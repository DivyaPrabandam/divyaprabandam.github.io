[[[1008,1008,["** angkaN njAlam anjcha * anggOr ALariyAy * avuNan","pongga Agam vaLLugirAl * pOzhndha punidhan iDam **","painggaN Anaik kombu koNDu * paththimaiyAl * aDik kIzhch","sengkaN ALi iTTiRainjchum * singgavEL kunRamE"],["** அங்கண் ஞாலம் அஞ்ச * அங்கோர் ஆளரியாய் * அவுணன்","பொங்க ஆகம் வள்ளுகிரால் * போழ்ந்த புனிதன் இடம் **","பைங்கண் ஆனைக் கொம்பு கொண்டு * பத்திமையால் * அடிக் கீழ்ச்","செங்கண் ஆளி இட்டிறைஞ்சும் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.1.mp3"],[1009,1009,["alaiththa pEzh vAy * vAL eyiRROr kOL ariyAy * avuNan","kolaik kaiyALan nenjchu iDandha * kUr ugirALan iDam **","malaiththa sel sAththeRindha pUsal * vanthuDivAy kaDuppa *","silaik kai vEDar thezhippaRAdha * singgavEL kunRamE"],["அலைத்த பேழ் வாய் * வாள் எயிற்றோர் கோள் அரியாய் * அவுணன்","கொலைக் கையாளன் நெஞ்சு இடந்த * கூர் உகிராளன் இடம் **","மலைத்த செல் சாத்தெறிந்த பூசல் * வன்துடிவாய் கடுப்ப *","சிலைக் கை வேடர் தெழிப்பறாத * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.2.mp3"],[1010,1010,["Eyndha pEzh vAy * vAL eyiRROr kOL ariyAy * avuNan","vAyndha Agam vaLLugirAl * vagirndha ammAnadhiDam **","Oyndha mAvum uDaindha kunRum * anRiyum ninRazhalAl *","thEyndha vEyum alladhillAch * singgavEL kunRamE"],["ஏய்ந்த பேழ் வாய் * வாள் எயிற்றோர் கோள் அரியாய் * அவுணன்","வாய்ந்த ஆகம் வள்ளுகிரால் * வகிர்ந்த அம்மானதிடம் **","ஓய்ந்த மாவும் உடைந்த குன்றும் * அன்றியும் நின்றழலால் *","தேய்ந்த வேயும் அல்லதில்லாச் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.3.mp3"],[1011,1011,["evvam vevvEl pon peyarOn * Edhalan innuyirai","vavvi * Agam vaLLugirAl * vagirndha ammAnadhiDam **","kavvu nAyum kazhugum * uchchip pOdhoDu kAl suzhanRu *","dheyvam allAl sella oNNAch * singgavEL kunRamE"],["எவ்வம் வெவ்வேல் பொன் பெயரோன் * ஏதலன் இன்னுயிரை","வவ்வி * ஆகம் வள்ளுகிரால் * வகிர்ந்த அம்மானதிடம் **","கவ்வு நாயும் கழுகும் * உச்சிப் போதொடு கால் சுழன்று *","தெய்வம் அல்லால் செல்ல ஒண்ணாச் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.4.mp3"],[1012,1012,["menRa pEzh vAy * vAL eyiRROr kOL ariyAy * avuNan","ponRa Agam vaLLugirAl * pOzhndha punidhan iDam **","ninRa senthI moNDu sURai * nIL visumbu UDiriya *","senRu kANDaRku ariya kOyil * singgavEL kunRamE"],["மென்ற பேழ் வாய் * வாள் எயிற்றோர் கோள் அரியாய் * அவுணன்","பொன்ற ஆகம் வள்ளுகிரால் * போழ்ந்த புனிதன் இடம் **","நின்ற செந்தீ மொண்டு சூறை * நீள் விசும்பு ஊடிரிய *","சென்று காண்டற்கு அரிய கோயில் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.5.mp3"],[1013,1013,["erindha painggaN ilanggu pEzh vAy * eyiRRoDu idhu evvuru enRu *","irindhu vAnOr kalanggi ODa * irundha ammAnadhiDam **","nerindha vEyin muzhaiyuL ninRu * nIL neRivAy uzhuvai *","thirindha Anaich chuvaDu pArkkum * singgavEL kunRamE"],["எரிந்த பைங்கண் இலங்கு பேழ் வாய் * எயிற்றொடு இது எவ்வுரு என்று *","இரிந்து வானோர் கலங்கி ஓட * இருந்த அம்மானதிடம் **","நெரிந்த வேயின் முழையுள் நின்று * நீள் நெறிவாய் உழுவை *","திரிந்த ஆனைச் சுவடு பார்க்கும் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.6.mp3"],[1014,1014,["munaiththa sIRRam viN suDap pOy * mUvulagum piRavum *","anaiththum anjcha ALariyAy * irundha ammAnadhiDam **","kanaiththa thIyum kallum allA * villuDai vEDarumAy *","thinaiththanaiyum sella oNNAch * singgavEL kunRamE"],["முனைத்த சீற்றம் விண் சுடப் போய் * மூவுலகும் பிறவும் *","அனைத்தும் அஞ்ச ஆளரியாய் * இருந்த அம்மானதிடம் **","கனைத்த தீயும் கல்லும் அல்லா * வில்லுடை வேடருமாய் *","தினைத்தனையும் செல்ல ஒண்ணாச் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.7.mp3"],[1015,1015,["nAth thazhumba nAnmuganum * IsanumAy muRaiyAl","Eththa * anggOr ALariyAy * irundha ammAnadhiDam **","kAyththa vAgai neRRolippak * kal adhar vEyngkazhai pOy *","thEyththa thIyAl viN sivakkum * singgavEL kunRamE"],["நாத் தழும்ப நான்முகனும் * ஈசனுமாய் முறையால்","ஏத்த * அங்கோர் ஆளரியாய் * இருந்த அம்மானதிடம் **","காய்த்த வாகை நெற்றொலிப்பக் * கல் அதர் வேய்ங்கழை போய் *","தேய்த்த தீயால் விண் சிவக்கும் * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.8.mp3"],[1016,1016,["nallai nenjchE! nAm thozhudhum * nammuDai namperumAn *","alli mAdhar pulga ninRa * Ayiram thOLan iDam **","nelli malgik kal uDaippap * pul ilai Arththu * adharvAych","sillu sil enRu ollaRAdha * singgavEL kunRamE"],["நல்லை நெஞ்சே! நாம் தொழுதும் * நம்முடை நம்பெருமான் *","அல்லி மாதர் புல்க நின்ற * ஆயிரம் தோளன் இடம் **","நெல்லி மல்கிக் கல் உடைப்பப் * புல் இலை ஆர்த்து * அதர்வாய்ச்","சில்லு சில் என்று ஒல்லறாத * சிங்கவேள் குன்றமே"],0,"/media/recitation/PT.1.7.9.mp3"],[1017,1017,["** sengkaN ALi iTTiRainjchum * singgavEL kunRuDaiya *","enggaL Isan empirAnai * irunthamizh nURpulavan **","manggaiyALan mannu thol sIr * vaNDaRai thArk kaliyan *","sengkaiyALan senjchol mAlai * vallavar thIdhilarE"],["** செங்கண் ஆளி இட்டிறைஞ்சும் * சிங்கவேள் குன்றுடைய *","எங்கள் ஈசன் எம்பிரானை * இருந்தமிழ் நூற்புலவன் **","மங்கையாளன் மன்னு தொல் சீர் * வண்டறை தார்க் கலியன் *","செங்கையாளன் செஞ்சொல் மாலை * வல்லவர் தீதிலரே"],0,"/media/recitation/PT.1.7.10.mp3"]],[[1018,1018,["** konggalarndha malark kurundham osiththa * kOvalan empirAn *","sanggu thanggu thaDangkaDal * thuyil koNDa thAmaraik kaNNinan **","ponggu puLLinai vAy piLandha * purANar tham iDam * ponggu nIrch","sengkayal thiLaikkum sunaith * thiruvEngkaDam aDai nenjchamE!"],["** கொங்கலர்ந்த மலர்க் குருந்தம் ஒசித்த * கோவலன் எம்பிரான் *","சங்கு தங்கு தடங்கடல் துயில் கொண்ட * தாமரைக் கண்ணினன் **","பொங்கு புள்ளினை வாய் பிளந்த * புராணர் தம் இடம் * பொங்கு நீர்ச்","செங்கயல் திளைக்கும் சுனைத் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.1.mp3"],[1019,1019,["** paLLi Avadhu pARkaDal aranggam * irangga vanpEy mulai *","piLLaiyAy uyir uNDa endhai * pirAn avan perugum iDam **","veLLiyAn kariyAn * maNiniRa vaNNan enReNNi * nAL thoRum","theLLiyAr vaNanggum malaith * thiruvEngkaDam aDai nenjchamE!"],["பள்ளி ஆவது பாற்கடல் அரங்கம் * இரங்க வன்பேய் முலை *","பிள்ளையாய் உயிர் உண்ட எந்தை * பிரான் அவன் பெருகும் இடம் **","வெள்ளியான் கரியான் * மணிநிற வண்ணன் என்றெண்ணி * நாள் தொறும்","தெள்ளியார் வணங்கும் மலைத் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.2.mp3"],[1020,1020,["ninRa mAmarudhu iRRu vIzha * naDandha ninmalan nEmiyAn *","enRum vAnavar kai thozhum * iNaith thAmarai aDi empirAn **","kanRi mAri pozhindhiDak * kaDidhu Aniraikku iDar nIkkuvAn *","senRu kunRam eDuththavan * thiruvEngkaDam aDai nenjchamE!"],["நின்ற மாமருது இற்று வீழ * நடந்த நின்மலன் நேமியான் *","என்றும் வானவர் கை தொழும் * இணைத் தாமரை அடி எம்பிரான் **","கன்றி மாரி பொழிந்திடக் * கடிது ஆநிரைக்கு இடர் நீக்குவான் *","சென்று குன்றம் எடுத்தவன் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.3.mp3"],[1021,1021,["** pArththaRkAy anRu pAradham kai seydhiTTu * venRa paranjchuDar *","kOththanggu Ayar tham pADiyil * kuravai piNaindha em kOvalan **","EththuvAr tham manaththuLLAn * iDavendhai mEviya empirAn *","thIrththa nIrth thaDanjchOlai sUzh * thiruvEngkaDam aDai nenjchamE!"],["பார்த்தற்காய் அன்று பாரதம் கை செய்திட்டு * வென்ற பரஞ்சுடர் *","கோத்தங்கு ஆயர் தம் பாடியில் * குரவை பிணைந்த எம் கோவலன் **","ஏத்துவார் தம் மனத்துள்ளான் * இடவெந்தை மேவிய எம்பிரான் *","தீர்த்த நீர்த் தடஞ்சோலை சூழ் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.4.mp3"],[1022,1022,["vaNkaiyAn avuNarkku nAyagan * vELviyil senRu mANiyAy *","maN kaiyAl irandhAn * marAmaram Ezhum eydha valaththinAn **","eNkaiyAn imayaththuLLAn * irunjchOlai mEviya empirAn *","thiNkaimmA thuyar thIrththavan * thiruvEngkaDam aDai nenjchamE!"],["வண்கையான் அவுணர்க்கு நாயகன் * வேள்வியில் சென்று மாணியாய் *","மண் கையால் இரந்தான் * மராமரம் ஏழும் எய்த வலத்தினான் **","எண்கையான் இமயத்துள்ளான் * இருஞ்சோலை மேவிய எம்பிரான் *","திண்கைம்மா துயர் தீர்த்தவன் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.5.mp3"],[1023,1023,["eNthisaigaLum Ezhulagamum vAnggip * pon vayiRRil peydhu *","paNDOr Alilaip paLLi koNDavan * pAlmadhikku iDar thIrththavan **","oNthiRal avuNan uraththu ugir vaiththavan * oL eyiRRoDu *","thiNthiRal ari Ayavan * thiruvEngkaDam aDai nenjchamE!"],["எண்திசைகளும் ஏழுலகமும் வாங்கிப் * பொன் வயிற்றில் பெய்து *","பண்டோர் ஆலிலைப் பள்ளி கொண்டவன் * பால்மதிக்கு இடர் தீர்த்தவன் **","ஒண்திறல் அவுணன் உரத்து உகிர் வைத்தவன் * ஒள் எயிற்றொடு *","திண்திறல் அரி ஆயவன் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.6.mp3"],[1024,1024,["pārum nīr ĕri kāṟṟiṉoṭu * ākācamum ivai āyiṉāṉ *","perum āyiram peca niṉṟa * piṟappili pĕrukum iṭam **","kārum vār paṉi nīl̤ vicumpiṭaic * corum mā mukil toytara *","cerum vār pŏzhil cūzh ĕzhil * tiruveṅkaṭam aṭai nĕñcame-"],["பாரும் நீர் எரி காற்றினோடு * ஆகாசமும் இவை ஆயினான் *","பேரும் ஆயிரம் பேச நின்ற * பிறப்பிலி பெருகும் இடம் **","காரும் வார் பனி நீள் விசும்பிடைச் * சோரும் மா முகில் தோய்தர *","சேரும் வார் பொழில் சூழ் எழில் * திருவேங்கடம் அடை நெஞ்சமே"],1,"/media/recitation/PT.1.8.7.mp3"],[1025,1025,["ambaram anal kAl nilam * salam Agi ninRa amarar kOn *","vambulAm malar mEl * malimaDa manggai than kozhunan avan **","kombin anna iDai maDak kuRamAdhar * nIL idhaNam thoRum *","sempunam avai kAval koL * thiruvEngkaDam aDai nenjchamE!"],["அம்பரம் அனல் கால் நிலம் * சலம் ஆகி நின்ற அமரர் கோன் *","வம்புலாம் மலர் மேல் * மலிமட மங்கை தன் கொழுனன் அவன் **","கொம்பின் அன்ன இடை மடக் குறமாதர் * நீள் இதணம் தொறும் *","செம்புனம் அவை காவல் கொள் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.8.mp3"],[1026,1026,["** pEsumin thirunAmam eTTezhuththum * solli ninRu pinnarum *","pEsuvAr thamai uyya vAnggip * piRappaRukkum pirAn iDam **","vAsa mAmalar nARuvAr * pozhil sUzh tharum ulagukkellAm *","thEsamAyth thigazhum malaith * thiruvEngkaDam aDai nenjchamE!"],["** பேசுமின் திருநாமம் எட்டெழுத்தும் * சொல்லி நின்று பின்னரும் *","பேசுவார் தமை உய்ய வாங்கிப் * பிறப்பறுக்கும் பிரான் இடம் **","வாச மாமலர் நாறுவார் * பொழில் சூழ் தரும் உலகுக்கெல்லாம் *","தேசமாய்த் திகழும் மலைத் * திருவேங்கடம் அடை நெஞ்சமே!"],0,"/media/recitation/PT.1.8.9.mp3"],[1027,1027,["** sengkayal thiLaikkum sunaith * thiruvEngkaDaththuRai selvanai *","manggaiyar thalaivan kalikanRi * vaNthamizhch senjchol mAlaigaL **","sanggai inRith thariththu uraikka vallArgaL * thanjchamadhAgavE *","vangga mAkaDal vaiyam kAvalar Agi * vAnulagu ALvarE"],["** செங்கயல் திளைக்கும் சுனைத் * திருவேங்கடத்துறை செல்வனை *","மங்கையர் தலைவன் கலிகன்றி * வண்தமிழ்ச் செஞ்சொல் மாலைகள் **","சங்கை இன்றித் தரித்து உரைக்க வல்லார்கள் * தஞ்சமதாகவே *","வங்க மாகடல் வையம் காவலர் ஆகி * வானுலகு ஆள்வரே"],0,"/media/recitation/PT.1.8.10.mp3"]],[[1028,1028,["tāye tantai ĕṉṟum * tārame kil̤ai makkal̤ ĕṉṟum *","noye paṭṭŏzhinteṉ * nuṉṉaik kāṇpatu or ācaiyiṉāl **","vey ey pūm pŏzhil cūzh * virai ār tiruveṅkaṭavā! *","nāyeṉ vantu aṭainteṉ * nalki āl̤ ĕṉṉaik kŏṇṭarul̤e-"],["தாயே தந்தை என்றும் * தாரமே கிளை மக்கள் என்றும் *","நோயே பட்டொழிந்தேன் * நுன்னைக் காண்பது ஓர் ஆசையினால் **","வேய் ஏய் பூம் பொழில் சூழ் * விரை ஆர் திருவேங்கடவா! *","நாயேன் வந்து அடைந்தேன் * நல்கி ஆள் என்னைக் கொண்டருளே"],1,"/media/recitation/PT.1.9.1.mp3"],[1029,1029,["mAnEy kaN maDavAr * mayakkil paTTu mAnilaththu *","nAnE nAnAvidha * naragam pugum pAvam seydhEn **","thEnEy pUmpozhil sUzh * thiruvEngkaDa mAmalai * en","AnAy! vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["மானேய் கண் மடவார் * மயக்கில் பட்டு மாநிலத்து *","நானே நானாவித * நரகம் புகும் பாவம் செய்தேன் **","தேனேய் பூம்பொழில் சூழ் * திருவேங்கட மாமலை * என்","ஆனாய்! வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.2.mp3"],[1030,1030,["konREn palluyiraik * kuRikkOL onRu ilAmaiyinAl *","enREnum irandhArkku * inidhAga uraiththu aRiyEn **","kunREy mEgam adhir * kuLir mAmalai vEngkaDavA! *","anRE vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["கொன்றேன் பல்லுயிரைக் * குறிக்கோள் ஒன்று இலாமையினால் *","என்றேனும் இரந்தார்க்கு * இனிதாக உரைத்து அறியேன் **","குன்றேய் மேகம் அதிர் * குளிர் மாமலை வேங்கடவா! *","அன்றே வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.3.mp3"],[1031,1031,["kulam thAn eththanaiyum * piRandhE iRandhu eyththozhindhEn *","nalam thAn onRumilEn * nalladhOr aRam seydhumilEn **","nilam thOy nILmugil sEr * neRiyAr thiruvEngkaDavA! *","alandhEn vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["குலம் தான் எத்தனையும் * பிறந்தே இறந்து எய்த்தொழிந்தேன் *","நலம் தான் ஒன்றுமிலேன் * நல்லதோர் அறம் செய்துமிலேன் **","நிலம் தோய் நீள்முகில் சேர் * நெறியார் திருவேங்கடவா! *","அலந்தேன் வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.4.mp3"],[1032,1032,["eppAvam palavum * ivaiyE seydhu iLaiththu ozhindhEn *","thuppA! ninnaDiyE * thoDarndhu Eththavum kiRkinRilEn **","seppAr thiNvarai sUzh * thiruvEngkaDa mAmalai * en","appA! vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["எப்பாவம் பலவும் * இவையே செய்து இளைத்து ஒழிந்தேன் *","துப்பா! நின்னடியே * தொடர்ந்து ஏத்தவும் கிற்கின்றிலேன் **","செப்பார் திண்வரை சூழ் * திருவேங்கட மாமலை * என்","அப்பா! வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.5.mp3"],[1033,1033,["maNNAy nIr eri kAl * manjchulAvum AgAsamumAm *","puNNAr Akkai thannuL * pulambith thaLarndhu eyththozhindhEn **","viNNAr nILsigara * viraiyAr thiruvEngkaDavA! *","aNNA! vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["மண்ணாய் நீர் எரி கால் * மஞ்சுலாவும் ஆகாசமுமாம் *","புண்ணார் ஆக்கை தன்னுள் * புலம்பித் தளர்ந்து எய்த்தொழிந்தேன் **","விண்ணார் நீள்சிகர * விரையார் திருவேங்கடவா! *","அண்ணா! வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.6.mp3"],[1034,1034,["theriyEn pAlaganAyp * pala thImaigaL seydhumiTTEn *","periyEn Ayina pin * piRarkkE uzhaiththu Ezhai AnEn **","kari sEr pUmpozhil sUzh * kanamAmalai vEngkaDavA! *","ariyE! vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["தெரியேன் பாலகனாய்ப் * பல தீமைகள் செய்துமிட்டேன் *","பெரியேன் ஆயின பின் * பிறர்க்கே உழைத்து ஏழை ஆனேன் **","கரி சேர் பூம்பொழில் சூழ் * கனமாமலை வேங்கடவா! *","அரியே! வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.7.mp3"],[1035,1035,["noṟṟeṉ pal piṟavi * nuṉṉaik kāṇpatu or ācaiyiṉāl *","eṟṟeṉ ip piṟappe * iṭar uṟṟaṉaṉ-ĕm pĕrumāṉ **","kol teṉ pāyntu ŏzhukum * kul̤ir colai cūzh veṅkaṭavā *","āṟṟeṉ vantu aṭainteṉ * aṭiyeṉai āṭ kŏṇṭarul̤e-"],["நோற்றேன் பல் பிறவி * நுன்னைக் காண்பது ஓர் ஆசையினால் *","ஏற்றேன் இப் பிறப்பே * இடர் உற்றனன் எம் பெருமான் **","கோல் தேன் பாய்ந்து ஒழுகும் * குளிர் சோலை சூழ் வேங்கடவா *","ஆற்றேன் வந்து அடைந்தேன் * அடியேனை ஆட் கொண்டருளே"],1,"/media/recitation/PT.1.9.8.mp3"],[1036,1036,["paRREl onRumilEn * pAvamE seydhu pAvi AnEn *","maRREl onRaRiyEn * mAyanE! enggaL mAdhavanE! **","kalthEn pAyndhu ozhugum * kamalach chunai vEngkaDavA! *","aRREn vandhaDaindhEn * aDiyEnai ATkoNDaruLE"],["பற்றேல் ஒன்றுமிலேன் * பாவமே செய்து பாவி ஆனேன் *","மற்றேல் ஒன்றறியேன் * மாயனே! எங்கள் மாதவனே! **","கல்தேன் பாய்ந்து ஒழுகும் * கமலச் சுனை வேங்கடவா! *","அற்றேன் வந்தடைந்தேன் * அடியேனை ஆட்கொண்டருளே"],0,"/media/recitation/PT.1.9.9.mp3"],[1037,1037,["** kaNNAy Ezhulagukku * uyirAya engkAr vaNNanai *","viNNOr thAm paravum * pozhil vEngkaDa vEdhiyanai **","thiNNAr mADanggaL sUzh * thirumanggaiyar kOn kaliyan *","paNNAr pADal paththum * payilvArkku illai pAvanggaLE"],["** கண்ணாய் ஏழுலகுக்கு * உயிராய எங்கார் வண்ணனை *","விண்ணோர் தாம் பரவும் * பொழில் வேங்கட வேதியனை **","திண்ணார் மாடங்கள் சூழ் * திருமங்கையர் கோன் கலியன் *","பண்ணார் பாடல் பத்தும் * பயில்வார்க்கு இல்லை பாவங்களே"],0,"/media/recitation/PT.1.9.10.mp3"]],[[1038,1038,["** kaNNAr kaDal sUzh * ilanggaikku iRaivan than *","thiNNAgam piLakkach * saram sela uyththAy! **","viNNOr thozhum * vEngkaDa mAmalai mEya *","aNNA! aDiyEn * iDaraik kaLaiyAyE"],["** கண்ணார் கடல் சூழ் * இலங்கைக்கு இறைவன் தன் *","திண்ணாகம் பிளக்கச் * சரம் செல உய்த்தாய்! **","விண்ணோர் தொழும் * வேங்கட மாமலை மேய *","அண்ணா! அடியேன் * இடரைக் களையாயே"],0,"/media/recitation/PT.1.10.1.mp3"],[1039,1039,["ilanggaip padhikku * anRu iRaiyAya * arakkar","kulam keTTu avar mALak * koDip puL thiriththAy! **","vilanggal kuDumith * thiruvEngkaDam mEya *","alanggal thuLaba muDiyAy! * aruLAyE"],["இலங்கைப் பதிக்கு * அன்று இறையாய * அரக்கர்","குலம் கெட்டு அவர் மாளக் * கொடிப் புள் திரித்தாய்! **","விலங்கல் குடுமித் * திருவேங்கடம் மேய *","அலங்கல் துளப முடியாய்! * அருளாயே"],0,"/media/recitation/PT.1.10.2.mp3"],[1040,1040,["nIrAr kaDalum * nilanum muzhudhu uNDu *","Er Alam iLanthaLir mEl * thuyil endhAy! **","sIrAr * thiruvEngkaDa mAmalai mEya *","ArAvamudhE! * aDiyERku aruLAyE"],["நீரார் கடலும் * நிலனும் முழுது உண்டு *","ஏர் ஆலம் இளந்தளிர் மேல் * துயில் எந்தாய்! **","சீரார் * திருவேங்கட மாமலை மேய *","ஆராவமுதே! * அடியேற்கு அருளாயே"],0,"/media/recitation/PT.1.10.3.mp3"],[1041,1041,["uNDAy uRi mEl * naRuney amudhAga *","koNDAy kuRaLAy * nilam IraDiyAlE **","viNthOy sigarath * thiruvEngkaDam mEya *","aNDA! aDiyEnukku * aruL puriyAyE"],["உண்டாய் உறி மேல் * நறுநெய் அமுதாக *","கொண்டாய் குறளாய் * நிலம் ஈரடியாலே **","விண்தோய் சிகரத் * திருவேங்கடம் மேய *","அண்டா! அடியேனுக்கு * அருள் புரியாயே"],0,"/media/recitation/PT.1.10.4.mp3"],[1042,1042,["thUNAy adhanUDu * ariyAy vandhu thOnRi *","pENA avuNan uDalam * piLandhiTTAy! **","sENAr * thiruvEngkaDa mAmalai mEya *","kONAgaNaiyAy! * kuRikkoL enai nIyE"],["தூணாய் அதனூடு * அரியாய் வந்து தோன்றி *","பேணா அவுணன் உடலம் * பிளந்திட்டாய்! **","சேணார் * திருவேங்கட மாமலை மேய *","கோணாகணையாய்! * குறிக்கொள் எனை நீயே"],0,"/media/recitation/PT.1.10.5.mp3"],[1043,1043,["mannA * immanisap piRaviyai nIkki *","than Akkith * than innaruL seyyum thalaivan **","minnAr mugil sEr * thiruvEngkaDam mEya *","en Anai en appan * en nenjchil uLAnE"],["மன்னா * இம்மனிசப் பிறவியை நீக்கி *","தன் ஆக்கித் * தன் இன்னருள் செய்யும் தலைவன் **","மின்னார் முகில் சேர் * திருவேங்கடம் மேய *","என் ஆனை என் அப்பன் * என் நெஞ்சில் உளானே"],0,"/media/recitation/PT.1.10.6.mp3"],[1044,1044,["mAnEy maDanOkki thiRaththu * edhir vandha *","AnEzh viDai seRRa * aNivaraith thOLA! **","thEnE! * thiruvEngkaDa mAmalai mEya *","kOnE! en manam * kuDi koNDu irundhAyE"],["மானேய் மடநோக்கி திறத்து * எதிர் வந்த *","ஆனேழ் விடை செற்ற * அணிவரைத் தோளா! **","தேனே! * திருவேங்கட மாமலை மேய *","கோனே! என் மனம் * குடி கொண்டு இருந்தாயே"],0,"/media/recitation/PT.1.10.7.mp3"],[1045,1045,["sEyan aNiyan * ena sindhaiyuL ninRa","mAyan * maNi vAL oLi * veNtharaLanggaL **","vEy viNDu udhir * vEngkaDa mAmalai mEya *","Ayan aDi alladhu * maRRu aRiyEnE"],["சேயன் அணியன் * என சிந்தையுள் நின்ற","மாயன் * மணி வாள் ஒளி * வெண்தரளங்கள் **","வேய் விண்டு உதிர் * வேங்கட மாமலை மேய *","ஆயன் அடி அல்லது * மற்று அறியேனே"],0,"/media/recitation/PT.1.10.8.mp3"],[1046,1046,["vandhAy en manam pugundhAy * manni ninRAy! *","nandhAdha kozhunjchuDarE! * enggaL nambI! **","chinthAmaNiyE! * thiruvEngkaDam mEya","endhAy! * ini yAn unnai * enRum viDEnE"],["வந்தாய் என் மனம் புகுந்தாய் * மன்னி நின்றாய்! *","நந்தாத கொழுஞ்சுடரே! * எங்கள் நம்பீ! **","சிந்தாமணியே! * திருவேங்கடம் மேய","எந்தாய்! * இனி யான் உன்னை * என்றும் விடேனே"],0,"/media/recitation/PT.1.10.9.mp3"],[1047,1047,["** villAr mali * vEngkaDa mAmalai mEya *","mallAr thiraL thOL * maNivaNNan ammAnai **","kallAr thiraL thOL * kaliyan sonna mAlai *","vallAr avar * vAnavar Aguvar thAmE"],["** வில்லார் மலி * வேங்கட மாமலை மேய *","மல்லார் திரள் தோள் * மணிவண்ணன் அம்மானை **","கல்லார் திரள் தோள் * கலியன் சொன்ன மாலை *","வல்லார் அவர் * வானவர் ஆகுவர் தாமே"],0,"/media/recitation/PT.1.10.10.mp3"]]]