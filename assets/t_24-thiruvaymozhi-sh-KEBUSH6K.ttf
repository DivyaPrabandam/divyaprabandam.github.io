{"id":"24-thiruvaymozhi","name":"Thiruvaymozhi","nameTa":"திருவாய்மொழி","alvar":"Nammazhvar","alvarTa":"நம்மாழ்வார்","src":"thiruvAymozhi","ayiram":4,"start":2791,"end":3892,"thaniyans":[{"le":["nammAzhvAr thiruvAy malarndharuLiya","thiruvAymozhi thaniyankaL","nAthamunigaL aruLich cheydhadhu"],"lt":["திருவாய்மொழி தனியன்கள்","நாதமுனிகள் அருளிச் செய்தது"],"en":["bhaktAmrutam vishva janAnumOdanam","sarvArtthadam srIshaThakOpa vAngmayam |","sahasra shAkhOpaniShat samAgamam","namAmyaham drAviDa vEda sAgaram ||"],"ta":["ப⁴க்தாம்ருதம் விஶ்வ ஜநாநுமோத³நம்","ஸர்வார்த்த²த³ம் ஸ்ரீஶட²கோப வாங்மயம் |","ஸஹஸ்ர ஶாகோ²பநிஷத் ஸமாக³மம்","நமாம்யஹம் த்³ராவிட³ வேத³ ஸாக³ரம் ||"]},{"le":["IsvaramunigaL aruLich cheydhadhu"],"lt":["ஈச்வரமுனிகள் அருளிச் செய்தது"],"en":["thiruvazhudhi nADu enRum thenkurugUr enRum *","maruviniya vaNporunal enRum * - arumaRaigaL","andhAdhi seydhAn aDi iNaiyE eppozhudhum *","sindhiyAy nenjchE! theLindhu"],"ta":["திருவழுதி நாடு என்றும் தென்குருகூர் என்றும் *","மருவினிய வண்பொருநல் என்றும் * - அருமறைகள்","அந்தாதி செய்தான் அடி இணையே எப்பொழுதும் *","சிந்தியாய் நெஞ்சே! தெளிந்து"]},{"le":["soTTai nambigaL aruLich cheydhadhu"],"lt":["சொட்டை நம்பிகள் அருளிச் செய்தது"],"en":["manaththAlum vAyAlum vaNkurugUr pENum *","inaththArai allAdhu iRainjchEn * - dhanaththAlum","Edhum kuRaivilEn * endhai saDakOpan","pAdhanggaL yAmuDaiya paRRu"],"ta":["மனத்தாலும் வாயாலும் வண்குருகூர் பேணும் *","இனத்தாரை அல்லாது இறைஞ்சேன் * - தனத்தாலும்","ஏதும் குறைவிலேன் * எந்தை சடகோபன்","பாதங்கள் யாமுடைய பற்று"]},{"le":["ananthAzhvAn aruLich cheydhadhu"],"lt":["அனந்தாழ்வான் அருளிச் செய்தது"],"en":["Eyndha perungkIrththi irAmAnusa muni than *","vAyndha malarp pAdham vaNangguginREn * - Ayndha perum","sIrAr saDakOpan senthamizh vEdham tharikkum *","pErAdha uLLam peRa"],"ta":["ஏய்ந்த பெருங்கீர்த்தி இராமானுச முனி தன் *","வாய்ந்த மலர்ப் பாதம் வணங்குகின்றேன் * - ஆய்ந்த பெரும்","சீரார் சடகோபன் செந்தமிழ் வேதம் தரிக்கும் *","பேராத உள்ளம் பெற"]},{"le":["bhaTTar aruLich cheydhavai"],"lt":["பட்டர் அருளிச் செய்தவை"],"en":["vAn thigazhum sOlai madhiL aranggar vaNpugazh mEl *","AnRa thamizh maRaigaL Ayiramum * - InRa","mudhal thAy saDakOpan * moympAl vaLarththa","idhath thAy irAmAnusan"],"ta":["வான் திகழும் சோலை மதிள் அரங்கர் வண்புகழ் மேல் *","ஆன்ற தமிழ் மறைகள் ஆயிரமும் * - ஈன்ற","முதல் தாய் சடகோபன் * மொய்ம்பால் வளர்த்த","இதத் தாய் இராமானுசன்"]},{"le":[],"lt":[],"en":["mikka iRai nilaiyum meyyAm uyir nilaiyum *","thakka neRiyum thaDai Agith - thokkiyalum *","Uzh vinaiyum vAzh vinaiyum Odhum kurugaiyar kOn *","yAzhin isai vEdhaththu iyal"],"ta":["மிக்க இறை நிலையும் மெய்யாம் உயிர் நிலையும் *","தக்க நெறியும் தடை ஆகித் - தொக்கியலும் *","ஊழ் வினையும் வாழ் வினையும் ஓதும் குருகையர் கோன் *","யாழின் இசை வேதத்து இயல்"]}],"sections":[{"he":["mudhal paththu","mEnmai uDaiya mAdhavaniDam mayarvaRa madhinalam maRappaRap peRudhal","mudhal thiruvAymozhi - uyarvaRa uyarnalam","emperumAn thiruvaDigaLilE nithya kaingkaryam paNNumpaDi","AzhvAr tham thiruvuLLaththukku upadhEsiththal"],"ht":["முதல் பத்து","மேன்மை உடைய மாதவனிடம் மயர்வற மதிநலம் மறப்பறப் பெறுதல்","முதல் திருவாய்மொழி - உயர்வற உயர்நலம்","எம்பெருமான் திருவடிகளிலே நித்ய கைங்கர்யம் பண்ணும்படி","ஆழ்வார் தம் திருவுள்ளத்துக்கு உபதேசித்தல்"],"ae":"aDivaravu: uyar manan ilanadhu nAm avaravar ninRanar thiDavisum suraraRi uLanenil parandha karavisum vIDu","at":"அடிவரவு: உயர் மனன் இலனது நாம் அவரவர் நின்றனர் திடவிசும் சுரரறி உளனெனில் பரந்த கரவிசும் வீடு","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","01 uyarvaRa uyarnalam [2675-2685] (Thiruvaymozhi - First Decad).mp3",2791,2801]},{"he":["mudhal paththu","iraNDAm thiruvAymozhi - vIDumin","'bhagavath bhakthiyaip paNNi AshrayiyunggOL' enRu piRarkku upadhEsiththal"],"ht":["முதல் பத்து","இரண்டாம் திருவாய்மொழி - வீடுமின்","'பகவத் பக்தியைப் பண்ணி ஆஶ்ரயியுங்கோள்' என்று பிறர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: vIDu min nIr iladhu aRRa paRRu aDanggu uLLam oDungga eN sEr paththu","at":"அடிவரவு: வீடு மின் நீர் இலது அற்ற பற்று அடங்கு உள்ளம் ஒடுங்க எண் சேர் பத்து","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","02 vIdumin muRRavum [2686-2696] (Thiruvaymozhi - First Decad).mp3",2802,2812]},{"he":["mudhal paththu","mUnRAm thiruvAymozhi - paththuDai","emperumAnadhu saulabyaththai aruLich cheydhal"],"ht":["முதல் பத்து","மூன்றாம் திருவாய்மொழி - பத்துடை","எம்பெருமானது ஸௌலப்யத்தை அருளிச் செய்தல்"],"ae":"aDivaravu: paththuDai eLivarum amaivuDai yArum piNakkaRa uNarndhu onRu nALum valaththanan thuyakkaRu amarar anjchiRai","at":"அடிவரவு: பத்துடை எளிவரும் அமைவுடை யாரும் பிணக்கற உணர்ந்து ஒன்று நாளும் வலத்தனன் துயக்கறு அமரர் அஞ்சிறை","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","03 paththudai [2697-2707] (Thiruvaymozhi - First Decad).mp3",2813,2823]},{"he":["mudhal paththu","nAnkAm thiruvAymozhi - anjchiRaiya","emperumAnadhu pizhai poRukkum guNaththaip paRRAsAgak koNDu","thalaimagaL paRavai mudhaliyavaRRaith thUdhu sella viDudhal"],"ht":["முதல் பத்து","நான்காம் திருவாய்மொழி - அஞ்சிறைய","எம்பெருமானது பிழை பொறுக்கும் குணத்தைப் பற்றாசாகக் கொண்டு","தலைமகள் பறவை முதலியவற்றைத் தூது செல்ல விடுதல்"],"ae":"aDivaravu: anjchiRai en vidhi ennIrmai nalgi aruLAdha enpizhai nIyalaiyE nADAdha uDal aLavu vaLavEzh","at":"அடிவரவு: அஞ்சிறை என் விதி என்னீர்மை நல்கி அருளாத என்பிழை நீயலையே நாடாத உடல் அளவு வளவேழ்","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","04 anjchiRaiya [2708-2718] (Thiruvaymozhi - First Decad).mp3",2824,2834]},{"he":["mudhal paththu","aindhAm thiruvAymozhi - vaLavEzh","AzhvAr emperumAnadhu vailakShaNyaththai anusandhiththu agalath thEDa,","emperumAn thannuDaiya sIlaguNaththAlE AzhvAraich sErththuk koLLudhal"],"ht":["முதல் பத்து","ஐந்தாம் திருவாய்மொழி - வளவேழ்","ஆழ்வார் எம்பெருமானது வைலக்ஷண்யத்தை அனுசந்தித்து அகலத் தேட, எம்பெருமான் தன்னுடைய சீலகுணத்தாலே ஆழ்வாரைச் சேர்த்துக் கொள்ளுதல்"],"ae":"aDivaravu: vaLavEzh ninaindhu mAyOn thAnOr mAnEy vinaiyEn aDiyEn uNDAy mAyOm sArndha mAlE parivadhu","at":"அடிவரவு: வளவேழ் நினைந்து மாயோன் தானோர் மானேய் வினையேன் அடியேன் உண்டாய் மாயோம் சார்ந்த மாலே பரிவது","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","05 vaLavEzh [2719-2729] (Thiruvaymozhi - First Decad).mp3",2835,2845]},{"he":["mudhal paththu","ARAm thiruvAymozhi - parivadhil","'emperumAn eLidhAga ArAdhikkath thakkavan' enRu upadhEsiththal"],"ht":["முதல் பத்து","ஆறாம் திருவாய்மொழி - பரிவதில்","'எம்பெருமான் எளிதாக ஆராதிக்கத் தக்கவன்' என்று உபதேசித்தல்"],"ae":"aDivaravu: parivadhu madhu IDum aNanggu koLgai amudham nIL kazhimin tharum kaDivAr mAdhavan piRavi","at":"அடிவரவு: பரிவது மது ஈடும் அணங்கு கொள்கை அமுதம் நீள் கழிமின் தரும் கடிவார் மாதவன் பிறவி","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","06 parivadhil [2730-2740] (Thiruvaymozhi - First Decad).mp3",2846,2856]},{"he":["mudhal paththu","EzhAm thiruvAymozhi - piRaviththuyar","emperumAnaip paRRuvadhu miga inidhAy irukkum enal"],"ht":["முதல் பத்து","ஏழாம் திருவாய்மொழி - பிறவித்துயர்","எம்பெருமானைப் பற்றுவது மிக இனிதாய் இருக்கும் எனல்"],"ae":"aDivaravu: piRavi vaippAm Ayar mayarvaRa viDuvEn pirAn yAnoTTi ennai amarar agalil kuDaindhu ODum","at":"அடிவரவு: பிறவி வைப்பாம் ஆயர் மயர்வற விடுவேன் பிரான் யானொட்டி என்னை அமரர் அகலில் குடைந்து ஓடும்","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","07 piRaviththuyar [2741-2751] (Thiruvaymozhi - First Decad).mp3",2857,2867]},{"he":["mudhal paththu","eTTAm thiruvAymozhi - ODumpuL"],"ht":["முதல் பத்து","எட்டாம் திருவாய்மொழி - ஓடும்புள்","ஈச்வரன் யாவரிடத்திலும் வாசியில்லாமல் ஆர்ஜவ (செம்மை)","குணம் உடையவன் என்று அருளிச் செய்தல்"],"ae":"aDivaravu: ODum ammAn kaN veRpai vaigal kalandhu koNDAn AnAn sanggu nAdhan nIr ivai","at":"அடிவரவு: ஓடும் அம்மான் கண் வெற்பை வைகல் கலந்து கொண்டான் ஆனான் சங்கு நாதன் நீர் இவை","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","08 OdumpuL [2752-2762] (Thiruvaymozhi - First Decad).mp3",2868,2878]},{"he":["mudhal paththu","onbadhAm thiruvAymozhi - ivaiyumavaiyum","Isvaran poRukkap poRukkath tham avayavanggaLODu kalandhu","anubavippiththa kalaviyai AzhvAr aruLich cheydhal"],"ht":["முதல் பத்து","ஒன்பதாம் திருவாய்மொழி - இவையுமவையும்","ஈச்வரன் பொறுக்கப் பொறுக்கத் தம் அவயவங்களோடு கலந்து","அநுபவிப்பித்த கலவியை ஆழ்வார் அருளிச் செய்தல்"],"ae":"aDivaravu: ivai sUzhal arugal uDan okkalai mAyan thOLiNai nAvin kamala neRRi uchchi porumA","at":"அடிவரவு: இவை சூழல் அருகல் உடன் ஒக்கலை மாயன் தோளிணை நாவின் கமல நெற்றி உச்சி பொருமா","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","09 ivaiyumavaiyum [2763-2773] (Thiruvaymozhi - First Decad).mp3",2879,2889]},{"he":["mudhal paththu","paththAm thiruvAymozhi - porumAnILpaDai","Isvaran nirhEthukamAgath thannai upakarippavan ena aruLich cheydhal"],"ht":["முதல் பத்து","பத்தாம் திருவாய்மொழி - பொருமாநீள்படை","ஈச்வரன் நிர்ஹேதுகமாகத் தன்னை உபகரிப்பவன் என அருளிச் செய்தல்"],"ae":"aDivaravu: porumA kaNNuL empirAn nenjcham kaNDAy nIyum endhai selva nambi maRappu maNi vAyum","at":"அடிவரவு: பொருமா கண்ணுள் எம்பிரான் நெஞ்சம் கண்டாய் நீயும் எந்தை செல்வ நம்பி மறப்பு மணி வாயும்","p":[],"box":["https://app.box.com/s/aqskukyfy3eqoa4tnthqy1tmlse4lk79","10 porumAnILpadai [2774-2784] (Thiruvaymozhi - First Decad).mp3",2890,2900]},{"he":["iraNDAm paththu","kAraNathvamuDaiya kEsavaniDam 'unakkEyAga enaik koLvadhE","njAna palamAna mOkSham' enRu nirNayiththal","mudhal thiruvAymozhi - vAyumthirai","kalandha emperumAn maRaiya niRka, AzhvAr oru pirATTi nilai aDaindhu achEthananggaLum thiryakkugaLum thammODu okkath thunbuRuvadhAga eNNip pulambudhal"],"ht":["இரண்டாம் பத்து","காரணத்வமுடைய கேசவனிடம் 'உனக்கேயாக எனைக்","கொள்வதே ஞான பலமான மோக்ஷம்' என்று நிர்ணயித்தல்","முதல் திருவாய்மொழி - வாயும்திரை","கலந்த எம்பெருமான் மறைய நிற்க, ஆழ்வார் ஒரு பிராட்டி நிலை அடைந்து அசேதனங்களும் திர்யக்குகளும் தம்மோடு ஒக்கத் துன்புறுவதாக எண்ணிப் புலம்புதல்"],"ae":"aDivaravu: vAyum kOL kAmuRRa kaDal Uzhi naivAy thORROm iruL nondhA vEvA sOrA thiNNan","at":"அடிவரவு: வாயும் கோள் காமுற்ற கடல் ஊழி நைவாய் தோற்றோம் இருள் நொந்தா வேவா சோரா திண்ணன்","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","11 vAyumthirai [2785-2795] (Thiruvaymozhi - Second Decad).mp3",2901,2911]},{"he":["iraNDAm paththu","iraNDAm thiruvAymozhi - thiNNanvIDu","emperumAnuDaiya parathvaththai ithihAsa purANa prakriyaiyAlE","avathAraththilE anusandhiththup parOpadhEsam seydhal"],"ht":["இரண்டாம் பத்து","இரண்டாம் திருவாய்மொழி - திண்ணன்வீடு","எம்பெருமானுடைய பரத்வத்தை இதிஹாச புராண ப்ரக்ரியையாலே","அவதாரத்திலே அநுஸந்தித்துப் பரோபதேசம் செய்தல்"],"ae":"aDivaravu: thiNNan EpAvam ERanai thEvum thagum yavarum paLLi karuththil kAkkum kaLvA Eththa Unil","at":"அடிவரவு: திண்ணன் ஏபாவம் ஏறனை தேவும் தகும் யவரும் பள்ளி கருத்தில் காக்கும் கள்வா ஏத்த ஊனில்","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","12 thiNNanvIdu [2796-2806] (Thiruvaymozhi - Second Decad).mp3",2912,2922]},{"he":["iraNDAm paththu","mUnRAm thiruvAymozhi - UnilvAzh","AzhvAr bagavadh anubavaththaip pUrNamAgap peRRu, usAththuNaiyAna","nithyasUrigaLODu eppOdhu kUDappOgiROm enRu AsaippaDudhal"],"ht":["இரண்டாம் பத்து","மூன்றாம் திருவாய்மொழி - ஊனில்வாழ்","ஆழ்வார் பகவத் அநுபவத்தைப் பூர்ணமாகப் பெற்று, உசாத்துணையான","நித்யஸூரிகளோடு எப்போது கூடப்போகிறோம் என்று ஆசைப்படுதல்"],"ae":"aDivaravu: Unil oththAr aRiyA enadhu ini sErndhAr munnal kuRikkoL kaDivAr kaLippu kuzhAngkoL ADi","at":"அடிவரவு: ஊனில் ஒத்தார் அறியா எனது இனி சேர்ந்தார் முன்னல் குறிக்கொள் கடிவார் களிப்பு குழாங்கொள் ஆடி","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","13 UnilvAzh [2807-2817] (Thiruvaymozhi - Second Decad).mp3",2923,2933]},{"he":["iraNDAm paththu","nAnkAm thiruvAymozhi - ADiyADi","nithyasUrigaLODu kUDappeRAmaiyAl, miga vATTamuRRu mayanggiya","parAngkusa nAyagiyin nilaiyaith thAy kURum pAsuram"],"ht":["இரண்டாம் பத்து","நான்காம் திருவாய்மொழி - ஆடியாடி","நித்யஸூரிகளோடு கூடப்பெறாமையால், மிக வாட்டமுற்று","மயங்கிய பராங்குச நாயகியின் நிலையைத் தாய் கூறும் பாசுரம்"],"ae":"aDivaravu: ADi vANudhal irakkam ilanggai ivaL thagavu uLLuL vanjchanE paTTa Ezhai vATTamil anthAmam","at":"அடிவரவு: ஆடி வாணுதல் இரக்கம் இலங்கை இவள் தகவு உள்ளுள் வஞ்சனே பட்ட ஏழை வாட்டமில் அந்தாமம்","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","14 AdiyAdi [2818-2828] (Thiruvaymozhi - Second Decad).mp3",2934,2944]},{"he":["iraNDAm paththu","aindhAm thiruvAymozhi - anthAmaththanbu","Isvaran thanadhu divyabhUshaNa divyAyudha divyAvayava sauntharyanggaLODu","vandhu kalakka, adhanAl AzhvAr thunbam thIrndhu inbuRudhal"],"ht":["இரண்டாம் பத்து","ஐந்தாம் திருவாய்மொழி - அந்தாமத்தன்பு","ஈச்வரன் தனது திவ்யபூஷண திவ்யாயுத திவ்யாவயவ ஸௌந்தர்யங்களோடு","வந்து கலக்க, அதனால் ஆழ்வார் துன்பம் தீர்ந்து இன்புறுதல்"],"ae":"aDivaravu: anthAmam thiru ennuL epporuL ArA palapala pAmbaNai ponmuDi sollIr AN kURudhal vaikunthA","at":"அடிவரவு: அந்தாமம் திரு என்னுள் எப்பொருள் ஆரா பலபல பாம்பணை பொன்முடி சொல்லீர் ஆண் கூறுதல் வைகுந்தா","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","15 anthAmaththanbu [2829-2839] (Thiruvaymozhi - Second Decad).mp3",2945,2955]},{"he":["iraNDAm paththu","ARAm thiruvAymozhi - vaikunthA","AzhvAradhu naichyAnusandhAnaththaik kaNDu emperumAn ivaradhu","pirivaich sanggiththu naiya, AzhvAr achchanggaiyaip pOkkudhal"],"ht":["இரண்டாம் பத்து","ஆறாம் திருவாய்மொழி - வைகுந்தா","ஆழ்வாரது நைச்யாநுஸந்தானத்தைக் கண்டு எம்பெருமான் இவரது","பிரிவைச் சங்கித்து நைய, ஆழ்வார் அச்சங்கையைப் போக்குதல்"],"ae":"aDivaravu: vaikunthA sikkena thAmarai vaLLalE uyndhu unnai muDiyA mARi endhAy pOginRa kaNNi kEsavan","at":"அடிவரவு: வைகுந்தா சிக்கென தாமரை வள்ளலே உய்ந்து உன்னை முடியா மாறி எந்தாய் போகின்ற கண்ணி கேசவன்","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","16 vaikunthA [2840-2850] (Thiruvaymozhi - Second Decad).mp3",2956,2966]},{"he":["iraNDAm paththu","EzhAm thiruvAymozhi - kEsavanthamar","emperumAnadhu thiruvaruLAl thamadhu EzhEzh thalaimuRaiyOrum","perumai peRRAr enal - pannirunAmap pATTu"],"ht":["இரண்டாம் பத்து","ஏழாம் திருவாய்மொழி - கேசவன்தமர்","எம்பெருமானது திருவருளால் தமது ஏழேழ் தலைமுறையோரும்","பெருமை பெற்றார் எனல் - பன்னிருநாமப் பாட்டு"],"ae":"aDivaravu: kEsavan nAraNan mAdhavan gOvindhan viTTilanggu madhusUdhan thirivikkiraman vAmanan sirIdharan iruDIkEsan paRpanAbhan dhAmOdharan vaNNam aNaivadhu","at":"அடிவரவு: கேசவன் நாரணன் மாதவன் கோவிந்தன் விட்டிலங்கு மதுசூதன் திரிவிக்கிரமன் வாமனன் சிரீதரன் இருடீகேசன் பற்பநாபன் தாமோதரன் வண்ணம் அணைவது","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","17 kEsavanthamar [2851-2863] (Thiruvaymozhi - Second Decad).mp3",2967,2979]},{"he":["iraNDAm paththu","eTTAm thiruvAymozhi - aNaivadhu","emperumAnadhu mOkShamaLikkum thanmaiyai ulagaththArkku upadhEsiththal"],"ht":["இரண்டாம் பத்து","எட்டாம் திருவாய்மொழி - அணைவது","எம்பெருமானது மோக்ஷமளிக்கும் தன்மையை உலகத்தார்க்கு உபதேசித்தல்"],"ae":"aDivaravu: aNaivadhu nIndhum puNarkkum pulan OvA thIrththan kiDandhu kANbAr enggum sIrmai kaNDalam emmA","at":"அடிவரவு: அணைவது நீந்தும் புணர்க்கும் புலன் ஓவா தீர்த்தன் கிடந்து காண்பார் எங்கும் சீர்மை கண்டலம் எம்மா","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","18 aNaivadhu [2864-2874] (Thiruvaymozhi - Second Decad).mp3",2980,2990]},{"he":["iraNDAm paththu","onbadhAm thiruvAymozhi - emmAvIDu","puruShArththa niShkarSham paNNudhal"],"ht":["இரண்டாம் பத்து","ஒன்பதாம் திருவாய்மொழி - எம்மாவீடு","புருஷார்த்த நிஷ்கர்ஷம் பண்ணுதல்"],"ae":"aDivaravu: emmA IdhE seyyEl enakkE siRappil magizh vArAy ekkAlaththu yAnE EREl viDalil kiLar","at":"அடிவரவு: எம்மா ஈதே செய்யேல் எனக்கே சிறப்பில் மகிழ் வாராய் எக்காலத்து யானே ஏறேல் விடலில் கிளர்","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","19 emmAvIdu [2875-2885] (Thiruvaymozhi - Second Decad).mp3",2991,3001]},{"he":["iraNDAm paththu","paththAm thiruvAymozhi - kiLaroLi","kIzh nishkarshiththa purushArththaththaip peRum poruTTuth","thirumAlirunjchOlai malaiyai AshrayikkumpaDi piRarkku upadhEsiththal"],"ht":["இரண்டாம் பத்து","பத்தாம் திருவாய்மொழி - கிளரொளி","கீழ் நிஷ்கர்ஷித்த புருஷார்த்தத்தைப் பெறும் பொருட்டுத்","திருமாலிருஞ்சோலை மலையை ஆச்ரயிக்கும்படி பிறர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: kiLar sadhir payan karumam thiRam kiRi nalam vazhakku sUdhu poruL muDi","at":"அடிவரவு: கிளர் சதிர் பயன் கருமம் திறம் கிறி நலம் வழக்கு சூது பொருள் முடி","p":[],"box":["https://app.box.com/s/062zj649wt9o9je61zhql8gwynruu2dp","20 kiLaroLi iLamai [2886-2896] (Thiruvaymozhi - Second Decad).mp3",3002,3012]},{"he":["mUnRAm paththu","anaiththaiyum vyApikkum viShNuvAna vEngkaDavaniDam","mOkSha palamAna kaingkaryam seyya AsaippaDudhal","mudhal thiruvAymozhi - muDichchOdhi","thirumAlirunjchOlai azhagaradhu vaDivazhagai muRRum anubaviththal"],"ht":["மூன்றாம் பத்து","அனைத்தையும் வ்யாபிக்கும் விஷ்ணுவான வேங்கடவனிடம்","மோக்ஷ பலமான கைங்கர்யம் செய்ய ஆசைப்படுதல்","முதல் திருவாய்மொழி - முடிச்சோதி","திருமாலிருஞ்சோலை அழகரது வடிவழகை முற்றும் அநுபவித்தல்"],"ae":"aDivaravu: muDi kaTTurai param mATTAdhE varundhAdha ODhu vAzhththu mAsUNA mazhunggAdha maRai viyappAya munnIr","at":"அடிவரவு: முடி கட்டுரை பரம் மாட்டாதே வருந்தாத ஓடு வாழ்த்து மாசூணா மழுங்காத மறை வியப்பாய முந்நீர்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","21 mudichchOdhi [2897-2907] (Thiruvaymozhi - Third Decad).mp3",3013,3023]},{"he":["mUnRAm paththu","iraNDAm thiruvAymozhi - munnIrnjAlam","AzhvAr azhagaraith tham indhiriyanggaLin kuRaiyAl pUrNAnubavam paNNa","muDiyAmal varundha, emperumAn ivaradhu kalakkaththaith thIrththal"],"ht":["மூன்றாம் பத்து","இரண்டாம் திருவாய்மொழி - முந்நீர்ஞாலம்","ஆழ்வார் அழகரைத் தம் இந்திரியங்களின் குறையால் பூர்ணாநுபவம் பண்ண முடியாமல் வருந்த, எம்பெருமான் இவரது கலக்கத்தைத் தீர்த்தல்"],"ae":"aDivaravu: munnIr vanmA kollA sUzhchchi vandhAy kiRpan enjnjAnRu mEvu kUvi thalai uyirgaL ozhivil","at":"அடிவரவு: முந்நீர் வன்மா கொல்லா சூழ்ச்சி வந்தாய் கிற்பன் எஞ்ஞான்று மேவு கூவி தலை உயிர்கள் ஒழிவில்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","22 munnIr njAlam [2908-2918] (Thiruvaymozhi - Third Decad).mp3",3024,3034]},{"he":["mUnRAm paththu","mUnRAm thiruvAymozhi - ozhivil kAlam","thiruvEngkaDamuDaiyAn thiruvaDigaLil kAlam ellAm vazhuvilA aDimai seyyap pAriththal"],"ht":["மூன்றாம் பத்து","மூன்றாம் திருவாய்மொழி - ஒழிவில் காலம்","திருவேங்கடமுடையான் திருவடிகளில் காலம்","எல்லாம் வழுவிலா அடிமை செய்யப் பாரித்தல்"],"ae":"aDivaravu: ozhivil endhai aNNal Isan sOdhi vEngkaDam sumandhu kunRam Oyum vaiththa thAL pugazh","at":"அடிவரவு: ஒழிவில் எந்தை அண்ணல் ஈசன் சோதி வேங்கடம் சுமந்து குன்றம் ஓயும் வைத்த தாள் புகழ்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","23 ozhivil kAlam [2919-2929] (Thiruvaymozhi - Third Decad).mp3",3035,3045]},{"he":["mUnRAm paththu","nAnkAm thiruvAymozhi - pugazhunalloruvan","emperumAn epporuLumAy niRpadhaip pEsi vAchikamAna aDimai seydhal"],"ht":["மூன்றாம் பத்து","நான்காம் திருவாய்மொழி - புகழுநல்லொருவன்","எம்பெருமான் எப்பொருளுமாய் நிற்பதைப் பேசி வாசிகமான அடிமை செய்தல்"],"ae":"aDivaravu: pugazhum kUvu panggaya sAdhi achchudhan pAl vAnavar oLi kaNNan yAvaiyum kUDi moy","at":"அடிவரவு: புகழும் கூவு பங்கய சாதி அச்சுதன் பால் வானவர் ஒளி கண்ணன் யாவையும் கூடி மொய்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","24 pugazhu nalloruvan [2930-2940] (Thiruvaymozhi - Third Decad).mp3",3046,3056]},{"he":["mUnRAm paththu","aindhAm thiruvAymozhi - moymmAm","bagavath kaingkaryam paNNugiRavargaLaik koNDADiyum, allAdhArai nindhiththum aruLich cheydhal"],"ht":["மூன்றாம் பத்து","ஐந்தாம் திருவாய்மொழி - மொய்ம்மாம்","பகவத் கைங்கர்யம் பண்ணுகிறவர்களைக் கொண்டாடியும்,","அல்லாதாரை நிந்தித்தும் அருளிச் செய்தல்"],"ae":"aDivaravu: moy thaN malai vambavizh sAdhu manisar nIRmai vArpunal amarar karumam thIrndha seyya","at":"அடிவரவு: மொய் தண் மலை வம்பவிழ் சாது மனிசர் நீற்மை வார்புனல் அமரர் கருமம் தீர்ந்த செய்ய","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","25 moymmAm [2941-2951] (Thiruvaymozhi - Third Decad).mp3",3057,3067]},{"he":["mUnRAm paththu","ARAm thiruvAymozhi - seyyathAmarai","kaingkaryam seyvadhaRkup para vyUha vibavanggaLaik kATTilum","archchAvathAramE eLidhenRu aruLich cheydhal"],"ht":["மூன்றாம் பத்து","ஆறாம் திருவாய்மொழி - செய்யதாமரை","கைங்கர்யம் செய்வதற்குப் பர வ்யூஹ விபவங்களைக் காட்டிலும்","அர்ச்சாவதாரமே எளிதென்று அருளிச் செய்தல்"],"ae":"aDivaravu: seyya mUvar paravi vaimin thiriyum thORRa ezhumai thuyaram thanjcham kaDal kaNgaL payilum","at":"அடிவரவு: செய்ய மூவர் பரவி வைமின் திரியும் தோற்ற எழுமை துயரம் தஞ்சம் கடல் கண்கள் பயிலும்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","26 seyya thAmarai [2952-2962] (Thiruvaymozhi - Third Decad).mp3",3068,3078]},{"he":["mUnRAm paththu","EzhAm thiruvAymozhi - payilum","aDiyArgaLiDaththil ALAnArkkuth thAm ATpaTTiruththalai aruLich cheydhal"],"ht":["மூன்றாம் பத்து","ஏழாம் திருவாய்மொழி - பயிலும்","அடியார்களிடத்தில் ஆளானார்க்குத் தாம் ஆட்பட்டிருத்தலை அருளிச் செய்தல்"],"ae":"aDivaravu: payilum ALum nAdhanai uDaiyAr perumakkaL aLikkum sanma pala namban kulam aDiyAr aDiyOnggu muDiyAn","at":"அடிவரவு: பயிலும் ஆளும் நாதனை உடையார் பெருமக்கள் அளிக்கும் சன்ம பல நம்பன் குலம் அடியார் அடியோங்கு முடியான்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","27 payilum [2963-2973] (Thiruvaymozhi - Third Decad).mp3",3079,3089]},{"he":["mUnRAm paththu","eTTAm thiruvAymozhi - muDiyAnE","karaNanggaLum thAmum peruviDAyppaTTup pEsudhal"],"ht":["மூன்றாம் பத்து","எட்டாம் திருவாய்மொழி - முடியானே","கரணங்களும் தாமும் பெருவிடாய்ப்பட்டுப் பேசுதல்"],"ae":"aDivaravu: muDiyAn nenjcham vAsagam kaigaL kaNgaL sevigaL AviyE kOlamE koLvan porundhi pulmabu sonnAl","at":"அடிவரவு: முடியான் நெஞ்சம் வாசகம் கைகள் கண்கள் செவிகள் ஆவியே கோலமே கொள்வன் பொருந்தி புல்மபு சொன்னால்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","28 mudiyAnE [2974-2984] (Thiruvaymozhi - Third Decad).mp3",3090,3100]},{"he":["mUnRAm paththu","onbadhAm thiruvAymozhi - sonnAl","mannA manisaraip pADAmal paramanaith thudhikkumpaDi pulavarkku upadhEsiththal"],"ht":["மூன்றாம் பத்து","ஒன்பதாம் திருவாய்மொழி - சொன்னால்","மன்னா மனிசரைப் பாடாமல் பரமனைத் துதிக்கும்படி புலவர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: sonnAl uLan ozhivu ennAvadhu koLLum vammin sErum vEyin vAy ninRu ERkum sanmam","at":"அடிவரவு: சொன்னால் உளன் ஒழிவு என்னாவது கொள்ளும் வம்மின் சேரும் வேயின் வாய் நின்று ஏற்கும் சன்மம்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","29 sonnAl [2985-2995] (Thiruvaymozhi - Third Decad).mp3",3101,3111]},{"he":["mUnRAm paththu","paththAm thiruvAymozhi - sanmampalapala","emperumAnadhu avathAra guNachEShTithanggaLai anubavikkaiyAlE thamakku","oru kuRaiyuminRi ellA iShTanggaLum uNDAnamaiyai aruLich cheydhal"],"ht":["மூன்றாம் பத்து","பத்தாம் திருவாய்மொழி - சன்மம்பலபல","எம்பெருமானது அவதார குணசேஷ்டிதங்களை அநுபவிக்கையாலே தமக்கு ஒரு குறையுமின்றி எல்லா இஷ்டங்களும் உண்டானமையை அருளிச் செய்தல்"],"ae":"aDivaravu: sanmam kuRaivu muTTil parivu iDar thuyar thunbam allal dhukkam thaLarvu kEDil orunAyagam","at":"அடிவரவு: சன்மம் குறைவு முட்டில் பரிவு இடர் துயர் துன்பம் அல்லல் துக்கம் தளர்வு கேடில் ஒருநாயகம்","p":[],"box":["https://app.box.com/s/a9v0bbncn9nicc86rokee7d0f0mc8exu","30 sanmam palapala [2996-3006] (Thiruvaymozhi - Third Decad).mp3",3112,3122]},{"he":["nAnkAm paththu","niyamikkum nAraNaniDam kaingkarya palamAna ithara viShaya virakthiyaip peRudhal","mudhal thiruvAymozhi - oru nAyagam","'aishvaryam aRpamAy nilaiyaRRadhAy iruppadhu, AthmAnubhavam thAzhndhadhu,","bhagavadhanubhavamE thalai siRandhadhu' enRu piRarkku upadhEsiththal"],"ht":["நான்காம் பத்து","நியமிக்கும் நாரணனிடம் கைங்கர்ய பலமான இதர விஷய விரக்தியைப் பெறுதல்","முதல் திருவாய்மொழி - ஒரு நாயகம்","'ஐஶ்வர்யம் அற்பமாய் நிலையற்றதாய் இருப்பது, ஆத்மாநுபவம் தாழ்ந்தது,","பகவதநுபவமே தலை சிறந்தது' என்று பிறர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: oru uymmin aDi ninaippAn paNimin vAzh Amin guNangkoL paDi kuRuga aqdhE pAlan","at":"அடிவரவு: ஒரு உய்ம்மின் அடி நினைப்பான் பணிமின் வாழ் ஆமின் குணங்கொள் படி குறுக அஃதே பாலன்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","31 oru nAyagam [3007-3017] (Thiruvaymozhi - Fourth Decad).mp3",3123,3133]},{"he":["nAnkAm paththu","iraNDAm thiruvAymozhi - pAlanAy","kAladhEsanggaLAl vilagi irukkaiyAl miga aridhAna bagavadhanubavanggaLai AsaippaTTu","naiginRa thalaimagaLin thanmai kaNDu thAy iranggik kURum pAsuram"],"ht":["நான்காம் பத்து","இரண்டாம் திருவாய்மொழி - பாலனாய்","காலதேசங்களால் விலகி இருக்கையால் மிக அரிதான பகவதநுபவங்களை ஆசைப்பட்டு நைகின்ற தலைமகளின் தன்மை கண்டு தாய் இரங்கிக் கூறும் பாசுரம்"],"ae":"aDivaravu: pAlan valli pAviyal kOdhila thOLi mAdhar maDandhai kombu nanggai en meliyum kOvai","at":"அடிவரவு: பாலன் வல்லி பாவியல் கோதில தோளி மாதர் மடந்தை கொம்பு நங்கை என் மெலியும் கோவை","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","32 pAlanAy [3018-3028] (Thiruvaymozhi - Fourth Decad).mp3",3134,3144]},{"he":["nAnkAm paththu","mUnRAm thiruvAymozhi - kOvaivAyAL","virumbiyapaDiyE kAlOpAdhiyaik kazhiththu emperumAn thannaik kATTa,"],"ht":["நான்காம் பத்து","மூன்றாம் திருவாய்மொழி - கோவைவாயாள்","விரும்பியபடியே காலோபாதியைக் கழித்து எம்பெருமான் தன்னைக் காட்ட,","ஆழ்வார் அவனது ப்ரணயித்வ குணத்தில் ஈடுபட்டு அருளிச் செய்தல்"],"ae":"aDivaravu: kOvai pUsum Ega mAyththa kaNNi kAla kurai ennadhu urai yAnum uyyu maNNai","at":"அடிவரவு: கோவை பூசும் ஏக மாய்த்த கண்ணி கால குரை என்னது உரை யானும் உய்யு மண்ணை","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","33 kOvai vAyAL [3029-3039] (Thiruvaymozhi - Fourth Decad).mp3",3145,3155]},{"he":["nAnkAm paththu","nAnkAm thiruvAymozhi - maNNai","kalandha emperumAn maRaiya niRka, piRivARRAdha nilaiyil pOlikaNDu","mElvizhundhu varundhum thalaiviyin nilaiyaith thAy uraikkum pAsuram"],"ht":["நான்காம் பத்து","நான்காம் திருவாய்மொழி - மண்ணை","கலந்த எம்பெருமான் மறைய நிற்க, பிறிவாற்றாத நிலையில் போலிகண்டு மேல்விழுந்து வருந்தும் தலைவியின் நிலையைத் தாய் உரைக்கும் பாசுரம்"],"ae":"aDivaravu: maN peyvaLai aRiyum onRiya kOmaLa kUththar ERiya thiru virumbi ayarkkum valvinai vIRRu","at":"அடிவரவு: மண் பெய்வளை அறியும் ஒன்றிய கோமள கூத்தர் ஏறிய திரு விரும்பி அயர்க்கும் வல்வினை வீற்று","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","34 maNNai [3040-3050] (Thiruvaymozhi - Fourth Decad).mp3",3156,3166]},{"he":["nAnkAm paththu","aindhAm thiruvAymozhi - vIRRirundhu","emperumAn thanadhu perumai ellAm thOnRak kATchi aLiththuk kalakka,","AzhvAr avanai manggaLAshAsanam paNNith thuyar thIrndhu magizhdhal"],"ht":["நான்காம் பத்து","ஐந்தாம் திருவாய்மொழி - வீற்றிருந்து","எம்பெருமான் தனது பெருமை எல்லாம் தோன்றக் காட்சி அளித்துக் கலக்க, ஆழ்வார் அவனை மங்களாஶாஸனம் பண்ணித் துயர் தீர்ந்து மகிழ்தல்"],"ae":"aDivaravu: vIRRu maiya vIvil mEvi ARRa kariya enRum namakkum vAnaththu uNDum mAri thIrppAr","at":"அடிவரவு: வீற்று மைய வீவில் மேவி ஆற்ற கரிய என்றும் நமக்கும் வானத்து உண்டும் மாரி தீர்ப்பார்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","35 vIRRirundhu [3051-3061] (Thiruvaymozhi - Fourth Decad).mp3",3167,3177]},{"he":["nAnkAm paththu","ARAm thiruvAymozhi - thIrppArai","emperumAn pirindhavuDan parAngkusa nAyagi mayangga, mayakkam thIra thEvathAntharak kaTTuvichchiyaik koNarndha thAyaith thOzhi veRivilakka, thirunAmam kETTu nAyagi uNardhal"],"ht":["நான்காம் பத்து","ஆறாம் திருவாய்மொழி - தீர்ப்பாரை","எம்பெருமான் பிரிந்தவுடன் பராங்குச நாயகி மயங்க, மயக்கம்","தீர தேவதாந்தரக் கட்டுவிச்சியைக் கொணர்ந்த தாயைத்","தோழி வெறிவிலக்க, திருநாமம் கேட்டு நாயகி உணர்தல்"],"ae":"aDivaravu: thIrppAr thisai idhu marundhu ivaLai thaNiyum aNanggu vEdham kIzhmai unniththu thozhudhu sIlam","at":"அடிவரவு: தீர்ப்பார் திசை இது மருந்து இவளை தணியும் அணங்கு வேதம் கீழ்மை உன்னித்து தொழுது சீலம்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","36 thIrppArai [3062-3072] (Thiruvaymozhi - Fourth Decad).mp3",3178,3188]},{"he":["nAnkAm paththu","EzhAm thiruvAymozhi - sIlamillA","uNarndha AzhvAr emperumAnadhu thirumEniyaik kaNDu","aNaivadhaRkAga iravum pagalum varundhik kUppiDudhal"],"ht":["நான்காம் பத்து","ஏழாம் திருவாய்மொழி - சீலமில்லா","உணர்ந்த ஆழ்வார் எம்பெருமானது திருமேனியைக் கண்டு","அணைவதற்காக இரவும் பகலும் வருந்திக் கூப்பிடுதல்"],"ae":"aDivaravu: sIlam koLLa Ivil kANa appan nOkki aRindhu kaNDu iDa chakkara thazhuvi ERALum","at":"அடிவரவு: சீலம் கொள்ள ஈவில் காண அப்பன் நோக்கி அறிந்து கண்டு இட சக்கர தழுவி ஏறாளும்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","37 sIlamillA [3073-3083] (Thiruvaymozhi - Fourth Decad).mp3",3189,3199]},{"he":["nAnkAm paththu","eTTAm thiruvAymozhi - ERALum","AzhvAr 'emperumAn vENDAdha en uyirum uDaimaigaLum","enakkum vENDA' enRu thalaivi pAsuraththAl pEsudhal"],"ht":["நான்காம் பத்து","எட்டாம் திருவாய்மொழி - ஏறாளும்","ஆழ்வார் 'எம்பெருமான் வேண்டாத என் உயிரும் உடைமைகளும்","எனக்கும் வேண்டா' என்று தலைவி பாசுரத்தால் பேசுதல்"],"ae":"aDivaravu: ERALum maNi maDa niRai thaLir aRivu kiLar varivaLai mEgalai uDambu uyir naNNAdhAr","at":"அடிவரவு: ஏறாளும் மணி மட நிறை தளிர் அறிவு கிளர் வரிவளை மேகலை உடம்பு உயிர் நண்ணாதார்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","38 ERALum [3084-3094] (Thiruvaymozhi - Fourth Decad).mp3",3200,3210]},{"he":["nAnkAm paththu","onbadhAm thiruvAymozhi - naNNAdhAr","AzhvAr mAlukku ATcheyyAdhu thunbuRum uyirgaLaik kaNDu, kaN kalanggi veRuppuRRu,","thammaith thiruvaDiyil sErththuk koLLumARu emperumAnai vENDudhal"],"ht":["நான்காம் பத்து","ஒன்பதாம் திருவாய்மொழி - நண்ணாதார்","ஆழ்வார் மாலுக்கு ஆட்செய்யாது துன்புறும் உயிர்களைக் கண்டு, கண் கலங்கி வெறுப்புற்று, தம்மைத் திருவடியில் சேர்த்துக் கொள்ளுமாறு எம்பெருமானை வேண்டுதல்"],"ae":"aDivaravu: naNNA sAmARu koNDu koL vAnggu maRukki AyE kATTi kUTTudhi kaNDu thiruvaDi onRum","at":"அடிவரவு: நண்ணா சாமாறு கொண்டு கொள் வாங்கு மறுக்கி ஆயே காட்டி கூட்டுதி கண்டு திருவடி ஒன்றும்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","39 naNNAdhAr [3095-3105] (Thiruvaymozhi - Fourth Decad).mp3",3211,3221]},{"he":["nAnkAm paththu","paththAm thiruvAymozhi - onRum dhEvum","'srIman nArAyaNanE paradhEvathai AgaiyAl maRRa dheyvanggaLai viTTu","avanaiyE paRRunggaL' enRu aRudhiyiTTup pEsudhal"],"ht":["நான்காம் பத்து","பத்தாம் திருவாய்மொழி - ஒன்றும் தேவும்","'ஸ்ரீமந் நாராயணனே பரதேவதை ஆகையால் மற்ற தெய்வங்களை","விட்டு அவனையே பற்றுங்கள்' என்று அறுதியிட்டுப் பேசுதல்"],"ae":"aDivaravu: onRu nADi parandha pEsa ilingga pORRi ODi pukku viLambu uRu ATchey kaiyAr","at":"அடிவரவு: ஒன்று நாடி பரந்த பேச இலிங்க போற்றி ஓடி புக்கு விளம்பு உறு ஆட்செய் கையார்","p":[],"box":["https://app.box.com/s/fk6frc6hi621rwq3tcem9d9c2koinlc3","40 onRum dhEvum [3106-3116] (Thiruvaymozhi - Fourth Decad).mp3",3222,3232]},{"he":["aindhAm paththu","ithara viShaya vairAgyaththin palanAga, kAruNikanAna","emperumAn viShayaththil kAdhal miga vinjchudhal","mudhal thiruvAymozhi - kaiyAr chakkaraththu","uNmaiyAna anbu illAdhirukka, poyyAgap pEsiya thamakku meyyAna","pERRai aLiththAn enRu AzhvAr emperumAnadhu pEraruLaip pEsudhal"],"ht":["ஐந்தாம் பத்து","இதர விஷய வைராக்யத்தின் பலனாக, காருணிகனான","எம்பெருமான் விஷயத்தில் காதல் மிக விஞ்சுதல்","முதல் திருவாய்மொழி - கையார் சக்கரத்து","உண்மையான அன்பு இல்லாதிருக்க, பொய்யாகப் பேசிய தமக்கு மெய்யான பேற்றை அளித்தான் என்று ஆழ்வார் எம்பெருமானது பேரருளைப் பேசுதல்"],"ae":"aDivaravu: kaiyAr pOnAy uLLana enkoL kaN puRam ammAn mElA AvAr AnAn kAr poliga","at":"அடிவரவு: கையார் போனாய் உள்ளன என்கொள் கண் புறம் அம்மான் மேலா ஆவார் ஆனான் கார் பொலிக","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","41 kaiyAr [3117-3127] (Thiruvaymozhi - Fifth Decad).mp3",3233,3243]},{"he":["aindhAm paththu","iraNDAm thiruvAymozhi - poliga poliga","srIvaiShNavar thiraLaik kaNDu vAzhththi, allAdhArai upadhEsiththuth thiruththudhal"],"ht":["ஐந்தாம் பத்து","இரண்டாம் திருவாய்மொழி - பொலிக பொலிக","ஸ்ரீவைஷ்ணவர் திரளைக் கண்டு வாழ்த்தி, அல்லாதாரை உபதேசித்துத் திருத்துதல்"],"ae":"aDivaravu: poliga kaNDOm thiriyum iDam sey konRu niRuththi iRukkum mEvi mikka kaliyugam mAsaRu","at":"அடிவரவு: பொலிக கண்டோம் திரியும் இடம் செய் கொன்று நிறுத்தி இறுக்கும் மேவி மிக்க கலியுகம் மாசறு","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","42 poliga poliga [3128-3138] (Thiruvaymozhi - Fifth Decad).mp3",3244,3254]},{"he":["aindhAm paththu","mUnRAm thiruvAymozhi - mAsaRu sOdhi","emperumAnadhu pirivu poRukka mATTAmal, parAngkusa nAyagi Asai","migundhu pazhikku anjchAmal maDalUrath thuNindhadhaik kURum pAsuram"],"ht":["ஐந்தாம் பத்து","மூன்றாம் திருவாய்மொழி - மாசறு சோதி","எம்பெருமானது பிரிவு பொறுக்க மாட்டாமல், பராங்குச நாயகி ஆசை","மிகுந்து பழிக்கு அஞ்சாமல் மடலூரத் துணிந்ததைக் கூறும் பாசுரம்"],"ae":"aDivaravu: mAsaRu en Urndha Ur kaDiyan annai valaiyuL pEymulai nANum yAm iraikkum Ur","at":"அடிவரவு: மாசறு என் ஊர்ந்த ஊர் கடியன் அன்னை வலையுள் பேய்முலை நாணும் யாம் இரைக்கும் ஊர்","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","43 mAsaRu [3139-3149] (Thiruvaymozhi - Fifth Decad).mp3",3255,3265]},{"he":["aindhAm paththu","nAnkAm thiruvAymozhi - UrellAm","maDal UrdhaRku iyalAdhapaDi iravu nINDadhu kuRiththuth thalaivi varundhik kURudhal"],"ht":["ஐந்தாம் பத்து","நான்காம் திருவாய்மொழி - ஊரெல்லாம்","மடல் ஊர்தற்கு இயலாதபடி இரவு நீண்டது குறித்துத் தலைவி வருந்திக் கூறுதல்"],"ae":"aDivaravu: Ur Avi nIyum peN Ar pin kAppAr dheyvam venjchuDar ninRu uRanggu engnganEyO","at":"அடிவரவு: ஊர் ஆவி நீயும் பெண் ஆர் பின் காப்பார் தெய்வம் வெஞ்சுடர் நின்று உறங்கு எங்ஙனேயோ","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","44 UrellAm [3150-3160] (Thiruvaymozhi - Fifth Decad).mp3",3266,3276]},{"he":["aindhAm paththu","aindhAm thiruvAymozhi - engnganEyO","uruveLippADu kaNDa thalaivi thAyai maRuththu uraiththal"],"ht":["ஐந்தாம் பத்து","ஐந்தாம் திருவாய்மொழி - எங்ஙனேயோ","உருவெளிப்பாடு கண்ட தலைவி தாயை மறுத்து உரைத்தல்"],"ae":"aDivaravu: engnganE en ninRiDum nIngga pakkam mElum niRaindha kaiyuL mun kazhiya aRivariya kaDal","at":"அடிவரவு: எங்ஙனே என் நின்றிடும் நீங்க பக்கம் மேலும் நிறைந்த கையுள் முன் கழிய அறிவரிய கடல்","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","45 engnganEyO [3161-3171] (Thiruvaymozhi - Fifth Decad).mp3",3277,3287]},{"he":["aindhAm paththu","ARAm thiruvAymozhi - kaDalnjAlam","kaDalnjAlaththu Isanaik kANAmal nondhu, avan thanmaigaLai anukariththu uyir tharikkap pArkkiRa parAngkusa nAyagiyin nilai kaNDa thAy, 'emperumAn AvEsiththAnO?' enRu nondhu kURum pAsuram"],"ht":["ஐந்தாம் பத்து","ஆறாம் திருவாய்மொழி - கடல்ஞாலம்","கடல்ஞாலத்து ஈசனைக் காணாமல் நொந்து, அவன் தன்மைகளை","அநுகரித்து உயிர் தரிக்கப் பார்க்கிற பராங்குச நாயகியின் நிலை கண்ட","தாய், 'எம்பெருமான் ஆவேசித்தானோ?' என்று நொந்து கூறும் பாசுரம்"],"ae":"aDivaravu: kaDal kaRkum kAN seyginRa thiRambA inavEy uRRAr urai koDIya kOlam kUndhal nORRa","at":"அடிவரவு: கற்கும் காண் செய்கின்ற திறம்பா இனவேய் உற்றார் உரை கொடீய கோலம் கூந்தல் நோற்ற","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","46 kadal njAlam [3172-3182] (Thiruvaymozhi - Fifth Decad).mp3",3288,3298]},{"he":["aindhAm paththu","EzhAm thiruvAymozhi - nORRa nOnbu","prApaka niShkarSham seyyum thiruvAymozhigaLil mudhalAvadhu;","AzhvAr thamadhu Akinjchanyaththai [kaimmudhal illAmaiyai]","eDuththuk kURi vAnamAmalaip perumAniDaththil prapaththi paNNudhal"],"ht":["ஐந்தாம் பத்து","ஏழாம் திருவாய்மொழி - நோற்ற நோன்பு","ப்ராபக நிஷ்கர்ஷம் செய்யும் திருவாய்மொழிகளில் முதலாவது;","ஆழ்வார் தமது ஆகிஞ்சன்யத்தை [கைம்முதல் இல்லாமையை]","எடுத்துக் கூறி வானமாமலைப் பெருமானிடத்தில் ப்ரபத்தி பண்ணுதல்"],"ae":"aDivaravu: nORRa anggu karuLa mARu eydha Enam vandhu agaRRa puLLin ARu dheyva ArA","at":"அடிவரவு: நோற்ற அங்கு கருள மாறு எய்த ஏனம் வந்து அகற்ற புள்ளின் ஆறு தெய்வ ஆரா","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","47 nORRa nOnbu [3183-3193] (Thiruvaymozhi - Fifth Decad).mp3",3299,3309]},{"he":["aindhAm paththu","eTTAm thiruvAymozhi - ArAvamudhE","iraNDAvadhu. AsaippaTTa payan kiDaiyAmaiyAl, ArAvamudhAzhvAriDaththil","AzhvAr tham ananyakadhithvaththai [vERevarum pugalillAmaiyai] munniTTuk","koNDu thIrAdha AsaiyuDan ARRAmai pEsi alamarudhal"],"ht":["ஐந்தாம் பத்து","எட்டாம் திருவாய்மொழி - ஆராவமுதே","இரண்டாவது. ஆசைப்பட்ட பயன் கிடையாமையால், ஆராவமுதாழ்வாரிடத்தில் ஆழ்வார் தம் அநந்யகதித்வத்தை [வேறெவரும் புகலில்லாமையை] முன்னிட்டுக்","கொண்டு தீராத ஆசையுடன் ஆற்றாமை பேசி அலமருதல்"],"ae":"aDivaravu: ArA emmAn ennAn selakkAN azhuvan sUzh ariyERu kaLaivAy isai vArA uzhalai mAnEy","at":"அடிவரவு: ஆரா எம்மான் என்நான் செலக்காண் அழுவன் சூழ் அரியேறு களைவாய் இசை வாரா உழலை மானேய்","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","48 ArAvamudhE [3194-3204] (Thiruvaymozhi - Fifth Decad).mp3",3310,3320]},{"he":["aindhAm paththu","onbadhAm thiruvAymozhi - mAnEy nOkku","mUnRAvadhu. thirukkuDandhaiyilum pERu peRAmal thiruvallavAzh sella oruppaTTa nAyagi bakthi paravasa nilaiyAlE avvUrp puRachchOlaiyil vizhundhu, thaDukkum thOzhiyarkkuth than Arththiyaik kURi, 'andhath thiruvallavAzhp pirAnai enRu aDaivEn?' enRu kURum pAsuram"],"ht":["ஐந்தாம் பத்து","ஒன்பதாம் திருவாய்மொழி - மானேய் நோக்கு","மூன்றாவது. திருக்குடந்தையிலும் பேறு பெறாமல் திருவல்லவாழ் செல்ல","ஒருப்பட்ட நாயகி பக்தி பரவச நிலையாலே அவ்வூர்ப் புறச்சோலையில்","விழுந்து, தடுக்கும் தோழியர்க்குத் தன் ஆர்த்தியைக் கூறி, 'அந்தத்","திருவல்லவாழ்ப் பிரானை என்று அடைவேன்?' என்று கூறும் பாசுரம்"],"ae":"aDivaravu: mAnEy enRu sUDu nichchalum nannala kANbadhu pAdha nADoRum kazhal thol nAmam piRandha","at":"அடிவரவு: மானேய் என்று சூடு நிச்சலும் நன்னல காண்பது பாத நாடொறும் கழல் தொல் நாமம் பிறந்த","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","49 mAnEy nOkku [3205-3215] (Thiruvaymozhi - Fifth Decad).mp3",3321,3331]},{"he":["aindhAm paththu","paththAm thiruvAymozhi - piRandhavARum","AzhvAr thAm bagavath guNAnubavaththAl urugum thanmai thavirndhu,","sErndhu anubavikkach seyyumpaDi emperumAnai vENDudhal"],"ht":["ஐந்தாம் பத்து","பத்தாம் திருவாய்மொழி - பிறந்தவாறும்","ஆழ்வார் தாம் பகவத் குணாநுபவத்தால் உருகும் தன்மை தவிர்ந்து,","சேர்ந்து அநுபவிக்கச் செய்யும்படி எம்பெருமானை வேண்டுதல்"],"ae":"aDivaravu: piRandha vadhu peyyum kaLLa uNNa ninRa oNsuDar thiruvuru kUDi nAgaNai vaigal","at":"அடிவரவு: பிறந்த வது பெய்யும் கள்ள உண்ண நின்ற ஒண்சுடர் திருவுரு கூடி நாகணை வைகல்","p":[],"box":["https://app.box.com/s/ii7mhmtxz1ntp4bdipy31im66oe6dn9m","50 piRandhavARum [3216-3226] (Thiruvaymozhi - Fifth Decad).mp3",3332,3342]},{"he":["ARAm paththu","sharaNyanAna shriya:pathiyin thiruvaDigaLilE prEmaththinAl sharaNam pugudhal","mudhal thiruvAymozhi - vaigalpUngkazhi","thalaivi thiruvaNvaNDUril uRaiyum chakravarththith thirumaganiDam","kAdhalAlE pakShigaLaith thUdhu viDudhal"],"ht":["ஆறாம் பத்து","ஶரண்யனான ஶ்ரிய:பதியின் திருவடிகளிலே ப்ரேமத்தினால் சரணம் புகுதல்","முதல் திருவாய்மொழி - வைகல்பூங்கழி","தலைவி திருவண்வண்டூரில் உறையும் சக்ரவர்த்தித்","திருமகனிடம் காதலாலே பக்ஷிகளைத் தூது விடுதல்"],"ae":"aDivaravu: vaigal kAdhal thiRam iDar uNarththa pORRi oru thirundha aDi vERu minkoL minniDai","at":"அடிவரவு: வைகல் காதல் திறம் இடர் உணர்த்த போற்றி ஒரு திருந்த அடி வேறு மின்கொள் மின்னிடை","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","51  vaigal pUngkazhivAy [3227-3237] (Thiruvaymozhi - Sixth Decad).mp3",3343,3353]},{"he":["ARAm paththu","iraNDAm thiruvAymozhi - minniDai maDavArgaL","kaNNan thAmadhiththu varak kaNDa nAyagi 'umakku vENDina sthrIgaL","irukka inggE vara vENDA' enRu UDal thiRaththinAl thaLLip pEsudhal"],"ht":["ஆறாம் பத்து","இரண்டாம் திருவாய்மொழி - மின்னிடை மடவார்கள்","கண்ணன் தாமதித்து வரக் கண்ட நாயகி 'உமக்கு வேண்டின ஸ்த்ரீகள் இருக்க இங்கே வர வேண்டா' என்று ஊடல் திறத்தினால் தள்ளிப் பேசுதல்"],"ae":"aDivaravu: min pOgu pOy Alin kazhaREl kuzhagi kanmam piNakki ugavai ninRu Aychchi nalkuravu","at":"அடிவரவு: மின் போகு போய் ஆலின் கழறேல் குழகி கன்மம் பிணக்கி உகவை நின்று ஆய்ச்சி நல்குரவு","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","52 minnidai madavArgaL [3238-3248] (Thiruvaymozhi - Sixth Decad).mp3",3354,3364]},{"he":["ARAm paththu","mUnRAm thiruvAymozhi - nalkuravum","'praNayakalahaththil muraNpaTTa thammai vasIgariththavan, muraNpaTTadhu anaiththaiyum selvamAgak koNDu thiruviNNagaril vAzhum kUDArai vellum sIrk gOvindhan' enRu aruLich cheydhal"],"ht":["ஆறாம் பத்து","மூன்றாம் திருவாய்மொழி - நல்குரவும்","'ப்ரணயகலஹத்தில் முரண்பட்ட தம்மை வசீகரித்தவன், முரண்பட்டது","அனைத்தையும் செல்வமாகக் கொண்டு திருவிண்ணகரில் வாழும்","கூடாரை வெல்லும் சீர்க் கோவிந்தன்' என்று அருளிச் செய்தல்"],"ae":"aDivaravu: nalku kaNDa nagaram puNNiyam kaithavam mUvulagu paranjchuDar vancharaN en nizhal kAN kuravai","at":"அடிவரவு: நல்கு கண்ட நகரம் புண்ணியம் கைதவம் மூவுலகு பரஞ்சுடர் வன்சரண் என் நிழல் காண் குரவை","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","53 nalkuravum [3249-3259] (Thiruvaymozhi - Sixth Decad).mp3",3365,3375]},{"he":["ARAm paththu","nAnkAm thiruvAymozhi - kuravai Aychchiyar","kaNNanuDaiya guNachEshTithanggaLai eppozhudhum pEsap peRRamaikkuk kaLiththal"],"ht":["ஆறாம் பத்து","நான்காம் திருவாய்மொழி - குரவை ஆய்ச்சியர்","கண்ணனுடைய குணசேஷ்டிதங்களை எப்பொழுதும் பேசப் பெற்றமைக்குக் களித்தல்"],"ae":"aDivaravu: kuravai kEya nigaril nOva vENDi igal manam nINilam kalakka maN nAyagan thuvaL","at":"அடிவரவு: குரவை கேய நிகரில் நோவ வேண்டி இகல் மனம் நீணிலம் கலக்க மண் நாயகன் துவள்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","54 kuravai Aychchiyar [3260-3270] (Thiruvaymozhi - Sixth Decad).mp3",3376,3386]},{"he":["ARAm paththu","aindhAm thiruvAymozhi - thuvaLil","thOzhi thAymArai nOkkik kURum pAsuraththAlE, AzhvAr","thAm emperumAniDaththu IDupaTTamaiyaip pEsudhal"],"ht":["ஆறாம் பத்து","ஐந்தாம் திருவாய்மொழி - துவளில்","தோழி தாய்மாரை நோக்கிக் கூறும் பாசுரத்தாலே, ஆழ்வார்","தாம் எம்பெருமானிடத்து ஈடுபட்டமையைப் பேசுதல்"],"ae":"aDivaravu: thuvaLil kumuRu karai niRkum kuzhaiyum nOkkum annai thirundhu iranggi pinnai sindhai mAl","at":"அடிவரவு: துவளில் குமுறு கரை நிற்கும் குழையும் நோக்கும் அன்னை திருந்து இரங்கி பின்னை சிந்தை மால்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","55 thuvaLil [3271-3281] (Thiruvaymozhi - Sixth Decad).mp3",3387,3397]},{"he":["ARAm paththu","ARAm thiruvAymozhi - mAlukku","AzhvAr emperumAnODu kalandhu vAzhap peRAmaiyAl miga naindhu,","tham uDaimaigaL thAmE thammai viTTu aganRamaiyai, pirindhu varundhum","thalaimagaLaik kuRiththuth thAy iranggum pAsuraththAl aruLich cheydhal"],"ht":["ஆறாம் பத்து","ஆறாம் திருவாய்மொழி - மாலுக்கு","ஆழ்வார் எம்பெருமானோடு கலந்து வாழப் பெறாமையால் மிக நைந்து, தம் உடைமைகள் தாமே தம்மை விட்டு அகன்றமையை, பிரிந்து வருந்தும் தலைமகளைக் குறித்துத் தாய் இரங்கும் பாசுரத்தால் அருளிச் செய்தல்"],"ae":"aDivaravu: mAl sanggu niRam pIDu paNbu kaRpagam mey sAya mANbu poRpu kaTTu uNNum","at":"அடிவரவு: மால் சங்கு நிறம் பீடு பண்பு கற்பகம் மெய் சாய மாண்பு பொற்பு கட்டு உண்ணும்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","56 mAlukku [3282-3292] (Thiruvaymozhi - Sixth Decad).mp3",3398,3408]},{"he":["ARAm paththu","EzhAm thiruvAymozhi - uNNunjchORu","AzhvAr thAraga pOshaga bOgyanggaL kaNNan enRu uNarndhu thirukkOLUril IDupaTTadhai, thalaivan nagar nOkkich senRa thalaimagaLaip paRRith thAy iranggum pAsuraththAlE aruLich cheydhal"],"ht":["ஆறாம் பத்து","ஏழாம் திருவாய்மொழி - உண்ணுஞ்சோறு","ஆழ்வார் தாரக போஷக போக்யங்கள் கண்ணன் என்று உணர்ந்து","திருக்கோளூரில் ஈடுபட்டதை, தலைவன் நகர் நோக்கிச் சென்ற","தலைமகளைப் பற்றித் தாய் இரங்கும் பாசுரத்தாலே அருளிச் செய்தல்"],"ae":"aDivaravu: uN Urum pUvai kollai mEvi inRu malgu osindha kAriyam ninai vaiththa pon","at":"அடிவரவு: உண் ஊரும் பூவை கொல்லை மேவி இன்று மல்கு ஒசிந்த காரியம் நினை வைத்த பொன்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","57 uNNum sORu [3293-3303] (Thiruvaymozhi - Sixth Decad).mp3",3409,3419]},{"he":["ARAm paththu","eTTAm thiruvAymozhi - ponnulagu","'aishvaryap parappAl thammai maRandha emperumAn aDiyArODu Ekarasan AgaiyAlE thUdhu viTTAl varuvan' enRu eNNi, parathvam mudhaliyavaRRil parAngkusa nAyagi paRavaigaLaith thUdhu viDudhal"],"ht":["ஆறாம் பத்து","எட்டாம் திருவாய்மொழி - பொன்னுலகு","'ஐஶ்வர்யப் பரப்பால் தம்மை மறந்த எம்பெருமான் அடியாரோடு ஏகரஸன்","ஆகையாலே தூது விட்டால் வருவன்' என்று எண்ணி, பரத்வம்","முதலியவற்றில் பராங்குச நாயகி பறவைகளைத் தூது விடுதல்"],"ae":"aDivaravu: pon mai ODi thUmadhu nunggaL en pUvai pAsaRa pErththu vandhu mARRam nIr","at":"அடிவரவு: பொன் மை ஓடி தூமது நுங்கள் என் பூவை பாசற பேர்த்து வந்து மாற்றம் நீர்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","58 ponnulagu [3304-3314] (Thiruvaymozhi - Sixth Decad).mp3",3420,3430]},{"he":["ARAm paththu","onbadhAm thiruvAymozhi - nIrAy","kETTavargaL nenjchu nIrAyk karaiyavum, thirumAlukkum paramapadhaththil","iruppu aridhAgavum, AzhvAr ArAdha kAdhaluDan kUppiDudhal"],"ht":["ஆறாம் பத்து","ஒன்பதாம் திருவாய்மொழி - நீராய்","கேட்டவர்கள் நெஞ்சு நீராய்க் கரையவும், திருமாலுக்கும் பரமபதத்தில்","இருப்பு அரிதாகவும், ஆழ்வார் ஆராத காதலுடன் கூப்பிடுதல்"],"ae":"aDivaravu: nIr maN njAlam thaLarndhu viN pAy ulagu aRivu Avi kuRugA theridhal ulagam","at":"அடிவரவு: நீர் மண் ஞாலம் தளர்ந்து விண் பாய் உலகு அறிவு ஆவி குறுகா தெரிதல் உலகம்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","59 nIrAy [3315-3325] (Thiruvaymozhi - Sixth Decad).mp3",3431,3441]},{"he":["ARAm paththu","paththAm thiruvAymozhi - ulagamuNDa","alarmEl manggai puruShakAramAgath thiruvEngkaDamuDaiyAnadhu","thiruvaDigaLil sharaNam pugudhal"],"ht":["ஆறாம் பத்து","பத்தாம் திருவாய்மொழி - உலகமுண்ட","அலர்மேல் மங்கை புருஷகாரமாகத் திருவேங்கடமுடையானது","திருவடிகளில் ஶரணம் புகுதல்"],"ae":"aDivaravu: ulagam kURu vaNNam AvA puNarA ennAL aDiyEn nOlAdhu vandhAy agal aDikkIzh uL","at":"அடிவரவு: உலகம் கூறு வண்ணம் ஆவா புணரா எந்நாள் அடியேன் நோலாது வந்தாய் அகல் அடிக்கீழ் உள்","p":[],"box":["https://app.box.com/s/p4535wq6s76bqod7cu0uhgdevgzog1pf","60 ulagamuNda [3326-3336] (Thiruvaymozhi - Sixth Decad).mp3",3442,3452]},{"he":["EzhAm paththu","sarvashakthanAna emperumAn thiRaththil, sAdhanapalamAgath thiruvAymozhi","pADuviththa upakAraththiRkuk kaimmARu ilAmaiyaip pEsudhal","mudhal thiruvAymozhi - uNNilAviya","'emperumAn than thiruvaDigaLil sErAthapaDi innum indhriyanggaLAlE","eththanai nAL nalivippanO?' enRu AzhvAr OlamiDudhal"],"ht":["ஏழாம் பத்து","ஸர்வசக்தனான எம்பெருமான் திறத்தில், ஸாதனபலமாகத் திருவாய்மொழி","பாடுவித்த உபகாரத்திற்குக் கைம்மாறு இலாமையைப் பேசுதல்","முதல் திருவாய்மொழி - உண்ணிலாவிய","'எம்பெருமான் தன் திருவடிகளில் சேராதபடி இன்னும் இந்த்ரியங்களாலே","எத்தனை நாள் நலிவிப்பனோ?' என்று ஆழ்வார் ஓலமிடுதல்"],"ae":"aDivaravu: uL ennai vEdhi sUdhu thIr viN onRu innam kulam en koNDa kanggul","at":"அடிவரவு: உள் என்னை வேதி சூது தீர் விண் ஒன்று இன்னம் குலம் என் கொண்ட கங்குல்","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","61 uNNilAviya [3337-3347]  Seventh Decad.mp3",3453,3463]},{"he":["EzhAm paththu","iraNDAm thiruvAymozhi - kanggulum pagalum","parAngkusa nAyagi periya perumALiDaththu mOhiththirukka, 'innAyagi","viShayamAga en seyya nIr eNNuginRIr?' enRu thiruththAyAr kETkum pAsuram"],"ht":["ஏழாம் பத்து","இரண்டாம் திருவாய்மொழி - கங்குலும் பகலும்","பராங்குச நாயகி பெரிய பெருமாளிடத்து மோஹித்திருக்க, 'இந்நாயகி விஷயமாக என் செய்ய நீர் எண்ணுகின்றீர்?' என்று திருத்தாயார் கேட்கும் பாசுரம்"],"ae":"aDivaravu: kanggulum en vaTkilaL iTTa sindhikkum maiyal pAla kozhundhu en muDivu mugil veLLai","at":"அடிவரவு: கங்குலும் என் வட்கிலள் இட்ட சிந்திக்கும் மையல் பால கொழுந்து என் முடிவு முகில் வெள்ளை","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","62 kangulum pagalum [3348-3358].mp3",3464,3474]},{"he":["EzhAm paththu","mUnRAm thiruvAymozhi - veLLaich surisanggu","thirunAmam kETTu mayakkam theLindha pin, thAymArum thOzhimArum thaDukkavum,","nAyagi thiruppEraikkuch selvEn enRu thuNindhadhaik kURum pAsuram"],"ht":["ஏழாம் பத்து","மூன்றாம் திருவாய்மொழி - வெள்ளைச் சுரிசங்கு","திருநாமம் கேட்டு மயக்கம் தெளிந்த பின், தாய்மாரும் தோழிமாரும் தடுக்கவும், நாயகி திருப்பேரைக்குச் செல்வேன் என்று துணிந்ததைக் கூறும் பாசுரம்"],"ae":"aDivaravu: veLLai nAna sengkani izhandha munindhu kAlam pEreyil kaNDadhu sErvan nagaram Uzhi Azhi","at":"அடிவரவு: வெள்ளை நான செங்கனி இழந்த முனிந்து காலம் பேரெயில் கண்டது சேர்வன் நகரம் ஊழி ஆழி","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","63 veLLai[3359-3369].mp3",3475,3485]},{"he":["EzhAm paththu","nAnkAm thiruvAymozhi - Azhiyezha","emperumAnadhu vijaya paramparaigaLai avan kATTak kaNDu pEsudhal"],"ht":["ஏழாம் பத்து","நான்காம் திருவாய்மொழி - ஆழியெழ","எம்பெருமானது விஜய பரம்பரைகளை அவன் காட்டக் கண்டு பேசுதல்"],"ae":"aDivaravu: Azhi ARu nanRu nALum UN pOzhdhu mARu nEr anRu mEy kunRam kaRpAr","at":"அடிவரவு: ஆழி ஆறு நன்று நாளும் ஊண் போழ்து மாறு நேர் அன்று மேய் குன்றம் கற்பார்","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","64 Azhiyezha [3370-3380].mp3",3486,3496]},{"he":["EzhAm paththu","aindhAm thiruvAymozhi - kaRpAr","vijayanggaLukku aDiyAna vibavAvathAra guNanggaLai anusandhiththu, 'indha","guNAnubavaththai izhakkiRArgaLE!' enRu ulagaththArai nOkki AzhvAr iranggudhal"],"ht":["ஏழாம் பத்து","ஐந்தாம் திருவாய்மொழி - கற்பார்","விஜயங்களுக்கு அடியான விபவாவதார குணங்களை அநுசந்தித்து, 'இந்த குணாநுபவத்தை இழக்கிறார்களே!' என்று உலகத்தாரை நோக்கி ஆழ்வார் இரங்குதல்"],"ae":"aDivaravu: kaRpAr nATTil kETpAr thanmai sUzhal kETTu kaNDu sella mAya vArththai theLivu pAmaru","at":"அடிவரவு: கற்பார் நாட்டில் கேட்பார் தன்மை சூழல் கேட்டு கண்டு செல்ல மாய வார்த்தை தெளிவு பாமரு","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","65 kaRpAr [3381-3391].mp3",3497,3507]},{"he":["EzhAm paththu","ARAm thiruvAymozhi - pAmaru mUvulagum","emperumAnadhu guNam azhagu mudhaliyavaRRai manaththAl anubaviththu,","avanai nEril kaNDu anubavikka AsaippaTTu AzhvAr manamurugik kUppiDudhal"],"ht":["ஏழாம் பத்து","ஆறாம் திருவாய்மொழி - பாமரு மூவுலகும்","எம்பெருமானது குணம் அழகு முதலியவற்றை மனத்தால் அநுபவித்து, அவனை நேரில் கண்டு அநுபவிக்க ஆசைப்பட்டு ஆழ்வார் மனமுருகிக் கூப்பிடுதல்"],"ae":"aDivaravu: pAmaru enRu kAththa enggu ennuDaiya vandhu enthiru ALi kANDu ERRa pukka Ezhai","at":"அடிவரவு: பாமரு என்று காத்த எங்கு என்னுடைய வந்து என்திரு ஆளி காண்டு ஏற்ற புக்க ஏழை","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","66 pAmaru [3392-3402].mp3",3508,3518]},{"he":["EzhAm paththu","EzhAm thiruvAymozhi - Ezhaiyar","emperumAnadhu dhivya avayava saundharyam uruveLith thORRaththAl","sUzha vandhu kATchi aLikka, adhanAl varundhum thalaivi solliya pAsuram"],"ht":["ஏழாம் பத்து","ஏழாம் திருவாய்மொழி - ஏழையர்","எம்பெருமானது திவ்ய அவயவ ஸௌந்தர்யம் உருவெளித் தோற்றத்தால் சூழ வந்து காட்சி அளிக்க, அதனால் வருந்தும் தலைவி சொல்லிய பாசுரம்"],"ae":"aDivaravu: Ezhai ATTi vAliya innuyir enRu uyviDam kAN kOLizhai koL niRRi kaTkariya mAyA","at":"அடிவரவு: ஏழை ஆட்டி வாலிய இன்னுயிர் என்று உய்விடம் காண் கோளிழை கொள் நிற்றி கட்கரிய மாயா","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","67 Ezhaiyar [3403-3413].mp3",3519,3529]},{"he":["EzhAm paththu","eTTAm thiruvAymozhi - mAyA vAmananE","pirivAl mAyAdhapaDi thammai vaiththa vichiththira sakthi uDaiya emperumAnadhu","vichiththira vibUthiyai avan kATTak kaNDu AzhvAr AchchariyappaDudhal"],"ht":["ஏழாம் பத்து","எட்டாம் திருவாய்மொழி - மாயா வாமனனே","பிரிவால் மாயாதபடி தம்மை வைத்த விசித்திர சக்தி உடைய எம்பெருமானது","விசித்திர விபூதியை அவன் காட்டக் கண்டு ஆழ்வார் ஆச்சரியப்படுதல்"],"ae":"aDivaravu: mAyA angkaN chiththira kaLLavizh pAsa mayakkA thuyaram enna ennaviyaRkai illai Am enRai","at":"அடிவரவு: மாயா அங்கண் சித்திர கள்ளவிழ் பாச மயக்கா துயரம் என்ன என்னவியற்கை இல்லை ஆம் என்றை","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","68 mAyA [3414-3424].mp3",3530,3540]},{"he":["EzhAm paththu","onbadhAm thiruvAymozhi - enRaikkum","emperumAn thanakkum than aDiyArkkum inidhAgak kavi pADumpaDi thammai","inggu vaiththadhaRkuk kaimmARu illAmaiyai AzhvAr aruLich cheydhal"],"ht":["ஏழாம் பத்து","ஒன்பதாம் திருவாய்மொழி - என்றைக்கும்","எம்பெருமான் தனக்கும் தன் அடியார்க்கும் இனிதாகக் கவி பாடும்படி தம்மை இங்கு வைத்ததற்குக் கைம்மாறு இல்லாமையை ஆழ்வார் அருளிச் செய்தல்"],"ae":"aDivaravu: enRai en Amudhalvan appan sIr in vaikundha ArvanO thiRaththu udhavi inggum inbam","at":"அடிவரவு: என்றை என் ஆமுதல்வன் அப்பன் சீர் இன் வைகுந்த ஆர்வனோ திறத்து உதவி இங்கும் இன்பம்","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","69 enRaikkum [3425-3435].mp3",3541,3551]},{"he":["EzhAm paththu","paththAm thiruvAymozhi - inbam payakka","inbakkavi pADuviththa srImannArAyaNanai AzhvAr","thiruvARanviLaiyil senRu kaNDu aDimai seyyak karudhal"],"ht":["ஏழாம் பத்து","பத்தாம் திருவாய்மொழி - இன்பம் பயக்க","இன்பக்கவி பாடுவித்த ஸ்ரீமந்நாராயணனை ஆழ்வார்","திருவாறன்விளையில் சென்று கண்டு அடிமை செய்யக் கருதல்"],"ae":"aDivaravu: inbam Agum kUDum vAykkum malar onRu nINagaram anRi thIvinai sindhai thIrththan dhEvi","at":"அடிவரவு: இன்பம் ஆகும் கூடும் வாய்க்கும் மலர் ஒன்று நீணகரம் அன்றி தீவினை சிந்தை தீர்த்தன் தேவி","p":[],"box":["https://app.box.com/s/98p5557tpnud0gek16mp1nf34a53qsfj","70 inbam [3436-3446].mp3",3552,3562]},{"he":["eTTAm paththu","sathyakAmanAna emperumAn thiRaththil nanRi aRivAl kalanggik kaimmARAga","samarppikkap peRRa tham Athma svarUpaththin thanmai uNardhal","mudhal thiruvAymozhi - dhEvimArAvAr","emperumAn thamadhu ninaivaith thalaikkaTTAmaiyAl, AzhvAr avanadhu Ashritha pArathanthriyam, yAvaiyum thAnAm nilaimai ivaigaLaich sanggiththuth theLidhal"],"ht":["எட்டாம் பத்து","ஸத்யகாமனான எம்பெருமான் திறத்தில் நன்றி அறிவால் கலங்கிக் கைம்மாறாக ஸமர்ப்பிக்கப் பெற்ற தம் ஆத்ம ஸ்வரூபத்தின் தன்மை உணர்தல்","முதல் திருவாய்மொழி - தேவிமாராவார்","எம்பெருமான் தமது நினைவைத் தலைக்கட்டாமையால், ஆழ்வார் அவனது ஆஶ்ரித பாரதந்த்ரியம், யாவையும் தானாம் நிலைமை இவைகளைச் சங்கித்துத் தெளிதல்"],"ae":"aDivaravu: dhEvi kANum eDuththa umar Aruyir enggu iRandha maNam yAnum thAL periya nanggaL","at":"அடிவரவு: தேவி காணும் எடுத்த உமர் ஆருயிர் எங்கு இறந்த மணம் யானும் தாள் பெரிய னங்கள்","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","71 dhEvimArAvAr [3447-3457] Eighth Decad.mp3",3563,3573]},{"he":["eTTAm paththu","iraNDAm thiruvAymozhi - nanggaL varivaLai","AzhvAr thAm tham AthmAvilum, adhaich sErndhavaRRilum AsaiyaRRup pOnadhai,","thalaivanai nOkkich sellak karudhiya thalaivi pEchchAlE aruLich cheydhal"],"ht":["எட்டாம் பத்து","இரண்டாம் திருவாய்மொழி - நங்கள் வரிவளை","ஆழ்வார் தாம் தம் ஆத்மாவிலும், அதைச் சேர்ந்தவற்றிலும் ஆசையற்றுப் போனதை, தலைவனை நோக்கிச் செல்லக் கருதிய தலைவி பேச்சாலே அருளிச் செய்தல்"],"ae":"aDivaravu: nanggaL vENDi kAlam kUDa Azhi thollai mAl iDai kAN en pAdham anggu","at":"அடிவரவு: நங்கள் வேண்டி காலம் கூட ஆழி தொல்லை மால் இடை காண் என் பாதம் அங்கு","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","72 nangkaL varivaLai [3458-3468].mp3",3574,3584]},{"he":["eTTAm paththu","mUnRAm thiruvAymozhi - anggum inggum","AzhvAr ivvibUthiyil emperumAnukkup parivar illAmai paRRi anjchi,","appirAn aruLAl enggum parivar uLar enRu uNarndhu bayam thIrdhal"],"ht":["எட்டாம் பத்து","மூன்றாம் திருவாய்மொழி - அங்கும் இங்கும்","ஆழ்வார் இவ்விபூதியில் எம்பெருமானுக்குப் பரிவர் இல்லாமை பற்றி அஞ்சி, அப்பிரான் அருளால் எங்கும் பரிவர் உளர் என்று உணர்ந்து பயம் தீர்தல்"],"ae":"aDivaravu: anggu saraNam ALum njAlam koDi paNi varuvAr enRE thirumAl kalakka urai vAr","at":"அடிவரவு: அங்கு சரணம் ஆளும் ஞாலம் கொடி பணி வருவார் என்றே திருமால் கலக்க உரை வார்","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","73 angkum ingkum [3469-3479].mp3",3585,3595]},{"he":["eTTAm paththu","nAnkAm thiruvAymozhi - vArkaDAvaruvi","emperumAn thanadhu valimaiyaiyum parivar palar iruppadhaiyum","kATTa, AzhvAr thiruchchengkunRUril kaNDu magizhdhal"],"ht":["எட்டாம் பத்து","நான்காம் திருவாய்மொழி - வார்கடாவருவி","எம்பெருமான் தனது வலிமையையும் பரிவர் பலர் இருப்பதையும்","காட்ட, ஆழ்வார் திருச்செங்குன்றூரில் கண்டு மகிழ்தல்"],"ae":"aDivaravu: vAr enggaL en piRidhu alladhu enakkuth thiru thigazha paDai amar thEnai mAya","at":"அடிவரவு: வார் எங்கள் என் பிறிது அல்லது எனக்குத் திரு திகழ படை அமர் தேனை மாய","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","74 vArkadA [3480-3490].mp3",3596,3606]},{"he":["eTTAm paththu","aindhAm thiruvAymozhi - mAyakkUththA","emperumAn vaDivazhagai nEril kANamATTAdhu AzhvAr viDAy vinjchi azhudhu araRRudhal"],"ht":["எட்டாம் பத்து","ஐந்தாம் திருவாய்மொழி - மாயக்கூத்தா","எம்பெருமான் வடிவழகை நேரில் காணமாட்டாது","ஆழ்வார் விடாய் விஞ்சி அழுது அரற்றுதல்"],"ae":"aDivaravu: mAya kANa muDi thUnIr sol koNDal vandhu okkum idhuvO piRandha enggE elli","at":"அடிவரவு: மாய காண முடி தூநீர் சொல் கொண்டல் வந்து ஒக்கும் இதுவோ பிறந்த எங்கே எல்லி","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","75 mAyakkUththA [3491-3501].mp3",3607,3617]},{"he":["eTTAm paththu","ARAm thiruvAymozhi - elliyum","AzhvAradhu peruviDAy thIrak kalakkak karudhith thirumAl thirukkaDiththAnaththil","sEvai sAdhikka, AzhvAr thAm thariththamai kURudhal"],"ht":["எட்டாம் பத்து","ஆறாம் திருவாய்மொழி - எல்லியும்","ஆழ்வாரது பெருவிடாய் தீரக் கலக்கக் கருதித் திருமால் திருக்கடித்தானத்தில்","சேவை சாதிக்க, ஆழ்வார் தாம் தரித்தமை கூறுதல்"],"ae":"aDivaravu: elli thiru oruvar mAya kOyil kUththa koNmin thAna thAya aRpudhan sOlai iruththum","at":"அடிவரவு: எல்லி திரு ஒருவர் மாய கோயில் கூத்த கொண்மின் தான தாய அற்புதன் சோலை இருத்தும்","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","76 elliyum [3502-3512].mp3",3618,3628]},{"he":["eTTAm paththu","EzhAm thiruvAymozhi - iruththum","thammiDam vandhu thAm eNNiyapaDi ellAm emperumAn kalakka, andhak kalaviyai 'mayakkamO?' ena aiyamuRRu, uNmai enath theLindhu AzhvAr emperumAnadhu guNanggaLaip pEsudhal"],"ht":["எட்டாம் பத்து","ஏழாம் திருவாய்மொழி - இருத்தும்","தம்மிடம் வந்து தாம் எண்ணியபடி எல்லாம் எம்பெருமான் கலக்க,","அந்தக் கலவியை 'மயக்கமோ?' என ஐயமுற்று, உண்மை எனத்","தெளிந்து ஆழ்வார் எம்பெருமானது குணங்களைப் பேசுதல்"],"ae":"aDivaravu: iruththum irundhAn aruL mAya thigazhum poruL sevvAy aRiyEn vayiRRil vaiththEn suDar kaNgaL","at":"அடிவரவு: இருத்தும் இருந்தான் அருள் மாய திகழும் பொருள் செவ்வாய் அறியேன் வயிற்றில் வைத்தேன் சுடர் கண்கள்","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","77 iruththum [3513-3523].mp3",3629,3639]},{"he":["eTTAm paththu","eTTAm thiruvAymozhi - kaNgaL sivandhu","thanadhu kalaviyai uRudhi peRRadhu AkkuvadhaRkAga AthmasvarUpa","vailakShaNyaththai emperumAn kATTa, AzhvAr adhanaip pEsudhal"],"ht":["எட்டாம் பத்து","எட்டாம் திருவாய்மொழி - கண்கள் சிவந்து","தனது கலவியை உறுதி பெற்றது ஆக்குவதற்காக ஆத்மஸ்வரூப","வைலக்ஷண்யத்தை எம்பெருமான் காட்ட, ஆழ்வார் அதனைப் பேசுதல்"],"ae":"aDivaravu: kaN aDiyEn uNarvil yAnum ninRa nanRAy adhuvE eyththAr kUDi uLarum theruLum karumANikka","at":"அடிவரவு: கண் அடியேன் உணர்வில் யானும் நின்ற நன்றாய் அதுவே எய்த்தார் கூடி உளரும் தெருளும் கருமாணிக்க","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","78 kaNgaL sivandhu [3524-3534].mp3",3640,3650]},{"he":["eTTAm paththu","onbadhAm thiruvAymozhi - karumANikkam","AzhvAr thamadhu ananyArhashEShathvaththai, thOzhi maNavilakkukkAgath","thAymArODu kURum pAsuraththAlE aruLich cheydhal"],"ht":["எட்டாம் பத்து","ஒன்பதாம் திருவாய்மொழி - கருமாணிக்கம்","ஆழ்வார் தமது அநந்யார்ஹஶேஷத்வத்தை, தோழி மணவிலக்குக்காகத்","தாய்மாரோடு கூறும் பாசுரத்தாலே அருளிச் செய்தல்"],"ae":"aDivaravu: karumANikka annaimIr pugazhum Ur punai thiru mellilai maDavaral paravAL anRi nEr neDumAl","at":"அடிவரவு: கருமாணிக்க அன்னைமீர் புகழும் ஊர் புனை திரு மெல்லிலை மடவரல் பரவாள் அன்றி நேர் நெடுமால்","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","79  karumANikkam [3535-3545].mp3",3651,3661]},{"he":["eTTAm paththu","paththAm thiruvAymozhi - neDumARkaDimai","ananyArhashEShathvaththukku ellai nilamAna bhAgavatha","shEShathvam thamakku viLaindhadhai AzhvAr pEsudhal"],"ht":["எட்டாம் பத்து","பத்தாம் திருவாய்மொழி - நெடுமாற்கடிமை","அநந்யார்ஹஶேஷத்வத்துக்கு எல்லை நிலமான பாகவத","ஶேஷத்வம் தமக்கு விளைந்ததை ஆழ்வார் பேசுதல்"],"ae":"aDivaravu: neDumAl viyan uRumO inggE vazhi nugarchchi thanimA nALum thamargaL vAykka nalla koNDa","at":"அடிவரவு: நெடுமால் வியன் உறுமோ இங்கே வழி நுகர்ச்சி தனிமா நாளும் தமர்கள் வாய்க்க நல்ல கொண்ட","p":[],"box":["https://app.box.com/s/i0sc4oatn8pku6yo1c81uh8qpkeo07v7","80 nedumARkadimai [3546-3556].mp3",3662,3672]},{"he":["onbadhAm paththu","Apaththukkudhavum naNbanAna sarvEshvaranAlE 'kIzhp paththil peRRa Athmadharshanaththin palanAga nIr ennai aDaivadhu indha dhEhaththin muDivilE' enRu nALiTTuk koDukkap peRudhal","mudhal thiruvAymozhi - koNDapeNDir","'karmaththAl ERpaTTa uRavinarai viTTu, iyaRkai uRavinanAy aDiyArkku","ATpaDuththum emperumAnai paRRunggaL' enRu AzhvAr piRarkku upadhEsiththal"],"ht":["ஒன்பதாம் பத்து","ஆபத்துக்குதவும் நண்பனான ஸர்வேஶ்வரனாலே 'கீழ்ப் பத்தில் பெற்ற","ஆத்மதர்ஶனத்தின் பலனாக நீர் என்னை அடைவது இந்த","தேஹத்தின் முடிவிலே' என்று நாளிட்டுக் கொடுக்கப் பெறுதல்","முதல் திருவாய்மொழி - கொண்டபெண்டிர்","'கர்மத்தால் ஏற்பட்ட உறவினரை விட்டு, இயற்கை உறவினனாய் அடியார்க்கு ஆட்படுத்தும் எம்பெருமானை பற்றுங்கள்' என்று ஆழ்வார் பிறர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: koNDa thuNai poruL araN sadhuram illai maRRonRu vAzhdhal yAdhu kaNNan Adhu paNDai","at":"அடிவரவு: கொண்ட துணை பொருள் அரண் சதுரம் இல்லை மற்றொன்று வாழ்தல் யாது கண்ணன் ஆது பண்டை","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","81 koNda peNdir [3557-3567] Ninth Decad.mp3",3673,3683]},{"he":["onbadhAm paththu","iraNDAm thiruvAymozhi - paNDainALAlE","AzhvAr iyaRkai uRavinAna emperumAnaith thiruppuLingkuDiyil kaNDu","thamakku ellA uRavin kAriyamum kuRaivillAmal aruLumARu prArththiththal"],"ht":["ஒன்பதாம் பத்து","இரண்டாம் திருவாய்மொழி - பண்டைநாளாலே","ஆழ்வார் இயற்கை உறவினான எம்பெருமானைத் திருப்புளிங்குடியில் கண்டு தமக்கு எல்லா உறவின் காரியமும் குறைவில்லாமல் அருளுமாறு ப்ரார்த்தித்தல்"],"ae":"aDivaravu: paNDai kuDi kiDandha puLi pavaLam kAysina emmiDar enggaL vIRRu koDuvinai kUvudhal Or","at":"அடிவரவு: பண்டை குடி கிடந்த புளி பவளம் காய்சின எம்மிடர் எங்கள் வீற்று கொடுவினை கூவுதல் ஓர்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","82 paNdai nALAlE [3568-3578].mp3",3684,3694]},{"he":["onbadhAm paththu","mUnRAm thiruvAymozhi - OrAyiram","emperumAn 'nIr virumbiyadhai ellAm thara valla nArAyaNan anRO nAn'","enRu than pEruRavaik kATTa, AzhvAr avan sIlaththil IDupaTTup pEsudhal"],"ht":["ஒன்பதாம் பத்து","மூன்றாம் திருவாய்மொழி - ஓராயிரம்","எம்பெருமான் 'நீர் விரும்பியதை எல்லாம் தர வல்ல நாராயணன் அன்றோ நான்' என்று தன் பேருறவைக் காட்ட, ஆழ்வார் அவன் சீலத்தில் ஈடுபட்டுப் பேசுதல்"],"ae":"aDivaravu: Or avanE aRindhana marundhE manam aDai Agam inRi thozhudhu thAL sIlam mai","at":"அடிவரவு: ஓர் அவனே அறிந்தன மருந்தே மனம் அடை ஆகம் இன்றி தொழுது தாள் சீலம் மை","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","83 OrAyiram [3579-3589].mp3",3695,3705]},{"he":["onbadhAm paththu","nAnkAm thiruvAymozhi - maiyAr","AzhvAr thirumAlaich sanggu chakkaranggaLuDan kANa vENDik kAdhaluDan","kUppiTTu angnganamE peRRamaiyai ugandhu aruLich cheydhal"],"ht":["ஒன்பதாம் பத்து","நான்காம் திருவாய்மொழி - மையார்","ஆழ்வார் திருமாலைச் சங்கு சக்கரங்களுடன் காண வேண்டிக் காதலுடன்","கூப்பிட்டு அங்ஙனமே பெற்றமையை உகந்து அருளிச் செய்தல்"],"ae":"aDivaravu: mai kaN azhai uRuvadhu ari karuththE ugandhu uru kaN aDiyAn ARA innuyir","at":"அடிவரவு: மை கண் அழை உறுவது அரி கருத்தே உகந்து உரு கண் அடியான் ஆறா இன்னுயிர்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","84 maiyAr [3590-3600].mp3",3706,3716]},{"he":["onbadhAm paththu","aindhAm thiruvAymozhi - innuyirchchEval","nenjchil kaNDa nAyaganai nEril kANa AsaippaTTa parAngkusa nAyagi,","avanai ninaivikkum poruLgaLAl thAn thaLarndhamai kURudhal"],"ht":["ஒன்பதாம் பத்து","ஐந்தாம் திருவாய்மொழி - இன்னுயிர்ச்சேவல்","நெஞ்சில் கண்ட நாயகனை நேரில் காண ஆசைப்பட்ட பராங்குச நாயகி,","அவனை நினைவிக்கும் பொருள்களால் தான் தளர்ந்தமை கூறுதல்"],"ae":"aDivaravu: innuyir iththanai avan kUkkural andharam nanku kUTTu uyir paNbu ezha inbam urugum","at":"அடிவரவு: இன்னுயிர் இத்தனை அவன் கூக்குரல் அந்தரம் நன்கு கூட்டு உயிர் பண்பு எழ இன்பம் உருகும்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","85 innuyir [3601-3611].mp3",3717,3727]},{"he":["AzhvAr thiruvaDigaLE charaNam","onbadhAm paththu","ARAm thiruvAymozhi - urugumAl","AzhvAr emperumAnadhu guNanggaLai innAppuDan kURi aruLudhal"],"ht":["ஒன்பதாம் பத்து","ஆறாம் திருவாய்மொழி - உருகுமால்","ஆழ்வார் எம்பெருமானது குணங்களை இன்னாப்புடன் கூறி அருளுதல்"],"ae":"aDivaravu: urugu ninai nIrmai aRigilEn thiruvaruL en kATkarai kOL Aruyir vAri kaDiya engkAnal","at":"அடிவரவு: உருகு நினை நீர்மை அறிகிலேன் திருவருள் என் காட்கரை கோள் ஆருயிர் வாரி கடிய எங்கானல்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","86 urugumAl [3612-3622].mp3",3728,3738]},{"he":["onbadhAm paththu","EzhAm thiruvAymozhi - engkAnal","parAngkusa nAyagi 'en kAdhalukkuk kAraNam thirumAlin vaDivazhagE' enRu emperumAnadhu vaDivazhagE paRRAsAgath thirumUzhikkaLaththE paRavaigaLaith thUdhu viDudhal"],"ht":["ஒன்பதாம் பத்து","ஏழாம் திருவாய்மொழி - எங்கானல்","பராங்குச நாயகி 'என் காதலுக்குக் காரணம் திருமாலின் வடிவழகே' என்று எம்பெருமானது வடிவழகே பற்றாசாகத் திருமூழிக்களத்தே பறவைகளைத் தூது விடுதல்"],"ae":"aDivaravu: engkAnal numar thakkilam thirumEni theLi thUdhu suDar enakku pUnthuzhAy thagavu ozhivu aRukkum","at":"அடிவரவு: எங்கானல் நுமர் தக்கிலம் திருமேனி தெளி தூது சுடர் எனக்கு பூந்துழாய் தகவு ஒழிவு அறுக்கும்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","87 engkAnal [3623-3633].mp3",3739,3749]},{"he":["onbadhAm paththu","eTTAm thiruvAymozhi - aRukkumvinai","emperumAn pAl thUdhu pOga viTTa paRavaigaL varak kANAmaiyAlE thalaivi","thalaivanadhu nagarAna thirunAvAyil sella ninaindhamai kURum","mugaththAl AzhvAr thamadhu prApya thvaraiyaith theriviththal"],"ht":["ஒன்பதாம் பத்து","எட்டாம் திருவாய்மொழி - அறுக்கும்வினை","எம்பெருமான் பால் தூது போக விட்ட பறவைகள் வரக் காணாமையாலே","தலைவி தலைவனது நகரான திருநாவாயில் செல்ல நினைந்தமை","கூறும் முகத்தால் ஆழ்வார் தமது ப்ராப்ய த்வரையைத் தெரிவித்தல்"],"ae":"aDivaravu: aRukkum koDi evai nAL maNALan kaNDE kOvAgiya aruL dhEvar andhO vaNNam malligai","at":"அடிவரவு: அறுக்கும் கொடி எவை நாள் மணாளன் கண்டே கோவாகிய அருள் தேவர் அந்தோ வண்ணம் மல்லிகை","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","88 aRukkum [3634-3644].mp3",3750,3760]},{"he":["onbadhAm paththu","onbadhAm thiruvAymozhi - malligai","thalaivi thanadhu ARRAmaiyAl varundhiyadhaik kURum pAsuraththAlE","thamadhu pirivuth thunbaththai AzhvAr theriviththal"],"ht":["ஒன்பதாம் பத்து","ஒன்பதாம் திருவாய்மொழி - மல்லிகை","தலைவி தனது ஆற்றாமையால் வருந்தியதைக் கூறும்","பாசுரத்தாலே தமது பிரிவுத் துன்பத்தை ஆழ்வார் தெரிவித்தல்"],"ae":"aDivaravu: malligai pugal ini pAviyEn yAmuDai avan Arukku pudhumaNam Udhum mAlaiyum avanai mAlai","at":"அடிவரவு: மல்லிகை புகல் இனி பாவியேன் யாமுடை அவன் ஆருக்கு புதுமணம் ஊதும் மாலையும் அவனை மாலை","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","89 malligai [3645-3655].mp3",3761,3771]},{"he":["onbadhAm paththu","paththAm thiruvAymozhi - mAlai naNNi","'nIr virumbiyavai yAvum umadhu ivvuDambu muDiyum pOdhu tharuvEn'","enRu AzhvArukku emperumAn aruLa, avar uvandhu, thirukkaNNapuraththilE","senRu avanaich sErumARu piRarkku upadhEsiththal"],"ht":["ஒன்பதாம் பத்து","பத்தாம் திருவாய்மொழி - மாலை நண்ணி","'நீர் விரும்பியவை யாவும் உமது இவ்வுடம்பு முடியும் போது தருவேன்'","என்று ஆழ்வாருக்கு எம்பெருமான் அருள, அவர் உவந்து,","திருக்கண்ணபுரத்திலே சென்று அவனைச் சேருமாறு பிறர்க்கு உபதேசித்தல்"],"ae":"aDivaravu: mAlai kaL thoNDar mAnai saraNam anban meyyan aNiyan pAdham illai pADu thAL","at":"அடிவரவு: மாலை கள் தொண்டர் மானை சரணம் அன்பன் மெய்யன் அணியன் பாதம் இல்லை பாடு தாள்","p":[],"box":["https://app.box.com/s/v3pfjbrirfy1qf6ou3q6cr16gohknfw5","90 mAlai naNNi [3656-3666].mp3",3772,3782]},{"he":["paththAm paththu","aDiyAr varuththam thIrkkum emperumAnai, uDambu muDindhavuDan","peRum phalamAna archchirAdhigadhikkuth thuNaiyAgak koLLudhal","mudhal thiruvAymozhi - thALa thAmarai","than thiruvaDigaLai aDaindhArkkuth thAnE thuNai AginRa thirumOgUrk","kALamEgap perumALai vazhith thuNaiyAgak koNDu, AzhvAr thAm piRavith","thuyar ozhindhu paramapadham aDaiyak karudhiyadhai aruLich cheydhal"],"ht":["பத்தாம் பத்து","அடியார் வருத்தம் தீர்க்கும் எம்பெருமானை, உடம்பு முடிந்தவுடன்","பெறும் பலமான அர்ச்சிராதிகதிக்குத் துணையாகக் கொள்ளுதல்","முதல் திருவாய்மொழி - தாள தாமரை","தன் திருவடிகளை அடைந்தார்க்குத் தானே துணை ஆகின்ற திருமோகூர்க் காளமேகப் பெருமாளை வழித் துணையாகக் கொண்டு, ஆழ்வார் தாம் பிறவித் துயர் ஒழிந்து பரமபதம் அடையக் கருதியதை அருளிச் செய்தல்"],"ae":"aDivaravu: thAL ilam anRi iDar thoNDIr kUththan maRRilam thuyar maNi nAm Eththumin keDum","at":"அடிவரவு: தாள் இலம் அன்றி இடர் தொண்டீர் கூத்தன் மற்றிலம் துயர் மணி நாம் ஏத்துமின் கெடும்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","91 thALa thAmarai [3667-3677] Tenth Decad.mp3",3783,3793]},{"he":["paththAm paththu","iraNDAm thiruvAymozhi - keDumiDar","thiruvananthapuraththaich sErndhAl paramapadhaththiR pOlak","kaingkaryam seyyalAm enRu parOpadhEsam cheydhal"],"ht":["பத்தாம் பத்து","இரண்டாம் திருவாய்மொழி - கெடுமிடர்","திருவனந்தபுரத்தைச் சேர்ந்தால் பரமபதத்திற் போலக்","கைங்கர்யம் செய்யலாம் என்று பரோபதேசம் செய்தல்"],"ae":"aDivaravu: keDum inRu Urum pEsumin puNNiyam amarar thuDaiththa kaDuvinai nAm mAyndhu andhamil vEy","at":"அடிவரவு: கெடும் இன்று ஊரும் பேசுமின் புண்ணியம் அமரர் துடைத்த கடுவினை நாம் மாய்ந்து அந்தமில் வேய்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","92 kedumidar [3678-3688 ].mp3",3794,3804]},{"he":["AzhvAr thiruvaDigaLE charaNam","paththAm paththu","mUnRAm thiruvAymozhi - vEymaruthOL","thalaivi thalaivanadhu pirivukku iranggiya pAsuraththAlE, innum paramapadham aruLAmaiyAl, 'ennai indhap bUmiyilE vaiththu viDuvanO' enRu sanggiththu, thirumAl theLivikkath theLidhal"],"ht":["பத்தாம் பத்து","மூன்றாம் திருவாய்மொழி - வேய்மருதோள்","தலைவி தலைவனது பிரிவுக்கு இரங்கிய பாசுரத்தாலே, இன்னும்","பரமபதம் அருளாமையால், 'என்னை இந்தப் பூமியிலே வைத்து","விடுவனோ' என்று சங்கித்து, திருமால் தெளிவிக்கத் தெளிதல்"],"ae":"aDivaravu: vEy thagavu vIva thozhuththai paNi aDichchiyOm vEm asurar ugakku avaththam sengkani sArvu","at":"அடிவரவு: வேய் தகவு வீவ தொழுத்தை பணி அடிச்சியோம் வேம் அசுரர் உகக்கு அவத்தம் செங்கனி சார்வு","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","93 vEymaru [3689-3699].mp3",3805,3815]},{"he":["paththAm paththu","nAnkAm thiruvAymozhi - sArvE","AzhvAr thAm mudhalil anusandhiththa bakthi palaththODu sErndhamaiyai aruLich cheydhal"],"ht":["பத்தாம் பத்து","நான்காம் திருவாய்மொழி - சார்வே","ஆழ்வார் தாம் முதலில் அநுசந்தித்த பக்தி பலத்தோடு சேர்ந்தமையை அருளிச் செய்தல்"],"ae":"aDivaravu: sArvE perumai AL thalai nichchiththu nAgam paNi AzhiyAn kaNDEn vagai paRRu kaNNan","at":"அடிவரவு: சார்வே பெருமை ஆள் தலை நிச்சித்து நாகம் பணி ஆழியான் கண்டேன் வகை பற்று கண்ணன்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","94 sArvE [3700-3710].mp3",3816,3826]},{"he":["paththAm paththu","aindhAm thiruvAymozhi - kaNNan kazhaliNai","AzhvAr emperumAniDaththu bakthi uDaiyAr seyya vENDiya seyalgaLai","ellAm surunggach solli, parOpadhEsaththai niRaivu paDuththal"],"ht":["பத்தாம் பத்து","ஐந்தாம் திருவாய்மொழி - கண்ணன் கழலிணை","ஆழ்வார் எம்பெருமானிடத்து பக்தி உடையார் செய்ய வேண்டிய செயல்களை","எல்லாம் சுருங்கச் சொல்லி, பரோபதேசத்தை நிறைவு படுத்தல்"],"ae":"aDivaravu: kaNNan nAraNan thAnE ALvAn nADIr mEyAn mAdhavan sArA amarar vinai neDiyAn aruL","at":"அடிவரவு: கண்ணன் நாரணன் தானே ஆள்வான் நாடீர் மேயான் மாதவன் சாரா அமரர் வினை நெடியான் அருள்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","95 kaNNan kazhaliNai [3711-3721].mp3",3827,3837]},{"he":["paththAm paththu","ARAm thiruvAymozhi - aruL peRuvAr","kAmugan kAminiyin azhukku ugappadhu pOlE, emperumAn AzhvAradhu","prAkrutha sarIraththai ugandhu, avvuDambuDan avaraip paramapadham","azhaiththuch sella avaradhu isaivu pArththu irundhamaiyaik kURudhal"],"ht":["பத்தாம் பத்து","ஆறாம் திருவாய்மொழி - அருள் பெறுவார்","காமுகன் காமினியின் அழுக்கு உகப்பது போலே, எம்பெருமான் ஆழ்வாரது ப்ராக்ருத சரீரத்தை உகந்து, அவ்வுடம்புடன் அவரைப் பரமபதம் அழைத்துச்","செல்ல அவரது இசைவு பார்த்து இருந்தமையைக் கூறுதல்"],"ae":"aDivaravu: aruL vATTARu naNNi en vAnE thalai kurai mey thigazh piriyAdhu kATTi senjchol","at":"அடிவரவு: அருள் வாட்டாறு நண்ணி என் வானே தலை குரை மெய் திகழ் பிரியாது காட்டி செஞ்சொல்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","96 aruL peRuvAr [3722-3732].mp3",3838,3848]},{"he":["paththAm paththu","EzhAm thiruvAymozhi - senjchoR kavigAL","tham uDambil emperumAn migudhiyAga vaiththuLLa viruppaththai AzhvAr avanaik","kAlkaTTi viDuviththuk koNDu avanadhu guNaththaip pArATTip pEsi aruLudhal"],"ht":["பத்தாம் பத்து","ஏழாம் திருவாய்மொழி - செஞ்சொற் கவிகாள்","தம் உடம்பில் எம்பெருமான் மிகுதியாக வைத்துள்ள விருப்பத்தை ஆழ்வார் அவனைக் கால்கட்டி விடுவித்துக் கொண்டு அவனது குணத்தைப் பாராட்டிப் பேசி அருளுதல்"],"ae":"aDivaravu: senjchol thAnE ennai enkol naNNA thirumAl aruLai thirumAl Uzhi mangga mAnAm thirumAl","at":"அடிவரவு: செஞ்சொல் தானே என்னை என்கொல் நண்ணா திருமால் அருளை திருமால் ஊழி மங்க மானாம் திருமால்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","97 senjchoR kavigAL [3733-3743].mp3",3849,3859]},{"he":["paththAm paththu","eTTAm thiruvAymozhi - thirumAlirunjchOlai","thammiDaththu emperumAn ippOdhu miga viruppam seyvadhu kaNDa AzhvAr","munbu thammai agalviththu ippOdhu ippaDi iruththaRkuk kAraNam vinavi,","kURa mATTAdhu niRkum avanadhu thiRaththai viyappuRRu pEsudhal"],"ht":["பத்தாம் பத்து","எட்டாம் திருவாய்மொழி - திருமாலிருஞ்சோலை","தம்மிடத்து எம்பெருமான் இப்போது மிக விருப்பம் செய்வது கண்ட ஆழ்வார்","முன்பு தம்மை அகல்வித்து இப்போது இப்படி இருத்தற்குக் காரணம்","வினவி, கூற மாட்டாது நிற்கும் அவனது திறத்தை வியப்புற்று பேசுதல்"],"ae":"aDivaravu: thirumAl pErE piDiththEn eLidhu vAnE thiru uNDu kaNNuL inRu uRREn nillA sUzhvisumbu","at":"அடிவரவு: திருமால் பேரே பிடித்தேன் எளிது வானே திரு உண்டு கண்ணுள் இன்று உற்றேன் நில்லா சூழ்விசும்பு","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","98 thirumAlirunjsOlai [3744-3754].mp3",3860,3870]},{"he":["paththAm paththu","onbadhAm thiruvAymozhi - sUzh visumbu","parajnjAnaththaip peRRa AzhvAr emperumAnAl archchirAdhigathiyaik","kATTap peRRu, thirunATTukkuch senRu aDiyArODu sErndhamaiyai","mayarvaRRa madhinalaththAl kaNDu aruLich cheydhal"],"ht":["பத்தாம் பத்து","ஒன்பதாம் திருவாய்மொழி - சூழ் விசும்பு","பரஜ்ஞானத்தைப் பெற்ற ஆழ்வார் எம்பெருமானால் அர்ச்சிராதிகதியைக்","காட்டப் பெற்று, திருநாட்டுக்குச் சென்று அடியாரோடு சேர்ந்தமையை","மயர்வற்ற மதிநலத்தால் கண்டு அருளிச் செய்தல்"],"ae":"aDivaravu: sUzh nAraNan thozhudhanar edhir mAdhavan vELvi maDandhai kuDi vaikundham vidhi vandhu muni","at":"அடிவரவு: சூழ் நாரணன் தொழுதனர் எதிர் மாதவன் வேள்வி மடந்தை குடி வைகுந்தம் விதி வந்து முனி","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","99 sUzh visumbu [3755-3765].mp3",3871,3881]},{"he":["paththAm paththu","paththAm thiruvAymozhi - muniyE","AzhvAr paramabhakthiyAl naindhu thirumAlaith thAm sErndhamaiyai","aruLich cheydhu, thiruvAymozhiyaith thalaikkaTTudhal"],"ht":["பத்தாம் பத்து","பத்தாம் திருவாய்மொழி - முனியே","ஆழ்வார் பரமபக்தியால் நைந்து திருமாலைத் தாம் சேர்ந்தமையை","அருளிச் செய்து, திருவாய்மொழியைத் தலைக்கட்டுதல்"],"ae":"aDivaravu: muni mAyam kUvi umbar pOra enakku kOla peRRu mudhal sUzhndhu avA uyar","at":"அடிவரவு: முனி மாயம் கூவி உம்பர் போர எனக்கு கோல பெற்று முதல் சூழ்ந்து அவா உயர்","p":[],"box":["https://app.box.com/s/plqgsond6ho0yjo3pimfg1qum5pbh1g6","99.1 muniyE [3766-3776].mp3",3882,3892]}]}