":[],"box":["https://app.box.com/s/u8slptqd01vsme4n6se7kopu956twzbr","45. veruvAthAL [1388-1397].mp3",1388,1397]},{"he":["aindhAm paththu","ARAm thirumozhi - kaimmAnam","thiruvaranggam 3"],"ht":["ஐந்தாம் பத்து","ஆறாம் திருமொழி - கைம்மானம்","திருவரங்கம் 3"],"ae":"aDivaravu: kaimmAnam pErAnai EnAgi vaLarndhavanai nIr tham sindhanai thuvariththa pOy Amaruvi paNDai","at":"அடிவரவு: கைம்மானம் பேரானை ஏனாகி வளர்ந்தவனை நீர் தம் சிந்தனை துவரித்த போய் ஆமருவி பண்டை","p":[],"box":["https://app.box.com/s/u8slptqd01vsme4n6se7kopu956twzbr","46. kaimmAnam [1398-1407].mp3",1398,1407]},{"he":["aindhAm paththu","EzhAm thirumozhi - paNDai","thiruvaranggam 4"],"ht":["ஐந்தாம் பத்து","ஏழாம் திருமொழி - பண்டை","திருவரங்கம் 4"],"ae":"aDivaravu: paNDai indhiran mannu mAyirum engnganE Ayiram suri Uzhi pEyinAr ponnum Ezhai","at":"அடிவரவு: பண்டை இந்திரன் மன்னு மாயிரும் எங்ஙனே ஆயிரம் சுரி ஊழி பேயினார் பொன்னும் ஏழை","p":[],"box":["https://app.box.com/s/u8slptqd01vsme4n6se7kopu956twzbr","47. paNdai [1408-1417].mp3",1408,1417]},{"he":["aindhAm paththu","eTTAm thirumozhi - Ezhai Edhalan","thiruvaranggam 5"],"ht":["ஐந்தாம் பத்து","எட்டாம் திருமொழி - ஏழை ஏதலன்","திருவரங்கம் 5"],"ae":"aDivaravu: Ezhai vAdham kaDi nanjchu mannu Odhu vEdham thuLanggu mADam kai","at":"அடிவரவு: ஏழை வாதம் கடி நஞ்சு மன்னு ஓது வேதம் துளங்கு மாடம் கை","p":[],"box":["https://app.box.com/s/u8slptqd01vsme4n6se7kopu956twzbr","48. Ezhai Edhalan [ 1418-1427].mp3",1418,1427]},{"he":["aindhAm paththu","onbadhAm thirumozhi - kaiyilanggu","thiruppErnagar"],"ht":["ஐந்தாம் பத்து","ஒன்பதாம் திருமொழி - கையிலங்கு","திருப்பேர்நகர்"],"ae":"aDivaravu: kai vanggam oruvanai Un vakkaran vilanggalAl veNNey ampon nAl vaNDaRai thIdhaRu","at":"அடிவரவு: கை வங்கம் ஒருவனை ஊன் வக்கரன் விலங்கலால் வெண்ணெய் அம்பொன் நால் வண்டறை தீதறு","p":[],"box":["https://app.box.com/s/u8slptqd01vsme4n6se7kopu956twzbr","49. kaiyilangu [1428-1437].mp3",1428,1437]},{"he":["aindhAm paththu","paththAm thirumozhi - thIdhaRu","thirunandhipuraviNNagaram"],"ht":["ஐந்தாம் பத்து","பத்த