மின் வில் வாள் கனி பிறை கலங்க","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","54. kaNNum suzhanRu [1478-1487].mp3",1478,1487]},{"he":["ARAm paththu","aindhAm thirumozhi - kalangga","thirunaRaiyUr 2"],"ht":["ஆறாம் பத்து","ஐந்தாம் திருமொழி - கலங்க","திருநறையூர் 2"],"ae":"aDivaravu: kalangga munai Anai uRiyAr viDai paguvAy mundhu veLLai pArai thAmam ambaram","at":"அடிவரவு: கலங்க முனை ஆனை உறியார் விடை பகுவாய் முந்து வெள்ளை பாரை தாமம் அம்பரம்","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","55. kalangka munnIr [ 1488-1497].mp3",1488,1497]},{"he":["ARAm paththu","ARAm thirumozhi - ambaramum","thirunaRaiyUr 3"],"ht":["ஆறாம் பத்து","ஆறாம் திருமொழி - அம்பரமும்","திருநறையூர் 3"],"ae":"aDivaravu: ambaram kozhu pavvam paingkaN anRu thannAlE mulai murukku thArALan semmozhi ALum","at":"அடிவரவு: அம்பரம் கொழு பவ்வம் பைங்கண் அன்று தன்னாலே முலை முருக்கு தாராளன் செம்மொழி ஆளும்","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","56. ambaramum  1498-1507].mp3",1498,1507]},{"he":["ARAm paththu","EzhAm thirumozhi - ALum paNiyum","thirunaRaiyUr 4"],"ht":["ஆறாம் பத்து","ஏழாம் திருமொழி - ஆளும் பணியும்","திருநறையூர் 4"],"ae":"aDivaravu: ALum muni theLLAr oLiyA villAr vaLLi miDaiyA pandhAr ARum nanmai mAn","at":"அடிவரவு: ஆளும் முனி தெள்ளார் ஒளியா வில்லார் வள்ளி மிடையா பந்தார் ஆறும் நன்மை மான்","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","57. ALum [ 1508-1517].mp3",1508,1517]},{"he":["ARAm paththu","eTTAm thirumozhi - mAnkoNDa","thirunaRaiyUr 5"],"ht":["ஆறாம் பத்து","எட்டாம் திருமொழி - மான்கொண்ட","திருநறையூர் 5"],"ae":"aDivaravu: mAn munnIrai thUvAya ODA kallAr umbar kaTTERu maNNin ponggu mannu peDai","at":"அடிவரவு: மான் முந்நீரை தூவாய ஓடா கல்லார் உம்பர் கட்டேறு மண்ணின் பொங்கு மன்னு பெடை","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","58. mAnkoNda [1518-1527].mp3",1518,1527]},{"he":["ARAm paththu","onbadhAm thirumozhi - peDai aDarththa","thirunaRaiyUr 6"],"ht":["ஆறாம் பத்து","ஒன்பதாம் திருமொழி - பெடை அடர்த்த","திருநறையூர் 6"],"ae":"aDivaravu: peDai kazhi suLai thunRu agil pon sIr kulai maRai thiN kiDandha","at":"அடிவரவு: பெடை கழி சுளை துன்று அகில் பொன் சீர் குலை மறை திண் கிடந்த","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","59. pedai adarththa [1528-1537 ].mp3",1528,1537]},{"he":["ARAm paththu","paththAm thirumozhi - kiDandha nambi","thirunaRaiyUr 7"],"ht":["ஆறாம் பத்து","பத்தாம் திருமொழி - கிடந்த நம்பி","திருநறையூர் 7"],"ae":"aDivaravu: kiDandha viDam pUNAdhu kal kuDai kAnam ninRa kaDungkAl ponggu vAvi kaRavA","at":"அடிவரவு: கிடந்த விடம் பூணாது கல் குடை கானம் நின்ற கடுங்கால் பொங்கு வாவி கறவா","p":[],"box":["https://app.box.com/s/orwduhoen9jroz5bdi5v67tr9rvlli70","60. kidantha [1538-1547].mp3",1538,1547]},{"he":["EzhAm paththu","mudhal thirumozhi - kaRavA maDanAgu","thirunaRaiyUr 8"],"ht":["ஏழாம் பத்து","முதல் திருமொழி - கறவா மடநாகு","திருநறையூர் 8"],"ae":"aDivaravu: kaRavA vaRRA thArEn puL vil pani kadhi aththAn thUyAy vaNDAr puLLay","at":"அடிவரவு: கறவா வற்றா தாரேன் புள் வில் பனி கதி அத்தான் தூயாய் வண்டார் புள்ளய்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","61. kaRavAmadanAgu [1548-1557].mp3",1548,1557]},{"he":["EzhAm paththu","iraNDAm thirumozhi - puLLAy EnamumAy","thirunaRaiyUr 9"],"ht":["ஏழாம் பத்து","இரண்டாம் திருமொழி - புள்ளாய் ஏனமுமாய்","திருநறையூர் 9"],"ae":"aDivaravu: puL ODA emmAnum siRiyAy nINDAy enthAdhai man eppOdhum UnEr nannIr sinavil","at":"அடிவரவு: புள் ஓடா எம்மானும் சிறியாய் நீண்டாய் எந்தாதை மன் எப்போதும் ஊனேர் நன்னீர் சினவில்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","62. puLLAyEnamumAy [ 1558-1567 ].mp3",1558,1567]},{"he":["EzhAm paththu","mUnRAm thirumozhi - sinavil","thirunaRaiyUr 10"],"ht":["ஏழாம் பத்து","மூன்றாம் திருமொழி - சினவில்","திருநறையூர் 10"],"ae":"aDivaravu: sinavil thAy urangkaL Anggu eTTanai paNNin ini enseygEn thODu kaN","at":"அடிவரவு: சினவில் தாய் உரங்கள் ஆங்கு எட்டனை பண்ணின் இனி என்செய்கேன் தோடு கண்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","63. sinavil [1568-1577].mp3",1568,1577]},{"he":["EzhAm paththu","nAnkAm thirumozhi - kaN sOra","thiruchchERai"],"ht":["ஏழாம் பத்து","நான்காம் திருமொழி - கண் சோர","திருச்சேறை"],"ae":"aDivaravu: kaN ambu mIdhODi thErALum vandhikkum paNDu paiviriyum uNNAdhu kaLLaththEn pUmAN thandhai","at":"அடிவரவு: கண் அம்பு மீதோடி தேராளும் வந்திக்கும் பண்டு பைவிரியும் உண்ணாது கள்ளத்தேன் பூமாண் தந்தை","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","64. kaN sOra [1578-1587].mp3",1578,1587]},{"he":["EzhAm paththu","aindhAm thirumozhi - thandhai kAlil","thiruvazhundhUr 1","[thalaivanaip puNarndhu pirindha thalaivi thanadhu","pAngkiyarkkuth thalaivan padhi uraiththa pAsuram]"],"ht":["ஏழாம் பத்து","ஐந்தாம் திருமொழி - தந்தை காலில்","திருவழுந்தூர் 1","[தலைவனைப் புணர்ந்து பிரிந்த தலைவி தனது","பாங்கியர்க்குத் தலைவன் பதி உரைத்த பாசுரம்]"],"ae":"aDivaravu: thandhai pAriththu sempon veLLaththuL pagal EDu mAlai vanjchi ennaimpulanum nellil singgam","at":"அடிவரவு: தந்தை பாரித்து செம்பொன் வெள்ளத்துள் பகல் ஏடு மாலை வஞ்சி என்னைம்புலனும் நெல்லில் சிங்கம்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","65. thandhaikAlil [ 1588-1597 ].mp3",1588,1597]},{"he":["EzhAm paththu","ARAm thirumozhi - singgamadhAy","thiruvazhundhUr 2"],"ht":["ஏழாம் பத்து","ஆறாம் திருமொழி - சிங்கமதாய்","திருவழுந்தூர் 2"],"ae":"aDivaravu: singgamadhu kO uDaiyAnai kunRAl kanjchanai periyAnai thiruvAzh nilai pErAnai thiRal thiru","at":"அடிவரவு: சிங்கமது கோ உடையானை குன்றால் கஞ்சனை பெரியானை திருவாழ் நிலை பேரானை திறல் திரு","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","66. singamadhAy [ 1598-1607].mp3",1598,1607]},{"he":["EzhAm paththu","EzhAm thirumozhi - thiruvukkum","thiruvazhundhUr 3"],"ht":["ஏழாம் பத்து","ஏழாம் திருமொழி - திருவுக்கும்","திருவழுந்தூர் 3"],"ae":"aDivaravu: thiruvukkum pandhAr ney paranE viNDAn thOyA kaRuththu neDiyAnE kOvAy annam sengkamalam","at":"அடிவரவு: திருவுக்கும் பந்தார் நெய் பரனே விண்டான் தோயா கறுத்து நெடியானே கோவாய் அன்னம் செங்கமலம்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","67. thiruvukkum [ 1608-1617].mp3",1608,1617]},{"he":["EzhAm paththu","eTTAm thirumozhi - sengkamalam","thiruvazhundhUr 4"],"ht":["ஏழாம் பத்து","எட்டாம் திருமொழி - செங்கமலம்","திருவழுந்தூர் 4"],"ae":"aDivaravu: sengkamalam mun kulam silambu vAnavar pandhu kumbam UDERu panRi kaLLam","at":"அடிவரவு: செங்கமலம் முன் குலம் சிலம்பு வானவர் பந்து கும்பம் ஊடேறு பன்றி கள்ளம்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","68.  sengkamalam [1618-1627].mp3",1618,1627]},{"he":["EzhAm paththu","onbadhAm thirumozhi - kaLLam manam","thiruchchiRupuliyUr"],"ht":["ஏழாம் பத்து","ஒன்பதாம் திருமொழி - கள்ளம் மனம்","திருச்சிறுபுலியூர்"],"ae":"aDivaravu: kaLLam theruvil paRaiyum vAn nandhA muzhu sEyOnggu maiyAr karu sIrAr perumpuRam","at":"அடிவரவு: கள்ளம் தெருவில் பறையும் வான் நந்தா முழு சேயோங்கு மையார் கரு சீரார் பெரும்புறம்","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","69. kaLLammanam [1628-1637].mp3",1628,1637]},{"he":["EzhAm paththu","paththAm thirumozhi - perumpuRakkaDal","thirukkaNNamanggai"],"ht":["ஏழாம் பத்து","பத்தாம் திருமொழி - பெரும்புறக்கடல்","திருக்கண்ணமங்கை"],"ae":"aDivaravu: peru mey enggaLukku pEy ERRinai thuppanai thiruththanai venjchinam paNNinai kaNNamanggaiyuL silai","at":"அடிவரவு: பெரு மெய் எங்களுக்கு பேய் ஏற்றினை துப்பனை திருத்தனை வெஞ்சினம் பண்ணினை கண்ணமங்கையுள் சிலை","p":[],"box":["https://app.box.com/s/5ulys3m5bgviwri9n8r97xh9rma87ly6","70. perumpuRakkadalai [1638-1647].mp3",1638,1647]},{"he":["eTTAm paththu","mudhal thirumozhi - silai ilanggu","thirukkaNNapuram 1","[thalaimaganiDaththu IDupaTTa thalaimagaLadhu seyal kaNDa thAy viyandhu kURiya pAsuram]"],"ht":["எட்டாம் பத்து","முதல் திருமொழி - சிலை இலங்கு","திருக்கண்ணபுரம் 1","[தலைமகனிடத்து ஈடுபட்ட தலைமகளது செயல் கண்ட தாய் வியந்து கூறிய பாசுரம்]"],"ae":"aDivaravu: silai seruvarai thunnu thAr aDi pEr sevvaraththa koRRam vaNDu mAvaLarum theLLiyIr","at":"அடிவரவு: சிலை செருவரை துன்னு தார் அடி பேர் செவ்வரத்த கொற்றம் வண்டு மாவளரும் தெள்ளியீர்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","71. silaiyilangku [1648-1657].mp3",1648,1657]},{"he":["eTTAm paththu","iraNDAm thirumozhi - theLLiyIr","thirukkaNNapuram 2","[thalaiviyin nilai kaNDa thAy thalaimaganai iyaRpazhiththum,","thalaimagaLadhu iLamaikku iranggiyum kURiya pAsuram]"],"ht":["எட்டாம் பத்து","இரண்டாம் திருமொழி - தெள்ளியீர்","திருக்கண்ணபுரம் 2","[தலைவியின் நிலை கண்ட தாய் தலைமகனை இயற்பழித்தும்,","தலைமகளது இளமைக்கு இரங்கியும் கூறிய பாசுரம்]"],"ae":"aDivaravu: theLLiyIr nINilA aruvi uNNum kaNNan vaDavarai tharanggam thoNDu muL kAr karai","at":"அடிவரவு: தெள்ளியீர் நீணிலா அருவி உண்ணும் கண்ணன் வடவரை தரங்கம் தொண்டு முள் கார் கரை","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","72. theLLiyIr [1658-1667].mp3",1658,1667]},{"he":["eTTAm paththu","mUnRAm thirumozhi - karaiyeDuththa","thirukkaNNapuram 3","[thalaimaganaip pirindha thalaivi iranggik kURiya pAsuram; aRaththoDu niRRal]"],"ht":["எட்டாம் பத்து","மூன்றாம் திருமொழி - கரையெடுத்த","திருக்கண்ணபுரம் 3","[தலைமகனைப் பிரிந்த தலைவி இரங்கிக் கூறிய பாசுரம்; அறத்தொடு நிற்றல்]"],"ae":"aDivaravu: karai ari thunggam kaNam vAy maDal vaNDu konggu vArALum thEmaruvu viNNavar","at":"அடிவரவு: கரை அரி துங்கம் கணம் வாய் மடல் வண்டு கொங்கு வாராளும் தேமருவு விண்ணவர்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","73. karaiyeduththa [1668-1677].mp3",1668,1677]},{"he":["eTTAm paththu","nAnkAm thirumozhi - viNNavar","thirukkaNNapuram 4","[thalaimaganiDaththu IDupaTTa thalaivi ARRAdhu thumbiyai nOkkik kURiya pAsuram]"],"ht":["எட்டாம் பத்து","நான்காம் திருமொழி - விண்ணவர்","திருக்கண்ணபுரம் 4","[தலைமகனிடத்து ஈடுபட்ட தலைவி ஆற்றாது தும்பியை நோக்கிக் கூறிய பாசுரம்]"],"ae":"aDivaravu: viNNavar vEdham viNDa nIr ErAr mArvil vAmanan nIlam nandhan vaNDamarum thandhai","at":"அடிவரவு: விண்ணவர் வேதம் விண்ட நீர் ஏரார் மார்வில் வாமனன் நீலம் நந்தன் வண்டமரும் தந்தை","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","74. viNNavar [1678-1687].mp3",1678,1687]},{"he":["eTTAm paththu","aindhAm thirumozhi - thandhaikAlil","thirukkaNNapuram 5","[thalaivanaip pirindha thalaivi andhippozhudhil thalaivan vArAdhu","thAzhththa, thenRal mudhaliyavaRRAl varundhik kURudhal]"],"ht":["எட்டாம் பத்து","ஐந்தாம் திருமொழி - தந்தைகாலில்","திருக்கண்ணபுரம் 5","[தலைவனைப் பிரிந்த தலைவி அந்திப்பொழுதில் தலைவன் வாராது","தாழ்த்த, தென்றல் முதலியவற்றால் வருந்திக் கூறுதல்]"],"ae":"aDivaravu: thandhai mAri Ayan kayam Ezhu muriyum kalangga muzhudhu kananjchey vArkoL thoNDIr","at":"அடிவரவு: தந்தை மாரி ஆயன் கயம் ஏழு முரியும் கலங்க முழுது கனஞ்செய் வார்கொள் தொண்டீர்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","75. thandhai kAlil [1688-1697 ].mp3",1688,1697]},{"he":["eTTAm paththu","ARAm thirumozhi - thoNDIr","thirukkaNNapuram 6"],"ht":["எட்டாம் பத்து","ஆறாம் திருமொழி - தொண்டீர்","திருக்கண்ணபுரம் 6"],"ae":"aDivaravu: thoNDIr porundhA valli mallai Amai varundhAdhu ilai mAl kunRAl karumA viyam","at":"அடிவரவு: தொண்டீர் பொருந்தா வல்லி மல்லை ஆமை வருந்தாது இலை மால் குன்றால் கருமா வியம்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","76. thondIr [1698-1707].mp3",1698,1707]},{"he":["eTTAm paththu","EzhAm thirumozhi - viyamuDai","thirukkaNNapuram 7"],"ht":["எட்டாம் பத்து","ஏழாம் திருமொழி - வியமுடை","திருக்கண்ணபுரம் 7"],"ae":"aDivaravu: viyam iNai puyal Edhalar thoNDar mazhu paridhiyoDu paDi pulam malipugazh vAnOr","at":"அடிவரவு: வியம் இணை புயல் ஏதலர் தொண்டர் மழு பரிதியொடு படி புலம் மலிபுகழ் வானோர்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","77. viyamudai [ 1708-1717].mp3",1708,1717]},{"he":["eTTAm paththu","eTTAm thirumozhi - vAnOraLavum","thirukkaNNapuram 8 - dasAvathAram"],"ht":["எட்டாம் பத்து","எட்டாம் திருமொழி - வானோரளவும்","திருக்கண்ணபுரம் 8 - தசாவதாரம்"],"ae":"aDivaravu: vAnOr malanggu pAr uLaindha thozhu vaDi vaiyam oRRai thuvari mInODu kaimmAnam","at":"அடிவரவு: வானோர் மலங்கு பார் உளைந்த தொழு வடி வையம் ஒற்றை துவரி மீனோடு கைம்மானம்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","78. vAnOraLavum [1718-1727].mp3",1718,1727]},{"he":["eTTAm paththu","onbadhAm thirumozhi - kaimmAnam","thirukkaNNapuram 9"],"ht":["எட்டாம் பத்து","ஒன்பதாம் திருமொழி - கைம்மானம்","திருக்கண்ணபுரம் 9"],"ae":"aDivaravu: kaimmAnam tharu viDai mikkAnai vandhAy enjchA peRRAr kaRRAr kaNNAr seru vaNDAr","at":"அடிவரவு: கைம்மானம் தரு விடை மிக்கானை வந்தாய் எஞ்சா பெற்றார் கற்றார் கண்ணார் செரு வண்டார்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","79. kaimmAnam [1728-1737 ].mp3",1728,1737]},{"he":["eTTAm paththu","paththAm thirumozhi - vaNDAr","thirukkaNNapuram 10"],"ht":["எட்டாம் பத்து","பத்தாம் திருமொழி - வண்டார்","திருக்கண்ணபுரம் 10"],"ae":"aDivaravu: vaNDAr peru maRRu peN peRRAr Eththi veLLai mAN nATTinAy kaNDasIr vanggam","at":"அடிவரவு: வண்டார் பெரு மற்று பெண் பெற்றார் ஏத்தி வெள்ளை மாண் நாட்டினாய் கண்டசீர் வங்கம்","p":[],"box":["https://app.box.com/s/2iugnsheev5h345kve0zrlvfjm1yr0u7","80. vaNdAr [1738-1747 ].mp3",1738,1747]},{"he":["onbadhAm paththu","mudhal thirumozhi - vanggamAmunnIr","thirukkaNNangguDi"],"ht":["ஒன்பதாம் பத்து","முதல் திருமொழி - வங்கமாமுந்நீர்","திருக்கண்ணங்குடி"],"ae":"aDivaravu: vanggam kavaLam vAdhai venri mannavan mazhuvinAl vAnuLAr aravu panniya kalai pon","at":"அடிவரவு: வங்கம் கவளம் வாதை வென்ரி மன்னவன் மழுவினால் வானுளார் அரவு பன்னிய கலை பொன்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","81. vangkamAmunnIr [1748-1757].mp3",1748,1757]},{"he":["onbadhAm paththu","iraNDAm thirumozhi - ponnivar","thirunAgai","[thalaivanadhu uruveLippADu kaNDa thalaivi thOzhikkuk kURiya pAsuram]"],"ht":["ஒன்பதாம் பத்து","இரண்டாம் திருமொழி - பொன்னிவர்","திருநாகை","[தலைவனது உருவெளிப்பாடு கண்ட தலைவி தோழிக்குக் கூறிய பாசுரம்]"],"ae":"aDivaravu: pon thODu vEy vambu kOzhi venjchinam piNi manjchuyar eNthisai annam thannai","at":"அடிவரவு: பொன் தோடு வேய் வம்பு கோழி வெஞ்சினம் பிணி மஞ்சுயர் எண்திசை அன்னம் தன்னை","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","82. ponnivarmEni [1758-1767].mp3",1758,1767]},{"he":["onbadhAm paththu","mUnRAm thirumozhi - thannai","thiruppullANi 1","[thalaivanaip pirindha thalaivi ARRAmai migudhiyAl thalaivaniDam sellath","thuNindhu nenjchaiyum thOzhiyaiyum thuNai vENDiya pAsuram]"],"ht":["ஒன்பதாம் பத்து","மூன்றாம் திருமொழி - தன்னை","திருப்புல்லாணி 1","[தலைவனைப் பிரிந்த தலைவி ஆற்றாமை மிகுதியால் தலைவனிடம்","செல்லத் துணிந்து நெஞ்சையும் தோழியையும் துணை வேண்டிய பாசுரம்]"],"ae":"aDivaravu: thannai urugi Edhu konggu uNaril eLgi paravi alam Odhi ilanggu kAvAr","at":"அடிவரவு: தன்னை உருகி ஏது கொங்கு உணரில் எள்கி பரவி அலம் ஓதி இலங்கு காவார்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","83. thannai [1768-1777].mp3",1768,1777]},{"he":["onbadhAm paththu","nAngAm thirumozhi - kAvAr","thiruppullANi 2","[pirivARRAdha thalaivi paRavaigaLaith thUdhu viTTum, piRai","thenRal mudhaliyavaRRAl varundhiyum kURiya pAsuram]"],"ht":["ஒன்பதாம் பத்து","நான்காம் திருமொழி - காவார்","திருப்புல்லாணி 2","[பிரிவாற்றாத தலைவி பறவைகளைத் தூது விட்டும், பிறை","தென்றல் முதலியவற்றால் வருந்தியும் கூறிய பாசுரம்]"],"ae":"aDivaravu: kAvAr munnam vavvi pariya vil suzhanRu kanai thUmbuDai vEdham ponnalarum thavaLam","at":"அடிவரவு: காவார் முன்னம் வவ்வி பரிய வில் சுழன்று கனை தூம்புடை வேதம் பொன்னலரும் தவளம்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","84. kAvAr [ 1778-1787 ].mp3",1778,1787]},{"he":["onbadhAm paththu","aindhAm thirumozhi - thavaLaviLampiRai","thirukkuRungguDi 1","[thalaivi thanadhu thalaimagan uLLa iDaththil koNDu viDumpaDi uRRArai vENDik kURiya pAsuram]"],"ht":["ஒன்பதாம் பத்து","ஐந்தாம் திருமொழி - தவளவிளம்பிறை","திருக்குறுங்குடி 1","[தலைவி தனது தலைமகன் உள்ள இடத்தில் கொண்டு","விடும்படி உற்றாரை வேண்டிக் கூறிய பாசுரம்]"],"ae":"aDivaravu: thavaLam thAdhavizh kAlai karumaNi thiNthimil elli sengkaN kEvalam sOththena seRRavan akku","at":"அடிவரவு: தவளம் தாதவிழ் காலை கருமணி திண்திமில் எல்லி செங்கண் கேவலம் சோத்தென செற்றவன் அக்கு","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","85. thavaLaviLampiRai [1788-1797].mp3",1788,1797]},{"he":["onbadhAm paththu","ARAm thirumozhi - akkum","thirukkuRungguDi 2"],"ht":["ஒன்பதாம் பத்து","ஆறாம் திருமொழி - அக்கும்","திருக்குறுங்குடி 2"],"ae":"aDivaravu: akku thunggAr vAzh siramun kavvai thInIr valli nArAr ninRa silaiyAl thandhai","at":"அடிவரவு: அக்கு துங்கார் வாழ் சிரமுன் கவ்வை தீநீர் வல்லி நாரார் நின்ற சிலையால் தந்தை","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","86. akkumpuliyin [ 1798-1807].mp3",1798,1807]},{"he":["onbadhAm paththu","EzhAm thirumozhi - thandhaithAy","thiruvallavAzh"],"ht":["ஒன்பதாம் பத்து","ஏழாம் திருமொழி - தந்தைதாய்","திருவல்லவாழ்"],"ae":"aDivaravu: thandhai minnum pUN paN manjchu uruvin nOy manjchusEr veLLiyAr maRai mundhuRa","at":"அடிவரவு: தந்தை மின்னும் பூண் பண் மஞ்சு உருவின் நோய் மஞ்சுசேர் வெள்ளியார் மறை முந்துற","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","87. thandhaithAy [1808-1817].mp3",1808,1817]},{"he":["onbadhAm paththu","eTTAm thirumozhi - mundhuRa","thirumAlirunjchOlai 1"],"ht":["ஒன்பதாம் பத்து","எட்டாம் திருமொழி - முந்துற","திருமாலிருஞ்சோலை 1"],"ae":"aDivaravu: mundhuRa iNDai piNi sUrmaiyil vaNanggalil viDam thEnugan puthamigu pundhi vaNDamar mUvar","at":"அடிவரவு: முந்துற இண்டை பிணி சூர்மையில் வணங்கலில் விடம் தேனுகன் புதமிகு புந்தி வண்டமர் மூவர்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","88. mundhuRa [1818-1827].mp3",1818,1827]},{"he":["onbadhAm paththu","onbadhAm thirumozhi - mUvaril","thirumAlirunjchOlai 2","[pirivARRAdhu thalaivanai nADich senRa thalaiviyin","nilaiyaik kuRiththuth thAy iranggik kURiya pAsuram]"],"ht":["ஒன்பதாம் பத்து","ஒன்பதாம் திருமொழி - மூவரில்","திருமாலிருஞ்சோலை 2","[பிரிவாற்றாது தலைவனை நாடிச் சென்ற தலைவியின்","நிலையைக் குறித்துத் தாய் இரங்கிக் கூறிய பாசுரம்]"],"ae":"aDivaravu: mUvaril punai uNDu singgamadhu dhAnavan nEsam puLLinai pArththanukku valampuri thEDaRku enggaL","at":"அடிவரவு: மூவரில் புனை உண்டு சிங்கமது தானவன் நேஸம் புள்ளினை பார்த்தனுக்கு வலம்புரி தேடற்கு எங்கள்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","89. mUvaril [1828-1837].mp3",1828,1837]},{"he":["onbadhAm paththu","paththAm thirumozhi - enggaL","thirukkOTTiyUr"],"ht":["ஒன்பதாம் பத்து","பத்தாம் திருமொழி - எங்கள்","திருக்கோட்டியூர்"],"ae":"aDivaravu: enggaL evvam veLLiyAn ERu vanggam kAvalan kanRu pUngkurundhu kOvai Alum orunal","at":"அடிவரவு: எங்கள் எவ்வம் வெள்ளியான் ஏறு வங்கம் காவலன் கன்று பூங்குருந்து கோவை ஆலும் ஒருநல்","p":[],"box":["https://app.box.com/s/yaftzcxmaxs0milpq80yntzsd1leppn6","90. engkaL [1838-1847].mp3",1838,1847]},{"he":["paththAm paththu","mudhal thirumozhi - orunalsuRRam","pala dhivyadhEsanggaL"],"ht":["பத்தாம் பத்து","முதல் திருமொழி - ஒருநல்சுற்றம்","பல திவ்யதேசங்கள்"],"ae":"aDivaravu: oru ponnai vElai thuLakkam suDalaiyil vAnai kUndhal paththar kambam peRRa irakkam","at":"அடிவரவு: ஒரு பொன்னை வேலை துளக்கம் சுடலையில் வானை கூந்தல் பத்தர் கம்பம் பெற்ற இரக்கம்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","91. orunalsuRRam [1848-1857].mp3",1848,1857]},{"he":["paththAm paththu","iraNDAm thirumozhi - irakkaminRi","irAmAvathAraththil IDupADu 1","[irAmaniDam thOlviyuRRa arakkar abayam vENDik kUththADudhal]"],"ht":["பத்தாம் பத்து","இரண்டாம் திருமொழி - இரக்கமின்றி","இராமாவதாரத்தில் ஈடுபாடு 1","[இராமனிடம் தோல்வியுற்ற அரக்கர் அபயம் வேண்டிக் கூத்தாடுதல்]"],"ae":"aDivaravu: irakkam paththu thaNDaka enjchal sempon Odham thAzham manam puranggaL anggu Eththu","at":"அடிவரவு: இரக்கம் பத்து தண்டக எஞ்சல் செம்பொன் ஓதம் தாழம் மனம் புரங்கள் அங்கு ஏத்து","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","92. irakkaminRi [1858-1867].mp3",1858,1867]},{"he":["paththAm paththu","mUnRAm thirumozhi - EththuginROm","irAmAvathAraththil IDupADu 2","[irAmaniDam thOlviyuRRa arakkar abayam vENDik kUththADudhal]"],"ht":["பத்தாம் பத்து","மூன்றாம் திருமொழி - ஏத்துகின்றோம்","இராமாவதாரத்தில் ஈடுபாடு 2","[இராமனிடம் தோல்வியுற்ற அரக்கர் அபயம் வேண்டிக் கூத்தாடுதல்]"],"ae":"aDivaravu: EththuginROm empirAnE njAlam maNanggaL venRi kallin mARRam kavaLam EDu venRa sandham","at":"அடிவரவு: ஏத்துகின்றோம் எம்பிரானே ஞாலம் மணங்கள் வென்றி கல்லின் மாற்றம் கவளம் ஏடு வென்ற சந்தம்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","93. EththuginROm [1868-1877].mp3",1868,1877]},{"he":["paththAm paththu","nAnkAm thirumozhi - sandhamalar","kruShNAvathAraththil IDupADu 1","[kaNNanai mulaiyuNNa azhaiththal]"],"ht":["பத்தாம் பத்து","நான்காம் திருமொழி - சந்தமலர்","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 1","[கண்ணனை முலையுண்ண அழைத்தல்]"],"ae":"aDivaravu: sandham vanggam thiruvil makkaL maiththa piLLaigaL thanmagan untham peRRam immai pUngkOdhai","at":"அடிவரவு: சந்தம் வங்கம் திருவில் மக்கள் மைத்த பிள்ளைகள் தன்மகன் உந்தம் பெற்றம் இம்மை பூங்கோதை","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","94. sandhamalar [1878-1887].mp3",1878,1887]},{"he":["paththAm paththu","aindhAm thirumozhi - pUngkOdhai","kruShNAvathAraththil IDupADu 2","[kaNNanaik kaikoTTi viLaiyADumpaDi kURudhal]"],"ht":["பத்தாம் பத்து","ஐந்தாம் திருமொழி - பூங்கோதை","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 2","[கண்ணனைக் கைகொட்டி விளையாடும்படி கூறுதல்]"],"ae":"aDivaravu: pUngkOdhai thAyar thAmOr peRRAr sOththena kEvalam puLLinai yAyum kArAr enggAnum","at":"அடிவரவு: பூங்கோதை தாயர் தாமோர் பெற்றார் சோத்தென கேவலம் புள்ளினை யாயும் காரார் எங்கானும்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","95. pUngkOdhai [1888-1897].mp3",1888,1897]},{"he":["paththAm paththu","ARAm thirumozhi - enggAnum","kruShNAvathAraththil IDupADu 3","[maRRai avathAranggaLin mEnmaiyODu kruShNAvathAraththin eLimaiyai anubaviththal]"],"ht":["பத்தாம் பத்து","ஆறாம் திருமொழி - எங்கானும்","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 3","[மற்றை அவதாரங்களின் மேன்மையோடு க்ருஷ்ணாவதாரத்தின் எளிமையை அநுபவித்தல்]"],"ae":"aDivaravu: enggAnum kunRu uLaindhu thaLarndhu nINDAn pazhiththiTTa paDai neRi suri ninRAr mAnam","at":"அடிவரவு: எங்கானும் குன்று உளைந்து தளர்ந்து நீண்டான் பழித்திட்ட படை நெறி சுரி நின்றார் மானம்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","96. engkAnum [1898-1907].mp3",1898,1907]},{"he":["paththAm paththu","EzhAm thirumozhi - mAnamuDaiththu","kruShNAvathAraththil IDupADu 4","[kaNNan seydhiyaik kuRiththu Aychchiyarum yasOdhaiyum muRai iDudhal]"],"ht":["பத்தாம் பத்து","ஏழாம் திருமொழி - மானமுடைத்து","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 4","[கண்ணன் செய்தியைக் குறித்து ஆய்ச்சியரும் யசோதையும் முறை இடுதல்]"],"ae":"aDivaravu: mAnam kAlai theLLiya mai thandhai maNmagaL Ayiram thOyththa IDum anjchuvan angnganam achcham thamparam annam kAdhil","at":"அடிவரவு: மானம் காலை தெள்ளிய மை தந்தை மண்மகள் ஆயிரம் தோய்த்த ஈடும் அஞ்சுவன் அங்ஙனம் அச்சம் தம்பரம் அன்னம் காதில்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","97. mAnamudaiththu [1908-1921].mp3",1908,1921]},{"he":["paththAm paththu","eTTAm thirumozhi - kAdhil kaDippu","kruShNAvathAraththil IDupADu 5","[Aychchi oruththi kaNNanODu UDudhal]"],"ht":["பத்தாம் பத்து","எட்டாம் திருமொழி - காதில் கடிப்பு","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 5","[ஆய்ச்சி ஒருத்தி கண்ணனோடு ஊடுதல்]"],"ae":"aDivaravu: kAdhil thuvar karuLakkoDi nAmam suRRum AnAyar mallE pukku ADi alli puLLuru","at":"அடிவரவு: காதில் துவர் கருளக்கொடி நாமம் சுற்றும் ஆனாயர் மல்லே புக்கு ஆடி அல்லி புள்ளுரு","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","98. kAdhil kadippu [1922-1931].mp3",1922,1931]},{"he":["paththAm paththu","onbadhAm thirumozhi - puLLuruvAgi","kruShNAvathAraththil IDupADu 6","[thalaiviyin ARRAmaikkuth thAy iranggith thalaivanai vENDum pAsuram]"],"ht":["பத்தாம் பத்து","ஒன்பதாம் திருமொழி - புள்ளுருவாகி","க்ருஷ்ணாவதாரத்தில் ஈடுபாடு 6","[தலைவியின் ஆற்றாமைக்குத் தாய் இரங்கித் தலைவனை வேண்டும் பாசுரம்]"],"ae":"aDivaravu: puL manRil Ar malgiya seru arakkiyar Azhi porundhalan nIr vETTaththai thiruththAy","at":"அடிவரவு: புள் மன்றில் ஆர் மல்கிய செரு அரக்கியர் ஆழி பொருந்தலன் நீர் வேட்டத்தை திருத்தாய்","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","99. puLLuruvAgi [ 1932-1941].mp3",1932,1941]},{"he":["paththAm paththu","paththAm thirumozhi - thiruththAy","thalaimaganaip pirindha thalaimagaL ARRAdhu kURiya pAsuram"],"ht":["பத்தாம் பத்து","பத்தாம் திருமொழி - திருத்தாய்","தலைமகனைப் பிரிந்த தலைமகள் ஆற்றாது கூறிய பாசுரம்"],"ae":"aDivaravu: thiruththAy karaiyAy kUvAy koTTAy sollAy kOzhi kAmaRku inggE innAr thoNDIr kunRamonRu","at":"அடிவரவு: திருத்தாய் கரையாய் கூவாய் கொட்டாய் சொல்லாய் கோழி காமற்கு இங்கே இன்னார் தொண்டீர் குன்றமொன்று","p":[],"box":["https://app.box.com/s/jmitn0jx5v3z1yvv5uzfm5ydntuf3xcj","100.  thiruththAy [1942-1951].mp3",1942,1951]},{"he":["padhinOrAm paththu","mudhal thirumozhi - kunRamonRu","pirivARRAdha thalaivi iranggik kURum pAsuram"],"ht":["பதினோராம் பத்து","முதல் திருமொழி - குன்றமொன்று","பிரிவாற்றாத தலைவி இரங்கிக் கூறும் பாசுரம்"],"ae":"aDivaravu: kunRam kArum sanggu anggOrAy anggOrALari senRu pUvai mAl keNDaai anRu kunRameDuththu","at":"அடிவரவு: குன்றம் காரும் சங்கு அங்கோராய் அங்கோராளரி சென்று பூவை மால் கெண்டை அன்று குன்றமெடுத்து","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","101.  kunRamonRu [1952-1961].mp3",1952,1961]},{"he":["padhinOrAm paththu","iraNDAm thirumozhi - kunRameDuththu","thalaivi piRivARRAdhu varundhik kURum pAsuram"],"ht":["பதினோராம் பத்து","இரண்டாம் திருமொழி - குன்றமெடுத்து","தலைவி பிறிவாற்றாது வருந்திக் கூறும் பாசுரம்"],"ae":"aDivaravu: kunRam pU malloDu porundhu annai Azhi kAmanthanakku manjchuRu kAmankaNaikku venRi mannilanggu","at":"அடிவரவு: குன்றம் பூ மல்லொடு பொருந்து அன்னை ஆழி காமன்தனக்கு மஞ்சுறு காமன்கணைக்கு வென்றி மன்னிலங்கு","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","102. kunRameduththu [1962-1971].mp3",1962,1971]},{"he":["padhinOrAm paththu","mUnRAm thirumozhi - mannilanggu","thalaivi iranggik kURiya pAsuram: aRaththoDuniRRal"],"ht":["பதினோராம் பத்து","மூன்றாம் திருமொழி - மன்னிலங்கு","தலைவி இரங்கிக் கூறிய பாசுரம்: அறத்தொடுநிற்றல்"],"ae":"aDivaravu: mannilanggu irundhAn annE aRiyOm thammai vaiththAr kaNNan pADOmE nannenjchE peRRArAr nilai","at":"அடிவரவு: மன்னிலங்கு இருந்தான் அன்னே அறியோம் தம்மை வைத்தார் கண்ணன் பாடோமே நன்னெஞ்சே பெற்றாரார் நிலை","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","103. mannilangu [1972-1981].mp3",1972,1981]},{"he":["padhinOrAm paththu","nAnkAm thirumozhi - nilaiyiDam","avathAranggaLin magimai"],"ht":["பதினோராம் பத்து","நான்காம் திருமொழி - நிலையிடம்","அவதாரங்களின் மகிமை"],"ae":"aDivaravu: nilai serumigu thIdhaRu thaLai venthiRal irunilam ilaimali mun thuNai kolai mAn","at":"அடிவரவு: நிலை செருமிகு தீதறு தளை வெந்திறல் இருநிலம் இலைமலி முன் துணை கொலை மான்","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","104. nilaiyidam [ 1982-1991].mp3",1982,1991]},{"he":["padhinOrAm paththu","aindhAm thirumozhi - mAnamarum","iraNDu thOzhiyar emperumAnadhu saulabyaththaiyum parathvaththaiyum edhir edhirAgak kURudhal"],"ht":["பதினோராம் பத்து","ஐந்தாம் திருமொழி - மானமரும்","இரண்டு தோழியர் எம்பெருமானது ஸௌலப்யத்தையும்","பரத்வத்தையும் எதிர் எதிராகக் கூறுதல்"],"ae":"aDivaravu: mAnamarum thandhai AzhkaDal aRiyAdhArkku vaNNam kanRa kOdhai pArmannar kaNDAr kaLLaththAl mainninRa","at":"அடிவரவு: மானமரும் தந்தை ஆழ்கடல் அறியாதார்க்கு வண்ணம் கன்ற கோதை பார்மன்னர் கண்டார் கள்ளத்தால் மைந்நின்ற","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","105. mAnamarum [ 1992-2001].mp3",1992,2001]},{"he":["padhinOrAm paththu","ARAm thirumozhi - mainninRa","praLaya Apaththil pAdhukAththa emperumAnaiyE AshrayikkumpaDi ulagaththArkku upadhEsiththal"],"ht":["பதினோராம் பத்து","ஆறாம் திருமொழி - மைந்நின்ற","ப்ரளய ஆபத்தில் பாதுகாத்த எம்பெருமானையே","ஆஶ்ரயிக்கும்படி உலகத்தார்க்கு உபதேசித்தல்"],"ae":"aDivaravu: mai nillAdha neRRi pani pArArum pEy maN maRam aNDaththin dhEvarai nILnAgam","at":"அடிவரவு: மை நில்லாத நெற்றி பனி பாராரும் பேய் மண் மறம் அண்டத்தின் தேவரை நீள்நாகம்","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","106. mainninRa [2002-2011].mp3",2002,2011]},{"he":["padhinOrAm paththu","EzhAm thirumozhi - nILnAgam","'emperumAn thiRaththil IDupaDAdha avayanggaL payan aRRana' enRu kURal"],"ht":["பதினோராம் பத்து","ஏழாம் திருமொழி - நீள்நாகம்","'எம்பெருமான் திறத்தில் ஈடுபடாத அவயங்கள் பயன் அற்றன' என்று கூறல்"],"ae":"aDivaravu: nILnAgam nILvAn thUyAn kUDA maiyAr kaLLAr kanai veRi thEnoDu mey mARRam","at":"அடிவரவு: நீள்நாகம் நீள்வான் தூயான் கூடா மையார் கள்ளார் கனை வெறி தேனொடு மெய் மாற்றம்","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","107. nILnAgam [2012-2021].mp3",2012,2021]},{"he":["padhinOrAm paththu","eTTAm thirumozhi - mARRamuLa","'dEha sambandhaththai aRuththuth thandharuLa vENDum'","enRu AzhvAr emperumAnaip prArththiththal"],"ht":["பதினோராம் பத்து","எட்டாம் திருமொழி - மாற்றமுள","'தேஹ சம்பந்தத்தை அறுத்துத் தந்தருள வேண்டும்'","என்று ஆழ்வார் எம்பெருமானைப் ப்ரார்த்தித்தல்"],"ae":"aDivaravu: mARRam sIRRam uruvAr koLLa paDai vEmbin aNiyAr nandhA kunRam nidhiyinai","at":"அடிவரவு: மாற்றம் சீற்றம் உருவார் கொள்ள படை வேம்பின் அணியார் நந்தா குன்றம் நிதியினை","p":[],"box":["https://app.box.com/s/u98jv238yyjhstk6aerku91lzp8sh0le","108. mARRamuLa [2022-2031].mp3",2022,2031]}]}