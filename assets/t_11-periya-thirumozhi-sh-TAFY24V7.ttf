{"id":"11-periya-thirumozhi","name":"Periya Thirumozhi","nameTa":"பெரிய திருமொழி","alvar":"Thirumangai Azhvar","alvarTa":"திருமங்கையாழ்வார்","src":"periya thirumozhi","ayiram":2,"start":948,"end":2031,"thaniyans":[{"le":["thirumanggaiyAzhvAr aruLich cheydha","periya thirumozhi thaniyangaL","thirukkOTTiyUr nambi aruLich cheydhadhu"],"lt":["பெரிய திருமொழி தனியன்கள்","திருக்கோட்டியூர் நம்பி அருளிச் செய்தது"],"en":["kalayAmi kalidhvamsam kavim lOkadivAkaram |","yasya gObhi: prakAshAbhirAvidyam nihatam tama: ||"],"ta":["கலயாமி கலித்⁴வம்ஸம் கவிம் லோகதி³வாகரம் |","யஸ்ய கோ³பி⁴: ப்ரகாஶாபி⁴ராவித்³யம் நிஹதம் தம: ||"]},{"le":["emberumAnAr aruLich cheydhadhu"],"lt":["எம்பெருமானார் அருளிச் செய்தது"],"en":["vAzhi parakAlan vAzhi kalikanRi *","vAzhi kuRaiyalUr vAzh vEndhan * - vAzhiyarO","mAyOnai vAL valiyAl mandhirangkoL manggaiyar kOn *","thUyOn suDarmAna vEl"],"ta":["வாழி பரகாலன் வாழி கலிகன்றி *","வாழி குறையலூர் வாழ் வேந்தன் * - வாழியரோ","மாயோனை வாள் வலியால் மந்திரங்கொள் மங்கையர் கோன் *","தூயோன் சுடர்மான வேல்"]},{"le":["AzhvAn aruLich cheydhadhu"],"lt":["ஆழ்வான் அருளிச் செய்தது"],"en":["nenjchukkiruL kaDi dhIpam * aDanggA neDum piRavi","nanjchukku nalla amudham * thamizha nannUl thuRaigaL","anjchukku ilakkiyam AraNa sAram * para samayap","panjchukku analin poRi * parakAlan panuvalgaLE"],"ta":["நெஞ்சுக்கிருள் கடி தீபம் * அடங்கா நெடும் பிறவி","நஞ்சுக்கு நல்ல அமுதம் * தமிழ நன்னூல் துறைகள்","அஞ்சுக்கு இலக்கியம் ஆரண சாரம் * பர சமயப்","பஞ்சுக்கு அனலின் பொறி * பரகாலன் பனுவல்களே"]},{"le":["embAr aruLich cheydhadhu"],"lt":["எம்பார் அருளிச் செய்தது"],"en":["enggaL kadhiyE! irAmAnusa muniyE! *","sanggaik keDuththANDa thavarAsA! * - ponggu pugazh","manggaiyar kOn Indha maRai Ayiram anaiththum *","thanggu manam nI enakkuth thA"],"ta":["எங்கள் கதியே! இராமானுச முனியே! *","சங்கைக் கெடுத்தாண்ட தவராசா! * - பொங்கு புகழ்","மங்கையர் கோன் ஈந்த மறை ஆயிரம் அனைத்தும் *","தங்கு மனம் நீ எனக்குத் தா"]}],"sections":[{"he":["mudhal paththu","mudhal thirumozhi - vADinEn","periya thirumandhiraththin perumai"],"ht":["முதல் பத்து","முதல் திருமொழி - வாடினேன்","பெரிய திருமந்திரத்தின் பெருமை"],"ae":"aDivaravu: vADinEn AviyE sEmam venRi kaLvanEn empirAn iRpiRappu kaRRilEn kulam manjchu vAli","at":"அடிவரவு: வாடினேன் ஆவியே சேமம் வென்றி கள்வனேன் எம்பிரான் இற்பிறப்பு கற்றிலேன் குலம் மஞ்சு வாலி","p":[],"box":["https://app.box.com/s/1xhssnsomfnlr3gen0ai55m8x8d5bbej","01 vAdinEn [948-957].mp3",948,957]},{"he":["mudhal paththu","iraNDAm thirumozhi - vAli mAvalaththu","thiruppiridhi"],"ht":["முதல் பத்து","இரண்டாம் திருமொழி - வாலி மாவலத்து","திருப்பிரிதி"],"ae":"aDivaravu: vAli kalangga thuDi maRam karaisey paNanggaL kAr iravu Odhi kariya muRRa","at":"அடிவரவு: வாலி கலங்க துடி மறம் கரைசெய் பணன்ங்கள் கார் இரவு ஓதி கரிய முற்ற","p":[],"box":["https://app.box.com/s/1xhssnsomfnlr3gen0ai55m8x8d5bbej","02. vAli mAvalaththu [958-967].mp3",958,967]},{"he":["mudhal paththu","mUnRAm thirumozhi - muRRa mUththu","thiruvadhari"],"ht":["முதல் பத்து","மூன்றாம் திருமொழி - முற்ற மூத்து","திருவதரி"],"ae":"aDivaravu: muRRa mudhugu uRigaL pILai paNDu eyththa pappa Isi pulankaL vaNDu Enam","at":"அடிவரவு: முற்ற முதுகு உறிகள் பீளை பண்டு எய்த்த பப்ப ஈசி புலன்கள் வண்டு ஏனம்","p":[],"box":["https://app.box.com/s/1xhssnsomfnlr3gen0ai55m8x8d5bbej","03. muRRa mUththu [968-977].mp3",968,977]},{"he":["mudhal paththu","nAnkAm thirumozhi - EnamunAgi","thiruvadhariyAchchiramam"],"ht":["முதல் பத்து","நான்காம் திருமொழி - ஏனமுனாகி","திருவதரியாச்சிரமம்"],"ae":"aDivaravu: Enam kAniDai ilanggai thuNivu pEy thEr venthiRal mAn koNDal varunthirai kalai","at":"அடிவரவு: ஏனம் கானிடை இலங்கை துணிவு பேய் தேர் வெந்திறல் மான் கொண்டல் வருந்திரை கலை","p":[],"box":["https://app.box.com/s/1xhssnsomfnlr3gen0ai55m8x8d5bbej","04. EnamunAgi [978-987].mp3",978,987]},{"he":["thirumanggaiyAzhvAr aruLich cheytha","muthal paththu","aindhAm thirumozhi - kalaiyunggariyum","thiruchchALakkirAmam"],"ht":["முதல் பத்து","ஐந்தாம் திருமொழி - கலையுங்கரியும்","திருச்சாளக்கிராமம்"],"ae":"aDivaravu: kalai kaDam ulavu UrAn aDuththu thAy EnOr venthAr thoNDu thArA vA