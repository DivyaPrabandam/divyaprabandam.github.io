[[[948,948,["** vADinEn vADi varundhinEn manaththAl *","perunthuyar iDumbaiyil piRandhu *","kUDinEn kUDi iLaiyavar thammODu *","avar tharum kalaviyE karudhi **","ODinEn ODi uyvadhOr poruLAl *","uNarvenum perum padham thirindhu *","nADinEn nADi nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["** வாடினேன் வாடி வருந்தினேன் மனத்தால் *","பெருந்துயர் இடும்பையில் பிறந்து *","கூடினேன் கூடி இளையவர் தம்மோடு *","அவர் தரும் கலவியே கருதி **","ஓடினேன் ஓடி உய்வதோர் பொருளால் *","உணர்வெனும் பெரும் பதம் திரிந்து *","நாடினேன் நாடி நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.1.mp3"],[949,949,["** AviyE! amudhE! ena ninaindhu urugi *","avar avar paNaimulai thuNaiyA *","pAviyEn uNarAdhu eththanai pagalum *","pazhudhu pOy ozhindhana nALgaL **","thUvi sEr annam thuNaiyoDum puNarum *","sUzhpunaR kuDandhaiyE thozhudhu * en","nAvinAl uyya nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["** ஆவியே! அமுதே! என நினைந்து உருகி *","அவர் அவர் பணைமுலை துணையா *","பாவியேன் உணராது எத்தனை பகலும் *","பழுது போய் ஒழிந்தன நாள்கள் **","தூவி சேர் அன்னம் துணையொடும் புணரும் *","சூழ்புனற் குடந்தையே தொழுது * என்","நாவினால் உய்ய நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.2.mp3"],[950,950,["sEmamE vENDith thIvinai perukkith *","therivaimAr uruvamE maruvi *","UmanAr kaNDa kanavilum pazhudhAy *","ozhindhana kazhindha annALgaL **","kAmanAr thAdhai nammuDai aDigaL *","tham aDaindhAr manaththu iruppAr *","nAmam nAn uyya nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["சேமமே வேண்டித் தீவினை பெருக்கித் *","தெரிவைமார் உருவமே மருவி *","ஊமனார் கண்ட கனவிலும் பழுதாய் *","ஒழிந்தன கழிந்த அந்நாள்கள் **","காமனார் தாதை நம்முடை அடிகள் *","தம் அடைந்தார் மனத்து இருப்பார் *","நாமம் நான் உய்ய நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.3.mp3"],[951,951,["venRiyE vENDi vIzh poruTku iranggi *","vERkaNAr kalaviyE karudhi *","ninRavA nillA nenjchinai uDaiyEn *","en seygEn? neDu visumbu aNavum **","panRiyAy anRu pAragam kINDa *","pAzhiyAn AzhiyAn aruLE *","nanRu nAn uyya nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["வென்றியே வேண்டி வீழ் பொருட்கு இரங்கி *","வேற்கணார் கலவியே கருதி *","நின்றவா நில்லா நெஞ்சினை உடையேன் *","என் செய்கேன்? நெடு விசும்பு அணவும் **","பன்றியாய் அன்று பாரகம் கீண்ட *","பாழியான் ஆழியான் அருளே *","நன்று நான் உய்ய நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.4.mp3"],[952,952,["kaLvanEn AnEn paDiRu seydhiruppEn *","kaNDavA thirithandhEnElum *","theLLiyEn AnEn sel kadhikkamaindhEn *","chikkenath thiruvaruL peRREn **","uLLelAm urugik kural thazhuththu ozhindhEn *","uDambelAm kaNNa nIr sOra *","naLLiruL aLavum pagalum nAn azhaippan *","nArAyaNA ennum nAmam"],["கள்வனேன் ஆனேன் படிறு செய்திருப்பேன் *","கண்டவா திரிதந்தேனேலும் *","தெள்ளியேன் ஆனேன் செல் கதிக்கமைந்தேன் *","சிக்கெனத் திருவருள் பெற்றேன் **","உள்ளெலாம் உருகிக் குரல் தழுத்து ஒழிந்தேன் *","உடம்பெலாம் கண்ண நீர் சோர *","நள்ளிருள் அளவும் பகலும் நான் அழைப்பன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.5.mp3"],[953,953,["** empirAn endhai ennuDaich chuRRam *","enakkarasu ennuDai vANAL *","ambinAl arakkar verukkoLa nerukki *","avar uyir seguththa em aNNal **","vambulAm sOlai mAmadhiL *","thanjchai mAmaNikkOyilE vaNanggi *","nambigAL! uyya nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["** எம்பிரான் எந்தை என்னுடைச் சுற்றம் *","எனக்கரசு என்னுடை வாணாள் *","அம்பினால் அரக்கர் வெருக்கொள நெருக்கி *","அவர் உயிர் செகுத்த எம் அண்ணல் **","வம்புலாம் சோலை மாமதிள் *","தஞ்சை மாமணிக்கோயிலே வணங்கி *","நம்பிகாள்! உய்ய நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.6.mp3"],[954,954,["iRpiRappu aRiyIr ivar avar ennIr *","innadhOr thanmai enRu uNarIr *","kaRpagam pulavar kaLaikaN enRu ulagil *","kaNDavA thoNDaraip pADum **","soRporuL ALIr sollugEn vammin *","sUzhpunaR kuDandhaiyE thozhumin *","naRporuL kANmin pADi nIr uymmin *","nArAyaNA ennum nAmam"],["இற்பிறப்பு அறியீர் இவர் அவர் என்னீர் *","இன்னதோர் தன்மை என்றுணரீர் *","கற்பகம் புலவர் களைகண் என்று உலகில் *","கண்டவா தொண்டரைப் பாடும் **","சொற்பொருள் ஆளீர் சொல்லுகேன் வம்மின் *","சூழ்புனற் குடந்தையே தொழுமின் *","நற்பொருள் காண்மின் பாடி நீர் உய்ம்மின் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.7.mp3"],[955,955,["kaRRilEn kalaigaL aimpulan karudhum *","karuththuLE thiruththinEn manaththai *","peRRilEn adhanAl pEdhaiyEn nanmai *","perunilaththu Aruyirkku ellAm **","seRRamE vENDith thiritharvEn thavirndhEn *","sel kadhikku uyyumARu eNNi *","nalthuNaiyAgap paRRinEn aDiyEn *","nArAyaNA ennum nAmam"],["கற்றிலேன் கலைகள் ஐம்புலன் கருதும் *","கருத்துளே திருத்தினேன் மனத்தை *","பெற்றிலேன் அதனால் பேதையேன் நன்மை *","பெருநிலத்து ஆருயிர்க்கு எல்லாம் **","செற்றமே வேண்டித் திரிதர்வேன் தவிர்ந்தேன் *","செல் கதிக்கு உய்யுமாறு எண்ணி *","நல்துணையாகப் பற்றினேன் அடியேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.8.mp3"],[956,956,["** kulam tharum selvam thandhiDum *","aDiyAr paDu thuyar Ayina ellAm *","nilam tharam cheyyum nIL visumbu aruLum *","aruLoDu perunilam aLikkum **","valam tharum maRRum thandhiDum *","peRRa thAyinum Ayina seyyum *","nalam tharum sollai nAn kaNDu koNDEn *","nArAyaNA ennum nAmam"],["** குலம் தரும் செல்வம் தந்திடும் *","அடியார் படு துயர் ஆயின எல்லாம் *","நிலம் தரம் செய்யும் நீள் விசும்பு அருளும் *","அருளொடு பெருநிலம் அளிக்கும் **","வலம் தரும் மற்றும் தந்திடும் *","பெற்ற தாயினும் ஆயின செய்யும் *","நலம் தரும் சொல்லை நான் கண்டு கொண்டேன் *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.9.mp3"],[957,957,["** manjchulAm sOlai vaNDaRai mAnIr *","manggaiyAr vAL kali kanRi *","senjcholAl eDuththa dheyva nalmAlai *","ivai koNDu chikkenath thoNDIr! **","thunjchum pOdhu azhaimin thuyar varil ninaimin *","thuyarilIr sollilum nanRAm *","nanjchu thAn kaNDIr nammuDai vinaikku *","nArAyaNA ennum nAmam"],["** மஞ்சுலாம் சோலை வண்டறை மாநீர் *","மங்கையார் வாள் கலி கன்றி *","செஞ்சொலால் எடுத்த தெய்வ நல்மாலை *","இவை கொண்டு சிக்கெனத் தொண்டீர்! **","துஞ்சும் போது அழைமின் துயர் வரில் நினைமின் *","துயரிலீர் சொல்லிலும் நன்றாம் *","நஞ்சு தான் கண்டீர் நம்முடை வினைக்கு *","நாராயணா என்னும் நாமம்"],0,"/media/recitation/PT.1.1.10.mp3"]],[[958,958,["vāli mā valattu ŏruvaṉatu uṭal kĕṭa * vari cilai val̤aivittu * aṉṟu","elam nāṟu taṇ taṭam pŏzhil iṭampĕṟa * irunta nal imayattul̤ **","āli mā mukil atirtara aru varai * akaṭu uṟa mukaṭu eṟi *","pīli mā mayil naṭam cĕyum taṭañ cuṉaip * piriti cĕṉṟu aṭai nĕñce!"],["வாலி மா வலத்து ஒருவனது உடல் கெட * வரி சிலை வளைவித்து * அன்று","ஏலம் நாறு தண் தடம் பொழில் இடம்பெற * இருந்த நல் இமயத்துள் **","ஆலி மா முகில் அதிர்தர அரு வரை * அகடு உற முகடு ஏறி *","பீலி மா மயில் நடம் செயும் தடஞ் சுனைப் * பிரிதி சென்று அடை நெஞ்சே!"],1,"/media/recitation/PT.1.2.1.mp3"],[959,959,["kalangga mAkkaDal arikulam paNi seyya *","aruvarai aNai kaTTi *","ilanggai mAnagar poDi seydha aDigaL thAm *","irundha nal imayaththu **","vilanggal pOlvana viRal irunjchinaththana *","vEzhanggaL thuyar kUra *","pilangkoL vAL eyiRRu ari avai thiri tharu *","piridhi senRaDai nenjchE!"],["கலங்க மாக்கடல் அரிகுலம் பணி செய்ய *","அருவரை அணை கட்டி *","இலங்கை மாநகர் பொடி செய்த அடிகள் தாம் *","இருந்த நல் இமயத்து **","விலங்கல் போல்வன விறல் இருஞ்சினத்தன *","வேழங்கள் துயர் கூர *","பிலங்கொள் வாள் எயிற்று அரி அவை திரி தரு *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.2.mp3"],[960,960,["thuDikoL nuNNiDaich churikuzhal *","thuLanggeyiRRu iLangkoDi thiRaththu * Ayar","iDikoL vengkural inaviDai aDarththavan *","irundha nal imayaththu **","kaDikoL vEnggaiyin naRumalar amaLiyin *","maNi aRai misai vEzham *","piDiyinODu vaNDu isai solath thuyil koLum *","piridhi senRaDai nenjchE!"],["துடிகொள் நுண்ணிடைச் சுரிகுழல் *","துளங்கெயிற்று இளங்கொடி திறத்து * ஆயர்","இடிகொள் வெங்குரல் இனவிடை அடர்த்தவன் *","இருந்த நல் இமயத்து **","கடிகொள் வேங்கையின் நறுமலர் அமளியின் *","மணி அறை மிசை வேழம் *","பிடியினோடு வண்டு இசை சொலத் துயில் கொளும் *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.3.mp3"],[961,961,["maRangkoL ALari uruvena veruvara *","oruvanadhu agal mArvam","thiRandhu * vAnavar maNimuDi paNi thara *","irundha nal imayaththuL **","iRanggi EnanggaL vaLai maruppu iDandhiDak *","kiDandhu arugeri vIsum *","piRanggu mAmaNi aruviyoDu izhitharu *","piridhi senRaDai nenjchE!"],["மறங்கொள் ஆளரி உருவென வெருவர *","ஒருவனது அகல் மார்வம்","திறந்து * வானவர் மணிமுடி பணி தர *","இருந்த நல் இமயத்துள் **","இறங்கி ஏனங்கள் வளை மருப்பு இடந்திடக் *","கிடந்து அருகெரி வீசும் *","பிறங்கு மாமணி அருவியொடு இழிதரு *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.4.mp3"],[962,962,["karaisey mAkkaDal kiDandhavan *","kanaikazhal amarargaL thozhudhEththa *","araisey mEgalai alarmagaL avaLoDum *","amarndha nal imayaththu **","varaisey mAkkaLiRu iLavedhir vaLar muLai *","aLaimigu thEn thOyththu *","pirasavAri than iLampiDikku aruL seyum *","piridhi senRaDai nenjchE!"],["கரைசெய் மாக்கடல் கிடந்தவன் *","கனைகழல் அமரர்கள் தொழுதேத்த *","அரைசெய் மேகலை அலர்மகள் அவளொடும் *","அமர்ந்த நல் இமயத்து **","வரைசெய் மாக்களிறு இளவெதிர் வளர் முளை *","அளைமிகு தேன் தோய்த்து *","பிரசவாரி தன் இளம்பிடிக்கு அருள் செயும் *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.5.mp3"],[963,963,["paNanggaL Ayiram uDaiya nal aravaNaip","paLLi koL * paramA! enRu *","iNanggi vAnavar maNimuDi paNi thara *","irundha nal imayaththu **","maNangkoL mAdhavi neDungkoDi visumbuRa *","nimirndhu avai mugil paRRi *","piNanggu pUmpozhil nuzhaindhu vaND isai solum *","piridhi senRaDai nenjchE!"],["பணங்கள் ஆயிரம் உடைய நல் அரவணைப்","பள்ளி கொள் * பரமா! என்று *","இணங்கி வானவர் மணிமுடி பணி தர *","இருந்த நல் இமயத்து **","மணங்கொள் மாதவி நெடுங்கொடி விசும்புற *","நிமிர்ந்து அவை முகில் பற்றி *","பிணங்கு பூம்பொழில் நுழைந்து வண்டு இசை சொலும் *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.6.mp3"],[964,964,["kAr koL vEnggaigaL kanavarai thazhuviya *","kaRivaLar koDi thunni *","pOr koL vEnggaigaL punavarai thazhuviya *","pUmpozhil imayaththuL **","Er koL pUnjchunaith thaDam paDindhu *","inamalar eTTum iTTu imaiyOrgaL *","pErgaL Ayiram paravi ninRaDi thozhum *","piridhi senRaDai nenjchE!"],["கார் கொள் வேங்கைகள் கனவரை தழுவிய *","கறிவளர் கொடி துன்னி *","போர் கொள் வேங்கைகள் புனவரை தழுவிய *","பூம்பொழில் இமயத்துள் **","ஏர் கொள் பூஞ்சுனைத் தடம் படிந்து *","இனமலர் எட்டும் இட்டு இமையோர்கள் *","பேர்கள் ஆயிரம் பரவி நின்றடி தொழும் *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.7.mp3"],[965,965,["iravu kUrndhu iruL perugiya varai muzhai *","irumpasi adhu kUra *","aravam Avikkum agam pozhil thazhuviya *","aruvarai imayaththu **","paraman Adhi em pani mugil vaNNan enRu *","eNNi ninRu imaiyOrgaL *","piramanODu senRu aDi thozhum perunthagai *","piridhi senRaDai nenjchE!"],["இரவு கூர்ந்து இருள் பெருகிய வரை முழை *","இரும்பசி அது கூர *","அரவம் ஆவிக்கும் அகம் பொழில் தழுவிய *","அருவரை இமயத்து **","பரமன் ஆதி எம் பனி முகில் வண்ணன் என்று *","எண்ணி நின்று இமையோர்கள் *","பிரமனோடு சென்று அடி தொழும் பெருந்தகை *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.8.mp3"],[966,966,["Odhi Ayira nAmanggaL uNarndhavarkku *","uRuthuyar aDaiyAmal *","Edham inRi ninRu aruLum nam perunthagai *","irundha nal imayaththu **","thAdhu malgiya piNDi viNDu alarginRa *","thazhal purai ezhil nOkki *","pEdhai vaNDugaL eri ena veruvaru *","piridhi senRaDai nenjchE!"],["ஓதி ஆயிர நாமங்கள் உணர்ந்தவர்க்கு *","உறுதுயர் அடையாமல் *","ஏதம் இன்றி நின்று அருளும் நம் பெருந்தகை *","இருந்த நல் இமயத்து **","தாது மல்கிய பிண்டி விண்டு அலர்கின்ற *","தழல் புரை எழில் நோக்கி *","பேதை வண்டுகள் எரி என வெருவரு *","பிரிதி சென்றடை நெஞ்சே!"],0,"/media/recitation/PT.1.2.9.mp3"],[967,967,["** kariya mAmugil paDalanggaL kiDandhu *","avai muzhanggiDa * kaLiRenRu","periya mAsuNam varai enap peyar tharu *","piridhi emperumAnai **","varikoL vaNDaRai paimpozhil manggaiyar *","kaliyanadhu oli mAlai *","ariya innisai pADum nal aDiyavarkku *","aruvinai aDaiyAvE"],["** கரிய மாமுகில் படலங்கள் கிடந்து *","அவை முழங்கிட * களிறென்று","பெரிய மாசுணம் வரை எனப் பெயர் தரு *","பிரிதி எம்பெருமானை **","வரிகொள் வண்டறை பைம்பொழில் மங்கையர் *","கலியனது ஒலி மாலை *","அரிய இன்னிசை பாடும் நல் அடியவர்க்கு *","அருவினை அடையாவே"],0,"/media/recitation/PT.1.2.10.mp3"]],[[968,968,["** muRRa mUththuk kOl thuNaiyA * munnaDi nOkki vaLaindhu *","iRRa kAl pOl thaLLi meLLa * irundhu anggu iLaiyA mun **","peRRa thAy pOl vandha pEychchi * peru mulaiyUDu * uyirai","vaRRa vAnggi uNDa vAyAn * vadhari vaNanggudhumE"],["** முற்ற மூத்துக் கோல் துணையா * முன்னடி நோக்கி வளைந்து *","இற்ற கால் போல் தள்ளி மெள்ள * இருந்து அங்கு இளையா முன் **","பெற்ற தாய் போல் வந்த பேய்ச்சி * பெரு முலையூடு * உயிரை","வற்ற வாங்கி உண்ட வாயான் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.1.mp3"],[969,969,["mudhugu paRRik kaiththalaththAl * munnoru kOl UnRi *","vidhir vidhirththuk kaN suzhanRu * mERkiLai koNDu irumi **","idhu en appar mUththa ARenRu * iLaiyavar EsA mun *","madhu uN vaNDu paNgaL pADum * vadhari vaNanggudhumE"],["முதுகு பற்றிக் கைத்தலத்தால் * முன்னொரு கோல் ஊன்றி *","விதிர் விதிர்த்துக் கண் சுழன்று * மேற்கிளை கொண்டு இருமி **","இது என் அப்பர் மூத்த ஆறென்று * இளையவர் ஏசா முன் *","மது உண் வண்டு பண்கள் பாடும் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.2.mp3"],[970,970,["uṟikal̤ pol mĕyn narampu ĕzhuntu * ūṉ tal̤arntu ul̤l̤am ĕl̤ki *","nĕṟiyai nokkik kaṇ cuzhaṉṟu * niṉṟu naṭuṅkāmuṉ **","aṟiti ākil nĕñcam! aṉpāy * āyiram nāmam cŏlli *","vĕṟi kŏl̤ vaṇṭu paṇkal̤ pāṭum * vatari vaṇaṅkutume"],["உறிகள் போல் மெய்ந் நரம்பு எழுந்து * ஊன் தளர்ந்து உள்ளம் எள்கி *","நெறியை நோக்கிக் கண் சுழன்று * நின்று நடுங்காமுன் **","அறிதி ஆகில் நெஞ்சம்! அன்பாய் * ஆயிரம் நாமம் சொல்லி *","வெறி கொள் வண்டு பண்கள் பாடும் * வதரி வணங்குதுமே"],1,"/media/recitation/PT.1.3.3.mp3"],[971,971,["pILai sOrak kaN iDunggip * piththezha mUththu irumi *","thALgaL nOvath thammil muTTith * thaLLi naDavA mun **","kALaiyAgik kanRu mEyththuk * kunReDuththu anRu ninRAn *","vALai pAyum thaN thaDam sUzh * vadhari vaNanggudhumE"],["பீளை சோரக் கண் இடுங்கிப் * பித்தெழ மூத்து இருமி *","தாள்கள் நோவத் தம்மில் முட்டித் * தள்ளி நடவா முன் **","காளையாகிக் கன்று மேய்த்துக் * குன்றெடுத்து அன்று நின்றான் *","வாளை பாயும் தண் தடம் சூழ் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.4.mp3"],[972,972,["paNDu kAmar AnavARum * pAvaiyar vAy amudham","uNDavARum * vAzhndhavARum * okka uraiththu irumi **","thaNDu kAlA UnRi UnRith * thaLLi naDavA mun *","vaNDu pADum thaNthuzhAyAn * vadhari vaNanggudhumE"],["பண்டு காமர் ஆனவாறும் * பாவையர் வாய் அமுதம்","உண்டவாறும் * வாழ்ந்தவாறும் * ஒக்க உரைத்து இருமி **","தண்டு காலா ஊன்றி ஊன்றித் * தள்ளி நடவா முன் *","வண்டு பாடும் தண்துழாயான் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.5.mp3"],[973,973,["eyththa sollODu ILai Enggi * irumi iLaiththu uDalam *","piththar pOlach siththam vERAyp * pEsi ayarA mun **","aththan endhai Adhi mUrththi * AzhkaDalaik kaDaindha *","maiththa sOdhi emperumAn * vadhari vaNanggudhumE"],["எய்த்த சொல்லோடு ஈளை ஏங்கி * இருமி இளைத்து உடலம் *","பித்தர் போலச் சித்தம் வேறாய்ப் * பேசி அயரா முன் **","அத்தன் எந்தை ஆதி மூர்த்தி * ஆழ்கடலைக் கடைந்த *","மைத்த சோதி எம்பெருமான் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.6.mp3"],[974,974,["pappa appar mUththavARu * pAzhppadhu sIththiraLai","oppa * aikkaL pOdha undha * un thamar kANmin enRu **","seppu nEr menkonggai nallAr * thAm siriyAdha munnam *","vaippum nanggaL vAzhvum AnAn * vadhari vaNanggudhumE"],["பப்ப அப்பர் மூத்தவாறு * பாழ்ப்பது சீத்திரளை","ஒப்ப * ஐக்கள் போத உந்த * உன் தமர் காண்மின் என்று **","செப்பு நேர் மென்கொங்கை நல்லார் * தாம் சிரியாத முன்னம் *","வைப்பும் நங்கள் வாழ்வும் ஆனான் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.7.mp3"],[975,975,["īci pomiṉ īṅku ireṉmiṉ * irumi il̤aittīr * ul̤l̤am","kūci iṭṭīr ĕṉṟu pecum * kuval̤ai am kaṇṇiyar pāl **","nācam āṉa pācam viṭṭu * nal nĕṟi nokkal uṟil *","vācam malku taṇ tuzhāyāṉ * vatari vaṇaṅkutume"],["ஈசி போமின் ஈங்கு இரேன்மின் * இருமி இளைத்தீர் * உள்ளம்","கூசி இட்டீர் என்று பேசும் * குவளை அம் கண்ணியர் பால் **","நாசம் ஆன பாசம் விட்டு * நல் நெறி நோக்கல் உறில் *","வாசம் மல்கு தண் துழாயான் * வதரி வணங்குதுமே"],1,"/media/recitation/PT.1.3.8.mp3"],[976,976,["pulankaL naiya meyyil mUththup * pOndhirundhu uLLam eLgi *","kalangga aikkaL pOdha undhik * kaNDa pidhaRRA mun **","alanggalAya thaNthuzhAy koNDu * Ayira nAmam solli *","valangkoL thoNDar pADi ADum * vadhari vaNanggudhumE"],["புலன்கள் நைய மெய்யில் மூத்துப் * போந்திருந்து உள்ளம் எள்கி *","கலங்க ஐக்கள் போத உந்திக் * கண்ட பிதற்றா முன் **","அலங்கலாய தண்துழாய் கொண்டு * ஆயிர நாமம் சொல்லி *","வலங்கொள் தொண்டர் பாடி ஆடும் * வதரி வணங்குதுமே"],0,"/media/recitation/PT.1.3.9.mp3"],[977,977,["** vaNDu thaNthEn uNDu vAzhum * vadhari neDumAlai *","kaNDal vEli manggai vEndhan * kaliyan oli mAlai **","koNDu thoNDar pADi ADak * kUDiDil nILvisumbil *","aNDam allAl maRRu avarkku * Or ATchi aRiyOmE"],["** வண்டு தண்தேன் உண்டு வாழும் * வதரி நெடுமாலை *","கண்டல் வேலி மங்கை வேந்தன் * கலியன் ஒலி மாலை **","கொண்டு தொண்டர் பாடி ஆடக் * கூடிடில் நீள்விசும்பில் *","அண்டம் அல்லால் மற்று அவர்க்கு * ஓர் ஆட்சி அறியோமே"],0,"/media/recitation/PT.1.3.10.mp3"]],[[978,978,["** EnamunAgi irunilam iDandhu *","anRu iNaiyaDi imaiyavar vaNangga *","dhAnavan Agam tharaNiyil puraLath *","thaDanjchilai kuniththa en thalaivan **","thEnamar sOlaik kaRpagam payandha *","dheyva nal naRumalar koNarndhu *","vAnavar vaNanggum ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["** ஏனமுனாகி இருநிலம் இடந்து *","அன்று இணையடி இமையவர் வணங்க *","தானவன் ஆகம் தரணியில் புரளத் *","தடஞ்சிலை குனித்த என் தலைவன் **","தேனமர் சோலைக் கற்பகம் பயந்த *","தெய்வ நல் நறுமலர் கொணர்ந்து *","வானவர் வணங்கும் கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.1.mp3"],[979,979,["kAniDai uruvaich chuDu saram thurandhu *","kaNDu mun koDunthozhil uravOn *","UnuDai agalaththu aDukaNai kuLippa *","uyir kavarndhu ugandha em oruvan **","thEnuDaik kamalaththu ayanoDu dhEvar *","senRu senRu iRainjchiDa * perugu","vAniDai mudhu nIrk ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["கானிடை உருவைச் சுடு சரம் துரந்து *","கண்டு முன் கொடுந்தொழில் உரவோன் *","ஊனுடை அகலத்து அடுகணை குளிப்ப *","உயிர் கவர்ந்து உகந்த எம் ஒருவன் **","தேனுடைக் கமலத்து அயனொடு தேவர் *","சென்று சென்று இறைஞ்சிட * பெருகு","வானிடை முது நீர்க் கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.2.mp3"],[980,980,["ilanggaiyum kaDalum aDal arunthuppin *","irunidhikku iRaivanum * arakkar","kulanggaLum keDa mun koDunthozhil purindha","koRRavan * kozhunjchuDar suzhanRa **","vilanggalil urinjchi mEl ninRa visumbil *","veNthugil koDi ena virindhu *","valantharu maNi nIrk ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["இலங்கையும் கடலும் அடல் அருந்துப்பின் *","இருநிதிக்கு இறைவனும் * அரக்கர்","குலங்களும் கெட முன் கொடுந்தொழில் புரிந்த","கொற்றவன் * கொழுஞ்சுடர் சுழன்ற **","விலங்கலில் உரிஞ்சி மேல் நின்ற விசும்பில் *","வெண்துகில் கொடி என விரிந்து *","வலந்தரு மணி நீர்க் கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.3.mp3"],[981,981,["thuNivu ini unakkuch solluvan manamE! *","thozhudhezhu thoNDargaL thamakku *","piNi ozhiththu amarar peruvisumbu aruLum *","pEraruLALan emperumAn **","aNimalark kuzhalAr arambaiyar thugilum *","Aramum vAri vandhu * aNinIr","maNi kozhiththu izhindha ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["துணிவு இனி உனக்குச் சொல்லுவன் மனமே! *","தொழுதெழு தொண்டர்கள் தமக்கு *","பிணி ஒழித்து அமரர் பெருவிசும்பு அருளும் *","பேரருளாளன் எம்பெருமான் **","அணிமலர்க் குழலார் அரம்பையர் துகிலும் *","ஆரமும் வாரி வந்து * அணி நீர்","மணி கொழித்து இழிந்த கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.4.mp3"],[982,982,["pEy iDaikkirundhu vandha maRRavaL than *","perumulai suvaiththiDa * peRRa","thAy iDaikkiruththal anjchuvan enRu thaLarndhiDa *","vaLarndha en thalaivan **","sEy mugaTTuchchi aNDamum sumandha *","semponsey vilanggalil ilanggu *","vAy mugaTTizhindha ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["பேய் இடைக்கிருந்து வந்த மற்றவள் தன் *","பெருமுலை சுவைத்திட * பெற்ற","தாய் இடைக்கிருத்தல் அஞ்சுவன் என்று தளர்ந்திட *","வளர்ந்த என் தலைவன் **","சேய் முகட்டுச்சி அண்டமும் சுமந்த *","செம்பொன்செய் விலங்கலில் இலங்கு *","வாய் முகட்டிழிந்த கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.5.mp3"],[983,983,["thEraNanggu algul sezhungkayal kaNNi thiRaththu *","oru maRath thozhil purindhu *","pAraNanggu imil EREzhum mun aDarththa *","panimugil vaNNan emperumAn **","kAraNam thannAl kaDumpunal kayaththa *","karuvarai piLavezhak kuththi *","vAraNam koNarndha ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["தேரணங்கு அல்குல் செழுங்கயல் கண்ணி திறத்து *","ஒரு மறத் தொழில் புரிந்து *","பாரணங்கு இமில் ஏறேழும் முன் அடர்த்த *","பனிமுகில் வண்ணன் எம்பெருமான் **","காரணம் தன்னால் கடும்புனல் கயத்த *","கருவரை பிளவெழக் குத்தி *","வாரணம் கொணர்ந்த கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.6.mp3"],[984,984,["venthiRal kaLiRum vElai vAy amudhum *","viNNoDu viNNavarkku arasum *","indhiraRku aruLi emakkum IndharuLum *","endhai em aDigaL emperumAn **","andharaththu amarar aDiyiNai vaNangga *","Ayira mugaththinAl aruLi *","mandharaththu izhindha ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["வெந்திறல் களிறும் வேலை வாய் அமுதும் *","விண்ணொடு விண்ணவர்க்கு அரசும் *","இந்திரற்கு அருளி எமக்கும் ஈந்தருளும் *","எந்தை எம் அடிகள் எம்பெருமான் **","அந்தரத்து அமரர் அடியிணை வணங்க *","ஆயிர முகத்தினால் அருளி *","மந்தரத்து இழிந்த கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.7.mp3"],[985,985,["mAn munindhu orukAl varisilai vaLaiththa","mannavan * ponniRaththu uravOn *","Un munindhu avanadhu uDal irupiLavA *","ugir nudhi maDuththu ** ayan aranaith","thAn munindhiTTa * venthiRal sAbam thavirththavan *","thavam purindhu uyarndha","mAmuni koNarndha ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnE"],["மான் முனிந்து ஒருகால் வரிசிலை வளைத்த","மன்னவன் * பொன்னிறத்து உரவோன் *","ஊன் முனிந்து அவனது உடல் இருபிளவா *","உகிர் நுதி மடுத்து ** அயன் அரனைத்","தான் முனிந்திட்ட * வெந்திறல் சாபம் தவிர்த்தவன் *","தவம் புரிந்து உயர்ந்த","மாமுனி கொணர்ந்த கங்கையின் கரை மேல் *","வதரியாச்சிராமத்துள்ளானே"],0,"/media/recitation/PT.1.4.8.mp3"],[986,986,["kŏṇṭal mārutaṅkal̤ kula varai tŏku nīrk * kurai kaṭal ulaku uṭaṉ aṉaittum *","uṇṭa mā vayiṟṟoṉ ŏṇ cuṭar eynta * umparum ūzhiyum āṉāṉ **","aṇṭam ūṭu aṟuttu aṉṟu antarattu izhintu * aṅku avaṉiyāl̤ alamara * pĕrukum","maṇṭu mā maṇi nīrk kaṅkaiyiṉ karaimel * vatari āccirāmattu ul̤l̤āṉe-9 **"],["கொண்டல் மாருதங்கள் குல வரை தொகு நீர்க் * குரை கடல் உலகு உடன் அனைத்தும் *","உண்ட மா வயிற்றோன் ஒண் சுடர் ஏய்ந்த * உம்பரும் ஊழியும் ஆனான் **","அண்டம் ஊடு அறுத்து அன்று அந்தரத்து இழிந்து * அங்கு அவனியாள் அலமர * பெருகும்","மண்டு மா மணி நீர்க் கங்கையின் கரைமேல் * வதரி ஆச்சிராமத்து உள்ளானே 9 **"],1,"/media/recitation/PT.1.4.9.mp3"],[987,987,["** varunthirai maNi nIrk ganggaiyin karai mEl *","vadhariyAchchirAmaththuLLAnai *","karungkaDal munnIr vaNNanai eNNik *","kaliyan vAyoli seydha panuval **","varam seydha aindhum aindhum vallArgaL *","vAnavar ulaguDan maruvi *","irungkaDal ulagam ANDu veNkuDaik kIzh *","imaiyavar Aguvar thAmE"],["** வருந்திரை மணி நீர்க் கங்கையின் கரை மேல் *","வதரியாச்சிராமத்து உள்ளானை *","கருங்கடல் முந்நீர் வண்ணனை எண்ணிக் *","கலியன் வாயொலி செய்த பனுவல் **","வரம் செய்த ஐந்தும் ஐந்தும் வல்லார்கள் *","வானவர் உலகுடன் மருவி *","இருங்கடல் உலகம் ஆண்டு வெண்குடைக் கீழ் *","இமையவர் ஆகுவர் தாமே"],0,"/media/recitation/PT.1.4.10.mp3"]]]