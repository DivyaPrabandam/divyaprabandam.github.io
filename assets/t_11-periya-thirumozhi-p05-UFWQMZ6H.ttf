[[[1148,1148,["** irunthaN mAnilam EnamadhAy * vaLai maruppinil agaththu oDukki *","karunthaN mAkaDal kaN thuyinRavan iDam * kamala nanmalarth thERal","arundhi ** innisai muranRezhum aLi kulam podhuLi * ampozhil UDE *","serundhi nANmalar senRaNaindhu uzhi tharu * thiruvayindhirapuramE"],["** இருந்தண் மாநிலம் ஏனமதாய் * வளை மருப்பினில் அகத்து ஒடுக்கி *","கருந்தண் மாகடல் கண் துயின்றவன் இடம் * கமல நன்மலர்த் தேறல்","அருந்தி ** இன்னிசை முரன்றெழும் அளி குலம் பொதுளி * அம்பொழில் ஊடே *","செருந்தி நாண்மலர் சென்றணைந்து உழி தரு * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.1.mp3"],[1149,1149,["minnum Azhi angkai avan * seyyavaL uRai tharu thirumArban *","pannu nAnmaRaip palporuL Agiya * paran iDam varaich chAral **","pinnum mAdhavip pandhalil peDai varap * piNi avizh kamalaththu *","thennavenRu vaNDu innisai mural tharu * thiruvayindhirapuramE"],["மின்னும் ஆழி அங்கை அவன் * செய்யவள் உறை தரு திருமார்பன் *","பன்னு நான்மறைப் பல்பொருள் ஆகிய * பரன் இடம் வரைச் சாரல் **","பின்னும் மாதவிப் பந்தலில் பெடை வரப் * பிணி அவிழ் கமலத்து *","தென்னவென்று வண்டு இன்னிசை முரல் தரு * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.2.mp3"],[1150,1150,["vaiyam ezhum uṇṭu āl ilai vaikiya","māyavaṉ * aṭiyavarkku","mĕyyaṉ ākiya tĕyvanāyakaṉ iṭam- *","mĕytaku varaic cāral **","mŏy kŏl̤ mātavi caṇpakam muyaṅkiya *","mullai am kŏṭi āṭa *","cĕyya tāmaraic cĕzhum paṇai tikazhtaru *","tiruvayintirapurame-3 *"],["வையம் ஏழும் உண்டு ஆல் இலை வைகிய","மாயவன் * அடியவர்க்கு","மெய்யன் ஆகிய தெய்வநாயகன் இடம் *","மெய்தகு வரைச் சாரல் **","மொய் கொள் மாதவி சண்பகம் முயங்கிய *","முல்லை அம் கொடி ஆட *","செய்ய தாமரைச் செழும் பணை திகழ்தரு *","திருவயிந்திரபுரமே 3 *"],1,"/media/recitation/PT.3.1.3.mp3"],[1151,1151,["mARu koNDu uDanRu edhirndha vallavuNan than * mArbagam iru piLavA *","kURu koNDu avan kula magaRku * innaruL koDuththavan iDam ** miDaindhu","sARu koNDa menkarumbu iLangkazhai * thagai visumbuRa maNi nIzhal *","sERu koNDa thaNpazhanamadhu ezhil thigazh * thiruvayindhirapuramE"],["மாறு கொண்டு உடன்று எதிர்ந்த வல்லவுணன் தன் * மார்பகம் இரு பிளவா *","கூறு கொண்டு அவன் குல மகற்கு * இன்னருள் கொடுத்தவன் இடம் ** மிடைந்து","சாறு கொண்ட மென்கரும்பு இளங்கழை * தகை விசும்புற மணி நீழல் *","சேறு கொண்ட தண்பழனமது எழில் திகழ் * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.4.mp3"],[1152,1152,["Anggu mAvali vELviyil irandhu senRu * agal iDam aLandhu * Ayar","pUngkoDikku ina viDai porudhavan iDam * ponmalar thigazh ** vEnggai","kOnggu seNbagak kombinil * kudhikoDu kurakkinam iraiththODi *","thEn kalandha thaNpalangkani nugar tharu * thiruvayindhirapuramE"],["ஆங்கு மாவலி வேள்வியில் இரந்து சென்று * அகல் இடம் அளந்து * ஆயர்","பூங்கொடிக்கு இன விடை பொருதவன் இடம் * பொன்மலர் திகழ் ** வேங்கை","கோங்கு செண்பகக் கொம்பினில் * குதிகொடு குரக்கினம் இரைத்தோடி *","தேன் கலந்த தண்பலங்கனி நுகர் தரு * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.5.mp3"],[1153,1153,["kUn ulAviya maDandhai than * koDunjcholin thiRaththu iLangkoDiyODum *","kAn ulAviya karumugil thiruniRaththavan iDam * kavin Arum **","vAn ulAviya madhi thavazh mAl varai * mAmadhiL puDai sUzha *","thEn ulAviya sezhum pozhil thazhuviya * thiruvayindhirapuramE"],["கூன் உலாவிய மடந்தை தன் * கொடுஞ்சொலின் திறத்து இளங்கொடியோடும் *","கான் உலாவிய கருமுகில் திருநிறத்தவன் இடம் * கவின் ஆரும் **","வான் உலாவிய மதி தவழ் மால் வரை * மாமதிள் புடை சூழ *","தேன் உலாவிய செழும் பொழில் தழுவிய * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.6.mp3"],[1154,1154,["minnin nuNNiDai maDakkoDi kAraNam * vilanggalin misai ilanggai","mannan * nILmuDi poDi seydha maindhanadhu iDam * maNi varai nIzhal **","anna mAmalar aravindhaththu amaLiyil * peDaiyoDum inidhamara *","sennelAr kavarik kulai vIsu thaN * thiruvayindhirapuramE"],["மின்னின் நுண்ணிடை மடக்கொடி காரணம் * விலங்கலின் மிசை இலங்கை","மன்னன் * நீள்முடி பொடி செய்த மைந்தனது இடம் * மணி வரை நீழல் **","அன்ன மாமலர் அரவிந்தத்து அமளியில் * பெடையொடும் இனிதமர *","செந்நெலார் கவரிக் குலை வீசு தண் * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.7.mp3"],[1155,1155,["virai kamazhndha menkarungkuzhal kAraNam * vil iRuththu aDal mazhaikku *","nirai kalanggiDa varai kuDai eDuththavan * nilaviya iDam thaDamAr **","varai vaLam thigazh madhakari maruppoDu * malai vaLar agil undhi *","thirai koNarndhu aNai sezhu nadhi vayal pugu * thiruvayindhirapuramE"],["விரை கமழ்ந்த மென்கருங்குழல் காரணம் * வில் இறுத்து அடல் மழைக்கு *","நிரை கலங்கிட வரை குடை எடுத்தவன் * நிலவிய இடம் தடமார் **","வரை வளம் திகழ் மதகரி மருப்பொடு * மலை வளர் அகில் உந்தி *","திரை கொணர்ந்து அணை செழு நதி வயல் புகு * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.8.mp3"],[1156,1156,["vEl koL kaiththalaththu arasar vempOrinil * visayanukkAy maNith thEr *","kOl koL kaiththalaththu endhai pemmAn iDam * kulavu thaN varaich chAral **","kAl koL kaN koDik kaiyezhak * kamugu iLam pALaigaL kamazh sAral *","sElgaL pAy tharu sezhu nadhi vayal pugu * thiruvayindhirapuramE"],["வேல் கொள் கைத்தலத்து அரசர் வெம்போரினில் * விசயனுக்காய் மணித் தேர் *","கோல் கொள் கைத்தலத்து எந்தை பெம்மான் இடம் * குலவு தண் வரைச் சாரல் **","கால் கொள் கண் கொடிக் கையெழக் * கமுகு இளம் பாளைகள் கமழ் சாரல் *","சேல்கள் பாய் தரு செழு நதி வயல் புகு * திருவயிந்திரபுரமே"],0,"/media/recitation/PT.3.1.9.mp3"],[1157,1157,["** mUvarAgiya oruvanai * mUvulagu uNDu umizhndhu aLandhAnai *","dhEvar dhAnavar senRu senRu iRainjchath * thaN thiruvayindhirapuraththu **","mEvu sOdhiyai vEl valavan * kalikanRi viriththu uraiththa *","pAvu thaN thamizh paththivai pADiDap * pAvanggaL payilAvE"],["** மூவராகிய ஒருவனை * மூவுலகு உண்டு உமிழ்ந்து அளந்தானை *","தேவர் தானவர் சென்று சென்று இறைஞ்சத் * தண் திருவயிந்திரபுரத்து **","மேவு சோதியை வேல் வலவன் * கலிகன்றி விரித்து உரைத்த *","பாவு தண் தமிழ் பத்திவை பாடிடப் * பாவங்கள் பயிலாவே"],0,"/media/recitation/PT.3.1.10.mp3"]],[[1158,1158,["** Un vADa uNNAdhu uyir kAval iTTu *","uDalil piriyAp pulan aindhum nondhu *","thAm vADa vADath thavam seyya vENDA *","thamadhA imaiyOr ulagALa kiRpIr! **","kAn ADa manjnjaik kaNam ADa mADE *","kayal ADu kAnIrp pazhanam puDai pOy *","thEn ADa mADak koDi ADu * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["** ஊன் வாட உண்ணாது உயிர் காவல் இட்டு *","உடலில் பிரியாப் புலன் ஐந்தும் நொந்து *","தாம் வாட வாடத் தவம் செய்ய வேண்டா *","தமதா இமையோர் உலகாள கிற்பீர்! **","கான் ஆட மஞ்ஞைக் கணம் ஆட மாடே *","கயல் ஆடு கானீர்ப் பழனம் புடை போய் *","தேன் ஆட மாடக் கொடி ஆடு * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.1.mp3"],[1159,1159,["kAyODu nIDu kani uNDu * vIsu","kaDungkAl nugarndhu neDungkAlam * aindhu","thIyODu ninRu thavam seyya vENDA *","thirumArbanaich sindhaiyuL vaiththum enbIr! **","vAyOdhu vEdham maliginRa thol sIr *","maRaiyALar nALum muRaiyAl vaLarththa *","thIyOngga Onggap pugazh Onggu * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["காயோடு நீடு கனி உண்டு * வீசு","கடுங்கால் நுகர்ந்து நெடுங்காலம் * ஐந்து","தீயோடு நின்று தவம் செய்ய வேண்டா *","திருமார்பனைச் சிந்தையுள் வைத்தும் என்பீர்! **","வாயோது வேதம் மலிகின்ற தொல் சீர் *","மறையாளர் நாளும் முறையால் வளர்த்த *","தீயோங்க ஓங்கப் புகழ் ஓங்கு * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.2.mp3"],[1160,1160,["vembum sinaththup punak kEzhal onRAy *","virinIr mudhu veLLam uLpukku azhundha *","vambuN pozhil sUzh ulagu anRu eDuththAn *","aDip pOdhaNaivAn viruppODu iruppIr! **","paimponnum muththum maNiyum koNarndhu *","paDai mannavan pallavar kOn paNindha *","sempon maNi mADanggaL sUzhndha * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["வெம்பும் சினத்துப் புனக் கேழல் ஒன்றாய் *","விரிநீர் முது வெள்ளம் உள்புக்கு அழுந்த *","வம்புண் பொழில் சூழ் உலகு அன்று எடுத்தான் *","அடிப் போதணைவான் விருப்போடு இருப்பீர்! **","பைம்பொன்னும் முத்தும் மணியும் கொணர்ந்து *","படை மன்னவன் பல்லவர் கோன் பணிந்த *","செம்பொன் மணி மாடங்கள் சூழ்ந்த * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.3.mp3"],[1161,1161,["arumAnilam anRu aLappAn kuRaLAy *","avuNan peruvELviyil senRu irandha *","perumAn thirunAmam pidhaRRi * nuntham","piRavith thuyar nInggudhum enna kiRpIr! **","karumA kaDaluL kiDandhAn uvandhu *","kavai nA aravinaNaip paLLiyin mEl *","thirumAl thirumanggaiyoDADu * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["அருமாநிலம் அன்று அளப்பான் குறளாய் *","அவுணன் பெருவேள்வியில் சென்று இரந்த *","பெருமான் திருநாமம் பிதற்றி * நுந்தம்","பிறவித் துயர் நீங்குதும் என்ன கிற்பீர்! **","கருமா கடலுள் கிடந்தான் உவந்து *","கவை நா அரவினணைப் பள்ளியின் மேல் *","திருமால் திருமங்கையொடாடு * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.4.mp3"],[1162,1162,["kO mangga vanggak kaDal vaiyam uyyak *","kula mannar anggam mazhuvil thuNiya *","thAm anggu amaruL paDai thoTTa venRith *","thavamA muniyaith thamakkAkka kiRpIr! **","pUmanggai thanggip pulamanggai mannip *","pugazh manggai enggum thigazhap pugazh sEr *","sEmangkoL paimpUm pozhil sUzhndha * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["கோ மங்க வங்கக் கடல் வையம் உய்யக் *","குல மன்னர் அங்கம் மழுவில் துணிய *","தாம் அங்கு அமருள் படை தொட்ட வென்றித் *","தவமா முனியைத் தமக்காக்க கிற்பீர்! **","பூமங்கை தங்கிப் புலமங்கை மன்னிப் *","புகழ் மங்கை எங்கும் திகழப் புகழ் சேர் *","சேமங்கொள் பைம்பூம் பொழில் சூழ்ந்த * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.5.mp3"],[1163,1163,["neyvAy azhal ambu thurandhu * munnIr","thuNiyap paNi koNDu aNiyArndhu * ilanggu","maiyAr maNivaNNanai eNNi * nuntham","manaththE iruththumpaDi vAzha vallIr! **","avvAy iLamanggaiyar pEsavum thAn *","arumAmaRai andhaNar sindhai puga *","sevvAyk kiLi nAnmaRai pADu * thillaith","thiruchchithrakUDam senRu sErmingaLE"],["நெய்வாய் அழல் அம்பு துரந்து * முந்நீர்","துணியப் பணி கொண்டு அணியார்ந்து * இலங்கு","மையார் மணிவண்ணனை எண்ணி * நுந்தம்","மனத்தே இருத்தும்படி வாழ வல்லீர்! **","அவ்வாய் இளமங்கையர் பேசவும் தான் *","அருமாமறை அந்தணர் சிந்தை புக *","செவ்வாய்க் கிளி நான்மறை பாடு * தில்லைத்","திருச்சித்ரகூடம் சென்று சேர்மின்களே"],0,"/media/recitation/PT.3.2.6.mp3"],[1164,1164,["mauval kuzhal Aychchi menthOL nayandhu *","magaram suzhalach suzhal nIr payandha *","dheyvath thirumAmalar manggai thanggu *","thirumArbanaich sindhaiyuL vaiththum enbIr! **","kauvaik kaLiRRin maruppum poruppil *","kamazh sandhum undhi ni