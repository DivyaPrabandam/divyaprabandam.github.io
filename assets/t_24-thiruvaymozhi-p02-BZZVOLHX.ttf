[[[2901,2901,["** vAyum thirai ugaLum * kAnal maDa nArAy! *","Ayum amar ulagum * thunjchilum nI thunjchAyAl **","nOyum payalaimaiyum * mIdhUra emmE pOl *","nIyum thirumAlAl * nenjcham kOTpaTTAyE"],["** வாயும் திரை உகளும் * கானல் மட நாராய்! *","ஆயும் அமர் உலகும் * துஞ்சிலும் நீ துஞ்சாயால் **","நோயும் பயலைமையும் * மீதூர எம்மே போல் *","நீயும் திருமாலால் * நெஞ்சம் கோட்பட்டாயே"],0,"/media/recitation/TVM.2.1.1.mp3"],[2902,2902,["kOTpaTTa sindhaiyaiyAyk * kUr vAya anRilE! *","chETpaTTa yAmanggaL * sErAdhu iranggudhiyAl **","ATpaTTa emmE pOl * nIyum aravaNaiyAn *","thATpaTTa thaNthuzhAyth * thAmam kAmuRRAyE"],["கோட்பட்ட சிந்தையையாய்க் * கூர் வாய அன்றிலே! *","சேட்பட்ட யாமங்கள் * சேராது இரங்குதியால் **","ஆட்பட்ட எம்மே போல் * நீயும் அரவணையான் *","தாட்பட்ட தண்துழாய்த் * தாமம் காமுற்றாயே"],0,"/media/recitation/TVM.2.1.2.mp3"],[2903,2903,["kAmuRRa kai aRavODu * ellE! irAp pagal *","nI muRRak kaN thuyilAy * nenjchurugi EnggudhiyAl **","thI muRRath thennilanggai * UTTinAn thAL nayandha *","yAm uRRadhu uRRAyO? * vAzhi kanai kaDalE!"],["காமுற்ற கை அறவோடு * எல்லே! இராப் பகல் *","நீ முற்றக் கண் துயிலாய் * நெஞ்சுருகி ஏங்குதியால் **","தீ முற்றத் தென்னிலங்கை * ஊட்டினான் தாள் நயந்த *","யாம் உற்றது உற்றாயோ? * வாழி கனை கடலே!"],0,"/media/recitation/TVM.2.1.3.mp3"],[2904,2904,["kaDalum malaiyum * visumbum thuzhAy em pOl *","suDar koL irAp pagal * thunjchAyAl thaNvADAy! **","aDal koL paDaiyAzhi * ammAnaik kANbAn nI *","uDalam nOy uRRAyO? * Uzhi thORu UzhiyE"],["கடலும் மலையும் * விசும்பும் துழாய் எம் போல் *","சுடர் கொள் இராப் பகல் * துஞ்சாயால் தண்வாடாய்! **","அடல் கொள் படையாழி * அம்மானைக் காண்பான் நீ *","உடலம் நோய் உற்றாயோ? * ஊழி தோறு ஊழியே"],0,"/media/recitation/TVM.2.1.4.mp3"],[2905,2905,["Uzhi thORu Uzhi * ulagukku nIr koNDu *","thOzhiyarum yAmum pOl * nIrAy negizhkinRa **","vAzhiya vAnamE! * nIyum madhusUdhan *","pAzhimaiyil paTTu avan kaN * pAsaththAl naivAyE?"],["ஊழி தோறு ஊழி * உலகுக்கு நீர் கொண்டு *","தோழியரும் யாமும் போல் * நீராய் நெகிழ்கின்ற **","வாழிய வானமே! * நீயும் மதுசூதன் *","பாழிமையில் பட்டு அவன் கண் * பாசத்தால் நைவாயே?"],0,"/media/recitation/TVM.2.1.5.mp3"],[2906,2906,["naivAya emmE pOl * nAL madhiyE! nI innAL *","mai vAn iruL agaRRAy * mAzhAndhu thEmbudhiyAl *","aivAy aravaNai mEl * Azhip perumAnAr *","mey vAsagam kETTu * un meynnIrmai thORRAyE?"],["நைவாய எம்மே போல் * நாள் மதியே! நீ இந்நாள் *","மை வான் இருள் அகற்றாய் * மாழாந்து தேம்புதியால் *","ஐவாய் அரவணை மேல் * ஆழிப் பெருமானார் *","மெய் வாசகம் கேட்டு * உன் மெய்ந்நீர்மை தோற்றாயே?"],0,"/media/recitation/TVM.2.1.6.mp3"],[2907,2907,["thORROm maDa nenjcham * emperumAn nAraNaRku * em","ARRAmai solli * azhuvOmai nI naDuvE **","vERROr vagaiyil * koDidhAy enai Uzhi *","mARRANmai niRRiyO? * vAzhi kanai iruLE!"],["தோற்றோம் மட நெஞ்சம் * எம்பெருமான் நாரணற்கு * எம்","ஆற்றாமை சொல்லி * அழுவோமை நீ நடுவே **","வேற்றோர் வகையில் * கொடிதாய் எனை ஊழி *","மாற்றாண்மை நிற்றியோ? * வாழி கனை இருளே!"],0,"/media/recitation/TVM.2.1.7.mp3"],[2908,2908,["iruLin thiNi vaNNam * mA nIrk kazhiyE! pOy *","maruL uRRu irAp pagal * thunjchilum nI thunjchAyAl **","uruLum sagaDam * udhaiththa perumAnAr *","aruLin peru nasaiyAl * AzhAndhu nondhAyE?"],["இருளின் திணி வண்ணம் * மா நீர்க் கழியே! போய் *","மருள் உற்று இராப் பகல் * துஞ்சிலும் நீ துஞ்சாயால் **","உருளும் சகடம் * உதைத்த பெருமானார் *","அருளின் பெரு நசையால் * ஆழாந்து நொந்தாயே?"],0,"/media/recitation/TVM.2.1.8.mp3"],[2909,2909,["nondhArAk kAdhal nOy * mel Avi uL ularththa *","nandhA viLakkamE! * nIyum aLiyaththAy **","senthAmaraith thaDangkaN * sengkani vAy emperumAn *","anthAmath thaNthuzhAy * AsaiyAl vEvAyE?"],["நொந்தாராக் காதல் நோய் * மெல் ஆவி உள் உலர்த்த *","நந்தா விளக்கமே! * நீயும் அளியத்தாய் **","செந்தாமரைத் தடங்கண் * செங்கனி வாய் எம்பெருமான் *","அந்தாமத் தண்துழாய் * ஆசையால் வேவாயே?"],0,"/media/recitation/TVM.2.1.9.mp3"],[2910,2910,["vEvArA vETkai nOy * mel Avi uL ularththa *","OvAdhu irAp pagal * un pAlE vIzhththu ozhindhAy **","mA vAy piLandhu * marudhiDai pOy maNNaLandha *","mUvA mudhalvA! * ini emmaich sOrElE"],["வேவாரா வேட்கை நோய் * மெல் ஆவி உள் உலர்த்த *","ஓவாது இராப் பகல் * உன் பாலே வீழ்த்து ஒழிந்தாய் **","மா வாய் பிளந்து * மருதிடை போய் மண்ணளந்த *","மூவா முதல்வா! * இனி எம்மைச் சோரேலே"],0,"/media/recitation/TVM.2.1.10.mp3"],[2911,2911,["** sOrAdha epporuTkum * AdhiyAm sOdhikkE *","ArAdha kAdhal * kurugUrch saDakOpan **","Or Ayiram sonna * avaRRuL ivai paththum *","sOrAr viDAr kaNDIr * vaikundham thiNNenavE"],["** சோராத எப்பொருட்கும் * ஆதியாம் சோதிக்கே *","ஆராத காதல் * குருகூர்ச் சடகோபன் **","ஓர் ஆயிரம் சொன்ன * அவற்றுள் இவை பத்தும் *","சோரார் விடார் கண்டீர் * வைகுந்தம் திண்ணெனவே"],0,"/media/recitation/TVM.2.1.11.mp3"]],[[2912,2912,["** thiNNan vIDu * mudhal muzhudhumAy *","eNNin mIdhiyan * emperumAn **","maNNum viNNum ellAm * uDan uNDa * nam","kaNNan kaN alladhu * illai Or kaNNE"],["** திண்ணன் வீடு * முதல் முழுதுமாய் *","எண்ணின் மீதியன் * எம்பெருமான் **","மண்ணும் விண்ணும் எல்லாம் * உடன் உண்ட * நம்","கண்ணன் கண் அல்லது * இல்லை ஓர் கண்ணே"],0,"/media/recitation/TVM.2.2.1.mp3"],[2913,2913,["E pAvam! paramE! * Ezh ulagum *","I pAvam seydhu * aruLAl aLippAr Ar? **","mA pAvam viDa * araRkup pichchai pey *","gOpAla kOL ari * ERu anRiyE"],["ஏ பாவம்! பரமே! * ஏழ் உலகும் *","ஈ பாவம் செய்து * அருளால் அளிப்பார் ஆர்? **","மா பாவம் விட * அரற்குப் பிச்சை பெய் *","கோபால கோள் அரி * ஏறு அன்றியே"],0,"/media/recitation/TVM.2.2.2.mp3"],[2914,2914,["ERanaip pUvanaip * pUmagaL thannai *","vERinRi viN thozhath * thannuL vaiththu **","mEl thannai mIdhiDa * nimirndhu maN koNDa *","mAl thanil mikkum Or * thEvum uLadhE?"],["ஏறனைப் பூவனைப் * பூமகள் தன்னை *","வேறின்றி விண் தொழத் * தன்னுள் வைத்து **","மேல் தன்னை மீதிட * நிமிர்ந்து மண் கொண்ட *","மால் தனில் மிக்கும் ஓர் * தேவும் உளதே?"],0,"/media/recitation/TVM.2.2.3.mp3"],[2915,2915,["thEvum epporuLum paDaikka *","pUvil nAnmuganaip paDaiththa **","thEvan emperumAnukku allAl *","pUvum pUsanaiyum thagumE?"],["தேவும் எப்பொருளும் படைக்க *","பூவில் நான்முகனைப் படைத்த **","தேவன் எம்பெருமானுக்கு அல்லால் *","பூவும் பூசனையும் தகுமே?"],0,"/media/recitation/TVM.2.2.4.mp3"],[2916,2916,["thagum sIrth * than thani mudhalinuLLE *","migum thEvum * epporuLum paDaikka **","thagum kOlath * thAmaraik kaNNan emmAn *","migum sOdhi * mEl aRivAr yavarE?"],["தகும் சீர்த் * தன் தனி முதலினுள்ளே *","மிகும் தேவும் * எப்பொருளும் படைக்க **","தகும் கோலத் * தாமரைக் கண்ணன் எம்மான் *","மிகும் சோதி * மேல் அறிவார் யவரே?"],0,"/media/recitation/TVM.2.2.5.mp3"],[2917,2917,["yavarum yAvaiyum * ellAp poruLum *","kavarvu inRith * thannuL oDungga ninRa **","pavar koL njAna * veLLach suDar mUrththi *","avar em Azhi * ampaLLiyArE"],["யவரும் யாவையும் * எல்லாப் பொருளும் *","கவர்வு இன்றித் * தன்னுள் ஒடுங்க நின்ற **","பவர் கொள் ஞான * வெள்ளச் சுடர் மூர்த்தி *","அவர் எம் ஆழி * அம்பள்ளியாரே"],0,"/media/recitation/TVM.2.2.6.mp3"],[2918,2918,["paLLi Alilai * Ezhulagum koLLum *","vaLLal * val vayiRRup perumAn **","uLLuL Ar aRivAr? * avan than *","kaLLa mAya * manak karuththE"],["பள்ளி ஆலிலை * ஏழுலகும் கொள்ளும் *","வள்ளல் * வல் வயிற்றுப் பெருமான் **","உள்ளுள் ஆர் அறிவார்? * அவன் தன் *","கள்ள மாய * மனக் கருத்தே"],0,"/media/recitation/TVM.2.2.7.mp3"],[2919,2919,["karuththil thEvum * ellAp poruLum *","varuththiththa * mAyap pirAnai anRi ** ArE","thiruththith * thiN nilai mUvulagum * thammuL","iruththik kAkkum * iyalvinarE"],["கருத்தில் தேவும் * எல்லாப் பொருளும் *","வருத்தித்த * மாயப் பிரானை அன்றி ** ஆரே","திருத்தித் * திண் நிலை மூவுலகும் * தம்முள்","இருத்திக் * காக்கும் இயல்வினரே"],0,"/media/recitation/TVM.2.2.8.mp3"],[2920,2920,["kAkkum iyalvinan * kaNNa perumAn *","sErkkai seydhu * than undhi uLLE **","vAyththa thisaimugan * indhiran vAnavar *","AkkinAn * theyva ulagugaLE"],["காக்கும் இயல்வினன் * கண்ண பெருமான் *","சேர்க்கை செய்து * தன் உந்தி உள்ளே **","வாய்த்த திசைமுகன் * இந்திரன் வானவர் *","ஆக்கினான் * தெய்வ உலகுகளே"],0,"/media/recitation/TVM.2.2.9.mp3"],[2921,2921,["kaLvA! emmaiyum * Ezhulagum * nin","uLLE thORRiya * iRaiva! enRu **","veLLERan nAnmugan * indhiran vAnavar *","puL Urdhi * kazhal paNindhu EththuvarE"],["கள்வா! எம்மையும் * ஏழுலகும் * நின்","உள்ளே தோற்றிய * இறைவ! என்று **","வெள்ளேறன் நான்முகன் * இந்திரன் வானவர் *","புள் ஊர்தி * கழல் பணிந்து ஏத்துவரே"],0,"/media/recitation/TVM.2.2.10.mp3"],[2922,2922,["** Eththa Ezhulagum koNDa * kOlak","kUththanai * kurugUrch saDakOpan sol **","vAyththa AyiraththuL * ivai paththuDan *","Eththa vallavarkku * illai Or UnamE"],["** ஏத்த ஏழுலகும் கொண்ட * கோலக்","கூத்தனை * குருகூர்ச் சடகோபன் சொல் **","வாய்த்த ஆயிரத்துள் * இவை பத்துடன் *","ஏத்த வல்லவர்க்கு * இல்லை ஓர் ஊனமே"],0,"/media/recitation/TVM.2.2.11.mp3"]],[[2923,2923,["** Unil vAzh uyirE! * nallai pO unnaip peRRu *","vAnuLAr perumAn * madhusUdhan en ammAn **","thAnum yAnum ellAm * thannuLLE kalandhu ozhindhOm *","thEnum pAlum neyyum * kannalum amudhum oththE"],["** ஊனில் வாழ் உயிரே! * நல்லை போ உன்னைப் பெற்று *","வானுளார் பெருமான் * மதுசூதன் என் அம்மான் **","தானும் யானும் எல்லாம் * தன்னுள்ளே கலந்து ஒழிந்தோம் *","தேனும் பாலும் நெய்யும் * கன்னலும் அமுதும் ஒத்தே"],0,"/media/recitation/TVM.2.3.1.mp3"],[2924,2924,["oththAr mikkArai * ilai Aya mA mAyA! *","oththAy epporuTkum uyirAy ** ennaip peRRa","aththAyAyth thandhaiyAy * aRiyAdhana aRiviththa *","aththA! nI seydhana * aDiyEn aRiyEnE"],["ஒத்தார் மிக்காரை * இலை ஆய மா மாயா! *","ஒத்தாய் எப்பொருட்கும் உயிராய் ** என்னைப் பெற்ற","அத்தாயாய்த் தந்தையாய் * அறியாதன அறிவித்த *","அத்தா! நீ செய்தன * அடியேன் அறியேனே"],0,"/media/recitation/TVM.2.3.2.mp3"],[2925,2925,["aRiyAk kAlaththuLLE * aDimaik kaN anbu seyviththu *","aRiyA mA mAyaththu * aDiyEnai vaiththAyAl **","aRiyAmaik kuRaLAy * nilam mAvali! mUvaDi enRu *","aRiyAmai vanjchiththAy * enadhAvi uL kalandhE"],["அறியாக் காலத்துள்ளே * அடிமைக் கண் அன்பு செய்வித்து *","அறியா மா மாயத்து * அடியேனை வைத்தாயால் **","அறியாமைக் குறளாய் * நிலம் மாவலி! மூவடி என்று *","அறியாமை வஞ்சித்தாய் * எனதாவி உள் கலந்தே"],0,"/media/recitation/TVM.2.3.3.mp3"],[2926,2926,["enadhAvi uL kalandha * peru nal udhavik kaimmARu *","enadhAvi thandhu ozhindhEn * ini mILvadhu enbadhu uNDE? **","enadhAvi Aviyum nI * pozhil Ezhum uNDa endhAy! *","enadhAvi yAr? yAn Ar? * thandha nI koNDu AkkinaiyE"],["எனதாவி உள் கலந்த * பெரு நல் உதவிக் கைம்மாறு *","எனதாவி தந்து ஒழிந்தேன் * இனி மீள்வது என்பது உண்டே? **","எனதாவி ஆவியும் நீ * பொழில் ஏழும் உண்ட எந்தாய்! *","எனதாவி யார்? யான் ஆர்? * தந்த நீ கொண்டு ஆக்கினையே"],0,"/media/recitation/TVM.2.3.4.mp3"],[2927,2927,["ini yAr njAnanggaLAl * eDukkal ezhAdha endhAy *","kanivAr vITTu inbamE! * en kaDal paDA amudhE! **","thaniyEn vAzh mudhalE! * pozhil Ezhum Enam onRAy *","nuniyAr kOTTil vaiththAy * una pAdham sErndhEnE"],["இனி யார் ஞானங்களால் * எடுக்கல் எழாத எந்தாய் *","கனிவார் வீட்டு இன்பமே! * என் கடல் படா அமுதே! **","தனியேன் வாழ் முதலே! * பொழில் ஏழும் ஏனம் ஒன்றாய் *","நுனியார் கோட்டில் வைத்தாய் * உன பாதம் சேர்ந்தேனே"],0,"/media/recitation/TVM.2.3.5.mp3"],[2928,2928,["sErndhAr thI vinaigaTku * aru nanjchaith thiN madhiyai *","thIrndhAr tham manaththup * piriyAdhu avar uyirai **","sOrndhE pOgal koDAch suDarai * arakkiyai mUkku","IrndhAyai * aDiyEn aDaindhEn * mudhal munnamE"],["சேர்ந்தார் தீ வினைகட்கு * அரு நஞ்சைத் திண் மதியை *","தீர்ந்தார் தம் மனத்துப் * பிரியாது அவர் உயிரை **","சோர்ந்தே போகல் கொடாச் சுடரை * அரக்கியை மூக்கு","ஈர்ந்தாயை * அடியேன் அடைந்தேன் * முதல் முன்னமே"],0,"/media/recitation/TVM.2.3.6.mp3"],[2929,2929,["mun nal yAzh payil nUl * narambin mudhir suvaiyE! *","pannalAr payilum * paranE! paviththiranE! **","kannalE! amudhE! * kAr mugilE! en kaNNA! *","nin alAl ilEn kAN * ennai nI kuRikkoLLE"],["முன் நல் யாழ் பயில் நூல் * நரம்பின் முதிர் சுவையே! *","பன்னலார் பயிலும் * பரனே! பவித்திரனே! **","கன்னலே! அமுதே! * கார் முகிலே! என் கண்ணா! *","நின் அலால் இலேன் காண் * என்னை நீ குறிக்கொள்ளே"],0,"/media/recitation/TVM.2.3.7.mp3"],[2930,2930,["kuRikkoL njAnanggaLAl * enai Uzhi sey thavamum *","kiRik koNDu ippiRappE * sila nALil eydhinan yAn **","uRik koNDa veNNey pAl * oLiththu uNNum ammAn pin *","neRik koNDa nenjchanAyp * piRavith thuyar kaDindhE"],["குறிக்கொள் ஞானங்களால் * எனை ஊழி செய் தவமும் *","கிறிக் கொண்டு இப்பிறப்பே * சில நாளில் எய்தினன் யான் **","உறிக் கொண்ட வெண்ணெய் பால் * ஒளித்து உண்ணும் அம்மான் பின் *","நெறிக் கொண்ட நெஞ்சனாய்ப் * பிறவித் துயர் கடிந்தே"],0,"/media/recitation/TVM.2.3.8.mp3"],[2931,2931,["kaDi vAr thaNNanthuzhAyk * kaNNan viNNavar perumAn *","paDi vAnam iRandha * paraman paviththiran sIr **","seDiyAr nOygaL keDap * paDindhu kuDaindhu ADi *","aDiyEn vAy maDuththup * parugik kaLiththEnE"],["கடி வார் தண்ணந்துழாய்க் * கண்ணன் விண்ணவர் பெருமான் *","படி வானம் இறந்த * பரமன் பவித்திரன் சீர் **","செடியார் நோய்கள் கெடப் * படிந்து குடைந்து ஆடி *","அடியேன் வாய் மடுத்துப் * பருகிக் களித்தேனே"],0,"/media/recitation/TVM.2.3.9.mp3"],[2932,2932,["kaLippum kavarvum aRRup * piRappup piNi mUppu iRappu aRRu *","oLik koNDa sOdhiyamAy * uDan kUDuvadhu enRu kolO? **","thuLikkinRa vAn innilam * suDar Azhi sanggu Endhi *","aLikkinRa mAyap pirAn * aDiyArgaL kuzhAnggaLaiyE"],["களிப்பும் கவர்வும் அற்றுப் * பிறப்புப் பிணி மூப்பு இறப்பு அற்று *","ஒளிக் கொண்ட சோதியமாய் * உடன் கூடுவது என்று கொலோ? **","துளிக்கின்ற வான் இந்நிலம் * சுடர் ஆழி சங்கு ஏந்தி *","அளிக்கின்ற மாயப் பிரான் * அடியார்கள் குழாங்களையே"],0,"/media/recitation/TVM.2.3.10.mp3"],[2933,2933,["** kuzhAngkoL pEr arakkan * kulam vIya munindhavanai *","kuzhAngkoL thenkurugUrch * saDakOpan therindhu uraiththa **","kuzhAngkoL AyiraththuL * ivai paththum uDan pADi *","kuzhAnggaLAy aDiyIruDan * kUDi ninRu ADuminE"],["** குழாங்கொள் பேர் அரக்கன் * குலம் வீய முனிந்தவனை *","குழாங்கொள் தென்குருகூர்ச் * சடகோபன் தெரிந்து உரைத்த **","குழாங்கொள் ஆயிரத்துள் * இவை பத்தும் உடன் பாடி *","குழாங்களாய் அடியீருடன் * கூடி நின்று ஆடுமினே"],0,"/media/recitation/TVM.2.3.11.mp3"]],[[2934,2934,["** ADi ADi agam karaindhu * isai","pADip pADik * kaNNIr malgi ** enggum","nADi nADi * narasinggA! enRu *","vADi vADum * ivvANudhalE"],["** ஆடி ஆடி அகம் கரைந்து * இசை","பாடிப் பாடிக் * கண்ணீர் மல்கி ** எங்கும்","நாடி நாடி * நரசிங்கா! என்று *","வாடி வாடும் * இவ்வாணுதலே"],0,"/media/recitation/TVM.2.4.1.mp3"],[2935,2935,["vANudhal immaDavaral * ummaik","kANum * AsaiyuL naiginRAL ** viRal","vANan * Ayiram thOL thuNiththIr! * ummaik","kANa * nIr irakkam ilIrE"],["வாணுதல் இம்மடவரல் * உம்மைக்","காணும் * ஆசையுள் நைகின்றாள் ** விறல்","வாணன் * ஆயிரம் தோள் துணித்தீர்! * உம்மைக்","காண * நீர் இரக்கம் இலீரே"],0,"/media/recitation/TVM.2.4.2.mp3"],[2936,2936,["irakka manaththODu eri aNai *","arakku mezhugum * okkum ivaL **","irakkam ezhIr * idhaRku en seygEn? *","arakkan ilanggai * seRRIrukkE"],["இரக்க மனத்தோடு எரி அணை *","அரக்கு மெழுகும் * ஒக்கும் இவள் **","இரக்கம் எழீர் * இதற்கு என் செய்கேன்? *","அரக்கன் இலங்கை * செற்றீருக்கே"],0,"/media/recitation/TVM.2.4.3.mp3"],[2937,2937,["ilanggai seRRavanE! ennum * pinnum","valangkoL * puL uyarththAy! ennum ** uLLam","malangga * vevvuyirkkum * kaNNIr migak","kalanggik * kai thozhum ninRu ivaLE"],["இலங்கை செற்றவனே! என்னும் * பின்னும்","வலங்கொள் * புள் உயர்த்தாய்! என்னும் ** உள்ளம்","மலங்க * வெவ்வுயிர்க்கும் * கண்ணீர் மிகக்","கலங்கிக் * கை தொழும் நின்று இவளே"],0,"/media/recitation/TVM.2.4.4.mp3"],[2938,2938,["ivaL irAp pagal * vAy verIi * thana","kuvaLai * oN kaNNa nIr koNDAL ** vaNDu","thivaLum * thaNNanthuzhAy koDIr * ena","thavaLa vaNNar thagavugaLE"],["இவள் இராப் பகல் * வாய் வெரீஇ * தன","குவளை * ஒண் கண்ண நீர் கொண்டாள் ** வண்டு","திவளும் * தண்ணந்துழாய் கொடீர் * என","தவள வண்ணர் தகவுகளே"],0,"/media/recitation/TVM.2.4.5.mp3"],[2939,2939,["thagavu uDaiyavanE! ennum * pinnum","miga virumbum * pirAn ennum ** enadhu","aga uyirkku * amudhE! ennum * uLLam","uga urugi * ninRu uLLuLE"],["தகவு உடையவனே! என்னும் * பின்னும்","மிக விரும்பும் * பிரான் என்னும் ** எனது","அக உயிர்க்கு * அமுதே! என்னும் * உள்ளம்","உக உருகி * நின்று உள்ளுளே"],0,"/media/recitation/TVM.2.4.6.mp3"],[2940,2940,["uLLuL Avi * ularndhu ularndhu * ena","vaLLalE! * kaNNanE! ennum ** pinnum","veLLa nIrk * kiDandhAy ennum * ena","kaLvi thAn * paTTa vanjchanaiyE"],["உள்ளுள் ஆவி * உலர்ந்து உலர்ந்து * என","வள்ளலே! * கண்ணனே! என்னும் ** பின்னும்","வெள்ள நீர்க் * கிடந்தாய் என்னும் * என","கள்வி தான் * பட்ட வஞ்சனையே"],0,"/media/recitation/TVM.2.4.7.mp3"],[2941,2941,["vanjchanE! ennum * kai thozhum * thana","nenjcham vEva * neDidhu uyirkkum ** viRal","kanjchanai * vanjchanai seydhIr! * ummaith","thanjcham enRu * ivaL paTTanavE!"],["வஞ்சனே! என்னும் * கை தொழும் * தன","நெஞ்சம் வேவ * நெடிது உயிர்க்கும் ** விறல்","கஞ்சனை * வஞ்சனை செய்தீர்! * உம்மைத்","தஞ்சம் என்று * இவள் பட்டனவே!"],0,"/media/recitation/TVM.2.4.8.mp3"],[2942,2942,["paTTa pOdhu * ezhu pOdhu aRiyAL * virai","maTTalar * thaNthuzhAy ennum ** suDar","vaTTa vAy * nudhi nEmiyIr! * numadhu","iTTam enkol * ivvEzhaikkE?"],["பட்ட போது * எழு போது அறியாள் * விரை","மட்டலர் * தண்துழாய் என்னும் ** சுடர்","வட்ட வாய் * நுதி நேமியீர்! * நுமது","இட்டம் என்கொல் * இவ்வேழைக்கே?"],0,"/media/recitation/TVM.2.4.9.mp3"],[2943,2943,["Ezhai pEdhai * irAp pagal * thana","kEzh il * oN kaNNa nIr koNDAL ** kiLar","vAzhvai vEva * ilanggai seRRIr! * ivaL","mAzhai nOkku onRum * vATTEnminE"],["ஏழை பேதை * இராப் பகல் * தன","கேழ் இல் * ஒண் கண்ண நீர் கொண்டாள் ** கிளர்","வாழ்வை வேவ * இலங்கை செற்றீர்! * இவள்","மாழை நோக்கு ஒன்றும் * வாட்டேன்மினே"],0,"/media/recitation/TVM.2.4.10.mp3"],[2944,2944,["** vATTam il pugazh * vAmananai * isai","kUTTi * vaN saDakOpan sol ** amai","pATTu Or * Ayiraththu ippaththAl * aDi","sUTTal Agum * anthAmamE"],["** வாட்டம் இல் புகழ் * வாமனனை * இசை","கூட்டி * வண் சடகோபன் சொல் ** அமை","பாட்டு * ஓர் ஆயிரத்து இப்பத்தால் * அடி","சூட்டல் ஆகும் * அந்தாமமே"],0,"/media/recitation/TVM.2.4.11.mp3"]],[[2945,2945,["** anthAmaththu anbu seydhu * en Avi sEr ammAnukku *","anthAma vANmuDi sanggu * Azhi nUl Aram uLa **","senthAmaraith thaDangkaN * sengkani vAy sengkamalam *","senthAmarai aDigaL * sempon thiru uDambE"],["** அந்தாமத்து அன்பு செய்து * என் ஆவி சேர் அம்மானுக்கு *","அந்தாம வாண்முடி சங்கு * ஆழி நூல் ஆரம் உள **","செந்தாமரைத் தடங்கண் * செங்கனி வாய் செங்கமலம் *","செந்தாமரை அடிகள் * செம்பொன் திரு உடம்பே"],0,"/media/recitation/TVM.2.5.1.mp3"],[2946,2946,["thiru uDambu vAn suDar * senthAmaraik kaN kai kamalam *","thiruviDamE mArbam * ayan iDamE koppUzh **","oruviDamum * endhai perumARku aranEyO! *","oruviDam onRu inRi * ennuL kalandhAnukkE"],["திரு உடம்பு வான் சுடர் * செந்தாமரைக் கண் கை கமலம் *","திருவிடமே மார்பம் * அயன் இடமே கொப்பூழ் **","ஒருவிடமும் * எந்தை பெருமாற்கு அரனேயோ! *","ஒருவிடம் ஒன்று இன்றி * என்னுள் கலந்தானுக்கே"],0,"/media/recitation/TVM.2.5.2.mp3"],[2947,2947,["ennuL kalandhavan * sengkani vAy sengkamalam *","minnum suDar malaikkuk * kaN pAdham kai kamalam **","mannu muzhu Ezh ulagum * vayiRRin uLa *","thannuL kalavAdhadhu * epporuLum thAn ilaiyE"],["என்னுள் கலந்தவன் * செங்கனி வாய் செங்கமலம் *","மின்னும் சுடர் மலைக்குக் * கண் பாதம் கை கமலம் **","மன்னு முழு ஏழ் உலகும் * வயிற்றின் உள *","தன்னுள் கலவாதது * எப்பொருளும் தான் இலையே"],0,"/media/recitation/TVM.2.5.3.mp3"],[2948,2948,["epporuLum thAnAy * maradhagak kunRam okkum *","appozhudhaith thAmaraip pUk * kaN pAdham kai kamalam **","eppozhudhum nAL thinggaL * ANDu Uzhi Uzhi thoRum *","appozhudhaikku appozhudhu * en ArA amudhamE"],["எப்பொருளும் தானாய் * மரதகக் குன்றம் ஒக்கும் *","அப்பொழுதைத் தாமரைப் பூக் * கண் பாதம் கை கமலம் **","எப்பொழுதும் நாள் திங்கள் * ஆண்டு ஊழி ஊழி தொறும் *","அப்பொழுதைக்கு அப்பொழுது * என் ஆரா அமுதமே"],0,"/media/recitation/TVM.2.5.4.mp3"],[2949,2949,["ArA amudhamAy * allAvi uLkalandha *","kArAr karumugil pOl * en ammAn kaNNanukku **","nErA vAy sempavaLam * kaN pAdham kai kamalam *","pEr Ara nIL muDi nAN * pinnum izhai palavE"],["ஆரா அமுதமாய் * அல்லாவி உள்கலந்த *","காரார் கருமுகில் போல் * என் அம்மான் கண்ணனுக்கு **","நேரா வாய் செம்பவளம் * கண் பாதம் கை கமலம் *","பேர் ஆர நீள் முடி நாண் * பின்னும் இழை பலவே"],0,"/media/recitation/TVM.2.5.5.mp3"],[2950,2950,["pala palavE AbaraNam * pErum pala palavE *","pala palavE sOdhi * vaDivu paNbu eNNil **","pala pala kaNDuNDu * kETTuRRu mOndhu inbam *","pala palavE njAnamum * pAmbaNai mElARkEyO!"],["பல பலவே ஆபரணம் * பேரும் பல பலவே *","பல பலவே சோதி * வடிவு பண்பு எண்ணில் **","பல பல கண்டுண்டு * கேட்டுற்று மோந்து இன்பம் *","பல பலவே ஞானமும் * பாம்பணை மேலாற்கேயோ!"],0,"/media/recitation/TVM.2.5.6.mp3"],[2951,2951,["pAmbaNai mEl pARkaDaluL * paLLi amarndhadhuvum *","kAmbaNai thOL pinnaikkA * ERu uDan Ezh seRRadhuvum **","thEmbaNaiya sOlai * marAmaram Ezh eydhadhuvum *","pUm piNaiya thaNthuzhAyp * pon muDi ampOr ERE"],["பாம்பணை மேல் பாற்கடலுள் * பள்ளி அமர்ந்ததுவும் *","காம்பணை தோள் பின்னைக்கா * ஏறு உடன் ஏழ் செற்றதுவும் **","தேம்பணைய சோலை * மராமரம் ஏழ் எய்ததுவும் *","பூம் பிணைய தண்துழாய்ப் * பொன் முடி அம்போர் ஏறே"],0,"/media/recitation/TVM.2.5.7.mp3"],[2952,2952,["pon muDi ampOr ERRai * emmAnai nAl thaDanthOL *","than muDivu onRu illAdha * thaNthuzhAy mAlaiyanai **","en muDivu kANAdhE * ennuL kalandhAnai *","sol muDivu kANEn nAn * solluvadhu en? sollIrE"],["பொன் முடி அம்போர் ஏற்றை * எம்மானை நால் தடந்தோள் *","தன் முடிவு ஒன்று இல்லாத * தண்துழாய் மாலையனை **","என் முடிவு காணாதே * என்னுள் கலந்தானை *","சொல் முடிவு காணேன் நான் * சொல்லுவது என்? சொல்லீரே"],0,"/media/recitation/TVM.2.5.8.mp3"],[2953,2953,["sollIr en ammAnai * ennAvi Avi thanai *","ellai il sIr * en karu mANikkach chuDarai **","nalla amudham * peRaRku ariya vIDumAy *","alli malar virai oththu * AN allan peN allanE"],["சொல்லீர் என் அம்மானை * என்னாவி ஆவி தனை *","எல்லை இல் சீர் * என் கரு மாணிக்கச் சுடரை **","நல்ல அமுதம் * பெறற்கு அரிய வீடுமாய் *","அல்லி மலர் விரை ஒத்து * ஆண் அல்லன் பெண் அல்லனே"],0,"/media/recitation/TVM.2.5.9.mp3"],[2954,2954,["AN allan peN allan * allA aliyum allan *","kANalum AgAn * uLan allan illai allan **","pENungkAl pENum * uru Agum allanum Am *","kONai peridhu uDaiththu * em pemmAnaik kURudhalE"],["ஆண் அல்லன் பெண் அல்லன் * அல்லா அலியும் அல்லன் *","காணலும் ஆகான் * உளன் அல்லன் இல்லை அல்லன் **","பேணுங்கால் பேணும் * உரு ஆகும் அல்லனும் ஆம் *","கோணை பெரிது உடைத்து * எம் பெம்மானைக் கூறுதலே"],0,"/media/recitation/TVM.2.5.10.mp3"],[2955,2955,["** kURudhal onRu ArAk * kuDak kUththa ammAnai *","kURudhalE mEvik * kurugUrch saDakOpan **","kURina andhAdhi * Or AyiraththuL ippaththum *","kURudhal vallAr uLarEl * kUDuvar vaikundhamE"],["** கூறுதல் ஒன்று ஆராக் * குடக் கூத்த அம்மானை *","கூறுதலே மேவிக் * குருகூர்ச் சடகோபன் **","கூறின அந்தாதி * ஓர் ஆயிரத்துள் இப்பத்தும் *","கூறுதல் வல்லார் உளரேல் * கூடுவர் வைகுந்தமே"],0,"/media/recitation/TVM.2.5.11.mp3"]],[[2956,2956,["** vaikunthA! maNivaNNanE! * en pollAth thirukkuRaLA! ennuL manni *","vaigum vaigal thORum * amudhAya vAn ERE! **","sey kundhA arunthImai un aDiyArkkuth thIrththu * asurarkkuth thImaigaL","sey kundhA! * unnai nAn piDiththEn koL * sikkenavE"],["** வைகுந்தா! மணிவண்ணனே! * என் பொல்லாத் திருக்குறளா! என்னுள் மன்னி *","வைகும் வைகல் தோறும் * அமுதாய வான் ஏறே! **","செய் குந்தா அருந்தீமை உன் அடியார்க்குத் தீர்த்து * அசுரர்க்குத் தீமைகள்","செய் குந்தா! * உன்னை நான் பிடித்தேன் கொள் * சிக்கெனவே"],0,"/media/recitation/TVM.2.6.1.mp3"],[2957,2957,["sikkenach siRidhOr iDamum * puRappaDAth than uLLE * ulagugaL","okkavE vizhunggip * pugundhAn pugundhathaRpin **","mikka njAna veLLach suDar viLakkAyth * thuLakkaRRu amudhamAy * enggum","pakkam nOkkaRiyAn * en painthAmaraik kaNNanE"],["சிக்கெனச் சிறிதோர் இடமும் * புறப்படாத் தன் உள்ளே * உலகுகள்","ஒக்கவே விழுங்கிப் * புகுந்தான் புகுந்ததற்பின் **","மிக்க ஞான வெள்ளச் சுடர் விளக்காய்த் * துளக்கற்று அமுதமாய் * எங்கும்","பக்கம் நோக்கறியான் * என் பைந்தாமரைக் கண்ணனே"],0,"/media/recitation/TVM.2.6.2.mp3"],[2958,2958,["thAmaraik kaNNanai * viNNOr paravum thalaimaganai * thuzhAy viraip","pU maruvu kaNNi * empirAnaip pon malaiyai **","nAm maruvi nankEththi uLLi vaNanggi * nAm magizhndhu ADa * nAvalar","pA maruvi niRkath thandha * pAnmaiyE vaLLalE!"],["தாமரைக் கண்ணனை * விண்ணோர் பரவும் தலைமகனை * துழாய் விரைப்","பூ மருவு கண்ணி * எம்பிரானைப் பொன் மலையை **","நாம் மருவி நன்கேத்தி உள்ளி வணங்கி * நாம் மகிழ்ந்து ஆட * நாவலர்","பா மருவி நிற்கத் தந்த * பான்மையே வள்ளலே!"],0,"/media/recitation/TVM.2.6.3.mp3"],[2959,2959,["vaLLalE! madhusUdhanA! * en maradhaga malaiyE! * unai ninaindhu","eLgal thandha endhAy! * unnai engnganam viDugEn? **","veLLamE purai nin pugazh kuDaindhADip pADik * kaLiththu ugandhu ugandhu *","uLLa nOygaL ellAm thurandhu * uyndhu pOndhu irundhE"],["வள்ளலே! மதுசூதனா! * என் மரதக மலையே! * உனை நினைந்து","எள்கல் தந்த எந்தாய்! * உன்னை எங்ஙனம் விடுகேன்? **","வெள்ளமே புரை நின் புகழ் குடைந்தாடிப் பாடிக் * களித்து உகந்து உகந்து *","உள்ள நோய்கள் எல்லாம் துரந்து * உய்ந்து போந்து இருந்தே"],0,"/media/recitation/TVM.2.6.4.mp3"],[2960,2960,["uyndhu pOndhu en ulappilAdha * venthI vinaigaLai nAsam seydhu * unadhu","andhamil aDimai aDaindhEn * viDuvEnO? **","aindhu painthalai ADaravaNai mEvip * pARkaDal yOga niththirai *","sindhai seydha endhAy! * unnaich sindhai seydhu seydhE"],["உய்ந்து போந்து என் உலப்பிலாத * வெந்தீ வினைகளை நாசம் செய்து * உனது","அந்தமில் அடிமை அடைந்தேன் * விடுவேனோ? **","ஐந்து பைந்தலை ஆடரவணை மேவிப் * பாற்கடல் யோக நித்திரை *","சிந்தை செய்த எந்தாய்! * உன்னைச் சிந்தை செய்து செய்தே"],0,"/media/recitation/TVM.2.6.5.mp3"],[2961,2961,["unnaich sindhai seydhu seydhu * un neDu mA mozhi isai pADi ADi * en","munnaith thIvinaigaL * muzhu vEr arindhanan yAn **","unnaich sindhaiyinAl igazhndha * iraNiyan agal mArvam kINDa * en","munnaik kOL ariyE! * muDiyAdhadhu en enakkE?"],["உன்னைச் சிந்தை செய்து செய்து * உன் நெடு மா மொழி இசை பாடி ஆடி * என்","முன்னைத் தீவினைகள் * முழு வேர் அரிந்தனன் யான் **","உன்னைச் சிந்தையினால் இகழ்ந்த * இரணியன் அகல் மார்வம் கீண்ட * என்","முன்னைக் கோள் அரியே! * முடியாதது என் எனக்கே?"],0,"/media/recitation/TVM.2.6.6.mp3"],[2962,2962,["muDiyAdhadhu en enakkEl ini? * muzhu Ezh ulagum uNDAn * ugandhu vandhu","aDiyEn uL pugundhAn * agalvAnum allan ini **","seDiyAr nOygaL ellAm thurandhu * emar kIzh mEl ezhu piRappum *","viDiyA vennaragaththu * enRum sErdhal mARinarE"],["முடியாதது என் எனக்கேல் இனி? * முழு ஏழ் உலகும் உண்டான் * உகந்து வந்து","அடியேன் உள் புகுந்தான் * அகல்வானும் அல்லன் இனி **","செடியார் நோய்கள் எல்லாம் துரந்து * எமர் கீழ் மேல் எழு பிறப்பும் *","விடியா வெந்நரகத்து * என்றும் சேர்தல் மாறினரே"],0,"/media/recitation/TVM.2.6.7.mp3"],[2963,2963,["mARi mARip pala piRappum piRandhu * aDiyai aDaindhu uLLam thERi *","IRil inbaththu iruveLLam * yAn mUzhginan **","pARip pARi asurar tham * pal kuzhAnggaL nIRezha * pAy paRavai onRu","ERi vIRRirundhAy! * unnai ennuL nIkkEl endhAy!"],["மாறி மாறிப் பல பிறப்பும் பிறந்து * அடியை அடைந்து உள்ளம் தேறி *","ஈறில் இன்பத்து இருவெள்ளம் * யான் மூழ்கினன் **","பாறிப் பாறி அசுரர் தம் * பல் குழாங்கள் நீறெழ * பாய் பறவை ஒன்று","ஏறி வீற்றிருந்தாய்! * உன்னை என்னுள் நீக்கேல் எந்தாய்!"],0,"/media/recitation/TVM.2.6.8.mp3"],[2964,2964,["endhAy! thaN thiruvEngkaDaththuL ninRAy! * ilanggai seRRAy! * marAmaram","painthAL Ezh uruva * oru vALi kOththa villA! **","kondhAr thaNNanthuzhAyinAy! amudhE! * unnai ennuLLE kuzhaiththa em","maindhA! * vAn ERE! * ini enggup pOginRadhE?"],["எந்தாய்! தண் திருவேங்கடத்துள் நின்றாய்! * இலங்கை செற்றாய்! * மராமரம்","பைந்தாள் ஏழ் உருவ * ஒரு வாளி கோத்த வில்லா! **","கொந்தார் தண்ணந்துழாயினாய்! அமுதே! * உன்னை என்னுள்ளே குழைத்த எம்","மைந்தா! * வான் ஏறே! * இனி எங்குப் போகின்றதே?"],0,"/media/recitation/TVM.2.6.9.mp3"],[2965,2965,["pOginRa kAlanggaL pOya kAlanggaL * pOgu kAlanggaL * thAy thandhai uyir","AginRAy! * unnai nAn aDaindhEn viDuvEnO? **","pAginRa thol pugazh mUvulagukkum * nAdhanE! paramA! * thaNvEngkaDam","mEginRAy! * thaN thuzhAy virai nARu kaNNiyanE!"],["போகின்ற காலங்கள் போய காலங்கள் * போகு காலங்கள் * தாய் தந்தை உயிர்","ஆகின்றாய்! * உன்னை நான் அடைந்தேன் விடுவேனோ? **","பாகின்ற தொல் புகழ் மூவுலகுக்கும் * நாதனே! பரமா! * தண்வேங்கடம்","மேகின்றாய்! * தண் துழாய் விரை நாறு கண்ணியனே!"],0,"/media/recitation/TVM.2.6.10.mp3"],[2966,2966,["** kaNNith thaNNanthuzhAy muDik * kamalath thaDam perungkaNNanai * pugazh","naNNith thenkurugUrch * saDakOpan mARan sonna **","eNNil sOrvil andhAdhi * AyiraththuL ivaiyum Or paththu isaiyoDum *","paNNil pADa vallAr avar * kEsavan thamarE"],["** கண்ணித் தண்ணந்துழாய் முடிக் * கமலத் தடம் பெருங்கண்ணனை * புகழ்","நண்ணித் தென்குருகூர்ச் * சடகோபன் மாறன் சொன்ன **","எண்ணில் சோர்வில் அந்தாதி * ஆயிரத்துள் இவையும் ஓர் பத்து இசையொடும் *","பண்ணில் பாட வல்லார் அவர் * கேசவன் தமரே"],0,"/media/recitation/TVM.2.6.11.mp3"]],[[2967,2967,["** kEsavan thamar * kIzh mEl emar Ezh ezhu piRappum *","mA sadhir idhu peRRu * nammuDai vAzhvu vAykkinRavA! **","Isan en karumANikkam en sengkOlak kaNNan * viNNOr","nAyagan * empirAn emmAn * nArAyaNanAlE"],["** கேசவன் தமர் * கீழ் மேல் எமர் ஏழ் எழு பிறப்பும் *","மா சதிர் இது பெற்று * நம்முடை வாழ்வு வாய்க்கின்றவா! **","ஈசன் என் கருமாணிக்கம் * என் செங்கோலக் கண்ணன் விண்ணோர்","நாயகன் * எம்பிரான் எம்மான் * நாராயணனாலே"],0,"/media/recitation/TVM.2.7.1.mp3"],[2968,2968,["nAraNan muzhu Ezh ulagukkum nAthan * vEdha mayan *","kAraNam kirisai * karumam ivai mudhalvan endhai **","sIr aNanggu amarar piRar palarum * thozhudhu Eththa ninRu *","vAraNaththai maruppu osiththa pirAn * en mAdhavanE"],["நாரணன் முழு ஏழ் உலகுக்கும் நாதன் * வேத மயன் *","காரணம் கிரிசை கருமம் இவை * முதல்வன் எந்தை **","சீர் அணங்கு அமரர் பிறர் பலரும் * தொழுது ஏத்த நின்று *","வாரணத்தை மருப்பு ஒசித்த பிரான் * என் மாதவனே"],0,"/media/recitation/TVM.2.7.2.mp3"],[2969,2969,["mAdhavan enRadhE koNDu * ennai ini ippAl paTTadhu *","yAdhavanggaLum sEr koDEn enRu * ennuL pugundhu irundhu **","thIdhavam keDukkum amudham * senthAmaraik kaN kunRam *","kOdhavam il en kannaRkaTTi * emmAn en gOvindhanE"],["மாதவன் என்றதே கொண்டு * என்னை இனி இப்பால் பட்டது *","யாதவங்களும் சேர் கொடேன் என்று * என்னுள் புகுந்து இருந்து **","தீதவம் கெடுக்கும் அமுதம் * செந்தாமரைக் கண் குன்றம் *","கோதவம் இல் என் கன்னற்கட்டி * எம்மான் என் கோவிந்தனே"],0,"/media/recitation/TVM.2.7.3.mp3"],[2970,2970,["gOvindhan kuDakkUththan * kOvalan enRenRE kuniththu *","thEvum thannaiyum * pADi ADath thiruththi ** ennaik koNDu en","pAvam thannaiyum pARak kaiththu * emar Ezh ezhu piRappum *","mEvum than maiyam AkkinAn * vallan empirAn viTTuvE"],["கோவிந்தன் குடக்கூத்தன் * கோவலன் என்றென்றே குனித்து *","தேவும் தன்னையும் * பாடி ஆடத் திருத்தி ** என்னைக் கொண்டு என்","பாவம் தன்னையும் பாறக் கைத்து * எமர் ஏழ் எழு பிறப்பும் *","மேவும் தன் மையம் ஆக்கினான் * வல்லன் எம்பிரான் விட்டுவே"],0,"/media/recitation/TVM.2.7.4.mp3"],[2971,2971,["viTTilanggu senjchOdhith * thAmarai pAdham kaigaL kaNgaL *","viTTilanggu karunjchuDar * malaiyE thiru uDambu **","viTTilanggu madhiyam sIr * sanggu chakkaram paridhi *","viTTilanggu muDi ammAn * madhusUdhanan thanakkE"],["விட்டிலங்கு செஞ்சோதித் * தாமரை பாதம் கைகள் கண்கள் *","விட்டிலங்கு கருஞ்சுடர் * மலையே திரு உடம்பு **","விட்டிலங்கு மதியம் சீர் * சங்கு சக்கரம் பரிதி *","விட்டு இலங்கு முடி அம்மான் * மதுசூதனன் தனக்கே"],0,"/media/recitation/TVM.2.7.5.mp3"],[2972,2972,["madhusUdhanai anRi maRRilEn enRu * eththAlum karumam inRi *","thudhi sUzhndha pADalgaL * pADi ADa ninRu Uzhi Uzhi thoRum **","edhir sUzhal pukku enaiththOr piRappum * enakkE aruLgaL seyya *","vidhi sUzhndhadhAl enakkEl ammAn * thirivikkiramanaiyE"],["மதுசூதனை அன்றி மற்றிலேன் என்று * எத்தாலும் கருமம் இன்றி *","துதி சூழ்ந்த பாடல்கள் * பாடி ஆட நின்று ஊழி ஊழி தொறும் **","எதிர் சூழல் புக்கு எனைத்தோர் பிறப்பும் * எனக்கே அருள்கள் செய்ய *","விதி சூழ்ந்ததால் எனக்கேல் அம்மான் * திரிவிக்கிரமனையே"],0,"/media/recitation/TVM.2.7.6.mp3"],[2973,2973,["thirivikkiraman senthAmaraik kaN * emmAn en sengkani vAy *","uruvil polindha * veLLaip paLinggu niRaththanan enRenRu ** uLLip","paravip paNindhu * pal Uzhi Uzhi nin pAdha panggayamE *","maruvith thozhum manamE thandhAy * vallai kAN en vAmananE"],["திரிவிக்கிரமன் செந்தாமரைக் கண் * எம்மான் என் செங்கனி வாய் *","உருவில் பொலிந்த * வெள்ளைப் பளிங்கு நிறத்தனன் என்றென்று ** உள்ளிப்","பரவிப் பணிந்து * பல் ஊழி ஊழி நின் பாத பங்கயமே *","மருவித் தொழும் மனமே தந்தாய் * வல்லை காண் என் வாமனனே"],0,"/media/recitation/TVM.2.7.7.mp3"],[2974,2974,["vAmanan en maradhaga vaNNan! * thAmaraik kaNNinan!","kAmanaip payandhAy! * enRenRu un kazhal pADiyE paNindhu **","thU manaththananAyp * piRavith thuzhadhi nIngga * ennaith","thI manam keDuththAy * unakku en seygEn? en sirIdharanE!"],["வாமனன் என் மரதக வண்ணன்! * தாமரைக் கண்ணினன்!","காமனைப் பயந்தாய்! * என்றென்று உன் கழல் பாடியே பணிந்து **","தூ மனத்தனனாய்ப் * பிறவித் துழதி நீங்க * என்னைத்","தீ மனம் கெடுத்தாய் * உனக்கு என் செய்கேன்? என் சிரீதரனே!"],0,"/media/recitation/TVM.2.7.8.mp3"],[2975,2975,["sirIidharan seyya thAmaraik kaNNan * enRenRu irAp pagal vAy","verIi * alamandhu kaNgaL nIr malgi * vevvuyirththu uyirththu **","marIiya thI vinai mALa inbam vaLara * vaigal vaigal","irIi * unnai ennuL vaiththanai * en iruDIkEsanE!"],["சிரீஇதரன் செய்ய தாமரைக் கண்ணன் * என்றென்று இராப் பகல் வாய்","வெரீஇ * அலமந்து கண்கள் நீர் மல்கி * வெவ்வுயிர்த்து உயிர்த்து **","மரீஇய தீ வினை மாள இன்பம் வளர * வைகல் வைகல்","இரீஇ * உன்னை என்னுள் வைத்தனை * என் இருடீகேசனே!"],0,"/media/recitation/TVM.2.7.9.mp3"],[2976,2976,["iruDIkEsan empirAn * ilanggai arakkar kulam *","muruDu thIrththa pirAn emmAn * amarar pemmAn enRenRu **","theruDi Agil nenjchE! vaNanggu * thiNNam aRi aRindhu *","maruDi Elum viDEl kaNDAy * nambi paRpanAbanaiyE"],["இருடீகேசன் எம்பிரான் * இலங்கை அரக்கர் குலம் *","முருடு தீர்த்த பிரான் எம்மான் * அமரர் பெம்மான் என்றென்று **","தெருடி ஆகில் நெஞ்சே! வணங்கு * திண்ணம் அறி அறிந்து *","மருடி ஏலும் விடேல் கண்டாய் * நம்பி பற்பநாபனையே"],0,"/media/recitation/TVM.2.7.10.mp3"],[2977,2977,["paRpanAban uyarvaRa uyarum * perunthiRalOn *","eRparan ennai Akkik koNDu * enakkE thannaith thandha","kaRpagam ** en amudham kAr mugil pOlum * vEngkaDa nal","veRpan * visumbOr pirAn * endhai dhAmOdharanE"],["பற்பநாபன் உயர்வற உயரும் * பெருந்திறலோன் *","எற்பரன் என்னை ஆக்கிக் கொண்டு * எனக்கே தன்னைத் தந்த","கற்பகம் ** என் அமுதம் கார் முகில் போலும் * வேங்கட நல்","வெற்பன் * விசும்போர் பிரான் * எந்தை தாமோதரனே"],0,"/media/recitation/TVM.2.7.11.mp3"],[2978,2978,["dhAmOdharanaith thani mudhalvanai * njAlam uNDavanai *","AmO tharam aRiya * oruvarkku enRe thozhum avargaL **","dhAmOdharan uru Agiya * sivaRkum thisaimugaRkum *","AmO tharam aRiya? * emmAnai en Azhi vaNNanaiyE"],["தாமோதரனைத் தனி முதல்வனை * ஞாலம் உண்டவனை *","ஆமோ தரம் அறிய * ஒருவர்க்கு என்றெ தொழும் அவர்கள் **","தாமோதரன் உரு ஆகிய * சிவற்கும் திசைமுகற்கும் *","ஆமோ தரம் அறிய? * எம்மானை என் ஆழி வண்ணனையே"],0,"/media/recitation/TVM.2.7.12.mp3"],[2979,2979,["** vaNNa mA maNich sOdhiyai * amarar thalai maganai *","kaNNanai neDumAlaith * thenkurugUrch saDakOpan **","paNNiya thamizh mAlai * AyiraththuL ivai panniraNDum *","paNNil panniru nAmap pATTu * aNNal thAL aNaivikkumE"],["** வண்ண மா மணிச் சோதியை * அமரர் தலை மகனை *","கண்ணனை நெடுமாலைத் * தென்குருகூர்ச் சடகோபன் **","பண்ணிய தமிழ் மாலை * ஆயிரத்துள் இவை பன்னிரண்டும் *","பண்ணில் பன்னிரு நாமப் பாட்டு * அண்ணல் தாள் அணைவிக்குமே"],0,"/media/recitation/TVM.2.7.13.mp3"]],[[2980,2980,["** aNaivadhu aravaNai mEl * pUmpAvai Agam","puNarvadhu * iruvar avar mudhalum thAnE **","iNaivanAm epporuTkum * vIDu mudhalAm *","puNaivan * piRavik kaDal nIndhuvArkkE"],["** அணைவது அரவணை மேல் * பூம்பாவை ஆகம்","புணர்வது * இருவர் அவர் முதலும் தானே **","இணைவனாம் எப்பொருட்கும் * வீடு முதலாம் *","புணைவன் * பிறவிக் கடல் நீந்துவார்க்கே"],0,"/media/recitation/TVM.2.8.1.mp3"],[2981,2981,["nIndhum thuyarp piRavi * uTpaDa maRRu evvevaiyum *","nIndhum thuyar illA * vIDu mudhalAm **","pUnthaN punal poygai * yAnai iDar kaDindha *","pUnthaN thuzhAy * en thani nAyagan puNarppE"],["நீந்தும் துயர்ப் பிறவி * உட்பட மற்று எவ்வெவையும் *","நீந்தும் துயர் இல்லா * வீடு முதலாம் **","பூந்தண் புனல் பொய்கை * யானை இடர் கடிந்த *","பூந்தண் துழாய் * என் தனி நாயகன் புணர்ப்பே"],0,"/media/recitation/TVM.2.8.2.mp3"],[2982,2982,["puNarkkum ayanAm * azhikkum aranAm *","puNarththa than undhiyODu * Agaththu manni **","puNarththa thiru Agith * than mArvil thAn sEr *","puNarppan perum puNarppu * enggum pulanE"],["புணர்க்கும் அயனாம் * அழிக்கும் அரனாம் *","புணர்த்த தன் உந்தியோடு * ஆகத்து மன்னி **","புணர்த்த திரு ஆகித் * தன் மார்வில் தான் சேர் *","புணர்ப்பன் பெரும் புணர்ப்பு * எங்கும் புலனே"],0,"/media/recitation/TVM.2.8.3.mp3"],[2983,2983,["pulan aindhu mEyum * poRi aindhu nInggi *","nalam andham illadhOr * nADu puguvIr **","alamandhu vIya * asuraraich seRRAn *","palamundhu sIril * paDimin OvAdhE"],["புலன் ஐந்து மேயும் * பொறி ஐந்து நீங்கி *","நலம் அந்தம் இல்லதோர் * நாடு புகுவீர் **","அலமந்து வீய * அசுரரைச் செற்றான் *","பலமுந்து சீரில் * படிமின் ஓவாதே"],0,"/media/recitation/TVM.2.8.4.mp3"],[2984,2984,["ovAth thuyarp piRavi * uTpaDa maRRu evvevaiyum *","mUvAth thani mudhalAy * mUvulagum kAvalOn **","mAvAgi AmaiyAy * mInAgi mAniDamAm *","thEvAdhi thEva perumAn * en thIrththanE"],["ஒவாத் துயர்ப் பிறவி * உட்பட மற்று எவ்வெவையும் *","மூவாத் தனி முதலாய் * மூவுலகும் காவலோன் **","மாவாகி ஆமையாய் * மீனாகி மானிடமாம் *","தேவாதி தேவ பெருமான் * என் தீர்த்தனே"],0,"/media/recitation/TVM.2.8.5.mp3"],[2985,2985,["thIrththan ulagaLandha * sEvaDi mEl pUnthAmam *","sErththi avaiyE * sivan muDi mEl thAn kaNDu **","pArththan theLindhu ozhindha * painthuzhAyAn perumai *","pErththum oruvarAl * pEsak kiDandhadhE?"],["தீர்த்தன் உலகளந்த * சேவடி மேல் பூந்தாமம் *","சேர்த்தி அவையே * சிவன் முடி மேல் தான் கண்டு **","பார்த்தன் தெளிந்து ஒழிந்த * பைந்துழாயான் பெருமை *","பேர்த்தும் ஒருவரால் * பேசக் கிடந்ததே?"],0,"/media/recitation/TVM.2.8.6.mp3"],[2986,2986,["kiDandhu irundhu ninRu aLandhu * kEzhalAyk kIzh pukku","iDandhiDum * thannuL karakkum umizhum **","thaDam perunthOL Arath thazhuvum * pAr ennum","maDandhaiyai * mAl seyginRa mAl * Ar kANbArE?"],["கிடந்து இருந்து நின்று அளந்து * கேழலாய்க் கீழ் புக்கு","இடந்திடும் * தன்னுள் கரக்கும் உமிழும் **","தடம் பெருந்தோள் ஆரத் தழுவும் * பார் என்னும்","மடந்தையை * மால் செய்கின்ற மால் * ஆர் காண்பாரே?"],0,"/media/recitation/TVM.2.8.7.mp3"],[2987,2987,["kANbAr Ar? em Isan * kaNNanai en kANum ARu? *","UN pEsil ellA ulagum Or * thuRRu ARRA **","sENpAla vIDO * uyirO maRRu epporuTkum *","ENpAlum sOrAn * parandhu uLanAm enggumE"],["காண்பார் ஆர்? எம் ஈசன் * கண்ணனை என் காணும் ஆறு? *","ஊண் பேசில் எல்லா உலகும் ஓர் * துற்று ஆற்றா **","சேண்பால வீடோ * உயிரோ மற்று எப்பொருட்கும் *","ஏண்பாலும் சோரான் * பரந்து உளனாம் எங்குமே"],0,"/media/recitation/TVM.2.8.8.mp3"],[2988,2988,["enggum uLan kaNNan enRa * maganaik kAyndhu *","inggu illaiyAl enRu * iraNiyan thUN puDaippa **","anggu appozhudhE * avan vIyath thOnRiya * en","singgap pirAn perumai * ArAyum sIrmaiththE?"],["எங்கும் உளன் கண்ணன் என்ற * மகனைக் காய்ந்து *","இங்கு இல்லையால் என்று * இரணியன் தூண் புடைப்ப **","அங்கு அப்பொழுதே * அவன் வீயத் தோன்றிய * என்","சிங்கப் பிரான் பெருமை * ஆராயும் சீர்மைத்தே?"],0,"/media/recitation/TVM.2.8.9.mp3"],[2989,2989,["sIrmai koL vIDu * suvarkka naragu IRA *","Irmai koL thEvar * naDuvA maRRu epporuTkum **","vEr mudhalAy viththAyp * parandhu thani ninRa *","kAr mugil pOl vaNNan * en kaNNanai nAn kaNDEnE"],["சீர்மை கொள் வீடு * சுவர்க்க நரகு ஈறா *","ஈர்மை கொள் தேவர் * நடுவா மற்று எப்பொருட்கும் **","வேர் முதலாய் வித்தாய்ப் * பரந்து தனி நின்ற *","கார் முகில் போல் வண்ணன் * என் கண்ணனை நான் கண்டேனே"],0,"/media/recitation/TVM.2.8.10.mp3"],[2990,2990,["** kaN thalanggaL seyya * karumEni ammAnai *","vaNDu alambum sOlai * vazhudhi vaLa nADan **","paN thalaiyil sonna thamizh * Ayiraththu ippaththum vallAr *","viN thalaiyil vIRRirundhu ALvar * emmA vIDE"],["** கண் தலங்கள் செய்ய * கருமேனி அம்மானை *","வண்டு அலம்பும் சோலை * வழுதி வள நாடன் **","பண் தலையில் சொன்ன தமிழ் * ஆயிரத்து இப்பத்தும் வல்லார் *","விண் தலையில் வீற்றிருந்து ஆள்வர் * எம்மா வீடே"],0,"/media/recitation/TVM.2.8.11.mp3"]],[[2991,2991,["** emmA vITTuth * thiRamum seppam * nin","semmA pAdha paRputh * thalai sErththu ollai **","kaimmA thunbam * kaDindha pirAnE! *","ammA! aDiyEn * vENDuvadhu IdhE"],["** எம்மா வீட்டுத் * திறமும் செப்பம் * நின்","செம்மா பாத பற்புத் * தலை சேர்த்து ஒல்லை **","கைம்மா துன்பம் * கடிந்த பிரானே! *","அம்மா! அடியேன் * வேண்டுவது ஈதே"],0,"/media/recitation/TVM.2.9.1.mp3"],[2992,2992,["IdhE yAn unnaik * koLvadhu enjnjAnRum * en","mai thOy sOdhi * maNivaNNa! endhAy! **","eydhA nin kazhal * yAn eydha * njAnak","kai thA * kAlak kazhivu seyyElE"],["ஈதே யான் உன்னைக் * கொள்வது எஞ்ஞான்றும் * என்","மை தோய் சோதி * மணிவண்ண! எந்தாய்! **","எய்தா நின் கழல் * யான் எய்த * ஞானக்","கை தா * காலக் கழிவு செய்யேலே"],0,"/media/recitation/TVM.2.9.2.mp3"],[2993,2993,["seyyEl thI vinai enRu * aruL seyyum * en","kai Ar chakkarak * kaNNa pirAnE! **","aiyAr kaNDam aDaikkilum * nin kazhal","eyyAdhu Eththa * aruL sey enakkE"],["செய்யேல் தீ வினை என்று * அருள் செய்யும் * என்","கை ஆர் சக்கரக் * கண்ண பிரானே! **","ஐயார் கண்டம் அடைக்கிலும் * நின் கழல்","எய்யாது ஏத்த * அருள் செய் எனக்கே"],0,"/media/recitation/TVM.2.9.3.mp3"],[2994,2994,["enakkE ATsey * ekkAlaththum enRu * en","manakkE vandhu * iDaivIDu inRi manni **","thanakkE Aga * enaik koLLum IdhE *","enakkE kaNNanai * yAn koL siRappE"],["எனக்கே ஆட்செய் * எக்காலத்தும் என்று * என்","மனக்கே வந்து * இடைவீடு இன்றி மன்னி **","தனக்கே ஆக * எனைக் கொள்ளும் ஈதே *","எனக்கே கண்ணனை * யான் கொள் சிறப்பே"],0,"/media/recitation/TVM.2.9.4.mp3"],[2995,2995,["siRappil vIDu * suvarkka naragam *","iRappil eydhuga * eydhaRka ** yAnum","piRappu il * pal piRavip perumAnai *","maRappu onRinRi * enRum magizhvEnE"],["சிறப்பில் வீடு * சுவர்க்க நரகம் *","இறப்பில் எய்துக * எய்தற்க ** யானும்","பிறப்பு இல் * பல் பிறவிப் பெருமானை *","மறப்பு ஒன்றின்றி * என்றும் மகிழ்வேனே"],0,"/media/recitation/TVM.2.9.5.mp3"],[2996,2996,["magizh koL theyvam * ulOgam alOgam *","magizh koL sOdhi * malarndha ammAnE! **","magizh koL sindhai * sol seygai koNDu * enRum","magizhvuRRu * unnai vaNangga vArAyE"],["மகிழ் கொள் தெய்வம் * உலோகம் அலோகம் *","மகிழ் கொள் சோதி * மலர்ந்த அம்மானே! **","மகிழ் கொள் சிந்தை * சொல் செய்கை கொண்டு * என்றும்","மகிழ்வுற்று * உன்னை வணங்க வாராயே"],0,"/media/recitation/TVM.2.9.6.mp3"],[2997,2997,["vArAy * un thiruppAdha malark kIzh *","pErAdhE yAn vandhu * aDaiyumpaDi","thArAdhAy! ** unnai ennuL * vaippil enRum","ArAdhAy! * enakku enRum ekkAlE"],["வாராய் * உன் திருப்பாத மலர்க் கீழ் *","பேராதே யான் வந்து * அடையும்படி","தாராதாய்! ** உன்னை என்னுள் * வைப்பில் என்றும்","ஆராதாய்! * எனக்கு என்றும் எக்காலே"],0,"/media/recitation/TVM.2.9.7.mp3"],[2998,2998,["ekkAlaththu endhaiyAy * ennuL mannil * maRRu","ekkAlaththilum * yAdhonRum vENDEn **","mikkAr vEdha * vimalar vizhunggum * en","akkArak kaniyE! * unnai yAnE"],["எக்காலத்து எந்தையாய் * என்னுள் மன்னில் * மற்று","எக்காலத்திலும் * யாதொன்றும் வேண்டேன் **","மிக்கார் வேத * விமலர் விழுங்கும் * என்","அக்காரக் கனியே! * உன்னை யானே"],0,"/media/recitation/TVM.2.9.8.mp3"],[2999,2999,["yAnE ennai * aRiya kilAdhE *","yAnE endhanadhE * enRu irundhEn **","yAnE nI * en uDaimaiyum nIyE *","vAnE Eththum * em vAnavar ERE"],["யானே என்னை * அறிய கிலாதே *","யானே என்தனதே * என்று இருந்தேன் **","யானே நீ * என் உடைமையும் நீயே *","வானே ஏத்தும் * எம் வானவர் ஏறே"],0,"/media/recitation/TVM.2.9.9.mp3"],[3000,3000,["EREl Ezhum venRu * Er koL ilanggaiyai *","nIRE seydha * neDunjchuDarch sOdhi **","thEREl ennai * un ponnaDich sErththu ollai *","vERE pOga * enjnjAnRum viDalE"],["ஏறேல் ஏழும் வென்று * ஏர் கொள் இலங்கையை *","நீறே செய்த * நெடுஞ்சுடர்ச் சோதி **","தேறேல் என்னை * உன் பொன்னடிச் சேர்த்து ஒல்லை *","வேறே போக * எஞ்ஞான்றும் விடலே"],0,"/media/recitation/TVM.2.9.10.mp3"],[3001,3001,["** viDalil chakkaraththu * aNNalai mEval *","viDalil vaNkurugUrch * saDakOpan sol **","keDalil AyiraththuL * ivai paththum *","keDalil vIDu seyyum * kiLarvArkkE"],["** விடலில் சக்கரத்து * அண்ணலை மேவல் *","விடலில் வண்குருகூர்ச் * சடகோபன் சொல் **","கெடலில் ஆயிரத்துள் * இவை பத்தும் *","கெடலில் வீடு செய்யும் * கிளர்வார்க்கே"],0,"/media/recitation/TVM.2.9.11.mp3"]],[[3002,3002,["** kiLar oLi iLamai * keDuvadhan munnam *","vaLar oLi mAyOn * maruviya kOyil **","vaLar iLam pozhil sUzh * mAlirunjchOlai *","thaLarvu ilar Agich * sArvadhu sadhirE"],["** கிளர் ஒளி இளமை * கெடுவதன் முன்னம் *","வளர் ஒளி மாயோன் * மருவிய கோயில் **","வளர் இளம் பொழில் சூழ் * மாலிருஞ்சோலை *","தளர்வு இலர் ஆகிச் * சார்வது சதிரே"],0,"/media/recitation/TVM.2.10.1.mp3"],[3003,3003,["sadhir iLa maDavAr * thAzhchchiyai madhiyAdhu *","adhir kural sanggaththu * azhagar tham kOyil **","madhi thavazh kuDumi * mAlirunjchOlai *","pathi adhu Eththi * ezhuvadhu payanE"],["சதிர் இள மடவார் * தாழ்ச்சியை மதியாது *","அதிர் குரல் சங்கத்து * அழகர் தம் கோயில் **","மதி தவழ் குடுமி * மாலிருஞ்சோலை *","பதி அது ஏத்தி * எழுவது பயனே"],0,"/media/recitation/TVM.2.10.2.mp3"],[3004,3004,["payan alla seydhu * payan illai nenjchE! *","puyal mazhai vaNNar * purindhuRai kOyil **","mayal migu pozhil sUzh * mAlirunjchOlai *","ayal malai aDaivadhu * adhu karumamE"],["பயன் அல்ல செய்து * பயன் இல்லை நெஞ்சே! *","புயல் மழை வண்ணர் * புரிந்துறை கோயில் **","மயல் மிகு பொழில் சூழ் * மாலிருஞ்சோலை *","அயல் மலை அடைவது * அது கருமமே"],0,"/media/recitation/TVM.2.10.3.mp3"],[3005,3005,["karuma van pAsam * kazhiththu uzhanRu uyyavE *","peru malai eDuththAn * pIDuRai kOyil **","varu mazhai thavazhum * mAlirunjchOlai *","thirumalai adhuvE * aDaivadhu thiRamE"],["கரும வன் பாசம் * கழித்து உழன்று உய்யவே *","பெரு மலை எடுத்தான் * பீடுறை கோயில் **","வரு மழை தவழும் * மாலிருஞ்சோலை *","திருமலை அதுவே * அடைவது திறமே"],0,"/media/recitation/TVM.2.10.4.mp3"],[3006,3006,["thiRam uDai valaththAl * thI vinai perukkAdhu *","aRamuyal Azhip * paDaiyavan kOyil **","maRuvil vaN sunai sUzh * mAlirunjchOlai *","puRa malai sArap * pOvadhu kiRiyE"],["திறம் உடை வலத்தால் * தீ வினை பெருக்காது *","அறமுயல் ஆழிப் * படையவன் கோயில் **","மறுவில் வண் சுனை சூழ் * மாலிருஞ்சோலை *","புற மலை சாரப் * போவது கிறியே"],0,"/media/recitation/TVM.2.10.5.mp3"],[3007,3007,["kiRi ena ninaimin * kIzhmai seyyAdhE *","uRi amar veNNey * uNDavan kOyil **","maRiyoDu piNai sEr * mAlirunjchOlai *","neRi paDa adhuvE * ninaivadhu nalamE"],["கிறி என நினைமின் * கீழ்மை செய்யாதே *","உறி அமர் வெண்ணெய் * உண்டவன் கோயில் **","மறியொடு பிணை சேர் * மாலிருஞ்சோலை *","நெறி பட அதுவே * நினைவது நலமே"],0,"/media/recitation/TVM.2.10.6.mp3"],[3008,3008,["nalam ena ninaimin * naragu azhundhAdhE *","nilamunam iDandhAn * nIDuRai kOyil **","malamaRu madhi sEr * mAlirunjchOlai *","valamuRai eydhi * maruvudhal valamE"],["நலம் என நினைமின் * நரகு அழுந்தாதே *","நிலமுனம் இடந்தான் * நீடுறை கோயில் **","மலமறு மதி சேர் * மாலிருஞ்சோலை *","வலமுறை எய்தி * மருவுதல் வலமே"],0,"/media/recitation/TVM.2.10.7.mp3"],[3009,3009,["valam seydhu vaigal * valam kazhiyAdhE *","valam seyyum * Aya mAyavan kOyil **","valam seyyum vAnOr * mAlirunjchOlai *","valam seydhu nALum * maruvudhal vazhakkE"],["வலம் செய்து வைகல் * வலம் கழியாதே *","வலம் செய்யும் * ஆய மாயவன் கோயில் **","வலம் செய்யும் வானோர் * மாலிருஞ்சோலை *","வலம் செய்து நாளும் * மருவுதல் வழக்கே"],0,"/media/recitation/TVM.2.10.8.mp3"],[3010,3010,["vazhakkena ninaimin * valvinai mUzhgAdhu *","azhakkoDi aTTAn * amar perum kOyil **","mazhak kaLiRRinam sEr * mAlirunjchOlai *","thozhak karudhuvadhE * thuNivadhu sUdhE"],["வழக்கென நினைமின் * வல்வினை மூழ்காது *","அழக்கொடி அட்டான் * அமர் பெரும் கோயில் **","மழக் களிற்றினம் சேர் * மாலிருஞ்சோலை *","தொழக் கருதுவதே * துணிவது சூதே"],0,"/media/recitation/TVM.2.10.9.mp3"],[3011,3011,["sUdhu enRu kaLavum * sUdhum seyyAdhE *","vEdha mun viriththAn * virumbiya kOyil **","mAdhuRu mayil sEr * mAlirunjchOlai *","pOdhu avizh malaiyE * puguvadhu poruLE"],["சூது என்று களவும் * சூதும் செய்யாதே *","வேத முன் விரித்தான் * விரும்பிய கோயில் **","மாதுறு மயில் சேர் * மாலிருஞ்சோலை *","போது அவிழ் மலையே * புகுவது பொருளே"],0,"/media/recitation/TVM.2.10.10.mp3"],[3012,3012,["** poruL enRu ivvulagam * paDaiththavan pugazh mEl *","maruL il vaN kurugUr * vaN saDakOpan **","theruL koLLach sonna * Or AyiraththuL ippaththu *","aruL uDaiyavan thAL * aNaivikkum muDiththE"],["** பொருள் என்று இவ்வுலகம் * படைத்தவன் புகழ் மேல் *","மருள் இல் வண் குருகூர் * வண் சடகோபன் **","தெருள் கொள்ளச் சொன்ன * ஓர் ஆயிரத்துள் இப்பத்து *","அருள் உடையவன் தாள் * அணைவிக்கும் முடித்தே"],0,"/media/recitation/TVM.2.10.11.mp3"]]]