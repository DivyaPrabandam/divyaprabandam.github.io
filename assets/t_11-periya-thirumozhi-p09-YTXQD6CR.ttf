[[[1548,1548,["** kaRavA maDa nAgu * than kanRu uLLinAR pOl *","maRavAdhu aDiyEn * unnaiyE azhaikkinREn **","naRavAr pozhil sUzh * naRaiyUr ninRa nambi! *","piRavAmai enaip paNi * endhai pirAnE!"],["** கறவா மட நாகு * தன் கன்று உள்ளினாற் போல் *","மறவாது அடியேன் * உன்னையே அழைக்கின்றேன் **","நறவார் பொழில் சூழ் * நறையூர் நின்ற நம்பி! *","பிறவாமை எனைப் பணி * எந்தை பிரானே!"],0,"/media/recitation/PT.7.1.1.mp3"],[1549,1549,["vaRRA mudhu nIroDu * mAl varai Ezhum *","thuRRAga mun thuRRiya * thol pugazhOnE! **","aRREn aDiyEn * unnaiyE azhaikkinREn *","peRREn aruL thandhiDu * en endhai pirAnE!"],["வற்றா முது நீரொடு * மால் வரை ஏழும் *","துற்றாக முன் துற்றிய * தொல் புகழோனே! **","அற்றேன் அடியேன் * உன்னையே அழைக்கின்றேன் *","பெற்றேன் அருள் தந்திடு * என் எந்தை பிரானே!"],0,"/media/recitation/PT.7.1.2.mp3"],[1550,1550,["thArEn piRarkku * un aruL enniDai vaiththAy *","ArEn adhuvE * parugik kaLikkinREn **","kArEy kaDalE malaiyE * thirukkOTTi","yUrE * ugandhAyai * ugandhu aDiyEnE"],["தாரேன் பிறர்க்கு * உன் அருள் என்னிடை வைத்தாய் *","ஆரேன் அதுவே * பருகிக் களிக்கின்றேன் **","காரேய் கடலே மலையே * திருக்கோட்டி","யூரே * உகந்தாயை * உகந்து அடியேனே"],0,"/media/recitation/PT.7.1.3.mp3"],[1551,1551,["puL vAy piLandha * punidhA! enRu azhaikka *","uLLE ninRu * en uLLam kuLirum oruvA! **","kaLvA! * kaDalmallaik kiDandha karumbE! *","vaLLAl! unnai * engnganam nAn maRakkEnE?"],["புள் வாய் பிளந்த * புனிதா! என்று அழைக்க *","உள்ளே நின்று * என் உள்ளம் குளிரும் ஒருவா! **","கள்வா! * கடல்மல்லைக் கிடந்த கரும்பே! *","வள்ளால்! உன்னை * எங்ஙனம் நான் மறக்கேனே?"],0,"/media/recitation/PT.7.1.4.mp3"],[1552,1552,["villEr nudhal * vEl neDungkaNNiyum nIyum *","kallAr kaDungkAnam * thirindha kaLiRE! **","nallAy! naranAraNanE! * enggaL nambi! *","sollAy unnai * yAn vaNanggith thozhumARE"],["வில்லேர் நுதல் * வேல் நெடுங்கண்ணியும் நீயும் *","கல்லார் கடுங்கானம் * திரிந்த களிறே! **","நல்லாய்! நரநாரணனே! * எங்கள் நம்பி! *","சொல்லாய் உன்னை * யான் வணங்கித் தொழுமாறே"],0,"/media/recitation/PT.7.1.5.mp3"],[1553,1553,["paṉi ey paraṅ kuṉṟiṉ * paval̤at tiral̤e *","muṉiye * tirumūzhikkal̤attu vil̤akke **","iṉiyāy tŏṇṭarom * parukum iṉ amutu āya","kaṉiye * uṉṉaik kaṇṭukŏṇṭu * uyntŏzhinteṉe-"],["பனி ஏய் பரங் குன்றின் * பவளத் திரளே *","முனியே * திருமூழிக்களத்து விளக்கே **","இனியாய் தொண்டரோம் * பருகும் இன் அமுது ஆய","கனியே * உன்னைக் கண்டுகொண்டு * உய்ந்தொழிந்தேனே"],1,"/media/recitation/PT.7.1.6.mp3"],[1554,1554,["kadhiyEl illai * nin aruL alladhu enakku *","nidhiyE! * thirunIrmalai niththilaththoththE! **","padhiyE! paravith thozhum * thoNDar thamakkuk","kadhiyE! * unnaik kaNDu koNDu uyndhozhindhEnE"],["கதியேல் இல்லை * நின் அருள் அல்லது எனக்கு *","நிதியே! * திருநீர்மலை நித்திலத்தொத்தே! **","பதியே! பரவித் தொழும் * தொண்டர் தமக்குக்","கதியே! * உன்னைக் கண்டு கொண்டு * உய்ந்தொழிந்தேனே"],0,"/media/recitation/PT.7.1.7.mp3"],[1555,1555,["aththA! ariyE! enRu * unnai azhaikka *","piththA enRu pEsuginRAr * piRar ennai **","muththE! maNimANikkamE! * muLaikkinRa","viththE! * unnai engnganam * nAn viDugEnE?"],["அத்தா! அரியே! என்று * உன்னை அழைக்க *","பித்தா என்று பேசுகின்றார் * பிறர் என்னை **","முத்தே! மணிமாணிக்கமே! * முளைக்கின்ற","வித்தே! * உன்னை எங்ஙனம் * நான் விடுகேனே?"],0,"/media/recitation/PT.7.1.8.mp3"],[1556,1556,["thUyAy! suDar mAmadhi pOl * uyirkku ellAm *","thAyAy aLikkinRa * thaNthAmaraik kaNNA! **","AyA! alainIr ulagEzhum * mun uNDa","vAyA! * unnai engnganam * nAn maRakkEnE?"],["தூயாய்! சுடர் மாமதி போல் * உயிர்க்கு எல்லாம் *","தாயாய் அளிக்கின்ற * தண்தாமரைக் கண்ணா! **","ஆயா! அலைநீர் உலகேழும் * முன் உண்ட","வாயா! * உன்னை எங்ஙனம் * நான் மறக்கேனே?"],0,"/media/recitation/PT.7.1.9.mp3"],[1557,1557,["vaṇṭu ār pŏzhil cūzh * naṟaiyūr nampikku * ĕṉṟum","tŏṇṭu āy * kaliyaṉ ŏlicĕy tamizh-mālai *","tŏṇṭīr ivai pāṭumiṉ * pāṭi niṉṟu āṭa *","uṇṭe vicumpu * um-tamakku illai tuyare-"],["வண்டு ஆர் பொழில் சூழ் * நறையூர் நம்பிக்கு * என்றும்","தொண்டு ஆய் * கலியன் ஒலிசெய் தமிழ் மாலை *","தொண்டீர் இவை பாடுமின் * பாடி நின்று ஆட *","உண்டே விசும்பு * உம் தமக்கு இல்லை துயரே"],1,"/media/recitation/PT.7.1.10.mp3"]],[[1558,1558,["** puLLAy EnamumAyp pugundhu * ennai uLLam koNDa","kaLvA! enRalum * en kaNgaL nIrgaL sOrtharumAl **","uLLE ninRu urugi * nenjcham unnai uLLiyakkAl *","naLLEn unnai allAl * naRaiyUr ninRa nambIyO!"],["** புள்ளாய் ஏனமுமாய்ப் புகுந்து * என்னை உள்ளம் கொண்ட","கள்வா! என்றலும் * என் கண்கள் நீர்கள் சோர்தருமால் **","உள்ளே நின்று உருகி * நெஞ்சம் உன்னை உள்ளியக்கால் *","நள்ளேன் உன்னை அல்லால் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.1.mp3"],[1559,1559,["ODA ALariyin * uruvAy maruvi * enthan","mADE vandhu * aDiyEn manam koLLa valla maindhA! **","pADEn thoNDar thammaik * kavidhaip panuval koNDu *","nADEn unnai allAl * naRaiyUr ninRa nambIyO!"],["ஓடா ஆளரியின் * உருவாய் மருவி * என்தன்","மாடே வந்து * அடியேன் மனம் கொள்ள வல்ல மைந்தா! **","பாடேன் தொண்டர் தம்மைக் * கவிதைப் பனுவல் கொண்டு *","நாடேன் உன்னை அல்லால் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.2.mp3"],[1560,1560,["ĕmmāṉum ĕm aṉaiyum * ĕṉṉaip pĕṟṟu ŏzhintataṟpiṉ *","ammāṉum ammaṉaiyum * aṭiyeṉukku āki niṉṟa **","nal māṉa ŏṇ cuṭare * naṟaiyūr niṉṟa nampī * uṉ","maim māṉa vaṇṇam allāl * makizhntu ettamāṭṭeṉe-"],["எம்மானும் எம் அனையும் * என்னைப் பெற்று ஒழிந்ததற்பின் *","அம்மானும் அம்மனையும் * அடியேனுக்கு ஆகி நின்ற **","நல் மான ஒண் சுடரே * நறையூர் நின்ற நம்பீ * உன்","மைம் மான வண்ணம் அல்லால் * மகிழ்ந்து ஏத்தமாட்டேனே"],1,"/media/recitation/PT.7.2.3.mp3"],[1561,1561,["siRiyAy Or piLLaiyumAy * ulaguNDu Or Alilai mEl","uRaivAy! * en nenjchin uLLE uRaivAy * uRaindhadhu thAn **","aRiyAdhu irundhu aRiyEn aDiyEn * aNivaNDu kiNDum *","naRai vArum pozhil sUzh * naRaiyUr ninRa nambIyO!"],["சிறியாய் ஓர் பிள்ளையுமாய் * உலகுண்டு ஓர் ஆலிலை மேல்","உறைவாய்! * என் நெஞ்சின் உள்ளே உறைவாய் * உறைந்தது தான் **","அறியாது இருந்து அறியேன் அடியேன் * அணிவண்டு கிண்டும் *","நறை வாரும் பொழில் சூழ் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.4.mp3"],[1562,1562,["nINDAyai vAnavargaL * ninaindhu Eththik kANbaridhAl *","ANDAy enRu AdharikkappaDuvAykku * nAn aDimai","pUNDEn ** en nenjchin uLLE * pugundhAyaip pOgal oTTEn *","nAN thAn unakku ozhindhEn * naRaiyUr ninRa nambIyO!"],["நீண்டாயை வானவர்கள் * நினைந்து ஏத்திக் காண்பரிதால் *","ஆண்டாய் என்று ஆதரிக்கப்படுவாய்க்கு * நான் அடிமை","பூண்டேன் ** என் நெஞ்சின் உள்ளே * புகுந்தாயைப் போகல் ஒட்டேன் *","நாண் தான் உனக்கு ஒழிந்தேன் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.5.mp3"],[1563,1563,["ĕm tātai tātai appāl * ĕzhuvar pazha aṭimai","vantār * ĕṉ nĕñciṉ ul̤l̤e * vantāyaip pokal ŏṭṭeṉ **","anto!-ĕṉ ār uyire * arace arul̤ ĕṉakku *","nantāmal tanta ĕntāy! * naṟaiyūr niṉṟa nampīyo-"],["எம் தாதை தாதை அப்பால் * எழுவர் பழ அடிமை","வந்தார் * என் நெஞ்சின் உள்ளே * வந்தாயைப் போகல் ஒட்டேன் **","அந்தோ! என் ஆர் உயிரே * அரசே அருள் எனக்கு *","நந்தாமல் தந்த எந்தாய்! * நறையூர் நின்ற நம்பீயோ"],1,"/media/recitation/PT.7.2.6.mp3"],[1564,1564,["maṉ añca āyiram tol̤ * mazhuvil tuṇitta maintā *","ĕṉ nĕñcattul̤ iruntu * iṅku iṉip poyp piṟar ŏruvar **","val nĕñcam pukku irukka ŏṭṭeṉ * val̤aittu vaitteṉ *","nal nĕñca aṉṉam maṉṉum * naṟaiyūr niṉṟa nampīyo-"],["மன் அஞ்ச ஆயிரம் தோள் * மழுவில் துணித்த மைந்தா *","என் நெஞ்சத்துள் இருந்து * இங்கு இனிப் போய்ப் பிறர் ஒருவர் **","வல் நெஞ்சம் புக்கு இருக்க ஒட்டேன் * வளைத்து வைத்தேன் *","நல் நெஞ்ச அன்னம் மன்னும் * நறையூர் நின்ற நம்பீயோ"],1,"/media/recitation/PT.7.2.7.mp3"],[1565,1565,["eppOdhum ponmalar iTTu * imaiyOr thozhudhu * thanggaL","kaippOdhu koNDu iRainjchik * kazhal mEl vaNangga ninRAy **","ippOdhu en nenjchin uLLE * pugundhAyaip pOgal oTTEn *","naRpOdhu vaNDu kiNDum * naRaiyUr ninRa nambIyO!"],["எப்போதும் பொன்மலர் இட்டு * இமையோர் தொழுது * தங்கள்","கைப்போது கொண்டு இறைஞ்சிக் * கழல் மேல் வணங்க நின்றாய் **","இப்போது என் நெஞ்சின் உள்ளே * புகுந்தாயைப் போகல் ஒட்டேன் *","நற்போது வண்டு கிண்டும் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.8.mp3"],[1566,1566,["Un Er Akkai thannai * uzhandhu Ombi vaiththamaiyAl *","yAnAy enthanakkAy * aDiyEn manam pugundha","thEnE! ** thIngkarumbin theLivE! * en sindhai thannAl *","nAnE eydhap peRREn * naRaiyUr ninRa nambIyO!"],["ஊன் ஏர் ஆக்கை தன்னை * உழந்து ஓம்பி வைத்தமையால் *","யானாய் என்தனக்காய் * அடியேன் மனம் புகுந்த","தேனே! ** தீங்கரும்பின் தெளிவே! * என் சிந்தை தன்னால் *","நானே எய்தப் பெற்றேன் * நறையூர் நின்ற நம்பீயோ!"],0,"/media/recitation/PT.7.2.9.mp3"],[1567,1567,["** nannIr vayal puDai sUzh * naRaiyUr ninRa nambiyai *","kannIra mAl varaith thOL * kalikanRi manggaiyar kOn **","sonnIra sol mAlai * solluvArgaL * sUzh visumbil","nannIrmaiyAl magizhndhu * neDungkAlam vAzhvArE"],["** நன்னீர் வயல் புடை சூழ் * நறையூர் நின்ற நம்பியை *","கன்னீர மால் வரைத் தோள் * கலிகன்றி மங்கையர் கோன் **","சொன்னீர சொல் மாலை * சொல்லுவார்கள் * சூழ் விசும்பில்","நன்னீர்மையால் மகிழ்ந்து * நெடுங்காலம் வாழ்வாரே"],0,"/media/recitation/PT.7.2.10.mp3"]],[[1568,1568,["ciṉa il cĕṅ kaṇ arakkar uyir māl̤ac *","cĕṟṟa villi ĕṉṟu kaṟṟavar tamtam","maṉamul̤ kŏṇṭu * ĕṉṟum ĕppotum niṉṟu ettum","mā muṉiyai * maram ezh ĕyta maintaṉai **","naṉavil cĕṉṟu ārkkum naṇṇaṟku ariyāṉai *","nāṉ aṭiyeṉ naṟaiyūr niṉṟa nampiyai *","kaṉavil kaṇṭeṉ iṉṟu kaṇṭamaiyāl * ĕṉ","kaṇ-iṇaikal̤ kal̤ippak kal̤itteṉe-"],["சின இல் செங் கண் அரக்கர் உயிர் மாளச் *","செற்ற வில்லி என்று கற்றவர் தம்தம்","மனமுள் கொண்டு * என்றும் எப்போதும் நின்று ஏத்தும்","மா முனியை * மரம் ஏழ் எய்த மைந்தனை **","நனவில் சென்று ஆர்க்கும் நண்ணற்கு அரியானை *","நான் அடியேன் நறையூர் நின்ற நம்பியை *","கனவில் கண்டேன் இன்று கண்டமையால் * என்","கண் இணைகள் களிப்பக் களித்தேனே"],1,"/media/recitation/PT.7.3.1.mp3"],[1569,1569,["thAy ninaindha kanRE okka * ennaiyum","thannaiyE ninaikkach seydhu * thAn enak","kAy ninaindhu aruL seyyum appanai *","anRu ivvaiyagam uNDu umizhndhiTTa","vAyanai ** magarak kuzhaik kAdhanai","maindhanai * madhiL kOval iDaikazhi","Ayanai * amararkku ari ERRai * en","anbanai anRi AdhariyEnE"],["தாய் நினைந்த கன்றே ஒக்க * என்னையும்","தன்னையே நினைக்கச் செய்து * தான் எனக்","காய் நினைந்து அருள் செய்யும் அப்பனை *","அன்று இவ்வையகம் உண்டு உமிழ்ந்திட்ட","வாயனை ** மகரக் குழைக் காதனை","மைந்தனை * மதிள் கோவல் இடைகழி","ஆயனை * அமரர்க்கு அரி ஏற்றை * என்","அன்பனை அன்றி ஆதரியேனே"],0,"/media/recitation/PT.7.3.2.mp3"],[1570,1570,["vandha nAL vandhu en nenjchiDam koNDAn *","maRROr nenjchu aRiyAn * aDiyEnuDaich","sindhaiyAy vandhu thenpularkku ennaich","sEr koDAn * idhu sikkenap peRREn **","kondhulAm pozhil sUzh kuDandhaith thalaik","kOvinaik * kuDam ADiya kUththanai *","endhaiyai endhai thandhai thammAnai *","empirAnai eththAl maRakkEnE?"],["வந்த நாள் வந்து என் நெஞ்சிடம் கொண்டான் *","மற்றோர் நெஞ்சு அறியான் * அடியேனுடைச்","சிந்தையாய் வந்து தென்புலர்க்கு என்னைச்","சேர் கொடான் * இது சிக்கெனப் பெற்றேன் **","கொந்துலாம் பொழில் சூழ் குடந்தைத் தலைக்","கோவினைக் * குடம் ஆடிய கூத்தனை *","எந்தையை எந்தை தந்தை தம்மானை *","எம்பிரானை எத்தால் மறக்கேனே?"],0,"/media/recitation/PT.7.3.3.mp3"],[1571,1571,["urangkaLAl iyanRa mannar mALap *","pAradhaththu oru thEr aivarkkAych senRu *","iranggi Urndhu avarkku innaruL seyyum","empirAnai * vambAr punal kAviri **","aranggam ALi en ALi viN ALi *","Azhi sUzh ilanggai malanggach senRu *","saranggaL ANDa thaNthAmaraik kaNNanukku anRi *","en manam thAzhndhu nillAdhE"],["உரங்களால் இயன்ற மன்னர் மாளப் *","பாரதத்து ஒரு தேர் ஐவர்க்காய்ச் சென்று *","இரங்கி ஊர்ந்து அவர்க்கு இன்னருள் செய்யும்","எம்பிரானை * வம்பார் புனல் காவிரி **","அரங்கம் ஆளி என் ஆளி விண் ஆளி *","ஆழி சூழ் இலங்கை மலங்கச் சென்று *","சரங்கள் ஆண்ட தண்தாமரைக் கண்ணனுக்கு அன்றி *","என் மனம் தாழ்ந்து நில்லாதே"],0,"/media/recitation/PT.7.3.4.mp3"],[1572,1572,["Anggu vennaragaththu azhundhum pOdhu *","anjchEl enRu aDiyEnai anggE vandhu","thAnggu * thAmarai anna ponnAr aDi","empirAnai * umbarkku aNiyAy ninRa **","vEngkaDaththu ariyaip pari kIRiyai *","veNNey uNDu uraliniDai AppuNDa","thIngkarumbinai * thEnai nanpAlinai anRi *","en manam sindhai seyyAdhE"],["ஆங்கு வெந்நரகத்து அழுந்தும் போது *","அஞ்சேல் என்று அடியேனை அங்கே வந்து","தாங்கு * தாமரை அன்ன பொன்னார் அடி","எம்பிரானை * உம்பர்க்கு அணியாய் நின்ற **","வேங்கடத்து அரியைப் பரி கீறியை *","வெண்ணெய் உண்டு உரலினிடை ஆப்புண்ட","தீங்கரும்பினை * தேனை நன்பாலினை அன்றி *","என் மனம் சிந்தை செய்யாதே"],0,"/media/recitation/PT.7.3.5.mp3"],[1573,1573,["eTTanaip pozhudhu Agilum * enRum","en manaththu agalAdhu irukkum pugazh *","thaTTalarththa ponnE alar kOnggin *","thAzh pozhil thirumAlirunjchOlai ang","kaTTiyai ** karumbu InRa insARRaik *","kAdhalAl maRai nAnkum mun Odhiya","paTTanai * paravaith thuyil ERRai * en","paNbanai anRip pADal seyyEnE"],["எட்டனைப் பொழுது ஆகிலும் * என்றும்","என் மனத்து அகலாது இருக்கும் புகழ் *","தட்டலர்த்த பொன்னே அலர் கோங்கின் *","தாழ் பொழில் திருமாலிருஞ்சோலை அங்","கட்டியை ** கரும்பு ஈன்ற இன்சாற்றைக் *","காதலால் மறை நான்கும் முன் ஓதிய","பட்டனை * பரவைத் துயில் ஏற்றை * என்","பண்பனை அன்றிப் பாடல் செய்யேனே"],0,"/media/recitation/PT.7.3.6.mp3"],[1574,1574,["paNNin inmozhi yAzh narambil peRRa *","pAlai Agi inggE pugundhu * en","kaNNum nenjchum vAyum iDangkoNDAn *","koNDa pin maRaiyOr manam thannuL **","viNNuLAr perumAnai emmAnai *","vInggu nIr magaram thiLaikkum kaDal","vaNNan * mAmaNi vaNNan em aNNal *","vaNNamE anRi vAy uraiyAdhE"],["பண்ணின் இன்மொழி யாழ் நரம்பில் பெற்ற *","பாலை ஆகி இங்கே புகுந்து * என்","கண்ணும் நெஞ்சும் வாயும் இடங்கொண்டான் *","கொண்ட பின் மறையோர் மனம் தன்னுள் **","விண்ணுளார் பெருமானை எம்மானை *","வீங்கு நீர் மகரம் திளைக்கும் கடல்","வண்ணன் * மாமணி வண்ணன் எம் அண்ணல் *","வண்ணமே அன்றி வாய் உரையாதே"],0,"/media/recitation/PT.7.3.7.mp3"],[1575,1575,["ini eppAvam vandhu eydhum? sollIr *","emakku immaiyE aruL peRRamaiyAl * aDum","thuniyaith thIrththu inbamE tharuginRadhOr *","thORRath thonneRiyai ** vaiyam thozhappaDum","muniyai vAnavarAl vaNangkappaDum","muththinaip * paththar thAm nugarginRadhOr","kaniyai * kAdhal seydhu en uLLam koNDa","kaLvanai * inRu kaNDu koNDEnE"],["இனி எப்பாவம் வந்து எய்தும்? சொல்லீர் *","எமக்கு இம்மையே அருள் பெற்றமையால் * அடும்","துனியைத் தீர்த்து இன்பமே தருகின்றதோர் *","தோற்றத் தொன்னெறியை ** வையம் தொழப்படும்","முனியை வானவரால் வணங்கப்படும்","முத்தினைப் * பத்தர் தாம் நுகர்கின்றதோர்","கனியை * காதல் செய்து என் உள்ளம் கொண்ட","கள்வனை * இன்று கண்டு கொண்டேனே"],0,"/media/recitation/PT.7.3.8.mp3"],[1576,1576,["en seygEn aDiyEn? uraiyIr * idhaRku","enRum en manaththE irukkum pugazh *","thanjchai ALiyaip pon peyarOn * nenjcham","anRu iDan