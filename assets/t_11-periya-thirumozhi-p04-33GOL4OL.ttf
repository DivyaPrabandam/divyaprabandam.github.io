[[[1048,1048,["** vAnavar thanggaL sindhai pOla * en nenjchamE! inidhu uvandhu * mA thava","mAnavar thanggaL sindhai * amarndhu uRaiginRa endhai **","kAnavar iDu kAr agil pugai * Onggu vEngkaDam mEvi * mAN kuRaL","Ana andhaNaRku * inRu aDimaith thozhil pUNDAyE"],["** வானவர் தங்கள் சிந்தை போல * என் நெஞ்சமே! இனிது உவந்து * மா தவ","மானவர் தங்கள் சிந்தை * அமர்ந்து உறைகின்ற எந்தை **","கானவர் இடு கார் அகில் புகை * ஓங்கு வேங்கடம் மேவி * மாண் குறள்","ஆன அந்தணற்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.1.mp3"],[1049,1049,["uRavu suRRam enRu onRilA * oruvan ugandhavar thammai * maN misaip","piRaviyE keDuppAn * adhu kaNDu en nenjcham enbAy! **","kuRavar mAdhargaLODu * vaNDu kuRinjchi maruL isai pADum * vEngkaDaththu","aRava nAyagaRku * inRu aDimaith thozhil pUNDAyE"],["உறவு சுற்றம் என்று ஒன்றிலா * ஒருவன் உகந்தவர் தம்மை * மண் மிசைப்","பிறவியே கெடுப்பான் * அது கண்டு என் நெஞ்சம் என்பாய்! **","குறவர் மாதர்களோடு * வண்டு குறிஞ்சி மருள் இசை பாடும் * வேங்கடத்து","அறவ நாயகற்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.2.mp3"],[1050,1050,["iNDai Ayina koNDu * thoNDargaL EththuvAr uRavODum * vAniDaik","koNDu pOy iDavum * adhu kaNDu en nenjcham enbAy! **","vaNDu vAzh vaDavEngkaDa malai * kOyil koNDu adhanODum * mImisai","aNDam ANDu iruppARku * aDimaith thozhil pUNDAyE"],["இண்டை ஆயின கொண்டு * தொண்டர்கள் ஏத்துவார் உறவோடும் * வானிடைக்","கொண்டு போய் இடவும் * அது கண்டு என் நெஞ்சம் என்பாய்! **","வண்டு வாழ் வடவேங்கட மலை * கோயில் கொண்டு அதனோடும் * மீமிசை","அண்டம் ஆண்டு இருப்பாற்கு * அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.3.mp3"],[1051,1051,["pAviyAdhu seydhAy en nenjchamE! * paNDu thoNDu seydhArai * maNmisai","mEvi ATkoNDu pOy * visumbu ERa vaikkum endhai **","kOvi nAyagan koNDal undhuyar * vEngkaDa malai ANDu * vAnavar","AviyAy iruppARku * aDimaith thozhil pUNDAyE"],["பாவியாது செய்தாய் என் நெஞ்சமே! * பண்டு தொண்டு செய்தாரை * மண்மிசை","மேவி ஆட்கொண்டு போய் * விசும்பு ஏற வைக்கும் எந்தை **","கோவி நாயகன் கொண்டல் உந்துயர் * வேங்கட மலை ஆண்டு * வானவர்","ஆவியாய் இருப்பாற்கு * அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.4.mp3"],[1052,1052,["ponggu pOdhiyum piNDiyum uDaip * buththar nOnbiyar paLLiyuL uRai *","thanggaL dhEvarum thAnggaLumE Aga * en nenjcham enbAy! **","enggum vAnavar dhAnavar niRaindhu Eththum * vEngkaDam mEvi ninRaruL *","angkaN nAyagaRku * inRaDimaith thozhil pUNDAyE"],["பொங்கு போதியும் பிண்டியும் உடைப் * புத்தர் நோன்பியர் பள்ளியுள் உறை *","தங்கள் தேவரும் தாங்களுமே ஆக * என் நெஞ்சம் என்பாய்! **","எங்கும் வானவர் தானவர் நிறைந்து ஏத்தும் * வேங்கடம் மேவி நின்றருள் *","அங்கண் நாயகற்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.5.mp3"],[1053,1053,["thuvari ADaiyar maTTaiyar * samaN thoNDargaL maNDi uNDu pinnarum *","thamarum thAnggaLumE thaDikka * en nenjcham enbAy! **","kavari mAkkaNam sErum * vEngkaDam kOyil koNDa kaNNAr visumbiDai *","amara nAyagaRku * inRu aDimaith thozhil pUNDAyE"],["துவரி ஆடையர் மட்டையர் * சமண் தொண்டர்கள் மண்டி உண்டு பின்னரும் *","தமரும் தாங்களுமே தடிக்க * என் நெஞ்சம் என்பாய்! **","கவரி மாக்கணம் சேரும் * வேங்கடம் கோயில் கொண்ட கண்ணார் விசும்பிடை *","அமர நாயகற்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.6.mp3"],[1054,1054,["tharukkinAl samaN seydhu * sORu thaNthayirinAl thiraLai * miDaRRiDai","nerukkuvAr alakkaN * adhu kaNDu en nenjcham enbAy! **","maruTkaL vaNDugaL pADum * vEngkaDam kOyil koNDu adhanODum * vAniDai","arukkan mEvi niRpARku * aDimaith thozhil pUNDAyE"],["தருக்கினால் சமண் செய்து * சோறு தண்தயிரினால் திரளை * மிடற்றிடை","நெருக்குவார் அலக்கண் * அது கண்டு என் நெஞ்சம் என்பாய்! **","மருட்கள் வண்டுகள் பாடும் * வேங்கடம் கோயில் கொண்டு அதனோடும் * வானிடை","அருக்கன் மேவி நிற்பாற்கு * அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.7.mp3"],[1055,1055,["sEyan aNiyan siRiyan periyan enbadhum * silar pEsak kETTirun","dhE * en nenjcham enbAy! * enakku onRu sollAdhE **","vEygaL ninRu veNmuththamE sori * vEngkaDa malai kOyil mEviya *","Ayar nAyagaRku * inRu aDimaith thozhil pUNDAyE"],["சேயன் அணியன் சிறியன் பெரியன் என்பதும் * சிலர் பேசக் கேட்டிருந்","தே * என் நெஞ்சம் என்பாய்! * எனக்கு ஒன்று சொல்லாதே **","வேய்கள் நின்று வெண்முத்தமே சொரி * வேங்கட மலை கோயில் மேவிய *","ஆயர் நாயகற்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.8.mp3"],[1056,1056,["kUDi ADi uraiththadhE uraiththAy * en nenjcham enbAy! thuNindhu kEL *","pADi ADip palarum * paNindhu Eththik kANgilA **","ADu thAmaraiyOnum Isanum * amarar kOnum ninRu Eththum * vEngkaDaththu","ADu kUththanukku * inRu aDimaith thozhil pUNDAyE"],["கூடி ஆடி உரைத்ததே உரைத்தாய் * என் நெஞ்சம் என்பாய்! துணிந்து கேள் *","பாடி ஆடிப் பலரும் * பணிந்து ஏத்திக் காண்கிலா **","ஆடு தாமரையோனும் ஈசனும் * அமரர் கோனும் நின்று ஏத்தும் * வேங்கடத்து","ஆடு கூத்தனுக்கு * இன்று அடிமைத் தொழில் பூண்டாயே"],0,"/media/recitation/PT.2.1.9.mp3"],[1057,1057,["** minnu mAmugil mEvu * thaNthiruvEngkaDa malai kOyil mEviya *","annamAy nigazhndha * amarar perumAnai **","kanni mAmadhiL manggaiyar kalikanRi * inthamizhAl uraiththa * im","mannu pADal vallArkku * iDam Agum vAn ulagE"],["** மின்னு மாமுகில் மேவு * தண்திருவேங்கட மலை கோயில் மேவிய *","அன்னமாய் நிகழ்ந்த * அமரர் பெருமானை **","கன்னி மாமதிள் மங்கையர் கலிகன்றி * இன்தமிழால் உரைத்த * இம்","மன்னு பாடல் வல்லார்க்கு * இடம் ஆகும் வான் உலகே"],0,"/media/recitation/PT.2.1.10.mp3"]],[[1058,1058,["** kAsai ADai mUDi ODik * kAdhal seydhAn avan Ur *","nAsamAga namba valla * nambi namperumAn **","vEyin anna thOL maDavAr * veNNey uNDAn ivan enRu *","Esa ninRa emperumAn * evvuL kiDandhAnE"],["** காசை ஆடை மூடி ஓடிக் * காதல் செய்தான் அவன் ஊர் *","நாசமாக நம்ப வல்ல * நம்பி நம்பெருமான் **","வேயின் அன்ன தோள் மடவார் * வெண்ணெய் உண்டான் இவன் என்று *","ஏச நின்ற எம்பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.1.mp3"],[1059,1059,["thaiyalAL mEl kAdhal seydha * dhAnavan vAL arakkan *","poy ilAdha pon muDigaL * onbadhODu onRum ** anRu","seydha vempOr thannil * anggOr senjcharaththAl uruLa *","eydha endhai emperumAn * evvuL kiDandhAnE"],["தையலாள் மேல் காதல் செய்த * தானவன் வாள் அரக்கன் *","பொய் இலாத பொன் முடிகள் * ஒன்பதோடு ஒன்றும் ** அன்று","செய்த வெம்போர் தன்னில் * அங்கோர் செஞ்சரத்தால் உருள *","எய்த எந்தை எம்பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.2.mp3"],[1060,1060,["muṉ or tūtu * vāṉarattiṉ vāyil mŏzhintu * arakkaṉ","maṉ ūr taṉṉai * vāl̤iyiṉāl māl̤a muṉintu ** avaṉe","piṉ or tūtu * āti maṉṉarkku āki pĕrunilattār *","iṉṉār tūtaṉ ĕṉa niṉṟāṉ * ĕvvul̤ kiṭantāṉe-"],["முன் ஓர் தூது * வானரத்தின் வாயில் மொழிந்து * அரக்கன்","மன் ஊர் தன்னை * வாளியினால் மாள முனிந்து ** அவனே","பின் ஓர் தூது * ஆதி மன்னர்க்கு ஆகி பெருநிலத்தார் *","இன்னார் தூதன் என நின்றான் * எவ்வுள் கிடந்தானே"],1,"/media/recitation/PT.2.2.3.mp3"],[1061,1061,["pandhaNaindha melviralAL * pAvai than kAraNaththAl *","venthiRal ERu Ezhum * venRa vEndhan viripugazh sEr **","nandhan maindhanAga Agum * nambi namperumAn *","endhai thandhai tham perumAn * evvuL kiDandhAnE"],["பந்தணைந்த மெல்விரலாள் * பாவை தன் காரணத்தால் *","வெந்திறல் ஏறு ஏழும் * வென்ற வேந்தன் விரிபுகழ் சேர் **","நந்தன் மைந்தனாக ஆகும் * நம்பி நம்பெருமான் *","எந்தை தந்தை தம் பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.4.mp3"],[1062,1062,["pAlanAgi njAlam Ezhum uNDu * paNDu Alilai mEl *","sAla nALum paLLi koLLum * thAmaraik kaNNan eNNil **","nIlamAr vaNDuNDu vAzhum * neydhal anthaN kazhani *","Ela nARum paimpuRavil * evvuL kiDandhAnE"],["பாலனாகி ஞாலம் ஏழும் உண்டு * பண்டு ஆலிலை மேல் *","சால நாளும் பள்ளி கொள்ளும் * தாமரைக் கண்ணன் எண்ணில் **","நீலமார் வண்டுண்டு வாழும் * நெய்தல் அந்தண் கழனி *","ஏல நாறும் பைம்புறவில் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.5.mp3"],[1063,1063,["sOththa nambi enRu * thoNDar miNDith thoDarndhu azhaikkum *","Aththa nambi sengkaN nambi * Agilum dhEvarkku ellAm **","mUththa nambi mukkaNambi enRu * munivar thozhudhu","Eththum * nambi emperumAn * evvuL kiDandhAnE"],["சோத்த நம்பி என்று * தொண்டர் மிண்டித் தொடர்ந்து அழைக்கும் *","ஆத்த நம்பி செங்கண் நம்பி * ஆகிலும் தேவர்க்கு எல்லாம் **","மூத்த நம்பி முக்கணம்பி என்று * முனிவர் தொழுது","ஏத்தும் * நம்பி எம்பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.6.mp3"],[1064,1064,["thinggaL appu vAn eri kAlAgi * thisai muganAr *","thanggaL appan sAmi appan * pAgaththu irundha ** vaNDuN","thonggal appu nILmuDiyAn * sUzh kazhal sUDa ninRa *","enggaL appan emperumAn * evvuL kiDandhAnE"],["திங்கள் அப்பு வான் எரி காலாகி * திசை முகனார் *","தங்கள் அப்பன் சாமி அப்பன் * பாகத்து இருந்த ** வண்டுண்","தொங்கல் அப்பு நீள்முடியான் * சூழ் கழல் சூட நின்ற *","எங்கள் அப்பன் எம்பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.7.mp3"],[1065,1065,["munivan mUrththi mUvarAgi * vEdham viriththu uraiththa","punidhan * pUvai vaNNan aNNal * puNNiyan viNNavar kOn **","thaniyan sEyan thAn oruvan Agilum * than aDiyArkku","iniyan * endhai emperumAn * evvuL kiDandhAnE"],["முனிவன் மூர்த்தி மூவராகி * வேதம் விரித்து உரைத்த","புனிதன் * பூவை வண்ணன் அண்ணல் * புண்ணியன் விண்ணவர் கோன் **","தனியன் சேயன் தான் ஒருவன் ஆகிலும் * தன் அடியார்க்கு","இனியன் * எந்தை எம்பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.8.mp3"],[1066,1066,["pandhirukkum melviralAL * pAvai panimalarAL *","vandhirukkum mArvan * nIlamEni maNivaNNan **","andharaththil vAzhum * vAnOr nAyaganAy amaindha *","indhiraRkum tham perumAn * evvuL kiDandhAnE"],["பந்திருக்கும் மெல்விரலாள் * பாவை பனிமலராள் *","வந்திருக்கும் மார்வன் * நீலமேனி மணிவண்ணன் **","அந்தரத்தில் வாழும் * வானோர் நாயகனாய் அமைந்த *","இந்திரற்கும் தம் பெருமான் * எவ்வுள் கிடந்தானே"],0,"/media/recitation/PT.2.2.9.mp3"],[1067,1067,["** iNDai koNDu thoNDar Eththa * evvuL kiDandhAnai *","vaNDu pADum paimpuRavin * manggaiyar kOn kaliyan **","koNDa sIrAl thaNthamizh sey mAlai * Iraindhum vallAr *","aNDam ALvadhu ANai * anREl ALvar amarulagE"],["** இண்டை கொண்டு தொண்டர் ஏத்த * எவ்வுள் கிடந்தானை *","வண்டு பாடும் பைம்புறவின் * மங்கையர் கோன் கலியன் **","கொண்ட சீரால் தண்தமிழ் செய் மாலை * ஈரைந்தும் வல்லார் *","அண்டம் ஆள்வது ஆணை * அன்றேல் ஆள்வர் அமருலகே"],0,"/media/recitation/PT.2.2.10.mp3"]],[[1068,1068,["** viRperu vizhavum kanjchanum mallum * vEzhamum pAganum vIzha *","seRRavan thannai puram eri seydha * sivan uRu thuyar kaLai dhEvai **","paRRalar vIyak kOl kaiyil koNDu * pArththan than thEr mun ninRAnai *","chiRRavai paNiyAl muDi thuRandhAnaith * thiruvallikkENik kaNDEnE"],["** விற்பெரு விழவும் கஞ்சனும் மல்லும் *","வேழமும் பாகனும் வீழ *","செற்றவன் தன்னை புரம் எரி செய்த *","சிவன் உறு துயர் களை தேவை **","பற்றலர் வீயக் கோல் கையில் கொண்டு *","பார்த்தன் தன் தேர் முன் நின்றானை *","சிற்றவை பணியால் முடி துறந்தானைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.1.mp3"],[1069,1069,["** vEdhaththai vEdhaththin suvaip payanai * vizhumiya munivar vizhunggum *","kOdhil inkaniyai nandhanAr kaLiRRaik * kuvalayaththOr thozhudhu Eththum **","Adhiyai amudhai ennai ALuDai appanai * oppavar illA","mAdhargaL vAzhum * mADa mA mayilaith * thiruvallikkENik kaNDEnE"],["** வேதத்தை வேதத்தின் சுவைப் பயனை *","விழுமிய முனிவர் விழுங்கும் *","கோதில் இன்கனியை நந்தனார் களிற்றைக் *","குவலயத்தோர் தொழுது ஏத்தும் **","ஆதியை அமுதை என்னை ஆளுடை அப்பனை *","ஒப்பவர் இல்லா","மாதர்கள் வாழும் * மாட மா மயிலைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.2.mp3"],[1070,1070,["vanjchanai seyyath thAy uruvAgi * vandha pEy alaRi maN sEra *","nanjchamar mulaiyUDu uyir sega uNDa * nAdhanaith dhAnavar kURRai **","vinjchai vAnavar sAraNar siththar * viyanthudhi seyyap peN uruvAgi *","anjchuvai amudham anRu aLiththAnaith * thiruvallikkENik kaNDEnE"],["வஞ்சனை செய்யத் தாய் உருவாகி *","வந்த பேய் அலறி மண் சேர *","நஞ்சமர் முலையூடு உயிர் செக உண்ட *","நாதனைத் தானவர் கூற்றை **","விஞ்சை வானவர் சாரணர் சித்தர் *","வியந்துதி செய்யப் பெண் உருவாகி *","அஞ்சுவை அமுதம் அன்று அளித்தானைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.3.mp3"],[1071,1071,["indhiranukku enRu AyargaL eDuththa * ezhil vizhavil pazha naDai sey *","mandhira vidhiyil pUsanai peRAdhu * mazhai pozhindhiDath thaLarndhu ** Ayar","enthammODu ina Anirai thaLarAmal * emperumAn! aruL enna *","andhamil varaiyAl mazhai thaDuththAnaith * thiruvallikkENik kaNDEnE"],["இந்திரனுக்கு என்று ஆயர்கள் எடுத்த *","எழில் விழவில் பழ நடை செய் *","மந்திர விதியில் பூசனை பெறாது *","மழை பொழிந்திடத் தளர்ந்து ** ஆயர்","எந்தம்மோடு இன ஆநிரை தளராமல் *","எம்பெருமான்! அருள் என்ன *","அந்தமில் வரையால் மழை தடுத்தானைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.4.mp3"],[1072,1072,["in thuNaip padhumaththu alarmagaL thanakkum inban * naRpuvi thanakku iRaivan *","than thuNai Ayar pAvai nappinnai thanakku iRai * maRRaiyOrkku ellAm","van thuNai ** panjcha pANDavarkkAgi vAyurai thUdhu senRu * iyanggum","en thuNai * endhai thandhai thammAnaith * thiruvallikkENik kaNDEnE"],["இன் துணைப் பதுமத்து அலர்மகள் தனக்கும் இன்பன் *","நற்புவி தனக்கு இறைவன் *","தன் துணை ஆயர் பாவை நப்பின்னை தனக்கு இறை *","மற்றையோர்க்கு எல்லாம்","வன் துணை ** பஞ்ச பாண்டவர்க்காகி வாயுரை","தூது சென்று * இயங்கும்","என் துணை * எந்தை தந்தை தம்மானைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.5.mp3"],[1073,1073,["andhagan siRuvan arasar tham arasaRku iLaiyavan * aNiyizhaiyaich senRu *","enthamakku urimai sey enath thariyAdhu * emperumAn! aruL enna **","sandhamal kuzhalAL alakkaN nURRuvar tham * peNDirum eydhi nUl izhappa *","indhiran siRuvan thEr mun ninRAnaith * thiruvallikkENik kaNDEnE"],["அந்தகன் சிறுவன் அரசர் தம் அரசற்கு","இளையவன் * அணியிழையைச் சென்று *","எந்தமக்கு உரிமை செய் எனத் தரியாது *","எம்பெருமான்! அருள் என்ன **","சந்தமல் குழலாள் அலக்கண் நூற்றுவர் தம் *","பெண்டிரும் எய்தி நூல் இழப்ப *","இந்திரன் சிறுவன் தேர் முன் நின்றானைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.6.mp3"],[1074,1074,["** barathanum thambi chaththurukkananum * ilakkumanODu maithiliyum *","iravu nanpagalum thudhi seyya ninRa * irAvaNAndhaganai emmAnai **","kuravamE kamazhum kuLir pozhilUDu * kuyiloDu mayilgaL ninRAla *","iraviyin kadhirgaL nuzhaidhal seydhaRiyAth * thiruvallikkENik kaNDEnE"],["** பரதனும் தம்பி சத்துருக்கனனும் *","இலக்குமனோடு மைதிலியும் *","இரவு நன்பகலும் துதி செய்ய நின்ற *","இராவணாந்தகனை எம்மானை **","குரவமே கமழும் குளிர் பொழிலூடு *","குயிலொடு மயில்கள் நின்றால *","இரவியின் கதிர்கள் நுழைதல் செய்தறியாத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.7.mp3"],[1075,1075,["** paLLiyil Odhi vandha than siRuvan * vAyil Or Ayira nAmam *","oLLiyavAgip pOdha Anggu adhanukku * onRum Or poRuppilan Agi **","piLLaiyaich sIRi veguNDu thUN puDaippap * piRai eyiRRanal vizhi pEzhvAy *","theLLiya singgamAgiya dhEvaith * thiruvallikkENik kaNDEnE"],["** பள்ளியில் ஓதி வந்த தன் சிறுவன் *","வாயில் ஓர் ஆயிர நாமம் *","ஒள்ளியவாகிப் போத ஆங்கு அதனுக்கு *","ஒன்றும் ஓர் பொறுப்பிலன் ஆகி **","பிள்ளையைச் சீறி வெகுண்டு தூண் புடைப்பப் *","பிறை எயிற்றனல் விழி பேழ்வாய் *","தெள்ளிய சிங்கமாகிய தேவைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.8.mp3"],[1076,1076,["** mIn amar poygai nAL malar koyvAn * vETkaiyinODu senRu izhindha *","kAn amar vEzham kai eDuththu alaRak * karA adhan kAlinaik kadhuva **","Anaiyin thuyaram thIrap puL Urndhu * senRu ninRu Azhi thoTTAnai *","thEn amar sOlai mADa mA mayilaith * thiruvallikkENik kaNDEnE"],["** மீன் அமர் பொய்கை நாள் மலர் கொய்வான் *","வேட்கையினோடு சென்று இழிந்த *","கான் அமர் வேழம் கை எடுத்து அலறக் *","கரா அதன் காலினைக் கதுவ **","ஆனையின் துயரம் தீரப் புள் ஊர்ந்து *","சென்று நின்று ஆழி தொட்டானை *","தேன் அமர் சோலை மாட மா மயிலைத் *","திருவல்லிக்கேணிக் கண்டேனே"],0,"/media/recitation/PT.2.3.9.mp3"],[1077,1077,["** mannu thaNpozhilum vAviyum madhiLum * mADa mALigaiyum maNDapamum *","thennan thoNDaiyar kOn seydha nal mayilaith * thiruvallikkENi ninRAnai **","kanni nanmADa manggaiyar thalaivan * kAmaru sIrk kalikanRi *","sonna sol mAlai paththuDan vallAr * sugam inidhALvar vAn ulagE"],["** மன்னு தண்பொழிலும் வாவியும் மதிளும் *","மாட மாளிகையும் மண்டபமும் *","தென்னன் தொண்டையர் கோன் செய்த நல் மயிலைத் *","திருவல்லிக்கேணி நின்றானை **","கன்னி நன்மாட மங்கையர் தலைவன் *","காமரு சீர்க் கலிகன்றி *","சொன்ன சொல் மாலை பத்துடன் வல்லார் *","சுகம் இனிதாள்வர் வானுலகே"],0,"/media/recitation/PT.2.3.10.mp3"]],[[1078,1078,["** anRAyar kulak koDiyODu * aNimAmalar manggaiyoDu anbaLavi * avuNarkku","enthAnum irakkam ilAdhavanukku * uRaiyum iDam Avadhu ** irumpozhil sUzh","nanRAya punal naRaiyUr thiruvAli kuDandhai * thaDam thigazh kOval nagar *","ninRAn irundhAn kiDandhAn naDandhARku iDam * mAmalai Avadhu nIrmalaiyE"],["** அன்றாயர் குலக் கொடியோடு * அணிமாமலர்","மங்கையொடு அன்பளவி * அவுணர்க்கு","என்தானும் இரக்கம் இலாதவனுக்கு * உறையும்","இடம் ஆவது ** இரும்பொழில் சூழ்","நன்றாய புனல் நறையூர் திருவாலி குடந்தை *","தடம் திகழ் கோவல் நகர் *","நின்றான் இருந்தான் கிடந்தான் நடந்தாற்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.1.mp3"],[1079,1079,["kāṇṭā vaṉam ĕṉpatu or kāṭu * amararkku araiyaṉṉatu kaṇṭu avaṉ niṟka * muṉe","mūṇṭu ār azhal uṇṇa muṉintatuvum atu aṉṟiyum * muṉ ulakam pŏṟai tīrttu **","āṇṭāṉ avuṇaṉ-avaṉ mārvu-akalam * ukirāl vakir āka muṉintu * ariyāy","nīṇṭāṉ kuṟal̤ āki nimirntavaṉukku iṭam * mā malai āvatu-nīrmalaiye-"],["காண்டா வனம் என்பது ஓர் காடு * அமரர்க்கு அரையன்னது கண்டு அவன் நிற்க * முனே","மூண்டு ஆர் அழல் உண்ண முனிந்ததுவும் அது அன்றியும் * முன் உலகம் பொறை தீர்த்து **","ஆண்டான் அவுணன் அவன் மார்வு அகலம் * உகிரால் வகிர் ஆக முனிந்து * அரியாய்","நீண்டான் குறள் ஆகி நிமிர்ந்தவனுக்கு இடம் * மா மலை ஆவது நீர்மலையே"],1,"/media/recitation/PT.2.4.2.mp3"],[1080,1080,["alamannum aDal suri sanggam eDuththu * aDal AzhiyinAl aNiyAr uruvil *","pulamannu vaDam punai konggaiyinAL * poRai thIra munAL aDuvAL amaril **","pala mannar paDach suDar Azhiyinaip * pagalOn maRaiyap paNi koNDu aNi sEr *","nila mannanumAy ulagu ANDavanukku iDam * mAmalai Avadhu nIrmalaiyE"],["அலமன்னும் அடல் சுரி சங்கம் எடுத்து *","அடல் ஆழியினால் அணியார் உருவில் *","புலமன்னு வடம் புனை கொங்கையினாள் *","பொறை தீர முனாள் அடுவாள் அமரில் **","பல மன்னர் படச் சுடர் ஆழியினைப் *","பகலோன் மறையப் பணி கொண்டணி சேர் *","நில மன்னனுமாய் உலகாண்டவனுக்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.3.mp3"],[1081,1081,["thAnggAdhadhor ALariyAy * avuNan thanai vIDa munindhu avanAl amarum *","pUngkOdhaiyar ponggeri mUzhga viLaiththu adhuvanRiyum * venRi koL vAL amaril **","pAnggAga mun aivaroDu anbaLavip * padhiRRaindhu iraTTip paDai vEndhar paDa *","nInggAch cheruvil niRai kAththavanukku iDam * mAmalai Avadhu nIrmalaiyE"],["தாங்காததொர் ஆளரியாய் * அவுணன் தனை","வீட முனிந்து அவனால் அமரும் *","பூங்கோதையர் பொங்கெரி மூழ்க விளைத்து அதுவன்றியும் *","வென்றி கொள் வாள் அமரில் **","பாங்காக முன் ஐவரொடு அன்பளவிப் *","பதிற்றைந்து இரட்டிப் படை வேந்தர் பட *","நீங்காச் செருவில் நிறை காத்தவனுக்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.4.mp3"],[1082,1082,["mAlum kaDal Ara malaik kuvaDiTTu aNai kaTTi * varamburuva madhi sEr *","kOla madhiLAya ilanggai keDap * paDai thoTToru kAl amaril adhira **","kAlam idhu enRu ayan vALiyinAl * kadhir nILmuDi paththum aRuththamarum *","nIlamugil vaNNan emakku iRaivaRku iDam * mAmalai Avadhu nIrmalaiyE"],["மாலும் கடல் ஆர மலைக் குவடிட்டு அணை கட்டி *","வரம்புருவ மதி சேர் *","கோல மதிளாய இலங்கை கெடப் *","படை தொட்டொரு கால் அமரில் அதிர **","காலம் இது என்று அயன் வாளியினால் *","கதிர் நீள்முடி பத்தும் அறுத்தமரும் *","நீலமுகில் வண்ணன் எமக்கு இறைவற்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.5.mp3"],[1083,1083,["pArAr ulagum pani mAl varaiyum * kaDalum suDarum ivai uNDum * enakku","ArAdhena ninRavan emperumAn * alai nIr ulagukku arasAgiya ** ap","pErAnai munindha munikkaraiyan * piRar illai nunakkenum ellaiyinAn *","nIrAr pErAn neDumAl avanukku iDam * mAmalai Avadhu nIrmalaiyE"],["பாரார் உலகும் பனி மால் வரையும் *","கடலும் சுடரும் இவை உண்டும் * எனக்கு","ஆராதென நின்றவன் எம்பெருமான் *","அலை நீர் உலகுக்கு அரசாகிய ** அப்","பேரானை முனிந்த முனிக்கரையன் *","பிறர் இல்லை நுனக்கெனும் எல்லையினான் *","நீரார் பேரான் நெடுமால் அவனுக்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.6.mp3"],[1084,1084,["pugarAr uruvAgi munindhavanaip * pugazh vIDa munindhu uyir uNDu * asuran","nagar Ayina pAzh paDa nAmam eRindhu adhuvanRiyum * venRi koL vAL avuNan **","pagarAdhavan Ayira nAmam * aDip paNiyAdhavanaip paNiyAl amaril *","nigar Ayavan nenjchu iDandhAn avanukku iDam * mAmalai Avadhu nIrmalaiyE"],["புகரார் உருவாகி முனிந்தவனைப் *","புகழ் வீட முனிந்து உயிர் உண்டு * அசுரன்","நகர் ஆயின பாழ் பட நாமம் எறிந்து அதுவன்றியும் *","வென்றி கொள் வாள் அவுணன் **","பகராதவன் ஆயிர நாமம் *","அடிப் பணியாதவனைப் பணியால் அமரில் *","நிகர் ஆயவன் நெஞ்சு இடந்தான் அவனுக்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.7.mp3"],[1085,1085,["pichchach siRu pIli piDiththu ulagil * piNam thin maDavAr avar pOl * angnganE","achcham ilar nAN ilarA thanmaiyAl * avar seygai veRuththu aNimAmalar thUy **","nachchi namanAr aDaiyAmai * namakku aruL sey ena uLkuzhaindhu ArvamoDu *","nichcham ninaivArkku aruL seyyumavaRku iDam * mAmalai Avadhu nIrmalaiyE"],["பிச்சச் சிறு பீலி பிடித்து உலகில் *","பிணம் தின் மடவார் அவர் போல் * அங்ஙனே","அச்சம் இலர் நாண் இலரா தன்மையால் *","அவர் செய்கை வெறுத்து அணிமாமலர் தூய் **","நச்சி நமனார் அடையாமை *","நமக்கு அருள் செய் என உள்குழைந்து ஆர்வமொடு *","நிச்சம் நினைவார்க்கு அருள் செய்யுமவற்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.8.mp3"],[1086,1086,["pEsum aLavanRu idhu vammin namar * piRar kETpadhan mun paNivAr vinaigaL *","nAsam adhu seydhiDum AdhanmaiyAl * adhuvE namadhu uyviDam nANmalar mEl **","vAsam aNi vaNDaRai paimpuRavil * manam aindhoDu naindhu uzhalvAr * madhiyil","nIsar avar senRu aDaiyAdhavanukku iDam * mAmalai Avadhu nIrmalaiyE"],["பேசும் அளவன்று இது வம்மின் நமர் *","பிறர் கேட்பதன் முன் பணிவார் வினைகள் *","நாசம் அது செய்திடும் ஆதன்மையால் *","அதுவே நமது உய்விடம் நாண்மலர் மேல் **","வாசம் அணி வண்டறை பைம்புறவில் *","மனம் ஐந்தொடு நைந்து உழல்வார் * மதியில்","நீசர் அவர் சென்று அடையாதவனுக்கு இடம் *","மாமலை ஆவது நீர்மலையே"],0,"/media/recitation/PT.2.4.9.mp3"],[1087,1087,["** neDumAl avan mEviya nIrmalai mEl * nilavum pugazh manggaiyar kOn * amaril","kaDamA kaLi yAnai vallAn * kaliyan oli sey thamizh mAlai vallArkku ** uDanE","viDumAl vinai * vENDiDil mEl ulagum eLidhAyiDum anRi ilanggoli sEr *","koDumA kaDal vaiyagam ANDu * madhikkuDai mannavarAy aDi kUDuvarE"],["** நெடுமால் அவன் மேவிய நீர்மலை மேல் *","நிலவும் புகழ் மங்கையர் கோன் * அமரில்","கடமா களி யானை வல்லான் * கலியன் ஒலி","செய் தமிழ் மாலை வல்லார்க்கு ** உடனே","விடுமால் வினை * வேண்டிடில் மேல் உலகும்","எளிதாயிடும் அன்றி இலங்கொலி சேர் *","கொடுமா கட