[[[3563,3563,["** dhEvimAr AvAr thirumagaL bUmi *","Eva maRRu amarar ATcheyvAr *","mEviya ulagam mUnRu avai ATchi *","vENDu vENDu uruvam nin uruvam **","pAviyEn thannai aDuginRa kamalak","kaNNadhOr * pavaLa vAy maNiyE! *","AviyE! amudhE! alai kaDal kaDaindha","appanE! * kANum ARu aruLAy"],["** தேவிமார் ஆவார் திருமகள் பூமி *","ஏவ மற்று அமரர் ஆட்செய்வார் *","மேவிய உலகம் மூன்று அவை ஆட்சி *","வேன்டு வேண்டு உருவம் நின் உருவம் **","பாவியேன் தன்னை அடுகின்ற கமலக்","கண்ணதோர் * பவள வாய் மணியே! *","ஆவியே! அமுதே! அலை கடல் கடைந்த","அப்பனே! * காணும் ஆறு அருளாய்"],0,"/media/recitation/TVM.8.1.1.mp3"],[3564,3564,["kANum ARu aruLAy enRu enRE kalanggik *","kaNNa nIr alamara * vinaiyEn","pENum ARu ellAm pENi * nin peyarE","pidhaRRum ARu aruL enakku andhO! **","kANum ARu aruLAy kAguththA! kaNNA! *","thoNDanEn kaRpagak kaniyE! *","pENuvAr amudhE! periya thaN punal sUzh *","peru nilam eDuththa pErALA!"],["காணும் ஆறு அருளாய் என்று என்றே கலங்கிக் *","கண்ண நீர் அலமர * வினையேன்","பேணும் ஆறு எல்லாம் பேணி * நின் பெயரே","பிதற்றும் ஆறு அருள் எனக்கு அந்தோ! **","காணும் ஆறு அருளாய் காகுத்தா! கண்ணா! *","தொண்டனேன் கற்பகக் கனியே! *","பேணுவார் அமுதே! பெரிய தண் புனல் சூழ் *","பெரு நிலம் எடுத்த பேராளா!"],0,"/media/recitation/TVM.8.1.2.mp3"],[3565,3565,["eDuththa pErALan nandhagOpan than *","in uyirch chiRuvanE! * asOdhaikku","aDuththa pEr inbak kula iLangkaLiRE! *","aDiyanEn periya ammAnE! **","kaDuththa pOr avuNan uDal iru piLavAk *","kai ugir ANDa engkaDalE! *","aDuththadhOr uruvAy inRu nI vArAy *","engnganam thERuvar umarE?"],["எடுத்த பேராளன் நந்தகோபன் தன் *","இன் உயிர்ச் சிறுவனே! * அசோதைக்கு","அடுத்த பேர் இன்பக் குல இளங்களிறே! *","அடியனேன் பெரிய அம்மானே! **","கடுத்த போர் அவுணன் உடல் இரு பிளவாக் *","கை உகிர் ஆண்ட எங்கடலே! *","அடுத்ததோர் உருவாய் இன்று நீ வாராய் *","எங்ஙனம் தேறுவர் உமரே?"],0,"/media/recitation/TVM.8.1.3.mp3"],[3566,3566,["umar ugandhu ugandha uruvam nin uruvam Agi *","un thanakku anbar AnAr *","avar ugandhu amarndha seygai un mAyai *","aRivonRum sanggippan vinaiyEn **","amar adhu paNNi agal iDam puDai sUzh *","aDu paDai aviththa ammAnE! *","amarar tham amudhE! asurargaL nanjchE! *","ennuDai AruyirEyO!"],["உமர் உகந்து உகந்த உருவம் நின் உருவம் ஆகி *","உன் தனக்கு அன்பர் ஆனார் *","அவர் உகந்து அமர்ந்த செய்கை உன் மாயை *","அறிவொன்றும் சங்கிப்பன் வினையேன் **","அமர் அது பண்ணி அகல் இடம் புடை சூழ் *","அடு படை அவித்த அம்மானே! *","அமரர் தம் அமுதே! அசுரர்கள் நஞ்சே! *","என்னுடை ஆருயிரேயோ!"],0,"/media/recitation/TVM.8.1.4.mp3"],[3567,3567,["AruyirEyO! agal iDam muzhudhum *","paDaiththu iDandhu uNDu umizhndhu aLandha *","pEruyirEyO! periya nIr paDaiththu *","anggu uRaindhu adhu kaDaindhu aDaiththu uDaiththa **","sIriyarEyO! manisarkkuth thEvar pOlath *","thEvarkkum thEvAvO! *","Or uyirEyO? ulaganggaTku ellAm *","unnai nAn enggu vandhu uRugO?"],["ஆருயிரேயோ! அகல் இடம் முழுதும் *","படைத்து இடந்து உன்டு உமிழ்ந்து அளந்த *","பேருயிரேயோ! பெரிய நீர் படைத்து *","அங்கு உறைந்து அது கடைந்து அடைத்து உடைத்த **","சீரியரேயோ! மனிசர்க்குத் தேவர் போலத் *","தேவர்க்கும் தேவாவோ! *","ஓர் உயிரேயோ? உலகங்கட்கு எல்லாம் *","உன்னை நான் எங்கு வந்து உறுகோ?"],0,"/media/recitation/TVM.8.1.5.mp3"],[3568,3568,["enggu vandhu uRugO? ennai ALvAnE! *","Ezh ulaganggaLum nIyE *","anggu avarkku amaiththa dheyvamum nIyE *","avaRRavai karumamum nIyE **","ponggiya puRam pAl poruL uLavElum *","avaiyumO nI innE AnAl *","manggiya aruvAm nErppamum nIyE *","vAn pulan iRandhadhum nIyE"],["எங்கு வந்து உறுகோ? என்னை ஆள்வானே! *","ஏழ் உலகங்களும் நீயே *","அங்கு அவர்க்கு அமைத்த தெய்வமும் நீயே *","அவற்றவை கருமமும் நீயே **","பொங்கிய புறம் பால் பொருள் உளவேலும் *","அவையுமோ நீ இன்னே ஆனால் *","மங்கிய அருவாம் நேர்ப்பமும் நீயே *","வான் புலன் இறந்ததும் நீயே"],0,"/media/recitation/TVM.8.1.6.mp3"],[3569,3569,["iRandhadhum nIyE edhirndhadhum nIyE *","nigazhvadhO nI innE AnAl *","siRandha nin thanmai adhu idhu udhu enRu *","aRivonRum sanggippan vinaiyEn **","kaRandha pAl neyyE! neyyin in suvaiyE! *","kaDalinuL amudhamE! * amudhil","piRandha in suvaiyE! suvai adhu payanE! *","pinnai thOL maNandha pEr AyA!"],["இறந்ததும் நீயே எதிர்ந்ததும் நீயே *","நிகழ்வதோ நீ இன்னே ஆனால் *","சிறந்த நின் தன்மை அது இது உது என்று *","அறிவொன்றும் சங்கிப்பன் வினையேன் **","கறந்த பால் நெய்யே! நெய்யின் இன் சுவையே! *","கடலினுள் அமுதமே! * அமுதில்","பிறந்த இன் சுவையே! சுவை அது பயனே! *","பின்னை தோள் மணந்த பேர் ஆயா!"],0,"/media/recitation/TVM.8.1.7.mp3"],[3570,3570,["maNandha pEr AyA! mAyaththAl muzhudhum *","valvinaiyEnai IrginRa *","guNanggaLai uDaiyAy! asurar vankaiyar","kURRamE! * koDiya puL uyarththAy! **","paNanggaL Ayiramum uDaiya painnAgap","paLLiyAy! * pARkaDal sErppA! *","vaNanggum ARu aRiyEn manamum vAsagamum *","seygaiyum yAnum nI thAnE"],["மணந்த பேர் ஆயா! மாயத்தால் முழுதும் *","வல்வினையேனை ஈர்கின்ற *","குணங்களை உடையாய்! அசுரர் வன்கையர்","கூற்றமே! * கொடிய புள் உயர்த்தாய்! **","பணங்கள் ஆயிரமும் உடைய பைந்நாகப்","பள்ளியாய்! * பாற்கடல் சேர்ப்பா! *","வணங்கும் ஆறு அறியேன் மனமும் வாசகமும் *","செய்கையும் யானும் நீ தானே"],0,"/media/recitation/TVM.8.1.8.mp3"],[3571,3571,["yAnum nI thAnE AvadhO meyyE *","aru naragu avaiyum nI AnAl *","vAn uyar inbam eydhil en? * maRRai","naragamE eydhil en? enilum **","yAnum nI thAnAyth theLidhoRum nanRum","anjchuvan * naragam nAn aDaidhal *","vAn uyar inbam manni vIRRirundhAy! *","aruLu nin thALgaLai enakkE"],["யானும் நீ தானே ஆவதோ மெய்யே *","அரு நரகு அவையும் நீ ஆனால் *","வான் உயர் இன்பம் எய்தில் என்? * மற்றை","நரகமே எய்தில் என்? எனிலும் **","யானும் நீ தானாய்த் தெளிதொறும் நன்றும்","அஞ்சுவன் * நரகம் நான் அடைதல் *","வான் உயர் இன்பம் மன்னி வீற்றிருந்தாய்! *","அருளு நின் தாள்களை எனக்கே"],0,"/media/recitation/TVM.8.1.9.mp3"],[3572,3572,["thALgaLai enakkE thalaith thalaich siRappath","thandha * pEr udhavik kaimmARA *","thOLgaLai Arath thazhuvi * en uyirai","aRa vilai seydhanan sOdhI! **","thOLgaL AyiraththAy! muDigaL AyiraththAy! *","thuNai malark kaNgaL AyiraththAy! *","thALgaL AyiraththAy! pErgaL AyiraththAy! *","thamiyanEn periya appanE!"],["தாள்களை எனக்கே தலைத் தலைச் சிறப்பத்","தந்த * பேர் உதவிக் கைம்மாறா *","தோள்களை ஆரத் தழுவி * என் உயிரை","அற விலை செய்தனன் சோதீ! **","தோள்கள் ஆயிரத்தாய்! முடிகள் ஆயிரத்தாய்! *","துணை மலர்க் கண்கள் ஆயிரத்தாய்! *","தாள்கள் ஆயிரத்தாய்! பேர்கள் ஆயிரத்தாய்! *","தமியனேன் பெரிய அப்பனே!"],0,"/media/recitation/TVM.8.1.10.mp3"],[3573,3573,["** periya appanaip piraman appanai *","uruththiran appanai * munivarkku","uriya appanai amarar appanai *","ulagukku Or thani appan thannai **","periya vaNkurugUr vaN saDakOpan *","pENina AyiraththuLLum *","uriya sol mAlai ivaiyum paththu ivaRRAl *","uyyalAm thoNDIr! nanggaTkE"],["** பெரிய அப்பனைப் பிரமன் அப்பனை *","உருத்திரன் அப்பனை * முனிவர்க்கு","உரிய அப்பனை அமரர் அப்பனை *","உலகுக்கு ஓர் தனி அப்பன் தன்னை **","பெரிய வண்குருகூர் வண் சடகோபன் *","பேணின ஆயிரத்துள்ளும் *","உரிய சொல் மாலை இவையும் பத்து இவற்றால் *","உய்யலாம் தொண்டீர்! நங்கட்கே"],0,"/media/recitation/TVM.8.1.11.mp3"]],[[3574,3574,["** nanggaL vari vaLai AyanggALO! *","nammuDai Edhalar munbu nANi *","nunggaTku yAn onRu uraikkum mARRam *","nOkkuginREn enggum kANa mATTEn **","sanggam sarindhana sAy izhandhEn *","thaDa mulai pon niRamAyth thaLarndhEn *","vengkaN paRavaiyin pAgan engkOn *","vEngkaDa vANaNai vENDich senRE"],["** நங்கள் வரி வளை ஆயங்காளோ! *","நம்முடை ஏதலர் முன்பு நாணி *","நுங்கட்கு யான் ஒன்று உரைக்கும் மாற்றம் *","நோக்குகின்றேன் எங்கும் காண மாட்டேன் **","சங்கம் சரிந்தன சாய் இழந்தேன் *","தட முலை பொன் நிறமாய்த் தளர்ந்தேன் *","வெங்கண் பறவையின் பாகன் எங்கோன் *","வேங்கட வாணணை வேன்டிச் சென்றே"],0,"/media/recitation/TVM.8.2.1.mp3"],[3575,3575,["vENDich senRu onRu peRugiRpAril *","ennuDaith thOzhiyar nunggaTkElum *","INDu idhu uraikkum paDiyai andhO! *","kANginRilEn iDarATTiyEn nAn **","kAN thagu thAmaraik kaNNan kaLvan *","viNNavar kOn nanggaL kOnaik kaNDAl *","INDiya sanggum niRaivum koLvAn *","eththanai kAlam iLaikkinREnE?"],["வேன்டிச் சென்று ஒன்று பெறுகிற்பாரில் *","என்னுடைத் தோழியர் நுங்கட்கேலும் *","ஈன்டு இது உரைக்கும் படியை அந்தோ! *","காண்கின்றிலேன் இடராட்டியேன் நான் **","காண் தகு தாமரைக் கண்ணன் கள்வன் *","விண்ணவர் கோன் நங்கள் கோனைக் கன்டால் *","ஈண்டிய சங்கும் நிறைவும் கொள்வான் *","எத்தனை காலம் இளைக்கின்றேனே?"],0,"/media/recitation/TVM.8.2.2.mp3"],[3576,3576,["kAlam iLaikkil allAl * vinaiyEn","nAn iLaikkinRilan kaNDu koNmin *","njAlam aRiyap pazhi sumandhEn *","nannudhalIr! ini nANith thAn en? **","nIla malar neDunjchOdhi sUzhndha *","nINDa mugil vaNNan kaNNan koNDa *","kOla vaLaiyoDu mAmai koLvAn *","eththanai kAlamum kUDach senRE"],["காலம் இளைக்கில் அல்லால் * வினையேன்","நான் இளைக்கின்றிலன் கண்டு கொண்மின் *","ஞாலம் அறியப் பழி சுமந்தேன் *","நன்னுதலீர்! இனி நாணித் தான் என்? **","நீல மலர் நெடுஞ்சோதி சூழ்ந்த *","நீண்ட முகில் வண்ணன் கண்ணன் கொண்ட *","கோல வளையொடு மாமை கொள்வான் *","எத்தனை காலமும் கூடச் சென்றே"],0,"/media/recitation/TVM.8.2.3.mp3"],[3577,3577,["kUDach senREn ini en koDukkEn? *","kOl vaLai nenjchath thoDakkam ellAm *","pADu aRRozhiya izhandhu vaigal *","pal vaLaiyAr mun parisu azhindhEn **","mADak koDi madhiL then kuLandhai *","vaN kuDapAl ninRa mAyak kUththan *","ADal paRavai uyarththa velpOr *","Azhi valavanai AdhariththE"],["கூடச் சென்றேன் இனி என் கொடுக்கேன்? *","கோல் வளை நெஞ்சத் தொடக்கம் எல்லாம் *","பாடு அற்றொழிய இழந்து வைகல் *","பல் வளையார் முன் பரிசு அழிந்தேன் **","மாடக் கொடி மதிள் தென் குளந்தை *","வண் குடபால் நின்ற மாயக் கூத்தன் *","ஆடல் பறவை உயர்த்த வெல்போர் *","ஆழி வலவனை ஆதரித்தே"],0,"/media/recitation/TVM.8.2.4.mp3"],[3578,3578,["Azhi valavanai Adharippum * Anggavan","nammil varavum ellAm *","thOzhiyargAL! nammuDaiyamE thAn? *","solluvadhO inggu ariyadhu thAn **","Uzhi thORUzhi oruvan Aga *","nanku uNarvArkkum uNaral AgA *","sUzhal uDaiya suDar koL Adhith *","thollai anjchOdhi ninaikkunggAlE"],["ஆழி வலவனை ஆதரிப்பும் * ஆங்கவன்","நம்மில் வரவும் எல்லாம் *","தோழியர்காள்! நம்முடையமே தான்? *","சொல்லுவதோ இங்கு அரியது தான் **","ஊழி தோறூழி ஒருவன் ஆக *","நன்கு உணர்வார்க்கும் உணரல் ஆகா *","சூழல் உடைய சுடர் கொள் ஆதித் *","தொல்லை அஞ்சோதி நினைக்குங்காலே"],0,"/media/recitation/TVM.8.2.5.mp3"],[3579,3579,["thollai anjchOdhi ninaikkunggAl * en","sol aLavu anRu imaiyOr thamakkum *","ellai ilAdhana kUzhppuch seyyum *","aththiRam niRka em mAmai koNDAn **","alli malarth thaN thuzhAyum thArAn *","Arkku iDugO inip pUsal? sollIr *","valli vaLa vayal sUzh kuDandhai *","mA malark kaN vaLarginRa mAlE"],["தொல்லை அஞ்சோதி நினைக்குங்கால் * என்","சொல் அளவு அன்று இமையோர் தமக்கும் *","எல்லை இலாதன கூழ்ப்புச் செய்யும் *","அத்திறம் நிற்க எம் மாமை கொண்டான் **","அல்லி மலர்த் தண் துழாயும் தாரான் *","ஆர்க்கு இடுகோ இனிப் பூசல்? சொல்லீர் *","வல்லி வள வயல் சூழ் குடந்தை *","மா மலர்க் கண் வளர்கின்ற மாலே"],0,"/media/recitation/TVM.8.2.6.mp3"],[3580,3580,["mAl ari kEsavan nAraNan * sImAdhavan","gOvindhan vaikundhan enRenRu *","olam iDa ennaip paNNi viTTiTTu *","onRum uruvum suvaDum kATTAn **","Ela malark kuzhal annaimIrgAL! *","ennuDaith thOzhiyargAL! en seygEn? *","kAlam pala senRum kANbadhu ANai *","unggaLODu enggaL iDai illaiyE"],["மால் அரி கேசவன் நாரணன் * சீமாதவன்","கோவிந்தன் வைகுந்தன் என்றென்று *","ஒலம் இட என்னைப் பண்ணி விட்டிட்டு *","ஒன்றும் உருவும் சுவடும் காட்டான் **","ஏல மலர்க் குழல் அன்னைமீர்காள்! *","என்னுடைத் தோழியர்காள்! என் செய்கேன்? *","காலம் பல சென்றும் காண்பது ஆணை *","உங்களோடு எங்கள் இடை இல்லையே"],0,"/media/recitation/TVM.8.2.7.mp3"],[3581,3581,["iDai illai yAn vaLarththa kiLigAL! *","pUvaigaLgAL! kuyilgAL! mayilgAL! *","uDaiya nam mAmaiyum sanggum nenjchum *","onRum ozhiya oTTAdhu koNDAn **","aDaiyum vaikundhamum pARkaDalum *","anjchana veRpum avai naNiya *","kaDai aRap pAsanggaL viTTa pinnai","anRi * avan avai kAN koDAnE"],["இடை இல்லை யான் வளர்த்த கிளிகாள்! *","பூவைகள்காள்! குயில்காள்! மயில்காள்! *","உடைய நம் மாமையும் சங்கும் நெஞ்சும் *","ஒன்றும் ஒழிய ஒட்டாது கொண்டான் **","அடையும் வைகுந்தமும் பாற்கடலும் *","அஞ்சன வெற்பும் அவை நணிய *","கடை அறப் பாசங்கள் விட்ட பின்னை","அன்றி * அவன் அவை காண் கொடானே"],0,"/media/recitation/TVM.8.2.8.mp3"],[3582,3582,["kAN koDuppAn allan Arkkum thannaik *","kai sey appAladhOr mAyam thannAl *","mAN kuRaL kOla vaDivu kATTi *","maNNum viNNum niRaiya malarndha **","sEN suDarth thOLgaL pala thazhaiththa *","dhEva pirARku en niRaivinODu *","nAN koDuththEn ini en koDukkEn? *","ennuDai nannudhal nanggaimIrgAL!"],["காண் கொடுப்பான் அல்லன் ஆர்க்கும் தன்னைக் *","கை செய் அப்பாலதோர் மாயம் தன்னால் *","மாண் குறள் கோல வடிவு காட்டி *","மண்ணும் விண்ணும் நிறைய மலர்ந்த **","சேண் சுடர்த் தோள்கள் பல தழைத்த *","தேவ பிராற்கு என் நிறைவினோடு *","நாண் கொடுத்தேன் இனி என் கொடுக்கேன்? *","என்னுடை நன்னுதல் நங்கைமீர்காள்!"],0,"/media/recitation/TVM.8.2.9.mp3"],[3583,3583,["ennuDai nannudhal nanggaimIrgAL! *","yAn inich seyvadhu en? en nenjchu ennai *","nin iDaiyEn allEn enRu nInggi *","nEmiyum sanggum iru kaik koNDu **","panneDunj chUzh suDar njAyiRRODu *","pAl madhi Endhi Or kOla nIla *","nanneDung kunRam varuvadhu oppAn *","nAL malarp pAdham aDaindhadhuvE"],["என்னுடை நன்னுதல் நங்கைமீர்காள்! *","யான் இனிச் செய்வது என்? என் நெஞ்சு என்னை *","நின் இடையேன் அல்லேன் என்று நீங்கி *","நேமியும் சங்கும் இரு கைக் கொண்டு **","பன்னெடுஞ் சூழ் சுடர் ஞாயிற்றோடு *","பால் மதி ஏந்தி ஓர் கோல நீல *","நன்னெடுங் குன்றம் வருவது ஒப்பான் *","நாள் மலர்ப் பாதம் அடைந்ததுவே"],0,"/media/recitation/TVM.8.2.10.mp3"],[3584,3584,["** pAdham aDaivadhan pAsaththAlE *","maRRa vanpAsanggaL muRRa viTTu *","kOdhil pugazhk kaNNan than aDi mEl *","vaN kurugUrch saDakOpan sonna **","thIdhil andhAdhi Or AyiraththuL *","ivaiyum Or paththu isaiyODum vallAr *","Adhum Or thIdhilar Agi * inggum anggum","ellAm amaivArgaL thAmE"],["** பாதம் அடைவதன் பாசத்தாலே *","மற்ற வன்பாசங்கள் முற்ற விட்டு *","கோதில் புகழ்க் கண்ணன் தன் அடி மேல் *","வண் குருகூர்ச் சடகோபன் சொன்ன **","தீதில் அந்தாதி ஓர் ஆயிரத்துள் *","இவையும் ஓர் பத்து இசையோடும் வல்லார் *","ஆதும் ஓர் தீதிலர் ஆகி * இங்கும் அங்கும்","எல்லாம் அமைவார்கள் தாமே"],0,"/media/recitation/TVM.8.2.11.mp3"]],[[3585,3585,["** anggum inggum * vAnavar thAnavar yAvarum *","enggum inaiyai enRu unnai * aRiya kilAdhu alaRRi **","anggam sErum * pU magaL maN magaL Ay magaL *","sanggu chakkarak kaiyavan enbar * saraNamE"],["** அங்கும் இங்கும் * வானவர் தானவர் யாவரும் *","எங்கும் இனையை என்று உன்னை * அறிய கிலாது அலற்றி **","அங்கம் சேரும் * பூ மகள் மண் மகள் ஆய் மகள் *","சங்கு சக்கரக் கையவன் என்பர் * சரணமே"],0,"/media/recitation/TVM.8.3.1.mp3"],[3586,3586,["saraNam Agiya * nAnmaRai nUlgaLum sArAdhE *","maraNam thORRam * vAn piNi mUppu enRu ivai mAyththOm **","karaNap pal paDai * paRRaRa ODum kanal Azhi *","araNath thiN paDai Endhiya * IsaRku ALAyE"],["சரணம் ஆகிய * நான்மறை நூல்களும் சாராதே *","மரணம் தோற்றம் * வான் பிணி மூப்பு என்று இவை மாய்த்தோம் **","கரணப் பல் படை * பற்றற ஓடும் கனல் ஆழி *","அரணத் திண் படை ஏந்திய * ஈசற்கு ஆளாயே"],0,"/media/recitation/TVM.8.3.2.mp3"],[3587,3587,["ALum ALAr * Azhiyum sanggum sumappAr thAm *","vALum villum koNDu * pin selvAr maRRu illai **","thALum thOLum * kaigaLai Arath thozhak kANEn *","nALum nALum nADuvan * aDiyEn njAlaththE"],["ஆளும் ஆளார் * ஆழியும் சங்கும் சுமப்பார் தாம் *","வாளும் வில்லும் கொண்டு * பின் செல்வார் மற்று இல்லை **","தாளும் தோளும் * கைகளை ஆரத் தொழக் காணேன் *","நாளும் நாளும் நாடுவன் * அடியேன் ஞாலத்தே"],0,"/media/recitation/TVM.8.3.3.mp3"],[3588,3588,["njAlam pOnagam paRRi * Or muRRA uru Agi *","Al ampEr ilai * annavasam seyyum ammAnE! **","kAlam pErvadhOr * kAr iruL Uzhi oththu uLadhAl * un","kOlam kAr ezhil * kANal uRRu Azhum koDiyERkE"],["ஞாலம் போனகம் பற்றி * ஓர் முற்றா உரு ஆகி *","ஆல் அம்பேர் இலை * அன்னவசம் செய்யும் அம்மானே! **","காலம் பேர்வதோர் * கார் இருள் ஊழி ஒத்து உளதால் * உன்","கோலம் கார் எழில் * காணல் உற்று ஆழும் கொடியேற்கே"],0,"/media/recitation/TVM.8.3.4.mp3"],[3589,3589,["koDi Ar mADak * kOLur agaththum puLingkuDiyum *","maDiyAdhu innE * nI thuyil mEvi magizhndhadhu thAn **","aDiyAr allal thavirththa asavO? * anREl ip","paDi thAn * nINDu thAviya asavO? * paNiyAyE"],["கொடி ஆர் மாடக் * கோளுர் அகத்தும் புளிங்குடியும் *","மடியாது இன்னே * நீ துயில் மேவி மகிழ்ந்தது தான் **","அடியார் அல்லல் தவிர்த்த அசவோ? * அன்றேல் இப்","படி தான் * நீண்டு தாவிய அசவோ? * பணியாயே"],0,"/media/recitation/TVM.8.3.5.mp3"],[3590,3590,["paNiyA amarar * paNivum paNbum thAmEyAm *","aNiyAr Azhiyum * sanggamum Endhumavar kANmin **","thaNiyA vennOy * ulagil thavirppAn * thiru nIla","maNiyAr mEniyODu * en manam sUzha varuvArE"],["பணியா அமரர் * பணிவும் பண்பும் தாமேயாம் *","அணியார் ஆழியும் * சங்கமும் ஏந்துமவர் காண்மின் **","தணியா வெந்நோய் * உலகில் தவிர்ப்பான் * திரு நீல","மணியார் மேனியோடு * என் மனம் சூழ வருவாரே"],0,"/media/recitation/TVM.8.3.6.mp3"],[3591,3591,["varuvAr selvAr * vaN parisAraththu irundha * en","thiru vAzh mArvaRku * en thiRam sollAr seyvadhu en? **","uruvAr chakkaram * sanggu sumandhu inggu ummODu *","oru pADu uzhalvAn * Or aDi yAnum uLan enRE"],["வருவார் செல்வார் * வண் பரிசாரத்து இருந்த * என்","திரு வாழ் மார்வற்கு * என் திறம் சொல்லார் செய்வது என்? **","உருவார் சக்கரம் * சங்கு சுமந்து இங்கு உம்மோடு *","ஒரு பாடு உழல்வான் * ஓர் அடி யானும் உளன் என்றே"],0,"/media/recitation/TVM.8.3.7.mp3"],[3592,3592,["enRE ennai * un ErAr kOlath thirundhu aDik kIzh *","ninRE ATcheyya * nI koNDu aruLa ninaippadhu thAn? **","kunREzh pArEzh * sUzh kaDal njAlam muzhu Ezhum *","ninRE thAviya * nIL kazhal Azhith thirumAlE!"],["என்றே என்னை * உன் ஏரார் கோலத் திருந்து அடிக் கீழ் *","நின்றே ஆட்செய்ய * நீ கொண்டு அருள நினைப்பது தான்? **","குன்றேழ் பாரேழ் * சூழ் கடல் ஞாலம் முழு ஏழும் *","நின்றே தாவிய * நீள் கழல் ஆழித் திருமாலே!"],0,"/media/recitation/TVM.8.3.8.mp3"],[3593,3593,["thirumAl! nAnmugan * senjchaDaiyAn enRivargaL * em","perumAn thanmaiyai * yAr aRigiRpAr? pEsi en? **","oru mA mudhalvA! * Uzhip pirAn! ennai ALuDai *","karu mA mEniyan enban * en kAdhal kalakkavE"],["திருமால்! நான்முகன் * செஞ்சடையான் என்றிவர்கள் * எம்","பெருமான் தன்மையை * யார் அறிகிற்பார்? பேசி என்? **","ஒரு மா முதல்வா! * ஊழிப் பிரான்! என்னை ஆளுடை *","கரு மா மேனியன் என்பன் * என் காதல் கலக்கவே"],0,"/media/recitation/TVM.8.3.9.mp3"],[3594,3594,["kalakkam illA * nal thava munivar karai kaNDOr *","thuLakkam illA * vAnavar ellAm thozhuvArgaL **","malakkam eydha * mA kaDal thannaik kaDaindhAnai *","ulakka nAm pugazh kiRpadhu * en seyvadhu? uraiyIrE"],["கலக்கம் இல்லா * நல் தவ முனிவர் கரை கண்டோர் *","துளக்கம் இல்லா * வானவர் எல்லாம் தொழுவார்கள் **","மலக்கம் எய்த * மா கடல் தன்னைக் கடைந்தானை *","உலக்க நாம் புகழ் கிற்பது * என் செய்வது? உரையீரே"],0,"/media/recitation/TVM.8.3.10.mp3"],[3595,3595,["** uraiyA vennOy thavira * aruL nIL muDiyAnai *","varai Ar mADa * mannu kurugUrch saDakOpan **","urai Ey sol thoDai * Or AyiraththuL ippaththum *","niraiyE vallAr * nIDulagaththup piRavArE"],["** உரையா வெந்நோய் தவிர * அருள் நீள் முடியானை *","வரை ஆர் மாட * மன்னு குருகூர்ச் சடகோபன் **","உரை ஏய் சொல் தொடை * ஓர் ஆயிரத்துள் இப்பத்தும் *","நிரையே வல்லார் * நீடுலகத்துப் பிறவாரே"],0,"/media/recitation/TVM.8.3.11.mp3"]],[[3596,3596,["** vAr kaDA aruvi yAnai mA malaiyin *","maruppiNaik kuvaDu iRuththu uruTTi *","Ur koL thiN pAgan uyir seguththu * aranggin","mallaraik konRu sUzh paraN mEl **","pOr kaDAvarasar puRakkiDa * mADa","mImisaik kanjchanaith thagarththa *","sIr koL siRRAyan thiruchchengkunRUril *","thiruchchiRRARu enggaL sel sArvE"],["** வார் கடா அருவி யானை மா மலையின் *","மருப்பிணைக் குவடு இறுத்து உருட்டி *","ஊர் கொள் திண் பாகன் உயிர் செகுத்து * அரங்கின்","மல்லரைக் கொன்று சூழ் பரண் மேல் **","போர் கடாவரசர் புறக்கிட * மாட","மீமிசைக் கஞ்சனைத் தகர்த்த *","சீர் கொள் சிற்றாயன் திருச்செங்குன்றூரில் *","திருச்சிற்றாறு எங்கள் செல் சார்வே"],0,"/media/recitation/TVM.8.4.1.mp3"],[3597,3597,["enggaL sel sArvu yAmuDai amudham *","imaiyavar appan en appan *","ponggu mUvulagum paDaiththu aLiththu azhikkum *","porundhu mUvuruvan em aruvan **","sengkayal ugaLum thEmpaNai puDai sUzh *","thiruchchengkunRUrth thiruchchiRRARu","anggu amarginRa * AdhiyAn allAl *","yAvar maRRu en amar thuNaiyE?"],["எங்கள் செல் சார்வு யாமுடை அமுதம் *","இமையவர் அப்பன் என் அப்பன் *","பொங்கு மூவுலகும் படைத்து அளித்து அழிக்கும் *","பொருந்து மூவுருவன் எம் அருவன் **","செங்கயல் உகளும் தேம்பணை புடை சூழ் *","திருச்செங்குன்றூர்த் திருச்சிற்றாறு","அங்கு அமர்கின்ற * ஆதியான் அல்லால் *","யாவர் மற்று என் அமர் துணையே?"],0,"/media/recitation/TVM.8.4.2.mp3"],[3598,3598,["en amar perumAn imaiyavar perumAn *","iru nilam iDandha emperumAn *","munnai valvinaigaL muzhudhu uDan mALa *","ennai ALginRa emperumAn **","then thisaikku aNi koL thiruchchengkunRUril *","thiruchchiRRARRangkarai mIpAl","ninRa emperumAn * aDi allAl charaN","ninaippilum * piRidhu illai enakkE"],["என் அமர் பெருமான் இமையவர் பெருமான் *","இரு நிலம் இடந்த எம்பெருமான் *","முன்னை வல்வினைகள் முழுது உடன் மாள *","என்னை ஆள்கின்ற எம்பெருமான் **","தென் திசைக்கு அணி கொள் திருச்செங்குன்றூரில் *","திருச்சிற்றாற்றங்கரை மீபால்","நின்ற எம்பெருமான் * அடி அல்லால் சரண்","நினைப்பிலும் * பிறிது இல்லை எனக்கே"],0,"/media/recitation/TVM.8.4.3.mp3"],[3599,3599,["piRidhu illai enakkup periya mUvulagum","niRaiyap * pEr uruvamAy nimirndha *","kuRiya mAN emmAn kurai kaDal kaDaindha *","kOla mANikkam en ammAn **","seRi kulai vAzhai kamugu thengkaNi sUzh *","thiruchchengkunRUrth thiruchchiRRARu","aRiya * meymmaiyE ninRa emperumAn *","aDi iNai alladhOr araNE"],["பிறிது இல்லை எனக்குப் பெரிய மூவுலகும்","நிறையப் * பேர் உருவமாய் நிமிர்ந்த *","குறிய மாண் எம்மான் குரை கடல் கடைந்த *","கோல மாணிக்கம் என் அம்மான் **","செறி குலை வாழை கமுகு தெங்கணி சூழ் *","திருச்செங்குன்றூர்த் திருச்சிற்றாறு","அறிய * மெய்ம்மையே நின்ற எம்பெருமான் *","அடி இணை அல்லதோர் அரணே"],0,"/media/recitation/TVM.8.4.4.mp3"],[3600,3600,["alladhOr araNum avanil vERu illai *","adhu poruL Agilum * avanai","alladhu en Avi amarndhu aNaikillAdhu *","AdhalAl avan uRaiginRa **","nalla nAnmaRaiyOr vELviyuL maDuththa *","naRum pugai visumboLi maRaikkum *","nalla nIL mADath thiruchchengkunRUril *","thiruchchiRRARu enakku nal araNE"],["அல்லதோர் அரணும் அவனில் வேறு இல்லை *","அது பொருள் ஆகிலும் * அவனை","அல்லது என் ஆவி அமர்ந்து அணைகில்லாது *","ஆதலால் அவன் உறைகின்ற **","நல்ல நான்மறையோர் வேள்வியுள் மடுத்த *","நறும் புகை விசும்பொளி மறைக்கும் *","நல்ல நீள் மாடத் திருச்செங்குன்றூரில் *","திருச்சிற்றாறு எனக்கு நல் அரணே"],0,"/media/recitation/TVM.8.4.5.mp3"],[3601,3601,["enakku nal araNai enadhu Aruyirai *","imaiyavar thandhai thAy thannai *","thanakkum than thanmai aRivu ariyAnaith *","thaDangkaDal paLLi ammAnai **","manak koL sIr mUvAyiravar * vaNsivanum","ayanum thAnum oppAr vAzh *","kanak koL thiN mADath thiruchchengkunRUril *","thiruchchiRRARu adhanuL kaNDEnE"],["எனக்கு நல் அரணை எனது ஆருயிரை *","இமையவர் தந்தை தாய் தன்னை *","தனக்கும் தன் தன்மை அறிவு அரியானைத் *","தடங்கடல் பள்ளி அம்மானை **","மனக் கொள் சீர் மூவாயிரவர் * வண்சிவனும்","அயனும் தானும் ஒப்பார் வாழ் *","கனக் கொள் திண் மாடத் திருச்செங்குன்றூரில் *","திருச்சிற்றாறு அதனுள் கண்டேனே"],0,"/media/recitation/TVM.8.4.6.mp3"],[3602,3602,["thiruchchengkunRUril thiruchchiRRARu adhanuL","kaNDa * aththiruvaDi enRum *","thiruch cheyya kamalak kaNNum sevvAyum *","sevvaDiyum seyya kaiyum **","thiruch cheyya kamala undhiyum seyya","kamala mArbum * seyya uDaiyum *","thiruch cheyya muDiyum Aramum paDaiyum *","thigazha en sindhai uLAnE"],["திருச்செங்குன்றூரில் திருச்சிற்றாறு அதனுள்","கண்ட * அத்திருவடி என்றும் *","திருச் செய்ய கமலக் கண்ணும் செவ்வாயும் *","செவ்வடியும் செய்ய கையும் **","திருச் செய்ய கமல உந்தியும் செய்ய","கமல மார்பும் * செய்ய உடையும் *","திருச் செய்ய முடியும் ஆரமும் படையும் *","திகழ என் சிந்தை உளானே"],0,"/media/recitation/TVM.8.4.7.mp3"],[3603,3603,["thigazha en sindhaiyuL irundhAnaich *","sezhu nilath thEvar nAnmaRaiyOr *","thisai kai kUppi Eththum * thiruchchengkunRUril","thiruchchiRRARRangkaraiyAnai **","pugar koL vAnavargaL pugal iDam thannai *","asurar vankaiyar vengkURRai *","pugazhum ARu aRiyEn porundhu mUvulagum *","paDaippoDu keDuppuk kAppavanE"],["திகழ என் சிந்தையுள் இருந்தானைச் *","செழு நிலத் தேவர் நான்மறையோர் *","திசை கை கூப்பி ஏத்தும் * திருச்செங்குன்றூரில்","திருச்சிற்றாற்றங்கரையானை **","புகர் கொள் வானவர்கள் புகல் இடம் தன்னை *","அசுரர் வன்கையர் வெங்கூற்றை *","புகழும் ஆறு அறியேன் பொருந்து மூவுலகும் *","படைப்பொடு கெடுப்புக் காப்பவனே"],0,"/media/recitation/TVM.8.4.8.mp3"],[3604,3604,["paDaippoDu keDuppuk kAppu avan * pirama","paramparan sivappirAn avanE *","iDaippukku Or uruvum ozhivu illai avanE *","pugazhvu illai yAvaiyum thAnE **","koDaip perum pugazhAr inaiyar thannAnAr *","kURiya ichchaiyODu ozhukkam *","naDaip pali iyaRkaith thiruchchengkunRUril *","thiruchchiRRARu amarndha nAthanE"],["படைப்பொடு கெடுப்புக் காப்பு அவன் * பிரம","பரம்பரன் சிவப்பிரான் அவனே *","இடைப்புக்கு ஓர் உருவும் ஒழிவு இல்லை அவனே *","புகழ்வு இல்லை யாவையும் தானே **","கொடைப் பெரும் புகழார் இனையர் தன்னானார் *","கூறிய இச்சையோடு ஒழுக்கம் *","நடைப் பலி இயற்கைத் திருச்செங்குன்றூரில் *","திருச்சிற்றாறு அமர்ந்த நாதனே"],0,"/media/recitation/TVM.8.4.9.mp3"],[3605,3605,["amarndha nAthanai avar avar Agi *","avarkku aruL aruLum ammAnai *","amarndha thaN pazhanath thiruchchengkunRUril *","thiruchchiRRARRangkaraiyAnai **","amarndha sIr mUvAyiravar * vEdhiyargaL","tham pathi avani thEvar vAzhvu *","amarndha mAyOnai mukkaN ammAnai *","nAnmuganai amarndhEnE"],["அமர்ந்த நாதனை அவர் அவர் ஆகி *","அவர்க்கு அருள் அருளும் அம்மானை *","அமர்ந்த தண் பழனத் திருச்செங்குன்றூரில் *","திருச்சிற்றாற்றங்கரையானை **","அமர்ந்த சீர் மூவாயிரவர் * வேதியர்கள்","தம் பதி அவனி தேவர் வாழ்வு *","அமர்ந்த மாயோனை முக்கண் அம்மானை *","நான்முகனை அமர்ந்தேனே"],0,"/media/recitation/TVM.8.4.10.mp3"],[3606,3606,["** thEnai nanpAlaik kannalai amudhaith *","thirundhu ulaguNDa ammAnai *","vAna nAnmuganai malarndha thaN koppUzh *","malar misaip paDaiththa mAyOnai **","kOnai vaNkurugUr vaNsaDakOpan *","sonna AyiraththuL ippaththum *","vAnin mIdhu ERRi aruL seydhu muDikkum *","piRavi mA mAyak kUththinaiyE"],["** தேனை நன்பாலைக் கன்னலை அமுதைத் *","திருந்து உலகுண்ட அம்மானை *","வான நான்முகனை மலர்ந்த தண் கொப்பூழ் *","மலர் மிசைப் படைத்த மாயோனை **","கோனை வண்குருகூர் வண்சடகோபன் *","சொன்ன ஆயிரத்துள் இப்பத்தும் *","வானின் மீது ஏற்றி அருள் செய்து முடிக்கும் *","பிறவி மா மாயக் கூத்தினையே"],0,"/media/recitation/TVM.8.4.11.mp3"]],[[3607,3607,["** mAyak kUththA! vAmanA! *","vinaiyEn kaNNA! kaN kai kAl *","thUya seyya malargaLA *","sOdhich sevvAy mugizhadhA **","sAyal sAmath thirumEni *","thaN pAsu aDaiyA * thAmarai nIL","vAsath thaDam pOl varuvAnE! *","oru nAL kANa vArAyE"],["** மாயக் கூத்தா! வாமனா! *","வினையேன் கண்ணா! கண் கை கால் *","தூய செய்ய மலர்களா *","சோதிச் செவ்வாய் முகிழதா **","சாயல் சாமத் திருமேனி *","தண் பாசு அடையா * தாமரை நீள்","வாசத் தடம் போல் வருவானே! *","ஒரு நாள் காண வாராயே"],0,"/media/recitation/TVM.8.5.1.mp3"],[3608,3608,["kANa vArAy enRenRu *","kaNNum vAyum thuvarndhu * aDiyEn","nANi nannATTu alamandhAl *","iranggi oru nAL nI andhO! **","kANa vArAy karu nAyiRu udhikkum *","karu mA mANikkam *","nAL nal malai pOl suDarch sOdhi *","muDi sEr senni ammAnE!"],["காண வாராய் என்றென்று *","கண்ணும் வாயும் துவர்ந்து * அடியேன்","நாணி நன்னாட்டு அலமந்தால் *","இரங்கி ஒரு நாள் நீ அந்தோ! **","காண வாராய் கரு நாயிறு உதிக்கும் *","கரு மா மாணிக்கம் *","நாள் நல் மலை போல் சுடர்ச் சோதி *","முடி சேர் சென்னி அம்மானே!"],0,"/media/recitation/TVM.8.5.2.mp3"],[3609,3609,["muDi sEr senni ammA! * nin","moy pUnthAmath thaNthuzhAy *","kaDi sEr kaNNip perumAnE! *","enRenRu Enggi azhudhakkAl **","paDi sEr magarak kuzhaigaLum *","pavaLa vAyum nAl thOLum *","thuDi sEr iDaiyum amaindhadhOr *","thU nIr mugil pOl thOnRAyE"],["முடி சேர் சென்னி அம்மா! * நின்","மொய் பூந்தாமத் தண்துழாய் *","கடி சேர் கண்ணிப் பெருமானே! *","என்றென்று ஏங்கி அழுதக்கால் **","படி சேர் மகரக் குழைகளும் *","பவள வாயும் நால் தோளும் *","துடி சேர் இடையும் அமைந்ததோர் *","தூ நீர் முகில் போல் தோன்றாயே"],0,"/media/recitation/TVM.8.5.3.mp3"],[3610,3610,["thUnIr mugil pOl thOnRum * nin","suDar koL vaDivum kani vAyum *","thEnIrk kamalak kaNgaLum *","vandhu en sindhai niRaindhavA! **","mAnIr veLLi malai than mEl *","vaN kAr nIla mugil pOla *","thUnIrk kaDaluL thuyilvAnE! *","endhAy! solla mATTEnE"],["தூநீர் முகில் போல் தோன்றும் * நின்","சுடர் கொள் வடிவும் கனி வாயும் *","தேநீர்க் கமலக் கண்களும் *","வந்து என் சிந்தை நிறைந்தவா! **","மாநீர் வெள்ளி மலை தன் மேல் *","வண் கார் நீல முகில் போல *","தூநீர்க் கடலுள் துயில்வானே! *","எந்தாய்! சொல்ல மாட்டேனே"],0,"/media/recitation/TVM.8.5.4.mp3"],[3611,3611,["solla mATTEn aDiyEn * un","thuLanggu sOdhith thirup pAdham *","ellaiyil sIr iLa njAyiRu *","iraNDu pOl en uLLavA! **","allal ennum iruL sErdhaRku *","upAyam ennE? Azhi sUzh *","mallai njAlam muzhudhu uNDa *","mA nIrk koNDal vaNNanE!"],["சொல்ல மாட்டேன் அடியேன் * உன்","துளங்கு சோதித் திருப் பாதம் *","எல்லையில் சீர் இள ஞாயிறு *","இரண்டு போல் என் உள்ளவா! **","அல்லல் என்னும் இருள் சேர்தற்கு *","உபாயம் என்னே? ஆழி சூழ் *","மல்லை ஞாலம் முழுது உண்ட *","மா நீர்க் கொண்டல் வண்ணனே!"],0,"/media/recitation/TVM.8.5.5.mp3"],[3612,3612,["koNDal vaNNA! kuDak kUththA! *","vinaiyEn kaNNA! kaNNA * en","aNDa vANA! enRu ennai * ALak","kUppiTTu azhaiththakkAl **","viN than mEl thAn maN mEl thAn *","viri nIrk kaDal thAn maRRuth thAn *","thoNDanEn un kazhal kANa *","oru nAL vandhu thOnRAyE"],["கொண்டல் வண்ணா! குடக் கூத்தா! *","வினையேன் கண்ணா! கண்ணா * என்","அண்ட வாணா! என்று என்னை * ஆளக்","கூப்பிட்டு அழைத்தக்கால் **","விண் தன் மேல் தான் மண் மேல் தான் *","விரி நீர்க் கடல் தான் மற்றுத் தான் *","தொண்டனேன் உன் கழல் காண *","ஒரு நாள் வந்து தோன்றாயே"],0,"/media/recitation/TVM.8.5.6.mp3"],[3613,3613,["vandhu thOnRAy anREl * un","vaiyam thAya malar aDik kIzh *","mundhi vandhu yAn niRpa *","mugappE kUvip paNi koLLAy **","senthaN kamalak kaN kai kAl *","sivandha vAy Or karu nAyiRu *","andham illAk kadhir parappi *","alarndhadhu okkum ammAnE!"],["வந்து தோன்றாய் அன்றேல் * உன்","வையம் தாய மலர் அடிக் கீழ் *","முந்தி வந்து யான் நிற்ப *","முகப்பே கூவிப் பணி கொள்ளாய் **","செந்தண் கமலக் கண் கை கால் *","சிவந்த வாய் ஓர் கரு நாயிறு *","அந்தம் இல்லாக் கதிர் பரப்பி *","அலர்ந்தது ஒக்கும் அம்மானே!"],0,"/media/recitation/TVM.8.5.7.mp3"],[3614,3614,["okkum ammAn uruvam enRu *","uLLam kuzhaindhu nANALum *","thokka mEgap pal kuzhAnggaL *","kANum thORum tholaivan nAn **","thakka aivar thamakkAy anRu *","Ir aimpadhinmar thAL sAya *","pukka nal thErth thanip pAgA! *","vArAy idhuvO poruththamE?"],["ஒக்கும் அம்மான் உருவம் என்று *","உள்ளம் குழைந்து நாணாளும் *","தொக்க மேகப் பல் குழாங்கள் *","காணும் தோறும் தொலைவன் நான் **","தக்க ஐவர் தமக்காய் அன்று *","ஈர் ஐம்பதின்மர் தாள் சாய *","புக்க நல் தேர்த் தனிப் பாகா! *","வாராய் இதுவோ பொருத்தமே?"],0,"/media/recitation/TVM.8.5.8.mp3"],[3615,3615,["idhuvO poruththam? min Azhip","paDaiyAy! * ERum irunjchiRaip puL *","adhuvE koDiyA uyarththAnE! *","enRenRu Enggi azhudhakkAl **","edhuvE Agak karudhungkol? *","immA njAlam poRai thIrppAn *","madhu vAr sOlai * uththara","madhuraip piRandha mAyanE"],["இதுவோ பொருத்தம்? மின் ஆழிப்","படையாய்! * ஏறும் இருஞ்சிறைப் புள் *","அதுவே கொடியா உயர்த்தானே! *","என்றென்று ஏங்கி அழுதக்கால் **","எதுவே ஆகக் கருதுங்கொல்? *","இம்மா ஞாலம் பொறை தீர்ப்பான் *","மது வார் சோலை * உத்தர","மதுரைப் பிறந்த மாயனே"],0,"/media/recitation/TVM.8.5.9.mp3"],[3616,3616,["piRandha mAyA! bAratham","porudha mAyA! * nI innE *","siRandha kAl thI nIr vAn * maN","piRavum Aya perumAnE! **","kaRandha pAluL neyyE pOl *","ivaRRuL enggum kaNDukOL *","iRandhu ninRa peru mAyA! *","unnai enggE kANgEnE?"],["பிறந்த மாயா! பாரதம்","பொருத மாயா! * நீ இன்னே *","சிறந்த கால் தீ நீர் வான் * மண்","பிறவும் ஆய பெருமானே! **","கறந்த பாலுள் நெய்யே போல் *","இவற்றுள் எங்கும் கண்டுகோள் *","இறந்து நின்ற பெரு மாயா! *","உன்னை எங்கே காண்கேனே?"],0,"/media/recitation/TVM.8.5.10.mp3"],[3617,3617,["** enggE kANgEn! In thuzhAy","ammAn thannai * yAn? enRenRu *","anggE thAzhndha soRkaLAl *","anthaN kurugUrch saDakOpan *","sengkEzh sonna AyiraththuL *","ivaiyum paththum vallArgaL *","inggE kANa ippiRappE","magizhvar * elliyum kAlaiyE"],["** எங்கே காண்கேன்! ஈன் துழாய்","அம்மான் தன்னை * யான்? என்றென்று *","அங்கே தாழ்ந்த சொற்களால் *","அந்தண் குருகூர்ச் சடகோபன் *","செங்கேழ் சொன்ன ஆயிரத்துள் *","இவையும் பத்தும் வல்லார்கள் *","இங்கே காண இப்பிறப்பே","மகிழ்வர் * எல்லியும் காலையே"],0,"/media/recitation/TVM.8.5.11.mp3"]],[[3618,3618,["** elliyum kAlaiyum * thannai ninaindhu ezha *","nalla aruLgaL * namakkE thandhu aruL seyvAn **","alli anthaNNanthuzhAy muDi * appan Ur *","selvargaL vAzhum * thirukkaDiththAnamE"],["** எல்லியும் காலையும் * தன்னை நினைந்து எழ *","நல்ல அருள்கள் * நமக்கே தந்து அருள் செய்வான் **","அல்லி அந்தண்ணந்துழாய் முடி * அப்பன் ஊர் *","செல்வர்கள் வாழும் * திருக்கடித்தானமே"],0,"/media/recitation/TVM.8.6.1.mp3"],[3619,3619,["thirukkaDiththAnamum * ennuDaich sindhaiyum *","orukkaDuththu uLLE * uRaiyum pirAn kaNDIr **","seruk kaDuththu anRu * thigaiththa arakkarai *","uruk keDa * vALi pozhindha oruvanE"],["திருக்கடித்தானமும் * என்னுடைச் சிந்தையும் *","ஒருக்கடுத்து உள்ளே * உறையும் பிரான் கண்டீர் **","செருக் கடுத்து அன்று * திகைத்த அரக்கரை *","உருக் கெட * வாளி பொழிந்த ஒருவனே"],0,"/media/recitation/TVM.8.6.2.mp3"],[3620,3620,["oruvar iruvar Or * mUvar ena ninRu *","uruvu karandhu * uLLunthORum thiththippAn **","thiru amar mArvan * thirukkaDiththAnaththai *","maruvi uRaiginRa * mAyap pirAnE"],["ஒருவர் இருவர் ஓர் * மூவர் என நின்று *","உருவு கரந்து * உள்ளுந்தோறும் தித்திப்பான் **","திரு அமர் மார்வன் * திருக்கடித்தானத்தை *","மருவி உறைகின்ற * மாயப் பிரானே"],0,"/media/recitation/TVM.8.6.3.mp3"],[3621,3621,["mAyap pirAn * ena val vinai mAyndhu aRa *","nEsaththinAl * nenjcha nADu kuDi koNDAn **","thEsaththu amarar * thirukkaDiththAnaththai *","vAsap pozhil mannu * kOyil koNDAnE"],["மாயப் பிரான் * என வல் வினை மாய்ந்து அற *","நேசத்தினால் * நெஞ்ச நாடு குடி கொண்டான் **","தேசத்து அமரர் * திருக்கடித்தானத்தை *","வாசப் பொழில் மன்னு * கோயில் கொண்டானே"],0,"/media/recitation/TVM.8.6.4.mp3"],[3622,3622,["kOyil koNDAn * than thirukkaDiththAnaththai *","kOyil koNDAn * adhanODum en nenjchagam **","kOyil koL * dheyvam ellAm thozha * vaikundham","kOyil koNDa * kuDak kUththa ammAnE"],["கோயில் கொண்டான் * தன் திருக்கடித்தானத்தை *","கோயில் கொண்டான் * அதனோடும் என் நெஞ்சகம் **","கோயில் கொள் * தெய்வம் எல்லாம் தொழ * வைகுந்தம்","கோயில் கொண்ட * குடக் கூத்த அம்மானே"],0,"/media/recitation/TVM.8.6.5.mp3"],[3623,3623,["kUththa ammAn * koDiyEn iDar muRRavum *","mAyththa ammAn * madhusUdha ammAn uRai **","pUththa pozhil * thaN thirukkaDiththAnaththai *","Eththa nillA * kuRikkoNmin iDarE"],["கூத்த அம்மான் * கொடியேன் இடர் முற்றவும் *","மாய்த்த அம்மான் * மதுசூத அம்மான் உறை **","பூத்த பொழில் * தண் திருக்கடித்தானத்தை *","ஏத்த நில்லா * குறிக்கொண்மின் இடரே"],0,"/media/recitation/TVM.8.6.6.mp3"],[3624,3624,["koNmin iDar keDa * uLLaththuk gOvindhan *","maN viN muzhudhum aLandha * oN thAmarai **","maNNavar thAm thozha * vAnavar thAm vandhu *","naNNu thirukkaDiththAna nagarE"],["கொண்மின் இடர் கெட * உள்ளத்துக் கோவிந்தன் *","மண் விண் முழுதும் அளந்த * ஒண் தாமரை **","மண்ணவர் தாம் தொழ * வானவர் தாம் வந்து *","நண்ணு திருக்கடித்தான நகரே"],0,"/media/recitation/TVM.8.6.7.mp3"],[3625,3625,["thAna nagargaL * thalaich chiRandhu enggenggum *","vAn innilam kaDal * muRRum em mAyaRkE **","Ana iDaththum en nenjchum * thirukkaDith","thAna nagarum * thana thAyap padhiyE"],["தான நகர்கள் * தலைச் சிறந்து எங்கெங்கும் *","வான் இந்நிலம் கடல் * முற்றும் எம் மாயற்கே **","ஆன இடத்துமென் நெஞ்சும் * திருக்கடித்","தான நகரும் * தன தாயப் பதியே"],0,"/media/recitation/TVM.8.6.8.mp3"],[3626,3626,["thAyap padhigaL * thalaich chiRandhu enggenggum *","mAyaththinAl manni * vIRRirundhAn uRai **","thEsaththu amarar * thirukkaDiththAnaththuL *","Ayarkku adhipadhi * aRpudhan thAnE"],["தாயப் பதிகள் * தலைச் சிறந்து எங்கெங்கும் *","மாயத்தினால் மன்னி * வீற்றிருந்தான் உறை **","தேசத்து அமரர் * திருக்கடித்தானத்துள் *","ஆயர்க்கு அதிபதி * அற்புதன் தானே"],0,"/media/recitation/TVM.8.6.9.mp3"],[3627,3627,["aRpudhan nArAyaNan * ari vAmanan *","niRpadhu mEvi * iruppadhu en nenjchagam **","naRpugazh vEdhiyar * nAnmaRai ninRu adhir *","kaRpagach sOlaith * thirukkaDiththAnamE"],["அற்புதன் நாராயணன் * அரி வாமனன் *","நிற்பது மேவி * இருப்பது என் நெஞ்சகம் **","நற்புகழ் வேதியர் * நான்மறை நின்று அதிர் *","கற்பகச் சோலைத் * திருக்கடித்தானமே"],0,"/media/recitation/TVM.8.6.10.mp3"],[3628,3628,["** sOlai thirukkaDiththAnaththu * uRai thiru","mAlai * madhiL kurugUrch * saDakOpan sol **","pAlODu amudhu anna * Ayiraththu ippaththum *","mElai vaikundhaththu * iruththum viyandhE"],["** சோலை திருக்கடித்தானத்து * உறை திரு","மாலை * மதிள் குருகூர்ச் * சடகோபன் சொல் **","பாலோடு அமுது அன்ன * ஆயிரத்து இப்பத்தும் *","மேலை வைகுந்தத்து * இருத்தும் வியந்தே"],0,"/media/recitation/TVM.8.6.11.mp3"]],[[3629,3629,["** iruththum viyandhu ennaith * than pon aDik kIzh enRu *","aruththiththu enaiththOr * pala nAL azhaiththERku **","poruththam uDai * vAmanan thAn pugundhu * enthan","karuththai uRa vIRRirundhAn * kaNDu koNDE"],["** இருத்தும் வியந்து என்னைத் * தன் பொன் அடிக் கீழ் என்று *","அருத்தித்து எனைத்தோர் * பல நாள் அழைத்தேற்கு **","பொருத்தம் உடை * வாமனன் தான் புகுந்து * என்தன்","கருத்தை உற வீற்றிருந்தான் * கண்டு கொண்டே"],0,"/media/recitation/TVM.8.7.1.mp3"],[3630,3630,["irundhAn kaNDu koNDu * enadhu Ezhai nenjchALum *","thirundhAdha Or aivaraith * thEyndhu aRa manni **","perunthAL kaLiRRukku * aruL seytha perumAn *","tharunthAn aruL thAn * ini yAn aRiyEnE"],["இருந்தான் கண்டு கொண்டு * எனது ஏழை நெஞ்சாளும் *","திருந்தாத ஓர் ஐவரைத் * தேய்ந்து அற மன்னி **","பெருந்தாள் களிற்றுக்கு * அருள் செய்த பெருமான் *","தருந்தான் அருள் தான் * இனி யான் அறியேனே"],0,"/media/recitation/TVM.8.7.2.mp3"],[3631,3631,["aruL thAn ini yAn aRiyEn * avan en uL *","iruL thAn aRa * vIRRirundhAn idhu allAl **","poruL thAn enil * mU ulagum poruL alla *","maruL thAn IdhO? * mAya mayakku mayakkE"],["அருள் தான் இனி யான் அறியேன் * அவன் என் உள் *","இருள் தான் அற * வீற்றிருந்தான் இது அல்லால் **","பொருள் தான் எனில் * மூ உலகும் பொருள் அல்ல *","மருள் தான் ஈதோ? * மாய மயக்கு மயக்கே"],0,"/media/recitation/TVM.8.7.3.mp3"],[3632,3632,["mAya mayakku mayakkAn * ennai vanjchiththu *","Ayan amararkku * ari ERu enadhu ammAn **","thUya suDarch sOdhi * thanadhu ennuL vaiththAn *","thEsam thigazhum * than thiru aruL seydhE"],["மாய மயக்கு மயக்கான் * என்னை வஞ்சித்து *","ஆயன் அமரர்க்கு * அரி ஏறு எனது அம்மான் **","தூய சுடர்ச் சோதி * தனது என்னுள் வைத்தான் *","தேசம் திகழும் * தன் திரு அருள் செய்தே"],0,"/media/recitation/TVM.8.7.4.mp3"],[3633,3633,["thigazhum than thiru aruL seydhu * ulagaththAr","pugazhum pugazh * thAn adhu kATTith thandhu ** ennuL","thigazhum * maNik kunRam onRE oththu ninRAn *","pugazhum pugazh * maRRu enakkum Or poruLE?"],["திகழும் தன் திரு அருள் செய்து * உலகத்தார்","புகழும் புகழ் * தான் அது காட்டித் தந்து ** என்னுள்","திகழும் * மணிக் குன்றம் ஒன்றே ஒத்து நின்றான் *","புகழும் புகழ் * மற்று எனக்கும் ஓர் பொருளே?"],0,"/media/recitation/TVM.8.7.5.mp3"],[3634,3634,["poruL maRRu enakkum Or poruL thannil * sIrkkath","tharumEl * pinnai Arkku avan * thannaik koDukkum? **","karu mANikkak kunRaththuth * thAmarai pOl *","thiru mArvu kAl kaN kai * sevvAy undhiyAnE"],["பொருள் மற்று எனக்கும் ஓர் பொருள் தன்னில் * சீர்க்கத்","தருமேல் * பின்னை ஆர்க்கு அவன் * தன்னைக் கொடுக்கும்? **","கரு மாணிக்கக் குன்றத்துத் * தாமரை போல் *","திரு மார்வு கால் கண் கை * செவ்வாய் உந்தியானே"],0,"/media/recitation/TVM.8.7.6.mp3"],[3635,3635,["sevvAy undhi * veN pal suDark kuzhai thammODu *","evvAych suDarum * thammil munvaLAyk koLLa **","sevvAy muRuvalODu * enadhu uLLaththu irundha *","avvAy anRi * yAn aRiyEn maRRu aruLE"],["செவ்வாய் உந்தி * வெண் பல் சுடர்க் குழை தம்மோடு *","எவ்வாய்ச் சுடரும் * தம்மில் முன்வளாய்க் கொள்ள **","செவ்வாய் முறுவலோடு * எனது உள்ளத்து இருந்த *","அவ்வாய் அன்றி * யான் அறியேன் மற்று அருளே"],0,"/media/recitation/TVM.8.7.7.mp3"],[3636,3636,["aRiyEn maRRu aruL * ennai ALum pirAnAr *","veRidhE aruL seyvar * seyvArgaTku ugandhu **","siRiyEnuDaich * sindhaiyuL mU ulagum * than","neRiyA vayiRRil koNDu * ninRozhindhArE"],["அறியேன் மற்று அருள் * என்னை ஆளும் பிரானார் *","வெறிதே அருள் செய்வர் * செய்வார்கட்கு உகந்து **","சிறியேனுடைச் * சிந்தையுள் மூ உலகும் * தன்","நெறியா வயிற்றில் கொண்டு * நின்றொழிந்தாரே"],0,"/media/recitation/TVM.8.7.8.mp3"],[3637,3637,["vayiRRil koNDu * ninRozhindhArum yavarum *","vayiRRil koNDu * ninRoru mU ulagum ** tham","vayiRRil koNDu * ninRa vaNNam ninRa mAlai *","vayiRRil koNDu * manna vaiththEn madhiyAlE"],["வயிற்றில் கொண்டு * நின்றொழிந்தாரும் யவரும் *","வயிற்றில் கொண்டு * நின்றொரு மூ உலகும் ** தம்","வயிற்றில் கொண்டு * நின்ற வண்ணம் நின்ற மாலை *","வயிற்றில் கொண்டு * மன்ன வைத்தேன் மதியாலே"],0,"/media/recitation/TVM.8.7.9.mp3"],[3638,3638,["vaiththEn madhiyAl * enadhu uLLaththu agaththE *","eyththE ozhivEn allEn * enRum eppOdhum **","moyththEy thirai mOdhu * thaN pARkaDaluLAl *","paiththEy suDarp * pAmbaNai nam paranaiyE"],["வைத்தேன் மதியால் * எனது உள்ளத்து அகத்தே *","எய்த்தே ஒழிவேன் அல்லேன் * என்றும் எப்போதும் **","மொய்த்தேய் திரை மோது * தண் பாற்கடலுளால் *","பைத்தேய் சுடர்ப் * பாம்பணை நம் பரனையே"],0,"/media/recitation/TVM.8.7.10.mp3"],[3639,3639,["** suDarp pAmbaNai nam paranaith * thirumAlai *","aDich chEr vagai * vaNkurugUrch saDakOpan **","muDippAn sonna Ayiraththu * ippaththum sanmam","viDa * thEyndhaRa nOkkum * than kaNgaL sivandhE"],["** சுடர்ப் பாம்பணை நம் பரனைத் * திருமாலை *","அடிச் சேர் வகை * வண்குருகூர்ச் சடகோபன் **","முடிப்பான் சொன்ன ஆயிரத்து * இப்பத்தும் சன்மம்","விட * தேய்ந்தற நோக்கும் * தன் கண்கள் சிவந்தே"],0,"/media/recitation/TVM.8.7.11.mp3"]],[[3640,3640,["** kaNgaL sivandhu periyavAy *","vAyum sivandhu kanindhu * uLLE","veN pal ilagu suDar ilagu *","vilagu magara kuNDalaththan **","koNDal vaNNan suDar muDiyan *","nAngu thOLan kuni sArnggan *","oN sanggu kadhai vAL AzhiyAn *","oruvan aDiyEn uLLAnE"],["** கண்கள் சிவந்து பெரியவாய் *","வாயும் சிவந்து கனிந்து * உள்ளே","வெண் பல் இலகு சுடர் இலகு *","விலகு மகர குண்டலத்தன் **","கொண்டல் வண்ணன் சுடர் முடியன் *","நான்கு தோளன் குனி சார்ங்கன் *","ஒண் சங்கு கதை வாள் ஆழியான் *","ஒருவன் அடியேன் உள்ளானே"],0,"/media/recitation/TVM.8.8.1.mp3"],[3641,3641,["aDiyEn uLLAn uDal uLLAn *","aNDaththu agaththAn puRaththu uLLAn *","paDiyEy idhu enRu uraikkalAm","paDiyan allan * paramparan **","kaDi sEr nARRaththu uLLAlai *","inbath thunbak kazhi nErmai *","oDiyA inbap perumaiyOn *","uNarvil umbar oruvanE"],["அடியேன் உள்ளான் உடல் உள்ளான் *","அண்டத்து அகத்தான் புறத்து உள்ளான் *","படியேய் இது என்று உரைக்கலாம்","படியன் அல்லன் * பரம்பரன் **","கடி சேர் நாற்றத்து உள்ளாலை *","இன்பத் துன்பக் கழி நேர்மை *","ஒடியா இன்பப் பெருமையோன் *","உணர்வில் உம்பர் ஒருவனே"],0,"/media/recitation/TVM.8.8.2.mp3"],[3642,3642,["uNarvil umbar oruvanai *","avanadhu aruLAl uRal poruTTu * en","uNarvin uLLE iruththinEn *","adhuvum avanadhu innaruLE **","uNarvum uyirum uDambum *","maRRu ulappilanavum pazhudhEyAm *","uNarvaip peRa Urndhu iRavERi *","yAnum thAnAy ozhindhAnE"],["உணர்வில் உம்பர் ஒருவனை *","அவனது அருளால் உறல் பொருட்டு * என்","உணர்வின் உள்ளே இருத்தினேன் *","அதுவும் அவனது இன்னருளே **","உணர்வும் உயிரும் உடம்பும் *","மற்று உலப்பிலனவும் பழுதேயாம் *","உணர்வைப் பெற ஊர்ந்து இறவேறி *","யானும் தானாய் ஒழிந்தானே"],0,"/media/recitation/TVM.8.8.3.mp3"],[3643,3643,["yAnum thAnAy ozhindhAnai *","yAdhum yavarkkum munnOnai *","thAnum sivanum piramanum Agip *","paNaiththa thani mudhalai **","thEnum pAlum kannalum *","amudhum Agith thiththiththu * en","Unil uyiril uNarvinil *","ninRa onRai uNarndhEnE"],["யானும் தானாய் ஒழிந்தானை *","யாதும் யவர்க்கும் முன்னோனை *","தானும் சிவனும் பிரமனும் ஆகிப் *","பணைத்த தனி முதலை **","தேனும் பாலும் கன்னலும் *","அமுதும் ஆகித் தித்தித்து * என்","ஊனில் உயிரில் உணர்வினில் *","நின்ற ஒன்றை உணர்ந்தேனே"],0,"/media/recitation/TVM.8.8.4.mp3"],[3644,3644,["ninRa onRai uNarndhEnukku *","adhanuL nErmai adhu idhu enRu *","onRum oruvarkku uNaral AgAdhu *","uNarndhum mElum kANbu aridhu **","senRu senRu paramparamAy *","yAdhum inRith thEyndhu aRRu *","nanRu thIdhu enRu aRivu aridhAy *","nanRAy njAnam kaDandhadhE"],["நின்ற ஒன்றை உணர்ந்தேனுக்கு *","அதனுள் நேர்மை அது இது என்று *","ஒன்றும் ஒருவர்க்கு உணரல் ஆகாது *","உணர்ந்தும் மேலும் காண்பு அரிது **","சென்று சென்று பரம்பரமாய் *","யாதும் இன்றித் தேய்ந்து அற்று *","நன்று தீது என்று அறிவு அரிதாய் *","நன்றாய் ஞானம் கடந்ததே"],0,"/media/recitation/TVM.8.8.5.mp3"],[3645,3645,["nanRAy njAnam kaDandhu pOy *","nal indhiriyam ellAm Irththu *","onRAyk kiDandha arum perum pAzh *","ulappil adhanai uNarndhu uNarndhu **","senRAnggu inba thunbanggaL *","seRRuk kaLaindhu pasai aRRAl *","anRE appOdhE vIDu *","adhuvE vIDu vIDAmE"],["நன்றாய் ஞானம் கடந்து போய் *","நல் இந்திரியம் எல்லாம் ஈர்த்து *","ஒன்றாய்க் கிடந்த அரும் பெரும் பாழ் *","உலப்பில் அதனை உணர்ந்து உணர்ந்து **","சென்றாங்கு இன்ப துன்பங்கள் *","செற்றுக் களைந்து பசை அற்றால் *","அன்றே அப்போதே வீடு *","அதுவே வீடு வீடாமே"],0,"/media/recitation/TVM.8.8.6.mp3"],[3646,3646,["adhuvE vIDu vIDu pERRu *","inbam thAnum adhu thERi *","edhuvE thAnum paRRu inRi *","Adhum iligaL AgiRkil **","adhuvE vIDu vIDu pERRu *","inbam thAnum adhu thERAdhu *","edhuvE vIDu? Edhu inbam? enRu *","eyththAr eyththAr eyththArE"],["அதுவே வீடு வீடு பேற்று *","இன்பம் தானும் அது தேறி *","எதுவே தானும் பற்று இன்றி *","ஆதும் இலிகள் ஆகிற்கில் **","அதுவே வீடு வீடு பேற்று *","இன்பம் தானும் அது தேறாது *","எதுவே வீடு? ஏது இன்பம்? என்று *","எய்