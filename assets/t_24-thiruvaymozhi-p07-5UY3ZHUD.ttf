[[[3453,3453,["** uNNilAviya aivarAl kumai","thIRRi * ennai un pAdha panggayam *","naNNilA vagaiyE * nalivAn","innam eNNuginRAy **","eN ilAp peru mAyanE! imaiyOrgaL","Eththum * ulagam mUnRuDai *","aNNalE! amudhE! appanE! *","ennai ALvAnE!"],["** உண்ணிலாவிய ஐவரால் குமை","தீற்றி * என்னை உன் பாத பங்கயம் *","நண்ணிலா வகையே * நலிவான்","இன்னம் எண்ணுகின்றாய் **","எண் இலாப் பெரு மாயனே! இமையோர்கள்","ஏத்தும் * உலகம் மூன்றுடை *","அண்ணலே! அமுதே! அப்பனே! *","என்னை ஆள்வானே!"],0,"/media/recitation/TVM.7.1.1.mp3"],[3454,3454,["ennai ALum van kO Oraindhu ivai peydhu *","irAp pagal mOdhuviththiTTu *","unnai nAn aNugA vagai *","seydhu pOdhi kaNDAy **","kannalE! amudhE! kAr mugil vaNNanE! *","kaDal njAlam kAkkinRa *","minnu nEmiyinAy! *","vinaiyEnuDai vEdhiyanE!"],["என்னை ஆளும் வன் கோ ஓரைந்து இவை பெய்து *","இராப் பகல் மோதுவித்திட்டு *","உன்னை நான் அணுகா வகை *","செய்து போதி கண்டாய் **","கன்னலே! அமுதே! கார் முகில் வண்ணனே! *","கடல் ஞாலம் காக்கின்ற *","மின்னு நேமியினாய்! *","வினையேனுடை வேதியனே!"],0,"/media/recitation/TVM.7.1.2.mp3"],[3455,3455,["vEdhiyA niRkum aivarAl * vinaiyEnai","mOdhuviththu * un thiruvaDich","sAdhiyA vagai * nI thaDuththu","en peRudhi? andhO! **","Adhi Agi agaliDam paDaiththu * uNDu umizhndhu","kaDandhu iDandhiTTa *","sOdhi nIL muDiyAy! *","thoNDanEn madhusUdhananE!"],["வேதியா நிற்கும் ஐவரால் * வினையேனை","மோதுவித்து * உன் திருவடிச்","சாதியா வகை * நீ தடுத்து","என் பெறுதி? அந்தோ! **","ஆதி ஆகி அகலிடம் படைத்து * உண்டு உமிழ்ந்து","கடந்து இடந்திட்ட *","சோதி நீள் முடியாய்! *","தொண்டனேன் மதுசூதனனே!"],0,"/media/recitation/TVM.7.1.3.mp3"],[3456,3456,["sUdhu nAn aRiyA vagai * suzhaRRi Or","aivaraik kATTi * un aDip","pOdhu nAn aNugA vagai *","seydhu pOdhi kaNDAy **","yAdhum yAvarum inRi nin agam pAl","oDukki * Or Alin nIL ilai *","mIdhu sEr kuzhavi! *","vinaiyEn vinai thIr marundhE!"],["சூது நான் அறியா வகை * சுழற்றி ஓர்","ஐவரைக் காட்டி * உன் அடிப்","போது நான் அணுகா வகை *","செய்து போதி கண்டாய் **","யாதும் யாவரும் இன்றி நின் அகம் பால்","ஒடுக்கி * ஓர் ஆலின் நீள் இலை *","மீது சேர் குழவி! *","வினையேன் வினை தீர் மருந்தே!"],0,"/media/recitation/TVM.7.1.4.mp3"],[3457,3457,["thIr marundhu inRi aindhu nOy aDum *","sekkil iTTuth thirikkum aivarai *","nEr marunggu uDaiththA aDaiththu *","negizhppAn okkinRAy **","Ar marundhu ini AguvAr? * aDal Azhi","Endhi asurar van kulam *","vEr marunggu aRuththAy! *","viNNuLAr perumAnEyO!"],["தீர் மருந்து இன்றி ஐந்து நோய் அடும் *","செக்கில் இட்டுத் திரிக்கும் ஐவரை *","நேர் மருங்கு உடைத்தா அடைத்து *","நெகிழ்ப்பான் ஒக்கின்றாய் **","ஆர் மருந்து இனி ஆகுவார்? * அடல் ஆழி","ஏந்தி அசுரர் வன் குலம் *","வேர் மருங்கு அறுத்தாய்! *","விண்ணுளார் பெருமானேயோ!"],0,"/media/recitation/TVM.7.1.5.mp3"],[3458,3458,["viNNuLAr perumARku aDimai seyvAraiyum *","seRum aimpulan ivai *","maNNuL ennaip peRRAl * en seyyA","maRRu nIyum viTTAl? **","paNNuLAy! kavi than uLAy! *","paththiyin uLLAy! param IsanE! * vandhu en","kaNNuLAy! nenjchuLAy! * sol uLAy!","onRu sollAyE"],["விண்ணுளார் பெருமாற்கு அடிமை செய்வாரையும் *","செறும் ஐம்புலன் இவை *","மண்ணுள் என்னைப் பெற்றால் * என் செய்யா","மற்று நீயும் விட்டால்? **","பண்ணுளாய்! கவி தன் உளாய்! *","பத்தியின் உள்ளாய்! பரம் ஈசனே! * வந்து என்","கண்ணுளாய்! நெஞ்சுளாய்! * சொல் உளாய்!","ஒன்று சொல்லாயே"],0,"/media/recitation/TVM.7.1.6.mp3"],[3459,3459,["onRu solli oruththinil niRkilAdha *","Or aivar van kayavarai *","enRu yAn vel kiRpan * un","thiru aruL illaiyEl? **","anRu dhEvar asurar vAngga *","alai kaDal aravam aLAvi * Or","kunRam vaiththa endhAy! *","koDiyEn parugu innamudhE!"],["ஒன்று சொல்லி ஒருத்தினில் நிற்கிலாத *","ஓர் ஐவர் வன் கயவரை *","என்று யான் வெல் கிற்பன் * உன்","திரு அருள் இல்லையேல்? **","அன்று தேவர் அசுரர் வாங்க *","அலை கடல் அரவம் அளாவி * ஓர்","குன்றம் வைத்த எந்தாய்! *","கொடியேன் பருகு இன்னமுதே!"],0,"/media/recitation/TVM.7.1.7.mp3"],[3460,3460,["innamudhu enath thOnRi * Or aivar","yAvaraiyum mayakka * nI vaiththa","munna mAyam ellAm * muzhu","vEr arindhu ** ennai un","chinnamum thiru mUrththiyum * sindhiththu Eththik","kai thozhavE aruL enakku *","en ammA! en kaNNA! *","imaiyOr tham kula mudhalE!"],["இன்னமுது எனத் தோன்றி * ஓர் ஐவர்","யாவரையும் மயக்க * நீ வைத்த","முன்ன மாயம் எல்லாம் * முழு","வேர் அரிந்து ** என்னை உன்","சின்னமும் திரு மூர்த்தியும் * சிந்தித்து ஏத்திக்","கை தொழவே அருள் எனக்கு *","என் அம்மா! என் கண்ணா! *","இமையோர் தம் குல முதலே!"],0,"/media/recitation/TVM.7.1.8.mp3"],[3461,3461,["kula mudhal aDum thIvinaik * koDu van kuzhiyinil","vIzhkkum aivarai *","vala mudhal keDukkum * valamE","thandharuL kaNDAy **","nila mudhal ini evvulagukkum * niRpana","selvana ena * poruL","pala mudhal paDaiththAy! *","en kaNNA! en paranjchuDarE!"],["குல முதல் அடும் தீவினைக் * கொடு வன் குழியினில்","வீழ்க்கும் ஐவரை *","வல முதல் கெடுக்கும் * வலமே","தந்தருள் கண்டாய் **","நில முதல் இனி எவ்வுலகுக்கும் * நிற்பன","செல்வன என * பொருள்","பல முதல் படைத்தாய்! *","என் கண்ணா! என் பரஞ்சுடரே!"],0,"/media/recitation/TVM.7.1.9.mp3"],[3462,3462,["en paranjchuDarE! enRu unnai alaRRi * un","iNaith thAmaraigaTku *","anburugi niRkum * adhu niRkach","chumaDu thandhAy **","van paranggaL eDuththu * aivar thisai thisai","valiththu eRRuginRanar *","mun paravai kaDaindhu * amudham","koNDa mUrththiyO!"],["என் பரஞ்சுடரே! என்று உன்னை அலற்றி * உன்","இணைத் தாமரைகட்கு *","அன்புருகி நிற்கும் * அது நிற்கச்","சுமடு தந்தாய் **","வன் பரங்கள் எடுத்து * ஐவர் திசை திசை","வலித்து எற்றுகின்றனர் *","முன் பரவை கடைந்து * அமுதம்","கொண்ட மூர்த்தியோ!"],0,"/media/recitation/TVM.7.1.10.mp3"],[3463,3463,["** koNDa mUrththi Or mUvarAyk * guNanggaL","paDaiththu aLiththuk keDukkum * ap","puNDarIgak koppUzhp * punaR","paLLi appanukkE **","thoNDar thoNDar thoNDar thoNDan saDakOpan *","sol AyiraththuL ippaththum *","kaNDu pADa vallAr * vinai","pOm kanggulum pagalE"],["** கொண்ட மூர்த்தி ஓர் மூவராய்க் * குணங்கள்","படைத்து அளித்துக் கெடுக்கும் * அப்","புண்டரீகக் கொப்பூழ்ப் * புனற்","பள்ளி அப்பனுக்கே **","தொண்டர் தொண்டர் தொண்டர் தொண்டன் சடகோபன் *","சொல் ஆயிரத்துள் இப்பத்தும் *","கண்டு பாட வல்லார் * வினை","போம் கங்குலும் பகலே"],0,"/media/recitation/TVM.7.1.11.mp3"]],[[3464,3464,["** kanggulum pagalum kaN thuyil aRiyAL *","kaNNa nIr kaigaLAl iRaikkum *","sanggu chakkaranggaL enRu kai kUppum *","thAmaraik kaN enRE thaLarum **","engnganE tharikkEn unnai viTTu? ennum *","iru nilam kai thuzhA irukkum *","senggayal pAy nIrth thiruvaranggaththAy! *","ivaL thiRaththu en seyginRAyE?"],["** கங்குலும் பகலும் கண் துயில் அறியாள் *","கண்ண நீர் கைகளால் இறைக்கும் *","சங்கு சக்கரங்கள் என்று கை கூப்பும் *","தாமரைக் கண் என்றே தளரும் **","எங்ஙனே தரிக்கேன் உன்னை விட்டு? என்னும் *","இரு நிலம் கை துழா இருக்கும் *","செங்கயல் பாய் நீர்த் திருவரங்கத்தாய்! *","இவள் திறத்து என் செய்கின்றாயே?"],0,"/media/recitation/TVM.7.2.1.mp3"],[3465,3465,["en seyginRAy? en thAmaraik kaNNA!","ennum * kaN nIr malga irukkum *","en seygEn? eRi nIrth thiruvaranggaththAy!","ennum * vevvuyirththu uyirththu urugum **","mun seydha vinaiyE! mugappaDAy ennum *","mugil vaNNA! thaguvadhO? ennum *","mun seydhu ivvulagam uNDu umizhndhu aLandhAy! *","en kolO muDiginRadhu ivaTkE?"],["என் செய்கின்றாய்? என் தாமரைக் கண்ணா!","என்னும் * கண் நீர் மல்க இருக்கும் *","என் செய்கேன்? எறி நீர்த் திருவரங்கத்தாய்!","என்னும் * வெவ்வுயிர்த்து உயிர்த்து உருகும் **","முன் செய்த வினையே! முகப்படாய் என்னும் *","முகில் வண்ணா! தகுவதோ? என்னும் *","முன் செய்து இவ்வுலகம் உண்டு உமிழ்ந்து அளந்தாய்! *","என் கொலோ முடிகின்றது இவட்கே?"],0,"/media/recitation/TVM.7.2.2.mp3"],[3466,3466,["vaTkilaL iRaiyum maNi vaNNA! ennum *","vAnamE nOkkum maiyAkkum *","uTkuDai asurar uyir ellAm uNDa *","oruvanE! ennum uL urugum **","kaTkilI! unnaik kANum ARu aruLAy *","kAguththA! kaNNanE! ennum *","thiTkoDi mathiL sUzh thiruvaranggaththAy! *","ivaL thiRaththu en seydhiTTAyE?"],["வட்கிலள் இறையும் மணி வண்ணா! என்னும் *","வானமே நோக்கும் மையாக்கும் *","உட்குடை அசுரர் உயிர் எல்லாம் உண்ட *","ஒருவனே! என்னும் உள் உருகும் **","கட்கிலீ! உன்னைக் காணும் ஆறு அருளாய் *","காகுத்தா! கண்ணனே! என்னும் *","திட்கொடி மதிள் சூழ் திருவரங்கத்தாய்! *","இவள் திறத்து என் செய்திட்டாயே?"],0,"/media/recitation/TVM.7.2.3.mp3"],[3467,3467,["iTTa kAl iTTa kaiyaLAy irukkum *","ezhundhu ulAy mayanggum kai kUppum *","kaTTamE kAdhal enRu mUrchchikkum *","kaDal vaNNA! kaDiyai kAN ennum **","vaTTa vAy nEmi valangkaiyA! ennum *","vandhiDAy enRenRE mayanggum *","chiTTanE! sezhu nIrth thiruvaranggaththAy! *","ivaL thiRaththu en sindhiththAyE?"],["இட்ட கால் இட்ட கையளாய் இருக்கும் *","எழுந்து உலாய் மயங்கும் கை கூப்பும் *","கட்டமே காதல் என்று மூர்ச்சிக்கும் *","கடல் வண்ணா! கடியை காண் என்னும் **","வட்ட வாய் நேமி வலங்கையா! என்னும் *","வந்திடாய் என்றென்றே மயங்கும் *","சிட்டனே! செழு நீர்த் திருவரங்கத்தாய்! *","இவள் திறத்து என் சிந்தித்தாயே?"],0,"/media/recitation/TVM.7.2.4.mp3"],[3468,3468,["sindhikkum thisaikkum thERum kai kUppum *","thiruvaranggaththu uLLAy! ennum","vandhikkum * AnggE mazhaik kaN nIr malga *","vandhiDAy enRenRE mayanggum **","andhip pOdhu avuNan uDal iDandhAnE!","alai kaDal kaDaindha AramudhE *","sandhiththu un charaNam sArvadhE valiththa *","thaiyalai maiyal seydhAnE!"],["சிந்திக்கும் திசைக்கும் தேறும் கை கூப்பும் *","திருவரங்கத்து உள்ளாய்! என்னும்","வந்திக்கும் * ஆங்கே மழைக் கண் நீர் மல்க *","வந்திடாய் என்றென்றே மயங்கும் **","அந்திப் போது அவுணன் உடல் இடந்தானே!","அலை கடல் கடைந்த ஆரமுதே *","சந்தித்து உன் சரணம் சார்வதே வலித்த *","தையலை மையல் செய்தானே!"],0,"/media/recitation/TVM.7.2.5.mp3"],[3469,3469,["maiyal seydhu ennai manam kavarndhAnE!","ennum * mA mAyanE! ennum *","seyya vAy maNiyE! ennum * thaN punal sUzh","thiruvaranggaththu uLLAy! ennum **","veyya vAL thaNDu sanggu chakkaram vil Endhum *","viNNOr mudhal! ennum *","pai koL pAmbaNaiyAy! ivaL thiRaththu aruLAy *","pAviyEn seyaR pAladhuvE"],["மையல் செய்து என்னை மனம் கவர்ந்தானே!","என்னும் * மா மாயனே! என்னும் *","செய்ய வாய் மணியே! என்னும் * தண் புனல் சூழ்","திருவரங்கத்து உள்ளாய்! என்னும் **","வெய்ய வாள் தண்டு சங்கு சக்கரம் வில் ஏந்தும் *","விண்ணோர் முதல்! என்னும் *","பை கொள் பாம்பணையாய்! இவள் திறத்து அருளாய் *","பாவியேன் செயற் பாலதுவே"],0,"/media/recitation/TVM.7.2.6.mp3"],[3470,3470,["pAla thunbanggaL inbanggaL paDaiththAy! *","paRRilAr paRRa ninRAnE! *","kAla chakkaraththAy! kaDal iDam koNDa *","kaDal vaNNA! kaNNaNE! ennum **","sEl koL thaN punal sUzh thiruvaranggaththAy!","ennum * en thIrththanE! ennum *","kOla mA mazhaik kaN pani malga irukkum *","ennuDaik kOmaLak kozhundhE"],["பால துன்பங்கள் இன்பங்கள் படைத்தாய்! *","பற்றிலார் பற்ற நின்றானே! *","கால சக்கரத்தாய்! கடல் இடம் கொண்ட *","கடல் வண்ணா! கண்ணணே! என்னும் **","சேல் கொள் தண் புனல் சூழ் திருவரங்கத்தாய்!","என்னும் * என் தீர்த்தனே! என்னும் *","கோல மா மழைக் கண் பனி மல்க இருக்கும் *","என்னுடைக் கோமளக் கொழுந்தே"],0,"/media/recitation/TVM.7.2.7.mp3"],[3471,3471,["kozhundhu vAnavargaTku! ennum * kunREndhik","kO nirai kAththavan! ennum *","azhum thozhum Avi anala vevvuyirkkum *","anjchana vaNNanE! ennum **","ezhundhu mEl nOkki imaippilaL irukkum *","engnganE nOkkugEn? ennum *","sezhum thaDam punal sUzh thiruvaranggaththAy! *","en seygEn en thirumagaTkE?"],["கொழுந்து வானவர்கட்கு! என்னும் * குன்றேந்திக்","கோ நிரை காத்தவன்! என்னும் *","அழும் தொழும் ஆவி அனல வெவ்வுயிர்க்கும் *","அஞ்சன வண்ணனே! என்னும் **","எழுந்து மேல் நோக்கி இமைப்பிலள் இருக்கும் *","எங்ஙனே நோக்குகேன்? என்னும் *","செழும் தடம் புனல் சூழ் திருவரங்கத்தாய்! *","என் செய்கேன் என் திருமகட்கே?"],0,"/media/recitation/TVM.7.2.8.mp3"],[3472,3472,["** en thiru magaL sEr mArvanE! ennum","ennuDai AviyE! ennum *","nin thiru eyiRRAl iDandhu nI koNDa *","nila magaL kELvanE! ennum **","anRu uruvEzhum thazhuvi nI koNDa *","Ay magaL anbanE! ennum *","then thiruvaranggam kOyil koNDAnE! *","theLigilEn muDivu ivaL thanakkE"],["** என் திரு மகள் சேர் மார்வனே! என்னும்","என்னுடை ஆவியே! என்னும் *","நின் திரு எயிற்றால் இடந்து நீ கொண்ட *","நில மகள் கேள்வனே! என்னும் **","அன்று உருவேழும் தழுவி நீ கொண்ட *","ஆய் மகள் அன்பனே! என்னும் *","தென் திருவரங்கம் கோயில் கொண்டானே! *","தெளிகிலேன் முடிவு இவள் தனக்கே"],0,"/media/recitation/TVM.7.2.9.mp3"],[3473,3473,["muDivu ivaL thanakku onRu aRigilEn ennum *","mUvulagu ALiyE! ennum *","kaDi kamazh konRaich saDaiyanE! ennum *","nAnmugak kaDavuLE! ennum **","vaDivuDai vAnOr thalaivanE! ennum *","vaN thiruvarangganE! ennum *","aDi aDaiyAdhAL pOl ivaL aNugi","aDaindhanaL * mugil vaNNan aDiyE"],["முடிவு இவள் தனக்கு ஒன்று அறிகிலேன் என்னும் *","மூவுலகு ஆளியே! என்னும் *","கடி கமழ் கொன்றைச் சடையனே! என்னும் *","நான்முகக் கடவுளே! என்னும் **","வடிவுடை வானோர் தலைவனே! என்னும் *","வண் திருவரங்கனே! என்னும் *","அடி அடையாதாள் போல் இவள் அணுகி","அடைந்தனள் * முகில் வண்ணன் அடியே"],0,"/media/recitation/TVM.7.2.10.mp3"],[3474,3474,["** mugil vaNNan aDiyai aDaindhu aruL sUDi","uyndhavan * moy punal porunal *","thugil vaNNath thU nIrch sErppan * vaN pozhil sUzh","vaN kurugUrch saDakOpan **","mugil vaNNan aDi mEl sonna sol mAlai *","Ayiraththu ippaththum vallAr *","mugil vaNNa vAnaththu imaiyavar sUzha","iruppar * pEr inba veLLaththE"],["** முகில் வண்ணன் அடியை அடைந்து அருள் சூடி","உய்ந்தவன் * மொய் புனல் பொருநல் *","துகில் வண்ணத் தூ நீர்ச் சேர்ப்பன் * வண் பொழில் சூழ்","வண் குருகூர்ச் சடகோபன் **","முகில் வண்ணன் அடி மேல் சொன்ன சொல் மாலை *","ஆயிரத்து இப்பத்தும் வல்லார் *","முகில் வண்ண வானத்து இமையவர் சூழ","இருப்பர் * பேர் இன்ப வெள்ளத்தே"],0,"/media/recitation/TVM.7.2.11.mp3"]],[[3475,3475,["** veLLaich suri sanggoDu Azhi Endhith *","thAmaraik kaNNan en nenjchin UDE *","puLLaik kaDAginRa ARRaik kANIr *","en sollich sollugEn? annaimIrgAL! **","veLLach sugam avan vIRRirundha *","vEdha oliyum vizhA oliyum *","piLLaik kuzhA viLaiyATTu oliyum aRAth *","thiruppEreyil sErvan nAnE"],["** வெள்ளைச் சுரி சங்கொடு ஆழி ஏந்தித் *","தாமரைக் கண்ணன் என் நெஞ்சின் ஊடே *","புள்ளைக் கடாகின்ற ஆற்றைக் காணீர் *","என் சொல்லிச் சொல்லுகேன்? அன்னைமீர்காள்! **","வெள்ளச் சுகம் அவன் வீற்றிருந்த *","வேத ஒலியும் விழா ஒலியும் *","பிள்ளைக் குழா விளையாட்டு ஒலியும் அறாத் *","திருப்பேரெயில் சேர்வன் நானே"],0,"/media/recitation/TVM.7.3.1.mp3"],[3476,3476,["nAnak karungkuzhal thOzhimIrgAL! *","annaiyargAL! ayaRchEriyIrgAL! *","nAn iththani nenjcham kAkka mATTEn *","en vasam anRu idhu irAp pagal pOy **","thEn moyththa pUmpozhil thaNpaNai sUzh *","then thiruppEreyil vIRRirundha *","vAnap pirAn maNi vaNNan kaNNan *","sengkani vAyin thiRaththadhuvE"],["நானக் கருங்குழல் தோழிமீர்காள்! *","அன்னையர்காள்! அயற்சேரியீர்காள்! *","நான் இத்தனி நெஞ்சம் காக்க மாட்டேன் *","என் வசம் அன்று இது இராப் பகல் போய் **","தேன் மொய்த்த பூம்பொழில் தண்பணை சூழ் *","தென் திருப்பேரெயில் வீற்றிருந்த *","வானப் பிரான் மணி வண்ணன் கண்ணன் *","செங்கனி வாயின் திறத்ததுவே"],0,"/media/recitation/TVM.7.3.2.mp3"],[3477,3477,["sengkani vAyin thiRaththadhAyum *","senjchuDar nIL muDith thAzhndhadhAyum *","sanggoDu chakkaram kaNDugandhum *","thAmaraik kaNgaLukku aRRuth thIrndhum **","thinggaLum nALum vizhA aRAdha *","then thiruppEreyil vIRRirundha *","nanggaL pirAnukku en nenjcham thOzhI! *","nANum niRaiyum izhandhadhuvE"],["செங்கனி வாயின் திறத்ததாயும் *","செஞ்சுடர் நீள் முடித் தாழ்ந்ததாயும் *","சங்கொடு சக்கரம் கண்டுகந்தும் *","தாமரைக் கண்களுக்கு அற்றுத் தீர்ந்தும் **","திங்களும் நாளும் விழா அறாத *","தென் திருப்பேரெயில் வீற்றிருந்த *","நங்கள் பிரானுக்கு என் நெஞ்சம் தோழீ! *","நாணும் நிறையும் இழந்ததுவே"],0,"/media/recitation/TVM.7.3.3.mp3"],[3478,3478,["izhandha em mAmai thiRaththup pOna *","en nenjchinArum anggE ozhindhAr *","uzhandhu ini yAraik koNDu en usAkO? *","Odhak kaDal oli pOla ** enggum","ezhundha nal vEdhaththoli ninROnggu *","then thiruppEreyil vIRRirundha *","muzhanggu sanggak kaiyan mAyaththu AzhndhEn *","annaiyargAL! ennai en munindhE?"],["இழந்த எம் மாமை திறத்துப் போன *","என் நெஞ்சினாரும் அங்கே ஒழிந்தார் *","உழந்து இனி யாரைக் கொண்டு என் உசாகோ? *","ஓதக் கடல் ஒலி போல ** எங்கும்","எழுந்த நல் வேதத்தொலி நின்றோங்கு *","தென் திருப்பேரெயில் வீற்றிருந்த *","முழங்கு சங்கக் கையன் மாயத்து ஆழ்ந்தேன் *","அன்னையர்காள்! என்னை என் முனிந்தே?"],0,"/media/recitation/TVM.7.3.4.mp3"],[3479,3479,["munindhu sagaDam udhaiththu * mAyap","pEy mulai uNDu marudhiDai pOy *","kanindha viLavukkuk kanRu eRindha *","kaNNa pirAnukku en peNmai thORREn **","munindhu ini en seydhIr? annaimIrgAL! *","munni avan vandhu vIRRirundha *","kanindha pozhil thiruppEreyiRkE *","kAlam peRa ennaik kATTuminE"],["முனிந்து சகடம் உதைத்து * மாயப்","பேய் முலை உண்டு மருதிடை போய் *","கனிந்த விளவுக்குக் கன்று எறிந்த *","கண்ண பிரானுக்கு என் பெண்மை தோற்றேன் **","முனிந்து இனி என் செய்தீர்? அன்னைமீர்காள்! *","முன்னி அவன் வந்து வீற்றிருந்த *","கனிந்த பொழில் திருப்பேரெயிற்கே *","காலம் பெற என்னைக் காட்டுமினே"],0,"/media/recitation/TVM.7.3.5.mp3"],[3480,3480,["kAlam peRa ennaik kATTumingaL *","kAdhal kaDalin migap peridhAl *","nIla mugil vaNNaththu emperumAn *","niRkum munnE vandhu en kaikkum eydhAn **","njAlaththu avan vandhu vIRRirundha *","nAnmaRaiyALarum vELvi OvA *","kOlach senneRkaL kavari vIsum *","kUDu punal thiruppEreyiRkE"],["காலம் பெற என்னைக் காட்டுமின்கள் *","காதல் கடலின் மிகப் பெரிதால் *","நீல முகில் வண்ணத்து எம்பெருமான் *","நிற்கும் முன்னே வந்து என் கைக்கும் எய்தான் **","ஞாலத்து அவன் வந்து வீற்றிருந்த *","நான்மறையாளரும் வேள்வி ஓவா *","கோலச் செந்நெற்கள் கவரி வீசும் *","கூடு புனல் திருப்பேரெயிற்கே"],0,"/media/recitation/TVM.7.3.6.mp3"],[3481,3481,["pEr eyil sUzh kaDal then ilanggai *","seRRa pirAn vandhu vIRRirundha *","pEreyiRkE pukku en nenjcham nADip *","pErththu vara enggum kANa mATTEn **","Arai ini inggu uDaiyam? thOzhI! *","en nenjcham kUva vallArum illai *","Arai inik koNDu en sAdhikkinRadhu? *","en nenjcham kaNDadhuvE kaNDEnE"],["பேர் எயில் சூழ் கடல் தென் இலங்கை *","செற்ற பிரான் வந்து வீற்றிருந்த *","பேரெயிற்கே புக்கு என் நெஞ்சம் நாடிப் *","பேர்த்து வர எங்கும் காண மாட்டேன் **","ஆரை இனி இங்கு உடையம்? தோழீ! *","என் நெஞ்சம் கூவ வல்லாரும் இல்லை *","ஆரை இனிக் கொண்டு என் சாதிக்கின்றது? *","என் நெஞ்சம் கண்டதுவே கண்டேனே"],0,"/media/recitation/TVM.7.3.7.mp3"],[3482,3482,["kaNDadhuvE koNDu ellArum kUDik *","kArkkaDal vaNNanODu en thiRaththuk","koNDu * alar thURRiRRadhu mudhalAk *","koNDa en kAdhal uraikkil thOzhI! **","maNDiNi njAlamum Ezh kaDalum *","nIL visumbum kazhiyap peridhAl *","theNDirai sUzhndhu avan vIRRirundha *","then thiruppEreyil sErvan senRE"],["கண்டதுவே கொண்டு எல்லாரும் கூடிக் *","கார்க்கடல் வண்ணனோடு என் திறத்துக்","கொண்டு * அலர் தூற்றிற்றது முதலாக் *","கொண்ட என் காதல் உரைக்கில் தோழீ! **","மண்டிணி ஞாலமும் ஏழ் கடலும் *","நீள் விசும்பும் கழியப் பெரிதால் *","தெண்டிரை சூழ்ந்து அவன் வீற்றிருந்த *","தென் திருப்பேரெயில் சேர்வன் சென்றே"],0,"/media/recitation/TVM.7.3.8.mp3"],[3483,3483,["sErvan senRu ennuDaith thOzhimIrgAL! *","annaiyargAL! ennaith thERRa vENDA *","nIrgaL uraikkinRadhu en idhaRku? *","nenjchum niRaivum enakku inggu illai **","kAr vaNNan kArkkaDal njAlam uNDa *","kaNNa pirAn vandhu vIRRirundha *","Er vaLa oNkazhanip pazhanath *","then thiruppEreyin mA nagarE"],["சேர்வன் சென்று என்னுடைத் தோழிமீர்காள்! *","அன்னையர்காள்! என்னைத் தேற்ற வேண்டா *","நீர்கள் உரைக்கின்றது என் இதற்கு? *","நெஞ்சும் நிறைவும் எனக்கு இங்கு இல்லை **","கார் வண்ணன் கார்க்கடல் ஞாலம் உண்ட *","கண்ண பிரான் வந்து வீற்றிருந்த *","ஏர் வள ஒண்கழனிப் பழனத் *","தென் திருப்பேரெயின் மா நகரே"],0,"/media/recitation/TVM.7.3.9.mp3"],[3484,3484,["nagaramum nADum piRavum thErvEn *","nAN enakku illai en thOzhimIrgAL! *","sigara maNi neDu mADa nIDu *","thenthiruppEreyil vIRRirundha **","magara neDungkuzhaik kAdhan mAyan *","nURRuvarai anRu mangga nURRa *","nigaril mugil vaNNan nEmiyAn * en","nenjcham kavarndhu enai UzhiyAnE?"],["நகரமும் நாடும் பிறவும் தேர்வேன் *","நாண் எனக்கு இல்லை என் தோழிமீர்காள்! *","சிகர மணி நெடு மாட நீடு *","தெந்திருப்பேரெயில் வீற்றிருந்த **","மகர நெடுங்குழைக் காதன் மாயன் *","நூற்றுவரை அன்று மங்க நூற்ற *","நிகரில் முகில் வண்ணன் நேமியான் * என்","நெஞ்சம் கவர்ந்து எனை ஊழியானே?"],0,"/media/recitation/TVM.7.3.10.mp3"],[3485,3485,["** Uzhi thORUzhi uruvum pErum *","seygaiyum vERavan vaiyam kAkkum *","Azhi nIr vaNNanai achchudhanai *","aNi kurugUrch saDakOpan sonna **","kEzhil andhAdhi Or AyiraththuL","ivai * thiruppEreyil mEya paththum *","Azhi angkaiyanai Eththa vallAr","avar * aDimaith thiRaththu AzhiyArE"],["** ஊழி தோறூழி உருவும் பேரும் *","செய்கையும் வேறவன் வையம் காக்கும் *","ஆழி நீர் வண்ணனை அச்சுதனை *","அணி குருகூர்ச் சடகோபன் சொன்ன **","கேழில் அந்தாதி ஓர் ஆயிரத்துள்","இவை * திருப்பேரெயில் மேய பத்தும் *","ஆழி அங்கையனை ஏத்த வல்லார்","அவர் * அடிமைத் திறத்து ஆழியாரே"],0,"/media/recitation/TVM.7.3.11.mp3"]],[[3486,3486,["** Azhi ezhach * sanggum villum ezha * thisai","vAzhi ezhath * thaNDum vALum ezha ** aNDam","mOzhai ezha * muDi pAdham ezha * appan","Uzhi ezha * ulagam koNDa ARE"],["** ஆழி எழச் * சங்கும் வில்லும் எழ * திசை","வாழி எழத் * தண்டும் வாளும் எழ ** அண்டம்","மோழை எழ * முடி பாதம் எழ * அப்பன்","ஊழி எழ * உலகம் கொண்ட ஆறே"],0,"/media/recitation/TVM.7.4.1.mp3"],[3487,3487,["ARu malaikku * edhirndhu ODum oli * aravu","URu sulAy * malai thEykkum oli ** kaDal","mARu suzhanRu * azhaikkinRa oli * appan","sARu paDa * amudham koNDa nAnRE"],["ஆறு மலைக்கு * எதிர்ந்து ஓடும் ஒலி * அரவு","ஊறு சுலாய் * மலை தேய்க்கும் ஒலி ** கடல்","மாறு சுழன்று * அழைக்கின்ற ஒலி * அப்பன்","சாறு பட * அமுதம் கொண்ட நான்றே"],0,"/media/recitation/TVM.7.4.2.mp3"],[3488,3488,["nAnRila Ezh * maNNum thAnaththavE * pinnum","nAnRila Ezh * malai thAnaththavE ** pinnum","nAnRila Ezh * kaDal thAnaththavE * appan","UnRi iDandhu * eyiRRil koNDa nALE"],["நான்றில ஏழ் * மண்ணும் தானத்தவே * பின்னும்","நான்றில ஏழ் * மலை தானத்தவே ** பின்னும்","நான்றில ஏழ் * கடல் தானத்தவே * அப்பன்","ஊன்றி இடந்து * எயிற்றில் கொண்ட நாளே"],0,"/media/recitation/TVM.7.4.3.mp3"],[3489,3489,["nALum ezha * nila nIrum ezha * viNNum","kOLum ezha * eri kAlum ezha ** malai","thALum ezhach * suDar thAnum ezha * appan","ULi ezha * ulagam uNDa UNE"],["நாளும் எழ * நில நீரும் எழ * விண்ணும்","கோளும் எழ * எரி காலும் எழ ** மலை","தாளும் எழச் * சுடர் தானும் எழ * அப்பன்","ஊளி எழ * உலகம் உண்ட ஊணே"],0,"/media/recitation/TVM.7.4.4.mp3"],[3490,3490,["UN uDai mallar * thadharndha oli * mannar","AN uDaich sEnai * naDunggum oli ** viNNuL","EN uDaith dhEvar * veLippaTTa oli * appan","kANuDaip bAratham * kai aRai pOzhdhE"],["ஊண் உடை மல்லர் * ததர்ந்த ஒலி * மன்னர்","ஆண் உடைச் சேனை * நடுங்கும் ஒலி ** விண்ணுள்","ஏண் உடைத் தேவர் * வெளிப்பட்ட ஒலி * அப்பன்","காணுடைப் பாரதம் * கை அறை போழ்தே"],0,"/media/recitation/TVM.7.4.5.mp3"],[3491,3491,["pOzhdhu melindha * pun sekkaril * vAn thisai","sUzhum ezhundhu * udhirap punalA ** malai","kIzhdhu piLandha * singgam oththadhAl * appan","Azh thuyar seydhu * asuraraik kollum ARE"],["போழ்து மெலிந்த * புன் செக்கரில் * வான் திசை","சூழும் எழுந்து * உதிரப் புனலா ** மலை","கீழ்து பிளந்த * சிங்கம் ஒத்ததால் * அப்பன்","ஆழ் துயர் செய்து * அசுரரைக் கொல்லும் ஆறே"],0,"/media/recitation/TVM.7.4.6.mp3"],[3492,3492,["mARu niraiththu * iraikkum saranggaL * ina","nURu piNam * malai pOl puraLa ** kaDal","ARu maDuththu * udhirap punalA * appan","nIRu paDa * ilanggai seRRa nErE"],["மாறு நிரைத்து * இரைக்கும் சரங்கள் * இன","நூறு பிணம் * மலை போல் புரள ** கடல்","ஆறு மடுத்து * உதிரப் புனலா * அப்பன்","நீறு பட * இலங்கை செற்ற நேரே"],0,"/media/recitation/TVM.7.4.7.mp3"],[3493,3493,["nEr sarindhAn * koDik kOzhi koNDAn * pinnum","nEr sarindhAn * eriyum analOn ** pinnum","nEr sarindhAn * mukkaN mUrththi kaNDIr * appan","nEr sari vANan * thiN thOL koNDa anRE"],["நேர் சரிந்தான் * கொடிக் கோழி கொண்டான் * பின்னும்","நேர் சரிந்தான் * எரியும் அனலோன் ** பின்னும்","நேர் சரிந்தான் * முக்கண் மூர்த்தி கண்டீர் * அப்பன்","நேர் சரி வாணன் * திண் தோள் கொண்ட அன்றே"],0,"/media/recitation/TVM.7.4.8.mp3"],[3494,3494,["anRu maN nIr eri kAl * viN malai mudhal *","anRu suDar * iraNDu piRavum ** pinnum","anRu * mazhai uyir dhEvum maRRum * appan","anRu mudhal * ulagam seydhadhumE"],["அன்று மண் நீர் எரி கால் * விண் மலை முதல் *","அன்று சுடர் * இரண்டு பிறவும் ** பின்னும்","அன்று * மழை உயிர் தேவும் மற்றும் * அப்பன்","அன்று முதல் * உலகம் செய்ததுமே"],0,"/media/recitation/TVM.7.4.9.mp3"],[3495,3495,["mEy nirai kIzh puga * mA puraLa * sunai","vAy niRai nIr * piLiRich soriya ** ina","Anirai pADi * anggE oDungga * appan","thI mazhai kAththuk * kunRam eDuththAnE"],["மேய் நிரை கீழ் புக * மா புரள * சுனை","வாய் நிறை நீர் * பிளிறிச் சொரிய ** இன","ஆநிரை பாடி * அங்கே ஒடுங்க * அப்பன்","தீ மழை காத்துக் * குன்றம் எடுத்தானே"],0,"/media/recitation/TVM.7.4.10.mp3"],[3496,3496,["** kunRam eDuththa pirAn * aDiyAroDum *","onRi ninRa * saDakOpan urai seyal **","nanRi punaindha * Or AyiraththuL ivai *","venRi tharum paththum * mEvik kaRpArkkE"],["** குன்றம் எடுத்த பிரான் * அடியாரொடும் *","ஒன்றி நின்ற * சடகோபன் உரை செயல் **","நன்றி புனைந்த * ஓர் ஆயிரத்துள் இவை *","வென்றி தரும் பத்தும் * மேவிக் கற்பார்க்கே"],0,"/media/recitation/TVM.7.4.11.mp3"]],[[3497,3497,["** kaRpAr irAma pirAnai allAl * maRRum kaRparO? *","puRpA mudhalAp * pul eRumbAdhi onRu inRiyE **","naRpAl ayOdhdhiyil vAzhum * charAcharam muRRavum *","naRpAlukku uyththanan * nAnmuganAr peRRa nATTuLE"],["** கற்பார் இராம பிரானை அல்லால் * மற்றும் கற்பரோ? *","புற்பா முதலாப் * புல் எறும்பாதி ஒன்று இன்றியே **","நற்பால் அயோத்தியில் வாழும் * சராசரம் முற்றவும் *","நற்பாலுக்கு உய்த்தனன் * நான்முகனார் பெற்ற நாட்டுளே"],0,"/media/recitation/TVM.7.5.1.mp3"],[3498,3498,["nATTil piRandhavar * nAraNaRku AL anRi AvarO? *","nATTil piRandhu * paDAdhana paTTu manisarkkA **","nATTai naliyum arakkarai * nADith thaDindhiTTu *","nATTai aLiththu uyyach seydhu * naDandhamai kETTumE"],["நாட்டில் பிறந்தவர் * நாரணற்கு ஆள் அன்றி ஆவரோ? *","நாட்டில் பிறந்து * படாதன பட்டு மனிசர்க்கா **","நாட்டை நலியும் அரக்கரை * நாடித் தடிந்திட்டு *","நாட்டை அளித்து உய்யச் செய்து * நடந்தமை கேட்டுமே"],0,"/media/recitation/TVM.7.5.2.mp3"],[3499,3499,["kETpArgaL kEsavan kIrththi allAl * maRRum kETparO? *","kETpAr sevi suDu * kIzhmai vasavugaLE vaiyum **","sETpAl pazham pagaivan * sisupAlan * thiruvaDi","thATpAl aDaindha * thanmai aRivArai aRindhumE"],["கேட்பார்கள் கேசவன் கீர்த்தி அல்லால் * மற்றும் கேட்பரோ? *","கேட்பார் செவி சுடு * கீழ்மை வசவுகளே வையும் **","சேட்பால் பழம் பகைவன் * சிசுபாலன் * திருவடி","தாட்பால் அடைந்த * தன்மை அறிவாரை அறிந்துமே"],0,"/media/recitation/TVM.7.5.3.mp3"],[3500,3500,["thanmai aRipavar thAm * avaRku AL anRi AvarO? *","panmaip paDar poruL * Adhumil pAzh neDungkAlaththu **","nanmaip punal paNNi * nAnmuganaip paNNi * than uLLE","thonmai mayakkiya * thORRiya sUzhalgaL sindhiththE"],["தன்மை அறிபவர் தாம் * அவற்கு ஆள் அன்றி ஆவரோ? *","பன்மைப் படர் பொருள் * ஆதுமில் பாழ் நெடுங்காலத்து **","நன்மைப் புனல் பண்ணி * நான்முகனைப் பண்ணி * தன் உள்ளே","தொன்மை மயக்கிய * தோற்றிய சூழல்கள் சிந்தித்தே"],0,"/media/recitation/TVM.7.5.4.mp3"],[3501,3501,["sUzhalgaL sindhikkil * mAyan kazhal anRich sUzhvarO? *","Azhap perum punal thannuL * azhundhiya njAlaththai **","thAzhappaDAmal * than pAl oru kOTTiDaith thAn koNDa *","kEzhal thiru uru AyiRRuk * kETTum uNarndhumE"],["சூழல்கள் சிந்திக்கில் * மாயன் கழல் அன்றிச் சூழ்வரோ? *","ஆழப் பெரும் புனல் தன்னுள் * அழுந்திய ஞாலத்தை **","தாழப்படாமல் * தன் பால் ஒரு கோட்டிடைத் தான் கொண்ட *","கேழல் திரு உரு ஆயிற்றுக் * கேட்டும் உணர்ந்துமே"],0,"/media/recitation/TVM.7.5.5.mp3"],[3502,3502,["kETTum uNarndhavar * kEsavaRku AL anRi AvarO? *","vATTamilA vaN kai * mAvali vAdhikka vAdhippu uNDu **","ITTangkoL dhEvargaL * senRu irandhArkku iDar nIkkiya *","kOTTangkai vAmananAych * seydha kUththukkaL kaNDumE"],["கேட்டும் உணர்ந்தவர் * கேசவற்கு ஆள் அன்றி ஆவரோ? *","வாட்டமிலா வண் கை * மாவலி வாதிக்க வாதிப்பு உண்டு **","ஈட்டங்கொள் தேவர்கள் * சென்று இரந்தார்க்கு இடர் நீக்கிய *","கோட்டங்கை வாமனனாய்ச் * செய்த கூத்துக்கள் கண்டுமே"],0,"/media/recitation/TVM.7.5.6.mp3"],[3503,3503,["kaNDum theLindhum kaRRAr * kaNNaRku AL anRi AvarO? *","vaNDuN malarththonggal * mArkkaNDEyanukku vAzhu nAL **","iNDaich saDai muDi * Isan uDan koNDu usAch sella *","koNDangguth thannoDum koNDu * uDan senRadhu uNarndhumE"],["கண்டும் தெளிந்தும் கற்றார் * கண்ணற்கு ஆள் அன்றி ஆவரோ? *","வண்டுண் மலர்த்தொங்கல் * மார்க்கண்டேயனுக்கு வாழு நாள் **","இண்டைச் சடை முடி * ஈசன் உடன் கொண்டு உசாச் செல்ல *","கொண்டங்குத் தன்னொடும் கொண்டு * உடன் சென்றது உணர்ந்துமே"],0,"/media/recitation/TVM.7.5.7.mp3"],[3504,3504,["sella uNarndhavar * selvan than sIr anRik kaRparO? *","ellai ilAdha perum thavaththAl * pala sey miRai **","allal amararaich seyyum * iraNiyan Agaththai *","mallal ari uruvAych * seydha mAyam aRindhumE"],["செல்ல உணர்ந்தவர் * செல்வன் தன் சீர் அன்றிக் கற்பரோ? *","எல்லை இலாத பெரும் தவத்தால் * பல செய் மிறை **","அல்லல் அமரரைச் செய்யும் * இரணியன் ஆகத்தை *","மல்லல் அரி உருவாய்ச் * செய்த மாயம் அறிந்துமே"],0,"/media/recitation/TVM.7.5.8.mp3"],[3505,3505,["mAyam aRibavar * mAyavaRku AL anRi AvarO? *","thAyam seRum oru nURRuvar mangga * Or aivarkkAy **","thEsam aRiya Or sAradhiyAych senRu * sEnaiyai","nAsam seydhiTTu * naDandha nal vArththai aRindhumE"],["மாயம் அறிபவர் * மாயவற்கு ஆள் அன்றி ஆவரோ? *","தாயம் செறும் ஒரு நூற்றுவர் மங்க * ஓர் ஐவர்க்காய் **","தேசம் அறிய ஓர் சாரதியாய்ச் சென்று * சேனையை","நாசம் செய்திட்டு * நடந்த நல் வார்த்தை அறிந்துமே"],0,"/media/recitation/TVM.7.5.9.mp3"],[3506,3506,["** vArththai aRibavar * mAyavaRku AL anRi AvarO? *","pOrththa piRappoDu nOyODu mUppoDu * iRappu ivai","pErththu ** perunthunbam vEr aRa nIkkith * than thALin kIzhch","sErththu * avan seyyum * sEmaththai eNNith theLivuRRE"],["** வார்த்தை அறிபவர் * மாயவற்கு ஆள் அன்றி ஆவரோ? *","போர்த்த பிறப்பொடு நோயோடு மூப்பொடு * இறப்பு இவை","பேர்த்து ** பெருந்துன்பம் வேர் அற நீக்கித் * தன் தாளின் கீழ்ச்","சேர்த்து * அவன் செய்யும் * சேமத்தை எண்ணித் தெளிவுற்றே"],0,"/media/recitation/TVM.7.5.10.mp3"],[3507,3507,["** theLivuRRu vIvinRi ninRavarkku * inbak kadhi seyyum *","theLivuRRa kaNNanaith * thenkurugUrch saDakOpan sol **","theLivuRRa AyiraththuL * ivai paththum vallAr avar *","theLivuRRa sindhaiyar * pA maru mUvulagaththu uLLE"],["** தெளிவுற்று வீவின்றி நின்றவர்க்கு * இன்பக் கதி செய்யும் *","தெளிவுற்ற கண்ணனைத் * தென்குருகூர்ச் சடகோபன் சொல் **","தெளிவுற்ற ஆயிரத்துள் * இவை பத்தும் வல்லார் அவர் *","தெளிவு உற்ற சிந்தையர் * பா மரு மூவுலகத்து உள்ளே"],0,"/media/recitation/TVM.7.5.11.mp3"]],[[3508,3508,["** pA maru mUvulagum paDaiththa *","paRpanAbAvO? *","pA maru mUvulagum aLandha *","paRpa pAdhAvO? **","thAmaraik kaNNAvO! * thaniyEn","thani ALAvO! *","thAmaraik kaiyAvO! * unnai","enRu kol sErvadhuvE?"],["** பா மரு மூவுலகும் படைத்த *","பற்பநாபாவோ? *","பா மரு மூவுலகும் அளந்த *","பற்ப பாதாவோ? **","தாமரைக் கண்ணாவோ! * தனியேன்","தனி ஆளாவோ! *","தாமரைக் கையாவோ! * உன்னை","என்று கொல் சேர்வதுவே?"],0,"/media/recitation/TVM.7.6.1.mp3"],[3509,3509,["enRu kol sErvadhu? andhO! * aran","nAnmugan Eththum * seyya","nin thirup pAdhaththai yAn * nilam","nIr eri kAl ** viN uyir","enRa ivai thAm mudhalA * muRRumAy","ninRa endhAyO! *","kunRu eDuththu Anirai mEyththu * avai","kAththa em kUththAvO!"],["என்று கொல் சேர்வது? அந்தோ! * அரன்","நான்முகன் ஏத்தும் * செய்ய","நின் திருப் பாதத்தை யான் * நிலம்","நீர் எரி கால் ** விண் உயிர்","என்ற இவை தாம் முதலா * முற்றுமாய்","நின்ற எந்தாயோ! *","குன்று எடுத்து ஆநிரை மேய்த்து * அவை","காத்த எம் கூத்தாவோ!"],0,"/media/recitation/TVM.7.6.2.mp3"],[3510,3510,["kAththa em kUththAvO! * malai Endhik","kal mAri thannai *","pUth thaNthuzhAy muDiyAy! * punai","konRai anjchenjchaDaiyAy! **","vAyththa en nAnmuganE! * vandhu en","Ar uyir nI AnAl *","Eththarum kIrththiyinAy! * unnai","engguth thalaippeyvanE?"],["காத்த எம் கூத்தாவோ! * மலை ஏந்திக்","கல் மாரி தன்னை *","பூத் தண்துழாய் முடியாய்! * புனை","கொன்றை அஞ்செஞ்சடையாய்! **","வாய்த்த என் நான்முகனே! * வந்து என்","ஆர் உயிர் நீ ஆனால் *","ஏத்தரும் கீர்த்தியினாய்! * உன்னை","எங்குத் தலைப்பெய்வனே?"],0,"/media/recitation/TVM.7.6.3.mp3"],[3511,3511,["engguth thalaippeyvan nAn? * ezhil","mUvulagum nIyE *","anggu uyar mukkaN pirAn *","pirama perumAn avan nI **","vengkadhir vachchirak kai *","indhiran mudhalAth dheyvam nI *","konggalar thaNNanthuzhAy muDi *","ennuDaik kOvalanE!"],["எங்குத் தலைப்பெய்வன் நான்? * எழில்","மூவுலகும் நீயே *","அங்கு உயர் முக்கண் பிரான் *","பிரம பெருமான் அவன் நீ **","வெங்கதிர் வச்சிரக் கை *","இந்திரன் முதலாத் தெய்வம் நீ *","கொங்கலர் தண்ணந்துழாய் முடி *","என்னுடைக் கோவலனே!"],0,"/media/recitation/TVM.7.6.4.mp3"],[3512,3512,["ennuDaik kOvalanE! * en","pollAk karu mANikkamE! *","unnuDai undhi malar * ulagam","avai mUnRum parandhu **","unnuDaich sOdhi veLLaththu * agampAl","unnaik kaNDu koNDiTTu *","ennuDai AruyirAr * engnganE","kol vandhu eydhuvarE?"],["என்னுடைக் கோவலனே! * என்","பொல்லாக் கரு மாணிக்கமே! *","உன்னுடை உந்தி மலர் * உலகம்","அவை மூன்றும் பரந்து **","உன்னுடைச் சோதி வெள்ளத்து * அகம்பால்","உன்னைக் கண்டு கொண்டிட்டு *","என்னுடை ஆருயிரார் * எங்ஙனே","கொல் வந்து எய்துவரே?"],0,"/media/recitation/TVM.7.6.5.mp3"],[3513,3513,["vandhu eydhum ARu aRiyEn * malgu","nIlach chuDar thazhaippa *","senjchuDarch sOdhigaL pUththu * oru","mANikkam sErvadhu pOl **","andhara mEl sempaTTODu * aDi","undhi kai mArvu kaN vAy *","senjchuDarch sOdhi viDa uRai *","en thirumArbanaiyE"],["வந்து எய்தும் ஆறு அறியேன் * மல்கு","நீலச் சுடர் தழைப்ப *","செஞ்சுடர்ச் சோதிகள் பூத்து * ஒரு","மாணிக்கம் சேர்வது போல் **","அந்தர மேல் செம்பட்டோடு * அடி","உந்தி கை மார்வு கண் வாய் *","செஞ்சுடர்ச் சோதி விட உறை *","என் திருமார்பனையே"],0,"/media/recitation/TVM.7.6.6.mp3"],[3514,3514,["en thirumArban thannai * en","malai magaL kURan thannai *","enRum en nA magaLai * agampAl","koNDa nAnmuganai *","ninRa sasI pathiyai * nilam","kINDu eyil mUnRu eriththa *","venRu pulam thurandha *","visumbu ALiyaik kANEnO!"],["என் திருமார்பன் தன்னை * என்","மலை மகள் கூறன் தன்னை *","என்றும் என் நா மகளை * அகம்பால்","கொண்ட நான்முகனை *","நின்ற சசீ பதியை * நிலம்","கீண்டு எயில் மூன்று எரித்த *","வென்று புலம் துரந்த *","விசும்பு ஆளியைக் காணேனோ!"],0,"/media/recitation/TVM.7.6.7.mp3"],[3515,3515,["ALiyaik kANbariyAy * ari kAN","nariyAy * arakkar","ULaiyiTTu anRu ilanggai kaDandhu *","pilam pukku oLippa **","mILi ampuLLaik kaDAy * viRal","mAliyaik konRu * pinnum","AL uyar kunRanggaL seydhu *","aDarththAnaiyum kANDungkolO?"],["ஆளியைக் காண்பரியாய் * அரி காண்","நரியாய் * அரக்கர்","ஊளையிட்டு அன்று இலங்கை கடந்து *","பிலம் புக்கு ஒளிப்ப **","மீளி அம்புள்ளைக் கடாய் * விறல்","மாலியைக் கொன்று * பின்னும்","ஆள் உயர் குன்றங்கள் செய்து *","அடர்த்தானையும் காண்டுங்கொலோ?"],0,"/media/recitation/TVM.7.6.8.mp3"],[3516,3516,["kANDungkolO? nenjchamE! * kaDiya","vinaiyE muyalum *","ANDiRal mILi moymbin *","arakkan kulaththaith thaDindhu **","mINDum avan thambikkE *","viri nIr ilanggai aruLi *","ANDu than sOdhi pukka *","amarar ari ERRinaiyE"],["காண்டுங்கொலோ? நெஞ்சமே! * கடிய","வினையே முயலும் *","ஆண்டிறல் மீளி மொய்ம்பின் *","அரக்கன் குலத்தைத் தடிந்து **","மீண்டும் அவன் தம்பிக்கே *","விரி நீர் இலங்கை அருளி *","ஆண்டு தன் சோதி புக்க *","அமரர் அரி ஏற்றினையே"],0,"/media/recitation/TVM.7.6.9.mp3"],[3517,3517,["ERRarum vaikundhaththai * aruLum","namakku * Ayar kulaththu","IRRiLam piLLai onRAyp pukku *","mAyanggaLE iyaRRi **","kURRiyal kanjchanaik konRu * aivarkkAyk","koDunjchEnai thaDindhu *","ARRal mikkAn * periya","paranjchOdhi pukka ariyE"],["ஏற்றரும் வைகுந்தத்தை * அருளும்","நமக்கு * ஆயர் குலத்து","ஈற்றிளம் பிள்ளை ஒன்றாய்ப் புக்கு *","மாயங்களே இயற்றி **","கூற்றியல் கஞ்சனைக் கொன்று * ஐவர்க்காய்க்","கொடுஞ்சேனை தடிந்து *","ஆற்றல் மிக்கான் * பெரிய","பரஞ்சோதி புக்க அரியே"],0,"/media/recitation/TVM.7.6.10.mp3"],[3518,3518,["** pukka ari uruvAy * avuNan","uDal kINDu ugandha *","chakkarach selvan thannaik *","kurugUrch saDakOpan sonna **","mikka Or AyiraththuL * ivai","paththum vallAr avarai *","thokkup pallANDu isaiththuk *","kavari seyvar EzhaiyarE"],["** புக்க அரி உருவாய் * அவுணன்","உடல் கீண்டு உகந்த *","சக்கரச் செல்வன் தன்னைக் *","குருகூர்ச் சடகோபன் சொன்ன **","மிக்க ஓர் ஆயிரத்துள் * இவை","பத்தும் வல்லார் அவரை *","தொக்குப் பல்லாண்டு இசைத்துக் *","கவரி செய்வர் ஏழையரே"],0,"/media/recitation/TVM.7.6.11.mp3"]],[[3519,3519,["** Ezhaiyar Avi uNNum * iNaik","kURRangkolO? aRiyEn *","Azhi angkaNNa pirAn * thiruk kaNgaL","kolO? aRiyEn **","sUzhavum thAmarai nANmalar","pOl * vandhu thOnRum kaNDIr *","thOzhiyargAL! annaimIr! * en","seygEn? thuyarATTiyEnE"],["** ஏழையர் ஆவி உண்ணும் * இணைக்","கூற்றங்கொலோ? அறியேன் *","ஆழி அங்கண்ண பிரான் * திருக் கண்கள்","கொலோ? அறியேன் **","சூழவும் தாமரை நாண்மலர்","போல் * வந்து தோன்றும் கண்டீர் *","தோழியர்காள்! அன்னைமீர்! * என்","செய்கேன்? துயராட்டியேனே"],0,"/media/recitation/TVM.7.7.1.mp3"],[3520,3520,["ATTiyum thURRiyum ninRu * annaimIr!","ennai nIr nalindhu en? *","mATTuyar kaRpagaththin * valliyO?","kozhundhO? aRiyEn **","ITTiya veNNey uNDAn * thiru mUkku","enadhu Avi uLLE *","mATTiya val viLakkin *","suDarAy niRkum vAliyadhE"],["ஆட்டியும் தூற்றியும் நின்று * அன்னைமீர்!","என்னை நீர் நலிந்து என்? *","மாட்டுயர் கற்பகத்தின் * வல்லியோ?","கொழுந்தோ? அறியேன் **","ஈட்டிய வெண்ணெய் உண்டான் * திரு மூக்கு","எனது ஆவி உள்ளே *","மாட்டிய வல் விளக்கின் *","சுடராய் நிற்கும் வாலியதே"],0,"/media/recitation/TVM.7.7.2.mp3"],[3521,3521,["vAliyadhOr kani kol? *","vinaiyATTiyEn val vinai kol? *","kOlam thiraL pavaLak *","kozhunthuNDam kolO? aRiyEn **","nIla neDu mugil pOl * thiru mEni","ammAn thoNDai vAy *","Elum thisaiyuL ellAm * vandhu","thOnRum en innuyirkkE"],["வாலியதோர் கனி கொல்? *","வினையாட்டியேன் வல் வினை கொல்? *","கோலம் திரள் பவளக் *","கொழுந்துண்டம் கொலோ? அறியேன் **","நீல நெடு முகில் போல் * திரு மேனி","அம்மான் தொண்டை வாய் *","ஏலும் திசையுள் எல்லாம் * வந்து","தோன்றும் என் இன்னுயிர்க்கே"],0,"/media/recitation/TVM.7.7.3.mp3"],[3522,3522,["innuyirkku Ezhaiyar mEl * vaLaiyum","iNai nIla viRkol? *","manniya sIr madhanan * karuppuch","silai kol? ** madhanan","thannuyirth thAdhai * kaNNa perumAn","puruvam avaiyE *","ennuyir mElanavAy *","aDuginRana enRu ninRE"],["இன்னுயிர்க்கு ஏழையர் மேல் * வளையும்","இணை நீல விற்கொல்? *","மன்னிய சீர் மதனன் * கருப்புச்","சிலை கொல்? ** மதனன்","தன்னுயிர்த் தாதை * கண்ண பெருமான்","புருவம் அவையே *","என்னுயிர் மேலனவாய் *","அடுகின்றன என்று நின்றே"],0,"/media/recitation/TVM.7.7.4.mp3"],[3523,3523,["enRu ninRE thigazhum * seyya In","suDar veN minnuk kol? *","anRi ennAvi aDum *","aNi muththangkolO? aRiyEn **","kunRam eDuththa pirAn *","muRuval enadhAvi aDum *","onRum aRiginRilEn * annaimIr!","enakku uyviDamE"],["என்று நின்றே திகழும் * செய்ய ஈன்","சுடர் வெண் மின்னுக் கொல்? *","அன்றி என்னாவி அடும் *","அணி முத்தங்கொலோ? அறியேன் **","குன்றம் எடுத்த பிரான் *","முறுவல் எனதாவி அடும் *","ஒன்றும் அறிகின்றிலேன் * அன்னைமீர்!","எனக்கு உய்விடமே"],0,"/media/recitation/TVM.7.7.5.mp3"],[3524,3524,["uyviDam Ezhaiyarkkum *","asurarkkum arakkargaTkum *","evviDam? enRu ilanggi * magaram","thazhaikkum thaLirkol? **","pai viDap pAmbaNaiyAn *","thiruk kuNDalak kAdhugaLE **","kaiviDal onRum inRi *","aDuginRana kANmingaLE"],["உய்விடம் ஏழையர்க்கும் *","அசுரர்க்கும் அரக்கர்கட்கும் *","எவ்விடம்? என்று இலங்கி * மகரம்","தழைக்கும் தளிர்கொல்? **","பை விடப் பாம்பணையான் *","திருக் குண்டலக் காதுகளே **","கைவிடல் ஒன்றும் இன்றி *","அடுகின்றன காண்மின்களே"],0,"/media/recitation/TVM.7.7.6.mp3"],[3525,3525,["kANmingaL annaiyargAL! enRu *","kATTum vagai aRiyEn *","nAL mannu veNthinggaL kol? *","nayandhArgaTku nachchilai kol? **","sEN mannu nAl thaDanthOL *","perumAn than thiru nudhalE *","kOL manni Avi aDum * koDiyEn","uyir kOL izhaiththE"],["காண்மின்கள் அன்னையர்காள்! என்று *","காட்டும் வகை அறியேன் *","நாள் மன்னு வெண்திங்கள் கொல்? *","நயந்தார்கட்கு நச்சிலை கொல்? **","சேண் மன்னு நால் தடந்தோள் *","பெருமான் தன் திரு நுதலே *","கோள் மன்னி ஆவி அடும் * கொடியேன்","உயிர் கோள் இழைத்தே"],0,"/media/recitation/TVM.7.7.7.mp3"],[3526,3526,["kOL izhaith thAmaraiyum *","koDiyum pavaLamum villum *","kOL izhaith thaN muththamum *","thaLirum kuLir vAn piRaiyum **","kOL izhaiyA uDaiya * kozhunjchOdhi","vaTTangkol? * kaNNan","kOL izhai vANmugamAyk * koDiyEn","uyir koLginRadhE"],["கோள் இழைத் தாமரையும் *","கொடியும் பவளமும் வில்லும் *","கோள் இழைத் தண் முத்தமும் *","தளிரும் குளிர் வான் பிறையும் **","கோள் இழையா உடைய * கொழுஞ்சோதி","வட்டங்கொல்? * கண்ணன்","கோள் இழை வாண்முகமாய்க் * கொடியேன்","உயிர் கொள்கின்றதே"],0,"/media/recitation/TVM.7.7.8.mp3"],[3527,3527,["koLginRa kOL iruLaich *","sugirndhiTTa kozhunjchuruLin *","uL koNDa nIla nannUl thazhai","kol? * anRu mAyan kuzhal **","viLginRa pUnthaN thuzhAy * virai","nARa vandhu en uyirai *","kaLginRa ARu aRiyIr * annaimIr!","kazhaRA niRRirE"],["கொள்கின்ற கோள் இருளைச் *","சுகிர்ந்திட்ட கொழுஞ்சுருளின் *","உள் கொண்ட நீல நன்னூல் தழை","கொல்? * அன்று மாயன் குழல் **","விள்கின்ற பூந்தண் துழாய் * விரை","நாற வந்து என் உயிரை *","கள்கின்ற ஆறு அறியீர் * அன்னைமீர்!","கழறா நிற்றிரே"],0,"/media/recitation/TVM.7.7.9.mp3"],[3528,3528,["niRRi muRRaththuL enRu * neriththa","kaiyarAy * ennai nIr","suRRiyum sUzhndhum vaidhir * suDarch","sOdhi maNi niRamAy **","muRRa immUvulagum *","viriginRa suDar muDikkE *","oRRumaik koNDadhu uLLam * annaimIr!","nasai en nunggaTkE?"],["நிற்றி முற்றத்துள் என்று * நெரித்த","கையராய் * என்னை நீர்","சுற்றியும் சூழ்ந்தும் வைதிர் * சுடர்ச்","சோதி மணி நிறமாய் **","முற்ற இம்மூவுலகும் *","விரிகின்ற சுடர் முடிக்கே *","ஒற்றுமைக் கொண்டது உள்ளம் * அன்னைமீர்!","நசை என் நுங்கட்கே?"],0,"/media/recitation/TVM.7.7.10.mp3"],[3529,3529,["** kaTkariya piraman sivan *","indhiran enRu ivarkkum *","kaTkariya kaNNanaik *","kurugUrch saDakOpan sonna **","uTkuDai AyiraththuL * ivaiyum","oru paththum vallAr *","uTkuDai vAnavarODu *","uDanAy enRum mAyArE"],["** கட்கரிய பிரமன் சிவன் *","இந்திரன் என்று இவர்க்கும் *","கட்கரிய கண்ணனைக் *","குருகூர்ச் சடகோபன் சொன்ன **","உட்குடை ஆயிரத்துள் * இவையும்","ஒரு பத்தும் வல்லார் *","உட்குடை வானவரோடு *","உடனாய் என்றும் மாயாரே"],0,"/media/recitation/TVM.7.7.11.mp3"]],[[3530,3530,["** mAyA! vAmananE! * madhusUdhA! nI aruLAy *","thIyAy nIrAy nilanAy * visumbAyk kAlAy **","thAyAy thandhaiyAy * makkaLAy maRRumAy muRRumAy *","nIyAy nI ninRa ARu * ivai enna niyAyanggaLE!"],["** மாயா! வாமனனே! * மதுசூதா! நீ அருளாய் *","தீயாய் நீராய் நிலனாய் * விசும்பாய்க் காலாய் **","தாயாய் தந்தையாய் * மக்களாய் மற்றுமாய் முற்றுமாய் *","நீயாய் நீ நின்ற ஆறு * இவை என்ன நியாயங்களே!"],0,"/media/recitation/TVM.7.8.1.mp3"],[3531,3531,["angkaN malarth thaN thuzhAy muDi * achchudhanE! aruLAy *","thinggaLum njAyiRumAych * sezhum pal suDarAy iruLAy **","ponggu pozhi mazhaiyAyp * pugazhAyp pazhiyAyp pinnum nI *","vengkaN vengkURRamumAy * ivai enna vichiththiramE!"],["அங்கண் மலர்த் தண் துழாய் முடி * அச்சுதனே! அருளாய் *","திங்களும் ஞாயிறுமாய்ச் * செழும் பல் சுடராய் இருளாய் **","பொங்கு பொழி மழையாய்ப் * புகழாய்ப் பழியாய்ப் பின்னும் நீ *","வெங்கண் வெங்கூற்றமுமாய் * இவை என்ன விசித்திரமே!"],0,"/media/recitation/TVM.7.8.2.mp3"],[3532,3532,["chiththirath thEr valavA! * thiruch chakkaraththAy! aruLAy *","eththanai Or ugamum * avaiyAy avaRRuL iyalum **","oththa oN pal poruLgaL * ulappu illanavAy viyavAy *","viththagaththAy niRRi nI * ivai enna viDamanggaLE!"],["சித்திரத் தேர் வலவா! * திருச் சக்கரத்தாய்! அருளாய் *","எத்தனை ஓர் உகமும் * அவையாய் அவற்றுள் இயலும் **","ஒத்த ஒண் பல் பொருள்கள் * உலப்பு இல்லனவாய் வியவாய் *","வித்தகத்தாய் நிற்றி நீ * இவை என்ன விடமங்களே!"],0,"/media/recitation/TVM.7.8.3.mp3"],[3533,3533,["kaLLavizh thAmaraik kaN * kaNNanE! enakku onRu aruLAy *","uLLadhum illadhumAy * ulappu illanavAy viyavAy **","veLLath thaDangkaDaluL * viDa nAgaNai mEl maruvi *","uLLap pal yOgu seydhi * ivai enna upAyanggaLE!"],["கள்ளவிழ் தாமரைக் கண் * கண்ணனே! எனக்கு ஒன்று அருளாய் *","உள்ளதும் இல்லதுமாய் * உலப்பு இல்லனவாய் வியவாய் **","வெள்ளத் தடங்கடலுள் * விட நாகணை மேல் மருவி *","உள்ளப் பல் யோகு செய்தி * இவை என்ன உபாயங்களே!"],0,"/media/recitation/TVM.7.8.4.mp3"],[3534,3534,["pAsanggaL nIkki ennai * unakkE aRak koNDiTTu nI *","vAsa malarth thaN thuzhAy muDi * mAyavanE! aruLAy **","kAyamum sIvanumAyk * kazhivAyp piRappAyp pinnum nI *","mAyanggaL seydhu vaiththi * ivai enna mayakkukkaLE!"],["பாசங்கள் நீக்கி என்னை * உனக்கே அறக் கொண்டிட்டு நீ *","வாச மலர்த் தண் துழாய் முடி * மாயவனே! அருளாய் **","காயமும் சீவனுமாய்க் * கழிவாய்ப் பிறப்பாய்ப் பின்னும் நீ *","மாயங்கள் செய்து வைத்தி * இவை என்ன மயக்குக்களே!"],0,"/media/recitation/TVM.7.8.5.mp3"],[3535,3535,["mayakkA! vAmananE! * madhi Am vaNNam onRu aruLAy *","ayarppAyth thERRamumAy * azhalAyk kuLirAy viyavAy **","viyappAy venRigaLAy * vinaiyAyp payanAyp pinnum nI *","thuyakkA nI ninRa ARu * ivai enna thuyaranggaLE!"],["மயக்கா! வாமனனே! * மதி ஆம் வண்ணம் ஒன்று அருளாய் *","அயர்ப்பாய்த் தேற்றமுமாய் * அழலாய்க் குளிராய் வியவாய் **","வியப்பாய் வென்றிகளாய் * வினையாய்ப் பயனாய்ப் பின்னும் நீ *","துயக்கா நீ நின்ற ஆறு * இவை என்ன துயரங்களே!"],0,"/media/recitation/TVM.7.8.6.mp3"],[3536,3536,["thuyaranggaL seyyum kaNNA! * suDar nIL muDiyAy! aruLAy *","thuyaram sey mAnanggaLAy * madhan Agi ugavaigaLAy **","thuyaram sey kAmanggaLAyth * thulaiyAy nilaiyAy naDaiyAy *","thuyaranggaL seydhu vaiththi * ivai enna suNDAyanggaLE!"],["துயரங்கள் செய்யும் கண்ணா! * சுடர் நீள் முடியாய்! அருளாய் *","துயரம் செய் மானங்களாய் * மதன் ஆகி உகவைகளாய் **","துயரம் செய் காமங்களாய்த் * துலையாய் நிலையாய் நடையாய் *","துயரங்கள் செய்து வைத்தி * இவை என்ன சுண்டாயங்களே!"],0,"/media/recitation/TVM.7.8.7.mp3"],[3537,3537,["enna suNDAyanggaLAl * ninRiTTAy? ennai ALum kaNNA! *","innadhOr thanmaiyai enRu unnai * yAvarkkum thERRa ariyai **","munniya mUvulagum * avaiyAy avaRRaip paDaiththu *","pinnum uLLAy! puRaththAy! * ivai enna iyaRkaigaLE!"],["என்ன சுண்டாயங்களால் * நின்றிட்டாய்? என்னை ஆளும் கண்ணா! *","இன்னதோர் தன்மையை என்று உன்னை * யாவர்க்கும் தேற்ற அரியை **","முன்னிய மூவுலகும் * அவையாய் அவற்றைப் படைத்து *","பின்னும் உள்ளாய்! புறத்தாய்! * இவை என்ன இயற்கைகளே!"],0,"/media/recitation/TVM.7.8.8.mp3"],[3538,3538,["enna iyaRkaigaLAl * engnganE ninRiTTAy? en kaNNA! *","thunnu kara charaNam mudhalAga * ellA uRuppum **","unnu suvai oLi * URoli nARRam muRRum nIyE *","unnai uNara uRil * ulappu illai nuNukkanggaLE"],["என்ன இயற்கைகளால் * எங்ஙனே நின்றிட்டாய்? என் கண்ணா! *","துன்னு கர சரணம் முதலாக * எல்லா உறுப்பும் **","உன்னு சுவை ஒளி * ஊறொலி நாற்றம் முற்றும் நீயே *","உன்னை உணர உறில் * உலப்பு இல்லை நுணுக்கங்களே"],0,"/media/recitation/TVM.7.8.9.mp3"],[3539,3539,["illai nuNukkanggaLE * idhanil piRidhu ennum vaNNam *","thollai nannUlil sonna * uruvum aruvum nIyE **","allith thuzhAy alanggal * aNi mArba! en achchudhanE! *","valladhOr vaNNam sonnAl * adhuvE unakkAm vaNNamE"],["இல்லை நுணுக்கங்களே * இதனில் பிறிது என்னும் வண்ணம் *","தொல்லை நன்னூலில் சொன்ன * உருவும் அருவும் நீயே **","அல்லித் துழாய் அலங்கல் * அணி மார்ப! என் அச்சுதனே! *","வல்லதோர் வண்ணம் சொன்னால் * அதுவே உனக்காம் வண்ணமே"],0,"/media/recitation/TVM.7.8.10.mp3"],[3540,3540,["** Am vaNNam innadhu onRenRu * aRivadhu ariya ariyai *","Am vaNNaththAl * kurugUrch saDakOpan aRindhu uraiththa **","Am vaNNa oNthamizhgaL * ivai AyiraththuL ippaththum *","Am vaNNaththAl uraippAr * amaindhAr thamakku enRaikkumE"],["** ஆம் வண்ணம் இன்னது ஒன்றென்று * அறிவது அரிய அரியை *","ஆம் வண்ணத்தால் * குருகூர்ச் சடகோபன் அறிந்து உரைத்த **","ஆம் வண்ண ஒண்தமிழ்கள் * இவை ஆயிரத்துள் இப்பத்தும் *","ஆம் வண்ணத்தால் உரைப்பார் * அமைந்தார் தமக்கு என்றைக்குமே"],0,"/media/recitation/TVM.7.8.11.mp3"]],[[3541,3541,["** enRaikkum ennai * uyyak koNDu pOgiya *","anRaikku anRu ennaith * than Akki ennAl thannai **","in thamizh pADiya Isanai * AdhiyAy","ninRa en sOdhiyai * en solli niRpanO?"],["** என்றைக்கும் என்னை * உய்யக் கொண்டு போகிய *","அன்றைக்கு அன்று என்னைத் * தன் ஆக்கி என்னால் தன்னை **","இன் தமிழ் பாடிய ஈசனை * ஆதியாய்","நின்ற என் சோதியை * என் சொல்லி நிற்பனோ?"],0,"/media/recitation/TVM.7.9.1.mp3"],[3542,3542,["en solli niRpan? * en innuyir inRu onRAy *","en sollAl yAn sonna * in kavi enbiththu **","than sollAl thAn thannaik * kIrththiththa mAyan * en","mun sollum * mU uruvAm mudhalvanE"],["என் சொல்லி நிற்பன்? * என் இன்னுயிர் இன்று ஒன்றாய் *","என் சொல்லால் யான் சொன்ன * இன் கவி என்பித்து **","தன் சொல்லால் தான் தன்னைக் * கீர்த்தித்த மாயன் * என்","முன் சொல்லும் * மூ உருவாம் முதல்வனே"],0,"/media/recitation/TVM.7.9.2.mp3"],[3543,3543,["Am mudhalvan ivan enRu * thaRRERRi * en","nA mudhal vandhu pugundhu * nal in kavi **","thU mudhal paththarkkuth * thAn thannaich sonna * en","vAy mudhal appanai * enRu maRappanO?"],["ஆம் முதல்வன் இவன் என்று * தற்றேற்றி * என்","நா முதல் வந்து புகுந்து * நல் இன் கவி **","தூ முதல் பத்தர்க்குத் * தான் தன்னைச் சொன்ன * என்","வாய் முதல் அப்பனை * என்று மறப்பனோ?"],0,"/media/recitation/TVM.7.9.3.mp3"],[3544,3544,["appanai enRu maRappan? * en AgiyE *","thappudhal inRith * thanaik kavi thAn solli **","oppilAth thI vinaiyEnai * uyyak koNDu *","seppamE seydhu * thiriginRa sIr kaNDE"],["அப்பனை என்று மறப்பன்? * என் ஆகியே *","தப்புதல் இன்றித் * தனைக் கவி தான் சொல்லி **","ஒப்பிலாத் தீ வினையேனை * உய்யக் கொண்டு *","செப்பமே செய்து * திரிகின்ற சீர் கண்டே"],0,"/media/recitation/TVM.7.9.4.mp3"],[3545,3545,["sIr kaNDu koNDu * thirundhu nal in kavi *","nErpaDa yAn sollum * nIrmai ilAmaiyil **","ErvilA ennaith * than Akki ennAl thannai *","pAr paravu in kavi * pADum paramarE"],["சீர் கண்டு கொண்டு * திருந்து நல் இன் கவி *","நேர்பட யான் சொல்லும் * நீர்மை இலாமையில் **","ஏர்விலா என்னைத் * தன் ஆக்கி என்னால் தன்னை *","பார் பரவு இன் கவி * பாடும் பரமரே"],0,"/media/recitation/TVM.7.9.5.mp3"],[3546,3546,["in kavi pADum * parama kavigaLAl *","than kavi thAn thannaip * pADuviyAdhu ** inRu","nanku vandhu en uDan Akki * ennAl thannai *","van kavi pADum * en vaikuntha nAdhanE"],["இன் கவி பாடும் * பரம கவிகளால் *","தன் கவி தான் தன்னைப் * பாடுவியாது ** இன்று","நன்கு வந்து என் உடன் ஆக்கி * என்னால் தன்னை *","வன் கவி பாடும் * என் வைகுந்த நாதனே"],0,"/media/recitation/TVM.7.9.6.mp3"],[3547,3547,["vaikuntha nAdhan * ena valvinai mAyndhaRa *","sey kundhan thannai * en Akki ennAl thannai **","vaikunthan Agap * pugazha vaN thIngkavi *","sey kundhan thannai * ennAL sindhiththu ArvanO?"],["வைகுந்த நாதன் * என வல்வினை மாய்ந்தற *","செய் குந்தன் தன்னை * என் ஆக்கி என்னால் தன்னை **","வைகுந்தன் ஆகப் * புகழ வண் தீங்கவி *","செய் குந்தன் தன்னை * எந்நாள் சிந்தித்து ஆர்வனோ?"],0,"/media/recitation/TVM.7.9.7.mp3"],[3548,3548,["ArvanO? Azhi angkai * empirAn pugazh *","pAr viN nIr muRRum * kalandhu parugilum **","ErvilA ennaith * than Akki ennAl thannai *","sIr peRa in kavi * sonna thiRaththukkE"],["ஆர்வனோ? ஆழி அங்கை * எம்பிரான் புகழ் *","பார் விண் நீர் முற்றும் * கலந்து பருகிலும் **","ஏர்விலா என்னைத் * தன் ஆக்கி என்னால் தன்னை *","சீர் பெற இன் கவி * சொன்ன திறத்துக்கே"],0,"/media/recitation/TVM.7.9.8.mp3"],[3549,3549,["thiRaththukkE thupparavAm * thirumAlin sIr *","iRappu edhir kAlam * parugilum ArvanO? **","maRappilA ennaith * than Akki ennAl thannai *","uRap pala in kavi * sonna udhavikkE"],["திறத்துக்கே துப்பரவாம் * திருமாலின் சீர் *","இறப்பு எதிர் காலம் * பருகிலும் ஆர்வனோ? **","மறப்பிலா என்னைத் * தன் ஆக்கி என்னால் தன்னை *","உறப் பல இன் கவி * சொன்ன உதவிக்கே"],0,"/media/recitation/TVM.7.9.9.mp3"],[3550,3550,["udhavik kaimmARu * en uyir enna uRRu eNNil *","adhuvum maRRu Anggu avan thannadhu * ennAl thannai **","padhaviya in kavi * pADiya appanukku *","edhuvum onRum illai * seyvadhu inggum anggE"],["உதவிக் கைம்மாறு * என் உயிர் என்ன உற்று எண்ணில் *","அதுவும் மற்று ஆங்கு அவன் தன்னது * என்னால் தன்னை **","பதவிய இன் கவி * பாடிய அப்பனுக்கு *","எதுவும் ஒன்றும் இல்லை * செய்வது இங்கும் அங்கே"],0,"/media/recitation/TVM.7.9.10.mp3"],[3551,3551,["** inggum anggum * thirumAl anRi inmai kaNDu *","angnganE vaNkurugUrch * saDakOpan **","ingnganE sonna * Or Ayiraththu ippaththum *","engnganE sollinum * inbam payakkumE"],["** இங்கும் அங்கும் * திருமால் அன்றி இன்மை கண்டு *","அங்ஙனே வண்குருகூர்ச் * சடகோபன் **","இங்ஙனே சொன்ன * ஓர் ஆயிரத்து இப்பத்தும் *","எங்ஙனே சொல்லினும் * இன்பம் பயக்குமே"],0,"/media/recitation/TVM.7.9.11.mp3"]],[[3552,3552,["** inbam payakka ezhil malar","mAdharum thAnum * ivvEzhulagai *","inbam payakka inidhu uDan","vIRRirundhu * ALginRa enggaL pirAn **","anbuRRu amarndhu uRaiginRa *","aNi pozhil sUzh thiruvARanviLai *","anbuRRu amarndhu valam cheydhu *","kai thozhum nALgaLum AgungkolO?"],["** இன்பம் பயக்க எழில் மலர்","மாதரும் தானும் * இவ்வேழுலகை *","இன்பம் பயக்க இனிது உடன்","வீற்றிருந்து * ஆள்கின்ற எங்கள் பிரான் **","அன்புற்று அமர்ந்து உறைகின்ற *","அணி பொழில் சூழ் திருவாறன்விளை *","அன்புற்று அமர்ந்து வலம் செய்து *","கை தொழும் நாள்களும் ஆகுங்கொலோ?"],0,"/media/recitation/TVM.7.10.1.mp3"],[3553,3553,["Agungkol? aiyam onRinRi *","agal iDam muRRavum IraDiyE *","Agum parisu nimirndha *","thiruk kuRaL appan amarndhu uRaiyum **","mAgam thigazh koDi mADanggaL nIDu *","madhiL thiruvARanviLai *","mA gandha nIr koNDu thUvi valam","seydhu * kai thozhak kUDungkolO?"],["ஆகுங்கொல்? ஐயம் ஒன்றின்றி *","அகல் இடம் முற்றவும் ஈரடியே *","ஆகும் பரிசு நிமிர்ந்த *","திருக் குறள் அப்பன் அமர்ந்து உறையும் **","மாகம் திகழ் கொடி மாடங்கள் நீடு *","மதிள் திருவாறன்விளை *","மா கந்த நீர் கொண்டு தூவி வலம்","செய்து * கை தொழக் கூடுங்கொலோ?"],0,"/media/recitation/TVM.7.10.2.mp3"],[3554,3554,["kUDungkol? vaigalum * gOvindhanai","madhusUdhanaik kOL ariyai *","ADum paRavai misaik kaNDu *","kai thozhudhu anRi avan uRaiyum **","pADum perum pugazh nAnmaRai","vELvi aindhu * ARu anggam panninar vAzh *","nIDu pozhil thiruvARanviLai","thozha * vAykkungkol? nichchalumE"],["கூடுங்கொல்? வைகலும் * கோவிந்தனை","மதுசூதனைக் கோள் அரியை *","ஆடும் பறவை மிசைக் கண்டு *","கை தொழுது அன்றி அவன் உறையும் **","பாடும் பெரும் புகழ் நான்மறை","வேள்வி ஐந்து * ஆறு அங்கம் பன்னினர் வாழ் *","நீடு பொழில் திருவாறன்விளை","தொழ * வாய்க்குங்கொல்? நிச்சலுமே"],0,"/media/recitation/TVM.7.10.3.mp3"],[3555,3555,["vAykkungkol? nichchalum * eppozhudhum","manaththu Inggu ninaikkap peRa *","vAykkum karumbum perunjchennelum *","vayal sUzh thiruvARanviLai **","vAykkum perum pugazh mUvulagu Isan *","vaDa madhuraip piRandha *","vAykkum maNi niRak kaNNa pirAn","than * malar aDip pOdhugaLE"],["வாய்க்குங்கொல்? நிச்சலும் * எப்பொழுதும்","மனத்து ஈங்கு நினைக்கப் பெற *","வாய்க்கும் கரும்பும் பெருஞ்செந்நெலும் *","வயல் சூழ் திருவாறன்விளை **","வாய்க்கும் பெரும் புகழ் மூவுலகு ஈசன் *","வட மதுரைப் பிறந்த *","வாய்க்கும் மணி நிறக் கண்ண பிரான்","தன் * மலர் அடிப் போதுகளே"],0,"/media/recitation/TVM.7.10.4.mp3"],[3556,3556,["malar aDip pOdhugaL en nenjchaththu","eppozhudhum * iruththi vaNangga *","palar aDiyAr munbu aruLiya *","pAmbaNai appan amarndhu uRaiyum **","malaril maNi neDu mADanggaL","nIDu * madhiL thiruvARanviLai *","ulaga mali pugazh pADa * nam mEl","vinai onRum nillA keDumE"],["மலர் அடிப் போதுகள் என் நெஞ்சத்து","எப்பொழுதும் * இருத்தி வணங்க *","பலர் அடியார் முன்பு அருளிய *","பாம்பணை அப்பன் அமர்ந்து உறையும் **","மலரில் மணி நெடு மாடங்கள்","நீடு * மதிள் திருவாறன்விளை *","உலக மலி புகழ் பாட * நம் மேல்","வினை ஒன்றும் நில்லா கெடுமே"],0,"/media/recitation/TVM.7.10.5.mp3"],[3557,3557,["onRum nillA keDum muRRavum","thIvinai * uLLith thozhumin thoNDIr! *","anRu anggu amar venRu uruppiNi","nanggai * aNi neDunthOL puNarndhAn **","enRum eppOdhum en nenjcham","thudhippa * uLLE irukkinRa pirAn *","ninRa aNi thiruvARanviLai","ennum * nIL nagaram adhuvE"],["ஒன்றும் நில்லா கெடும் முற்றவும்","தீவினை * உள்ளித் தொழுமின் தொண்டீர்! *","அன்று அங்கு அமர் வென்று உருப்பிணி","நங்கை * அணி நெடுந்தோள் புணர்ந்தான் **","என்றும் எப்போதும் என் நெஞ்சம்","துதிப்ப * உள்ளே இருக்கின்ற பிரான் *","நின்ற அணி திருவாறன்விளை","என்னும் * நீள் நகரம் அதுவே"],0,"/media/recitation/TVM.7.10.6.mp3"],[3558,3558,["nINagaram adhuvE malarch","sOlaigaL sUzh * thiruvARanviLai *","nINagaraththu uRaiginRa pirAn *","neDumAl kaNNan viNNavar kOn **","vANapuram pukku mukkaN pirAnaith","tholaiya * vempOrgaL seydhu *","vANanai AyiranthOL thuNiththAn *","charaN anRi maRRonRu ilamE"],["நீணகரம் அதுவே மலர்ச்","சோலைகள் சூழ் * திருவாறன்விளை *","நீணகரத்து உறைகின்ற பிரான் *","நெடுமால் கண்ணன் விண்ணவர் கோன் **","வாணபுரம் புக்கு முக்கண் பிரானைத்","தொலைய * வெம்போர்கள் செய்து *","வாணனை ஆயிரந்தோள் துணித்தான் *","சரண் அன்றி மற்றொன்று இலமே"],0,"/media/recitation/TVM.7.10.7.mp3"],[3559,3559,["anRi maRRonRu ilam nin charaNE","enRu * agal irum poygaiyin vAy *","ninRu than nIL kazhal Eththiya *","Anaiyin nenjchiDar thIrththa pirAn **","senRu anggu inidhu uRaiginRa *","sezhum pozhil sUzh thiruvARanviLai *","onRi valanjcheyya onRumO? *","thIvinai uLLaththin sArvu allavE"],["அன்றி மற்றொன்று இலம் நின் சரணே","என்று * அகல் இரும் பொய்கையின் வாய் *","நின்று தன் நீள் கழல் ஏத்திய *","ஆனையின் நெஞ்சிடர் தீர்த்த பிரான் **","சென்று அங்கு இனிது உறைகின்ற *","செழும் பொழில் சூழ் திருவாறன்விளை *","ஒன்றி வலஞ்செய்ய ஒன்றுமோ? *","தீவினை உள்ளத்தின் சார்வு அல்லவே"],0,"/media/recitation/TVM.7.10.8.mp3"],[3560,3560,["thIvinai uLLaththin sArvu alla Agith *","theLi visumbu ERal uRRAl *","nAvin uLLum uLLaththu uLLum *","amaindha thozhilin uLLum navinRu **","yAvarum vandhu vaNanggum","pozhil * thiruvARanviLai adhanai *","mEvi valam seydhu kai thozhak","kUDungkol? ennum * en sindhanaiyE"],["தீவினை உள்ளத்தின் சார்வு அல்ல ஆகித் *","தெளி விசும்பு ஏறல் உற்றால் *","நாவின் உள்ளும் உள்ளத்து உள்ளும் *","அமைந்த தொழிலின் உள்ளும் நவின்று **","யாவரும் வந்து வணங்கும்","பொழில் * திருவாறன்விளை அதனை *","மேவி வலம் செய்து கை தொழக்","கூடுங்கொல்? என்னும் * என் சிந்தனையே"],0,"/media/recitation/TVM.7.10.9.mp3"],[3561,3561,["sindhai maRRonRin thiRaththadhu allAth","thanmai * dhEva pirAn aRiyum *","sindhaiyinAl seyva thAn aRiyAdhana *","mAyanggaL onRum illai **","sindhaiyinAl sollinAl seygaiyAl *","nilath thEvar kuzhu vaNanggum *","sindhai magizh thiruvARanviLai","uRai * thIrththanukku aRRa pinnE"],["சிந்தை மற்றொன்றின் திறத்தது அல்லாத்","தன்மை * தேவ பிரான் அறியும் *","சிந்தையினால் செய்வ தான் அறியாதன *","மாயங்கள் ஒன்றும் இல்லை **","சிந்தையினால் சொல்லினால் செய்கையால் *","நிலத் தேவர் குழு வணங்கும் *","சிந்தை மகிழ் திருவாறன்விளை","உறை * தீர்த்தனுக்கு அற்ற பின்னே"],0,"/media/recitation/TVM.7.10.10.mp3"],[3562,3562,["** thIrththanukku aRRa pin * maRROr","charaN illai enRu eNNi * thIrththanukkE","thIrththa manaththanan Agich *","sezhungkurugUrch saDakOpan sonna **","thIrththanggaL AyiraththuL * ivai","paththum vallArgaLai * dhEvar vaigal","thIrththanggaLE enRu pUsiththu","nalgi uraippar * tham dhEviyarkkE"],["** தீர்த்தனுக்கு அற்ற பின் * மற்றோர்","சரண் இல்லை என்று எண்ணி * தீர்த்தனுக்கே","தீர்த்த மனத்தனன் ஆகிச் *","செழுங்குருகூர்ச் சடகோபன் சொன்ன **","தீர்த்தங்கள் ஆயிரத்துள் * இவை","பத்தும் வல்லார்களை * தேவர் வைகல்","தீர்த்தங்களே என்று பூசித்து","நல்கி உரைப்பர் * தம் தேவியர்க்கே"],0,"/media/recitation/TVM.7.10.11.mp3"]]]