[[[1348,1348,["** aRivadhu ariyAn anaiththulagum uDaiyAn * ennai ALuDaiyAn *","kuRiya mANi uruvAya * kUththan manni amarum iDam **","naRiya malar mEl surumbArkka * ezhilAr manjnjai naDam ADa *","poRikoL siRai vaNDu isai pADum * puLLampUthangkuDi thAnE"],["** அறிவது அரியான் அனைத்துலகும் உடையான் * என்னை ஆளுடையான் *","குறிய மாணி உருவாய * கூத்தன் மன்னி அமரும் இடம் **","நறிய மலர் மேல் சுரும்பார்க்க * எழிலார் மஞ்ஞை நடம் ஆட *","பொறிகொள் சிறை வண்டு இசை பாடும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.1.mp3"],[1349,1349,["kaLLak kuRaLAy mAvaliyai vanjchiththu * ulagam kaippaDuththu *","poLLaik karaththa pOdhagaththin * thunbam thavirththa punidhan iDam **","paLLach seRuvil kayal ugaLap * pazhanak kazhani adhanuL pOy *","puLLup piLLaikku irai thEDum * puLLampUthangkuDi thAnE"],["கள்ளக் குறளாய் மாவலியை வஞ்சித்து * உலகம் கைப்படுத்து *","பொள்ளைக் கரத்த போதகத்தின் * துன்பம் தவிர்த்த புனிதன் இடம் **","பள்ளச் செறுவில் கயல் உகளப் * பழனக் கழனி அதனுள் போய் *","புள்ளுப் பிள்ளைக்கு இரை தேடும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.2.mp3"],[1350,1350,["mEvA arakkar thennilanggai * vEndhan vIyach saram thurandhu *","mA vAy piLandhu mal aDarththu * marudham sAyththa mAladhiDam **","kAvAr thenggin pazham vIzhak * kayalgaL pAyak kurugu iriyum*","pUvAr kazhani ezhil Arum * puLLampUthangkuDi thAnE"],["மேவா அரக்கர் தென்னிலங்கை * வேந்தன் வீயச் சரம் துரந்து *","மா வாய் பிளந்து மல் அடர்த்து * மருதம் சாய்த்த மாலதிடம் **","காவார் தெங்கின் பழம் வீழக் * கயல்கள் பாயக் குருகு இரியும்*","பூவார் கழனி எழில் ஆரும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.3.mp3"],[1351,1351,["veRpAl mAri pazhudhAkki * viRal vAL arakkar thalaivan than *","vaRpAr thiraL thOL ainnAnkum * thuNiththa valvil irAman iDam **","kaRpAr purisai sey kunRam * kavinAr kUDam mALigaigaL *","poRpAr mADam ezhil Arum * puLLampUthangkuDi thAnE"],["வெற்பால் மாரி பழுதாக்கி * விறல் வாள் அரக்கர் தலைவன் தன் *","வற்பார் திரள் தோள் ஐந்நான்கும் * துணித்த வல்வில் இராமன் இடம் **","கற்பார் புரிசை செய் குன்றம் * கவினார் கூடம் மாளிகைகள் *","பொற்பார் மாடம் எழில் ஆரும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.4.mp3"],[1352,1352,["maiyAr thaDanggaN karungkUndhal * Aychchi maRaiya vaiththa thayir *","neyyAr pAlODu amudhu seydha * nEmi angkai mAyan iDam **","seyyAr Aral irai karudhich * sengkAl nArai senRaNaiyum *","poyyA nAvin maRaiyALar * puLLampUthangkuDi thAnE"],["மையார் தடங்கண் கருங்கூந்தல் * ஆய்ச்சி மறைய வைத்த தயிர் *","நெய்யார் பாலோடு அமுது செய்த * நேமி அங்கை மாயன் இடம் **","செய்யார் ஆரல் இரை கருதிச் * செங்கால் நாரை சென்றணையும் *","பொய்யா நாவின் மறையாளர் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.5.mp3"],[1353,1353,["minnin anna nuNmarunggul * vEyEy thaDanthOL melliyaRkA *","mannu sinaththa mazha viDaigaL * Ezh anRu aDarththa mAladhiDam **","mannu mudhu nIr aravindha malar mEl * varivaNDu isai pADa *","punnai ponnEy thAdhudhirkkum * puLLampUthangkuDi thAnE"],["மின்னின் அன்ன நுண்மருங்குல் * வேயேய் தடந்தோள் மெல்லியற்கா *","மன்னு சினத்த மழ விடைகள் * ஏழ் அன்று அடர்த்த மாலதிடம் **","மன்னு முது நீர் அரவிந்த மலர் மேல் * வரிவண்டு இசை பாட *","புன்னை பொன்னேய் தாதுதிர்க்கும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.6.mp3"],[1354,1354,["kuDaiyA vilanggal koNDu Endhi * mAri pazhudhu Anirai kAththu *","saDaiyAn ODa aDal vANan * thaDanthOL thuNiththa thalaivan iDam **","kuDiyA vaNDu kaLLuNNak * kOla nIlam maTTugukkum *","puDaiyAr kazhani ezhil Arum * puLLampUthangkuDi thAnE"],["குடையா விலங்கல் கொண்டு ஏந்தி * மாரி பழுது ஆநிரை காத்து *","சடையான் ஓட அடல் வாணன் * தடந்தோள் துணித்த தலைவன் இடம் **","குடியா வண்டு கள்ளுண்ணக் * கோல நீலம் மட்டுகுக்கும் *","புடையார் கழனி எழில் ஆரும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.7.mp3"],[1355,1355,["kaRaiyAr neDuvEl maRamannar vIya * visayan thEr kaDavi *","iRaiyAn kaiyil niRaiyAdha * muNDam niRaiththa endhai iDam **","maRaiyAl muththI avai vaLarkkum * mannu pugazhAl vaNmaiyAl *","poRaiyAl mikka andhaNar vAzh * puLLampUthangkuDi thAnE"],["கறையார் நெடுவேல் மறமன்னர் வீய * விசயன் தேர் கடவி *","இறையான் கையில் நிறையாத * முண்டம் நிறைத்த எந்தை இடம் **","மறையால் முத்தீ அவை வளர்க்கும் * மன்னு புகழால் வண்மையால் *","பொறையால் மிக்க அந்தணர் வாழ் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.8.mp3"],[1356,1356,["thunni maNNum viNNADum * thOnRAdhu iruLAy mUDiya nAL *","annamAgi arumaRaigaL * aruLich seydha amalan iDam **","minnu sOdhi navamaNiyum * vEyin muththum sAmaraiyum *","ponnum ponni koNarndhu alaikkum * puLLampUthangkuDi thAnE"],["துன்னி மண்ணும் விண்ணாடும் * தோன்றாது இருளாய் மூடிய நாள் *","அன்னமாகி அருமறைகள் * அருளிச் செய்த அமலன் இடம் **","மின்னு சோதி நவமணியும் * வேயின் முத்தும் சாமரையும் *","பொன்னும் பொன்னி கொணர்ந்து அலைக்கும் * புள்ளம்பூதங்குடி தானே"],0,"/media/recitation/PT.5.1.9.mp3"],[1357,1357,["** kaRRA maRiththu kALiyan than * senni naDungga naDam payinRa *","poRRAmaraiyAL than kELvan * puLLampUthangkuDi than mEl **","kaRRAr paravum manggaiyar kOn * kArAr puyaRkaik kalikanRi *","sol thAn Iraindhu ivai pADach * sOra nillA thuyar thAmE"],["** கற்றா மறித்து காளியன் தன் * சென்னி நடுங்க நடம் பயின்ற *","பொற்றாமரையாள் தன் கேள்வன் * புள்ளம்பூதங்குடி தன் மேல் **","கற்றார் பரவும் மங்கையர் கோன் * காரார் புயற்கைக் கலிகன்றி *","சொல் தான் ஈரைந்து இவை பாடச் * சோர நில்லா துயர் தாமே"],0,"/media/recitation/PT.5.1.10.mp3"]],[[1358,1358,["** thAm tham perumai aRiyAr * thUdhu","vEndharkkAya * vEndhar Ur pOl **","kAndhaL viral * menkalai nanmaDavAr *","kUndhal kamazhum * kUDalUrE"],["** தாம் தம் பெருமை அறியார் * தூது","வேந்தர்க்காய * வேந்தர் ஊர் போல் **","காந்தள் விரல் * மென்கலை நன்மடவார் *","கூந்தல் கமழும் * கூடலூரே"],0,"/media/recitation/PT.5.2.1.mp3"],[1359,1359,["seRunthiN thimil ERuDaiya * pinnai","peRunthaN kOlam * peRRAr Ur pOl **","naRunthaN thIm * thEn uNDa vaNDu *","kuRinjchi pADum * kUDalUrE"],["செறுந்திண் திமில் ஏறுடைய * பின்னை","பெறுந்தண் கோலம் * பெற்றார் ஊர் போல் **","நறுந்தண் தீம் * தேன் உண்ட வண்டு *","குறிஞ்சி பாடும் * கூடலூரே"],0,"/media/recitation/PT.5.2.2.mp3"],[1360,1360,["piLLai uruvAyth * thayir uNDu * aDiyEn","uLLam pugundha * oruvar Ur pOl **","kaLLa nArai vayaluL * kayal mIn","koLLai koLLum * kUDalUrE"],["பிள்ளை உருவாய்த் * தயிர் உண்டு * அடியேன்","உள்ளம் புகுந்த * ஒருவர் ஊர் போல் **","கள்ள நாரை வயலுள் * கயல் மீன்","கொள்ளை கொள்ளும் * கூடலூரே"],0,"/media/recitation/PT.5.2.3.mp3"],[1361,1361,["kURREr uruvin kuRaLAy * nilam nIr","ERRAn * endhai perumAn Ur pOl **","sERREr uzhavar * kOdhaip pOdhUN *","kOl thEn muralum * kUDalUrE"],["கூற்றேர் உருவின் குறளாய் * நிலம் நீர்","ஏற்றான் * எந்தை பெருமான் ஊர் போல் **","சேற்றேர் உழவர் * கோதைப் போதூண் *","கோல் தேன் முரலும் * கூடலூரே"],0,"/media/recitation/PT.5.2.4.mp3"],[1362,1362,["thoNDar paravach * suDar senRu aNava *","aNDaththu amarum * aDigaL Ur pOl **","vaNDal alaiyuL * keNDai miLira *","koNDal adhirum * kUDalUrE"],["தொண்டர் பரவச் * சுடர் சென்று அணவ *","அண்டத்து அமரும் * அடிகள் ஊர் போல் **","வண்டல் அலையுள் * கெண்டை மிளிர *","கொண்டல் அதிரும் * கூடலூரே"],0,"/media/recitation/PT.5.2.5.mp3"],[1363,1363,["thakkan vELvi * thagarththa thalaivan *","thukkam thuDaiththa * thuNaivar Ur pOl **","ekkaliDu * nuNmaNal mEl * enggum","kokkin pazham vIzh * kUDalUrE"],["தக்கன் வேள்வி * தகர்த்த தலைவன் *","துக்கம் துடைத்த * துணைவர் ஊர் போல் **","எக்கலிடு * நுண்மணல் மேல் * எங்கும்","கொக்கின் பழம் வீழ் * கூடலூரே"],0,"/media/recitation/PT.5.2.6.mp3"],[1364,1364,["karunthaN kaDalum * malaiyum ulagum *","arundhum aDigaL * amarum Ur pOl **","perunthaN mullaip * piLLai ODi *","kurundham thazhuvum * kUDalUrE"],["கருந்தண் கடலும் * மலையும் உலகும் *","அருந்தும் அடிகள் * அமரும் ஊர் போல் **","பெருந்தண் முல்லைப் * பிள்ளை ஓடி *","குருந்தம் தழுவும் * கூடலூரே"],0,"/media/recitation/PT.5.2.7.mp3"],[1365,1365,["kalai vAzh piNaiyODu aNaiyum * thirunIr","malai vAzh endhai * maruvum Ur pOl **","ilai thAzh thenggin * mEl ninRu * iLanIrk","kulai thAzh kiDanggin * kUDalUrE"],["கலை வாழ் பிணையோடு அணையும் * திருநீர்","மலை வாழ் எந்தை * மருவும் ஊர் போல் **","இலை தாழ் தெங்கின் * மேல் நின்று * இளநீர்க்","குலை தாழ் கிடங்கின் * கூடலூரே"],0,"/media/recitation/PT.5.2.8.mp3"],[1366,1366,["perugu kAdhal aDiyEn * uLLam","urugap pugundha * oruvar Ur pOl **","arugu kaidhai malara * keNDai","kurugu enRu anjchum * kUDalUrE"],["பெருகு காதல் அடியேன் * உள்ளம்","உருகப் புகுந்த * ஒருவர் ஊர் போல் **","அருகு கைதை மலர * கெண்டை","குருகு என்று அஞ்சும் * கூடலூரே"],0,"/media/recitation/PT.5.2.9.mp3"],[1367,1367,["** kAvip perunIr vaNNan * kaNNan","mEvith thigazhum * kUDalUr mEl **","kOvaith thamizhAl * kaliyan sonna *","pAvaip pADap * pAvam pOmE"],["** காவிப் பெருநீர் வண்ணன் * கண்ணன்","மேவித் திகழும் * கூடலூர் மேல் **","கோவைத் தமிழால் * கலியன் சொன்ன *","பாவைப் பாடப் * பாவம் போமே"],0,"/media/recitation/PT.5.2.10.mp3"]],[[1368,1368,["** venRi mAmazhu Endhi mun maN misai mannarai * mUvezhukAl","konRa dhEva! * nin kurai kazhal thozhuvadhOr vagai * enakku aruL puriyE **","manRil mAmpozhil nuzhai thandhu * malligai mauvalin pOdhu alarththi *","thenRal mAmaNam kamazh thara varu * thiruveLLaRai ninRAnE"],["** வென்றி மாமழு ஏந்தி முன் மண்","மிசை மன்னரை * மூவெழுகால்","கொன்ற தேவ! * நின் குரை கழல் தொழுவதோர்","வகை * எனக்கு அருள் புரியே **","மன்றில் மாம்பொழில் நுழை தந்து *","மல்லிகை மௌவலின் போது அலர்த்தி *","தென்றல் மாமணம் கமழ் தர வரு *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.1.mp3"],[1369,1369,["vasai il nAnmaRai keDuththa ammalar ayaRku aruLi * mun parimugamAy *","isai koL vEdha nUl enRivai payandhavanE! * enakku aruL puriyE **","uyar koL mAdhavip pOthoDu ulAviya * mArutham vIdhiyin vAy *","thisai ellAm kamazhum pozhil sUzh * thiruveLLaRai ninRAnE"],["வசை இல் நான்மறை கெடுத்த அம்மலர்","அயற்கு அருளி * முன் பரிமுகமாய் *","இசை கொள் வேத நூல் என்றிவை பயந்தவனே! *","எனக்கு அருள் புரியே **","உயர் கொள் மாதவிப் போதொடு உலாவிய *","மாருதம் வீதியின் வாய் *","திசை எல்லாம் கமழும் பொழில் சூழ் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.2.mp3"],[1370,1370,["veyyanAy ulagu EzhuDan nalindhavan * uDalagam iru piLavA *","kaiyil nIL ugirp paDai adhu vAyththavanE! * enakku aruL puriyE **","maiyin Artharu varAl inam pAya * vaN thaDaththiDaik kamalanggaL *","dheyva nARum oNpoygaigaL sUzh * thiruveLLaRai ninRAnE"],["வெய்யனாய் உலகு ஏழுடன் நலிந்தவன் *","உடலகம் இரு பிளவா *","கையில் நீள் உகிர்ப் படை அது வாய்த்தவனே! *","எனக்கு அருள் புரியே **","மையின் ஆர்தரு வரால் இனம் பாய *","வண் தடத்திடைக் கமலங்கள் *","தெய்வ நாறும் ஒண்பொய்கைகள் சூழ் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.3.mp3"],[1371,1371,["vAm pari uga mannar tham uyir sega * aivargaTku arasu aLiththa *","kAmbinAr thiruvEngkaDap poruppa! * nin kAdhalai aruL enakku **","mAmpozhil thaLir kOdhiya maDakkuyil * vAyadhu thuvarppeydha *","thImpalangkanith thEn adhu nugar * thiruveLLaRai ninRAnE"],["வாம் பரி உக மன்னர் தம் உயிர் செக *","ஐவர்கட்கு அரசு அளித்த *","காம்பினார் திருவேங்கடப் பொருப்ப! *","நின் காதலை அருள் எனக்கு **","மாம்பொழில் தளிர் கோதிய மடக்குயில் *","வாயது துவர்ப்பெய்த *","தீம்பலங்கனித் தேன் அது நுகர் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.4.mp3"],[1372,1372,["mAnavEl oNkaN maDavaral * maNmagaL azhungga munnIrp parappil *","EnamAgi anRu iru nilam iDandhavanE! * enakku aruL puriyE **","kAna mAmullai kazhaik karumbERi * veNmuRuval seydhu alarginRa *","thEnin vAy malar murugu ugukkum * thiruveLLaRai ninRAnE"],["மானவேல் ஒண்கண் மடவரல் * மண்மகள்","அழுங்க முந்நீர்ப் பரப்பில் *","ஏனமாகி அன்று இரு நிலம் இடந்தவனே! *","எனக்கு அருள் புரியே **","கான மாமுல்லை கழைக் கரும்பேறி *","வெண்முறுவல் செய்து அலர்கின்ற *","தேனின் வாய் மலர் முருகு உகுக்கும் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.5.mp3"],[1373,1373,["ponggu nILmuDi amarargaL thozhudhu ezha * amudhinaik koDuththu aLippAn *","anggOr Amai adhAgiya Adhi! * nin aDimaiyai aruL enakku **","thanggu pEDaiyODu UDiya madhukaram * thaiyalAr kuzhal aNaivAn *","thinggaL thOy senni mADam senRaNai * thiruveLLaRai ninRAnE"],["பொங்கு நீள்முடி அமரர்கள் தொழுது எழ *","அமுதினைக் கொடுத்து அளிப்பான் *","அங்கோர் ஆமை அதாகிய ஆதி! *","நின் அடிமையை அருள் எனக்கு **","தங்கு பேடையோடு ஊடிய மதுகரம் *","தையலார் குழல் அணைவான் *","திங்கள் தோய் சென்னி மாடம் சென்றணை *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.6.mp3"],[1374,1374,["ARinODu oru nAnkuDai neDumuDi * arakkan than siram ellAm *","vERu vERuga villadhu vaLaiththavanE! * enakku aruL puriyE **","mARil sOdhiya maradhagap pAsaDaith * thAmarai malar vArndha *","thERal mAndhi vaNDu innisai mural * thiruveLLaRai ninRAnE"],["ஆறினோடு ஒரு நான்குடை நெடுமுடி *","அரக்கன் தன் சிரம் எல்லாம் *","வேறு வேறுக வில்லது வளைத்தவனே! *","எனக்கு அருள் புரியே **","மாறில் சோதிய மரதகப் பாசடைத் *","தாமரை மலர் வார்ந்த *","தேறல் மாந்தி வண்டு இன்னிசை முரல் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.7.mp3"],[1375,1375,["muṉ iv ezh ulaku uṇarvu iṉṟi * irul̤ mika","umparkal̤ tŏzhutu etta *","aṉṉam āki aṉṟu aru maṟai payantava","ṉe! * -ĕṉakku arul̤puriye ** -","maṉṉu ketakai cūtakam ĕṉṟu ivai *","vaṉattiṭaic curumpu iṉaṅkal̤ *","tĕṉṉa ĕṉṉa vaṇṭu iṉ icai mural * tiru","vĕl̤l̤aṟai niṉṟāṉe-"],["முன் இவ் ஏழ் உலகு உணர்வு இன்றி * இருள் மிக","உம்பர்கள் தொழுது ஏத்த *","அன்னம் ஆகி அன்று அரு மறை பயந்தவ","னே! * எனக்கு அருள்புரியே **","மன்னு கேதகை சூதகம் என்று இவை *","வனத்திடைச் சுரும்பு இனங்கள் *","தென்ன என்ன வண்டு இன் இசை முரல் * திரு","வெள்ளறை நின்றானே"],1,"/media/recitation/PT.5.3.8.mp3"],[1376,1376,["Anggu mAvali vELviyil irandhu senRu * agaliDam muzhudhinaiyum *","pAngginAl koNDa parama! niRpaNindhu ezhuvEn * enakku aruL puriyE **","Onggu piNDiyin semmalar ERi * vaNDu uzhithara * mAvERith","thIngguyil mizhaRRum paDappaith * thiruveLLaRai ninRAnE"],["ஆங்கு மாவலி வேள்வியில் இரந்து சென்று *","அகலிடம் முழுதினையும் *","பாங்கினால் கொண்ட பரம! நிற்பணிந்து","எழுவேன் * எனக்கு அருள் புரியே **","ஓங்கு பிண்டியின் செம்மலர் ஏறி * வண்டு","உழிதர * மாவேறித்","தீங்குயில் மிழற்றும் படப்பைத் *","திருவெள்ளறை நின்றானே"],0,"/media/recitation/PT.5.3.9.mp3"],[1377,1377,["** manjchulA maNimADanggaL sUzh * thiruveLLaRai adhan mEya *","anjchanam puraiyum thiru uruvanai * Adhiyai amudhaththai **","nanjchu ulAviya vEl valavan * kalikanRi sol aiyiraNDum *","enjchal inRi ninREththa vallAr * imaiyOrkku arasu AvargaLE"],["** மஞ்சுலா மணிமாடங்கள் சூழ் *","திருவெள்ளறை அதன் மேய *","அஞ்சனம் புரையும் திரு உருவனை *","ஆதியை அமுதத்தை **","நஞ்சு உலாவிய வேல் வலவன் *","கலிகன்றி சொல் ஐயிரண்டும் *","எஞ்சல் இன்றி நின்றேத்த வல்லார் *","இமையோர்க்கு அரசு ஆவர்களே"],0,"/media/recitation/PT.5.3.10.mp3"]],[[1378,1378,["** undhi mEl nAnmuganaip paDaiththAn * ulagu uNDavan","endhai pemmAn * imaiyOrgaL thAdhaikku * iDam enbarAl **","sandhinODu maNiyum kozhikkum * punal kAviri *","andhi pOlum niRaththu Arvayal sUzh * thennaranggamE"],["** உந்தி மேல் நான்முகனைப் படைத்தான் * உலகு உண்டவன்","எந்தை பெம்மான் * இமையோர்கள் தாதைக்கு * இடம் என்பரால் **","சந்தினோடு மணியும் கொழிக்கும் * புனல் காவிரி *","அந்தி போலும் நிறத்து ஆர்வயல் சூழ் * தென்னரங்கமே"],0,"/media/recitation/PT.5.4.1.mp3"],[1379,1379,["vaiyam uṇṭu āl ilai mevum māyaṉ * maṇi nīl̤ muṭi *","pai kŏl̤ nākattu aṇaiyāṉ * payilum iṭam ĕṉparāl ** -","taiyal nallār kuzhal mālaiyum * maṟṟu avar taṭa mulai *","cĕyya cāntum kalantu izhi puṉal cūzh * tĕṉ araṅkame-"],["வையம் உண்டு ஆல் இலை மேவும் மாயன் * மணி நீள் முடி *","பை கொள் நாகத்து அணையான் * பயிலும் இடம் என்பரால் **","தையல் நல்லார் குழல் மாலையும் * மற்று அவர் தட முலை *","செய்ய சாந்தும் கலந்து இழி புனல் சூழ் * தென் அரங்கமே"],1,"/media/recitation/PT.5.4.2.mp3"],[1380,1380,["paNDu ivvaiyam aLappAn senRu * mAvali kaiyil nIr","koNDa * Azhith thaDakkaik * kuRaLan iDam enbarAl **","vaNDu pADum madhuvAr punal * vandhizhi kAviri *","aNDa nARum pozhil sUzhndhu * azhagAr thennaranggamE"],["பண்டு இவ்வையம் அளப்பான் சென்று * மாவலி கையில் நீர்","கொண்ட * ஆழித் தடக்கைக் * குறளன் இடம் என்பரால் **","வண்டு பாடும் மதுவார் புனல் * வந்திழி காவிரி *","அண்ட நாறும் பொழில் சூழ்ந்து * அழகார் தென்னரங்கமே"],0,"/media/recitation/PT.5.4.3.mp3"],[1381,1381,["viLaiththa vempOr viRal vAL arakkan * nagar pAzh paDa *","vaLaiththa valvil thaDakkai avanukku * iDam enbarAl **","thuLaikkai yAnai maruppum agilum * koNarndhu undhi * mun","thiLaikkum selvap punal kAviri sUzh * thennaranggamE"],["விளைத்த வெம்போர் விறல் வாள் அரக்கன் * நகர் பாழ் பட *","வளைத்த வல்வில் தடக்கை அவனுக்கு * இடம் என்பரால் **","துளைக்கை யானை மருப்பும் அகிலும் * கொணர்ந்து உந்தி * முன்","திளைக்கும் செல்வப் புனல் காவிரி சூழ் * தென்னரங்கமே"],0,"/media/recitation/PT.5.4.4.mp3"],[1382,1382,["vambulAm kUndhal maNDOdhari kAdhalan * vAn puga *","ambu thannAl munindha * azhagan iDam enbarAl **","umbar kOnum ulagEzhum * vandhu INDi vaNanggum * nal","sempon Arum madhiL sUzhndhu * azhagAr thennaranggamE"],["வம்புலாம் கூந்தல் மண்டோதரி காதலன் * வான் புக *","அம்பு தன்னால் முனிந்த * அழகன் இடம் என்பரால் **","உம்பர் கோனும் உலகேழும் * வந்து ஈண்டி வணங்கும் * நல்","செம்பொன் ஆரும் மதிள் சூழ்ந்து * அழகார் தென்னரங்கமே"],0,"/media/recitation/PT.5.4.5.mp3"],[1383,1383,["kalai uDuththa agal algul * vanpEy magaL thAy ena *","mulai koDuththAL uyir uNDavan * vAzh iDam enbarAl **","kulai eDuththa kadhalip * pozhilUDum vandhu undhi * mun","alai eDukkum punal kAviri sUzh * thennaranggamE"],["கலை உடுத்த அகல் அல்குல் * வன்பேய் மகள் தாய் என *","முலை கொடுத்தாள் உயிர் உண்டவன் * வாழ் இடம் என்பரால் **","குலை எடுத்த கதலிப் * பொழிலூடும் வந்து உந்தி * முன்","அலை எடுக்கும் புனல் காவிரி சூழ் * தென்னரங்கமே"],0,"/media/recitation/PT.5.4.6.mp3"],[1384,1384,["kanjchan nenjchum kaDu mallarum * sagaDamum kAlinAl *","thunjcha venRa suDar AzhiyAn * vAzh iDam enbarAl **","manjchu sEr mALigai * nIDu agil pugaiyum * maRaiyOr","senjchol vELvip pugaiyum kamazhum * thennaranggamE"],["கஞ்சன் நெஞ்சும் கடு மல்லரும் * சகடமும் காலினால் *","துஞ்ச வென்ற சுடர் ஆழியான் * வாழ் இடம் என்பரால் **","மஞ்சு சேர் மாளிகை * நீடு அகில் புகையும் * மறையோர்","செஞ்சொல் வேள்விப் புகையும் கமழும் * தென்னரங்கமே"],0,"/media/recitation/PT.5.4.7.mp3"],[1385,1385,["Enam mIn AmaiyODu * ariyum siRu kuRaLumAy *","thAnum Aya * tharaNith thalaivan iDam enbarAl **","vAnum maNNum niRaiyap * pugundhu INDi vaNanggum * nal","thEnum pAlum kalandhu annavar sEr * thennaranggamE"],["ஏனம் மீன் ஆமையோடு * அரியும் சிறு குறளுமாய் *","தானும் ஆய * தரணித் தலைவன் இடம் என்பரால் **","வானும் மண்ணும் நிறையப் * புகுந்து ஈண்டி வணங்கும் * நல்","தேனும் பாலும் கலந்து அன்னவர் சேர் * தென்னரங்கமே"],0,"/media/recitation/PT.5.4.8.mp3"],[1386,1386,["sEyan enRum migap periyan * nuN nErmaiyinAya * im","mAyai yArum aRiyA vagaiyAn * iDam enbarAl **","vEyin muththum maNiyum koNarndhu * Arpunal kAviri *","Aya pon mAmadhiL sUzhndhu * azhagAr thennaranggamE"],["சேயன் என்றும் மிகப் பெரியன் * நுண் நேர்மையினாய * இம்","மாயை யாரும் அறியா வகையான் * இடம் என்பரால் **","வேயின் முத்தும் மணியும் கொணர்ந்து * ஆர்புனல் காவிரி *","ஆய பொன் மாமதிள் சூழ்ந்து * அழகார் தென்னரங்கமே"],0,"/media/recitation/PT.5.4.9.mp3"],[1387,1387,["** alli mAdhar amarum * thirumArvan aranggaththai *","kallin mannu madhiL * manggaiyar kOn kalikanRi sol **","nallisai mAlaigaL * nAliraNDum iraNDum uDan *","vallavar thAm ulagANDu * pin vAnulagu ALvarE"],["** அல்லி மாதர் அமரும் * திருமார்வன் அரங்கத்தை *","கல்லின் மன்னு மதிள் * மங்கையர் கோன் கலிகன்றி சொல் **","நல்லிசை மாலைகள் * நாலிரண்டும் இரண்டும் உடன் *","வல்லவர் தாம் உலகாண்டு * பின் வானுலகு ஆள்வரே"],0,"/media/recitation/PT.5.4.10.mp3"]],[[1388,1388,["** veruvAdhAL vAy veruvi * vEngkaDamE! vEngkaDamE! enginRALAl *","maruvALAl en kuDangkAl * vAL neDungkaN thuyil maRandhAL ** vaNDAr koNDal","uruvALan vAnavar tham uyirALan * oli thirai nIrp pauvam koNDa","thiruvALan * en magaLaich seydhanagaL * engnganam nAn sindhikkEnE?"],["** வெருவாதாள் வாய் வெருவி *","வேங்கடமே! வேங்கடமே! என்கின்றாளால் *","மருவாளால் என் குடங்கால் * வாள் நெடுங்கண்","துயில் மறந்தாள் ** வண்டார் கொண்டல்","உருவாளன் வானவர் தம் உயிராளன் *","ஒலி திரை நீர்ப் பௌவம் கொண்ட","திருவாளன் * என் மகளைச் செய்தனகள் *","எங்ஙனம் நான் சிந்திக்கேனே?"],0,"/media/recitation/PT.5.5.1.mp3"],[1389,1389,["kalai ALA agal algul * kanavaLaiyum kai ALA en seygEn nAn? *","vilai ALA aDiyEnai * vENDudhiyO? vENDAyO? ennum ** meyya","malai ALan vAnavar tham thalaiyALan * marAmaram Ezh eydha venRich","silai ALan * en magaLaich seydhanagaL * engnganam nAn sindhikkEnE?"],["கலை ஆளா அகல் அல்குல் * கனவளையும்","கை ஆளா என் செய்கேன் நான்? *","விலை ஆளா அடியேனை * வேண்டுதியோ?","வேண்டாயோ? என்னும் ** மெய்ய","மலை ஆளன் வானவர் தம் தலையாளன் *","மராமரம் ஏழ் எய்த வென்றிச்","சிலை ஆளன் * என் மகளைச் செய்தனகள் *","எங்ஙனம் நான் சிந்திக்கேனே?"],0,"/media/recitation/PT.5.5.2.mp3"],[1390,1390,["mAnAya mennOkki * vAL neDungkaN nIr malgum vaLaiyum sOrum *","thEnAya naRunthuzhAy alanggalin * thiRam pEsi uRanggAL kANmin **","kAnAyan kaDi manaiyil thayir uNDu ney paruga * nandhan peRRa","AnAyan * en magaLaich seydhanagaL * ammanaimIr! aRigilEnE"],["மானாய மென்னோக்கி * வாள் நெடுங்கண்","நீர் மல்கும் வளையும் சோரும் *","தேனாய நறுந்துழாய் அலங்கலின் *","திறம் பேசி உறங்காள் காண்மின் **","கானாயன் கடி மனையில் தயிர் உண்டு","நெய் பருக * நந்தன் பெற்ற","ஆனாயன் * என் மகளைச் செய்தனகள் *","அம்மனைமீர்! அறிகிலேனே"],0,"/media/recitation/PT.5.5.3.mp3"],[1391,1391,["thAy vAyil soRkELAL * than AyaththODu aNaiyAL thaDamen konggai","yE * Arach sAndhaNiyAL * emperumAn thiruvaranggam enggE? ennum **","pEy mAya mulai uNDu ivvulaguNDa peru vayiRRan * pEsil nanggAy! *","mAmAyan en magaLaich seydhanagaL * manggaimIr! madhikkilEnE"],["தாய் வாயில் சொற்கேளாள் * தன் ஆயத்தோடு","அணையாள் தடமென் கொங்கை","யே * ஆரச் சாந்தணியாள் * எம்பெருமான்","திருவரங்கம் எங்கே? என்னும் **","பேய் மாய முலை உண்டு இவ்வுலகுண்ட பெரு","வயிற்றன் * பேசில் நங்காய்! *","மாமாயன் என் மகளைச் செய்தனகள் *","மங்கைமீர்! மதிக்கிலேனே"],0,"/media/recitation/PT.5.5.4.mp3"],[1392,1392,["pUNmulai mEl sAndhaNiyAL * porukayal kaN mai ezhudhAL pUvai pENAL *","EN aRiyAL eththanaiyum * emperumAn thiruvaranggam enggE ? ennum **","nANmalarAL nAyaganAy * nAm aRiya AyppADi vaLarndha nambi *","ANmaganAy en magaLaich seydhanagaL * ammanaimIr! aRigilEnE"],["பூண்முலை மேல் சாந்தணியாள் * பொருகயல்","கண் மை எழுதாள் பூவை பேணாள் *","ஏண் அறியாள் எத்தனையும் * எம்பெருமான்","திருவரங்கம் எங்கே ? என்னும் **","நாண்மலராள் நாயகனாய் * நாம் அறிய","ஆய்ப்பாடி வளர்ந்த நம்பி *","ஆண்மகனாய் என் மகளைச் செய்தனகள் *","அம்மனைமீர்! அறிகிலேனே"],0,"/media/recitation/PT.5.5.5.mp3"],[1393,1393,["thAdhADu vana mAlai * thArAnO? enRenRE thaLarndhAL kANmin *","yAdhAnum onRu uraikkil * emperumAn thiruvaranggam ennum ** pUmEl","mAdhALan kuDamADi madhusUdhan * mannarkkAy munnam senRa","thUdhALan * en magaLaich seydhanagaL * engnganam nAn sollugEnE?"],["தாதாடு வன மாலை * தாரானோ?","என்றென்றே தளர்ந்தாள் காண்மின் *","யாதானும் ஒன்று உரைக்கில் * எம்பெருமான்","திருவரங்கம் என்னும் ** பூமேல்","மாதாளன் குடமாடி மதுசூதன் *","மன்னர்க்காய் முன்னம் சென்ற","தூதாளன் * என் மகளைச் செய்தனகள் *","எங்ஙனம் நான் சொல்லுகேனே?"],0,"/media/recitation/PT.5.5.6.mp3"],[1394,1394,["vArALum iLangkonggai * vaNNam vERu AyinavARu eNNAL * eNNil","pErALan pEr allAl pEsAL * ippeN peRREn en seygEn nAn? *","thArALan thaNkuDandhai nagarALan * aivarkkAy amaril uyththa","thErALan * en magaLaich seydhanagaL * engnganam nAn seppugEnE?"],["வாராளும் இளங்கொங்கை * வண்ணம்","வேறு ஆயினவாறு எண்ணாள் * எண்ணில்","பேராளன் பேர் அல்லால் பேசாள் * இப்பெண்","பெற்றேன் என் செய்கேன் நான்? *","தாராளன் தண்குடந்தை நகராளன் *","ஐவர்க்காய் அமரில் உய்த்த","தேராளன் * என் மகளைச் செய்தனகள் *","எங்ஙனம் நான் செப்புகேனே?"],0,"/media/recitation/PT.5.5.7.mp3"],[1395,1395,["uRavAdhum ilaL enRu * ozhiyAdhu palar Esum alar AyiRRAl *","maRavAdhE eppozhudhum * mAyavanE! mAdhavanE! enkinRaLAl **","piRavAdha pErALan peNNALan maNNALan * viNNOr thanggaL","aRavALan * en magaLaich seydhanagaL * ammanaimIr! aRigilEnE"],["உறவாதும் இலள் என்று * ஒழியாது","பலர் ஏசும் அலர் ஆயிற்றால் *","மறவாதே எப்பொழுதும் * மாயவனே!","மாதவனே! என்கின்றளால் **","பிறவாத பேராளன் பெண்ணாளன்","மண்ணாளன் * விண்ணோர் தங்கள்","அறவாளன் * என் மகளைச் செய்தனகள் *","அம்மனைமீர்! அறிகிலேனே"],0,"/media/recitation/PT.5.5.8.mp3"],[1396,1396,["pandhODu kazhal maruvAL * paingkiLiyum pAl UTTAL pAvai pENAL *","vandhAnO! thiruvaranggan * vArAnO? enRenRE vaLaiyum sOrum **","sandhOgan pauzhiyan ainthazhal Ombu * thaiththiriyan sAma vEdhi *","andhO! vandhu en magaLaich seydhanagaL * ammanaimIr! aRigilEnE"],["பந்தோடு கழல் மருவாள் * பைங்கிளியும்","பால் ஊட்டாள் பாவை பேணாள் *","வந்தானோ! திருவரங்கன் * வாரானோ?","என்றென்றே வளையும் சோரும் **","சந்தோகன் பௌழியன் ஐந்தழல் ஓம்பு *","தைத்திரியன் சாம வேதி *","அந்தோ! வந்து என் மகளைச் செய்தனகள் *","அம்மனைமீர்! அறிகிலேனே"],0,"/media/recitation/PT.5.5.9.mp3"],[1397,1397,["** sEl ugaLum vayal puDai sUzh * thiruvaranggaththu ammAnaich sindhai seydha *","nIla malarkkaN maDavAL niRai azhivaith * thAy mozhindha adhanai ** nErAr","kAla vEl parakAlan * kalikanRi oli mAlai kaRRu vallAr *","mAlai sEr veNkuDaik kIzh mannavarAyp * ponnulagil vAzhvar thAmE"],["** சேல் உகளும் வயல் புடை சூழ் * திருவரங்கத்து","அம்மானைச் சிந்தை செய்த *","நீல மலர்க்கண் மடவாள் நிறை அழிவைத் *","தாய் மொழிந்த அதனை ** நேரார்","கால வேல் பரகாலன் * கலிகன்றி ஒலி","மாலை கற்று வல்லார் *","மாலை சேர் வெண்குடைக் கீழ் மன்னவராய்ப் *","பொன்னுலகில் வாழ்வர் தாமே"],0,"/media/recitation/PT.5.5.10.mp3"]],[[1398,1398,["** kaimmAna mazhakaLiRRaik * kaDal kiDandha karumaNiyai *","maimmAna maradhagaththai * maRai uraiththa thirumAlai **","emmAnai enakku enRum iniyAnaip * pani kAththa","ammAnai * yAn kaNDadhu * aNinIrth thennaranggaththE"],["** கைம்மான மழகளிற்றைக் * கடல் கிடந்த கருமணியை *","மைம்மான மரதகத்தை * மறை உரைத்த திருமாலை **","எம்மானை எனக்கு என்றும் இனியானைப் * பனி காத்த","அம்மானை * யான் கண்டது * அணிநீர்த் தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.1.mp3"],[1399,1399,["** pErAnaik * kuRungkuDi emperumAnai * thiruththaNkAl","UrAnaik * karambanUr uththamanai ** muththilanggu","kArAr thiNkaDal Ezhum * malai Ezhu ivvulagu EzhuNDum *","ArAdhenRu irundhAnaik * kaNDadhu thennaranggaththE"],["** பேரானைக் * குறுங்குடி எம்பெருமானை * திருத்தண்கால்","ஊரானைக் * கரம்பனூர் உத்தமனை ** முத்திலங்கு","காரார் திண்கடல் ஏழும் * மலை ஏழு இவ்வுலகு ஏழுண்டும் *","ஆராதென்று இருந்தானைக் * கண்டது தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.2.mp3"],[1400,1400,["EnAgi ulagu iDandhu * anRu irunilanum peru visumbum *","thAnAya perumAnaith * thannaDiyAr manaththu enRum **","thEnAgi amudhAgith * thigazhndhAnai magizhndhu orukAl *","AnAyan AnAnaik * kaNDadhu thennaranggaththE"],["ஏனாகி உலகு இடந்து * அன்று இருநிலனும் பெரு விசும்பும் *","தானாய பெருமானைத் * தன்னடியார் மனத்து என்றும் **","தேனாகி அமுதாகித் * திகழ்ந்தானை மகிழ்ந்து ஒருகால் *","ஆனாயன் ஆனானைக் * கண்டது தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.3.mp3"],[1401,1401,["val̤arntavaṉait taṭaṅ kaṭalul̤ * vali uruvil tiri cakaṭam *","tal̤arntu utira utaittavaṉait * tariyātu aṉṟu iraṇiyaṉaip","pil̤antavaṉai ** pĕru nilam īr aṭi nīṭṭip * paṇṭu ŏrunāl̤","al̤antavaṉai * yāṉ kaṇṭatu * -aṇi nīrt tĕṉ araṅkatte-"],["வளர்ந்தவனைத் தடங் கடலுள் * வலி உருவில் திரி சகடம் *","தளர்ந்து உதிர உதைத்தவனைத் * தரியாது அன்று இரணியனைப்","பிளந்தவனை ** பெரு நிலம் ஈர் அடி நீட்டிப் * பண்டு ஒருநாள்","அளந்தவனை * யான் கண்டது * அணி நீர்த் தென் அரங்கத்தே"],1,"/media/recitation/PT.5.6.4.mp3"],[1402,1402,["nIr azhalAy neDu nilanAy * ninRAnai * anRu arakkan","Ur azhalAl uNDAnaik * kaNDAr pin kANAmE **","pEr azhalAyp peru visumbAyp * pin maRaiyOr mandhiraththin *","Ar azhalAl uNDAnaik * kaNDadhu thennaranggaththE"],["நீர் அழலாய் நெடு நிலனாய் * நின்றானை * அன்று அரக்கன்","ஊர் அழலால் உண்டானைக் * கண்டார் பின் காணாமே **","பேர் அழலாய்ப் பெரு விசும்பாய்ப் * பின் மறையோர் மந்திரத்தின் *","ஆர் அழலால் உண்டானைக் * கண்டது தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.5.mp3"],[1403,1403,["tam ciṉattait tavirttu aṭaintār * tava nĕṟiyai tariyātu *","kañcaṉaik kŏṉṟu * aṉṟu ulakam uṇṭu umizhnta kaṟpakattai **","vĕm ciṉatta kŏṭun tŏzhiloṉ * vicai uruvai acaivitta *","am ciṟaip pul̤ pākaṉai * yāṉ kaṇṭatu-tĕṉ araṅkatte-"],["தம் சினத்தைத் தவிர்த்து அடைந்தார் * தவ நெறியை தரியாது *","கஞ்சனைக் கொன்று * அன்று உலகம் உண்டு உமிழ்ந்த கற்பகத்தை **","வெம் சினத்த கொடுந் தொழிலோன் * விசை உருவை அசைவித்த *","அம் சிறைப் புள் பாகனை * யான் கண்டது தென் அரங்கத்தே"],1,"/media/recitation/PT.5.6.6.mp3"],[1404,1404,["** sindhanaiyaith thava neRiyaith * thirumAlai * piriyAdhu","vandhu enadhu manaththu irundha * vaDamalaiyai ** varivaNDAr","kondhu aNaindha pozhil kOval * ulagu aLappAn aDi nimirththa","andhaNanai * yAn kaNDadhu * aNinIrth thennaranggaththE"],["** சிந்தனையைத் தவ நெறியைத் * திருமாலை * பிரியாது","வந்து எனது மனத்து இருந்த * வடமலையை ** வரிவண்டார்","கொந்து அணைந்த பொழில் கோவல் * உலகு அளப்பான் அடி நிமிர்த்த","அந்தணனை * யான் கண்டது * அணிநீர்த் தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.7.mp3"],[1405,1405,["thuvariththa uDaiyavarkkum * thUymai illAch samaNarkkum *","avargaTku anggu aruL illA * aruLAnai ** than aDaindha","emargaTkum aDiyERkum * emmARkum em anaikkum *","amararkkum pirAnAraik * kaNDadhu thennaranggaththE"],["துவரித்த உடையவர்க்கும் * தூய்மை இல்லாச் சமணர்க்கும் *","அவர்கட்கு அங்கு அருள் இல்லா * அருளானை ** தன் அடைந்த","எமர்கட்கும் அடியேற்கும் * எம்மாற்கும் எம் அனைக்கும் *","அமரர்க்கும் பிரானாரைக் * கண்டது தென்னரங்கத்தே"],0,"/media/recitation/PT.5.6.8.mp3"],[1406,1406,["pŏy vaṇṇam maṉattu akaṟṟip * pulaṉ aintum cĕla vaittu *","mĕy vaṇṇam niṉaintavarkku * mĕyn niṉṟa vittakaṉai **","mai vaṇṇam karu mukilpol * tikazh vaṇṇam maratakattiṉ *","av vaṇṇa vaṇṇaṉai * yāṉ kaṇṭatu-tĕṉ araṅkatte-"],["பொய் வண்ணம் மனத்து அகற்றிப் * புலன் ஐந்தும் செல வைத்து *","மெய் வண்ணம் நினைந்தவர்க்கு * மெய்ந் நின்ற வித்தகனை **","மை வண்ணம் கரு முகில்போல் * திகழ் வண்ணம் மரதகத்தின் *","அவ் வண்ண வண்ணனை * யான் கண்டது தென் அரங்கத்தே"],1,"/media/recitation/PT.5.6.9.mp3"],[1407,1407,["** A maruvi nirai mEyththa * aNi aranggaththu ammAnai *","kAmaru sIrk kalikanRi * oli seydha mali pugazh sEr **","nA maruvu thamizh mAlai * nAl iraNDODu iraNDinaiyum *","thAmaruvi vallAr mEl * sArA thIvinai thAnE"],["** ஆ மருவி நிரை மேய்த்த * அணி அரங்கத்து அம்மானை *","காமரு சீர்க் கலிகன்றி * ஒலி செய்த மலி புகழ் சேர் **","நா மருவு தமிழ் மாலை * நால் இரண்டோடு இரண்டினையும் *","தாமருவி வல்லார் மேல் * சாரா தீவினை தானே"],0,"/media/recitation/PT.5.6.10.mp3"]],[[1408,1408,["** paNDai nAnmaRaiyum vELviyum kELvip","padhanggaLum * padhanggaLin poruLum *","piNDamAy virindha piRanggoLi analum *","perugiya punaloDu nilanum **","koNDal mArudhamum kurai kaDal Ezhum *","Ezhu mAmalaigaLum visumbum *","aNDamum thAnAy ninRa emperumAn *","arangga mA nagar amarndhAnE"],["** பண்டை நான்மறையும் வேள்வியும் கேள்விப்","பதங்களும் * பதங்களின் பொருளும் *","பிண்டமாய் விரிந்த பிறங்கொளி அனலும் *","பெருகிய புனலொடு நிலனும் **","கொண்டல் மாருதமும் குரை கடல் ஏழும் *","ஏழு மாமலைகளும் விசும்பும் *","அண்டமும் தானாய் நின்ற எம்பெருமான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.1.mp3"],[1409,1409,["indhiran piraman Isan enRu ivargaL *","eNNil pal guNanggaLE iyaRRa *","thandhaiyum thAyum makkaLum mikka","suRRamum * suRRi ninRu agalAp","bandhamum ** bandham aRuppadhOr marundhum","pAnmaiyum * pal uyirkku ellAm *","andhamum vAzhvum Aya emperumAn *","arangga mA nagar amarndhAnE"],["இந்திரன் பிரமன் ஈசன் என்று இவர்கள் *","எண்ணில் பல் குணங்களே இயற்ற *","தந்தையும் தாயும் மக்களும் மிக்க","சுற்றமும் * சுற்றி நின்று அகலாப்","பந்தமும் ** பந்தம் அறுப்பதோர் மருந்தும்","பான்மையும் * பல் உயிர்க்கு எல்லாம் *","அந்தமும் வாழ்வும் ஆய எம்பெருமான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.2.m4a"],[1410,1410,["mannu mAnilanum malaigaLum kaDalum *","vAnamum dhAnavar ulagum *","thunnu mA iruLAyth thulanggoLi surunggith *","thollai nAnmaRaigaLum maRaiya **","pinnum vAnavarkkum munivarkkum nalgip *","piRanggiruL niRam keDa * oru nAL","annamAy anRanggu arumaRai payandhAn *","arangga mA nagar amarndhAnE"],["மன்னு மாநிலனும் மலைகளும் கடலும் *","வானமும் தானவர் உலகும் *","துன்னு மா இருளாய்த் துலங்கொளி சுருங்கித் *","தொல்லை நான்மறைகளும் மறைய **","பின்னும் வானவர்க்கும் முனிவர்க்கும் நல்கிப் *","பிறங்கிருள் நிறம் கெட * ஒரு நாள்","அன்னமாய் அன்றங்கு அருமறை பயந்தான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.3.mp3"],[1411,1411,["mA irum kunRam onRu maththAga *","mAsuNam adhanODum aLavi *","pA irum pauvam pagaDu viNDalaRap *","paDuthirai visumbiDaip paDara **","sE iru visumbum thinggaLum suDarum *","dhEvarum thAm uDan thisaippa *","Ayiram thOLAl alai kaDal kaDaindhAn *","arangga mA nagar amarndhAnE"],["மா இரும் குன்றம் ஒன்று மத்தாக *","மாசுணம் அதனோடும் அளவி *","பா இரும் பௌவம் பகடு விண்டலறப் *","படுதிரை விசும்பிடைப் படர **","சே இரு விசும்பும் திங்களும் சுடரும் *","தேவரும் தாம் உடன் திசைப்ப *","ஆயிரம் தோளால் அலை கடல் கடைந்தான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.4.m4a"],[1412,1412,["engnganE uyvar? dhAnavar ninaindhAl *","iraNiyan ilanggu pUN agalam *","ponggu vengkurudhi pon malai piLandhu *","pozhi tharum aruvi oththu izhiya **","vengkaN vAL eyiRROr veLLi mA vilanggal *","viN uRak kanal vizhiththu ezhundhadhu *","angnganE okka ari uruvAnAn *","aranggamA nagar amarndhAnE"],["எங்ஙனே உய்வர்? தானவர் நினைந்தால் *","இரணியன் இலங்கு பூண் அகலம் *","பொங்கு வெங்குருதி பொன் மலை பிளந்து *","பொழி தரும் அருவி ஒத்து இழிய **","வெங்கண் வாள் எயிற்றோர் வெள்ளி மா விலங்கல் *","விண் உறக் கனல் விழித்து எழுந்தது *","அங்ஙனே ஒக்க அரி உருவானான் *","அரங்கமா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.5.mp3"],[1413,1413,["Ayiram kunRam senRu thokkanaiya *","aDal purai ezhil thigazh thiraL thOL *","Ayiram thuNiya aDal mazhup paRRi *","maRRavan agal visumbu aNaiya **","Ayiram peyarAl amarar senRu iRainjcha *","aRi thuyil alai kaDal naDuvE *","Ayiram suDar vAy aravaNaith thuyinRAn *","arangga mA nagar amarndhAnE"],["ஆயிரம் குன்றம் சென்று தொக்கனைய *","அடல் புரை எழில் திகழ் திரள் தோள் *","ஆயிரம் துணிய அடல் மழுப் பற்றி *","மற்றவன் அகல் விசும்பு அணைய **","ஆயிரம் பெயரால் அமரர் சென்று இறைஞ்ச *","அறி துயில் அலை கடல் நடுவே *","ஆயிரம் சுடர் வாய் அரவணைத் துயின்றான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.6.mp3"],[1414,1414,["suri kuzhal kani vAyth thiruvinaip piriththa *","koDumaiyiR kaDuvisai arakkan *","eri vizhiththu ilanggu maNi muDi poDi seydhu *","ilanggai pAzh paDuppadhaRku eNNi **","vari silai vaLaiya aDusaram thurandhu *","maRi kaDal neRi paDa * malaiyAl","arikulam paNi koNDu alai kaDal aDaiththAn *","arangga mA nagar amarndhAnE"],["சுரி குழல் கனி வாய்த் திருவினைப் பிரித்த *","கொடுமையிற் கடுவிசை அரக்கன் *","எரி விழித்து இலங்கு மணி முடி பொடி செய்து *","இலங்கை பாழ் படுப்பதற்கு எண்ணி **","வரி சிலை வளைய அடுசரம் துரந்து *","மறி கடல் நெறி பட * மலையால்","அரிகுலம் பணி கொண்டு அலை கடல் அடைத்தான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.7.mp3"],[1415,1415,["UzhiyAy Omaththu uchchiyAy * orukAl","uDaiya thEr oruvanAy * ulagil","sUzhi mAl yAnaith thuyar keDuththu * ilanggai","malangga anRu aDusaram thurandhu **","pAzhiyAl mikka pArththanukku aruLip *","pagalavan oLi keDa * pagalE","AzhiyAl anRu anggu Azhiyai maRaiththAn *","arangga mA nagar amarndhAnE"],["ஊழியாய் ஓமத்து உச்சியாய் * ஒருகால்","உடைய தேர் ஒருவனாய் * உலகில்","சூழி மால் யானைத் துயர் கெடுத்து * இலங்கை","மலங்க அன்று அடுசரம் துரந்து **","பாழியால் மிக்க பார்த்தனுக்கு அருளிப் *","பகலவன் ஒளி கெட * பகலே","ஆழியால் அன்று அங்கு ஆழியை மறைத்தான் *","அரங்க மா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.8.m4a"],[1416,1416,["pEyin Armulai UN piLLaiyAy orukAl *","peru nilam vizhunggi adhu umizhndha","vAyanAy * mAlAy Alilai vaLarndhu *","maNi muDi vAnavar thamakkuch","sEyanAy ** aDiyERku aNiyanAy vandhu *","en sindhaiyuL venthuyar aRukkum *","AyanAy anRu kunRam onRu eDuththAn *","aranggamA nagar amarndhAnE"],["பேயின் ஆர்முலை ஊண் பிள்ளையாய் ஒருகால் *","பெரு நிலம் விழுங்கி அது உமிழ்ந்த","வாயனாய் * மாலாய் ஆலிலை வளர்ந்து *","மணி முடி வானவர் தமக்குச்","சேயனாய் ** அடியேற்கு அணியனாய் வந்து *","என் சிந்தையுள் வெந்துயர் அறுக்கும் *","ஆயனாய் அன்று குன்றம் ஒன்று எடுத்தான் *","அரங்கமா நகர் அமர்ந்தானே"],0,"/media/recitation/PT.5.7.9.m4a"],[1417,1417,["** ponnum mAmaNiyum muththamum sumandhu *","poruthirai mAnadhi puDai sUzhndhu *","annam mADulavum alai punal sUzhndha *","arangga mA nagar amarndhAnai **","mannu mA mADa manggaiyar thalaivan *","mAnavEl kaliyan vAy oligaL *","panniya panuval pADuvAr * nALum","pazhavinai paRRaRuppArE"],["** பொன்னும் மாமணியும் முத்தமும் சுமந்து *","பொருதிரை மாநதி புடை சூழ்ந்து *","அன்னம் மாடுலவும் அலை புனல் சூழ்ந்த *","அரங்க மா நகர் அமர்ந்தானை **","மன்னு மா மாட மங்கையர் தலைவன் *","மானவேல் கலியன் வாய் ஒலிகள் *","பன்னிய பனுவல் பாடுவார் * நாளும்","பழவினை பற்றறுப்பாரே"],0,"/media/recitation/PT.5.7.10.mp3"]],[[1418,1418,["** Ezhai Edhalan kIzh magan ennAdhu","iranggi * maRRu avaRku innaruL surandhu *","mAzhai mAn maDa nOkki un thOzhi *","umbi embi enRu ozhindhilai ** ugandhu","thOzhan nI enakku inggu ozhi enRa","soRkaL vandhu * aDiyEn manaththu irundhiDa *","Azhi vaNNa! nin aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["** ஏழை ஏதலன் கீழ் மகன் என்னாது","இரங்கி * மற்று அவற்கு இன்னருள் சுரந்து *","மாழை மான் மட நோக்கி உன் தோழி *","உம்பி எம்பி என்று ஒழிந்திலை ** உகந்து","தோழன் நீ எனக்கு இங்கு ஒழி என்ற","சொற்கள் வந்து * அடியேன் மனத்து இருந்திட *","ஆழி வண்ண! நின் அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.1.mp3"],[1419,1419,["vāta mā makaṉ markkaṭam vilaṅku *","maṟṟu or cāti ĕṉṟu ŏzhintilai * ukantu","kātal ātaram kaṭaliṉum pĕrukac *","cĕytakaviṉukku illai kaimmāṟu ** ĕṉṟu","kotu il vāymaiyiṉāyŏṭum uṭaṉe *","uṇpaṉ nāṉ ĕṉṟa ŏṇ pŏrul̤ * ĕṉakkum","ātal veṇṭum ĕṉṟu aṭi-iṇai aṭainteṉ *","-aṇi pŏzhil tiruvaraṅkattu ammāṉe-"],["வாத மா மகன் மர்க்கடம் விலங்கு *","மற்று ஓர் சாதி என்று ஒழிந்திலை * உகந்து","காதல் ஆதரம் கடலினும் பெருகச் *","செய்தகவினுக்கு இல்லை கைம்மாறு ** என்று","கோது இல் வாய்மையினாயொடும் உடனே *","உண்பன் நான் என்ற ஒண் பொருள் * எனக்கும்","ஆதல் வேண்டும் என்று அடி இணை அடைந்தேன் *","அணி பொழில் திருவரங்கத்து அம்மானே"],1,"/media/recitation/PT.5.8.2.m4a"],[1420,1420,["kaDikoL pUmpozhil kAmaru poygai *","vaigu thAmarai vAnggiya vEzham *","muDiyum vaNNam Or muzhu vali mudhalai","paRRa * maRRu adhu nin charaN ninaippa **","koDiya vAy vilanggin uyir malanggak *","koNDa sIRRam onRuNDu uLadhu aRindhu * un","aDiyanEnum vandhu aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["கடிகொள் பூம்பொழில் காமரு பொய்கை *","வைகு தாமரை வாங்கிய வேழம் *","முடியும் வண்ணம் ஓர் முழு வலி முதலை","பற்ற * மற்று அது நின் சரண் நினைப்ப **","கொடிய வாய் விலங்கின் உயிர் மலங்கக் *","கொண்ட சீற்றம் ஒன்றுண்டு உளது அறிந்து * உன்","அடியனேனும் வந்து அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.3.mp3"],[1421,1421,["nanjchu sOrvadhOr venjchina aravam *","veruvi vandhu nin charaN enach saraNA *","nenjchil koNDu nin anjchiRaip paRavaikku *","aDaikkalam koDuththu aruL seydhadhu aRindhu **","venjchol ALargaL naman thamar kaDiyar *","koDiya seyvana uLa * adhaRku aDiyEn","anjchi vandhu nin aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["நஞ்சு சோர்வதோர் வெஞ்சின அரவம் *","வெருவி வந்து நின் சரண் எனச் சரணா *","நெஞ்சில் கொண்டு நின் அஞ்சிறைப் பறவைக்கு *","அடைக்கலம் கொடுத்து அருள் செய்தது அறிந்து **","வெஞ்சொல் ஆளர்கள் நமன் தமர் கடியர் *","கொடிய செய்வன உள * அதற்கு அடியேன்","அஞ்சி வந்து நின் அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.4.mp3"],[1422,1422,["mAga mAnilam muzhuvadhum vandhu iRainjchum *","malar aDi kaNDa mAmaRaiyALan *","thOgai mAmayil annavar inbam *","thuRRilAmaiyil aththa! inggu ozhindhu **","bOgam nI eydhip pinnum nam iDaikkE *","pOdhuvAy enRa pon aruL * enakkum","Aga vENDum enRu aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["மாக மாநிலம் முழுவதும் வந்து இறைஞ்சும் *","மலர் அடி கண்ட மாமறையாளன் *","தோகை மாமயில் அன்னவர் இன்பம் *","துற்றிலாமையில் அத்த! இங்கு ஒழிந்து **","போகம் நீ எய்திப் பின்னும் நம் இடைக்கே *","போதுவாய் என்ற பொன் அருள் * எனக்கும்","ஆக வேண்டும் என்று அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.5.mp3"],[1423,1423,["mannu nAnmaRai mAmuni peRRa","maindhanai * madhiyAdha vengkURRam","thannai anjchi * nin charaN enach saraNAyth *","thagavil kAlanai uga munindhu ozhiyA **","pinnai enRum nin thiruvaDi piriyA vaNNam *","eNNiya pEraruL * enakkum","annadhu Agum enRu aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["மன்னு நான்மறை மாமுனி பெற்ற","மைந்தனை * மதியாத வெங்கூற்றம்","தன்னை அஞ்சி * நின் சரண் எனச் சரணாய்த் *","தகவில் காலனை உக முனிந்து ஒழியா **","பின்னை என்றும் நின் திருவடி பிரியா வண்ணம் *","எண்ணிய பேரருள் * எனக்கும்","அன்னது ஆகும் என்று அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.6.mp3"],[1424,1424,["Odhu vAymaiyum uvaniyap piRappum *","unakku mun thandha andhaNan oruvan *","kAdhal en magan pugal iDam kANEn *","kaNDu nI tharuvAy enakkenRu **","kOdhil vAymaiyinAn unai vENDiya *","kuRai muDiththu avan siRuvanaik koDuththAy *","AdhalAl vandhu un aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["ஓது வாய்மையும் உவனியப் பிறப்பும் *","உனக்கு முன் தந்த அந்தணன் ஒருவன் *","காதல் என் மகன் புகல் இடம் காணேன் *","கண்டு நீ தருவாய் எனக்கென்று **","கோதில் வாய்மையினான் உனை வேண்டிய *","குறை முடித்து அவன் சிறுவனைக் கொடுத்தாய் *","ஆதலால் வந்து உன் அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.7.mp3"],[1425,1425,["vEdha vAymozhi andhaNan oruvan *","endhai! nin charaN ennuDai manaivi *","kAdhal makkaLaip payaththalum kANAL *","kaDiyadhOr dheyvam koNDu oLikkum enRazhaippa **","EdhalAr munnE innaruL avaRkuch","seydhu * un makkaL maRRivar enRu koDuththAy *","AdhalAl vandhu un aDiyiNai aDaindhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["வேத வாய்மொழி அந்தணன் ஒருவன் *","எந்தை! நின் சரண் என்னுடை மனைவி *","காதல் மக்களைப் பயத்தலும் காணாள் *","கடியதோர் தெய்வம் கொண்டு ஒளிக்கும் என்றழைப்ப **","ஏதலார் முன்னே இன்னருள் அவற்குச்","செய்து * உன் மக்கள் மற்றிவர் என்று கொடுத்தாய் *","ஆதலால் வந்து உன் அடியிணை அடைந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.8.mp3"],[1426,1426,["** thuLanggu nINmuDi arasar tham kurisil *","thoNDai mannavan thiN thiRal oruvaRku *","uLangkoL anbinODu innaruL surandhu *","anggu ODu nAzhigai EzhuDan iruppa **","vaLangkoL mandhiram maRRu avaRku aruLich","seydhavARu * aDiyEn aRindhu * ulagam","aLandha ponnaDiyE aDaindhu uyndhEn *","aNipozhil thiruvaranggaththu ammAnE!"],["** துளங்கு நீண்முடி அரசர் தம் குரிசில் *","தொண்டை மன்னவன் திண் திறல் ஒருவற்கு *","உளங்கொள் அன்பினோடு இன்னருள் சுரந்து *","அங்கு ஓடு நாழிகை ஏழுடன் இருப்ப **","வளங்கொள் மந்திரம் மற்று அவற்கு அருளிச்","செய்தவாறு * அடியேன் அறிந்து * உலகம்","அளந்த பொன்னடியே அடைந்து உய்ந்தேன் *","அணிபொழில் திருவரங்கத்து அம்மானே!"],0,"/media/recitation/PT.5.8.9.mp3"],[1427,1427,["** mADamALigai sUzh thirumanggai","mannan * onnalar thanggaLai vellum *","ADal mA valavan kali kanRi *","aNipozhil thiruvaranggaththu ammAnai **","nIDu thol pugazh Azhi vallAnai *","endhaiyai neDumAlai ninaindha *","pADal paththu ivai pADumin thoNDIr! *","pADa nummiDaip pAvam nillAvE"],["** மாடமாளிகை சூழ் திருமங்கை","மன்னன் * ஒன்னலர் தங்களை வெல்லும் *","ஆடல் மா வலவன் கலி கன்றி *","அணிபொழில் திருவரங்கத்து அம்மானை **","நீடு தொல் புகழ் ஆழி வல்லானை *","எந்தையை நெடுமாலை நினைந்த *","பாடல் பத்து இவை பாடுமின் தொண்டீர்! *","பாட நும்மிடைப் பாவம் நில்லாவே"],0,"/media/recitation/PT.5.8.10.mp3"]],[[1428,1428,["** kai ilanggu Azhi sanggan * karumugil thiruniRaththan *","poy ilan meyyan than thAL * aDaivarEl aDimai Akkum **","sey alar kamalam Onggu * seRi pozhil thenthiruppEr *","pai aravaNaiyAn nAmam * paravi nAn uyndhavARE!"],["** கை இலங்கு ஆழி சங்கன் * கருமுகில் திருநிறத்தன் *","பொய் இலன் மெய்யன் தன் தாள் * அடைவரேல் அடிமை ஆக்கும் **","செய் அலர் கமலம் ஓங்கு * செறி பொழில் தென்திருப்பேர் *","பை அரவணையான் நாமம் * பரவி நான் உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.1.mp3"],[1429,1429,["vanggam Ar kaDalgaL Ezhum * malaiyum vAnagamum maRRum *","anggaN mA njAlam ellAm * amudhu seydhu umizhndha endhai **","thinggaL mAmugil aNavu * seRi pozhil thenthiruppEr *","enggaL mAl iRaivan nAmam * Eththi nAn uyndhavARE!"],["வங்கம் ஆர் கடல்கள் ஏழும் * மலையும் வானகமும் மற்றும் *","அங்கண் மா ஞாலம் எல்லாம் * அமுது செய்து உமிழ்ந்த எந்தை **","திங்கள் மாமுகில் அணவு * செறி பொழில் தென்திருப்பேர் *","எங்கள் மால் இறைவன் நாமம் * ஏத்தி நான் உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.2.mp3"],[1430,1430,["oruvanai undhip pU mEl * Ongguviththu Agam thannAl *","oruvanaich sAbam nIkki * umbar AL enRu viTTAn **","peruvarai madhiLgaL sUzhndha * perunagar aravaNai mEl *","karuvarai vaNNan thenpEr * karudhi nAn uyndhavARE!"],["ஒருவனை உந்திப் பூ மேல் * ஓங்குவித்து ஆகம் தன்னால் *","ஒருவனைச் சாபம் நீக்கி * உம்பர் ஆள் என்று விட்டான் **","பெருவரை மதிள்கள் சூழ்ந்த * பெருநகர் அரவணை மேல் *","கருவரை வண்ணன் தென்பேர் * கருதி நான் உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.3.mp3"],[1431,1431,["Un amar thalai onRu Endhi * ulagelAm thiriyum Isan *","In amar sAbam nIkkAy enna * oN punalai IndhAn **","thEn amar pozhilgaL sUzhndha * seRi vayal thenthiruppEr *","vAnavar thalaivan nAmam * vAzhththi nAn uyndhavARE!"],["ஊன் அமர் தலை ஒன்று ஏந்தி * உலகெலாம் திரியும் ஈசன் *","ஈன் அமர் சாபம் நீக்காய் என்ன * ஒண் புனலை ஈந்தான் **","தேன் அமர் பொழில்கள் சூழ்ந்த * செறி வயல் தென்திருப்பேர் *","வானவர் தலைவன் நாமம் * வாழ்த்தி நான் உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.4.mp3"],[1432,1432,["vakkaran vAy mun kINDa * mAyanE! enRu vAnOr","pukku * araN thandhu aruLAy ennap * pon AgaththAnai **","nakkari uruvamAgi * nagam kiLarndhu iDandhu ugandha *","chakkarach chelvan thenpErth * thalaivan thAL aDaindhu uyndhEnE"],["வக்கரன் வாய் முன் கீண்ட * மாயனே! என்று வானோர்","புக்கு * அரண் தந்து அருளாய் என்னப் * பொன் ஆகத்தானை **","நக்கரி உருவமாகி * நகம் கிளர்ந்து இடந்து உகந்த *","சக்கரச் செல்வன் தென்பேர்த் * தலைவன் தாள் அடைந்து உய்ந்தேனே"],0,"/media/recitation/PT.5.9.5.mp3"],[1433,1433,["vilanggalAl kaDal aDaiththu * viLanggizhai poruTTu * villAl","ilanggai mAnagarkku iRaivan * irupadhu puyam thuNiththAn **","nalangkoL nAnmaRai vallArgaL * Oththoli Eththak kETTu *","malanggu pAy vayal thiruppEr * maruvi nAn vAzhndhavARE!"],["விலங்கலால் கடல் அடைத்து * விளங்கிழை பொருட்டு * வில்லால்","இலங்கை மாநகர்க்கு இறைவன் * இருபது புயம் துணித்தான் **","நலங்கொள் நான்மறை வல்லார்கள் * ஓத்தொலி ஏத்தக் கேட்டு *","மலங்கு பாய் வயல் திருப்பேர் * மருவி நான் வாழ்ந்தவாறே!"],0,"/media/recitation/PT.5.9.6.mp3"],[1434,1434,["veNNey thAn amudhu seyya * veguNDu maththAychchi Ochchi *","kaNNiyar kuRungkayiRRAl * kaTTa veTTenRu irundhAn **","thiNNa mAmadhiLgaL sUzhndha * thenthiruppEruL * vElai","vaNNanAr nAmam nALum * vAy mozhindhu uyndhavARE!"],["வெண்ணெய் தான் அமுது செய்ய * வெகுண்டு மத்தாய்ச்சி ஓச்சி *","கண்ணியர் குறுங்கயிற்றால் * கட்ட வெட்டென்று இருந்தான் **","திண்ண மாமதிள்கள் சூழ்ந்த * தென்திருப்பேருள் * வேலை","வண்ணனார் நாமம் நாளும் * வாய் மொழிந்து உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.7.mp3"],[1435,1435,["amponAr ulagam Ezhum aRiya * AyppADi thannuL *","kombanAr pinnai kOlam * kUDudhaRku ERu konRAn **","semponAr madhiLgaL sUzhndha * thenthiruppEruL mEvum *","empirAn nAmam nALum * Eththi nAn uyndhavARE!"],["அம்பொனார் உலகம் ஏழும் அறிய * ஆய்ப்பாடி தன்னுள் *","கொம்பனார் பின்னை கோலம் * கூடுதற்கு ஏறு கொன்றான் **","செம்பொனார் மதிள்கள் சூழ்ந்த * தென்திருப்பேருள் மேவும் *","எம்பிரான் நாமம் நாளும் * ஏத்தி நான் உய்ந்தவாறே!"],0,"/media/recitation/PT.5.9.8.mp3"],[1436,1436,["nAl vagai vEdham aindhu vELvi * ARanggam vallAr *","mElai vAnavaril mikka * vEdhiyar Adhi kAlam **","sEl ugaL vayal thiruppErch * sengkaN mAlODum vAzhvAr *","sIla mA thavaththar sindhai ALi * en sindhaiyAnE"],["நால் வகை வேதம் ஐந்து வேள்வி * ஆறங்கம் வல்லார் *","மேலை வானவரில் மிக்க * வேதியர் ஆதி காலம் **","சேல் உகள் வயல் திருப்பேர்ச் * செங்கண் மாலோடும் வாழ்வார் *","சீல மா தவத்தர் சிந்தை ஆளி * என் சிந்தையானே"],0,"/media/recitation/PT.5.9.9.mp3"],[1437,1437,["** vaNDaRai pozhil thiruppEr * vari aravaNaiyil paLLi","koNDu * uRaiginRa mAlaik * koDi madhiL mADa manggai **","thiNthiRal thOL kaliyan * senjcholAl mozhindha mAlai *","koNDivai pADi ADak * kUDuvar nIL visumbE"],["** வண்டறை பொழில் திருப்பேர் * வரி அரவணையில் பள்ளி","கொண்டு * உறைகின்ற மாலைக் * கொடி மதிள் மாட மங்கை **","திண்திறல் தோள் கலியன் * செஞ்சொலால் மொழிந்த மாலை *","கொண்டிவை பாடி ஆடக் * கூடுவர் நீள் விசும்பே"],0,"/media/recitation/PT.5.9.10.mp3"]],[[1438,1438,["** thIdhaRu nilaththoDu eri kAlinoDu * nIrkezhu visumbum avaiyAy *","mAsaRu manaththinoDu uRakkamoDu iRakkai * avai Aya perumAn **","thAy seRa uLaindhu thayir uNDu kuDamADu * thaDamArvar thagai sEr *","nAdhan uRaiginRa nagar * nandhipura viNNagaram naNNu manamE!"],["** தீதறு நிலத்தொடு எரி காலினொடு *","நீர்கெழு விசும்பும் அவையாய் *","மாசறு மனத்தினொடு உறக்கமொடு இறக்கை *","அவை ஆய பெருமான் **","தாய் செற உளைந்து தயிர் உண்டு குடமாடு *","தடமார்வர் தகை சேர் *","நாதன் உறைகின்ற நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.1.mp3"],[1439,1439,["uyyum vagai uNDu sona seyyil * ulagEzhum ozhiyAmai muna nAL *","meyyin aLavE amudhu seyya vala * aiyan avan mEvu nagar thAn **","maiya varivaNDu madhu uNDu kiLaiyODu * malar kiNDi adhan mEl *","naivaLam naviRRu pozhil * nandhipura viNNagaram naNNu manamE!"],["உய்யும் வகை உண்டு சொன செய்யில் *","உலகேழும் ஒழியாமை முன நாள் *","மெய்யின் அளவே அமுது செய்ய வல *","ஐயன் அவன் மேவு நகர் தான் **","மைய வரிவண்டு மது உண்டு கிளையோடு *","மலர் கிண்டி அதன் மேல் *","நைவளம் நவிற்று பொழில் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.2.m4a"],[1440,1440,["umbar ulagEzhu kaDal Ezhu malai Ezhum * ozhiyAmai muna nAL *","tham pon vayiRu AraLavum uNDu avai umizhndha * thaDamArvar thagai sEr **","vambu malarginRa pozhil paimpon varu thumbi maNi * kanggul vayal sUzh *","namban uRaiginRa nagar * nandhipura viNNagaram naNNu manamE!"],["உம்பர் உலகேழு கடல் ஏழு மலை ஏழும் *","ஒழியாமை முன நாள் *","தம் பொன் வயிறு ஆரளவும் உண்டு அவை உமிழ்ந்த *","தடமார்வர் தகை சேர் **","வம்பு மலர்கின்ற பொழில் பைம்பொன் வரு தும்பி மணி *","கங்குல் வயல் சூழ் *","நம்பன் உறைகின்ற நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.3.m4a"],[1441,1441,["piṟaiyiṉ ŏl̤i ĕyiṟu ilaka muṟuki ĕtir pŏrutum ĕṉa *","vanta acurar *","iṟaikal̤-avai-nĕṟu-nĕṟu ĕṉa vĕṟiya-avar vayiṟu azhala *","niṉṟa pĕrumāṉ **","ciṟai kŏl̤ mayil kuyil payila malarkal̤ uka al̤i murala *","aṭikŏl̤ nĕṭu mā *","naṟaicĕy pŏzhil mazhai tavazhum * nantipuraviṇṇakaram-","naṇṇu maṉame-"],["பிறையின் ஒளி எயிறு இலக முறுகி எதிர் பொருதும் என *","வந்த அசுரர் *","இறைகள் அவை நெறு நெறு என வெறிய அவர் வயிறு அழல *","நின்ற பெருமான் **","சிறை கொள் மயில் குயில் பயில மலர்கள் உக அளி முரல *","அடிகொள் நெடு மா *","நறைசெய் பொழில் மழை தவழும் * நந்திபுரவிண்ணகரம்","நண்ணு மனமே"],1,"/media/recitation/PT.5.10.4.mp3"],[1442,1442,["mULa eri sindhi muniveydhi amar seydhum ena * vandha asurar *","thOLum avar thALum muDiyODu poDiyAga * noDiyAm aLavu eydhAn **","vALum vari villum vaLai Azhi kadhai sanggam ivai * angkai uDaiyAn *","nALum uRaiginRa nagar * nandhipura viNNagaram naNNu manamE!"],["மூள எரி சிந்தி முனிவெய்தி அமர் செய்தும்","என * வந்த அசுரர் *","தோளும் அவர் தாளும் முடியோடு பொடியாக *","நொடியாம் அளவு எய்தான் **","வாளும் வரி வில்லும் வளை ஆழி கதை","சங்கம் இவை * அங்கை உடையான் *","நாளும் உறைகின்ற நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.5.mp3"],[1443,1443,["thambiyoDu thAm oruvar than thuNaivi kAdhal * thuNaiyAga muna nAL *","vembi eri kAnagam ulAvum avar thAm * inidhu mEvu nagar thAn **","kombu kudhi koNDu kuyil kUva mayil Alum * ezhilAr puRavu sEr *","nambi uRaiginRa nagar * nandhipura viNNagaram naNNu manamE!"],["தம்பியொடு தாம் ஒருவர் தன் துணைவி","காதல் * துணையாக முன நாள் *","வெம்பி எரி கானகம் உலாவும் அவர் தாம் *","இனிது மேவு நகர் தான் **","கொம்பு குதி கொண்டு குயில் கூவ மயில்","ஆலும் * எழிலார் புறவு சேர் *","நம்பி உறைகின்ற நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.6.m4a"],[1444,1444,["thandhai manam undhu thuyar nandha iruL vandha viRal * nandhan madhalai *","endhai ivan enRu amarar kandha malar koNDu thozha * ninRa nagar thAn **","mandha muzhavOsai mazhaiyAga ezhu kAr * mayilgaL ADu pozhil sUzh *","nandhi paNi seydha nagar * nandhipura viNNagaram naNNu manamE!"],["தந்தை மனம் உந்து துயர் நந்த இருள்","வந்த விறல் * நந்தன் மதலை *","எந்தை இவன் என்று அமரர் கந்த மலர் கொண்டு","தொழ * நின்ற நகர் தான் **","மந்த முழவோசை மழையாக எழு கார் *","மயில்கள் ஆடு பொழில் சூழ் *","நந்தி பணி செய்த நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.7.mp3"],[1445,1445,["eNNil ninaivu eydhi ini illai iRai enRu * muniyALar thiru Ar *","paNNil mali kIdhamoDu pADi avar ADaloDu * kUDa ezhil Ar **","maNNil idhu pOla nagar illai ena * vAnavargaL thAm malargaL thUy *","naNNi uRaiginRa nagar * nandhipura viNNagaram naNNu manamE!"],["எண்ணில் நினைவு எய்தி இனி இல்லை இறை","என்று * முனியாளர் திரு ஆர் *","பண்ணில் மலி கீதமொடு பாடி அவர்","ஆடலொடு * கூட எழில் ஆர் **","மண்ணில் இது போல நகர் இல்லை என *","வானவர்கள் தாம் மலர்கள் தூய் *","நண்ணி உறைகின்ற நகர் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.8.m4a"],[1446,1446,["vangga mali pauvam adhu mA mugaDin uchchi puga * mikka perunIr *","anggam azhiyAr avanadhu ANai thalai sUDum * aDiyAr aRidhiyEl **","ponggu punal undhu maNi kanggul iruL sIRum oLi * enggum uLadhAl *","nanggaL perumAn uRaiyum * nandhipura viNNagaram naNNu manamE!"],["வங்க மலி பௌவம் அது மா முகடின்","உச்சி புக * மிக்க பெருநீர் *","அங்கம் அழியார் அவனது ஆணை தலை","சூடும் * அடியார் அறிதியேல் **","பொங்கு புனல் உந்து மணி கங்குல் இருள்","சீறும் ஒளி * எங்கும் உளதால் *","நங்கள் பெருமான் உறையும் *","நந்திபுர விண்ணகரம் நண்ணு மனமே!"],0,"/media/recitation/PT.5.10.9.mp3"],[1447,1447,["** naRai sey pozhil mazhai thavazhum * nandhipura viNNagaram naNNi uRaiyum *","uRai koL pugar Azhi suri sanggam * avai angkai uDaiyAnai ** oLi sEr","kaRai vaLarum vEl valla * kaliyan oli mAlai ivai aindhum aindhum *","muRaiyil ivai payila vala aDiyavargaL koDuvinaigaL * muzhudhagalumE"],["** நறை செய் பொழில் மழை தவழும் *","நந்திபுர விண்ணகரம் நண்ணி உறையும் *","உறை கொள் புகர் ஆழி சுரி சங்கம் *","அவை அங்கை உடையானை ** ஒளி சேர்","கறை வளரும் வேல் வல்ல * கலியன் ஒலி","மாலை இவை ஐந்தும் ஐந்தும் *","முறையில் இவை பயில வல அடியவர்கள்","கொடுவினைகள் * முழுதகலுமே"],0,"/media/recitation/PT.5.10.10.mp3"]]]