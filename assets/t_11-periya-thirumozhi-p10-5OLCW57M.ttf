[[[1648,1648,["** silai ilanggu ponnAzhi * thiNpaDai thaNDu","oNsanggam enginRALAl *","malai ilanggu thOL nAngE * maRRu avanukku","eRRE kAN enginRALAl **","mulai ilanggu pUmpayalai * munbODa","anbODi irukkinRALAl *","kalai ilanggu mozhiyALar * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["** சிலை இலங்கு பொன்னாழி * திண்படை தண்டு","ஒண்சங்கம் என்கின்றாளால் *","மலை இலங்கு தோள் நான்கே * மற்று அவனுக்கு","எற்றே காண் என்கின்றாளால் **","முலை இலங்கு பூம்பயலை * முன்போட","அன்போடி இருக்கின்றாளால் *","கலை இலங்கு மொழியாளர் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.1.mp3"],[1649,1649,["** seru varai mun AsaRuththa * silai anRO?","kaiththalaththadhu enginRALAl *","poru varai mun pOr tholaiththa * ponnAzhi","maRRoru kai enginRALAl **","oruvaraiyum nin oppAr * oppilA","en appA! enginRALAl *","karu varai pOl ninRAnaik * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["** செரு வரை முன் ஆசறுத்த * சிலை அன்றோ?","கைத்தலத்தது என்கின்றாளால் *","பொரு வரை முன் போர் தொலைத்த * பொன்னாழி","மற்றொரு கை என்கின்றாளால் **","ஒருவரையும் நின் ஒப்பார் * ஒப்பிலா","என் அப்பா! என்கின்றாளால் *","கரு வரை போல் நின்றானைக் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.2.mp3"],[1650,1650,["thunnu mAmaNi muDi mEl * thuzhAy alanggal","thOnRumAl enginRALAl *","minnu mAmaNi magara kuNDalanggaL *","vil vIsum enginRALAl **","ponnin mAmaNi Aram * aNi Agaththu","ilanggumAl enginRALAl *","kanni mAmadhiL puDai sUzh * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["துன்னு மாமணி முடி மேல் * துழாய் அலங்கல்","தோன்றுமால் என்கின்றாளால் *","மின்னு மாமணி மகர குண்டலங்கள் *","வில் வீசும் என்கின்றாளால் **","பொன்னின் மாமணி ஆரம் * அணி ஆகத்து","இலங்குமால் என்கின்றாளால் *","கன்னி மாமதிள் புடை சூழ் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.3.mp3"],[1651,1651,["thAr Aya thaNthuLaba * vaNDuzhudha","varai mArban enginRALAl *","pOr Anaik kombosiththa * puTpAgan","en ammAn enginRALAl **","ArAnum kANmingaL * ampavaLam","vAy avanukku enginRALAl *","kAr vAnam ninRadhirum * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["தார் ஆய தண்துளப * வண்டுழுத","வரை மார்பன் என்கின்றாளால் *","போர் ஆனைக் கொம்பொசித்த * புட்பாகன்","என் அம்மான் என்கின்றாளால் **","ஆரானும் காண்மின்கள் * அம்பவளம்","வாய் அவனுக்கு என்கின்றாளால் *","கார் வானம் நின்றதிரும் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.4.mp3"],[1652,1652,["aDiththalamum thAmaraiyE * angkaigaLum","panggayamE enginRALAl *","muDith thalamum poRpUNum * en nenjchaththu","uL agalAdhu enginRALAl **","vaDith thaDangkaN malaravaLO * varai Agaththu","uL iruppAL enginRALAl *","kaDikkamalam kaL ugukkum * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["அடித்தலமும் தாமரையே * அங்கைகளும்","பங்கயமே என்கின்றாளால் *","முடித் தலமும் பொற்பூணும் * என் நெஞ்சத்து","உள் அகலாது என்கின்றாளால் **","வடித் தடங்கண் மலரவளோ * வரை ஆகத்து","உள் இருப்பாள் என்கின்றாளால் *","கடிக்கமலம் கள் உகுக்கும் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.5.mp3"],[1653,1653,["pEr Ayiram uDaiya pEr ALan *","pEr ALan enginRALAl *","ErAr kana makara kuNDalaththan *","eNthOLan enginRALAl **","nIrAr mazhai mugilE * nIL varaiyE","okkumAl enginRALAl *","kArAr vayal amarum * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["பேர் ஆயிரம் உடைய பேர் ஆளன் *","பேர் ஆளன் என்கின்றாளால் *","ஏரார் கன மகர குண்டலத்தன் *","எண்தோளன் என்கின்றாளால் **","நீரார் மழை முகிலே * நீள் வரையே","ஒக்குமால் என்கின்றாளால் *","காரார் வயல் அமரும் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.6.mp3"],[1654,1654,["sevvaraththa uDai ADai * adhan mEl Or","sivaLigaik kachchu enginRALAl *","avvaraththa aDi iNaiyum * angkaigaLum","panggayamE enginRALAl **","mai vaLarkkum maNi uruvam * maragadhamO!","mazhai mugilO! enginRALAl *","kai vaLarkkum azhal ALar * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["செவ்வரத்த உடை ஆடை * அதன் மேல் ஓர்","சிவளிகைக் கச்சு என்கின்றாளால் *","அவ்வரத்த அடி இணையும் * அங்கைகளும்","பங்கயமே என்கின்றாளால் **","மை வளர்க்கும் மணி உருவம் * மரகதமோ!","மழை முகிலோ! என்கின்றாளால் *","கை வளர்க்கும் அழல் ஆளர் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.7.mp3"],[1655,1655,["koRRap puL onRERi * manRUDE","varuginRAn enginRALAl *","veRRip pOr indhiraRkum * indhiranE","okkumAl enginRALAl **","peRRakkAl avan Agam * peN piRandhOm","uyyOmO! enginRALAl *","kaRRa nUl maRai ALar * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["கொற்றப் புள் ஒன்றேறி * மன்றூடே","வருகின்றான் என்கின்றாளால் *","வெற்றிப் போர் இந்திரற்கும் * இந்திரனே","ஒக்குமால் என்கின்றாளால் **","பெற்றக்கால் அவன் ஆகம் * பெண் பிறந்தோம்","உய்யோமோ! என்கின்றாளால் *","கற்ற நூல் மறை ஆளர் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.8.mp3"],[1656,1656,["vaNDamarum vanamAlai * maNi muDi mEl","maNa nARum enginRALAl *","uNDivar pAl anbu enakkenRu * oru kAlum","pirigilEn enginRALAl **","paNDivaraik kaNDu aRivadhu evvUril? *","yAm enRE payilginRALAl *","kaNDavar tham manam vazhanggum * kaNNapuraththu","ammAnaik kaNDAL kolO?"],["வண்டமரும் வனமாலை * மணி முடி மேல்","மண நாறும் என்கின்றாளால் *","உண்டிவர் பால் அன்பு எனக்கென்று * ஒரு காலும்","பிரிகிலேன் என்கின்றாளால் **","பண்டிவரைக் கண்டு அறிவது எவ்வூரில்? *","யாம் என்றே பயில்கின்றாளால் *","கண்டவர் தம் மனம் வழங்கும் * கண்ணபுரத்து","அம்மானைக் கண்டாள் கொலோ?"],0,"/media/recitation/PT.8.1.9.mp3"],[1657,1657,["** mA vaLaru mennOkki * mAdharAL","mAyavanaik kaNDAL enRu *","kA vaLarum kaDipozhil sUzh * kaNNapuraththu","ammAnaik kaliyan sonna **","pA vaLarum thamizh mAlai * panniya nUl","ivai aindhum aindhum vallAr *","pU vaLarum kaRpagam sEr * ponnulagil","mannavarAyp pugazh thakkOrE"],["** மா வளரு மென்னோக்கி * மாதராள்","மாயவனைக் கண்டாள் என்று *","கா வளரும் கடிபொழில் சூழ் * கண்ணபுரத்து","அம்மானைக் கலியன் சொன்ன **","பா வளரும் தமிழ் மாலை * பன்னிய நூல்","இவை ஐந்தும் ஐந்தும் வல்லார் *","பூ வளரும் கற்பகம் சேர் * பொன்னுலகில்","மன்னவராய்ப் புகழ் தக்கோரே"],0,"/media/recitation/PT.8.1.10.mp3"]],[[1658,1658,["** theLLiyIr! * dhEvarkkum dhEvar thiruththakkIr! *","veLLiyIr! * veyya vizhu nidhi vaNNar ** O!","thuLLu nIrk * kaNNapuram thozhudhAL ivaL","kaLviyO! * kai vaLai koLvadhu thakkadhE?"],["** தெள்ளியீர்! * தேவர்க்கும் தேவர் திருத்தக்கீர்! *","வெள்ளியீர்! * வெய்ய விழு நிதி வண்ணர் ** ஓ!","துள்ளு நீர்க் * கண்ணபுரம் தொழுதாள் இவள்","கள்வியோ! * கை வளை கொள்வது தக்கதே?"],0,"/media/recitation/PT.8.2.1.mp3"],[1659,1659,["** nINilA muRRaththu * ninRu ivaL nOkkinAL *","kANumO! * kaNNapuram enRu kATTinAL **","pANanAr thiNNam irukka * ini ivaL","nANumO? * nanRu nanRu naRaiyUrarkkE"],["** நீணிலா முற்றத்து * நின்று இவள் நோக்கினாள் *","காணுமோ! * கண்ணபுரம் என்று காட்டினாள் **","பாணனார் திண்ணம் இருக்க * இனி இவள்","நாணுமோ? * நன்று நன்று நறையூரர்க்கே"],0,"/media/recitation/PT.8.2.2.mp3"],[1660,1660,["** aruvi sOr vEnggaDam * nIrmalai enRu vAy","veruvinAL * meyyam vinavi irukkinRAL **","perugu sIrk * kaNNapuram enRu pEsinAL","uruginAL * uL melindhAL * idhu en kolO?"],["** அருவி சோர் வேங்கடம் * நீர்மலை என்று வாய்","வெருவினாள் * மெய்யம் வினவி இருக்கின்றாள் **","பெருகு சீர்க் * கண்ணபுரம் என்று பேசினாள்","உருகினாள் * உள் மெலிந்தாள் * இது என் கொலோ?"],0,"/media/recitation/PT.8.2.3.mp3"],[1661,1661,["uNNum nAL illai * uRakkamum thAn illai *","peNmaiyum sAla * niRaindhilaL pEdhai thAn **","kaNNan Ur kaNNapuram thozhum * kArkkaDal","vaNNar mEl * eNNam ivaTku idhu en kolO?"],["உண்ணும் நாள் இல்லை * உறக்கமும் தான் இல்லை *","பெண்மையும் சால * நிறைந்திலள் பேதை தான் **","கண்ணன் ஊர் கண்ணபுரம் தொழும் * கார்க்கடல்","வண்ணர் மேல் * எண்ணம் இவட்கு இது என் கொலோ?"],0,"/media/recitation/PT.8.2.4.mp3"],[1662,1662,["kaNNan Ur * kaNNapuram thozhum kArigai *","peNmaiyen * thannuDai uNmai uraikkinRAL **","veNNey uNDu AppuNDa * vaNNam viLambinAL *","vaNNamum * pon niRam Avadhu ozhiyumE"],["கண்ணன் ஊர் * கண்ணபுரம் தொழும் காரிகை *","பெண்மையென் * தன்னுடை உண்மை உரைக்கின்றாள் **","வெண்ணெய் உண்டு ஆப்புண்ட * வண்ணம் விளம்பினாள் *","வண்ணமும் * பொன் நிறம் ஆவது ஒழியுமே"],0,"/media/recitation/PT.8.2.5.mp3"],[1663,1663,["vaDavarai ninRum vandhu * inRu kaNapuram","iDavagai koLvadhu * yAm enRu pEsinAL **","maDavaral mAdhar en pEdhai * ivarkku ivaL","kaDavadhu en? * kaN thuyil inRu ivar koLLavE"],["வடவரை நின்றும் வந்து * இன்று கணபுரம்","இடவகை கொள்வது * யாம் என்று பேசினாள் **","மடவரல் மாதர் என் பேதை * இவர்க்கு இவள்","கடவது என்? * கண் துயில் இன்று இவர் கொள்ளவே"],0,"/media/recitation/PT.8.2.6.mp3"],[1664,1664,["** tharangga nIr pEsinum * thaN madhi kAyinum *","iranggumO? * eththanai nAL irundhu eLginAL? **","thuranggam vAy kINDu ugandhAnadhu * thonmai Ur *","aranggamE enbadhu * ivaL thanakku AsaiyE"],["** தரங்க நீர் பேசினும் * தண் மதி காயினும் *","இரங்குமோ? * எத்தனை நாள் இருந்து எள்கினாள்? **","துரங்கம் வாய் கீண்டு உகந்தானது * தொன்மை ஊர் *","அரங்கமே என்பது * இவள் தனக்கு ஆசையே"],0,"/media/recitation/PT.8.2.7.mp3"],[1665,1665,["thoNDellAm nin aDiyE * thozhudhu uyyumA","kaNDu * thAn kaNapuram kai thozhap pOyinAL **","vaNDulAm kOdhai en pEdhai * maNi niRam","koNDu thAn * kOyinmai seyvadhu thakkadhE?"],["தொண்டெல்லாம் நின் அடியே * தொழுது உய்யுமா","கண்டு * தான் கணபுரம் கை தொழப் போயினாள் **","வண்டுலாம் கோதை என் பேதை * மணி நிறம்","கொண்டு தான் * கோயின்மை செய்வது தக்கதே?"],0,"/media/recitation/PT.8.2.8.mp3"],[1666,1666,["muL eyiRu Eyndhila * kUzhai muDi koDA *","theLLiyaL enbadhOr * thEsilaL en seygEn? **","kaLLavizh sOlaik * kaNapuram kai thozhum","piLLaiyai * piLLai enRu eNNap peRuvarE?"],["முள் எயிறு ஏய்ந்தில * கூழை முடி கொடா *","தெள்ளியள் என்பதோர் * தேசிலள் என் செய்கேன்? **","கள்ளவிழ் சோலைக் * கணபுரம் கை தொழும்","பிள்ளையை * பிள்ளை என்று எண்ணப் பெறுவரே?"],0,"/media/recitation/PT.8.2.9.mp3"],[1667,1667,["** kAr mali * kaNNapuraththu em aDigaLai *","pAr mali manggaiyar kOn * parakAlan sol **","sIr mali pADal * ivai paththum vallavar *","nIr mali vaiyaththu * nIDu niRpArgaLE"],["** கார் மலி * கண்ணபுரத்து எம் அடிகளை *","பார் மலி மங்கையர் கோன் * பரகாலன் சொல் **","சீர் மலி பாடல் * இவை பத்தும் வல்லவர் *","நீர் மலி வையத்து * நீடு நிற்பார்களே"],0,"/media/recitation/PT.8.2.10.mp3"]],[[1668,1668,["** karai eDuththa surisanggum * kana pavaLaththu ezhukoDiyum *","thirai eDuththu varupunal sUzh * thirukkaNNapuraththu uRaiyum **","virai eDuththa thuzhAy alanggal * viRal varaith thOL puDai peyara *","varai eDuththa perumAnukku * izhandhEn en varivaLaiyE"],["** கரை எடுத்த சுரிசங்கும் * கன பவளத்து எழுகொடியும் *","திரை எடுத்து வருபுனல் சூழ் * திருக்கண்ணபுரத்து உறையும் **","விரை எடுத்த துழாய் அலங்கல் * விறல் வரைத் தோள் புடை பெயர *","வரை எடுத்த பெருமானுக்கு * இழந்தேன் என் வரிவளையே"],0,"/media/recitation/PT.8.3.1.mp3"],[1669,1669,["ari viravu mugil kaNaththAl * agil pugaiyAl varaiyODum *","therivariya maNimADath * thirukkaNNapuraththu uRaiyum **","vari aravinnaNaith thuyinRu * mazhai madhaththa siRu thaRu kaN *","kari veruva marupposiththARku * izhandhEn en kanavaLaiyE"],["அரி விரவு முகில் கணத்தால் * அகில் புகையால் வரையோடும் *","தெரிவரிய மணிமாடத் * திருக்கண்ணபுரத்து உறையும் **","வரி அரவின்னணைத் துயின்று * மழை மதத்த சிறு தறு கண் *","கரி வெருவ மருப்பொசித்தாற்கு * இழந்தேன் என் கனவளையே"],0,"/media/recitation/PT.8.3.2.mp3"],[1670,1670,["thungga mAmaNi mADa * neDu mugaTTin sUligai pOm *","thinggaL mAmugil thuNikkum * thirukkaNNapuraththu uRaiyum **","paingkaN mAl viDai aDarththup * pani madhi kOL viDuththugandha *","sengkaNmAl ammAnukku * izhandhEn en seRivaLaiyE"],["துங்க மாமணி மாட * நெடு முகட்டின் சூலிகை போம் *","திங்கள் மாமுகில் துணிக்கும் * திருக்கண்ணபுரத்து உறையும் **","பைங்கண் மால் விடை அடர்த்துப் * பனி மதி கோள் விடுத்துகந்த *","செங்கண்மால் அம்மானுக்கு * இழந்தேன் என் செறிவளையே"],0,"/media/recitation/PT.8.3.3.mp3"],[1671,1671,["kaNa maruvu mayil agavu * kaDipozhil sUzh neDu maRugil *","thiNa maruvu kanamadhiL sUzh * thirukkaNNapuraththu uRaiyum **","maNa maruvu thOL Aychchi * Arkkap pOy uralODum *","puNar marudham iRa naDandhARku * izhandhEn en ponvaLaiyE"],["கண மருவு மயில் அகவு * கடிபொழில் சூழ் நெடு மறுகில் *","திண மருவு கனமதிள் சூழ் * திருக்கண்ணபுரத்து உறையும் **","மண மருவு தோள் ஆய்ச்சி * ஆர்க்கப் போய் உரலோடும் *","புணர் மருதம் இற நடந்தாற்கு * இழந்தேன் என் பொன்வளையே"],0,"/media/recitation/PT.8.3.4.mp3"],[1672,1672,["vAy eDuththa mandhiraththAl * andhaNar tham sey thozhilgaL *","thI eDuththu maRai vaLarkkum * thirukkaNNapuraththu uRaiyum **","thAy eDuththa siRu kOlukku * uLaindhODith thayir uNDa *","vAy thuDaiththa maindhanukku * izhandhEn en varivaLaiyE"],["வாய் எடுத்த மந்திரத்தால் * அந்தணர் தம் செய் தொழில்கள் *","தீ எடுத்து மறை வளர்க்கும் * திருக்கண்ணபுரத்து உறையும் **","தாய் எடுத்த சிறு கோலுக்கு * உளைந்தோடித் தயிர் உண்ட *","வாய் துடைத்த மைந்தனுக்கு * இழந்தேன் என் வரிவளையே"],0,"/media/recitation/PT.8.3.5.mp3"],[1673,1673,["maDal eDuththa neDunthAzhai * marunggellAm vaLar pavaLam *","thiDal eDuththuch suDar imaikkum * thirukkaNNapuraththu uRaiyum **","aDal aDarththu anRu iraNiyanai * muraN azhiya aNi ugirAl *","uDal eDuththa perumAnukku * izhandhEn en oLivaLaiyE"],["மடல் எடுத்த நெடுந்தாழை * மருங்கெல்லாம் வளர் பவளம் *","திடல் எடுத்துச் சுடர் இமைக்கும் * திருக்கண்ணபுரத்து உறையும் **","அடல் அடர்த்து அன்று இரணியனை * முரண் அழிய அணி உகிரால் *","உடல் எடுத்த பெருமானுக்கு * இழந்தேன் என் ஒளிவளையே"],0,"/media/recitation/PT.8.3.6.mp3"],[1674,1674,["vaNDamarum malarp punnai * vari nIzhal aNi muththam *","theNthiraigaL varath thiraTTum * thirukkaNNapuraththu uRaiyum **","eNthisaiyum ezhusuDarum * irunilanum peruvisumbum *","uNDumizhndha perumAnukku * izhandhEn en oLivaLaiyE"],["வண்டமரும் மலர்ப் புன்னை * வரி நீழல் அணி முத்தம் *","தெண்திரைகள் வரத் திரட்டும் * திருக்கண்ணபுரத்து உறையும் **","எண்திசையும் எழுசுடரும் * இருநிலனும் பெருவிசும்பும் *","உண்டுமிழ்ந்த பெருமானுக்கு * இழந்தேன் என் ஒளிவளையே"],0,"/media/recitation/PT.8.3.7.mp3"],[1675,1675,["konggu mali karungkuvaLai * kaNNAgath theNkayanggaL *","sengkamala muga malarththum * thirukkaNNapuraththu uRaiyum **","vangga mali thaDangkaDaluL * vari aravin aNaith thuyinRa *","sengkamala nAbanukku * izhandhEn en seRivaLaiyE"],["கொங்கு மலி கருங்குவளை * கண்ணாகத் தெண்கயங்கள் *","செங்கமல முக மலர்த்தும் * திருக்கண்ணபுரத்து உறையும் **","வங்க மலி தடங்கடலுள் * வரி அரவின் அணைத் துயின்ற *","செங்கமல நாபனுக்கு * இழந்தேன் என் செறிவளையே"],0,"/media/recitation/PT.8.3.8.mp3"],[1676,1676,["vArALum iLangkonggai * neDum paNaith thOL maDap pAvai *","sIrALum varai mArban * thirukkaNNapuraththu uRaiyum **","pErALan Ayiram pEr * Ayira vAy aravaNai mEl *","pErALar perumAnukku * izhandhEn en peyvaLaiyE"],["வாராளும் இளங்கொங்கை * நெடும் பணைத் தோள் மடப் பாவை *","சீராளும் வரை மார்பன் * திருக்கண்ணபுரத்து உறையும் **","பேராளன் ஆயிரம் பேர் * ஆயிர வாய் அரவணை மேல் *","பேராளர் பெருமானுக்கு * இழந்தேன் என் பெய்வளையே"],0,"/media/recitation/PT.8.3.9.mp3"],[1677,1677,["** thE maruvu pozhil puDai sUzh * thirukkaNNapuraththu uRaiyum","vAmananai * maRikaDal sUzh * vayalAli vaLanADan **","kAmaru sIrk kalikanRi * kaNDuraiththa thamizh mAlai *","nA maruvi ivai pADa * vinaiyAya naNNAvE"],["** தே மருவு பொழில் புடை சூழ் * திருக்கண்ணபுரத்து உறையும்","வாமனனை * மறிகடல் சூழ் * வயலாலி வளநாடன் **","காமரு சீர்க் கலிகன்றி * கண்டுரைத்த தமிழ் மாலை *","நா மருவி இவை பாட * வினையாய நண்ணாவே"],0,"/media/recitation/PT.8.3.10.mp3"]],[[1678,1678,["** viNNavar thanggaL perumAn * thirumArvan *","maNNavar ellAm vaNanggum * mali pugazh sEr **","kaNNapuraththu emperumAn * kadhir muDi mEl *","vaNNa naRunthuzhAy * vandhu UdhAy kOl thumbI!"],["** விண்ணவர் தங்கள் பெருமான் * திருமார்வன் *","மண்ணவர் எல்லாம் வணங்கும் * மலி புகழ் சேர் **","கண்ணபுரத்து எம்பெருமான் * கதிர் முடி மேல் *","வண்ண நறுந்துழாய் * வந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.1.mp3"],[1679,1679,["vEdha mudhalvan * viLanggu purinUlan *","pAdham paravip * palarum paNindhEththi **","kAdhanmai seyyum * kaNNapuraththu emperumAn *","thAdhu naRunthuzhAy * thAzhndhUdhAy kOl thumbI!"],["வேத முதல்வன் * விளங்கு புரிநூலன் *","பாதம் பரவிப் * பலரும் பணிந்தேத்தி **","காதன்மை செய்யும் * கண்ணபுரத்து எம்பெருமான் *","தாது நறுந்துழாய் * தாழ்ந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.2.mp3"],[1680,1680,["viNDa malar ellAm * Udhi nI en peRudhi? *","aNDa mudhalvan * amarargaL ellArum **","kaNDu vaNanggum * kaNNapuraththu emperumAn *","vaNDu naRunthuzhAy * vandhUdhAy kOl thumbI!"],["விண்ட மலர் எல்லாம் * ஊதி நீ என் பெறுதி? *","அண்ட முதல்வன் * அமரர்கள் எல்லாரும் **","கண்டு வணங்கும் * கண்ணபுரத்து எம்பெருமான் *","வண்டு நறுந்துழாய் * வந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.3.mp3"],[1681,1681,["nIr maliginRadhOr * mInAy Or AmaiyumAy *","sIr maliginRadhOr * singga uruvAgi **","kAr mali vaNNan * kaNNapuraththu emperumAn *","thAr mali thaNthuzhAy * thAzhndhUdhAy kOl thumbI!"],["நீர் மலிகின்றதோர் * மீனாய் ஓர் ஆமையுமாய் *","சீர் மலிகின்றதோர் * சிங்க உருவாகி **","கார் மலி வண்ணன் * கண்ணபுரத்து எம்பெருமான் *","தார் மலி தண்துழாய் * தாழ்ந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.4.mp3"],[1682,1682,["ErAr malar ellAm * Udhi nI en peRudhi? *","pArAr ulagam * paravap perungkaDaluL **","kAr AmaiyAna * kaNNapuraththu emperumAn *","thArAr naRunthuzhAy * thAzhndhUdhAy kOl thumbI!"],["ஏரார் மலர் எல்லாம் * ஊதி நீ என் பெறுதி? *","பாரார் உலகம் * பரவப் பெருங்கடலுள் **","கார் ஆமையான * கண்ணபுரத்து எம்பெருமான் *","தாரார் நறுந்துழாய் * தாழ்ந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.5.mp3"],[1683,1683,["mArvil thiruvan * valan Endhu chakkaraththan *","pAraip piLandha * paraman paranjchOdhi **","kAril thigazh * kAyA vaNNan kadhir muDi mEl *","thAril naRunthuzhAy * thAzhndhUdhAy kOl thumbI!"],["மார்வில் திருவன் * வலன் ஏந்து சக்கரத்தன் *","பாரைப் பிளந்த * பரமன் பரஞ்சோதி **","காரில் திகழ் * காயா வண்ணன் கதிர் முடி மேல் *","தாரில் நறுந்துழாய் * தாழ்ந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.6.mp3"],[1684,1684,["vAmanan kaRki * madhusUdhan mAdhavan *","thAr mannu * dhAsaradhi Aya thaDamArvan **","kAman than thAdhai * kaNNapuraththu emperumAn *","thAma naRunthuzhAy * thAzhndhUdhAy kOl thumbI!"],["வாமனன் கற்கி * மதுசூதன் மாதவன் *","தார் மன்னு * தாசரதி ஆய தடமார்வன் **","காமன் தன் தாதை * கண்ணபுரத்து எம்பெருமான் *","தாம நறுந்துழாய் * தாழ்ந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.7.mp3"],[1685,1685,["nIla malargaL * neDu nIr vayal marunggil *","sAla malar ellAm * UdhAdhE ** vAL arakkar","kAlan * kaNNapuraththu emperumAn kadhir muDi mEl *","kOla naRunthuzhAy * koNDUdhAy kOl thumbI!"],["நீல மலர்கள் * நெடு நீர் வயல் மருங்கில் *","சால மலர் எல்லாம் * ஊதாதே ** வாள் அரக்கர்","காலன் * கண்ணபுரத்து எம்பெருமான் கதிர் முடி மேல் *","கோல நறுந்துழாய் * கொண்டூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.8.mp3"],[1686,1686,["nandhan madhalai * nilamanggai nalthuNaivan *","andha mudhalvan * amarargaL tham perumAn **","kandham kamazh * kAyA vaNNan kadhir muDi mEl *","kondhu naRunthuzhAy * koNDUdhAy kOl thumbI!"],["நந்தன் மதலை * நிலமங்கை நல்துணைவன் *","அந்த முதல்வன் * அமரர்கள் தம் பெருமான் **","கந்தம் கமழ் * காயா வண்ணன் கதிர் முடி மேல் *","கொந்து நறுந்துழாய் * கொண்டூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.9.mp3"],[1687,1687,["** vaNDamarum sOlai * vayal Ali nalnADan *","kaNDa sIr venRik * kaliyan oli mAlai **","koNDal niRa vaNNan * kaNNapuraththAnai *","thoNDarOm pADa * ninaindhUdhAy kOl thumbI!"],["** வண்டமரும் சோலை * வயல் ஆலி நல்நாடன் *","கண்ட சீர் வென்றிக் * கலியன் ஒலி மாலை **","கொண்டல் நிற வண்ணன் * கண்ணபுரத்தானை *","தொண்டரோம் பாட * நினைந்தூதாய் கோல் தும்பீ!"],0,"/media/recitation/PT.8.4.10.mp3"]],[[1688,1688,["** thandhai kAlil vilanggaRa * vandhu","thOnRiya thOnRal pin * thamiyEn than","sindhai pOyiRRuth * thiruvaruL","avaniDaip peRum aLavu irundhEnai **","andhi kAvalan amudhuRu","pasungkadhir * avai suDa adhanODum *","mandha mArudham vanamulai","thaDavandhu * vali seyvadhu ozhiyAdhE"],["** தந்தை காலில் விலங்கற * வந்து","தோன்றிய தோன்றல் பின் * தமியேன் தன்","சிந்தை போயிற்றுத் * திருவருள்","அவனிடைப் பெறும் அளவு இருந்தேனை **","அந்தி காவலன் அமுதுறு","பசுங்கதிர் * அவை சுட அதனோடும் *","மந்த மாருதம் வனமுலை","தடவந்து * வலி செய்வது ஒழியாதே"],0,"/media/recitation/PT.8.5.1.mp3"],[1689,1689,["mAri mAkkaDal vaLai vaNaRku iLaiyavan *","varai purai thirumArbil *","thArin Asaiyil pOyina nenjchamum *","thAzhndhadhOr thuNai kANEn **","Urum thunjchiRRu ulagamum thuyinRadhu *","oLiyavan visumbu iyanggum *","thErum pOyiRRuth thisaigaLum","maRaindhana * seyvadhu onRu aRiyEnE"],["மாரி மாக்கடல் வளை வணற்கு இளையவன் *","வரை புரை திருமார்பில் *","தாரின் ஆசையில் போயின நெஞ்சமும் *","தாழ்ந்ததோர் துணை காணேன் **","ஊரும் துஞ்சிற்று உலகமும் துயின்றது *","ஒளியவன் விசும்பு இயங்கும் *","தேரும் போயிற்றுத் திசைகளும்","மறைந்தன * செய்வது ஒன்று அறியேனே"],0,"/media/recitation/PT.8.5.2.mp3"],[1690,1690,["Ayan mAyamE anRi maRRu en","kaiyil * vaLaigaLum iRai nillA *","pEyin Aruyir uNDiDum","piLLai * nam peN uyirkku iranggumO? **","thUya mAmadhik kadhir suDath","thuNai illai * iNaimulai vEginRadhAl *","Ayan vEyinukku azhiginRadhu","uLLamum * anjchEl enbAr ilaiyE"],["ஆயன் மாயமே அன்றி மற்று என்","கையில் * வளைகளும் இறை நில்லா *","பேயின் ஆருயிர் உண்டிடும்","பிள்ளை * நம் பெண் உயிர்க்கு இரங்குமோ? **","தூய மாமதிக் கதிர் சுடத்","துணை இல்லை * இணைமுலை வேகின்றதால் *","ஆயன் வேயினுக்கு அழிகின்றது","உள்ளமும் * அஞ்சேல் என்பார் இலையே"],0,"/media/recitation/PT.8.5.3.mp3"],[1691,1691,["kayangkoL puN thalaik kaLiRundhu","venthiRal * kazhal mannar perum pOril *","mayangga veNsanggam vAy vaiththa","maindhanum * vandhilan maRikaDal nIr **","thayanggu veNthiraith thivalai nuNpani","enum * thazhal mugandhu iLamulai mEl *","iyanggu mArudham vilanggil en","Aviyai * enakkenap peRalAmE"],["கயங்கொள் புண் தலைக் களிறுந்து","வெந்திறல் * கழல் மன்னர் பெரும் போரில் *","மயங்க வெண்சங்கம் வாய் வைத்த","மைந்தனும் * வந்திலன் மறிகடல் நீர் **","தயங்கு வெண்திரைத் திவலை நுண்பனி","எனும் * தழல் முகந்து இளமுலை மேல் *","இயங்கு மாருதம் விலங்கில் என்","ஆவியை * எனக்கெனப் பெறலாமே"],0,"/media/recitation/PT.8.5.4.mp3"],[1692,1692,["Ezhu mAmaram thuLai paDach","silai vaLaiththu * ilanggaiyai malangguviththa","AzhiyAn * namakku aruLiya","aruLoDum * pagal ellai kazhiginRadhAl **","thOzhi! nAm idhaRken seydhum?","thuNai illai * suDar paDu mudhu nIril *","Azha AzhginRa Aviyai aDuvadhOr *","andhi vandhu aDaiginRadhE"],["ஏழு மாமரம் துளை படச்","சிலை வளைத்து * இலங்கையை மலங்குவித்த","ஆழியான் * நமக்கு அருளிய","அருளொடும் * பகல் எல்லை கழிகின்றதால் **","தோழி! நாம் இதற்கென் செய்தும்?","துணை இல்லை * சுடர் படு முது நீரில் *","ஆழ ஆழ்கின்ற ஆவியை அடுவதோர் *","அந்தி வந்து அடைகின்றதே"],0,"/media/recitation/PT.8.5.5.mp3"],[1693,1693,["muriyum veNthirai mudhukayam","thIppaDa * muzhanggu azhal eri ambin *","varikoL venjchilai vaLaiviththa","maindhanum * vandhilan en seygEn? **","eriyum v