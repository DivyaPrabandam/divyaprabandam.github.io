[[[3123,3123,["** oru nAyagamAy * ODa ulaguDan ANDavar *","karu nAy kavarndha kAlar * sidhaigiya pAnaiyar **","peru nADu kANa * immaiyilE pichchai thAm koLvar *","thiru nAraNan thAL * kAlam peRach sindhiththu uymminO"],["** ஒரு நாயகமாய் * ஓட உலகுடன் ஆண்டவர் *","கரு நாய் கவர்ந்த காலர் * சிதைகிய பானையர் **","பெரு நாடு காண * இம்மையிலே பிச்சை தாம் கொள்வர் *","திரு நாரணன் தாள் * காலம் பெறச் சிந்தித்து உய்ம்மினோ"],0,"/media/recitation/TVM.4.1.1.mp3"],[3124,3124,["uymmin thiRai koNarndhu * enRu ulagANDavar * immaiyE","tham insuvai maDavAraip * piRar koLLath thAm viTTu **","vem min oLi veyil * kAnagam pOyk kumai thinbargaL *","sem min muDith thirumAlai * viraindhu aDi sErminO"],["உய்ம்மின் திறை கொணர்ந்து * என்று உலகான்டவர் * இம்மையே","தம் இன்சுவை மடவாரைப் * பிறர் கொள்ளத் தாம் விட்டு **","வெம் மின் ஒளி வெயில் * கானகம் போய்க் குமை தின்பர்கள் *","செம் மின் முடித் திருமாலை * விரைந்து அடி சேர்மினோ"],0,"/media/recitation/TVM.4.1.2.mp3"],[3125,3125,["aDi sEr muDiyinar Agi * arasargaL thAm thozha *","iDi sEr murasanggaL * muRRaththu iyamba irundhavar **","poDi sEr thugaLAyp pOvargaL * Adhalil nokkena *","kaDi sEr thuzhAy muDik * kaNNan kazhalgaL ninaiminO"],["அடி சேர் முடியினர் ஆகி * அரசர்கள் தாம் தொழ *","இடி சேர் முரசங்கள் * முற்றத்து இயம்ப இருந்தவர் **","பொடி சேர் துகளாய்ப் போவர்கள் * ஆதலில் நொக்கென *","கடி சேர் துழாய் முடிக் * கண்ணன் கழல்கள் நினைமினோ"],0,"/media/recitation/TVM.4.1.3.mp3"],[3126,3126,["ninaippAn pugil kaDal ekkalil * nuNmaNalin palar *","enaiththOr uganggaLum * ivvulagu ANDu kazhindhavar **","manaippAl marunggaRa * mAydhal allAl maRRuk kaNDilam *","panaith thAL madha kaLiRu aTTavan * pAdham paNiminO"],["நினைப்பான் புகில் கடல் எக்கலில் * நுண்மணலின் பலர் *","எனைத்தோர் உகங்களும் * இவ்வுலகு ஆண்டு கழிந்தவர் **","மனைப்பால் மருங்கற * மாய்தல் அல்லால் மற்றுக் கண்டிலம் *","பனைத் தாள் மத களிறு அட்டவன் * பாதம் பணிமினோ"],0,"/media/recitation/TVM.4.1.4.mp3"],[3127,3127,["paNimin thiru aruL ennum * amsIdhap paimpUm paLLi *","aNi menkuzhalAr * inbak kalavi amudhuNDAr **","thuNi munbu nAlap * pal Ezhaiyar thAm izhippach selvar *","maNi minnu mEni * nam mAyavan pEr solli vAzhminO"],["பணிமின் திரு அருள் என்னும் * அம்சீதப் பைம்பூம் பள்ளி *","அணி மென்குழலார் * இன்பக் கலவி அமுதுன்டார் **","துணி முன்பு நாலப் * பல் ஏழையர் தாம் இழிப்பச் செல்வர் *","மணி மின்னு மேனி * நம் மாயவன் பேர் சொல்லி வாழ்மினோ"],0,"/media/recitation/TVM.4.1.5.mp3"],[3128,3128,["vAzhndhArgaL vAzhndhadhu * mA mazhai mokkuLin mAyndhu mAyndhu *","AzhndhAr enRu allAl * anRu mudhal inRu aRudhiyA **","vAzhndhArgaL vAzhndhE niRpar * enbadhu illai niRkuRil *","AzhndhAr kaDaR paLLi * aNNal aDiyavar AminO"],["வாழ்ந்தார்கள் வாழ்ந்தது * மா மழை மொக்குளின் மாய்ந்து மாய்ந்து *","ஆழ்ந்தார் என்று அல்லால் * அன்று முதல் இன்று அறுதியா **","வாழ்ந்தார்கள் வாழ்ந்தே நிற்பர் * என்பது இல்லை நிற்குறில் *","ஆழ்ந்தார் கடற் பள்ளி * அண்ணல் அடியவர் ஆமினோ"],0,"/media/recitation/TVM.4.1.6.mp3"],[3129,3129,["Am in suvai avai * ARODu aDisil uNDu Arndha pin *","thU men mozhi maDavAr irakkap * pinnum thuRRuvAr **","Imin emakkoru thuRRenRu * iDaRuvar Adhalin *","kOmin thuzhAy muDi * Adhi anjchOdhi guNanggaLE"],["ஆம் இன் சுவை அவை * ஆறோடு அடிசில் உண்டு ஆர்ந்த பின் *","தூ மென் மொழி மடவார் இரக்கப் * பின்னும் துற்றுவார் **","ஈமின் எமக்கொரு துற்றென்று * இடறுவர் ஆதலின் *","கோமின் துழாய் முடி * ஆதி அஞ்சோதி குணங்களே"],0,"/media/recitation/TVM.4.1.7.mp3"],[3130,3130,["guNangkoL niRai pugazh mannar * koDaik kaDan pUNDirundhu *","iNanggi ulaguDan Akkilum * Anggu avanai illAr **","maNangkoNDa bOgaththu manniyum * mILvargaL mILvillai *","paNangkoL aravaNaiyAn * thiru nAmam paDiminO"],["குணங்கொள் நிறை புகழ் மன்னர் * கொடைக் கடன் பூண்டிருந்து *","இணங்கி உலகுடன் ஆக்கிலும் * ஆங்கு அவனை இல்லார் **","மணங்கொண்ட போகத்து மன்னியும் * மீள்வர்கள் மீள்வில்லை *","பணங்கொள் அரவணையான் * திரு நாமம் படிமினோ"],0,"/media/recitation/TVM.4.1.8.mp3"],[3131,3131,["paDi mannu palkalan paRRODu aRuththu * aimpulan venRu *","seDi mannu kAyam seRRArgaLum * Anggu avanai illAr **","kuDi mannum insuvarkkam eydhiyum * mILvargaL mILvillai *","koDi mannu puL uDai * aNNal kazhalgaL kuRuguminO"],["படி மன்னு பல்கலன் பற்றோடு அறுத்து * ஐம்புலன் வென்று *","செடி மன்னு காயம் செற்றார்களும் * ஆங்கு அவனை இல்லார் **","குடி மன்னும் இன்சுவர்க்கம் எய்தியும் * மீள்வர்கள் மீள்வில்லை *","கொடி மன்னு புள் உடை * அண்ணல் கழல்கள் குறுகுமினோ"],0,"/media/recitation/TVM.4.1.9.mp3"],[3132,3132,["kuRuga miga uNarvaththoDu nOkki * ellAm viTTa *","iRugal iRappu ennum * njAnikkum appayan illaiyEl **","siRuga ninaivadhOr pAsam uNDAm * pinnum vIDillai *","maRugal il Isanaip paRRi * viDAviDil vIDu aqdhE"],["குறுக மிக உணர்வத்தொடு நோக்கி * எல்லாம் விட்ட *","இறுகல் இறப்பு என்னும் * ஞானிக்கும் அப்பயன் இல்லையேல் **","சிறுக நினைவதோர் பாசம் உண்டாம் * பின்னும் வீடில்லை *","மறுகல் இல் ஈசனைப் பற்றி * விடாவிடில் வீடு அஃதே"],0,"/media/recitation/TVM.4.1.10.mp3"],[3133,3133,["** aqdhE uyyap pugum ARenRu * kaNNan kazhalgaL mEl *","koy pUm pozhil sUzh * kurugUrch saDakOpan kuRREval **","sey kOlaththu Ayiram * sIrth thoDaip pADal ivai paththum *","aqgAmal kaRpavar * Azh thuyar pOy uyyaRpAlarE"],["** அஃதே உய்யப் புகும் ஆறென்று * கண்ணன் கழல்கள் மேல் *","கொய் பூம் பொழில் சூழ் * குருகூர்ச் சடகோபன் குற்றேவல் **","செய் கோலத்து ஆயிரம் * சீர்த் தொடைப் பாடல் இவை பத்தும் *","அஃகாமல் கற்பவர் * ஆழ் துயர் போய் உய்யற்பாலரே"],0,"/media/recitation/TVM.4.1.11.mp3"]],[[3134,3134,["** pAlanAy * Ezh ulaguNDu parivinRi *","Alilai * annavasam seyyum aNNalAr **","thALiNai mEl aNi * thaNNanthuzhAy enRE","mAlumAl * valvinaiyEn maDavalliyE"],["** பாலனாய் * ஏழ் உலகுண்டு பரிவின்றி *","ஆலிலை * அன்னவசம் செய்யும் அண்ணலார் **","தாளிணை மேல் அணி * தண்ணந்துழாய் என்றே","மாலுமால் * வல்வினையேன் * மடவல்லியே"],0,"/media/recitation/TVM.4.2.1.mp3"],[3135,3135,["valli sEr nuNNiDai * Aychchiyar thammoDum *","kollaimai seydhu * kuravai piNaindhavar **","nallaDi mEl aNi * nARu thuzhAy enRE","sollumAl * sUzh vinaiyATTiyEn pAvaiyE"],["வல்லி சேர் நுண்ணிடை * ஆய்ச்சியர் தம்மொடும் *","கொல்லைமை செய்து * குரவை பிணைந்தவர் **","நல்லடி மேல் அணி * நாறு துழாய் என்றே","சொல்லுமால் * சூழ் வினையாட்டியேன் பாவையே"],0,"/media/recitation/TVM.4.2.2.mp3"],[3136,3136,["pA iyal vEdha * nanmAlai pala koNDu *","dhEvargaL mA munivar * iRainjcha ninRa **","sEvaDi mEl aNi * sempon thuzhAy enRE","kUvumAl * kOL vinaiyATTiyEn kOdhaiyE"],["பா இயல் வேத * நன்மாலை பல கொண்டு *","தேவர்கள் மா முனிவர் * இறைஞ்ச நின்ற **","சேவடி மேல் அணி * செம்பொன் துழாய் என்றே","கூவுமால் * கோள் வினையாட்டியேன் கோதையே"],0,"/media/recitation/TVM.4.2.3.mp3"],[3137,3137,["kOdhila vaNpugazh * koNDu samayigaL *","pEdhanggaL sollip * pidhaRRum pirAn paran **","pAdhanggaL mEl aNi * paimpon thuzhAy enRE","OdhumAl * Uzh vinaiyEn thaDanthOLiyE"],["கோதில வண்புகழ் * கொண்டு சமயிகள் *","பேதங்கள் சொல்லிப் * பிதற்றும் பிரான் பரன் **","பாதங்கள் மேல் அணி * பைம்பொன் துழாய் என்றே","ஓதுமால் * ஊழ் வினையேன் தடந்தோளியே"],0,"/media/recitation/TVM.4.2.4.mp3"],[3138,3138,["thOLi sEr pinnai poruTTu * erudhu Ezh thazhIik *","kOLiyAr kOvalanAr * kuDak kUththanAr **","thALiNai mEl aNi * thaNNanthuzhAy enRE","nALu nAL * naiginRadhAl endhan mAdharE"],["தோளி சேர் பின்னை பொருட்டு * எருது ஏழ் தழீஇக் *","கோளியார் கோவலனார் * குடக் கூத்தனார் **","தாளிணை மேல் அணி * தண்ணந்துழாய் என்றே","நாளு நாள் * நைகின்றதால் என்தன் மாதரே"],0,"/media/recitation/TVM.4.2.5.mp3"],[3139,3139,["mAdhar mA maN maDandhai poruTTu * EnamAy *","Adhi angkAlaththu * agal iDam kINDavar **","pAdhanggaL mEl aNi * paimpon thuzhAy enRE *","OdhumAl * eydhinaL endhan maDandhaiyE"],["மாதர் மா மண் மடந்தை பொருட்டு * ஏனமாய் *","ஆதி அங்காலத்து * அகல் இடம் கீண்டவர் **","பாதங்கள் மேல் அணி * பைம்பொன் துழாய் என்றே *","ஓதுமால் * எய்தினள் என்தன் மடந்தையே"],0,"/media/recitation/TVM.4.2.6.mp3"],[3140,3140,["maDandhaiyai * vaNkamalath thiru mAdhinai *","thaDangkoL thAr mArbinil * vaiththavar thALin mEl **","vaDangkoL pUn thaNNanthuzhAy * malarkkE ivaL","maDanggumAl * vANudhalIr! en maDak kombE"],["மடந்தையை * வண்கமலத் திரு மாதினை *","தடங்கொள் தார் மார்பினில் * வைத்தவர் தாளின் மேல் **","வடங்கொள் பூன் தண்ணந்துழாய் * மலர்க்கே இவள்","மடங்குமால் * வாணுதலீர்! என் மடக் கொம்பே"],0,"/media/recitation/TVM.4.2.7.mp3"],[3141,3141,["kombu pOl sIthai poruTTu * ilanggai nagar *","ambu eri uyththavar * thALiNai mEl aNi **","vambavizh thaNNanthuzhAy * malarkkE ivaL","nambumAl * nAn idhaRku en seygEn? nanggaimIr!"],["கொம்பு போல் சீதை பொருட்டு * இலங்கை நகர் *","அம்பு எரி உய்த்தவர் * தாளிணை மேல் அணி **","வம்பவிழ் தண்ணந்துழாய் * மலர்க்கே இவள்","நம்புமால் * நான் இதற்கு என் செய்கேன்? நங்கைமீர்!"],0,"/media/recitation/TVM.4.2.8.mp3"],[3142,3142,["nanggaimIr! nIrum * Or peN peRRu nalginIr *","engnganE sollugEn? * yAn peRRa Ezhaiyai **","sanggu ennum chakkaram ennum * thuzhAy ennum *","ingnganE sollum * irAp pagal en seygEn?"],["நங்கைமீர்! நீரும் * ஓர் பெண் பெற்று நல்கினீர் *","எங்ஙனே சொல்லுகேன்? * யான் பெற்ற ஏழையை **","சங்கு என்னும் சக்கரம் என்னும் * துழாய் என்னும் *","இங்ஙனே சொல்லும் * இராப் பகல் என் செய்கேன்?"],0,"/media/recitation/TVM.4.2.9.mp3"],[3143,3143,["en seygEn? ennuDaip pEdhai * en kOmaLam *","en sollum * en vasamum allaL nanggaimIr! **","min sey pUN mArbinan * kaNNan kazhal thuzhAy *","pon sey pUN men mulaikku enRu * meliyumE"],["என் செய்கேன்? என்னுடைப் பேதை * என் கோமளம் *","என் சொல்லும் * என் வசமும் அல்லள் நங்கைமீர்! **","மின் செய் பூண் மார்பினன் * கண்ணன் கழல் துழாய் *","பொன் செய் பூண் மென் முலைக்கு என்று * மெலியுமே"],0,"/media/recitation/TVM.4.2.10.mp3"],[3144,3144,["** meliyu nOy thIrkkum * nam kaNNan kazhalgaL mEl *","mali pugazh vaN kurugUrch * saDakOpan sol **","oli pugazh Ayiraththu * ippaththum vallavar *","mali pugazh vAnavarkku Avar * naRkOvaiyE"],["** மெலியு நோய் தீர்க்கும் * நம் கண்ணன் கழல்கள் மேல் *","மலி புகழ் வண் குருகூர்ச் * சடகோபன் சொல் **","ஒலி புகழ் ஆயிரத்து * இப்பத்தும் வல்லவர் *","மலி புகழ் வானவர்க்கு ஆவர் * நற்கோவையே"],0,"/media/recitation/TVM.4.2.11.mp3"]],[[3145,3145,["** kOvai vAyAL poruTTu * ERRin","eruththam iRuththAy! * madhiL ilanggaik","kOvai vIyach silai kuniththAy! *","kula nal yAnai maruppu osiththAy! **","pUvai vIyA nIr thUvip *","pOdhAl vaNanggEnElum * nin","pUvai vIyAm mEnikkup *","pUsum sAndhu en nenjchamE"],["** கோவை வாயாள் பொருட்டு * ஏற்றின்","எருத்தம் இறுத்தாய்! * மதிள் இலங்கைக்","கோவை வீயச் சிலை குனித்தாய்! *","குல நல் யானை மருப்பு ஒசித்தாய்! **","பூவை வீயா நீர் தூவிப் *","போதால் வணங்கேனேலும் * நின்","பூவை வீயாம் மேனிக்குப் *","பூசும் சாந்து என் நெஞ்சமே"],0,"/media/recitation/TVM.4.3.1.mp3"],[3146,3146,["pUsum sAndhu en nenjchamE *","punaiyum kaNNi enadhuDaiya *","vAsagam sey mAlaiyE *","vAn paTTADaiyum aqdhE **","thEsam Ana aNi kalanum *","en kai kUppuch seygaiyE *","Isan njAlam uNDu umizhndha *","endhai Ega mUrththikkE"],["பூசும் சாந்து என் நெஞ்சமே *","புனையும் கண்ணி எனதுடைய *","வாசகம் செய் மாலையே *","வான் பட்டாடையும் அஃதே **","தேசம் ஆன அணி கலனும் *","என் கை கூப்புச் செய்கையே *","ஈசன் ஞாலம் உண்டு உமிழ்ந்த *","எந்தை ஏக மூர்த்திக்கே"],0,"/media/recitation/TVM.4.3.2.mp3"],[3147,3147,["Ega mUrththi iru mUrththi *","mUnRu mUrththi pala mUrththi","Agi * aindhu pUdhamAy *","iraNDu suDarAy aruvAgi **","nAgam ERi naDuk kaDaluL","thuyinRa * nArAyaNanE! * un","Agam muRRum agaththaDakki *","Avi allal mAyththadhE"],["ஏக மூர்த்தி இரு மூர்த்தி *","மூன்று மூர்த்தி பல மூர்த்தி","ஆகி * ஐந்து பூதமாய் *","இரண்டு சுடராய் அருவாகி **","நாகம் ஏறி நடுக் கடலுள்","துயின்ற * நாராயணனே! * உன்","ஆகம் முற்றும் அகத்தடக்கி *","ஆவி அல்லல் மாய்த்ததே"],0,"/media/recitation/TVM.4.3.3.mp3"],[3148,3148,["mAyththal eNNi vAy mulai","thandha * mAyap pEy uyir","mAyththa * Aya mAyanE! *","vAmananE! mAdhavA! **","pUth thaN mAlai koNDu * unnaip","pOdhAl vaNanggEnElum * nin","pUth thaN mAlai neDu muDikkup *","punaiyum kaNNi enadhuyirE"],["மாய்த்தல் எண்ணி வாய் முலை","தந்த * மாயப் பேய் உயிர்","மாய்த்த * ஆய மாயனே! *","வாமனனே! மாதவா! **","பூத் தண் மாலை கொண்டு * உன்னைப்","போதால் வணங்கேனேலும் * நின்","பூத் தண் மாலை நெடு முடிக்குப் *","புனையும் கண்ணி எனதுயிரே"],0,"/media/recitation/TVM.4.3.4.mp3"],[3149,3149,["kaNNi enadhuyir * kAdhal","kanagach sOdhi muDi mudhalA *","eNNil pal kalankaLum *","Elum ADaiyum aqdhE **","naNNi mUvulagum * naviRRum","kIrththiyum aqdhE *","kaNNan empirAn emmAn *","kAla chakkaraththAnukkE"],["கண்ணி எனதுயிர் * காதல்","கனகச் சோதி முடி முதலா *","எண்ணில் பல் கலன்களும் *","ஏலும் ஆடையும் அஃதே **","நண்ணி மூவுலகும் * நவிற்றும்","கீர்த்தியும் அஃதே *","கண்ணன் எம்பிரான் எம்மான் *","கால சக்கரத்தானுக்கே"],0,"/media/recitation/TVM.4.3.5.mp3"],[3150,3150,["kAla chakkaraththoDu * veNsanggam","kai EndhinAy! *","njAla muRRum uNDu umizhndha *","nArAyaNanE! enRenRu **","Olam iTTu nAn azhaiththAl *","onRum vArAy Agilum *","kOlamAm en sennikku * un","kamalam anna kurai kazhalE"],["கால சக்கரத்தொடு * வெண்சங்கம்","கை ஏந்தினாய்! *","ஞால முற்றும் உண்டு உமிழ்ந்த *","நாராயணனே! என்றென்று **","ஓலம் இட்டு நான் அழைத்தால் *","ஒன்றும் வாராய் ஆகிலும் *","கோலமாம் என் சென்னிக்கு * உன்","கமலம் அன்ன குரை கழலே"],0,"/media/recitation/TVM.4.3.6.mp3"],[3151,3151,["kurai kazhalgaL nITTi * maN","koNDa kOla vAmanA! *","kurai kazhal kai kUppuvArgaL *","kUDa ninRa mAyanE! **","virai koL pUvum nIrum koNDu *","Eththa mATTEnElum * un","urai koL sOdhith thiru uruvam *","ennadhAvi mEladhE"],["குரை கழல்கள் நீட்டி * மண்","கொண்ட கோல வாமனா! *","குரை கழல் கை கூப்புவார்கள் *","கூட நின்ற மாயனே! **","விரை கொள் பூவும் நீரும் கொண்டு *","ஏத்த மாட்டேனேலும் * உன்","உரை கொள் சோதித் திரு உருவம் *","என்னதாவி மேலதே"],0,"/media/recitation/TVM.4.3.7.mp3"],[3152,3152,["ennadhAvi mElaiyAy *","Er koL Ezh ulagamum *","thunni muRRum Agi ninRa *","sOdhi njAna mUrththiyAy **","unnadhu ennadhu Aviyum *","ennadhu unnadhu Aviyum *","inna vaNNamE ninRAy *","enRu uraikka vallEnE?"],["என்னதாவி மேலையாய் *","ஏர் கொள் ஏழ் உலகமும் *","துன்னி முற்றும் ஆகி நின்ற *","சோதி ஞான மூர்த்தியாய் **","உன்னது என்னது ஆவியும் *","என்னது உன்னது ஆவியும் *","இன்ன வண்ணமே நின்றாய் *","என்று உரைக்க வல்லேனே?"],0,"/media/recitation/TVM.4.3.8.mp3"],[3153,3153,["uraikka vallEn allEn * un","ulappil kIrththi veLLaththin *","karaik kaN enRu selvan nAn? *","kAdhal maiyal ERinEn **","puraippu ilAdha param paranE! *","poy ilAdha paranjchuDarE! *","iraiththu nalla mEn makkaL","Eththa * yAnum EththinEn"],["உரைக்க வல்லேன் அல்லேன் * உன்","உலப்பில் கீர்த்தி வெள்ளத்தின் *","கரைக் கண் என்று செல்வன் நான்? *","காதல் மையல் ஏறினேன் **","புரைப்பு இலாத பரம் பரனே! *","பொய் இலாத பரஞ்சுடரே! *","இரைத்து நல்ல மேன் மக்கள்","ஏத்த * யானும் ஏத்தினேன்"],0,"/media/recitation/TVM.4.3.9.mp3"],[3154,3154,["yAnum Eththi * Ezh ulagum","muRRum Eththi * pinnaiyum","thAnum Eththilum * thannai","Eththa Eththa enggu eydhum? **","thEnum pAlum kannalum *","amudhum Agith thiththippa *","yAnum empirAnaiyE","EththinEn * yAn uyvAnE"],["யானும் ஏத்தி * ஏழ் உலகும்","முற்றும் ஏத்தி * பின்னையும்","தானும் ஏத்திலும் * தன்னை","ஏத்த ஏத்த எங்கு எய்தும்? **","தேனும் பாலும் கன்னலும் *","அமுதும் ஆகித் தித்திப்ப *","யானும் எம்பிரானையே","ஏத்தினேன் * யான் உய்வானே"],0,"/media/recitation/TVM.4.3.10.mp3"],[3155,3155,["** uyvu upAyam maRRu inmai","thERik * kaNNan oNkazhalgaL mEl *","seyya thAmaraip pazhanath *","then nan kurugUrch saDakOpan **","poy il pADal AyiraththuL *","ivaiyum paththum vallArgaL *","vaiyam manni vIRRirundhu *","viNNum ALvar maNNUDE"],["** உய்வு உபாயம் மற்று இன்மை","தேறிக் * கண்ணன் ஒண்கழல்கள் மேல் *","செய்ய தாமரைப் பழனத் *","தென் நன் குருகூர்ச் சடகோபன் **","பொய் இல் பாடல் ஆயிரத்துள் *","இவையும் பத்தும் வல்லார்கள் *","வையம் மன்னி வீற்றிருந்து *","விண்ணும் ஆள்வர் மண்ணூடே"],0,"/media/recitation/TVM.4.3.11.mp3"]],[[3156,3156,["** maNNai irundhu thuzhAvi *","vAmanan maN idhu ennum *","viNNaith thozhudhu avan mEvu *","vaikundham enRu kai kATTum **","kaNNai uNNIr malga ninRu *","kaDal vaNNan ennum annE! * en","peNNaip peru mayal seydhARku *","en seygEn? pey vaLaiyIrE!"],["** மண்ணை இருந்து துழாவி *","வாமனன் மண் இது என்னும் *","விண்ணைத் தொழுது அவன் மேவு *","வைகுந்தம் என்று கை காட்டும் **","கண்ணை உண்ணீர் மல்க நின்று *","கடல் வண்ணன் என்னும் அன்னே! * என்","பெண்ணைப் பெரு மயல் செய்தாற்கு *","என் செய்கேன்? பெய் வளையீரே!"],0,"/media/recitation/TVM.4.4.1.mp3"],[3157,3157,["pey vaLaik kaigaLaik kUppip *","pirAn kiDakkum kaDal ennum *","seyyadhOr njAyiRRaik kATTich *","sirIdharan mUrththi Idhennum **","naiyum kaNNIr malga ninRu *","nAraNan ennum annE! * en","dheyva uruvil siRu mAn *","seyginRadhu onRu aRiyEnE"],["பெய் வளைக் கைகளைக் கூப்பிப் *","பிரான் கிடக்கும் கடல் என்னும் *","செய்யதோர் ஞாயிற்றைக் காட்டிச் *","சிரீதரன் மூர்த்தி ஈதென்னும் **","நையும் கண்ணீர் மல்க நின்று *","நாரணன் என்னும் அன்னே! * என்","தெய்வ உருவில் சிறு மான் *","செய்கின்றது ஒன்று அறியேனே"],0,"/media/recitation/TVM.4.4.2.mp3"],[3158,3158,["aRiyum senthIyaith thazhuvi *","achchudhan ennum mey vEvAL *","eRiyum thaN kARRaith thazhuvi *","ennuDaik gOvindhan ennum **","veRi koL thuzhAy malar nARum *","vinai uDaiyATTiyEn peRRa *","seRi vaLai mun kaich siRu mAn *","seyginRadhu en kaNNukku onRE"],["அறியும் செந்தீயைத் தழுவி *","அச்சுதன் என்னும் மெய் வேவாள் *","எறியும் தண் காற்றைத் தழுவி *","என்னுடைக் கோவிந்தன் என்னும் **","வெறி கொள் துழாய் மலர் நாறும் *","வினை உடையாட்டியேன் பெற்ற *","செறி வளை முன் கைச் சிறு மான் *","செய்கின்றது என் கண்ணுக்கு ஒன்றே"],0,"/media/recitation/TVM.4.4.3.mp3"],[3159,3159,["onRiya thinggaLaik kATTi *","oLi maNi vaNNanE! ennum *","ninRa kunRaththinai nOkki *","neDumAlE! vA enRu kUvum **","nanRu peyyum mazhai kANil *","nAraNan vandhAn enRu Alum *","enRu ina maiyalgaL seydhAr *","ennuDaik kOmaLaththaiyE"],["ஒன்றிய திங்களைக் காட்டி *","ஒளி மணி வண்ணனே! என்னும் *","நின்ற குன்றத்தினை நோக்கி *","நெடுமாலே! வா என்று கூவும் **","நன்று பெய்யும் மழை காணில் *","நாரணன் வந்தான் என்று ஆலும் *","என்று இன மையல்கள் செய்தார் *","என்னுடைக் கோமளத்தையே"],0,"/media/recitation/TVM.4.4.4.mp3"],[3160,3160,["kOmaLa vAn kanRaip pulgik *","gOvindhan mEyththana ennum *","pOm iLa nAgaththin pin pOy *","avan kiDakkai Idhennum **","Am aLavu onRum aRiyEn *","aru vinaiyATTiyEn peRRa *","kOmaLavalliyai mAyOn *","mAl seydhu seyginRa kUththE"],["கோமள வான் கன்றைப் புல்கிக் *","கோவிந்தன் மேய்த்தன என்னும் *","போம் இள நாகத்தின் பின் போய் *","அவன் கிடக்கை ஈதென்னும் **","ஆம் அளவு ஒன்றும் அறியேன் *","அரு வினையாட்டியேன் பெற்ற *","கோமளவல்லியை மாயோன் *","மால் செய்து செய்கின்ற கூத்தே"],0,"/media/recitation/TVM.4.4.5.mp3"],[3161,3161,["kUththar kuDam eDuththu ADil *","gOvindhanAm enA ODum *","vAyththa kuzhal Osai kETkil *","mAyavan enRu maiyAkkum **","Aychchiyar veNNeygaL kANil *","avan uNDa veNNey Idhennum *","pEychchi mulai suvaiththARku * en","peN koDi ERiya piththE!"],["கூத்தர் குடம் எடுத்து ஆடில் *","கோவிந்தனாம் எனா ஓடும் *","வாய்த்த குழல் ஓசை கேட்கில் *","மாயவன் என்று மையாக்கும் **","ஆய்ச்சியர் வெண்ணெய்கள் காணில் *","அவன் உண்ட வெண்ணெய் ஈதென்னும் *","பேய்ச்சி முலை சுவைத்தாற்கு * என்","பெண் கொடி ஏறிய பித்தே!"],0,"/media/recitation/TVM.4.4.6.mp3"],[3162,3162,["ERiya piththinODu * ellA","ulagum kaNNan paDaippu ennum *","nIRu sevvE iDak kANil *","neDumAl aDiyAr enRu ODum **","nARu thuzhAy malar kANil *","nAraNan kaNNi Idhennum *","thERiyum thERAdhum mAyOn *","thiRaththanaLE iththiruvE"],["ஏறிய பித்தினோடு * எல்லா","உலகும் கண்ணன் படைப்பு என்னும் *","நீறு செவ்வே இடக் காணில் *","நெடுமால் அடியார் என்று ஓடும் **","நாறு துழாய் மலர் காணில் *","நாரணன் கண்ணி ஈதென்னும் *","தேறியும் தேறாதும் மாயோன் *","திறத்தனளே இத்திருவே"],0,"/media/recitation/TVM.4.4.7.mp3"],[3163,3163,["thiru uDai mannaraik kANil *","thirumAlaik kaNDEnE ennum *","uru uDai vaNNanggaL kANil *","ulagaLandhAn enRu thuLLum **","karu uDaith thEvilgaL ellAm *","kaDal vaNNan kOyilE ennum *","veruvilum vIzhvilum OvAk *","kaNNan kazhalgaL virumbumE"],["திரு உடை மன்னரைக் காணில் *","திருமாலைக் கண்டேனே என்னும் *","உரு உடை வண்ணங்கள் காணில் *","உலகளந்தான் என்று துள்ளும் **","கரு உடைத் தேவில்கள் எல்லாம் *","கடல் வண்ணன் கோயிலே என்னும் *","வெருவிலும் வீழ்விலும் ஓவாக் *","கண்ணன் கழல்கள் விரும்புமே"],0,"/media/recitation/TVM.4.4.8.mp3"],[3164,3164,["virumbip pagavaraik kANil *","viyal iDam uNDAnE! ennum *","karum peru mEganggaL kANil *","kaNNan enRu ERap paRakkum **","perum pula Anirai kANil *","pirAn uLan enRu pin sellum *","arum peRal peNNinai mAyOn *","alaRRi ayarppikkinRAnE"],["விரும்பிப் பகவரைக் காணில் *","வியல் இடம் உண்டானே! என்னும் *","கரும் பெரு மேகங்கள் காணில் *","கண்ணன் என்று ஏறப் பறக்கும் **","பெரும் புல ஆநிரை காணில் *","பிரான் உளன் என்று பின் செல்லும் *","அரும் பெறல் பெண்ணினை மாயோன் *","அலற்றி அயர்ப்பிக்கின்றானே"],0,"/media/recitation/TVM.4.4.9.mp3"],[3165,3165,["ayarkkum suRRum paRRi nOkkum *","agalavE nINOkkuk koLLum *","viyarkkum mazhaik kaN thuLumba *","vevvuyirk koLLum mey sOrum **","peyarththum kaNNA! enRu pEsum *","perumAnE! vA enRu kUvum *","mayal perungkAdhal en pEdhaikku *","en seygEn? valvinaiyEnE"],["அயர்க்கும் சுற்றும் பற்றி நோக்கும் *","அகலவே நீணோக்குக் கொள்ளும் *","வியர்க்கும் மழைக் கண் துளும்ப *","வெவ்வுயிர்க் கொள்ளும் மெய் சோரும் **","பெயர்த்தும் கண்ணா! என்று பேசும் *","பெருமானே! வா என்று கூவும் *","மயல் பெருங்காதல் என் பேதைக்கு *","என் செய்கேன்? வல்வினையேனே"],0,"/media/recitation/TVM.4.4.10.mp3"],[3166,3166,["** valvinai thIrkkum kaNNanai *","vaN kurugUrch saDakOpan *","sol vinaiyAl sonna pADal *","AyiraththuL ivai paththum **","nal vinai enRu kaRpArgaL *","nalaniDai vaikundham naNNi *","thol vinai thIra ellArum *","thozhudhu ezha vIRRiruppArE"],["** வல்வினை தீர்க்கும் கண்ணனை *","வண் குருகூர்ச் சடகோபன் *","சொல் வினையால் சொன்ன பாடல் *","ஆயிரத்துள் இவை பத்தும் **","நல் வினை என்று கற்பார்கள் *","நலனிடை வைகுந்தம் நண்ணி *","தொல் வினை தீர எல்லாரும் *","தொழுது எழ வீற்றிருப்பாரே"],0,"/media/recitation/TVM.4.4.11.mp3"]],[[3167,3167,["** vIRRirundhu Ezh ulagum * thanik kOl sella vIvil sIr *","ARRal mikku ALum ammAnai * vem mA piLandhAn thannai **","pORRi enRE kaigaL Arath * thozhudhu sol mAlaigaL *","ERRa nORRERku * ini enna kuRai ezhumaiyumE?"],["** வீற்றிருந்து ஏழ் உலகும் * தனிக் கோல் செல்ல வீவில் சீர் *","ஆற்றல் மிக்கு ஆளும் அம்மானை * வெம் மா பிளந்தான் தன்னை **","போற்றி என்றே கைகள் ஆரத் * தொழுது சொல் மாலைகள் *","ஏற்ற நோற்றேற்கு * இனி என்ன குறை எழுமையுமே?"],0,"/media/recitation/TVM.4.5.1.mp3"],[3168,3168,["maiya kaNNAL malar mEl uRaivAL * uRai mArbinan *","seyya kOlath thaDangkaNNan * viNNOr perumAn thannai **","moyya sollAl isai mAlaigaL Eththi * uLLap peRREn *","veyya nOygaL muzhudhum * viyan njAlaththu vIyavE"],["மைய கண்ணாள் மலர் மேல் உறைவாள் * உறை மார்பினன் *","செய்ய கோலத் தடங்கண்ணன் * விண்ணோர் பெருமான் தன்னை **","மொய்ய சொல்லால் இசை மாலைகள் ஏத்தி * உள்ளப் பெற்றேன் *","வெய்ய நோய்கள் முழுதும் * வியன் ஞாலத்து வீயவே"],0,"/media/recitation/TVM.4.5.2.mp3"],[3169,3169,["vIvil inbam miga * ellai nigazhndha nam achchudhan *","vIvil sIran malark kaNNan * viNNOr perumAn thannai **","vIvil kAlam isai mAlaigaL Eththi * mEvap peRREn *","vIvil inbam miga * ellai nigazhndhanan mEviyE"],["வீவில் இன்பம் மிக * எல்லை நிகழ்ந்த நம் அச்சுதன் *","வீவில் சீரன் மலர்க் கண்ணன் * விண்ணோர் பெருமான் தன்னை **","வீவில் காலம் இசை மாலைகள் ஏத்தி * மேவப் பெற்றேன் *","வீவில் இன்பம் மிக * எல்லை நிகழ்ந்தனன் மேவியே"],0,"/media/recitation/TVM.4.5.3.mp3"],[3170,3170,["mEvi ninRu thozhuvAr * vinai pOga mEvum pirAn *","thUvi ampuL uDaiyAn * aDal Azhi ammAn thannai **","nA iyalAl isai mAlaigaL Eththi * naNNap peRREn *","Avi en Aviyai * yAn aRiyEn seydha ARRaiyE"],["மேவி நின்று தொழுவார் * வினை போக மேவும் பிரான் *","தூவி அம்புள் உடையான் * அடல் ஆழி அம்மான் தன்னை **","நா இயலால் இசை மாலைகள் ஏத்தி * நண்ணப் பெற்றேன் *","ஆவி என் ஆவியை * யான் அறியேன் செய்த ஆற்றையே"],0,"/media/recitation/TVM.4.5.4.mp3"],[3171,3171,["ARRa nalla vagai kATTum * ammAnai * amarar tham","ERRai * ellAp poruLum viriththAnai emmAn thannai **","mARRa mAlai punaindhu Eththi * nALum magizhveydhinEn *","kARRin munnam kaDugi * vinai nOygaL kariyavE"],["ஆற்ற நல்ல வகை காட்டும் * அம்மானை * அமரர் தம்","ஏற்றை * எல்லாப் பொருளும் விரித்தானை எம்மான் தன்னை **","மாற்ற மாலை புனைந்து ஏத்தி * நாளும் மகிழ்வெய்தினேன் *","காற்றின் முன்னம் கடுகி * வினை நோய்கள் கரியவே"],0,"/media/recitation/TVM.4.5.5.mp3"],[3172,3172,["kariya mEni misai * veLiya nIRu siRidhE iDum *","periya kOlath thaDangkaNNan * viNNOr perumAn thannai **","uriya sollAl isai mAlaigaL Eththi * uLLap peRRERku *","ariyadhu uNDO enakku? * inRu thoTTum ini enRumE"],["கரிய மேனி மிசை * வெளிய நீறு சிறிதே இடும் *","பெரிய கோலத் தடங்கண்ணன் * விண்ணோர் பெருமான் தன்னை **","உரிய சொல்லால் இசை மாலைகள் ஏத்தி * உள்ளப் பெற்றேற்கு *","அரியது உண்டோ எனக்கு? * இன்று தொட்டும் இனி என்றுமே"],0,"/media/recitation/TVM.4.5.6.mp3"],[3173,3173,["enRum onRAgi * oththArum mikkArgaLum * than thanakku","inRi ninRAnai * ellA ulagum uDaiyAn thannai **","kunRam onRAl mazhai kAththa pirAnaich * sol mAlaigaL *","nanRu sUTTum vidhi eydhinam * enna kuRai namakkE?"],["என்றும் ஒன்றாகி * ஒத்தாரும் மிக்கார்களும் * தன் தனக்கு","இன்றி நின்றானை * எல்லா உலகும் உடையான் தன்னை **","குன்றம் ஒன்றால் மழை காத்த பிரானைச் * சொல் மாலைகள் *","நன்று சூட்டும் விதி எய்தினம் * என்ன குறை நமக்கே?"],0,"/media/recitation/TVM.4.5.7.mp3"],[3174,3174,["namakkum pUvin misai nanggaikkum * inbanai * njAlaththAr","thamakkum * vAnaththavarkkum perumAnai ** thaNthAmarai","sumakkum pAdhap perumAnaich * sol mAlaigaL * sollum ARu","amaikka vallERku * ini yAvar nigar agal vAnaththE?"],["நமக்கும் பூவின் மிசை நங்கைக்கும் * இன்பனை * ஞாலத்தார்","தமக்கும் * வானத்தவர்க்கும் பெருமானை ** தண்தாமரை","சுமக்கும் பாதப் பெருமானைச் * சொல் மாலைகள் * சொல்லும் ஆறு","அமைக்க வல்லேற்கு * இனி யாவர் நிகர் அகல் வானத்தே?"],0,"/media/recitation/TVM.4.5.8.mp3"],[3175,3175,["vAnaththum vAnaththuL umbarum * maNNuLLum maNNin kIzhth","thAnaththum * eNthisaiyum * thavirAdhu ninRAn thannai **","kUnaRsanggath thaDak kaiyavanaik * kuDam ADiyai","vAnak kOnaik * kavi solla vallERku * ini mARu uNDE?"],["வானத்தும் வானத்துள் உம்பரும் * மண்ணுள்ளும் மண்ணின் கீழ்த்","தானத்தும் * எண்திசையும் * தவிராது நின்றான் தன்னை **","கூனற்சங்கத் தடக் கையவனைக் * குடம் ஆடியை","வானக் கோனைக் * கவி சொல்ல வல்லேற்கு * இனி மாறு உண்டே?"],0,"/media/recitation/TVM.4.5.9.mp3"],[3176,3176,["uNDu umizhndhum kaDandhum iDandhum * kiDandhu ninRum *","koNDa kOlaththoDu vIRRirundhum * maNangkUDiyum **","kaNDa ARRAl thanadhE * ulagena ninRAn thannai *","vaNthamizh nURka nORREn * aDiyArkku inba mAriyE"],["உண்டு உமிழ்ந்தும் கடந்தும் இடந்தும் * கிடந்து நின்றும் *","கொண்ட கோலத்தொடு வீற்றிருந்தும் * மணங்கூடியும் **","கண்ட ஆற்றால் தனதே * உலகென நின்றான் தன்னை *","வண்தமிழ் நூற்க நோற்றேன் * அடியார்க்கு இன்ப மாரியே"],0,"/media/recitation/TVM.4.5.10.mp3"],[3177,3177,["** mAri mARAdha thaNNammalai * vEngkaDaththu aNNalai *","vAri mARAdha paimpUm pozhil sUzh * kurugUr nagar **","kAri mARan saDakOpan * sol Ayiraththu ippaththAl *","vEri mARAdha pU mEl iruppAL * vinai thIrkkumE"],["** மாரி மாறாத தண்ணம்மலை * வேங்கடத்து அண்ணலை *","வாரி மாறாத பைம்பூம் பொழில் சூழ் * குருகூர் நகர் **","காரி மாறன் சடகோபன் * சொல் ஆயிரத்து இப்பத்தால் *","வேரி மாறாத பூ மேல் இருப்பாள் * வினை தீர்க்குமே"],0,"/media/recitation/TVM.4.5.11.mp3"]],[[3178,3178,["** thIrppArai yAm ini * engnganam nADudhum annaimIr! *","OrppAl ivvoNNudhal * uRRa nal nOy idhu thERinOm **","pOrp pAgu thAn seydhu * anRu aivarai velviththa * mAyap pOrth","thErp pAganArkku * ivaL sindhai thuzhAyth thisaikkinRadhE"],["** தீர்ப்பாரை யாம் இனி * எங்ஙனம் நாடுதும் அன்னைமீர்! *","ஓர்ப்பால் இவ்வொண்ணுதல் * உற்ற நல் நோய் இது தேறினோம் **","போர்ப் பாகு தான் செய்து * அன்று ஐவரை வெல்வித்த * மாயப் போர்த்","தேர்ப் பாகனார்க்கு * இவள் சிந்தை துழாய்த் திசைக்கின்றதே"],0,"/media/recitation/TVM.4.6.1.mp3"],[3179,3179,["thisaikkinRadhE ivaL nOy * idhu mikka perundheyvam *","isaippinRi nIr aNanggADum * iLandheyvam anRidhu **","thisaippinRiyE * sanggu chakkaram enRu ivaL kETka * nIr","isaikkiRRir Agil * nanRE il peRum idhu kANminE"],["திசைக்கின்றதே இவள் நோய் * இது மிக்க பெருந்தெய்வம் *","இசைப்பின்றி நீர் அணங்காடும் * இளந்தெய்வம் அன்றிது **","திசைப்பின்றியே * சங்கு சக்கரம் என்று இவள் கேட்க * நீர்","இசைக்கிற்றிர் ஆகில் * நன்றே இல் பெறும் இது காண்மினே"],0,"/media/recitation/TVM.4.6.2.mp3"],[3180,3180,["idhu kANmin annaimIr! * ikkaTTuvichchi soRkoNDu * nIr","edhuvAnum seydhu * anggOr kaLLum iRaichchiyum thUvEnmin **","madhu Ar thuzhAy muDi * mAyap pirAn kazhal vAzhththinAl *","adhuvE ivaL uRRa nOykkum * arumarundhu AgumE"],["இது காண்மின் அன்னைமீர்! * இக்கட்டுவிச்சி சொற்கொண்டு * நீர்","எதுவானும் செய்து * அங்கோர் கள்ளும் இறைச்சியும் தூவேன்மின் **","மது ஆர் துழாய் முடி * மாயப் பிரான் கழல் வாழ்த்தினால் *","அதுவே இவள் உற்ற நோய்க்கும் * அருமருந்து ஆகுமே"],0,"/media/recitation/TVM.4.6.3.mp3"],[3181,3181,["marundhAgum enRu anggOr * mAya alavai soRkoNDu * nIr","karunjchORum maRRaich senjchORum * kaLan izhaiththu en payan? **","orunggAgavE ulagEzhum * vizhunggi umizhndhiTTa *","perundhEvan pEr solla kiRkil * ivaLaip peRudhirE"],["மருந்தாகும் என்று அங்கோர் * மாய அலவை சொற்கொண்டு * நீர்","கருஞ்சோறும் மற்றைச் செஞ்சோறும் * களன் இழைத்து என் பயன்? **","ஒருங்காகவே உலகேழும் * விழுங்கி உமிழ்ந்திட்ட *","பெருந்தேவன் பேர் சொல்ல கிற்கில் * இவளைப் பெறுதிரே"],0,"/media/recitation/TVM.4.6.4.mp3"],[3182,3182,["ivaLaip peRum parisu * ivvaNanggu ADudhal anRandhO! *","kuvaLaith thaDangkaNNum * kOvaich sevvAyum payandhanaL **","kavaLak kaDAk kaLiRaTTa pirAn * thirunAmaththAl *","thavaLap poDik koNDu * nIr iTTiDumin thaNiyumE"],["இவளைப் பெறும் பரிசு * இவ்வணங்கு ஆடுதல் அன்றந்தோ! *","குவளைத் தடங்கண்ணும் * கோவைச் செவ்வாயும் பயந்தனள் **","கவளக் கடாக் களிறட்ட பிரான் * திருநாமத்தால் *","தவளப் பொடிக் கொண்டு * நீர் இட்டிடுமின் தணியுமே"],0,"/media/recitation/TVM.4.6.5.mp3"],[3183,3183,["thaNiyum pozhudhu illai * nIr aNanggu ADudhir annaimIr! *","piNiyum ozhiginRadhu illai * perugum idhu allAl **","maNiyin aNi niRa mAyan * thamar aDi nIRu koNDu *","aNiya muyalil * maRRillai kaNDIr ivvaNanggukkE"],["தணியும் பொழுது இல்லை * நீர் அணங்கு ஆடுதிர் அன்னைமீர்! *","பிணியும் ஒழிகின்றது இல்லை * பெருகும் இது அல்லால் **","மணியின் அணி நிற மாயன் * தமர் அடி நீறு கொண்டு *","அணிய முயலில் * மற்றில்லை கண்டீர் இவ்வணங்குக்கே"],0,"/media/recitation/TVM.4.6.6.mp3"],[3184,3184,["aNanggukku arumarundhu enRu * anggOr ADum kaLLum parAy *","suNanggai eRindhu * num thOL kulaikkappaDum annaimIr! **","uNanggal keDak * kazhudhai udhaDATTam kaNDu en payan? *","vaNanggIrgaL mAyap pirAn thamar * vEdham vallAraiyE"],["அணங்குக்கு அருமருந்து என்று * அங்கோர் ஆடும் கள்ளும் பராய் *","சுணங்கை எறிந்து * நும் தோள் குலைக்கப்படும் அன்னைமீர்! **","உணங்கல் கெடக் * கழுதை உதடாட்டம் கண்டு என் பயன்? *","வணங்கீர்கள் மாயப் பிரான் தமர் * வேதம் வல்லாரையே"],0,"/media/recitation/TVM.4.6.7.mp3"],[3185,3185,["vEdham vallArgaLaik koNDu * viNNOr perumAn thirup","pAdham paNindhu * ivaL nOy idhu * thIrththuk koLLAdhu pOy **","Edham paRaindhu alla seydhu * kaLLUDu kalAyth thUy *","kItha muzhavu iTTu * nIr aNanggu ADudhal kIzhmaiyE"],["வேதம் வல்லார்களைக் கொண்டு * விண்ணோர் பெருமான் திருப்","பாதம் பணிந்து * இவள் நோய் இது * தீர்த்துக் கொள்ளாது போய் **","ஏதம் பறைந்து அல்ல செய்து * கள்ளூடு கலாய்த் தூய் *","கீத முழவு இட்டு * நீர் அணங்கு ஆடுதல் கீழ்மையே"],0,"/media/recitation/TVM.4.6.8.mp3"],[3186,3186,["kIzhmaiyinAl anggOr * kIzh magan iTTa muzhavin kIzh *","nAzhmai pala solli * nIr aNanggu ADum poy kANkilEn **","Ezhmaip piRappukkum sEmam * innOykkum IdhE marundhu *","Uzhmaiyil kaNNa pirAn * kazhal vAzhththumin unniththE"],["கீழ்மையினால் அங்கோர் * கீழ் மகன் இட்ட முழவின் கீழ் *","நாழ்மை பல சொல்லி * நீர் அணங்கு ஆடும் பொய் காண்கிலேன் **","ஏழ்மைப் பிறப்புக்கும் சேமம் * இந்நோய்க்கும் ஈதே மருந்து *","ஊழ்மையில் கண்ண பிரான் * கழல் வாழ்த்துமின் உன்னித்தே"],0,"/media/recitation/TVM.4.6.9.mp3"],[3187,3187,["unniththu maRRoru dheyvam thozhAL * avanai allAl *","num ichchai solli * num thOL kulaikkappaDum annaimIr! **","mannappaDu maRai vANanai * vaNthuvarApadhi","mannanai * Eththumin Eththudhalum * thozhudhu ADumE"],["உன்னித்து மற்றொரு தெய்வம் தொழாள் * அவனை அல்லால் *","நும் இச்சை சொல்லி * நும் தோள் குலைக்கப்படும் அன்னைமீர்! **","மன்னப்படு மறை வாணனை * வண்துவராபதி","மன்னனை * ஏத்துமின் ஏத்துதலும் * தொழுது ஆடுமே"],0,"/media/recitation/TVM.4.6.10.mp3"],[3188,3188,["** thozhudhu ADi thUmaNi vaNNanukku * ATseydhu nOy thIrndha *","vazhuvAdha thol pugazh * vaNkurugUrch saDakOpan ** sol","vazhuvAdha AyiraththuL * ivai paththu veRigaLum *","thozhudhu ADip pADa vallAr * thukka sIlam ilargaLE"],["** தொழுது ஆடி தூமணி வண்ணனுக்கு * ஆட்செய்து நோய் தீர்ந்த *","வழுவாத தொல் புகழ் * வண்குருகூர்ச் சடகோபன் ** சொல்","வழுவாத ஆயிரத்துள் * இவை பத்து வெறிகளும் *","தொழுது ஆடிப் பாட வல்லார் * துக்க சீலம் இலர்களே"],0,"/media/recitation/TVM.4.6.11.mp3"]],[[3189,3189,["** sIlam illAch siRiyan Elum * sey vinaiyO peridhAl *","njAlam uNDAy! njAna mUrththI! * nArAyaNA! enRenRu **","kAlam thORum yAn irundhu * kai thalai pUsal iTTAl *","kOla mEni kANa vArAy * kUviyum koLLAyE"],["** சீலம் இல்லாச் சிறியன் ஏலும் * செய் வினையோ பெரிதால் *","ஞாலம் உண்டாய்! ஞான மூர்த்தீ! * நாராயணா! என்றென்று **","காலம் தோறும் யான் இருந்து * கை தலை பூசல் இட்டால் *","கோல மேனி காண வாராய் * கூவியும் கொள்ளாயே"],0,"/media/recitation/TVM.4.7.1.mp3"],[3190,3190,["koLLa mALA inba veLLam * kOdhila thandhiDum * en","vaLLalEyO! vaiyam koNDa * vAmanAvO! enRenRu **","naL irAvum nan pagalum * nAn irundhu Olam iTTAl *","kaLLa mAyA! unnai * en kaN kANa vandhu IyAyE"],["கொள்ள மாளா இன்ப வெள்ளம் * கோதில தந்திடும் * என்","வள்ளலேயோ! வையம் கொண்ட * வாமனாவோ! என்றென்று **","நள் இராவும் நன் பகலும் * நான் இருந்து ஓலம் இட்டால் *","கள்ள மாயா! உன்னை * என் கண் காண வந்து ஈயாயே"],0,"/media/recitation/TVM.4.7.2.mp3"],[3191,3191,["IvilAdha thI vinaigaL * eththanai seydhanan kol? *","thAvi vaiyam koNDa endhAy! * dhAmOdharA! enRenRu **","kUvik kUvi nenjchu urugik * kaN pani sOra ninRAl *","pAvi nI enRu onRu sollAy * pAviyEn kANa vandhE"],["ஈவிலாத தீ வினைகள் * எத்தனை செய்தனன் கொல்? *","தாவி வையம் கொண்ட எந்தாய்! * தாமோதரா! என்றென்று **","கூவிக் கூவி நெஞ்சு உருகிக் * கண் பனி சோர நின்றால் *","பாவி நீ என்று ஒன்று சொல்லாய் * பாவியேன் காண வந்தே"],0,"/media/recitation/TVM.4.7.3.mp3"],[3192,3192,["kANa vandhu en kaN mugappE * thAmaraik kaN piRazha *","ANi sempon mEni endhAy! * ninRaruLAy enRenRu **","nANam illAch siRu thagaiyEn * nAn inggu alaRRuvadhu en? *","pENi vAnOr kANa mATTAp * pIDuDai appanaiyE"],["காண வந்து என் கண் முகப்பே * தாமரைக் கண் பிறழ *","ஆணி செம்பொன் மேனி எந்தாய்! * நின்றருளாய் என்றென்று **","நாணம் இல்லாச் சிறு தகையேன் * நான் இங்கு அலற்றுவது என்? *","பேணி வானோர் காண மாட்டாப் * பீடுடை அப்பனையே"],0,"/media/recitation/TVM.4.7.4.mp3"],[3193,3193,["appanE! aDal AzhiyAnE! * Azh kaDalaik kaDaindha","thuppanE! * un thOLgaL nAnkum * kaNDiDak kUDungkol? enRu **","eppozhudhum kaNNa nIr koNDu * Avi thuvarndhu thuvarndhu *","ippozhudhE vandhiDAy enRu * EzhaiyEn nOkkuvanE"],["அப்பனே! அடல் ஆழியானே! * ஆழ் கடலைக் கடைந்த","துப்பனே! * உன் தோள்கள் நான்கும் * கண்டிடக் கூடுங்கொல்? என்று **","எப்பொழுதும் கண்ண நீர் கொண்டு * ஆவி துவர்ந்து துவர்ந்து *","இப்பொழுதே வந்திடாய் என்று * ஏழையேன் நோக்குவனே"],0,"/media/recitation/TVM.4.7.5.mp3"],[3194,3194,["nOkki nOkki unnaik kANbAn * yAn enadhAvi uLLE *","nAkku nILvan njAnam illai * nAL thORum ennuDaiya **","Akkai uLLum Avi uLLum * alla puRaththin uLLum *","nIkkam inRi enggum ninRAy! * ninnai aRindhu aRindhE"],["நோக்கி நோக்கி உன்னைக் காண்பான் * யான் எனதாவி உள்ளே *","நாக்கு நீள்வன் ஞானம் இல்லை * நாள் தோறும் என்னுடைய **","ஆக்கை உள்ளும் ஆவி உள்ளும் * அல்ல புறத்தின் உள்ளும் *","நீக்கம் இன்றி எங்கும் நின்றாய்! * நின்னை அறிந்து அறிந்தே"],0,"/media/recitation/TVM.4.7.6.mp3"],[3195,3195,["aRindhu aRindhu thERith thERi * yAn enadhAvi uLLE *","niRaindha njAna mUrththiyAyai * ninmalam Aga vaiththu **","piRandhum seththum ninRu iDaRum * pEdhaimai thIrndhu ozhindhEn *","naRunthuzhAyin kaNNi ammA! * nAn unnaik kaNDu koNDE"],["அறிந்து அறிந்து தேறித் தேறி * யான் எனதாவி உள்ளே *","நிறைந்த ஞான மூர்த்தியாயை * நின்மலம் ஆக வைத்து **","பிறந்தும் செத்தும் நின்று இடறும் * பேதைமை தீர்ந்து ஒழிந்தேன் *","நறுந்துழாயின் கண்ணி அம்மா! * நான் உன்னைக் கண்டு கொண்டே"],0,"/media/recitation/TVM.4.7.7.mp3"],[3196,3196,["kaNDu koNDu en kaigaL Ara * nin thiruppAdhanggaL mEl *","eN thisaiyum uLLa pUk koNDu * Eththi ugandhu ugandhu **","thoNDarOnggaL pADi ADach * sUzh kaDal njAlaththuLLE *","vaNthuzhAyin kaNNi vEndhE! * vandhiDa killAyE"],["கண்டு கொண்டு என் கைகள் ஆர * நின் திருப்பாதங்கள் மேல் *","எண் திசையும் உள்ள பூக் கொண்டு * ஏத்தி உகந்து உகந்து **","தொண்டரோங்கள் பாடி ஆடச் * சூழ் கடல் ஞாலத்துள்ளே *","வண்துழாயின் கண்ணி வேந்தே! * வந்திட கில்லாயே"],0,"/media/recitation/TVM.4.7.8.mp3"],[3197,3197,["iDa kilEn OnRu aTTa killEn * aimpulan vella killEn *","kaDavan Agik kAlam thORum * pUp paRiththu Eththa killEn **","maDa vannenjcham kAdhal kUra * valvinaiyEn ayarppAy *","thaDavukinREn engguk kANban * chakkaraththu aNNalaiyE?"],["இட கிலேன் ஓன்று அட்ட கில்லேன் * ஐம்புலன் வெல்ல கில்லேன் *","கடவன் ஆகிக் காலம் தோறும் * பூப் பறித்து ஏத்த கில்லேன் **","மட வன்னெஞ்சம் காதல் கூர * வல்வினையேன் அயர்ப்பாய் *","தடவுகின்றேன் எங்குக் காண்பன் * சக்கரத்து அண்ணலையே?"],0,"/media/recitation/TVM.4.7.9.mp3"],[3198,3198,["chakkaraththu aNNalE! enRu * thAzhndhu kaNNIr thadhumba *","pakkam nOkki ninRu alandhEn * pAviyEn kANginRilEn **","mikka njAna mUrththi Aya * vEdha viLakkinai * en","thakka njAnak kaNgaLAlE * kaNDu thazhuvuvanE"],["சக்கரத்து அண்ணலே! என்று * தாழ்ந்து கண்ணீர் ததும்ப *","பக்கம் நோக்கி நின்று அலந்தேன் * பாவியேன் காண்கின்றிலேன் **","மிக்க ஞான மூர்த்தி ஆய * வேத விளக்கினை * என்","தக்க ஞானக் கண்களாலே * கண்டு தழுவுவனே"],0,"/media/recitation/TVM.4.7.10.mp3"],[3199,3199,["** thazhuvi ninRa kAdhal thannAl * thAmaraik kaNNan thannai *","kuzhuvu mADath thenkurugUr * mARan saDakOpan ** sol","vazhuvilAdha oNthamizhgaL * AyiraththuL ippaththum *","thazhuvap pADi ADa vallAr * vaikundham ERuvarE"],["** தழுவி நின்ற காதல் தன்னால் * தாமரைக் கண்ணன் தன்னை *","குழுவு மாடத் தென்குருகூர் * மாறன் சடகோபன் ** சொல்","வழுவிலாத ஒண்தமிழ்கள் * ஆயிரத்துள் இப்பத்தும் *","தழுவப் பாடி ஆட வல்லார் * வைகுந்தம் ஏறுவரே"],0,"/media/recitation/TVM.4.7.11.mp3"]],[[3200,3200,["** ERALum iRaiyOnum *","thisaimuganum thirumagaLum *","kURALum thani uDamban *","kulangkulamA asurargaLai **","nIRAgumpaDi Aga *","nirumiththup paDai thoTTa *","mARALan kavarAdha *","maNi mAmai kuRaivilamE"],["** ஏறாளும் இறையோனும் *","திசைமுகனும் திருமகளும் *","கூறாளும் தனி உடம்பன் *","குலங்குலமா அசுரர்களை **","நீறாகும்படி ஆக *","நிருமித்துப் படை தொட்ட *","மாறாளன் கவராத *","மணி மாமை குறைவிலமே"],0,"/media/recitation/TVM.4.8.1.mp3"],[3201,3201,["maNi mAmai kuRaivillA *","malar mAdhar uRai mArban *","aNimAnath thaDa varaith thOL *","aDal Azhith thaDak kaiyan **","paNi mAnam pizhaiyAmE *","aDiyEnaip paNi koNDa *","maNi mAyan kavarAdha *","maDa nenjchAl kuRaivilamE"],["மணி மாமை குறைவில்லா *","மலர் மாதர் உறை மார்பன் *","அணிமானத் தட வரைத் தோள் *","அடல் ஆழித் தடக் கையன் **","பணி மானம் பிழையாமே *","அடியேனைப் பணி கொண்ட *","மணி மாயன் கவராத *","மட நெஞ்சால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.2.mp3"],[3202,3202,["maDa nenjchAl kuRaivillA *","magaL thAy seydha oru pEychchi *","viDa nanjcha mulai suvaiththa *","migu njAnach siRu kuzhavi **","paDa nAgaththaNaik kiDandha *","paru varaith thOL parampuruDan *","neDu mAyan kavarAdha *","niRaivinAl kuRaivilamE"],["மட நெஞ்சால் குறைவில்லா *","மகள் தாய் செய்த ஒரு பேய்ச்சி *","விட நஞ்ச முலை சுவைத்த *","மிகு ஞானச் சிறு குழவி **","பட நாகத்தணைக் கிடந்த *","பரு வரைத் தோள் பரம்புருடன் *","நெடு மாயன் கவராத *","நிறைவினால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.3.mp3"],[3203,3203,["niRaivinAl kuRaivillA *","neDum paNaith thOL maDap pinnai *","poRaiyinAl mulai aNaivAn *","poru viDai Ezh aDarththu ugandha **","kaRaiyin Ar thuvar uDukkai *","kaDaiyAvin kazhikOl kai *","saRaiyinAr kavarAdha *","thaLir niRaththAl kuRaivilamE"],["நிறைவினால் குறைவில்லா *","நெடும் பணைத் தோள் மடப் பின்னை *","பொறையினால் முலை அணைவான் *","பொரு விடை ஏழ் அடர்த்து உகந்த **","கறையின் ஆர் துவர் உடுக்கை *","கடையாவின் கழிகோல் கை *","சறையினார் கவராத *","தளிர் நிறத்தால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.4.mp3"],[3204,3204,["thaLir niRaththAl kuRaivillAth *","thanich chiRaiyil viLappuRRa *","kiLi mozhiyAL kAraNamAk *","kiLar arakkan nagar eriththa **","kaLi malarth thuzhAy alanggal *","kamazh muDiyan kaDal njAlaththu *","aLimikkAn kavarAdha *","aRivinAl kuRaivilamE"],["தளிர் நிறத்தால் குறைவில்லாத் *","தனிச் சிறையில் விளப்புற்ற *","கிளி மொழியாள் காரணமாக் *","கிளர் அரக்கன் நகர் எரித்த **","களி மலர்த் துழாய் அலங்கல் *","கமழ் முடியன் கடல் ஞாலத்து *","அளிமிக்கான் கவராத *","அறிவினால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.5.mp3"],[3205,3205,["aRivinAl kuRaivillA *","agal njAlaththavar aRiya *","neRi ellAm eDuththu uraiththa *","niRai njAnaththu oru mUrththi **","kuRiya mAN uruvAgik *","koDungkOLAl nilam koNDa *","kiRi ammAn kavarAdha *","kiLar oLiyAl kuRaivilamE"],["அறிவினால் குறைவில்லா *","அகல் ஞாலத்தவர் அறிய *","நெறி எல்லாம் எடுத்து உரைத்த *","நிறை ஞானத்து ஒரு மூர்த்தி **","குறிய மாண் உருவாகிக் *","கொடுங்கோளால் நிலம் கொண்ட *","கிறி அம்மான் கவராத *","கிளர் ஒளியால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.6.mp3"],[3206,3206,["kiLar oLiyAl kuRaivillA *","ari uruvAyk kiLarndhu ezhundhu *","kiLar oLiya iraNiyaNadhu *","agal mArbam kizhiththu ugandha **","vaLar oLiya kanal Azhi *","valampuriyan maNi nIla *","vaLar oLiyAn kavarAdha *","vari vaLaiyAl kuRaivilamE"],["கிளர் ஒளியால் குறைவில்லா *","அரி உருவாய்க் கிளர்ந்து எழுந்து *","கிளர் ஒளிய இரணியணது *","அகல் மார்பம் கிழித்து உகந்த **","வளர் ஒளிய கனல் ஆழி *","வலம்புரியன் மணி நீல *","வளர் ஒளியான் கவராத *","வரி வளையால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.7.mp3"],[3207,3207,["vari vaLaiyAl kuRaivillAp *","peru muzhakkAl aDanggArai *","eri azhalam puga Udhi *","iru nila mun thuyar thavirththa **","therivariya sivan piraman *","amarar kOn paNindhu Eththum *","viri pugazhAn kavarAdha *","mEgalaiyAl kuRaivilamE"],["வரி வளையால் குறைவில்லாப் *","பெரு முழக்கால் அடங்காரை *","எரி அழலம் புக ஊதி *","இரு நில முன் துயர் தவிர்த்த **","தெரிவரிய சிவன் பிரமன் *","அமரர் கோன் பணிந்து ஏத்தும் *","விரி புகழான் கவராத *","மேகலையால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.8.mp3"],[3208,3208,["mEgalaiyAl kuRaivillA *","melivuRRa agal algul *","pOga magaL pugazhth thandhai *","viRal vANan puyam thuNiththu **","nAga misaith thuyilvAn pOl *","ulagellAm nankoDungga *","yOgu aNaivAn kavarAdha *","uDambinAl kuRaivilamE"],["மேகலையால் குறைவில்லா *","மெலிவுற்ற அகல் அல்குல் *","போக மகள் புகழ்த் தந்தை *","விறல் வாணன் புயம் துணித்து **","நாக மிசைத் துயில்வான் போல் *","உலகெல்லாம் நன்கொடுங்க *","யோகு அணைவான் கவராத *","உடம்பினால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.9.mp3"],[3209,3209,["uDambinAl kuRaivillA *","uyir pirindha malaith thuNDam *","kiDandhana pOl thuNi palavA *","asurar kuzhAm thuNiththu ugandha **","thaDam punala saDai muDiyan *","thani oru kURu amarndhu uRaiyum *","uDambu uDaiyAn kavarAdha *","uyirinAl kuRaivilamE"],["உடம்பினால் குறைவில்லா *","உயிர் பிரிந்த மலைத் துண்டம் *","கிடந்தன போல் துணி பலவா *","அசுரர் குழாம் துணித்து உகந்த **","தடம் புனல சடை முடியன் *","தனி ஒரு கூறு அமர்ந்து உறையும் *","உடம்பு உடையான் கவராத *","உயிரினால் குறைவிலமே"],0,"/media/recitation/TVM.4.8.10.mp3"],[3210,3210,["** uyirinAl kuRaivillA *","ulagEzh thannuL oDukki *","thayir veNNey uNDAnaith *","thaDangkurugUrch saDakOpan **","seyir il sol isai mAlai *","AyiraththuL ippaththAl *","vayiram sEr piRappu aRuththu *","vaikundham naNNuvarE"],["** உயிரினால் குறைவில்லா *","உலகேழ் தன்னுள் ஒடுக்கி *","தயிர் வெண்ணெய் உண்டானைத் *","தடங்குருகூர்ச் சடகோபன் **","செயிர் இல் சொல் இசை மாலை *","ஆயிரத்துள் இப்பத்தால் *","வயிரம் சேர் பிறப்பு அறுத்து *","வைகுந்தம் நண்ணுவரே"],0,"/media/recitation/TVM.4.8.11.mp3"]],[[3211,3211,["** naNNAdhAr muRuvalippa *","nal uRRAr karaindhu Engga *","eNNArAth thuyar viLaikkum *","ivai enna ulagiyaRkai? **","kaNNALA! kaDal kaDaindhAy! *","una kazhaRkE varum parisu *","thaNNAvAdhu aDiyEnaip *","paNi kaNDAy sAm ARE"],["** நண்ணாதார் முறுவலிப்ப *","நல் உற்றார் கரைந்து ஏங்க *","எண்ணாராத் துயர் விளைக்கும் *","இவை என்ன உலகியற்கை? **","கண்ணாளா! கடல் கடைந்தாய்! *","உன கழற்கே வரும் பரிசு *","தண்ணாவாது அடியேனைப் *","பணி கண்டாய் சாம் ஆறே"],0,"/media/recitation/TVM.4.9.1.mp3"],[3212,3212,["sAm ARum keDum ARum *","thamar uRRAr thalaith thalaippeydhu *","EmARik kiDandhu alaRRum *","ivai enna ulagiyaRkai? **","Am ARu onRu aRiyEn nAn *","aravaNaiyAy! ammAnE! *","kUm ARE virai kaNDAy *","aDiyEnaik kuRikkoNDE"],["சாம் ஆறும் கெடும் ஆறும் *","தமர் உற்றார் தலைத் தலைப்பெய்து *","ஏமாறிக் கிடந்து அலற்றும் *","இவை என்ன உலகியற்கை? **","ஆம் ஆறு ஒன்று அறியேன் நான் *","அரவணையாய்! அம்மானே! *","கூம் ஆறே விரை கண்டாய் *","அடியேனைக் குறிக்கொண்டே"],0,"/media/recitation/TVM.4.9.2.mp3"],[3213,3213,["koNDATTum kulam punaivum *","thamar uRRAr vizhu nidhiyum *","vaNDAr pUngkuzhalALum *","manai ozhiya uyir mAydhal **","kaNDu ARREn ulagiyaRkai *","kaDal vaNNA! aDiyEnai *","paNDE pOl karudhAdhu *","un aDikkE kUyp paNi koLLE"],["கொண்டாட்டும் குலம் புனைவும் *","தமர் உற்றார் விழு நிதியும் *","வண்டார் பூங்குழலாளும் *","மனை ஒழிய உயிர் மாய்தல் **","கண்டு ஆற்றேன் உலகியற்கை *","கடல் வண்ணா! அடியேனை *","பண்டே போல் கருதாது *","உன் அடிக்கே கூய்ப் பணி கொள்ளே"],0,"/media/recitation/TVM.4.9.3.mp3"],[3214,3214,["koL enRu kiLarndhu ezhundha *","perunjchelvam neruppAga *","koL enRu thamam mUDum *","ivai enna ulagiyaRkai? **","vaLLalE! maNi vaNNA! *","una kazhaRkE varum parisu *","vaLLal seydhu aDiyEnai *","unadhu aruLAl vAnggAyE"],["கொள் என்று கிளர்ந்து எழுந்த *","பெருஞ்செல்வம் நெருப்பாக *","கொள் என்று தமம் மூடும் *","இவை என்ன உலகியற்கை? **","வள்ளலே! மணி வண்ணா! *","உன கழற்கே வரும் பரிசு *","வள்ளல் செய்து அடியேனை *","உனது அருளால் வாங்காயே"],0,"/media/recitation/TVM.4.9.4.mp3"],[3215,3215,["vAnggu nIr malar ulagil *","niRpanavum thirivanavum *","Anggu uyirgaL piRappu iRappup *","piNi mUppAl thagarppu uNNum **","Inggu idhan mEl vennaragam *","ivai enna ulagiyaRkai? *","vAnggu enai nI maNi vaNNA! *","aDiyEnai maRukkElE"],["வாங்கு நீர் மலர் உலகில் *","நிற்பனவும் திரிவனவும் *","ஆங்கு உயிர்கள் பிறப்பு இறப்புப் *","பிணி மூப்பால் தகர்ப்பு உண்ணும் **","ஈங்கு இதன் மேல் வெந்நரகம் *","இவை என்ன உலகியற்கை? *","வாங்கு எனை நீ மணி வண்ணா! *","அடியேனை மறுக்கேலே"],0,"/media/recitation/TVM.4.9.5.mp3"],[3216,3216,["maRukki valvalaip paDuththik *","kumaiththiTTuk konRuNbar *","aRap poruLai aRindhu OrAr *","ivai enna ulagiyaRkai? **","veRith thuLava muDiyAnE! *","vinaiyEnai unakku aDimai","aRak koNDAy! * ini","en AramudhE! * kUy aruLAyE"],["மறுக்கி வல்வலைப் படுத்திக் *","குமைத்திட்டுக் கொன்றுண்பர் *","அறப் பொருளை அறிந்து ஓரார் *","இவை என்ன உலகியற்கை? **","வெறித் துளவ முடியானே! *","வினையேனை உனக்கு அடிமை","அறக் கொண்டாய்! * இனி","என் ஆரமுதே! * கூய் அருளாயே"],0,"/media/recitation/TVM.4.9.6.mp3"],[3217,3217,["AyE! ivvulagaththu *","niRpanavum thirivanavum *","nIyE maRRoru poruLum *","inRi nI ninRamaiyAl **","nOyE mUppu piRappu iRappup *","piNiyE enRivai ozhiya *","kUyE koL aDiyEnaik *","koDu ulagam kATTElE"],["ஆயே! இவ்வுலகத்து *","நிற்பனவும் திரிவனவும் *","நீயே மற்றொரு பொருளும் *","இன்றி நீ நின்றமையால் **","நோயே மூப்பு பிறப்பு இறப்புப் *","பிணியே என்றிவை ஒழிய *","கூயே கொள் அடியேனைக் *","கொடு உலகம் காட்டேலே"],0,"/media/recitation/TVM.4.9.7.mp3"],[3218,3218,["kATTi nI karandhu umizhum *","nilam nIr thI visumbu kAl *","ITTi nI vaiththu amaiththa *","imaiyOr vAzh thani muTTai **","kOTTaiyinil kazhiththu * enai un","kozhunjchOdhi uyaraththu *","kUTTariya thiruvaDikkaL *","enjnjAnRu kUTTudhiyE?"],["காட்டி நீ கரந்து உமிழும் *","நிலம் நீர் தீ விசும்பு கால் *","ஈட்டி நீ வைத்து அமைத்த *","இமையோர் வாழ் தனி முட்டை **","கோட்டையினில் கழித்து * எனை உன்","கொழுஞ்சோதி உயரத்து *","கூட்டரிய திருவடிக்கள் *","எஞ்ஞான்று கூட்டுதியே?"],0,"/media/recitation/TVM.4.9.8.mp3"],[3219,3219,["kUTTudhi nin kurai kazhalgaL * imaiyOrum","thozhA vagai seydhu *","ATTudhi nI aravaNaiyAy! *","aDiyEnum aqdhu aRivan **","vETkai ellAm viDuththu * ennai un","thiruvaDiyE sumandhu uzhala *","kUTTariya thiruvaDikkaL *","kUTTinai nAn kaNDEnE"],["கூட்டுதி நின் குரை கழல்கள் * இமையோரும்","தொழா வகை செய்து *","ஆட்டுதி நீ அரவணையாய்! *","அடியேனும் அஃது அறிவன் **","வேட்கை எல்லாம் விடுத்து * என்னை உன்","திருவடியே சுமந்து உழல *","கூட்டரிய திருவடிக்கள் *","கூட்டினை நான் கண்டேனே"],0,"/media/recitation/TVM.4.9.9.mp3"],[3220,3220,["kaNDu kETTu uRRu mOndhu","uNDu uzhalum * aingkaruvi","kaNDa inbam * therivariya","aLavillAch chiRRinbam **","oNthoDiyAL thirumagaLum *","nIyumE nilA niRpa *","kaNDa sadhir kaNDu ozhindhEn *","aDaindhEn un thiruvaDiyE"],["கண்டு கேட்டு உற்று மோந்து","உண்டு உழலும் * ஐங்கருவி","கண்ட இன்பம் * தெரிவரிய","அளவில்லாச் சிற்றின்பம் **","ஒண்தொடியாள் திருமகளும் *","நீயுமே நிலா நிற்ப *","கண்ட சதிர் கண்டு ஒழிந்தேன் *","அடைந்தேன் உன் திருவடியே"],0,"/media/recitation/TVM.4.9.10.mp3"],[3221,3221,["** thiruvaDiyai nAraNanaik *","kEsavanaip paranjchuDarai *","thiruvaDi sErvadhu karudhich *","sezhungkurugUrch saDakOpan **","thiruvaDi mEl uraiththa thamizh *","AyiraththuL ippaththum *","thiruvaDiyE aDaivikkum *","thiruvaDi sErndhu onRuminE"],["** திருவடியை நாரணனைக் *","கேசவனைப் பரஞ்சுடரை *","திருவடி சேர்வது கருதிச் *","செழுங்குருகூர்ச் சடகோபன் **","திருவடி மேல் உரைத்த தமிழ் *","ஆயிரத்துள் இப்பத்தும் *","திருவடியே அடைவிக்கும் *","திருவடி சேர்ந்து ஒன்றுமினே"],0,"/media/recitation/TVM.4.9.11.mp3"]],[[3222,3222,["** onRum dhEvum ulagum uyirum maRRum * yAdhum illA","anRu * nAnmugan thannoDu * dhEvar ulagODu uyir paDaiththAn **","kunRam pOl maNi mADa nIDu * thirukkurugUr adhanuL *","ninRa Adhip pirAn niRka * maRRaith dheyvam nADudhirE"],["** ஒன்றும் தேவும் உலகும் உயிரும் மற்றும் * யாதும் இல்லா","அன்று * நான்முகன் தன்னொடு * தேவர் உலகோடு உயிர் படைத்தான் **","குன்றம் போல் மணி மாட நீடு * திருக்குருகூர் அதனுள் *","நின்ற ஆதிப் பிரான் நிற்க * மற்றைத் தெய்வம் நாடுதிரே"],0,"/media/recitation/TVM.4.10.1.mp3"],[3223,3223,["nADi nIr vaNanggum dheyvamum * ummaiyum mun paDaiththAn *","vIDil sIrp pugazh Adhip pirAn * avan mEvi uRai kOyil **","mADa mALigai sUzhndhu azhagAya * thirukkurugUr adhanai *","pADi ADip paravich senminkaL * pal ulagIr! parandhE"],["நாடி நீர் வணங்கும் தெய்வமும் * உம்மையும் முன் படைத்தான் *","வீடில் சீர்ப் புகழ் ஆதிப் பிரான் * அவன் மேவி உறை கோயில் **","மாட மாளிகை சூழ்ந்து அழகாய * திருக்குருகூர் அதனை *","பாடி ஆடிப் பரவிச் சென்மின்கள் * பல் உலகீர்! பரந்தே"],0,"/media/recitation/TVM.4.10.2.mp3"],[3224,3224,["parandha dheyvamum pal ulagum paDaiththu * anRu uDanE vizhunggi *","karandhu umizhndhu kaDandhu iDandhadhu kaNDum * theLiya killIr **","siranggaLAl amarar vaNanggum * thirukkurugUr adhanuL *","paran thiRam anRip pal ulagIr! * dheyvam maRRillai pEsuminE"],["பரந்த தெய்வமும் பல் உலகும் படைத்து * அன்று உடனே விழுங்கி *","கரந்து உமிழ்ந்து கடந்து இடந்தது கண்டும் * தெளிய கில்லீர் **","சிரங்களால் அமரர் வணங்கும் * திருக்குருகூர் அதனுள் *","பரன் திறம் அன்றிப் பல் உலகீர்! * தெய்வம் மற்றில்லை பேசுமினே"],0,"/media/recitation/TVM.4.10.3.mp3"],[3225,3225,["pEsa ninRa sivanukkum piraman thanakkum * piRarkkum","nAyagan avanE * kabAla nan mOkkaththuk kaNDu koNmin **","thEsa mA madhiL sUzhndhu azhagAya * thirukkurugUr adhanuL *","Isan pAl Or avam paRaidhal * en Avadhu ilinggiyarkkE?"],["பேச நின்ற சிவனுக்கும் பிரமன் தனக்கும் * பிறர்க்கும்","நாயகன் அவனே * கபால நன் மோக்கத்துக் கண்டு கொண்மின் **","தேச மா மதிள் சூழ்ந்து அழகாய * திருக்குருகூர் அதனுள் *","ஈசன் பால் ஓர் அவம் பறைதல் * என் ஆவது இலிங்கியர்க்கே?"],0,"/media/recitation/TVM.4.10.4.mp3"],[3226,3226,["** ilinggaththu iTTa purANaththIrum * samaNarum sAkkiyarum *","valindhu vAdhu seyvIrgaLum * maRRu nundheyvamum Agi ninRAn **","malindhu sennel kavari vIsum * thirukkurugUr adhanuL *","polindhu ninRa pirAn kaNDIr * onRum poy illai pORRuminE"],["** இலிங்கத்து இட்ட புராணத்தீரும் * சமணரும் சாக்கியரும் *","வலிந்து வாது செய்வீர்களும் * மற்று நுந்தெய்வமும் ஆகி நின்றான் **","மலிந்து செந்நெல் கவரி வீசும் * திருக்குருகூர் அதனுள் *","பொலிந்து நின்ற பிரான் கண்டீர் * ஒன்றும் பொய் இல்லை போற்றுமினே"],0,"/media/recitation/TVM.4.10.5.mp3"],[3227,3227,["pORRi maRROr dheyvam * pENap puRaththu iTTu * ummai innE","thERRi vaiththadhu * ellIrum vIDu peRRAl ulagillai enRE **","sERRil sennel kamalam Onggu * thirukkurugUr adhanuL *","ARRa vallavan mAyam kaNDIr * adhu aRindhu aRindhu ODuminE"],["போற்றி மற்றோர் தெய்வம் * பேணப் புறத்து இட்டு * உம்மை இன்னே","தேற்றி வைத்தது * எல்லீரும் வீடு பெற்றால் உலகில்லை என்றே **","சேற்றில் செந்நெல் கமலம் ஓங்கு * திருக்குருகூர் அதனுள் *","ஆற்ற வல்லவன் மாயம் கண்டீர் * அது அறிந்து அறிந்து ஓடுமினே"],0,"/media/recitation/TVM.4.10.6.mp3"],[3228,3228,["ODi ODip pala piRappum piRandhu * maRROr dheyvam","pADi ADip paNindhu * pal paDi kAl * vazhi ERik kaNDIr **","kUDi vAnavar Eththa ninRa * thirukkurugUr adhanuL *","ADu puTkoDi Adhi mUrththikku * aDimai puguvadhuvE"],["ஓடி ஓடிப் பல பிறப்பும் பிறந்து * மற்றோர் தெய்வம்","பாடி ஆடிப் பணிந்து * பல் படி கால் * வழி ஏறிக் கண்டீர் **","கூடி வானவர் ஏத்த நின்ற * திருக்குருகூர் அதனுள் *","ஆடு புட்கொடி ஆதி மூர்த்திக்கு * அடிமை புகுவதுவே"],0,"/media/recitation/TVM.4.10.7.mp3"],[3229,3229,["pukku aDimaiyinAl thannaik kaNDa * mArkkaNDEyan avanai *","nakka pirAnum anRu uyyak koNDadhu * nArAyaNan aruLE **","kokkalar thaDanthAzhai vElith * thirukkurugUr adhanuL *","mikka Adhip pirAn niRka * maRRaith dheyvam viLambudhirE"],["புக்கு அடிமையினால் தன்னைக் கண்ட * மார்க்கண்டேயன் அவனை *","நக்க பிரானும் அன்று உய்யக் கொண்டது * நாராயணன் அருளே **","கொக்கலர் தடந்தாழை வேலித் * திருக்குருகூர் அதனுள் *","மிக்க ஆதிப் பிரான் நிற்க * மற்றைத் தெய்வம் விளம்புதிரே"],0,"/media/recitation/TVM.4.10.8.mp3"],[3230,3230,["viLambum ARu samayamum * avai Agiya maRRum than pAl *","aLandhu kANDaRku ariyan Agiya * Adhip pirAn amarum **","vaLangkoL thaNpaNai sUzhndhu azhagAya * thirukkurugUr adhanai *","uLangkoL njAnaththu vaimmin * ummai uyyak koNDu pOguRilE"],["விளம்பும் ஆறு சமயமும் * அவை ஆகிய மற்றும் தன் பால் *","அளந்து காண்டற்கு அரியன் ஆகிய * ஆதிப் பிரான் அமரும் **","வளங்கொள் தண்பணை சூழ்ந்து அழகாய * திருக்குருகூர் அதனை *","உளங்கொள் ஞானத்து வைம்மின் * உம்மை உய்யக் கொண்டு போகுறிலே"],0,"/media/recitation/TVM.4.10.9.mp3"],[3231,3231,["uRuvadhu Avadhu eththEvum * evvulaganggaLum maRRum than pAl *","maRuvil mUrththiyODu oththu * iththanaiyum ninRa vaNNam niRkavE **","seRuvil sennel karumboDu Onggu * thirukkurugUr adhanuL *","kuRiya mAN uru Agiya * nIL kuDak kUththanukku ATcheyvadhE"],["உறுவது ஆவது எத்தேவும் * எவ்வுலகங்களும் மற்றும் தன் பால் *","மறுவில் மூர்த்தியோடு ஒத்து * இத்தனையும் நின்ற வண்ணம் நிற்கவே **","செறுவில் செந்நெல் கரும்பொடு ஓங்கு * திருக்குருகூர் அதனுள் *","குறிய மாண் உரு ஆகிய * நீள் குடக் கூத்தனுக்கு ஆட்செய்வதே"],0,"/media/recitation/TVM.4.10.10.mp3"],[3232,3232,["** ATcheydhu Azhip pirAnaich sErndhavan * vaNkurugUr nagarAn *","nATkamazh magizh mAlai mArbinan * mARan saDakOpan **","vETkaiyAl sonna pADal * AyiraththuL ippaththum vallAr *","mITchi inRi vaikundha mA nagar * maRRadhu kaiyadhuvE"],["** ஆட்செய்து ஆழிப் பிரானைச் சேர்ந்தவன் * வண்குருகூர் நகரான் *","நாட்கமழ் மகிழ் மாலை மார்பினன் * மாறன் சடகோபன் **","வேட்கையால் சொன்ன பாடல் * ஆயிரத்துள் இப்பத்தும் வல்லார் *","மீட்சி இன்றி வைகுந்த மா நகர் * மற்றது கையதுவே"],0,"/media/recitation/TVM.4.10.11.mp3"]]]