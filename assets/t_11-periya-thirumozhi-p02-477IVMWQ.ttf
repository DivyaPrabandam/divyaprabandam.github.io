[[[988,988,["kalaiyum kariyum parimāvum * tiriyum kāṉam kaṭantu poy *","cilaiyum kaṇaiyum tuṇaiyākac * cĕṉṟāṉ vĕṉṟic cĕrukkal̤attu **","malai kŏṇṭu alai nīr aṇai kaṭṭi * matil̤ nīr ilaṅkai vāl̤ arakkar","talaivaṉ * talai pattu aṟuttu ukantāṉ * cāl̤akkirāmam aṭai nĕñce-1 **"],["கலையும் கரியும் பரிமாவும் * திரியும் கானம் கடந்து போய் *","சிலையும் கணையும் துணையாகச் * சென்றான் வென்றிச் செருக்களத்து **","மலை கொண்டு அலை நீர் அணை கட்டி * மதிள் நீர் இலங்கை வாள் அரக்கர்","தலைவன் * தலை பத்து அறுத்து உகந்தான் * சாளக்கிராமம் அடை நெஞ்சே 1 **"],1,"/media/recitation/PT.1.5.1.mp3"],[989,989,["kaDam sUzh kariyum parimAvum * oli mAnthErum kAlALum *","uDan sUzhndhu ezhundha kaDi ilanggai * poDiyA vaDivAych charam thurandhAn **","iDam sUzhndhu enggum iruvisumbil * imaiyOr vaNangga maNam kamazhum *","thaDam sUzhndhu enggum azhagAya * sALakkirAmam aDai nenjchE!"],["கடம் சூழ் கரியும் பரிமாவும் * ஒலி மாந்தேரும் காலாளும் *","உடன் சூழ்ந்து எழுந்த கடி இலங்கை * பொடியா வடிவாய்ச் சரம் துரந்தான் **","இடம் சூழ்ந்து எங்கும் இருவிசும்பில் * இமையோர் வணங்க மணம் கமழும் *","தடம் சூழ்ந்து எங்கும் அழகாய * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.2.mp3"],[990,990,["ulavu thiraiyum kula varaiyum * Uzhi mudhalA eN thikkum *","nilavum suDarum iruLumAy ninRAn * venRi viRal Azhi","valavan ** vAnOr tham perumAn * maruvA arakkarkku enjnjAnRum","salavan * salam sUzhndhu azhagAya * sALakkirAmam aDai nenjchE!"],["உலவு திரையும் குல வரையும் * ஊழி முதலா எண் திக்கும் *","நிலவும் சுடரும் இருளுமாய் நின்றான் * வென்றி விறல் ஆழி","வலவன் ** வானோர் தம் பெருமான் * மருவா அரக்கர்க்கு எஞ்ஞான்றும்","சலவன் * சலம் சூழ்ந்து அழகாய * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.3.mp3"],[991,991,["UrAn kuDandhai uththaman * orukAl irukAl silai vaLaiya *","thErA arakkar thEr veLLam seRRAn * vaRRA varupunal sUzh","pErAn ** pEr Ayiram uDaiyAn * piRanggu siRai vaNDu aRaiginRa","thArAn * thArA vayal sUzhndha * sALakkirAmam aDai nenjchE!"],["ஊரான் குடந்தை உத்தமன் * ஒருகால் இருகால் சிலை வளைய *","தேரா அரக்கர் தேர் வெள்ளம் செற்றான் * வற்றா வருபுனல் சூழ்","பேரான் ** பேர் ஆயிரம் உடையான் * பிறங்கு சிறை வண்டு அறைகின்ற","தாரான் * தாரா வயல் சூழ்ந்த * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.4.mp3"],[992,992,["aDuththArththu ezhundhAL pilavAy viTTalaRa * avaL mUkku ayil vALAl","viDuththAn * viLanggu suDar Azhi * viNNOr perumAn naNNAr mun **","kaDuththArththu ezhundha perumazhaiyaik * kal onRu Endhi inanirai kAth","thaDuththAn * thaDam sUzhndhu azhagAya * sALakkirAmam aDai nenjchE!"],["அடுத்தார்த்து எழுந்தாள் பிலவாய் விட்டலற * அவள் மூக்கு அயில் வாளால்","விடுத்தான் * விளங்கு சுடர் ஆழி * விண்ணோர் பெருமான் நண்ணார் முன் **","கடுத்தார்த்து எழுந்த பெருமழையைக் * கல் ஒன்று ஏந்தி இனநிரைக் காத்","தடுத்தான் * தடம் சூழ்ந்து அழகாய * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.5.mp3"],[993,993,["thAyAy vandha pEy uyirum * thayirum izhudhum uDan uNDa","vAyAn * thUya ari uruvil kuRaLAych senRu * mAvaliyai","EyAn irappa ** mUvaDi maN inRE thA enRu * ulagEzhum","thAyAn * kAyA malar vaNNan * sALakkirAmam aDai nenjchE!"],["தாயாய் வந்த பேய் உயிரும் * தயிரும் இழுதும் உடன் உண்ட","வாயான் * தூய அரி உருவில் குறளாய்ச் சென்று * மாவலியை","ஏயான் இரப்ப ** மூவடி மண் இன்றே தா என்று * உலகேழும்","தாயான் * காயா மலர் வண்ணன் * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.6.mp3"],[994,994,["EnOr anjcha venjchamaththuL * ariyAyp pariya iraNiyanai *","UnAr agalam piLaveDuththa * oruvan thAnE irusuDarAy **","vAnAyth thIyAy mArudhamAy * malaiyAy alainIr ulaganaiththum","thAnAy * thAnum AnAn than * sALakkirAmam aDai nenjchE!"],["ஏனோர் அஞ்ச வெஞ்சமத்துள் * அரியாய்ப் பரிய இரணியனை *","ஊனார் அகலம் பிளவெடுத்த * ஒருவன் தானே இருசுடராய் **","வானாய்த் தீயாய் மாருதமாய் * மலையாய் அலைநீர் உலகனைத்தும்","தானாய் * தானும் ஆனான் தன் * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.7.mp3"],[995,995,["vendhAr enbum suDu nIRum * meyyil pUsik kaiyagaththu * Or","sandhAr thalai koNDu ulagEzhum * thiriyum periyOn thAn senRu ** en","endhAy! sAbam thIr enna * ilanggu amudhu nIr thirumArbil","thandhAn * sandhAr pozhil sUzhndha * sALakkirAmam aDai nenjchE!"],["வெந்தார் என்பும் சுடு நீறும் * மெய்யில் பூசிக் கையகத்து * ஓர்","சந்தார் தலை கொண்டு உலகேழும் * திரியும் பெரியோன் தான் சென்று ** என்","எந்தாய்! சாபம் தீர் என்ன * இலங்கு அமுது நீர் திருமார்பில்","தந்தான் * சந்தார் பொழில் சூழ்ந்த * சாளக்கிராமம் அடை நெஞ்சே!"],0,"/media/recitation/PT.1.5.8.mp3"],[996,996,["tŏṇṭu ām iṉamum imaiyorum * tuṇai nūl mārpiṉ antaṇarum *","aṇṭā ĕmakke arul̤āy ĕṉṟu * aṇaiyum koyil aruku ĕllām **","vaṇṭu ār pŏzhiliṉ pazhaṉattu * vayaliṉ ayale kayal pāya *","taṇ tāmaraikal̤ mukam alarttum * cāl̤akkirāmam aṭai nĕñce-9 **"],["தொண்டு ஆம் இனமும் இமையோரும் * துணை நூல் மார்பின் அந்தணரும் *","அண்டா எமக்கே அருளாய் என்று * அணையும் கோயில் அருகு எல்லாம் **","வண்டு ஆர் பொழிலின் பழனத்து * வயலின் அயலே கயல் பாய *","தண் தாமரைகள் முகம் அலர்த்தும் * சாளக்கிராமம் அடை நெஞ்சே 9 **"],1,"/media/recitation/PT.1.5.9.mp3"],[997,997,["** thArA Arum vayal sUzhndha * sALakkirAmaththu aDigaLai *","kArAr puRavin manggai vEndhan * kaliyan oli sey thamizh mAlai **","ArAr ulagaththu aRivuDaiyAr * amarar nalnATTu arasALa *","pEr Ayiramum OdhumingaL * anRi ivaiyE pidhaRRuminE"],["** தாரா ஆரும் வயல் சூழ்ந்த * சாளக்கிராமத்து அடிகளை *","காரார் புறவின் மங்கை வேந்தன் * கலியன் ஒலி செய் தமிழ் மாலை **","ஆரார் உலகத்து அறிவுடையார் * அமரர் நல்நாட்டு அரசாள *","பேர் ஆயிரமும் ஓதுமின்கள் * அன்றி இவையே பிதற்றுமினே"],0,"/media/recitation/PT.1.5.10.mp3"]],[[998,998,["** vANilA muRuval siRunudhal perunthOL * mAdharAr vanamulaip payanE","pENinEn * adhanaip pizhai enak karudhip * pEdhaiyEn piRavi nOy aRuppAn **","ENilEn irundhEn eNNinEn eNNi * iLaiyavar kalaviyin thiRaththai *","nANinEn vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["** வாணிலா முறுவல் சிறுநுதல் பெருந்தோள் *","மாதரார் வனமுலைப் பயனே","பேணினேன் * அதனைப் பிழை எனக் கருதிப் *","பேதையேன் பிறவி நோய் அறுப்பான் **","ஏணிலேன் இருந்தேன் எண்ணினேன் எண்ணி *","இளையவர் கலவியின் திறத்தை *","நாணினேன் வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.1.mp3"],[999,999,["silambaDi uruviR karuneDungkaNNAr * thiRaththanAy aRaththaiyE maRandhu *","pulan paDindhuNNum bOgamE perukkip * pOkkinEn pozhudhinai vALA **","alampuri thaDakkai AyanE! mAyA! * vAnavarkku arasanE! * vAnOr","nalam purindhu iRainjchum thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["சிலம்படி உருவிற் கருநெடுங்கண்ணார் *","திறத்தனாய் அறத்தையே மறந்து *","புலன் படிந்துண்ணும் போகமே பெருக்கிப் *","போக்கினேன் பொழுதினை வாளா **","அலம்புரி தடக்கை ஆயனே! மாயா! *","வானவர்க்கு அரசனே! * வானோர்","நலம் புரிந்து இறைஞ்சும் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.2.mp3"],[1000,1000,["sUdhinaip perukkik kaLavinaith thuNindhu * surikuzhal maDandhaiyar thiRaththu *","kAdhalE miguththuk kaNDavA thirindha thoNDanEn * naman thamar seyyum **","vEdhanaikku oDunggi naDungginEn * vElai veNthirai alamarak kaDaindha *","nAdhanE! vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["சூதினைப் பெருக்கிக் களவினைத் துணிந்து *","சுரிகுழல் மடந்தையர் திறத்து *","காதலே மிகுத்துக் கண்டவா திரிந்த தொண்டனேன் *","நமன் தமர் செய்யும் **","வேதனைக்கு ஒடுங்கி நடுங்கினேன் * வேலை","வெண்திரை அலமரக் கடைந்த *","நாதனே! வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.3.mp3"],[1001,1001,["vambulAm kUndhal manaiviyaith thuRandhu * piRar poruL thAram enRu ivaRRai *","nambinAr iRandhAl naman thamar paRRi * eRRi vaiththu ** eri ezhuginRa","sembinAl iyanRa pAvaiyaip * pAvI! thazhuvena mozhivadhaRku anjchi *","nambanE! vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["வம்புலாம் கூந்தல் மனைவியைத் துறந்து *","பிறர் பொருள் தாரம் என்று இவற்றை *","நம்பினார் இறந்தால் நமன் தமர் பற்றி *","எற்றி வைத்து ** எரி எழுகின்ற","செம்பினால் இயன்ற பாவையைப் * பாவீ!","தழுவென மொழிவதற்கு அஞ்சி *","நம்பனே! வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.4.mp3"],[1002,1002,["iDumbaiyAl aDarppuNDu iDuminO thuRRenRu * irandhavarkku illaiyE enRu *","neDunjcholAl maRuththa nIsanEn andhO! * ninaikkilEn vinaip payan thannai **","kaDunjcholAr kaDiyAr kAlanAr thamarAl * paDuvadhOr koDumiRaikku anjchi *","naDunggi nAn vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["இடும்பையால் அடர்ப்புண்டு இடுமினோ துற்றென்று *","இரந்தவர்க்கு இல்லையே என்று *","நெடுஞ்சொலால் மறுத்த நீசனேன் அந்தோ! *","நினைக்கிலேன் வினைப் பயன் தன்னை **","கடுஞ்சொலார் கடியார் காலனார் தமரால் *","படுவதோர் கொடுமிறைக்கு அஞ்சி *","நடுங்கி நான் வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.5.mp3"],[1003,1003,["kODiya manaththAl sinaththozhil purindhu * thirindhu nAy inaththoDum thiLaiththiTTu *","ODiyum uzhanRum uyirgaLE konREn * uNarvilEn AdhalAl ** namanAr","pADiyaip peridhum parisu azhiththiTTEn * paramanE! pARkaDal kiDandhAy! *","nADi nAn vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["கோடிய மனத்தால் சினத்தொழில் புரிந்து *","திரிந்து நாய் இனத்தொடும் திளைத்திட்டு *","ஓடியும் உழன்றும் உயிர்களே கொன்றேன் *","உணர்விலேன் ஆதலால் ** நமனார்","பாடியைப் பெரிதும் பரிசு அழித்திட்டேன் *","பரமனே! பாற்கடல் கிடந்தாய்! *","நாடி நான் வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.6.mp3"],[1004,1004,["nenjchinAl ninaindhum vAyinAl mozhindhum * nIdhi allAdhana seydhum *","thunjchinAr sellum tholneRi kETTE * thuLangginEn viLangkani munindhAy! **","vanjchanEn aDiyEn nenjchinil piriyA * vAnavA! dhAnavarkku enRum","nanjchanE! * vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["நெஞ்சினால் நினைந்தும் வாயினால் மொழிந்தும் *","நீதி அல்லாதன செய்தும் *","துஞ்சினார் செல்லும் தொல்நெறி கேட்டே *","துளங்கினேன் விளங்கனி முனிந்தாய்! **","வஞ்சனேன் அடியேன் நெஞ்சினில் பிரியா *","வானவா! தானவர்க்கு என்றும்","நஞ்சனே! * வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.7.mp3"],[1005,1005,["EvinAr kaliyAr naliga enRu * en mEl engnganE vAzhumARu? * aivar","kOvinAr seyyum koDumaiyai maDiththEn * kuRungkuDi neDungkaDal vaNNA! **","pAvinAr insol panmalar koNDu * un pAdhamE paravi nAn paNindhu * en","nAvinAl vandhun thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["ஏவினார் கலியார் நலிக என்று * என் மேல்","எங்ஙனே வாழுமாறு? * ஐவர்","கோவினார் செய்யும் கொடுமையை மடித்தேன் *","குறுங்குடி நெடுங்கடல் வண்ணா! **","பாவினார் இன்சொல் பன்மலர் கொண்டு * உன்","பாதமே பரவி நான் பணிந்து * என்","நாவினால் வந்துன் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.8.mp3"],[1006,1006,["UniDaich chuvar vaiththu enbu thUN nATTi * urOmam vEyndhu onbadhu vAsal *","thAnuDaik kurambai piriyum pOdhu * undhan charaNamE saraNam enRu irundhEn **","thEnuDaik kamalath thiruvinukku arasE! * thirai koL mA neDunggaDal kiDandhAy! *","nAnuDaith thavaththAl thiruvaDi aDaindhEn * naimisAraNiyaththuL endhAy!"],["ஊனிடைச் சுவர் வைத்து என்பு தூண் நாட்டி *","உரோமம் வேய்ந்து ஒன்பது வாசல் *","தானுடைக் குரம்பை பிரியும் போது * உன்தன்","சரணமே சரணம் என்று இருந்தேன் **","தேனுடைக் கமலத் திருவினுக்கு அரசே! * திரை","கொள் மா நெடுங்கடல் கிடந்தாய்! *","நானுடைத் தவத்தால் திருவடி அடைந்தேன் *","நைமிசாரணியத்துள் எந்தாய்!"],0,"/media/recitation/PT.1.6.9.mp3"],[1007,1007,["** Edham vandhu aNugA vaNNam nAm eNNi * ezhuminO thozhudhum enRu * imaiyOr","nAdhan vandhu iRainjchum * naimisAraNiyaththu endhaiyaich sindhaiyuL vaiththu **","kAdhalE miguththa kaliyan vAyoli sey * mAlai thAn kaRRu vallArgaL *","OdhanIr vaiyagam ANDu veNkuDaik kIzh * umbarum Aguvar thAmE"],["** ஏதம் வந்து அணுகா வண்ணம் நாம் எண்ணி *","எழுமினோ தொழுதும் என்று * இமையோர்","நாதன் வந்து இறைஞ்சும் * நைமிசாரணியத்து","எந்தையைச் சிந்தையுள் வைத்து **","காதலே மிகுத்த கலியன் வாயொலி செய் *","மாலை தான் கற்று வல்லார்கள் *","ஓதநீர் வையகம் ஆண்டு வெண்குடைக் கீழ் *","உம்பரும் ஆகுவர் தாமே"],0,"/media/recitation/PT.1.6.10.mp3"]]]