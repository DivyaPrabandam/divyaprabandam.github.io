[[[1848,1848,["** oru nal suRRam * enakku uyir oNporuL *","varu nal thol kadhi * Agiya maindhanai **","nerunal kaNDadhu * nIrmalai inRu pOy *","karu nel sUzh * kaNNamanggaiyuL kANDumE"],["** ஒரு நல் சுற்றம் * எனக்கு உயிர் ஒண்பொருள் *","வரு நல் தொல் கதி * ஆகிய மைந்தனை **","நெருநல் கண்டது * நீர்மலை இன்று போய் *","கரு நெல் சூழ் * கண்ணமங்கையுள் காண்டுமே"],0,"/media/recitation/PT.10.1.1.mp3"],[1849,1849,["** ponnai mAmaNiyai * aNi ArndhadhOr","minnai * vEnggaDaththu uchchiyil * kaNDu pOy **","ennai ALuDai Isanai * empirAn","thannai * yAm senRu kANDum * thaNkAvilE"],["** பொன்னை மாமணியை * அணி ஆர்ந்ததோர்","மின்னை * வேங்கடத்து உச்சியில் * கண்டு போய் **","என்னை ஆளுடை ஈசனை * எம்பிரான்","தன்னை * யாம் சென்று காண்டும் * தண்காவிலே"],0,"/media/recitation/PT.10.1.2.mp3"],[1850,1850,["vElai Alilaip * paLLi virumbiya *","pAlai Ar amudhaththinaip * painthuzhAy **","mAlai Aliyil * kaNDu magizhndhu pOy *","njAlam unniyaik kANDum * nAnggUrilE"],["வேலை ஆலிலைப் * பள்ளி விரும்பிய *","பாலை ஆர் அமுதத்தினைப் * பைந்துழாய் **","மாலை ஆலியில் * கண்டு மகிழ்ந்து போய் *","ஞாலம் உன்னியைக் காண்டும் * நாங்கூரிலே"],0,"/media/recitation/PT.10.1.3.mp3"],[1851,1851,["thuLakkamil suDarai * avuNan uDal","piLakkum maindhanaip * pEril vaNanggip pOy **","aLappil Aramudhai * amararkku aruL","viLakkinai * senRu veLLaRaik kANDumE"],["துளக்கமில் சுடரை * அவுணன் உடல்","பிளக்கும் மைந்தனைப் * பேரில் வணங்கிப் போய் **","அளப்பில் ஆரமுதை * அமரர்க்கு அருள்","விளக்கினை * சென்று வெள்ளறைக் காண்டுமே"],0,"/media/recitation/PT.10.1.4.mp3"],[1852,1852,["cuṭalaiyil * cuṭu nīṟaṉ amarntatu or *","naṭalai tīrttavaṉai * naṟaiyūrk kaṇṭu ** ĕṉ","uṭalaiyul̤ pukuntu * ul̤l̤am urukki uṇ *","viṭalaiyaic cĕṉṟu kāṇṭum- * mĕyyattul̤l̤e-"],["சுடலையில் * சுடு நீறன் அமர்ந்தது ஓர் *","நடலை தீர்த்தவனை * நறையூர்க் கண்டு ** என்","உடலையுள் புகுந்து * உள்ளம் உருக்கி உண் *","விடலையைச் சென்று காண்டும் * மெய்யத்துள்ளே"],1,"/media/recitation/PT.10.1.5.mp3"],[1853,1853,["vAnai Aramudham * thandha vaLLalai *","thEnai nIL vayal * sERaiyil kaNDu pOy **","Anai vATTi aruLum * amarar tham","kOnai * yAm kuDandhaich senRu kANDumE"],["வானை ஆரமுதம் * தந்த வள்ளலை *","தேனை நீள் வயல் * சேறையில் கண்டு போய் **","ஆனை வாட்டி அருளும் * அமரர் தம்","கோனை * யாம் குடந்தைச் சென்று காண்டுமே"],0,"/media/recitation/PT.10.1.6.mp3"],[1854,1854,["kUndhalAr magizh kOvalanAy * veNNey","mAndha azhundhaiyil * kaNDu magizhndhu pOy **","pAndhaL pAzhiyil * paLLi virumbiya *","vEndhanaich senRu kANDum * veqkAvuLE"],["கூந்தலார் மகிழ் கோவலனாய் * வெண்ணெய்","மாந்த அழுந்தையில் * கண்டு மகிழ்ந்து போய் **","பாந்தள் பாழியில் * பள்ளி விரும்பிய *","வேந்தனைச் சென்று காண்டும் * வெஃகாவுளே"],0,"/media/recitation/PT.10.1.7.mp3"],[1855,1855,["** paththar Aviyaip * pAl madhiyai * aNith","thoththai * mAlirunjchOlaith thozhudhu pOy **","muththinai maNiyai * maNimANikka","viththinai * senRu viNNagark kANDumE"],["** பத்தர் ஆவியைப் * பால் மதியை * அணித்","தொத்தை * மாலிருஞ்சோலைத் தொழுது போய் **","முத்தினை மணியை * மணிமாணிக்க","வித்தினை * சென்று விண்ணகர்க் காண்டுமே"],0,"/media/recitation/PT.10.1.8.mp3"],[1856,1856,["kampa mā kal̤iṟu * añcik kalaṅka * or","kŏmpu kŏṇṭa * kurai kazhal kūttaṉai **","kŏmpu ulām pŏzhil * koṭṭiyūrk kaṇṭu poy *","nampaṉaic cĕṉṟu kāṇṭum-nāvāyul̤e-"],["கம்ப மா களிறு * அஞ்சிக் கலங்க * ஓர்","கொம்பு கொண்ட * குரை கழல் கூத்தனை **","கொம்பு உலாம் பொழில் * கோட்டியூர்க் கண்டு போய் *","நம்பனைச் சென்று காண்டும் நாவாயுளே"],1,"/media/recitation/PT.10.1.9.mp3"],[1857,1857,["** peRRam ALiyaip * pEril maNALanai *","kaRRa nUl * kalikanRi urai seydha **","sol thiRam ivai * solliya thoNDargaTku *","aRRam illai * aNDam avarkku ATchiyE"],["** பெற்றம் ஆளியைப் * பேரில் மணாளனை *","கற்ற நூல் * கலிகன்றி உரை செய்த **","சொல் திறம் இவை * சொல்லிய தொண்டர்கட்கு *","அற்றம் இல்லை * அண்டம் அவர்க்கு ஆட்சியே"],0,"/media/recitation/PT.10.1.10.mp3"]],[[1858,1858,["** irakkam inRi engkOn seydha thImai *","immaiyE emakku eydhiRRuk kANIr *","parakka yAm inRu uraiththen? irAvaNan","paTTanan * ini yAvarkku uraikkOm? **","kurakku nAyagargAL! iLanggOvE! *","kOla valvil irAmapirAnE! *","arakkar ADazhaippAr illai * nAnggaL","anjchinOm thaDam ponggaththam ponggO"],["** இரக்கம் இன்றி எங்கோன் செய்த தீமை *","இம்மையே எமக்கு எய்திற்றுக் காணீர் *","பரக்க யாம் இன்று உரைத்தென்? இராவணன்","பட்டனன் * இனி யாவர்க்கு உரைக்கோம்? **","குரக்கு நாயகர்காள்! இளங்கோவே! *","கோல வல்வில் இராமபிரானே! *","அரக்கர் ஆடழைப்பார் இல்லை * நாங்கள்","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.1.mp3"],[1859,1859,["paththu nILmuDiyum avaRRu iraTTip *","pAzhith thOLum paDaiththavan selvam *","siththam manggaiyar pAl vaiththuk keTTAn *","seyvadhu onRu aRiyA aDiyOnggaL **","oththa thOL iraNDum oru muDiyum *","oruvar tham thiRaththOm anRi vAzhndhOm *","aththa! emperumAn! emmaik kollEl *","anjchinOm thaDam ponggaththam ponggO"],["பத்து நீள்முடியும் அவற்று இரட்டிப் *","பாழித் தோளும் படைத்தவன் செல்வம் *","சித்தம் மங்கையர் பால் வைத்துக் கெட்டான் *","செய்வது ஒன்று அறியா அடியோங்கள் **","ஒத்த தோள் இரண்டும் ஒரு முடியும் *","ஒருவர் தம் திறத்தோம் அன்றி வாழ்ந்தோம் *","அத்த! எம்பெருமான்! எம்மைக் கொல்லேல் *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.2.mp3"],[1860,1860,["thaNDakAraNiyam pugundhu * anRu","thaiyalaith thagavili engkOmAn *","koNDu pOndhu keTTAn emakku inggOr","kuRRam illai * kollEl kula vEndhE! **","peNDirAl keDum ikkuDi thannaip *","pEsuginRadhu en? dhAsarathI! * un","aNDa vANar ugappadhE seydhAy *","anjchinOm thaDam ponggaththam ponggO"],["தண்டகாரணியம் புகுந்து * அன்று","தையலைத் தகவிலி எங்கோமான் *","கொண்டு போந்து கெட்டான் எமக்கு இங்கோர்","குற்றம் இல்லை * கொல்லேல் குல வேந்தே! **","பெண்டிரால் கெடும் இக்குடி தன்னைப் *","பேசுகின்றது என்? தாசரதீ! * உன்","அண்ட வாணர் உகப்பதே செய்தாய் *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.3.mp3"],[1861,1861,["enjchalil ilanggaikku iRai engkOn","thannai * mun paNindhu enggaL kaNmugappE *","nanjchu thAn arakkar kuDikku enRu *","nanggaiyai avan thambiyE sonnAn **","vinjchai vAnavar vENDiRRE paTTOm *","vEri vAr pozhil mAmayil anna *","anjchal Odhiyaik koNDu naDamin *","anjchinOm thaDam ponggaththam ponggO"],["எஞ்சலில் இலங்கைக்கு இறை எங்கோன்","தன்னை * முன் பணிந்து எங்கள் கண்முகப்பே *","நஞ்சு தான் அரக்கர் குடிக்கு என்று *","நங்கையை அவன் தம்பியே சொன்னான் **","விஞ்சை வானவர் வேண்டிற்றே பட்டோம் *","வேரி வார் பொழில் மாமயில் அன்ன *","அஞ்சல் ஓதியைக் கொண்டு நடமின் *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.4.mp3"],[1862,1862,["sempon nILmuDi enggaL irAvaNan *","sIthai enbadhOr dheyvam koNarndhu *","vambulAm kaDi kAvil siRaiyA","vaiththadhE * kuRRam AyiRRuk kANIr **","kumbanODu nikumbanum paTTAn *","kURRam mAniDamAy vandhu thOnRi *","ambinAl emmaik konRiDuginRadhu *","anjchinOm thaDam ponggaththam ponggO"],["செம்பொன் நீள்முடி எங்கள் இராவணன் *","சீதை என்பதோர் தெய்வம் கொணர்ந்து *","வம்புலாம் கடி காவில் சிறையா","வைத்ததே * குற்றம் ஆயிற்றுக் காணீர் **","கும்பனோடு நிகும்பனும் பட்டான் *","கூற்றம் மானிடமாய் வந்து தோன்றி *","அம்பினால் எம்மைக் கொன்றிடுகின்றது *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.5.mp3"],[1863,1863,["Odha mAkaDalaik kaDandhERi *","uyar koL mAkkaDi kAvai iRuththu *","kAdhal makkaLum suRRamum konRu *","kaDi ilanggai malangga eriththu **","thUdhu vandha kuranggukkE * unggaL","thOnRal dhEviyai viTTuk koDAdhE *","Adhar ninRu paDuginRadhu andhO! *","anjchinOm thaDam ponggaththam ponggO"],["ஓத மாகடலைக் கடந்தேறி *","உயர் கொள் மாக்கடி காவை இறுத்து *","காதல் மக்களும் சுற்றமும் கொன்று *","கடி இலங்கை மலங்க எரித்து **","தூது வந்த குரங்குக்கே * உங்கள்","தோன்றல் தேவியை விட்டுக் கொடாதே *","ஆதர் நின்று படுகின்றது அந்தோ! *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.6.mp3"],[1864,1864,["thAzham inRi munnIrai anjnjAnRu *","thagaindhadhE kaNDu vanjchi nuNmarunggul *","mAzhai mAn maDa nOkkiyai viTTu *","vAzhakillA madhiyil manaththAnai **","Ezhaiyai ilanggaikku iRai thannai *","enggaLai ozhiyak kolai avanai *","sUzhumA ninai mAmaNi vaNNA! *","sollinOm thaDam ponggaththam ponggO"],["தாழம் இன்றி முந்நீரை அஞ்ஞான்று *","தகைந்ததே கண்டு வஞ்சி நுண்மருங்குல் *","மாழை மான் மட நோக்கியை விட்டு *","வாழகில்லா மதியில் மனத்தானை **","ஏழையை இலங்கைக்கு இறை தன்னை *","எங்களை ஒழியக் கொலை அவனை *","சூழுமா நினை மாமணி வண்ணா! *","சொல்லினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.7.mp3"],[1865,1865,["manangkoNDu ERum maNDOdhari mudhalA *","angkayal kaNNinArgaL iruppa *","thanangkoL menmulai nOkkam ozhindhu *","thanjchamE sila thApathar enRu **","punangkoL menmayilaich siRai vaiththa *","punmaiyALan nenjchil puga eydha *","ananggan anna thiNthOL em irAmaRku *","anjchinOm thaDam ponggaththam ponggO"],["மனங்கொண்டு ஏறும் மண்டோதரி முதலா *","அங்கயல் கண்ணினார்கள் இருப்ப *","தனங்கொள் மென்முலை நோக்கம் ஒழிந்து *","தஞ்சமே சில தாபதர் என்று **","புனங்கொள் மென்மயிலைச் சிறை வைத்த *","புன்மையாளன் நெஞ்சில் புக எய்த *","அனங்கன் அன்ன திண்தோள் எம் இராமற்கு *","அஞ்சினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.8.mp3"],[1866,1866,["puraṅkal̤ mūṉṟum or māttiraip potil *","pŏṅku ĕrikku irai kaṇṭavaṉ ampiṉ *","caraṅkal̤e kŏṭitu āy aṭukiṉṟa *","cāmpavāṉ uṭaṉ niṟkat tŏzhutom **","iraṅku nī ĕmakku ĕntai pirāṉe *","ilaṅku vĕm katiroṉ-taṉ ciṟuvā *","kuraṅkukaṭku arace ĕmmaik kŏllel *","kūṟiṉom-taṭam pŏṅkattam pŏṅko-"],["புரங்கள் மூன்றும் ஓர் மாத்திரைப் போதில் *","பொங்கு எரிக்கு இரை கண்டவன் அம்பின் *","சரங்களே கொடிது ஆய் அடுகின்ற *","சாம்பவான் உடன் நிற்கத் தொழுதோம் **","இரங்கு நீ எமக்கு எந்தை பிரானே *","இலங்கு வெம் கதிரோன் தன் சிறுவா *","குரங்குகட்கு அரசே எம்மைக் கொல்லேல் *","கூறினோம் தடம் பொங்கத்தம் பொங்கோ"],1,"/media/recitation/PT.10.2.9.mp3"],[1867,1867,["** anggu vAnavarkku Agulam thIra *","aNi ilanggai azhiththavan thannai *","ponggu mAvalavan kalikanRi *","puganRa ponggaththam koNDu ** ivvulaginil","enggum pADi ninRu ADumin thoNDIr! *","immaiyE iDar illai * iRandhAl","thanggum Ur aNDamE kaNDu koNmin *","sARRinOm thaDam ponggaththam ponggO"],["** அங்கு வானவர்க்கு ஆகுலம் தீர *","அணி இலங்கை அழித்தவன் தன்னை *","பொங்கு மாவலவன் கலிகன்றி *","புகன்ற பொங்கத்தம் கொண்டு ** இவ்வுலகினில்","எங்கும் பாடி நின்று ஆடுமின் தொண்டீர்! *","இம்மையே இடர் இல்லை * இறந்தால்","தங்கும் ஊர் அண்டமே கண்டு கொண்மின் *","சாற்றினோம் தடம் பொங்கத்தம் பொங்கோ"],0,"/media/recitation/PT.10.2.10.mp3"]],[[1868,1868,["** EththuginROm nAththazhumba * irAman thirunAmam *","sOththam nambI! sukkirIvA! * ummaith thozhuginROm **","vArththai pEsIr emmai * unggaL vAnaram kollAmE *","kUththar pOla ADuginROm * kuzhamaNi dhUramE"],["** ஏத்துகின்றோம் நாத்தழும்ப * இராமன் திருநாமம் *","சோத்தம் நம்பீ! சுக்கிரீவா! * உம்மைத் தொழுகின்றோம் **","வார்த்தை பேசீர் எம்மை * உங்கள் வானரம் கொல்லாமே *","கூத்தர் போல ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.1.mp3"],[1869,1869,["ĕmpirāṉe ĕṉṉai āl̤vāy * ĕṉṟu ĕṉṟu alaṟṟāte *","ampiṉ vāyppaṭṭu āṟṟakillātu * intiracittu azhintāṉ **","nampi anumā cukkirīvā * aṅkataṉe nal̤aṉe *","kumpakarṇaṉ paṭṭuppoṉāṉ- * kuzhamaṇitūrame-"],["எம்பிரானே என்னை ஆள்வாய் * என்று என்று அலற்றாதே *","அம்பின் வாய்ப்பட்டு ஆற்றகில்லாது * இந்திரசித்து அழிந்தான் **","நம்பி அநுமா சுக்கிரீவா * அங்கதனே நளனே *","கும்பகர்ணன் பட்டுப்போனான் * குழமணிதூரமே"],1,"/media/recitation/PT.10.3.2.mp3"],[1870,1870,["njAlam ALum unggaL kOmAn * enggaL irAvaNaRku *","kAlan Agi vandhavA! kaNDu * anjchik karumugil pOl **","nIlan vAzhga suDENan vAzhga * anggadhan vAzhga enRu *","kOlam Aga ADuginROm * kuzhamaNi dhUramE"],["ஞாலம் ஆளும் உங்கள் கோமான் * எங்கள் இராவணற்கு *","காலன் ஆகி வந்தவா! கண்டு * அஞ்சிக் கருமுகில் போல் **","நீலன் வாழ்க சுடேணன் வாழ்க * அங்கதன் வாழ்க என்று *","கோலம் ஆக ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.3.mp3"],[1871,1871,["maNanggaL nARum vAr kuzhalAr * mAdhargaL Adharaththai *","puNarndha sindhaip punmaiyALan * ponRa vari silaiyAl **","kaNanggaL uNNa vALi ANDa * kAvalanukku iLaiyOn *","guNanggaL pADi ADuginROm * kuzhamaNi dhUramE"],["மணங்கள் நாறும் வார் குழலார் * மாதர்கள் ஆதரத்தை *","புணர்ந்த சிந்தைப் புன்மையாளன் * பொன்ற வரி சிலையால் **","கணங்கள் உண்ண வாளி ஆண்ட * காவலனுக்கு இளையோன் *","குணங்கள் பாடி ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.4.mp3"],[1872,1872,["venRi thandhOm mAnam vENDOm * dhAnam emakkAga *","inRu thammin enggaL vANAL * emperumAn thamargAL! **","ninRu kANIr kaNgaL Ara * nIr emmaik kollAdhE *","kunRu pOla ADuginROm * kuzhamaNi dhUramE"],["வென்றி தந்தோம் மானம் வேண்டோம் * தானம் எமக்காக *","இன்று தம்மின் எங்கள் வாணாள் * எம்பெருமான் தமர்காள்! **","நின்று காணீர் கண்கள் ஆர * நீர் எம்மைக் கொல்லாதே *","குன்று போல ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.5.mp3"],[1873,1873,["kallin munnIr mARRi vandhu * kAval kaDandhu * ilanggai","allal seydhAn unggaL kOmAn * emmai amarkkaLaththu **","vellakillAdhu anjchinOm kAN * vengkadhirOn siRuvA! *","kolla vENDA ADuginROm * kuzhamaNi dhUramE"],["கல்லின் முந்நீர் மாற்றி வந்து * காவல் கடந்து * இலங்கை","அல்லல் செய்தான் உங்கள் கோமான் * எம்மை அமர்க்களத்து **","வெல்லகில்லாது அஞ்சினோம் காண் * வெங்கதிரோன் சிறுவா! *","கொல்ல வேண்டா ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.6.mp3"],[1874,1874,["mARRam Avadhu iththanaiyE * vammin arakkar uLLIr! *","sIRRam nummEl thIra vENDil * sEvagam pEsAdhE **","ARRal sAnRa thol piRappil * anumanai vAzhga enRu *","kURRam annAr kANa ADIr * kuzhamaNi dhUramE"],["மாற்றம் ஆவது இத்தனையே * வம்மின் அரக்கர் உள்ளீர்! *","சீற்றம் நும்மேல் தீர வேண்டில் * சேவகம் பேசாதே **","ஆற்றல் சான்ற தொல் பிறப்பில் * அனுமனை வாழ்க என்று *","கூற்றம் அன்னார் காண ஆடீர் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.7.mp3"],[1875,1875,["kaval̤a yāṉai pāy puravi * terŏṭu arakkar ĕllām","tuval̤a * vĕṉṟa vĕṉṟiyāl̤aṉ-taṉ tamar kŏllāme **","taval̤a māṭam nīṭu ayottik * kāvalaṉ-taṉ ciṟuvaṉ *","kuval̤ai vaṇṇaṉ kāṇa āṭīr- * kuzhamaṇitūrame-"],["கவள யானை பாய் புரவி * தேரொடு அரக்கர் எல்லாம்","துவள * வென்ற வென்றியாளன் தன் தமர் கொல்லாமே **","தவள மாடம் நீடு அயோத்திக் * காவலன் தன் சிறுவன் *","குவளை வண்ணன் காண ஆடீர் * குழமணிதூரமே"],1,"/media/recitation/PT.10.3.8.mp3"],[1876,1876,["EDoththa Endhum nILilai vEl * enggaL irAvaNanAr","ODip pOnAr * nAnggaL eyththOm * uyvadhOr kAraNaththAl **","sUDip pOndhOm unggaL kOman ANai * thoDarEnmin *","kUDik kUDi ADuginROm * kuzhamaNi dhUramE"],["ஏடொத்த ஏந்தும் நீளிலை வேல் * எங்கள் இராவணனார்","ஓடிப் போனார் * நாங்கள் எய்த்தோம் * உய்வதோர் காரணத்தால் **","சூடிப் போந்தோம் உங்கள் கோமன் ஆணை * தொடரேன்மின் *","கூடிக் கூடி ஆடுகின்றோம் * குழமணி தூரமே"],0,"/media/recitation/PT.10.3.9.mp3"],[1877,1877,["** venRa thol sIrth thennilanggai * venjchamaththu * anRu arakkar","kunRam annAr ADi uyndha * kuzhamaNi dhUraththai **","kanRi neynnIr ninRa vERkaik * kaliyan oli mAlai *","onRum onRum aindhum mUnRum * pADi ninRu ADuminE"],["** வென்ற தொல் சீர்த் தென்னிலங்கை * வெஞ்சமத்து * அன்று அரக்கர்","குன்றம் அன்னார் ஆடி உய்ந்த * குழமணி தூரத்தை **","கன்றி நெய்ந்நீர் நின்ற வேற்கைக் * கலியன் ஒலி மாலை *","ஒன்றும் ஒன்றும் ஐந்தும் மூன்றும் * பாடி நின்று ஆடுமினே"],0,"/media/recitation/PT.10.3.10.mp3"]],[[1878,1878,["** sandha malark kuzhal thAzhath *","thAn ugandhODith thaniyE","vandhu * en mulaith thaDanthannai","vAnggi * nin vAyil maDuththu **","nandhan peRap peRRa nambI! *","nAn ugandhuNNum amudhE! *","endhai perumanE! uNNAy *","en ammam sEmam uNNAyE"],["** சந்த மலர்க் குழல் தாழத் *","தான் உகந்தோடித் தனியே","வந்து * என் முலைத் தடந்தன்னை","வாங்கி * நின் வாயில் மடுத்து **","நந்தன் பெறப் பெற்ற நம்பீ! *","நான் உகந்துண்ணும் அமுதே! *","எந்தை பெருமனே! உண்ணாய் *","என் அம்மம் சேமம் உண்ணாயே"],0,"/media/recitation/PT.10.4.1.mp3"],[1879,1879,["vangga maRikaDal vaNNA! *","mAmugilE okkum nambI! *","sengkaN neDiya thiruvE! *","sengkamalam purai vAyA! **","konggai surandhiDa unnaik *","kUviyum kANAdhu irundhEn *","enggirundhu AyargaLODum *","en viLaiyADuginRAyE?"],["வங்க மறிகடல் வண்ணா! *","மாமுகிலே ஒக்கும் நம்பீ! *","செங்கண் நெடிய திருவே! *","செங்கமலம் புரை வாயா! **","கொங்கை சுரந்திட உன்னைக் *","கூவியும் காணாது இருந்தேன் *","எங்கிருந்து ஆயர்களோடும் *","என் விளையாடுகின்றாயே?"],0,"/media/recitation/PT.10.4.2.mp3"],[1880,1880,["thiruvil polindha ezhil Ar *","Ayar tham piLLaigaLODu *","theruvil thiLaikkinRa nambI! *","seyginRa thImaigaL kaNDiTTu **","urugi en konggaiyin thImpAl *","OTTandhu pAyndhiDuginRa *","maruvik kuDangkAl irundhu *","vAy mulai uNNa nI vArAy"],["திருவில் பொலிந்த எழில் ஆர் *","ஆயர் தம் பிள்ளைகளோடு *","தெருவில் திளைக்கின்ற நம்பீ! *","செய்கின்ற தீமைகள் கண்டிட்டு **","உருகி என் கொங்கையின் தீம்பால் *","ஓட்டந்து பாய்ந்திடுகின்ற *","மருவிக் குடங்கால் இருந்து *","வாய் முலை உண்ண நீ வாராய்"],0,"/media/recitation/PT.10.4.3.mp3"],[1881,1881,["makkaL peRu thavam pOlum *","vaiyaththu vAzhum maDavAr *","makkaL piRar kaNNukku okkum","mudhalvA! * madhak kaLiRu annAy! **","sekkar iLampiRai thannai","vAnggi * nin kaiyil tharuvan *","okkalai mEl irundhu ammam","ugandhu * inidhuNNa nI vArAy"],["மக்கள் பெறு தவம் போலும் *","வையத்து வாழும் மடவார் *","மக்கள் பிறர் கண்ணுக்கு ஒக்கும்","முதல்வா! * மதக் களிறு அன்னாய்! **","செக்கர் இளம்பிறை தன்னை","வாங்கி * நின் கையில் தருவன் *","ஒக்கலை மேல் இருந்து அம்மம்","உகந்து * இனிதுண்ண நீ வாராய்"],0,"/media/recitation/PT.10.4.4.mp3"],[1882,1882,["maiththa karungkunjchi maindhA! *","mAmarudhUDu naDandhAy! *","viththaganE! viraiyAdhE! *","veNNey vizhunggum vigirdhA! **","iththanai pOdhanRi endhan *","konggai surandhirukka killA *","uththamanE! ammam uNNAy *","ulagaLandhAy! ammam uNNAy"],["மைத்த கருங்குஞ்சி மைந்தா! *","மாமருதூடு நடந்தாய்! *","வித்தகனே! விரையாதே! *","வெண்ணெய் விழுங்கும் விகிர்தா! **","இத்தனை போதன்றி என்தன் *","கொங்கை சுரந்திருக்க கில்லா *","உத்தமனே! அம்மம் உண்ணாய் *","உலகளந்தாய்! அம்மம் உண்ணாய்"],0,"/media/recitation/PT.10.4.5.mp3"],[1883,1883,["piLLaigaL seyvana seyyAy *","pEsin peridhum valiyai *","kaLLam manaththil uDaiyai *","kANavE thImaigaL seydhi **","uLLam urugi en konggai *","OTTandhu pAyndhiDuginRa *","paLLik kuRippuch seyyAdhE *","pAlamudhu uNNa nI vArAy"],["பிள்ளைகள் செய்வன செய்யாய் *","பேசின் பெரிதும் வலியை *","கள்ளம் மனத்தில் உடையை *","காணவே தீமைகள் செய்தி **","உள்ளம் உருகி என் கொங்கை *","ஓட்டந்து பாய்ந்திடுகின்ற *","பள்ளிக் குறிப்புச் செய்யாதே *","பாலமுது உண்ண நீ வாராய்"],0,"/media/recitation/PT.10.4.6.mp3"],[1884,1884,["than maganAga vanpEychchi *","thAn mulai uNNak koDukka *","vanmaganAy avaL Avi","vAnggi * mulai uNDa nambI! **","nanmagaL AymagaLODu *","nAnila manggai maNALA! *","en maganE! ammam uNNAy *","en ammam sEmam uNNAyE"],["தன் மகனாக வன்பேய்ச்சி *","தான் முலை உண்ணக் கொடுக்க *","வன்மகனாய் அவள் ஆவி","வாங்கி * முலை உண்ட நம்பீ! **","நன்மகள் ஆய்மகளோடு *","நானில மங்கை மணாளா! *","என் மகனே! அம்மம் உண்ணாய் *","என் அம்மம் சேமம் உண்ணாயே"],0,"/media/recitation/PT.10.4.7.mp3"],[1885,1885,["undham aDigaL munivar *","unnai nAn en kaiyil kOlAl *","nondhiDa mOdhavum killEn *","nunggaL tham Anirai ellAm **","vandhu pugutharum pOdhu *","vAniDaith dheyvanggaL kANa *","andhiyam pOdhu anggu nillEl *","AzhiyangkaiyanE! vArAy"],["உந்தம் அடிகள் முனிவர் *","உன்னை நான் என் கையில் கோலால் *","நொந்திட மோதவும் கில்லேன் *","நுங்கள் தம் ஆநிரை எல்லாம் **","வந்து புகுதரும் போது *","வானிடைத் தெய்வங்கள் காண *","அந்தியம் போது அங்கு நில்லேல் *","ஆழியங்கையனே! வாராய்"],0,"/media/recitation/PT.10.4.8.mp3"],[1886,1886,["peRRath thalaivan enggOmAn *","pEraruLALan madhalAy! *","suRRak kuzhAththu iLangkOvE! *","thOnRiya thol pugazhALA! **","kaRRinam thORum maRiththuk *","kAnam thirindha kaLiRE! *","eRRukken ammam uNNAdhE *","emperumAn irundhAyE?"],["பெற்றத் தலைவன் எங்கோமான் *","பேரருளாளன் மதலாய்! *","சுற்றக் குழாத்து இளங்கோவே! *","தோன்றிய தொல் புகழாளா! **","கற்றினம் தோறும் மறித்துக் *","கானம் திரிந்த களிறே! *","எற்றுக்கென் அம்மம் உண்ணாதே *","எம்பெருமான் இருந்தாயே?"],0,"/media/recitation/PT.10.4.9.mp3"],[1887,1887,["** immai iDar keDa vENDi *","Endhezhil thOL kalikanRi *","semmaip panuval nUl koNDu *","sengkaN neDiyavan thannai **","ammam uN enRu uraikkinRa *","pADal ivai aindhum aindhum *","meymmai manaththu vaiththEththa *","viNNavar AgalumAmE"],["** இம்மை இடர் கெட வேண்டி *","ஏந்தெழில் தோள் கலிகன்றி *","செம்மைப் பனுவல் நூல் கொண்டு *","செங்கண் நெடியவன் தன்னை **","அம்மம் உண் என்று உரைக்கின்ற *","பாடல் இவை ஐந்தும் ஐந்தும் *","மெய்ம்மை மனத்து வைத்தேத்த *","விண்ணவர் ஆகலுமாமே"],0,"/media/recitation/PT.10.4.10.mp3"]],[[1888,1888,["pūṅ kotai āycci * kaṭai vĕṇṇĕy pukku uṇṇa *","āṅku aval̤ ārttup * puṭaikkap puṭaiyuṇṭu **","eṅki iruntu * ciṇuṅki vil̤aiyāṭum *","oṅku ota vaṇṇaṉe cappāṇi * ŏl̤i maṇi vaṇṇaṉe cappāṇi-"],["பூங் கோதை ஆய்ச்சி * கடை வெண்ணெய் புக்கு உண்ண *","ஆங்கு அவள் ஆர்த்துப் * புடைக்கப் புடையுண்டு **","ஏங்கி இருந்து * சிணுங்கி விளையாடும் *","ஓங்கு ஓத வண்ணனே சப்பாணி * ஒளி மணி வண்ணனே சப்பாணி"],1,"/media/recitation/PT.10.5.1.mp3"],[1889,1889,["thAyar mananggaL thaDippa * thayir ney uN","DE empirAkkaL ** irunilaththu enggaL tham *","Ayar azhaga! * aDigaL aravindha","vAyavanE! koTTAy chappANi * mAlvaNNanE! koTTAy chappANi"],["தாயர் மனங்கள் தடிப்ப * தயிர் நெய் உண்","டே எம்பிராக்கள் ** இருநிலத்து எங்கள் தம் *","ஆயர் அழக! * அடிகள் அரவிந்த","வாயவனே! கொட்டாய் சப்பாணி * மால்வண்ணனே! கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.2.mp3"],[1890,1890,["thA mOr uruTTith * thayir ney vizhunggiTTu *","thAmO thavazhvar enRu * Aychchiyar thAmbinAl **","thAmOtharak kaiyAl * Arkkath thazhumbirundha *","dhAmOdharA! koTTAy chappANi * thAmaraik kaNNanE! chappANi"],["தா மோர் உருட்டித் * தயிர் நெய் விழுங்கிட்டு *","தாமோ தவழ்வர் என்று * ஆய்ச்சியர் தாம்பினால் **","தாமோதரக் கையால் * ஆர்க்கத் தழும்பிருந்த *","தாமோதரா! கொட்டாய் சப்பாணி * தாமரைக் கண்ணனே! சப்பாணி"],0,"/media/recitation/PT.10.5.3.mp3"],[1891,1891,["peRRAr thaLai kazhalap * pErndhanggu ayal iDaththu *","uRRAr oruvarum inRi * ulaginil **","maRRArum anjchap pOy * vanjchap peN nanjchuNDa *","kaRRAyanE! koTTAy chappANi * kArvaNNanE! koTTAy chappANi"],["பெற்றார் தளை கழலப் * பேர்ந்தங்கு அயல் இடத்து *","உற்றார் ஒருவரும் இன்றி * உலகினில் **","மற்றாரும் அஞ்சப் போய் * வஞ்சப் பெண் நஞ்சுண்ட *","கற்றாயனே! கொட்டாய் சப்பாணி * கார்வண்ணனே! கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.4.mp3"],[1892,1892,["sOththena ninnaith * thozhuvan varam thara *","pEychchi mulai uNDa piLLAy! ** periyana","Aychchiyar appam tharuvar * avarkkAgach","sARRi Or Ayiram chappANi * thaDangkaigaLAl koTTAy chappANi"],["சோத்தென நின்னைத் * தொழுவன் வரம் தர *","பேய்ச்சி முலை உண்ட பிள்ளாய்! ** பெரியன","ஆய்ச்சியர் அப்பம் தருவர் * அவர்க்காகச்","சாற்றி ஓர் ஆயிரம் சப்பாணி * தடங்கைகளால் கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.5.mp3"],[1893,1893,["kEvalam anRu * un vayiRu * vayiRRukku","nAn * aval appam tharuvan ** karuviLaip","pUvalar nILmuDi * nandhan than pOr ERE! *","kOvalanE! koTTAy chappANi * kuDamADI! koTTAy chappANi"],["கேவலம் அன்று உன் வயிறு * வயிற்றுக்கு","நான் * அவல் அப்பம் தருவன் ** கருவிளைப்","பூவலர் நீள்முடி * நந்தன் தன் போர் ஏறே! *","கோவலனே! கொட்டாய் சப்பாணி * குடமாடீ! கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.6.mp3"],[1894,1894,["puLLinai vAy piLandhu * pUngkurundham sAyththu *","thuLLi viLayADith * thUngguRi veNNeyai **","aLLiya kaiyAl * aDiyEn mulai neruDum *","piLLaip pirAn! koTTAy chappANi * pEymulai uNDAnE! chappANi"],["புள்ளினை வாய் பிளந்து * பூங்குருந்தம் சாய்த்து *","துள்ளி விளயாடித் * தூங்குறி வெண்ணெயை **","அள்ளிய கையால் * அடியேன் முலை நெருடும் *","பிள்ளைப் பிரான்! கொட்டாய் சப்பாணி * பேய்முலை உண்டானே! சப்பாணி"],0,"/media/recitation/PT.10.5.7.mp3"],[1895,1895,["yāyum piṟarum * aṟiyāta yāmattu *","māya valavaip * pĕṇ vantu mulai tara **","pey ĕṉṟu aval̤aip * piṭittu uyir uṇṭa *","vāyavaṉe kŏṭṭāy cappāṇi * mālvaṇṇaṉe kŏṭṭāy cappāṇi-"],["யாயும் பிறரும் * அறியாத யாமத்து *","மாய வலவைப் * பெண் வந்து முலை தர **","பேய் என்று அவளைப் * பிடித்து உயிர் உண்ட *","வாயவனே கொட்டாய் சப்பாணி * மால்வண்ணனே கொட்டாய் சப்பாணி"],1,"/media/recitation/PT.10.5.8.mp3"],[1896,1896,["kaLLak kuzhaviyAyk * kAlAl sakaDaththai *","thaLLi udhaiththiTTuth * thAyAy varuvALai **","meLLath thoDarndhu * piDiththu Aruyir uNDa *","vaLLalE! koTTAy chappANi * mAlvaNNanE! koTTAy chappANi"],["கள்ளக் குழவியாய்க் * காலால் சகடத்தை *","தள்ளி உதைத்திட்டுத் * தாயாய் வருவாளை **","மெள்ளத் தொடர்ந்து * பிடித்து ஆருயிர் உண்ட *","வள்ளலே! கொட்டாய் சப்பாணி * மால்வண்ணனே! கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.9.mp3"],[1897,1897,["** kArAr puyaRkaik * kalikanRi manggaiyar kOn *","pErALan nenjchil * piriyAdhu iDangkoNDa","sIrALA! ** senthAmaraik kaNNA! * thaNthuzhAy *","thArALA! koTTAy chappANi * thaDamArvA! koTTAy chappANi"],["** காரார் புயற்கைக் * கலிகன்றி மங்கையர் கோன் *","பேராளன் நெஞ்சில் * பிரியாது இடங்கொண்ட","சீராளா! ** செந்தாமரைக் கண்ணா! தண்துழாய் *","தாராளா! கொட்டாய் சப்பாணி * தடமார்வா! கொட்டாய் சப்பாணி"],0,"/media/recitation/PT.10.5.10.mp3"]],[[1898,1898,["** enggAnum IdhoppadhOr mAyam uNDE? *","nara nAraNanAy ulagaththu aRa nUl *","singgAmai viriththavan emperumAn *","adhu anRiyum senjchuDarum nilanum **","ponggAr kaDalum poruppum neruppum","nerukkip pugap * pon miDaRu aththanai pOdhu *","anggAndhavan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["** எங்கானும் ஈதொப்பதோர் மாயம் உண்டே? *","நர நாரணனாய் உலகத்து அற நூல் *","சிங்காமை விரித்தவன் எம்பெருமான் *","அது அன்றியும் செஞ்சுடரும் நிலனும் **","பொங்கார் கடலும் பொருப்பும் நெருப்பும்","நெருக்கிப் புகப் * பொன் மிடறு அத்தனை போது *","அங்காந்தவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.1.mp3"],[1899,1899,["kunRonRu maththA aravam aLavik *","kurai mAkaDalaik kaDaindhiTTu * orukAl","ninRuNDai koNDu OTTi vankUn nimira *","ninaindha perumAn adhu anRiyum mun **","nanRuNDa thol sIr magarak kaDal Ezh *","malaiyEzh ulagEzh ozhiyAmai nambi *","anRuNDavan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["குன்றொன்று மத்தா அரவம் அளவிக் *","குரை மாகடலைக் கடைந்திட்டு * ஒருகால்","நின்றுண்டை கொண்டு ஓட்டி வன்கூன் நிமிர *","நினைந்த பெருமான் அது அன்றியும் முன் **","நன்றுண்ட தொல் சீர் மகரக் கடல் ஏழ் *","மலையேழ் உலகேழ் ஒழியாமை நம்பி *","அன்றுண்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.2.mp3"],[1900,1900,["ul̤aintiṭṭu ĕzhunta matu-kaiṭavarkal̤ *","ulappu il valiyār-avarpāl * vayiram","vil̤aintiṭṭatu ĕṉṟu ĕṇṇi viṇṇor parava *","avar nāl̤ ŏzhitta pĕrumāṉ muṉa nāl̤ **","val̤aintiṭṭa villāl̤i val vāl̤ ĕyiṟṟu *","malai pol avuṇaṉ uṭal val̤ ukirāl *","al̤aintiṭṭavaṉ kāṇmiṉ-iṉṟu āycciyarāl *","al̤ai vĕṇṇĕy uṇṭu āppuṇṭiruntavaṉe-"],["உளைந்திட்டு எழுந்த மது கைடவர்கள் *","உலப்பு இல் வலியார் அவர்பால் * வயிரம்","விளைந்திட்டது என்று எண்ணி விண்ணோர் பரவ *","அவர் நாள் ஒழித்த பெருமான் முன நாள் **","வளைந்திட்ட வில்லாளி வல் வாள் எயிற்று *","மலை போல் அவுணன் உடல் வள் உகிரால் *","அளைந்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளை வெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],1,"/media/recitation/PT.10.6.3.mp3"],[1901,1901,["thaLarndhiTTu imaiyOr saraN thA enath * thAn","saraNAy muraNAyavanai * ugirAl","piLandhiTTu amararkku aruL seydhu ugandha *","perumAn thirumAl viri nIr ulagai **","vaLarndhiTTa thol sIr viRal mAvaliyai *","maN koLLa vanjchiththu oru mAN kuRaLAy *","aLandhiTTavan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["தளர்ந்திட்டு இமையோர் சரண் தா எனத் * தான்","சரணாய் முரணாயவனை * உகிரால்","பிளந்திட்டு அமரர்க்கு அருள் செய்து உகந்த *","பெருமான் திருமால் விரி நீர் உலகை **","வளர்ந்திட்ட தொல் சீர் விறல் மாவலியை *","மண் கொள்ள வஞ்சித்து ஒரு மாண் குறளாய் *","அளந்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.4.mp3"],[1902,1902,["nINDAn kuRaLAy neDuvAn aLavum *","aDiyAr paDum Azh thuyarAya ellAm *","thINDAmai ninaindhu imaiyOr aLavum *","sela vaiththa pirAn adhu anRiyum mun **","vENDAmai naman thamar en thamarai *","vinavap peRuvAr alar enRu * ulagEzh","ANDAn avan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["நீண்டான் குறளாய் நெடுவான் அளவும் *","அடியார் படும் ஆழ் துயராய எல்லாம் *","தீண்டாமை நினைந்து இமையோர் அளவும் *","செல வைத்த பிரான் அது அன்றியும் முன் **","வேண்டாமை நமன் தமர் என் தமரை *","வினவப் பெறுவார் அலர் என்று * உலகேழ்","ஆண்டான் அவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.5.mp3"],[1903,1903,["pazhiththiTTa inbap payan paRRaRuththup *","paNindhEththa vallAr thuyarAya ellAm *","ozhiththiTTu avaraith thanakkAkka valla *","perumAn thirumAl adhu anRiyum mun **","thezhiththiTTu ezhundhE edhir ninRa mannan *","sinath thOL avai Ayiramum mazhuvAl *","azhiththiTTavan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["பழித்திட்ட இன்பப் பயன் பற்றறுத்துப் *","பணிந்தேத்த வல்லார் துயராய எல்லாம் *","ஒழித்திட்டு அவரைத் தனக்காக்க வல்ல *","பெருமான் திருமால் அது அன்றியும் முன் **","தெழித்திட்டு எழுந்தே எதிர் நின்ற மன்னன் *","சினத் தோள் அவை ஆயிரமும் மழுவால் *","அழித்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.6.mp3"],[1904,1904,["paDaiththiTTadhu ivvaiyam uyya muna nAL *","paNindhEththa vallAr thuyarAya ellAm *","thuDaiththiTTu avaraith thanakkAkka ennath *","theLiyA arakkar thiRal pOy aviya **","miDaiththiTTu ezhundha kuranggaip paDaiyA *","vilanggal pugap pAychchi vimma * kaDalai","aDaiththiTTavan kANmin inRu AychchiyarAl *","aLaiveNNey uNDu AppuNDirundhavanE"],["படைத்திட்டது இவ்வையம் உய்ய முன நாள் *","பணிந்தேத்த வல்லார் துயராய எல்லாம் *","துடைத்திட்டு அவரைத் தனக்காக்க என்னத் *","தெளியா அரக்கர் திறல் போய் அவிய **","மிடைத்திட்டு எழுந்த குரங்கைப் படையா *","விலங்கல் புகப் பாய்ச்சி விம்ம * கடலை","அடைத்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளைவெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],0,"/media/recitation/PT.10.6.7.mp3"],[1905,1905,["nĕṟittiṭṭa mĕṉ kūzhai nal ner-izhaiyoṭu *","uṭaṉ āya vil ĕṉṉa val ey ataṉai *","iṟuttiṭṭu aval̤ iṉpam aṉpoṭu aṇaintiṭṭu *","il̤aṅ kŏṟṟavaṉ āy tul̤aṅkāta munnīr **","cĕṟittiṭṭu ilaṅkai malaṅka arakkaṉ *","cĕzhu nīl̤ muṭi tol̤ŏṭu tāl̤ tuṇiya *","aṟuttiṭṭavaṉ kāṇmiṉ-iṉṟu āycciyarāl *","al̤ai vĕṇṇĕy uṇṭu āppuṇṭiruntavaṉe-"],["நெறித்திட்ட மென் கூழை நல் நேர் இழையோடு *","உடன் ஆய வில் என்ன வல் ஏய் அதனை *","இறுத்திட்டு அவள் இன்பம் அன்போடு அணைந்திட்டு *","இளங் கொற்றவன் ஆய் துளங்காத முந்நீர் **","செறித்திட்டு இலங்கை மலங்க அரக்கன் *","செழு நீள் முடி தோளொடு தாள் துணிய *","அறுத்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளை வெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],1,"/media/recitation/PT.10.6.8.mp3"],[1906,1906,["curintiṭṭa cĕṅ kezh ul̤aip pŏṅku arimāt *","tŏlaiyap piriyātu cĕṉṟu ĕyti ĕytātu *","irintiṭṭu iṭaṅkŏṇṭu aṭaṅkātataṉ vāy *","iru kūṟu cĕyta pĕrumāṉ muṉa nāl̤ **","varintiṭṭa villāl maram ezhum ĕytu *","malaipol uruvattu or irākkati mūkku *","arintiṭṭavaṉ kāṇmiṉ-iṉṟu āycciyarāl *","al̤ai vĕṇṇĕy uṇṭu āppuṇṭiruntavaṉe-"],["சுரிந்திட்ட செங் கேழ் உளைப் பொங்கு அரிமாத் *","தொலையப் பிரியாது சென்று எய்தி எய்தாது *","இரிந்திட்டு இடங்கொண்டு அடங்காததன் வாய் *","இரு கூறு செய்த பெருமான் முன நாள் **","வரிந்திட்ட வில்லால் மரம் ஏழும் எய்து *","மலைபோல் உருவத்து ஓர் இராக்கதி மூக்கு *","அரிந்திட்டவன் காண்மின் இன்று ஆய்ச்சியரால் *","அளை வெண்ணெய் உண்டு ஆப்புண்டிருந்தவனே"],1,"/media/recitation/PT.10.6.9.mp3"],[1907,1907,["** ninRAr mugappuch siRidhum ninaiyAn *","vayiRRai niRaippAn uRip pAl thayir ney *","anRu Aychchiyar veNNey vizhunggi * uralODu","AppuNDirundha perumAn aDi mEl **","nanRAya thol sIr vayal manggaiyar kOn *","kaliyan oli sey thamizh mAlai vallAr *","enRAnum eydhAr iDar inbam eydhi *","imaiyOrkkum appAl sela eydhuvArE"],["** நின்றார் முகப்புச் சிறிதும் நினையான் *","வயிற்றை நிறைப்பான் உறிப் பால் தயிர் நெய் *","அன்று ஆய்ச்சியர் வெண்ணெய் விழுங்கி * உரலோடு","ஆப்புண்டிருந்த பெருமான் அடி மேல் **","நன்றாய தொல் சீர் வயல் மங்கையர் கோன் *","கலியன் ஒலி செய் தமிழ் மாலை வல்லார் *","என்றானும் எய்தார் இடர் இன்பம் எய்தி *","இமையோர்க்கும் அப்பால் செல எய்துவாரே"],0,"/media/recitation/PT.10.6.10.mp3"]],[[1908,1908,["** mAnam uDaiththu unggaL Ayar kulam","adhanAl * piRar makkaL thammai *","Unam uDaiyana seyyap peRAy enRu *","irappan urappa killEn **","nAnum uraiththilEn nandhan paNiththilan *","nanggaigAL! nAn en seygEn? *","thAnum Or kanniyum kIzhai agaththuth *","thayir kaDaiginRAn pOlum"],["** மானம் உடைத்து உங்கள் ஆயர் குலம்","அதனால் * பிறர் மக்கள் தம்மை *","ஊனம் உடையன செய்யப் பெறாய் என்று *","இரப்பன் உரப்ப கில்லேன் **","நானும் உரைத்திலேன் நந்தன் பணித்திலன் *","நங்கைகாள்! நான் என் செய்கேன்? *","தானும் ஓர் கன்னியும் கீழை அகத்துத் *","தயிர் கடைகின்றான் போலும்"],0,"/media/recitation/PT.10.7.1.mp3"],[1909,1909,["kAlai ezhundhu kaDaindha immOr viRkap","pOginREn * kaNDE pOnEn *","mAlai naRungkunjchi nandhan magan allAl *","maRRu vandhArum illai **","mElai agaththu nanggAy! vandhu kANmingaL *","veNNeyE anRu * irundha","pAlum padhin kuDam kaNDilEn * pAviyEn","en seygEn? en seygEnO?"],["காலை எழுந்து கடைந்த இம்மோர் விற்கப்","போகின்றேன் * கண்டே போனேன் *","மாலை நறுங்குஞ்சி நந்தன் மகன் அல்லால் *","மற்று வந்தாரும் இல்லை **","மேலை அகத்து நங்காய்! வந்து காண்மின்கள் *","வெண்ணெயே அன்று * இருந்த","பாலும் பதின் குடம் கண்டிலேன் * பாவியேன்","என் செய்கேன்? என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.2.mp3"],[1910,1910,["theLLiya vAych chiRiyAn nanggaigAL! * uRi","mElaith thaDA niRaindha *","veLLi malai irundhAl oththa veNNeyai *","vAri vizhunggiyiTTu **","kaLvan uRangguginRAn vandhu kANmingaL *","kai ellAm ney vayiRu","piLLai param anRu * ivvEzh ulagum koLLum *","pEdhaiyEn en seygEnO?"],["தெள்ளிய வாய்ச் சிறியான் நங்கைகாள்! * உறி","மேலைத் தடா நிறைந்த *","வெள்ளி மலை இருந்தால் ஒத்த வெண்ணெயை *","வாரி விழுங்கியிட்டு **","கள்வன் உறங்குகின்றான் வந்து காண்மின்கள் *","கை எல்லாம் நெய் வயிறு","பிள்ளை பரம் அன்று * இவ்வேழ் உலகும் கொள்ளும் *","பேதையேன் என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.3.mp3"],[1911,1911,["mainnambu vERkaN nallAL * munnam peRRa vaLai","vaNNa nanmAmEni *","thannambi nambiyum inggu vaLarndhadhu *","avan ivai seydhaRiyAn **","poynnambi puLLuvan kaLvam podhi aRai *","pOginRavA thavazhndhiTTu *","innambi nambiyA Aychchiyarkku uyvillai *","en seygEn? en seygEnO?"],["மைந்நம்பு வேற்கண் நல்லாள் * முன்னம் பெற்ற வளை","வண்ண நன்மாமேனி *","தன்னம்பி நம்பியும் இங்கு வளர்ந்தது *","அவன் இவை செய்தறியான் **","பொய்ந்நம்பி புள்ளுவன் கள்வம் பொதி அறை *","போகின்றவா தவழ்ந்திட்டு *","இந்நம்பி நம்பியா ஆய்ச்சியர்க்கு உய்வில்லை *","என் செய்கேன்? என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.4.mp3"],[1912,1912,["thandhai pugundhilan nAn inggu irundhilEn *","thOzhimAr Arum illai *","sandha malark kuzhalAL * thaniyE","viLaiyADum iDam kuRugi **","pandhu paRiththuth thugil paRRik kIRip *","paDiRan paDiRu seyyum *","nandhan madhalaikku inggu en kaDavOm? nanggAy! *","en seygEn? en seygEnO?"],["தந்தை புகுந்திலன் நான் இங்கு இருந்திலேன் *","தோழிமார் ஆரும் இல்லை *","சந்த மலர்க் குழலாள் * தனியே","விளையாடும் இடம் குறுகி **","பந்து பறித்துத் துகில் பற்றிக் கீறிப் *","படிறன் படிறு செய்யும் *","நந்தன் மதலைக்கு இங்கு என் கடவோம்? நங்காய்! *","என் செய்கேன்? என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.5.mp3"],[1913,1913,["maNmagaL kELvan malarmanggai nAyagan *","nandhan peRRa madhalai *","aNNal ilaik kuzhal Udhi nam sErikkE *","allil thAn vandha pinnai **","kaNmalar sOrndhu mulai vandhu vimmik *","kamalach chevvAy veLuppa *","en magaL vaNNam irukkinRavA nanggAy! *","en seygEn? en seygEnO?"],["மண்மகள் கேள்வன் மலர்மங்கை நாயகன் *","நந்தன் பெற்ற மதலை *","அண்ணல் இலைக் குழல் ஊதி நம் சேரிக்கே *","அல்லில் தான் வந்த பின்னை **","கண்மலர் சோர்ந்து முலை வந்து விம்மிக் *","கமலச் செவ்வாய் வெளுப்ப *","என் மகள் வண்ணம் இருக்கின்றவா நங்காய்! *","என் செய்கேன்? என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.6.mp3"],[1914,1914,["Ayiram kaN uDai indhiranArukku enRu *","Ayar vizhavu eDuppa *","pAsana nallana paNDigaLAl *","pugap peydha adhanai ellAm **","pOy irundhu anggoru pUtha vaDivu koNDu *","un magan inRu nanggAy! *","mAyan adhanai ellAm muRRa * vAri","vaLaiththu uNDirundhAn pOlum"],["ஆயிரம் கண் உடை இந்திரனாருக்கு என்று *","ஆயர் விழவு எடுப்ப *","பாசன நல்லன பண்டிகளால் *","புகப் பெய்த அதனை எல்லாம் **","போய் இருந்து அங்கொரு பூத வடிவு கொண்டு *","உன் மகன் இன்று நங்காய்! *","மாயன் அதனை எல்லாம் முற்ற * வாரி","வளைத்து உண்டிருந்தான் போலும்"],0,"/media/recitation/PT.10.7.7.mp3"],[1915,1915,["toytta tayirum naṟu nĕyyum pālum *","or or kuṭam tuṟṟiṭum ĕṉṟu *","āycciyar kūṭi azhaikkavum * nāṉ itaṟku","ĕl̤ki ivaṉai naṅkāy **","cottam pirāṉ ivai cĕyyap pĕṟāy ĕṉṟu *","irappaṉ urappakilleṉ *","peycci mulai uṇṭa piṉṉai * ip","pil̤l̤aiyaip pecuvatu añcuvaṉe-"],["தோய்த்த தயிரும் நறு நெய்யும் பாலும் *","ஓர் ஓர் குடம் துற்றிடும் என்று *","ஆய்ச்சியர் கூடி அழைக்கவும் * நான் இதற்கு","எள்கி இவனை நங்காய் **","சோத்தம் பிரான் இவை செய்யப் பெறாய் என்று *","இரப்பன் உரப்பகில்லேன் *","பேய்ச்சி முலை உண்ட பின்னை * இப்","பிள்ளையைப் பேசுவது அஞ்சுவனே"],1,"/media/recitation/PT.10.7.8.mp3"],[1916,1916,["īṭum valiyum uṭaiya * in nampi","piṟanta ĕzhu tiṅkal̤il *","eṭu alar kaṇṇiyiṉāṉai val̤artti *","yamuṉai nīrāṭap poṉeṉ **","ceṭaṉ tiru maṟu mārvaṉ * kiṭantu","tiruvaṭiyāl * malaipol","oṭum cakaṭattaic cāṭiya piṉṉai *","urappuvatu añcuvaṉe-"],["ஈடும் வலியும் உடைய * இந் நம்பி","பிறந்த எழு திங்களில் *","ஏடு அலர் கண்ணியினானை வளர்த்தி *","யமுனை நீராடப் போனேன் **","சேடன் திரு மறு மார்வன் * கிடந்து","திருவடியால் * மலைபோல்","ஓடும் சகடத்தைச் சாடிய பின்னை *","உரப்புவது அஞ்சுவனே"],1,"/media/recitation/PT.10.7.9.mp3"],[1917,1917,["anjchuvan solli azhaiththiDa nanggaigAL! *","Ayira nAzhi neyyai *","panjchiya mellaDip piLLaigaL uNginRu *","pAganthAn vaiyArgaLE **","kanjchan kaDiyan kaRaveTTu nALil *","en kaivalaththu Adhum illai *","nenjchaththu iruppana seydhu vaiththAy nambI! *","en seygEn? en seygEnO?"],["அஞ்சுவன் சொல்லி அழைத்திட நங்கைகாள்! *","ஆயிர நாழி நெய்யை *","பஞ்சிய மெல்லடிப் பிள்ளைகள் உண்கின்று *","பாகந்தான் வையார்களே **","கஞ்சன் கடியன் கறவெட்டு நாளில் *","என் கைவலத்து ஆதும் இல்லை *","நெஞ்சத்து இருப்பன செய்து வைத்தாய் நம்பீ! *","என் செய்கேன்? என் செய்கேனோ?"],0,"/media/recitation/PT.10.7.10.mp3"],[1918,1918,["aṅṅaṉam tīmaikal̤ cĕyvarkal̤o-","nampī * āyar maṭa makkal̤ai? *","paṅkaya nīr kuṭaintu āṭukiṉṟārkal̤ *","piṉṉe cĕṉṟu ŏl̤ittiruntu **","aṅku avar pūn tukil vārikkŏṇṭiṭṭu *","aravu er iṭaiyār irappa *","maṅkai nallīr vantu kŏṇmiṉ ĕṉṟu *","maram eṟi iruntāy polum-"],["அங்ஙனம் தீமைகள் செய்வர்களோ","நம்பீ * ஆயர் மட மக்களை? *","பங்கய நீர் குடைந்து ஆடுகின்றார்கள் *","பின்னே சென்று ஒளித்திருந்து **","அங்கு அவர் பூந் துகில் வாரிக்கொண்டிட்டு *","அரவு ஏர் இடையார் இரப்ப *","மங்கை நல்லீர் வந்து கொண்மின் என்று *","மரம் ஏறி இருந்தாய் போலும்"],1,"/media/recitation/PT.10.7.11.mp3"],[1919,1919,["achcham thinaiththanai illai ippiLLaikku *","ANmaiyum sEvagamum *","uchchiyil muththi vaLarththu eDuththEnukku *","uraiththilan thAn inRu pOy **","pachchilaip pUnggaDambERi * visai koNDu","pAyndhu pukku * Ayira vAy","nachchu azhal poygaiyil nAgaththinODu *","piNanggi nI vandhAy pOlum"],["அச்சம் தினைத்தனை இல்லை இப்பிள்ளைக்கு *","ஆண்மையும் சேவகமும் *","உச்சியில் முத்தி வளர்த்து எடுத்தேனுக்கு *","உரைத்திலன் தான் இன்று போய் **","பச்சிலைப் பூங்கடம்பேறி * விசை கொண்டு","பாய்ந்து புக்கு * ஆயிர வாய்","நச்சு அழல் பொய்கையில் நாகத்தினோடு *","பிணங்கி நீ வந்தாய் போலும்"],0,"/media/recitation/PT.10.7.12.mp3"],[1920,1920,["tham param allana ANmaigaLaith * thaniyE","ninRu thAm seyvArO? *","emperumAn! unnaip peRRa vayiRuDaiyEn *","ini yAn en seygEn? **","ambaram Ezhum adhirum iDikural *","angkanal sengkaN uDai *","vambavizh kAnaththu mAl viDaiyODu *","piNanggi nI vandhAy pOlum"],["தம் பரம் அல்லன ஆண்மைகளைத் * தனியே","நின்று தாம் செய்வாரோ? *","எம்பெருமான்! உன்னைப் பெற்ற வயிறுடையேன் *","இனி யான் என் செய்கேன்? **","அம்பரம் ஏழும் அதிரும் இடிகுரல் *","அங்கனல் செங்கண் உடை *","வம்பவிழ் கானத்து மால் விடையோடு *","பிணங்கி நீ வந்தாய் போலும்"],0,"/media/recitation/PT.10.7.13.mp3"],[1921,1921,["** anna naDai maDavAychchi vayiRaDiththu","anjcha * aruvarai pOl *","mannu karungkaLiRRu Aruyir vavviya *","maindhanai mAkaDal sUzh **","kanni nanmAmadhiL manggaiyar kAvalan *","kAmaru sIrk kalikanRi *","innisai mAlaigaL IrEzhum vallavarkku *","Edhum iDar illaiyE"],["** அன்ன நடை மடவாய்ச்சி வயிறடித்து","அஞ்ச * அருவரை போல் *","மன்னு கருங்களிற்று ஆருயிர் வவ்விய *","மைந்தனை மாகடல் சூழ் **","கன்னி நன்மாமதிள் மங்கையர் காவலன் *","காமரு சீர்க் கலிகன்றி *","இன்னிசை மாலைகள் ஈரேழும் வல்லவர்க்கு *","ஏதும் இடர் இல்லையே"],0,"/media/recitation/PT.10.7.14.mp3"]],[[1922,1922,["kātil kaṭippu iṭṭuk * kaliṅkam uṭuttu *","tātu nalla * taṇ am tuzhāykŏṭu aṇintu **","potu maṟuttup * puṟame vantu niṉṟīr *","etukku? itu ĕṉ? * itu ĕṉ? itu ĕṉṉo?-"],["காதில் கடிப்பு இட்டுக் * கலிங்கம் உடுத்து *","தாது நல்ல * தண் அம் துழாய்கொடு அணிந்து **","போது மறுத்துப் * புறமே வந்து நின்றீர் *","ஏதுக்கு? இது என்? * இது என்? இது என்னோ?"],1,"/media/recitation/PT.10.8.1.mp3"],[1923,1923,["thuvar ADai uDuththu * oru seNDu siluppi *","kavar Aga muDiththuk * kalik kachchuk kaTTi **","suvar Ar kadhavin puRamE * vandhu ninRIr *","ivar Ar idhuven? * idhuven? idhuvennO?"],["துவர் ஆடை உடுத்து * ஒரு செண்டு சிலுப்பி *","கவர் ஆக முடித்துக் * கலிக் கச்சுக் கட்டி **","சுவர் ஆர் கதவின் புறமே * வந்து நின்றீர் *","இவர் ஆர் இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.2.mp3"],[1924,1924,["karuLak koDi onRuDaiyIr! * thanip pAgIr *","uruLach sagaDam adhu * uRakkil nimirththIr **","maruLaik koDu pADi vandhu * illam pugundhIr *","iruLaththu idhuven? * idhuven? idhuvennO?"],["கருளக் கொடி ஒன்றுடையீர்! * தனிப் பாகீர் *","உருளச் சகடம் அது * உறக்கில் நிமிர்த்தீர் **","மருளைக் கொடு பாடி வந்து * இல்லம் புகுந்தீர் *","இருளத்து இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.3.mp3"],[1925,1925,["nāmam palavum uṭai * nāraṇa nampī *","tāmat tul̤avam * mika nāṟiṭukiṉṟīr **","kāmaṉ ĕṉap pāṭi vantu * illam pukuntīr *","emattu-itu ĕṉ? * itu ĕṉ? itu ĕṉṉo?-"],["நாமம் பலவும் உடை * நாரண நம்பீ *","தாமத் துளவம் * மிக நாறிடுகின்றீர் **","காமன் எனப் பாடி வந்து * இல்லம் புகுந்தீர் *","ஏமத்து இது என்? * இது என்? இது என்னோ?"],1,"/media/recitation/PT.10.8.4.mp3"],[1926,1926,["suRRum kuzhal thAzhach * surigai aNaiththu *","maRRum pala * mAmaNi pon koDaNindhu **","muRRam pugundhu * muRuval seydhu ninRIr *","eRRukku idhuven? * idhuven? idhuvennO?"],["சுற்றும் குழல் தாழச் * சுரிகை அணைத்து *","மற்றும் பல * மாமணி பொன் கொடணிந்து **","முற்றம் புகுந்து * முறுவல் செய்து நின்றீர் *","எற்றுக்கு இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.5.mp3"],[1927,1927,["An Ayarum * Aniraiyum anggozhiya *","kUn AyadhOr * koRRa vil onRu kai Endhi **","pOnAr irundhAraiyum * pArththup pugudhIr *","EnOrgaL mun en? * idhuven? idhuvennO?"],["ஆன் ஆயரும் * ஆநிரையும் அங்கொழிய *","கூன் ஆயதோர் * கொற்ற வில் ஒன்று கை ஏந்தி **","போனார் இருந்தாரையும் * பார்த்துப் புகுதீர் *","ஏனோர்கள் முன் என்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.6.mp3"],[1928,1928,["mallE porudha thiraL thOl * maNavALIr! *","allE aRindhOm * num manaththin karuththai **","sollAdhu ozhiyIr * sonna pOdhinAl vArIr *","ellE! idhuven? * idhuven? idhuvennO?"],["மல்லே பொருத திரள் தோல் * மணவாளீர்! *","அல்லே அறிந்தோம் * நும் மனத்தின் கருத்தை **","சொல்லாது ஒழியீர் * சொன்ன போதினால் வாரீர் *","எல்லே! இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.7.mp3"],[1929,1929,["pukku ADaravam * piDiththATTum punidhIr! *","ikkAlanggaL * yAm umakku EdhonRum allOm **","thakkAr palar * dhEvimAr sAla uDaiyIr *","ekkE! idhuven? * idhuven? idhuvennO?"],["புக்கு ஆடரவம் * பிடித்தாட்டும் புனிதீர்! *","இக்காலங்கள் * யாம் உமக்கு ஏதொன்றும் அல்லோம் **","தக்கார் பலர் * தேவிமார் சால உடையீர் *","எக்கே! இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.8.mp3"],[1930,1930,["ADi asaindhu * Ay maDavAroDu nI pOy *","kUDik kuravai piNai * kOmaLap piLLAy! **","thEDith thirumAmagaL * maNmagaL niRpa *","EDi! idhuven? * idhuven? idhuvennO?"],["ஆடி அசைந்து * ஆய் மடவாரொடு நீ போய் *","கூடிக் குரவை பிணை * கோமளப் பிள்ளாய்! **","தேடித் திருமாமகள் * மண்மகள் நிற்ப *","ஏடி! இதுவென்? * இதுவென்? இதுவென்னோ?"],0,"/media/recitation/PT.10.8.9.mp3"],[1931,1931,["** allik kamalak kaNNanai * anggOr Aychchi *","ellip pozhuthu UDiya * UDal thiRaththai **","kallin mali thOL * kaliyan sonna mAlai *","sollith thudhippAr avar * thukkam ilarE"],["** அல்லிக் கமலக் கண்ணனை * அங்கோர் ஆய்ச்சி *","எல்லிப் பொழுது ஊடிய * ஊடல் திறத்தை **","கல்லின் மலி தோள் * கலியன் சொன்ன மாலை *","சொல்லித் துதிப்பார் அவர் * துக்கம் இலரே"],0,"/media/recitation/PT.10.8.10.mp3"]],[[1932,1932,["** puL uruvAgi naL iruL vandha *","pUdhanai mALa * ilanggai","oL eri maNDi uNNap paNiththa *","Ukkam adhanai ninaindhO? **","kaL avizh kOdhai kAdhalum * enggaL","kArigai mAdhar karuththum *","piLLai than kaiyil kiNNamE okkap *","pEsuvadhu endhai pirAnE!"],["** புள் உருவாகி நள் இருள் வந்த *","பூதனை மாள * இலங்கை","ஒள் எரி மண்டி உண்ணப் பணித்த *","ஊக்கம் அதனை நினைந்தோ? **","கள் அவிழ் கோதை காதலும் * எங்கள்","காரிகை மாதர் கருத்தும் *","பிள்ளை தன் கையில் கிண்ணமே ஒக்கப் *","பேசுவது எந்தை பிரானே!"],0,"/media/recitation/PT.10.9.1.mp3"],[1933,1933,["manRil malindhu kUththuvandhADi *","mAl viDai Ezhum aDarththu * Ayar","anRu naDungga Anirai kAththa *","ANmai kolO? aRiyEn nAn **","ninRa pirAnE! nILkaDal vaNNA! *","nI ivaL thannai nin kOyil *","munRil ezhundha murunggaiyil thEnA *","mun kaivaLai kavarndhAyE"],["மன்றில் மலிந்து கூத்துவந்தாடி *","மால் விடை ஏழும் அடர்த்து * ஆயர்","அன்று நடுங்க ஆநிரை காத்த *","ஆண்மை கொலோ? அறியேன் நான் **","நின்ற பிரானே! நீள்கடல் வண்ணா! *","நீ இவள் தன்னை நின் கோயில் *","முன்றில் எழுந்த முருங்கையில் தேனா *","முன் கைவளை கவர்ந்தாயே"],0,"/media/recitation/PT.10.9.2.mp3"],[1934,1934,["Ar mali Azhi sanggoDu paRRi *","ARRalai ARRal miguththuk *","kAr mugil vaNNA! kanjchanai munnam *","kaDandha nin kaDunthiRal thAnO? **","nEr izhai mAdhai niththilath thoththai *","neDungkaDal amudhu anaiyALai *","Ar ezhil vaNNA! angkaiyil vaTTAm *","ivaL enak karudhuginRAyE"],["ஆர் மலி ஆழி சங்கொடு பற்றி *","ஆற்றலை ஆற்றல் மிகுத்துக் *","கார் முகில் வண்ணா! கஞ்சனை முன்னம் *","கடந்த நின் கடுந்திறல் தானோ? **","நேர் இழை மாதை நித்திலத் தொத்தை *","நெடுங்கடல் அமுது அனையாளை *","ஆர் எழில் வண்ணா! அங்கையில் வட்டாம் *","இவள் எனக் கருதுகின்றாயே"],0,"/media/recitation/PT.10.9.3.mp3"],[1935,1935,["malgiya thOLum mAn uri adhaLum *","uDaiyavar thamakkum Or pAgam *","nalgiya nalamO? naraganaith tholaiththa *","karathalaththu amaidhiyin karuththO? **","alli angkOdhai aNi niRam koNDu","vandhu * munnE ninRu pOgAy *","solli en? nambI! ivaLai nI unggaL *","thoNDar kaith thaNDu enRavARE"],["மல்கிய தோளும் மான் உரி அதளும் *","உடையவர் தமக்கும் ஓர் பாகம் *","நல்கிய நலமோ? நரகனைத் தொலைத்த *","கரதலத்து அமைதியின் கருத்தோ? **","அல்லி அங்கோதை அணி நிறம் கொண்டு","வந்து * முன்னே நின்று போகாய் *","சொல்லி என்? நம்பீ! இவளை நீ உங்கள் *","தொண்டர் கைத் தண்டு என்றவாறே"],0,"/media/recitation/PT.10.9.4.mp3"],[1936,1936,["seru azhiyAdha mannargaL mALath *","thEr valangkoNDu avar sellum *","aru vazhi vAnam adharpaDak kaNDa *","ANmai kolO? aRiyEn nAn **","thirumozhi enggaL thEmalark kOdhai *","sIrmaiyai ninaindhilai andhO! *","peru vazhi nAvaRkaniyinum eLiyaL *","ivaL enap pEsuginRAyE"],["செரு அழியாத மன்னர்கள் மாளத் *","தேர் வலங்கொண்டு அவர் செல்லும் *","அரு வழி வானம் அதர்படக் கண்ட *","ஆண்மை கொலோ? அறியேன் நான் **","திருமொழி எங்கள் தேமலர்க் கோதை *","சீர்மையை நினைந்திலை அந்தோ! *","பெரு வழி நாவற்கனியினும் எளியள் *","இவள் எனப் பேசுகின்றாயே"],0,"/media/recitation/PT.10.9.5.mp3"],[1937,1937,["arakkiyar Agam pullena villAl *","aNi madhiL ilanggaiyAr kOnai *","serukkazhiththu amarar paNiya mun ninRa *","sEvagamO? seydhadhu inRu **","murukkidhazh vAychchi mun kai veNsanggam","koNDu * munnE ninRu pOgAy *","erukkilaikkAga eRi mazhu Ochchal *","en seyvadhu? endhai pirAnE!"],["அரக்கியர் ஆகம் புல்லென வில்லால் *","அணி மதிள் இலங்கையார் கோனை *","செருக்கழித்து அமரர் பணிய முன் நின்ற *","சேவகமோ? செய்தது இன்று **","முருக்கிதழ் வாய்ச்சி முன் கை வெண்சங்கம்","கொண்டு * முன்னே நின்று போகாய் *","எருக்கிலைக்காக எறி மழு ஓச்சல் *","என் செய்வது? எந்தை பிரானே!"],0,"/media/recitation/PT.10.9.6.mp3"],[1938,1938,["Azhi anthiNthEr arasar vandhu iRainjcha *","alaikaDal ulagam mun ANDa *","pAzhi anthOL Or Ayiram vIzhap *","paDai mazhup paRRiya valiyO? **","mAzhai mennOkki maNi niRam koNDu","vandhu * munnE ninRu pOgAy *","kOzhi veNmuTTaikku en seyvadhu? endhAy! *","kuRunthaDi neDunggaDal vaNNA!"],["ஆழி அந்திண்தேர் அரசர் வந்து இறைஞ்ச *","அலைகடல் உலகம் முன் ஆண்ட *","பாழி அந்தோள் ஓர் ஆயிரம் வீழப் *","படை மழுப் பற்றிய வலியோ? **","மாழை மென்னோக்கி மணி நிறம் கொண்டு","வந்து * முன்னே நின்று போகாய் *","கோழி வெண்முட்டைக்கு என் செய்வது? எந்தாய்! *","குறுந்தடி நெடுங்கடல் வண்ணா!"],0,"/media/recitation/PT.10.9.7.mp3"],[1939,1939,["porundhalan Agam puL uvandhu ERa *","vaL ugirAl piLandhu * anRu","perunthagaikku iranggi vAliyai munindha *","perumai kolO? seydhadhu inRu **","perunthaDangkaNNi surumbuRu kOdhai *","perumaiyai ninaindhilai pEsil *","karungkaDal vaNNA! kavuL koNDa nIrAm *","ivaL enak karudhuginRAyE"],["பொருந்தலன் ஆகம் புள் உவந்து ஏற *","வள் உகிரால் பிளந்து * அன்று","பெருந்தகைக்கு இரங்கி வாலியை முனிந்த *","பெருமை கொலோ? செய்தது இன்று **","பெருந்தடங்கண்ணி சுரும்புறு கோதை *","பெருமையை நினைந்திலை பேசில் *","கருங்கடல் வண்ணா! கவுள் கொண்ட நீராம் *","இவள் எனக் கருதுகின்றாயே"],0,"/media/recitation/PT.10.9.8.mp3"],[1940,1940,["nIr azhal vAnAy neDunilam kAlAy *","ninRa nin nIrmaiyai ninaindhO? *","sIr kezhu kOdhai ennaladhu ilaL enRu *","annadhOr thERRanmai thAnO? **","pAr kezhu pavvaththu Aramudhanaiya *","pAvaiyaip pAvam seydhEnukku *","Ar azhal Ombum andhaNan thOTTamAga *","nin manaththu vaiththAyE"],["நீர் அழல் வானாய் நெடுநிலம் காலாய் *","நின்ற நின் நீர்மையை நினைந்தோ? *","சீர் கெழு கோதை என்னலது இலள் என்று *","அன்னதோர் தேற்றன்மை தானோ? **","பார் கெழு பவ்வத்து ஆரமுதனைய *","பாவையைப் பாவம் செய்தேனுக்கு *","ஆர் அழல் ஓம்பும் அந்தணன் தோட்டமாக *","நின் மனத்து வைத்தாயே"],0,"/media/recitation/PT.10.9.9.mp3"],[1941,1941,["** vETTaththaik karudhAdhu aDi iNai vaNanggi *","meymmai ninRu emperumAnai *","vAL thiRal thAnai manggaiyar thalaivan *","mAnavEl kaliyan vAy oligaL **","thOTTalar painthArch suDar muDiyAnaip *","pazhamozhiyAl paNindhu uraiththa *","pATTivai pADap paththimai perugich *","siththamum thiruvoDu migumE"],["** வேட்டத்தைக் கருதாது அடி இணை வணங்கி *","மெய்ம்மை நின்று எம்பெருமானை *","வாள் திறல் தானை மங்கையர் தலைவன் *","மானவேல் கலியன் வாய் ஒலிகள் **","தோட்டலர் பைந்தார்ச் சுடர் முடியானைப் *","பழமொழியால் பணிந்து உரைத்த *","பாட்டிவை பாடப் பத்திமை பெருகிச் *","சித்தமும் திருவொடு மிகுமே"],0,"/media/recitation/PT.10.9.10.mp3"]],[[1942,1942,["** thiruththAy sempOththE! *","thirumAmagaL than kaNavan **","maruth thAr thol pugazh * mAdhavanai vara *","thiruththAy sempOththE!"],["** திருத்தாய் செம்போத்தே! *","திருமாமகள் தன் கணவன் **","மருத் தார் தொல் புகழ் * மாதவனை வர *","திருத்தாய் செம்போத்தே!"],0,"/media/recitation/PT.10.10.1.mp3"],[1943,1943,["karaiyAy kAkkaip piLLAy! *","karu mAmugil pOl niRaththan **","urai Ar thol pugazh * uththamanai vara *","karaiyAy kAkkaip piLLAy!"],["கரையாய் காக்கைப் பிள்ளாய்! *","கரு மாமுகில் போல் நிறத்தன் **","உரை ஆர் தொல் புகழ் * உத்தமனை வர *","கரையாய் * காக்கைப் பிள்ளாய்!"],0,"/media/recitation/PT.10.10.2.mp3"],[1944,1944,["kUvAy pUngkuyilE! *","kuLir mAri thaDuththugandha **","mAvAy kINDa * maNivaNNanai vara *","kUvAy pUngkuyilE!"],["கூவாய் பூங்குயிலே! *","குளிர் மாரி தடுத்துகந்த **","மாவாய் கீண்ட மணிவண்ணனை வர *","கூவாய் பூங்குயிலே!"],0,"/media/recitation/PT.10.10.3.mp3"],[1945,1945,["koTTAy pallik kuTTi! *","kuDam ADi ulagaLandha **","maTTAr pUngguzhal * mAdhavanai vara *","koTTAy pallik kuTTi!"],["கொட்டாய் பல்லிக் குட்டி! *","குடம் ஆடி உலகளந்த **","மட்டார் பூங்குழல் * மாதவனை வர *","கொட்டாய் பல்லிக் குட்டி!"],0,"/media/recitation/PT.10.10.4.mp3"],[1946,1946,["** sollAy paingkiLiyE! *","suDar Azhi valan uyarththa **","mallAr thOL * vaDa vEngkaDavanai vara *","sollAy * paingkiLiyE!"],["** சொல்லாய் பைங்கிளியே! *","சுடர் ஆழி வலன் உயர்த்த **","மல்லார் தோள் * வட வேங்கடவனை வர *","சொல்லாய் பைங்கிளியே!"],0,"/media/recitation/PT.10.10.5.mp3"],[1947,1947,["kOzhi kUvennum Al *","thOzhi! nAn en seygEn? **","Azhi vaNNar * varum pozhudhu AyiRRu *","kOzhi kU ennum Al"],["கோழி கூவென்னும் ஆல் *","தோழி! நான் என் செய்கேன்? **","ஆழி வண்ணர் * வரும் பொழுது ஆயிற்று *","கோழி கூவென்னும் ஆல்"],0,"/media/recitation/PT.10.10.6.mp3"],[1948,1948,["kAmaRku en kaDavEn? *","karu mAmugil vaNNaRku allAl **","pU mEl aingkaNai kOththup * pugundhu eyya *","kAmaRku en kaDavEn?"],["காமற்கு என் கடவேன்? *","கரு மாமுகில் வண்ணற்கு அல்லால் **","பூ மேல் ஐங்கணை கோத்துப் * புகுந்து எய்ய *","காமற்கு என் கடவேன்?"],0,"/media/recitation/PT.10.10.7.mp3"],[1949,1949,["** inggE pOdhungklolO? *","ina vEl neDunggaN kaLippa **","konggAr sOlaik * kuDandhaik kiDandha mAl *","inggE pOthungkolO?"],["** இங்கே போதுங்கொலோ? *","இன வேல் நெடுங்கண் களிப்ப **","கொங்கார் சோலைக் * குடந்தைக் கிடந்த மால் *","இங்கே போதுங்கொலோ?"],0,"/media/recitation/PT.10.10.8.mp3"],[1950,1950,["innAr enRu aRiyEn *","annE! AzhiyoDum **","ponnAr sArnggam * uDaiya aDigaLai *","innAr enRu aRiyEn"],["இன்னார் என்று அறியேன் *","அன்னே! ஆழியொடும் **","பொன்னார் சார்ங்கம் * உடைய அடிகளை *","இன்னார் என்று அறியேன்"],0,"/media/recitation/PT.10.10.9.mp3"],[1951,1951,["** thoNDIr! pADuminO *","surumbAr pozhil manggaiyar kOn **","oNthAr vEl * kaliyan oli mAlaigaL *","thoNDIr! pADuminO"],["** தொண்டீர்! பாடுமினோ *","சுரும்பார் பொழில் மங்கையர் கோன் **","ஒண்தார் வேல் * கலியன் ஒலி மாலைகள் *","தொண்டீர்! பாடுமினோ"],0,"/media/recitation/PT.10.10.10.mp3"]]]