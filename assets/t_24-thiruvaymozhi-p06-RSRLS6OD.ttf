[[[3343,3343,["** vaigal pUngkazhi vAy * vandhu mEyum kurugu inanggAL! *","sey koL sennel uyar * thiruvaNvaNDUr uRaiyum **","kai koL chakkaraththu * en kani vAy perumAnaik kaNDu *","kaigaL kUppich sollIr * vinaiyATTiyEn kAdhanmaiyE"],["** வைகல் பூங்கழி வாய் * வந்து மேயும் குருகு இனங்காள்! *","செய் கொள் செந்நெல் உயர் * திருவண்வண்டூர் உறையும் **","கை கொள் சக்கரத்து * என் கனி வாய் பெருமானைக் கண்டு *","கைகள் கூப்பிச் சொல்லீர் * வினையாட்டியேன் காதன்மையே"],0,"/media/recitation/TVM.6.1.1.mp3"],[3344,3344,["kAdhal men peDaiyODu * uDan mEyum karu nArAy! *","vEdha vELvi oli muzhanggum * thaN thiruvaNvaNDUr **","nAdhan njAlam ellAm uNDa * namperumAnaik kaNDu *","pAdham kai thozhudhu paNiyIr * aDiyEn thiRamE"],["காதல் மென் பெடையோடு * உடன் மேயும் கரு நாராய்! *","வேத வேள்வி ஒலி முழங்கும் * தண் திருவண்வண்டூர் **","நாதன் ஞாலம் எல்லாம் உண்ட * நம்பெருமானைக் கண்டு *","பாதம் கை தொழுது பணியீர் * அடியேன் திறமே"],0,"/media/recitation/TVM.6.1.2.mp3"],[3345,3345,["thiRanggaL Agi enggum * seygaLUDu uzhal puL inanggAL! *","siRandha selvam malgu * thiruvaNvaNDUr uRaiyum **","kaRanggu chakkarak kaik * kani vAyp perumAnaik kaNDu *","iRanggi nIr thozhudhu paNiyIr * aDiyEn iDarE"],["திறங்கள் ஆகி எங்கும் * செய்களூடு உழல் புள் இனங்காள்! *","சிறந்த செல்வம் மல்கு * திருவண்வண்டூர் உறையும் **","கறங்கு சக்கரக் கைக் * கனி வாய்ப் பெருமானைக் கண்டு *","இறங்கி நீர் தொழுது பணியீர் * அடியேன் இடரே"],0,"/media/recitation/TVM.6.1.3.mp3"],[3346,3346,["iDaril bOgam mUzhgi * iNaindhADum maDa annanggAL! *","viDalil vEdha oli muzhanggum * thaN thiruvaNvaNDUr **","kaDalin mEnip pirAn * kaNNaNai neDumAlaik kaNDu *","uDalam naindhu oruththi * urugum enRu uNarththuminE"],["இடரில் போகம் மூழ்கி * இணைந்தாடும் மட அன்னங்காள்! *","விடலில் வேத ஒலி முழங்கும் * தண் திருவண்வண்டூர் **","கடலின் மேனிப் பிரான் * கண்ணணை நெடுமாலைக் கண்டு *","உடலம் நைந்து ஒருத்தி * உருகும் என்று உணர்த்துமினே"],0,"/media/recitation/TVM.6.1.4.mp3"],[3347,3347,["uNarththal UDal uNarndhu * uDan mEyum maDa annanggAL! *","thiNarththa vaNDalgaL mEl * sanggu sErum thiruvaNvaNDUr **","puNarththa pUnthaN thuzhAy muDi * nam perumAnaik kaNDu *","puNarththa kaiyinarAy * aDiyEnukkum pORRuminE"],["உணர்த்தல் ஊடல் உணர்ந்து * உடன் மேயும் மட அன்னங்காள்! *","திணர்த்த வண்டல்கள் மேல் * சங்கு சேரும் திருவண்வண்டூர் **","புணர்த்த பூந்தண் துழாய் முடி * நம் பெருமானைக் கண்டு *","புணர்த்த கையினராய் * அடியேனுக்கும் போற்றுமினே"],0,"/media/recitation/TVM.6.1.5.mp3"],[3348,3348,["pORRi yAn irandhEn * punnai mEl uRai pUngkuyilgAL! *","sERRil vALai thuLLum * thiruvaNvaNDUr uRaiyum **","ARRal Azhi angkai * amarar perumAnaik kaNDu *","mARRam koNDu aruLIr * maiyal thIrvadhu oru vaNNamE"],["போற்றி யான் இரந்தேன் * புன்னை மேல் உறை பூங்குயில்காள்! *","சேற்றில் வாளை துள்ளும் * திருவண்வண்டூர் உறையும் **","ஆற்றல் ஆழி அங்கை * அமரர் பெருமானைக் கண்டு *","மாற்றம் கொண்டு அருளீர் * மையல் தீர்வது ஒரு வண்ணமே"],0,"/media/recitation/TVM.6.1.6.mp3"],[3349,3349,["oru vaNNam senRu pukku * enakku onRu urai oNkiLiyE! *","seru oNpUmpozhil sUzh * sekkar vElaith thiruvaNvaNDUr **","karu vaNNam seyya vAy * seyya kaN seyya kai seyya kAl *","seru oNchakkaram sanggu * aDaiyALam thirundhak kaNDE"],["ஒரு வண்ணம் சென்று புக்கு * எனக்கு ஒன்று உரை ஒண்கிளியே! *","செரு ஒண்பூம்பொழில் சூழ் * செக்கர் வேலைத் திருவண்வண்டூர் **","கரு வண்ணம் செய்ய வாய் * செய்ய கண் செய்ய கை செய்ய கால் *","செரு ஒண்சக்கரம் சங்கு * அடையாளம் திருந்தக் கண்டே"],0,"/media/recitation/TVM.6.1.7.mp3"],[3350,3350,["thirundhak kaNDu enakku onRu uraiyAy * oNsiRu pUvAy! *","serundhi njAzhal magizh * punnai sUzh thaNthiruvaNvaNDUr **","perunthaN thAmaraik kaN * peru nIL muDi nAl thaDanthOL *","karunthiN mA mugil pOl * thiru mEni aDigaLaiyE"],["திருந்தக் கண்டு எனக்கு ஒன்று உரையாய் * ஒண்சிறு பூவாய்! *","செருந்தி ஞாழல் மகிழ் * புன்னை சூழ் தண்திருவண்வண்டூர் **","பெருந்தண் தாமரைக் கண் * பெரு நீள் முடி நால் தடந்தோள் *","கருந்திண் மா முகில் போல் * திரு மேனி அடிகளையே"],0,"/media/recitation/TVM.6.1.8.mp3"],[3351,3351,["aDigaL kai thozhudhu * alar mEl asaiyum annanggAL! *","viDivai sanggu olikkum * thiruvaNvaNDUr uRaiyum **","kaDiya mAyan thannaik * kaNNanai neDumAlaik kaNDu *","koDiya valvinaiyEn * thiRam kURumin vERu koNDE"],["அடிகள் கை தொழுது * அலர் மேல் அசையும் அன்னங்காள்! *","விடிவை சங்கு ஒலிக்கும் * திருவண்வண்டூர் உறையும் **","கடிய மாயன் தன்னைக் * கண்ணனை நெடுமாலைக் கண்டு *","கொடிய வல்வினையேன் * திறம் கூறுமின் வேறு கொண்டே"],0,"/media/recitation/TVM.6.1.9.mp3"],[3352,3352,["vERu koNDu ummai yAn irandhEn * veRi vaNDu inanggAL! *","thERu nIrp pambai * vaDapAlaith thiruvaNvaNDUr **","mARil pOr arakkan * madhiL nIRezhach seRRu ugandha *","ERu sEvaganArkku * ennaiyum uLaL enmingaLE"],["வேறு கொண்டு உம்மை யான் இரந்தேன் * வெறி வண்டு இனங்காள்! *","தேறு நீர்ப் பம்பை * வடபாலைத் திருவண்வண்டூர் **","மாறில் போர் அரக்கன் * மதிள் நீறெழச் செற்று உகந்த *","ஏறு சேவகனார்க்கு * என்னையும் உளள் என்மின்களே"],0,"/media/recitation/TVM.6.1.10.mp3"],[3353,3353,["** minkoL sEr purinUl kuRaLAy * agal njAlam koNDa *","vankaLvan aDi mEl * kurugUrch saDakOpan sonna **","paNkoL AyiraththuL ivai paththum * thiruvaNvaNDUrkku *","inkoL pADal vallAr * madhanar min iDaiyavarkkE"],["** மின்கொள் சேர் புரிநூல் குறளாய் * அகல் ஞாலம் கொண்ட *","வன்கள்வன் அடி மேல் * குருகூர்ச் சடகோபன் சொன்ன **","பண்கொள் ஆயிரத்துள் இவை பத்தும் * திருவண்வண்டூர்க்கு *","இன்கொள் பாடல் வல்லார் * மதனர் மின் இடையவர்க்கே"],0,"/media/recitation/TVM.6.1.11.mp3"]],[[3354,3354,["** minniDai maDavArgaL ninnaruL sUDuvAr * munbu nAn adhanjchuvan *","mannuDai ilanggai * araN kAyndha mAyavanE! **","unnuDaiya suNDAyam nAn aRivan * ini adhu koNDu seyvadhu en? *","ennuDaiya pandhum kazhalum * thandhu pOgu nambI!"],["** மின்னிடை மடவார்கள் நின்னருள் சூடுவார் * முன்பு நான் அதஞ்சுவன் *","மன்னுடை இலங்கை * அரண் காய்ந்த மாயவனே! **","உன்னுடைய சுண்டாயம் நான் அறிவன் * இனி அது கொண்டு செய்வது என்? *","என்னுடைய பந்தும் கழலும் * தந்து போகு நம்பீ!"],0,"/media/recitation/TVM.6.2.1.mp3"],[3355,3355,["pOgu nambI! un thAmarai purai kaNNiNaiyum * sevvAy muRuvalum *","AkulanggaL seyya * azhidhaRkE nORROmE yAm? **","thOgai mA mayilArgaL ninnaruL sUDuvAr * sevi Osai vaiththu ezha *","AgaL pOga viTTuk * kuzhal Udhu pOy irundhE"],["போகு நம்பீ! உன் தாமரை புரை கண்ணிணையும் * செவ்வாய் முறுவலும் *","ஆகுலங்கள் செய்ய * அழிதற்கே நோற்றோமே யாம்? **","தோகை மா மயிலார்கள் நின்னருள் சூடுவார் * செவி ஓசை வைத்து எழ *","ஆகள் போக விட்டுக் * குழல் ஊது போய் இருந்தே"],0,"/media/recitation/TVM.6.2.2.mp3"],[3356,3356,["pOy irundhu nin puLLuvam aRiyAdhavarkku * urai nambI! * nin seyya","vAy irungkaniyum kaNgaLum * viparIdham innAL **","vEy irunthaDanthOLinAr * iththiruvaruL peRuvAr yavar kol? *","mA irungkaDalaik kaDaindha * perumAnAlE"],["போய் இருந்து நின் புள்ளுவம் அறியாதவர்க்கு * உரை நம்பீ! * நின் செய்ய","வாய் இருங்கனியும் கண்களும் * விபரீதம் இந்நாள் **","வேய் இருந்தடந்தோளினார் * இத்திருவருள் பெறுவார் யவர் கொல்? *","மா இருங்கடலைக் கடைந்த * பெருமானாலே"],0,"/media/recitation/TVM.6.2.3.mp3"],[3357,3357,["Alin nIL ilai Ezhulagam uNDu * anRu nI kiDandhAy * un mAyanggaL","mElai vAnavarum aRiyAr * ini em paramE? **","vElinEr thaDangkaNNinAr * viLaiyADu sUzhalaich sUzhavE ninRu *","kAli mEykka vallAy! * emmai nI kazhaRElE"],["ஆலின் நீள் இலை ஏழுலகம் உண்டு * அன்று நீ கிடந்தாய் * உன் மாயங்கள்","மேலை வானவரும் அறியார் * இனி எம் பரமே? **","வேலினேர் தடங்கண்ணினார் * விளையாடு சூழலைச் சூழவே நின்று *","காலி மேய்க்க வல்லாய்! * எம்மை நீ கழறேலே"],0,"/media/recitation/TVM.6.2.4.mp3"],[3358,3358,["kazhaREl nambI! * un kaithavam maNNum viNNum nankaRiyum * thiN chakkara","nizhaRu thol paDaiyAy! * unakku onRu uNarththuvan nAn **","mazhaRu thEn mozhiyArgaL ninnaruL sUDuvAr * manam vADi niRka * em","kuzhaRu pUvaiyoDum * kiLiyODum kuzhagElE"],["கழறேல் நம்பீ! * உன் கைதவம் மண்ணும் விண்ணும் நன்கறியும் * திண் சக்கர","நிழறு தொல் படையாய்! * உனக்கு ஒன்று உணர்த்துவன் நான் **","மழறு தேன் மொழியார்கள் நின்னருள் சூடுவார் * மனம் வாடி நிற்க * எம்","குழறு பூவையொடும் * கிளியோடும் குழகேலே"],0,"/media/recitation/TVM.6.2.5.mp3"],[3359,3359,["kuzhagi enggaL kuzhamaNan koNDu * kOyinmai seydhu kanmam onRu illai *","pazhagi yAm iruppOm * paramE iththiruvaruLgaL? **","azhagiyAr ivvulagu mUnRukkum * thEvimai thaguvAr palar uLar *","kazhagam EREl nambI! * unakkum iLaidhE kanmamE"],["குழகி எங்கள் குழமணன் கொண்டு * கோயின்மை செய்து கன்மம் ஒன்று இல்லை *","பழகி யாம் இருப்போம் * பரமே இத்திருவருள்கள்? **","அழகியார் இவ்வுலகு மூன்றுக்கும் * தேவிமை தகுவார் பலர் உளர் *","கழகம் ஏறேல் நம்பீ! * உனக்கும் இளைதே கன்மமே"],0,"/media/recitation/TVM.6.2.6.mp3"],[3360,3360,["kanmam anRu enggaL kaiyil pAvai paRippadhu * kaDal njAlam uNDiTTa *","ninmalA! neDiyAy! * unakkElum pizhai pizhaiyE **","vanmamE solli emmai nI viLaiyADudhi * adhu kETkil en aimAr *","thanma pAvam ennAr * oru nAnRu thaDi piNakkE"],["கன்மம் அன்று எங்கள் கையில் பாவை பறிப்பது * கடல் ஞாலம் உண்டிட்ட *","நின்மலா! நெடியாய்! * உனக்கேலும் பிழை பிழையே **","வன்மமே சொல்லி எம்மை நீ விளையாடுதி * அது கேட்கில் என் ஐமார் *","தன்ம பாவம் என்னார் * ஒரு நான்று தடி பிணக்கே"],0,"/media/recitation/TVM.6.2.7.mp3"],[3361,3361,["piNakki yAvaiyum yAvarum * pizhaiyAmal pEdhiththum pEdhiyAdhadhOr *","kaNakkil kIrththi veLLak * kadhir njAna mUrththiyinAy! **","iNakki emmai em thOzhimAr * viLaiyADap pOdhumin ennap pOndhOmai *","uNakki nI vaLaiththAl * en sollAr ugavAdhavarE!"],["பிணக்கி யாவையும் யாவரும் * பிழையாமல் பேதித்தும் பேதியாததோர் *","கணக்கில் கீர்த்தி வெள்ளக் * கதிர் ஞான மூர்த்தியினாய்! **","இணக்கி எம்மை எம் தோழிமார் * விளையாடப் போதுமின் என்னப் போந்தோமை *","உணக்கி நீ வளைத்தால் * என் சொல்லார் உகவாதவரே!"],0,"/media/recitation/TVM.6.2.8.mp3"],[3362,3362,["ugavaiyAl nenjcham uLLurugi * un thAmaraith thaDangkaN vizhigaLin *","agavalaippaDuppAn * azhiththAy un thiruvaDiyAl **","thagavu seydhilai enggaL siRRilum * yAm aDu siRu sORum kaNDu * nin","muga oLi thigazha * muRuval seydhu ninRilaiyE"],["உகவையால் நெஞ்சம் உள்ளுருகி * உன் தாமரைத் தடங்கண் விழிகளின் *","அகவலைப்படுப்பான் * அழித்தாய் உன் திருவடியால் **","தகவு செய்திலை எங்கள் சிற்றிலும் * யாம் அடு சிறு சோறும் கண்டு * நின்","முக ஒளி திகழ * முறுவல் செய்து நின்றிலையே"],0,"/media/recitation/TVM.6.2.9.mp3"],[3363,3363,["ninRu ilanggu muDiyinAy! * irupaththOr kAl arasu kaLai kaTTa *","venRi nIL mazhuvA! * viyan njAlam mun paDaiththAy! **","inRu ivvAyar kulaththai vIDuyyath thOnRiya * karumANikkach suDar! *","nin thannAl nalivE paDuvOm * enRum AychchiyOmE"],["நின்று இலங்கு முடியினாய்! * இருபத்தோர் கால் அரசு களை கட்ட *","வென்றி நீள் மழுவா! * வியன் ஞாலம் முன் படைத்தாய்! **","இன்று இவ்வாயர் குலத்தை வீடுய்யத் தோன்றிய * கருமாணிக்கச் சுடர்! *","நின் தன்னால் நலிவே படுவோம் * என்றும் ஆய்ச்சியோமே"],0,"/media/recitation/TVM.6.2.10.mp3"],[3364,3364,["** Aychchi Agiya annaiyAl * anRu veNNey vArththaiyuL * sIRRamuNDu azhu","kUththa appan thannaik * kurugUrch saDakOpan **","Eththiya thamizh mAlai * AyiraththuL ivaiyum Or paththu isaiyoDum *","nAth thannAl navila uraippArkku * illai nalkuravE"],["** ஆய்ச்சி ஆகிய அன்னையால் * அன்று வெண்ணெய் வார்த்தையுள் * சீற்றமுண்டு அழு","கூத்த அப்பன் தன்னைக் * குருகூர்ச் சடகோபன் **","ஏத்திய தமிழ் மாலை * ஆயிரத்துள் இவையும் ஓர் பத்து இசையொடும் *","நாத் தன்னால் நவில உரைப்பார்க்கு * இல்லை நல்குரவே"],0,"/media/recitation/TVM.6.2.11.mp3"]],[[3365,3365,["** nalkuravum selvum * naragum suvarkkamumAy *","vel pagaiyum naTpum * viDamum amudhamumAy **","pal vagaiyum parandha * perumAn ennai ALvAnai *","selvam malgu kuDith * thiruviNNagark kaNDEnE"],["** நல்குரவும் செல்வும் * நரகும் சுவர்க்கமுமாய் *","வெல் பகையும் நட்பும் * விடமும் அமுதமுமாய் **","பல் வகையும் பரந்த * பெருமான் என்னை ஆள்வானை *","செல்வம் மல்கு குடித் * திருவிண்ணகர்க் கண்டேனே"],0,"/media/recitation/TVM.6.3.1.mp3"],[3366,3366,["kaNDa inbam thunbam * kalakkanggaLum thERRamumAy *","thaNDamum thaNmaiyum * thazhalum nizhalumAy **","kaNDu kODaRku ariya * perumAn ennai ALvAn Ur *","theNthiraip punal sUzh * thiruviNNagar nannagarE"],["கண்ட இன்பம் துன்பம் * கலக்கங்களும் தேற்றமுமாய் *","தண்டமும் தண்மையும் * தழலும் நிழலுமாய் **","கண்டு கோடற்கு அரிய * பெருமான் என்னை ஆள்வான் ஊர் *","தெண்திரைப் புனல் சூழ் * திருவிண்ணகர் நன்னகரே"],0,"/media/recitation/TVM.6.3.2.mp3"],[3367,3367,["nagaramum nADugaLum * njAnamum mUDamumAy *","nigaril sUzh suDarAy iruLAy * nilanAy visumbAy **","sigara mADanggaL sUzh * thiruviNNagarch chErndha pirAn *","pugar koL kIrththi allAl illai * yAvarkkum puNNiyamE"],["நகரமும் நாடுகளும் * ஞானமும் மூடமுமாய் *","நிகரில் சூழ் சுடராய் இருளாய் * நிலனாய் விசும்பாய் **","சிகர மாடங்கள் சூழ் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","புகர் கொள் கீர்த்தி அல்லால் இல்லை * யாவர்க்கும் புண்ணியமே"],0,"/media/recitation/TVM.6.3.3.mp3"],[3368,3368,["puNNiyam pAvam * puNarchchi pirivu enRa ivaiyAy *","eNNamAy maRappAy * uNmaiyAy inmaiyAy allanAy **","thiNNa mADanggaL sUzh * thiruviNNagarch chErndha pirAn *","kaNNan innaruLE * kaNDu koNmingaL kaithavamE"],["புண்ணியம் பாவம் * புணர்ச்சி பிரிவு என்ற இவையாய் *","எண்ணமாய் மறப்பாய் * உண்மையாய் இன்மையாய் அல்லனாய் **","திண்ண மாடங்கள் சூழ் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","கண்ணன் இன்னருளே * கண்டு கொண்மின்கள் கைதவமே"],0,"/media/recitation/TVM.6.3.4.mp3"],[3369,3369,["kaithavam semmai * karumai veLumaiyumAy *","mey poy iLamai mudhumai * pudhumai pazhamaiyumAy **","seyya thiNmadhiL sUzh * thiruviNNagarch chErndha pirAn *","peydha kAvu kaNDIr * perundhEvu uDai mUvulagE"],["கைதவம் செம்மை * கருமை வெளுமையுமாய் *","மெய் பொய் இளமை முதுமை * புதுமை பழமையுமாய் **","செய்ய திண்மதிள் சூழ் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","பெய்த காவு கண்டீர் * பெருந்தேவு உடை மூவுலகே"],0,"/media/recitation/TVM.6.3.5.mp3"],[3370,3370,["mUvulaganggaLumAy allanAy * ugappAy munivAy *","pUvil vAzh magaLAyth * thavvaiyAyp pugazhAyp pazhiyAy **","dhEvar mEvith thozhum * thiruviNNagarch chErndha pirAn *","pAviyEn manaththE * uRaiginRa paranjchuDarE"],["மூவுலகங்களுமாய் அல்லனாய் * உகப்பாய் முனிவாய் *","பூவில் வாழ் மகளாய்த் * தவ்வையாய்ப் புகழாய்ப் பழியாய் **","தேவர் மேவித் தொழும் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","பாவியேன் மனத்தே * உறைகின்ற பரஞ்சுடரே"],0,"/media/recitation/TVM.6.3.6.mp3"],[3371,3371,["paranjchuDar uDambAy * azhukku padhiththa uDambAy *","karandhum thOnRiyum ninRum * kaithavanggaL seydhum ** viNNOr","siranggaLAl vaNanggum * thiruviNNagarch chErndha pirAn *","varangkoL pAdham allAl illai * yAvarkkum van saraNE"],["பரஞ்சுடர் உடம்பாய் * அழுக்கு பதித்த உடம்பாய் *","கரந்தும் தோன்றியும் நின்றும் * கைதவங்கள் செய்தும் ** விண்ணோர்","சிரங்களால் வணங்கும் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","வரங்கொள் பாதம் அல்லால் இல்லை * யாவர்க்கும் வன் சரணே"],0,"/media/recitation/TVM.6.3.7.mp3"],[3372,3372,["van saraN surarkkAy * asurarkku vengkURRamumAy *","than saraN nizhaR kIzh * ulagam vaiththum vaiyAdhum **","then saraN thisaikkuth * thiruviNNagarch chErndha pirAn *","en saraN en kaNNan * ennai ALuDai en appanE"],["வன் சரண் சுரர்க்காய் * அசுரர்க்கு வெங்கூற்றமுமாய் *","தன் சரண் நிழற் கீழ் * உலகம் வைத்தும் வையாதும் **","தென் சரண் திசைக்குத் * திருவிண்ணகர்ச் சேர்ந்த பிரான் *","என் சரண் என் கண்ணன் * என்னை ஆளுடை என் அப்பனே"],0,"/media/recitation/TVM.6.3.8.mp3"],[3373,3373,["en appan enakkAy iguLAy * ennaip peRRavaLAy *","pon appan maNiya ppan * muththappan en appanumAy **","minnap pon madhiL sUzh * thiruviNNagarch chErndha appan *","than oppAr illappan * thandhanan thana thAL nizhalE"],["என் அப்பன் எனக்காய் இகுளாய் * என்னைப் பெற்றவளாய் *","பொன் அப்பன் மணிய ப்பன் * முத்தப்பன் என் அப்பனுமாய் **","மின்னப் பொன் மதிள் சூழ் * திருவிண்ணகர்ச் சேர்ந்த அப்பன் *","தன் ஒப்பார் இல்லப்பன் * தந்தனன் தன தாள் நிழலே"],0,"/media/recitation/TVM.6.3.9.mp3"],[3374,3374,["nizhal veyyil siRumai perumai * kuRumai neDumaiyumAy *","suzhalvana niRpana * maRRumAy avai allanumAy **","mazhalai vAy vaNDu vAzh * thiruviNNagar mannu pirAn *","kazhalgaL anRi * maRROr kaLaikaN ilam kANmingaLE"],["நிழல் வெய்யில் சிறுமை பெருமை * குறுமை நெடுமையுமாய் *","சுழல்வன நிற்பன * மற்றுமாய் அவை அல்லனுமாய் **","மழலை வாய் வண்டு வாழ் * திருவிண்ணகர் மன்னு பிரான் *","கழல்கள் அன்றி * மற்றோர் களைகண் இலம் காண்மின்களே"],0,"/media/recitation/TVM.6.3.10.mp3"],[3375,3375,["** kANmingaL ulagIr! enRu * kaN mugappE nimirndha *","thAL iNaiyan thannaik * kurugUrch saDakOpan sonna **","ANai Ayiraththuth * thiruviNNagarp paththum vallAr *","kONai inRi viNNOrkku * enRum Avar kuravargaLE"],["** காண்மின்கள் உலகீர்! என்று * கண் முகப்பே நிமிர்ந்த *","தாள் இணையன் தன்னைக் * குருகூர்ச் சடகோபன் சொன்ன **","ஆணை ஆயிரத்துத் * திருவிண்ணகர்ப் பத்தும் வல்லார் *","கோணை இன்றி விண்ணோர்க்கு * என்றும் ஆவர் குரவர்களே"],0,"/media/recitation/TVM.6.3.11.mp3"]],[[3376,3376,["** kuravai AychchiyarODu kOththadhum * kunRam onRu Endhiyadhum *","uravu nIrp poygai nAgam kAyndhadhum * uTpaDa maRRum pala **","araviR paLLip pirAn than * mAya vinaigaLaiyE alaRRi *","iravum nanpagalum thavirgilam * enna kuRaivu namakkE?"],["** குரவை ஆய்ச்சியரோடு கோத்ததும் * குன்றம் ஒன்று ஏந்தியதும் *","உரவு நீர்ப் பொய்கை நாகம் காய்ந்ததும் * உட்பட மற்றும் பல **","அரவிற் பள்ளிப் பிரான் தன் * மாய வினைகளையே அலற்றி *","இரவும் நன்பகலும் தவிர்கிலம் * என்ன குறைவு நமக்கே?"],0,"/media/recitation/TVM.6.4.1.mp3"],[3377,3377,["kEyath thIngkuzhal UdhiRRum * nirai mEyththadhum keNDai oNkaN *","vAsap pUngkuzhal pinnai thOLgaL maNandhadhum * maRRum pala **","mAyak kOlap pirAn than * seygai ninaindhu manam kuzhaindhu *","nEyaththODu kazhindha pOdhu * enakku evvulagam nigarE?"],["கேயத் தீங்குழல் ஊதிற்றும் * நிரை மேய்த்ததும் கெண்டை ஒண்கண் *","வாசப் பூங்குழல் பின்னை தோள்கள் மணந்ததும் * மற்றும் பல **","மாயக் கோலப் பிரான் தன் * செய்கை நினைந்து மனம் குழைந்து *","நேயத்தோடு கழிந்த போது * எனக்கு எவ்வுலகம் நிகரே?"],0,"/media/recitation/TVM.6.4.2.mp3"],[3378,3378,["nigaril mallaraich seRRadhum * nirai mEyththadhum nIL neDungkai *","sigara mA kaLiRu aTTadhum * ivai pOlvanavum piRavum **","pugar koL sOdhip pirAn than * seygai ninaindhu pulambi * enRum","nugara vaigal vaigap peRREn * enakku en ini nOvadhuvE?"],["நிகரில் மல்லரைச் செற்றதும் * நிரை மேய்த்ததும் நீள் நெடுங்கை *","சிகர மா களிறு அட்டதும் * இவை போல்வனவும் பிறவும் **","புகர் கொள் சோதிப் பிரான் தன் * செய்கை நினைந்து புலம்பி * என்றும்","நுகர வைகல் வைகப் பெற்றேன் * எனக்கு என் இனி நோவதுவே?"],0,"/media/recitation/TVM.6.4.3.mp3"],[3379,3379,["nOva Aychchi uralODu Arkka * iranggiRRum vanjchap peNNai *","sAvap pAl uNDadhum * Ur sagaDam iRach sADiyadhum **","dhEvak kOlap pirAn than * seygai ninaindhu manam kuzhaindhu *","mEvak kAlanggaL kUDinEn * enakku en ini vENDuvadhE?"],["நோவ ஆய்ச்சி உரலோடு ஆர்க்க * இரங்கிற்றும் வஞ்சப் பெண்ணை *","சாவப் பால் உண்டதும் * ஊர் சகடம் இறச் சாடியதும் **","தேவக் கோலப் பிரான் தன் * செய்கை நினைந்து மனம் குழைந்து *","மேவக் காலங்கள் கூடினேன் * எனக்கு என் இனி வேண்டுவதே?"],0,"/media/recitation/TVM.6.4.4.mp3"],[3380,3380,["vENDith dhEvar irakka vandhu piRandhadhum * vInggiruL vAy","pUNDu * anRu annai pulambap pOy * anggOr Aykkulam pukkadhum **","kANDal inRi vaLarndhu * kanjchanaith thunjcha vanjcham seydhadhum *","INDu nAn alaRRap peRRen * enakku enna igal uLadhE?"],["வேண்டித் தேவர் இரக்க வந்து பிறந்ததும் * வீங்கிருள் வாய்","பூண்டு * அன்று அன்னை புலம்பப் போய் * அங்கோர் ஆய்க்குலம் புக்கதும் **","காண்டல் இன்றி வளர்ந்து * கஞ்சனைத் துஞ்ச வஞ்சம் செய்ததும் *","ஈண்டு நான் அலற்றப் பெற்றென் * எனக்கு என்ன இகல் உளதே?"],0,"/media/recitation/TVM.6.4.5.mp3"],[3381,3381,["igal koL puLLaip piLandhadhum * imil ERugaL seRRadhuvum *","uyar koL sOlaik kurundhu osiththadhum * uTpaDa maRRum pala **","agal koL vaiyam aLandha mAyan * en appan than mAyanggaLE *","pagal irAp paravap peRREn * enakku enna manap parippE?"],["இகல் கொள் புள்ளைப் பிளந்ததும் * இமில் ஏறுகள் செற்றதுவும் *","உயர் கொள் சோலைக் குருந்து ஒசித்ததும் * உட்பட மற்றும் பல **","அகல் கொள் வையம் அளந்த மாயன் * என் அப்பன் தன் மாயங்களே *","பகல் இராப் பரவப் பெற்றேன் * எனக்கு என்ன மனப் பரிப்பே?"],0,"/media/recitation/TVM.6.4.6.mp3"],[3382,3382,["manap parippODu * azhukku mAniDa sAdhiyil thAn piRandhu *","thanakku vENDu uruk koNDu * thAn thana sIRRaththinai muDikkum **","punath thuzhAy muDi mAlai mArban * en appan than mAyanggaLE *","ninaikkum nenjchu uDaiyEn * enakku ini yAr nigar nINilaththE?"],["மனப் பரிப்போடு * அழுக்கு மானிட சாதியில் தான் பிறந்து *","தனக்கு வேண்டு உருக் கொண்டு * தான் தன சீற்றத்தினை முடிக்கும் **","புனத் துழாய் முடி மாலை மார்பன் * என் அப்பன் தன் மாயங்களே *","நினைக்கும் நெஞ்சு உடையேன் * எனக்கு இனி யார் நிகர் நீணிலத்தே?"],0,"/media/recitation/TVM.6.4.7.mp3"],[3383,3383,["nINilaththoDu vAn viyappa * niRai perum pOrgaL seydhu *","vANan Ayiram thOL thuNiththadhum * uTpaDa maRRum pala **","mANiyAy nilam koNDa mAyan * en appan than mAyanggaLE *","kANum nenjchu uDaiyEn * enakku ini enna kalakkam uNDE?"],["நீணிலத்தொடு வான் வியப்ப * நிறை பெரும் போர்கள் செய்து *","வாணன் ஆயிரம் தோள் துணித்ததும் * உட்பட மற்றும் பல **","மாணியாய் நிலம் கொண்ட மாயன் * என் அப்பன் தன் மாயங்களே *","காணும் நெஞ்சு உடையேன் * எனக்கு இனி என்ன கலக்கம் உண்டே?"],0,"/media/recitation/TVM.6.4.8.mp3"],[3384,3384,["kalakka Ezh kaDal Ezh malai * ulagu Ezhum kazhiyak kaDAy *","ulakkath thEr koDu senRa mAyamum * uTpaDa maRRum pala **","valakkai Azhi iDakkai sanggam * ivai uDai mAl vaNNanai *","malakku nA uDaiyERku * mARuLadhO immaNNin misaiyE?"],["கலக்க ஏழ் கடல் ஏழ் மலை * உலகு ஏழும் கழியக் கடாய் *","உலக்கத் தேர் கொடு சென்ற மாயமும் * உட்பட மற்றும் பல **","வலக்கை ஆழி இடக்கை சங்கம் * இவை உடை மால் வண்ணனை *","மலக்கு நா உடையேற்கு * மாறுளதோ இம்மண்ணின் மிசையே?"],0,"/media/recitation/TVM.6.4.9.mp3"],[3385,3385,["maN misaip perum bAram nIngga * Or bAradha mA perum pOr","paNNi * mAyanggaL seydhu * sEnaiyaip pAzh paDa nURRiTTup pOy **","viN misaith thana thAmamE puga * mEviya sOdhi than thAL *","naNNi nAn vaNanggap peRRen * enakku Ar piRar nAyagarE?"],["மண் மிசைப் பெரும் பாரம் நீங்க * ஓர் பாரத மா பெரும் போர்","பண்ணி * மாயங்கள் செய்து * சேனையைப் பாழ் பட நூற்றிட்டுப் போய் **","விண் மிசைத் தன தாமமே புக * மேவிய சோதி தன் தாள் *","நண்ணி நான் வணங்கப் பெற்றென் * எனக்கு ஆர் பிறர் நாயகரே?"],0,"/media/recitation/TVM.6.4.10.mp3"],[3386,3386,["** nAyagan muzhu Ezh ulagukkumAy * muzhu Ezh ulagum * than","vAyagam puga vaiththu umizhndhu avaiyAy * avai allanumAm **","kEsavan aDiyiNai misaik * kurugUrch saDakOpan sonna *","thUya Ayiraththu ippaththAl * paththar Avar thuvaL inRiyE"],["** நாயகன் முழு ஏழ் உலகுக்குமாய் * முழு ஏழ் உலகும் * தன்","வாயகம் புக வைத்து உமிழ்ந்து அவையாய் * அவை அல்லனுமாம் **","கேசவன் அடியிணை மிசைக் * குருகூர்ச் சடகோபன் சொன்ன *","தூய ஆயிரத்து இப்பத்தால் * பத்தர் ஆவர் துவள் இன்றியே"],0,"/media/recitation/TVM.6.4.11.mp3"]],[[3387,3387,["** thuvaLil mA maNi mADam Onggu *","tholaivilli manggalam thozhum","ivaLai * nIr ini annaimIr! * umakku","Asai illai viDuminO **","thavaLa oN sanggu chakkaram enRum *","thAmaraith thaDanggaN enRum *","kuvaLai oN malark kaNgaL nIr malga *","ninRu ninRu kumuRumE"],["** துவளில் மா மணி மாடம் ஓங்கு *","தொலைவில்லி மங்கலம் தொழும்","இவளை * நீர் இனி அன்னைமீர்! * உமக்கு","ஆசை இல்லை விடுமினோ **","தவள ஒண் சங்கு சக்கரம் என்றும் *","தாமரைத் தடங்கண் என்றும் *","குவளை ஒண் மலர்க் கண்கள் நீர் மல்க *","நின்று நின்று குமுறுமே"],0,"/media/recitation/TVM.6.5.1.mp3"],[3388,3388,["kumuRum Osai vizhavolith * tholaivilli","manggalam koNDu pukku *","amudha men mozhiyALai * nIr umakku","Asai inRi agaRRinIr **","thimir koNDAl oththu niRkum * maRRivaL","dhEva dhEva pirAn enRE *","nimiyum vAyoDu kaNgaL nIr malga *","nekkosindhu karaiyumE"],["குமுறும் ஓசை விழவொலித் * தொலைவில்லி","மங்கலம் கொண்டு புக்கு *","அமுத மென் மொழியாளை * நீர் உமக்கு","ஆசை இன்றி அகற்றினீர் **","திமிர் கொண்டால் ஒத்து நிற்கும் * மற்றிவள்","தேவ தேவ பிரான் என்றே *","நிமியும் வாயொடு கண்கள் நீர் மல்க *","நெக்கொசிந்து கரையுமே"],0,"/media/recitation/TVM.6.5.2.mp3"],[3389,3389,["karai koL paimpozhil thaN paNaith * tholaivilli","manggalam koNDu pukku *","urai koL in mozhiyALai * nIr umakku","Asai inRi agaRRinIr **","thirai koL pauvaththuch sErndhadhum * thisai","njAlam thAvi aLandhadhum *","niraigaL mEyththadhumE pidhaRRi *","neDungkaN nIr malga niRkumE"],["கரை கொள் பைம்பொழில் தண் பணைத் * தொலைவில்லி","மங்கலம் கொண்டு புக்கு *","உரை கொள் இன் மொழியாளை * நீர் உமக்கு","ஆசை இன்றி அகற்றினீர் **","திரை கொள் பௌவத்துச் சேர்ந்ததும் * திசை","ஞாலம் தாவி அளந்ததும் *","நிரைகள் மேய்த்ததுமே பிதற்றி *","நெடுங்கண் நீர் மல்க நிற்குமே"],0,"/media/recitation/TVM.6.5.3.mp3"],[3390,3390,["niRkum nAnmaRai vANar vAzh * tholaivilli","manggalam kaNDa pin *","aRkam onRum aRa uRAL * malindhAL","kaNDIr ivaL annaimIr! **","kaRkum kalvi ellAm * karungkaDal","vaNNan kaNNa pirAn enRE *","oRkam onRum ilaL * ugandhu ugandhu","uL magizhndhu kuzhaiyumE"],["நிற்கும் நான்மறை வாணர் வாழ் * தொலைவில்லி","மங்கலம் கண்ட பின் *","அற்கம் ஒன்றும் அற உறாள் * மலிந்தாள்","கண்டீர் இவள் அன்னைமீர்! **","கற்கும் கல்வி எல்லாம் * கருங்கடல்","வண்ணன் கண்ண பிரான் என்றே *","ஒற்கம் ஒன்றும் இலள் * உகந்து உகந்து","உள் மகிழ்ந்து குழையுமே"],0,"/media/recitation/TVM.6.5.4.mp3"],[3391,3391,["kuzhaiyum vANmugaththu Ezhaiyaith * tholaivilli","manggalam koNDu pukku *","izhai koL sOdhich senthAmaraik kaN","pirAn * irundhamai kATTinIr **","mazhai peydhAl okkum kaNNa nIrinoDu *","anRu thoTTum maiyAndhu * ivaL","nuzhaiyum sindhaiyaL annaimIr! * thozhum","aththisai uRRu nOkkiyE"],["குழையும் வாண்முகத்து ஏழையைத் * தொலைவில்லி","மங்கலம் கொண்டு புக்கு *","இழை கொள் சோதிச் செந்தாமரைக் கண்","பிரான் * இருந்தமை காட்டினீர் **","மழை பெய்தால் ஒக்கும் கண்ண நீரினொடு *","அன்று தொட்டும் மையாந்து * இவள்","நுழையும் சிந்தையள் அன்னைமீர்! * தொழும்","அத்திசை உற்று நோக்கியே"],0,"/media/recitation/TVM.6.5.5.mp3"],[3392,3392,["nOkkum pakkam ellAm * karumboDu","sennel Onggu senthAmarai *","vAykkum thaN porunal * vaDakarai","vaN tholaivilli manggalam **","nOkkumEl aththisai allAl * maRu","nOkkilaL vaigal nAL thoRum *","vAyk koL vAsagamum * maNi vaNNan","nAmamE ivaL annaimIr!"],["நோக்கும் பக்கம் எல்லாம் * கரும்பொடு","செந்நெல் ஓங்கு செந்தாமரை *","வாய்க்கும் தண் பொருநல் * வடகரை","வண் தொலைவில்லி மங்கலம் **","நோக்குமேல் அத்திசை அல்லால் * மறு","நோக்கிலள் வைகல் நாள் தொறும் *","வாய்க் கொள் வாசகமும் * மணி வண்ணன்","நாமமே இவள் அன்னைமீர்!"],0,"/media/recitation/TVM.6.5.6.mp3"],[3393,3393,["annaimIr! aNi mA mayil * siRu","mAn ivaL nammaik kai valindhu *","enna vArththaiyum kETkuRAL *","tholaivilli manggalam enRallAl **","munnam nORRa vidhi kolO? *","mugil vaNNan mAyangkolO? * avan","chinnamum thiru nAmamum * ivaL","vAyanagaL thirundhavE"],["அன்னைமீர்! அணி மா மயில் * சிறு","மான் இவள் நம்மைக் கை வலிந்து *","என்ன வார்த்தையும் கேட்குறாள் *","தொலைவில்லி மங்கலம் என்றல்லால் **","முன்னம் நோற்ற விதி கொலோ? *","முகில் வண்ணன் மாயங்கொலோ? * அவன்","சின்னமும் திரு நாமமும் * இவள்","வாயனகள் திருந்தவே"],0,"/media/recitation/TVM.6.5.7.mp3"],[3394,3394,["thirundhu vEdhamum vELviyum *","thiru mA magaLirum thAm * malin","thirundhu vAzh porunal * vaDakarai","vaN tholaivilli manggalam **","karunthaDangkaNNi kai thozhudha *","annAL thoDanggi innAL thoRum *","irundhu irundhu aravindha lOchana! *","enRenRE naindhu iranggumE"],["திருந்து வேதமும் வேள்வியும் *","திரு மா மகளிரும் தாம் * மலிந்","திருந்து வாழ் பொருநல் * வடகரை","வண் தொலைவில்லி மங்கலம் **","கருந்தடங்கண்ணி கை தொழுத *","அந்நாள் தொடங்கி இந்நாள் தொறும் *","இருந்து இருந்து அரவிந்த லோசன! *","என்றென்றே நைந்து இரங்குமே"],0,"/media/recitation/TVM.6.5.8.mp3"],[3395,3395,["iranggi nAL thoRum vAyverIi * ivaL","kaNNa nIrgaL alamara *","maranggaLum iranggum vagai *","maNi vaNNavO! enRu kUvumAl **","thuranggam vAy piLandhAn uRai * tholaivilli","manggalam enRu * than","karanggaL kUppith thozhum * avvUrth","thiru nAmam kaRRadhaR pinnaiyE"],["இரங்கி நாள் தொறும் வாய்வெரீஇ * இவள்","கண்ண நீர்கள் அலமர *","மரங்களும் இரங்கும் வகை *","மணி வண்ணவோ! என்று கூவுமால் **","துரங்கம் வாய் பிளந்தான் உறை * தொலைவில்லி","மங்கலம் என்று * தன்","கரங்கள் கூப்பித் தொழும் * அவ்வூர்த்","திரு நாமம் கற்றதற் பின்னையே"],0,"/media/recitation/TVM.6.5.9.mp3"],[3396,3396,["pinnai kol? nila mA magaL kol? *","thiru magaL kol? piRandhiTTAL *","enna mAyangkolO? * ivaL neDumAl","enRE ninRu kUvumAl **","munni vandhu avan ninRu irundhu uRaiyum *","tholaivilli manggalam","senniyAl vaNanggum * avvUrth","thiru nAmam * kETpadhu sindhaiyE"],["பின்னை கொல்? நில மா மகள் கொல்? *","திரு மகள் கொல்? பிறந்திட்டாள் *","என்ன மாயங்கொலோ? * இவள் நெடுமால்","என்றே நின்று கூவுமால் **","முன்னி வந்து அவன் நின்று இருந்து உறையும் *","தொலைவில்லி மங்கலம்","சென்னியால் வணங்கும் * அவ்வூர்த்","திரு நாமம் * கேட்பது சிந்தையே"],0,"/media/recitation/TVM.6.5.10.mp3"],[3397,3397,["** sindhaiyAlum sollAlum seygaiyinAlum *","dhEva pirAnaiyE *","thandhai thAy enRu aDaindha * vaN kurugUravar","saDakOpan **","mundhai AyiraththuL ivai * tholaivilli","manggalaththaich sonna *","senthamizh paththum vallAr * aDimai","seyvAr thirumAlukkE"],["** சிந்தையாலும் சொல்லாலும் செய்கையினாலும் *","தேவ பிரானையே *","தந்தை தாய் என்று அடைந்த * வண் குருகூரவர்","சடகோபன் **","முந்தை ஆயிரத்துள் இவை * தொலைவில்லி","மங்கலத்தைச் சொன்ன *","செந்தமிழ் பத்தும் வல்லார் * அடிமை","செய்வார் திருமாலுக்கே"],0,"/media/recitation/TVM.6.5.11.mp3"]],[[3398,3398,["** mAlukku * vaiyam aLandha maNALaRku *","nIlak karu niRa * mEga niyAyaRku **","kOlach senthAmaraik kaNNaRku * en konggalar","Elak kuzhali * izhandhadhu sanggE"],["** மாலுக்கு * வையம் அளந்த மணாளற்கு *","நீலக் கரு நிற * மேக நியாயற்கு **","கோலச் செந்தாமரைக் கண்ணற்கு * என் கொங்கலர்","ஏலக் குழலி * இழந்தது சங்கே"],0,"/media/recitation/TVM.6.6.1.mp3"],[3399,3399,["sanggu vil vAL thaNDu * chakkarak kaiyaRku *","sengkani vAych * seyya thAmaraik kaNNaRku **","konggalar thaNNanthuzhAy * muDiyAnukku * en","manggai izhandhadhu * mAmai niRamE"],["சங்கு வில் வாள் தண்டு * சக்கரக் கையற்கு *","செங்கனி வாய்ச் * செய்ய தாமரைக் கண்ணற்கு **","கொங்கலர் தண்ணந்துழாய் * முடியானுக்கு * என்","மங்கை இழந்தது * மாமை நிறமே"],0,"/media/recitation/TVM.6.6.2.mp3"],[3400,3400,["niRam kariyAnukku * nIDu ulaguNDa *","thiRam kiLar vAych * siRu kaLvan avaRku **","kaRanggiya chakkarak * kaiyavanukku * en","piRanggu irungkUndhal * izhandhadhu pIDE"],["நிறம் கரியானுக்கு * நீடு உலகுண்ட *","திறம் கிளர் வாய்ச் * சிறு கள்வன் அவற்கு **","கறங்கிய சக்கரக் * கையவனுக்கு * என்","பிறங்கு இருங்கூந்தல் * இழந்தது பீடே"],0,"/media/recitation/TVM.6.6.3.mp3"],[3401,3401,["pIDuDai nAnmuganaip * paDaiththAnukku *","mADuDai vaiyam * aLandha maNALaRku **","nADuDai mannarkkuth * thUdhu sel nambikku * en","pADuDai algul * izhandhadhu paNbE"],["பீடுடை நான்முகனைப் * படைத்தானுக்கு *","மாடுடை வையம் * அளந்த மணாளற்கு **","நாடுடை மன்னர்க்குத் * தூது செல் நம்பிக்கு * என்","பாடுடை அல்குல் * இழந்தது பண்பே"],0,"/media/recitation/TVM.6.6.4.mp3"],[3402,3402,["paNbuDai vEdham * payandha paranukku *","maN purai vaiyam * iDandha varAgaRku **","theN punal paLLi * em dhEva pirAnukku * en","kaN punai kOdhai * izhandhadhu kaRpE"],["பண்புடை வேதம் * பயந்த பரனுக்கு *","மண் புரை வையம் * இடந்த வராகற்கு **","தெண் புனல் பள்ளி * எம் தேவ பிரானுக்கு * என்","கண் புனை கோதை * இழந்தது கற்பே"],0,"/media/recitation/TVM.6.6.5.mp3"],[3403,3403,["kaRpagak kAvana * naR pala thOLaRku *","poR suDark kunRu anna * pUnthaN muDiyaRku **","naR pala thAmarai * nAL malark kaiyaRku * en","viR puruvak koDi * thORRadhu meyyE"],["கற்பகக் காவன * நற் பல தோளற்கு *","பொற் சுடர்க் குன்று அன்ன * பூந்தண் முடியற்கு **","நற் பல தாமரை * நாள் மலர்க் கையற்கு * என்","விற் புருவக் கொடி * தோற்றது மெய்யே"],0,"/media/recitation/TVM.6.6.6.mp3"],[3404,3404,["mey amar pal kalan * nanku aNindhAnukku *","pai aravin aNaip * paLLiyinAnukku **","kaiyoDu kAl seyya * kaNNa pirAnukku* en","thaiyal izhandhadhu * thannuDaich sAyE"],["மெய் அமர் பல் கலன் * நன்கு அணிந்தானுக்கு *","பை அரவின் அணைப் * பள்ளியினானுக்கு **","கையொடு கால் செய்ய * கண்ண பிரானுக்கு* என்","தையல் இழந்தது * தன்னுடைச் சாயே"],0,"/media/recitation/TVM.6.6.7.mp3"],[3405,3405,["sAyak kurundham * osiththa thamiyaRku *","mAyach sagaDam * udhaiththa maNALaRku **","pEyaip piNam paDap * pAl uN pirAnukku * en","vAsak kuzhali * izhandhadhu mANbE"],["சாயக் குருந்தம் * ஒசித்த தமியற்கு *","மாயச் சகடம் * உதைத்த மணாளற்கு **","பேயைப் பிணம் படப் * பால் உண் பிரானுக்கு * என்","வாசக் குழலி * இழந்தது மாண்பே"],0,"/media/recitation/TVM.6.6.8.mp3"],[3406,3406,["mANbamai kOlaththu * em mAyak kuRaLaRku *","sEN suDark kunRanna * senjchuDar mUrththikku **","kAN perum thORRaththu * em kAguththa nambikku * en","pUN punai menmulai * thORRadhu poRpE"],["மாண்பமை கோலத்து * எம் மாயக் குறளற்கு *","சேண் சுடர்க் குன்றன்ன * செஞ்சுடர் மூர்த்திக்கு **","காண் பெரும் தோற்றத்து * எம் காகுத்த நம்பிக்கு * என்","பூண் புனை மென்முலை * தோற்றது பொற்பே"],0,"/media/recitation/TVM.6.6.9.mp3"],[3407,3407,["poRpamai nIL muDip * pUnthaN thuzhAyaRku *","maR poru thOL uDai * mAyap pirAnukku **","niRpana pal uruvAy * niRku mAyaRku * en","kaRpuDaiyATTi * izhandhadhu kaTTE"],["பொற்பமை நீள் முடிப் * பூந்தண் துழாயற்கு *","மற் பொரு தோள் உடை * மாயப் பிரானுக்கு **","நிற்பன பல் உருவாய் * நிற்கு மாயற்கு * என்","கற்புடையாட்டி * இழந்தது கட்டே"],0,"/media/recitation/TVM.6.6.10.mp3"],[3408,3408,["** kaTTezhil sOlai * nal vEngkaDa vANanai *","kaTTezhil then kurugUrch * saDakOpan sol **","kaTTezhil Ayiraththu * ippaththum vallavar *","kaTTezhil vAnavar * bOgam uNbArE"],["** கட்டெழில் சோலை * நல் வேங்கட வாணனை *","கட்டெழில் தென் குருகூர்ச் * சடகோபன் சொல் **","கட்டெழில் ஆயிரத்து * இப்பத்தும் வல்லவர் *","கட்டெழில் வானவர் * போகம் உண்பாரே"],0,"/media/recitation/TVM.6.6.11.mp3"]],[[3409,3409,["** uNNum sORu parugu nIr *","thinnum veRRilaiyum ellAm","kaNNan * emperumAn enRenRE *","kaNgaL nIrgaL malgi **","maNNinuL avan sIr * vaLam mikka","avan Ur vinavi *","thiNNam en iLa mAn pugum Ur *","thirukkOLUrE"],["** உண்ணும் சோறு பருகு நீர் *","தின்னும் வெற்றிலையும் எல்லாம்","கண்ணன் * எம்பெருமான் என்றென்றே *","கண்கள் நீர்கள் மல்கி **","மண்ணினுள் அவன் சீர் * வளம் மிக்க","அவன் ஊர் வினவி *","திண்ணம் என் இள மான் புகும் ஊர் *","திருக்கோளூரே"],0,"/media/recitation/TVM.6.7.1.mp3"],[3410,3410,["Urum nADum ulagamum *","thannaip pOl * avanuDaiya","pErum thArgaLumE pidhaRRak *","kaRpu vAn iDaRi **","sEru nal vaLam sEr * pazhanath","thirukkOLUrkkE *","pOrungkol? uraiyIr * koDiyEn","koDi pUvaigaLE!"],["ஊரும் நாடும் உலகமும் *","தன்னைப் போல் * அவனுடைய","பேரும் தார்களுமே பிதற்றக் *","கற்பு வான் இடறி **","சேரு நல் வளம் சேர் * பழனத்","திருக்கோளூர்க்கே *","போருங்கொல்? உரையீர் * கொடியேன்","கொடி பூவைகளே!"],0,"/media/recitation/TVM.6.7.2.mp3"],[3411,3411,["pUvai paingkiLigaL * pandhu","thUdhai pUm puTTilgaL *","yAvaiyum thirumAl * thiru nAmanggaLE","kUvi ezhum ** en","pAvai pOy inith * thaN pazhanath","thirukkOLUrkkE *","kOvai vAy thuDippa * mazhaik kaNNoDu","en seyyungkolO?"],["பூவை பைங்கிளிகள் * பந்து","தூதை பூம் புட்டில்கள் *","யாவையும் திருமால் * திரு நாமங்களே","கூவி எழும் ** என்","பாவை போய் இனித் * தண் பழனத்","திருக்கோளூர்க்கே *","கோவை வாய் துடிப்ப * மழைக் கண்ணொடு","என் செய்யுங்கொலோ?"],0,"/media/recitation/TVM.6.7.3.mp3"],[3412,3412,["kollai enbar kolO? * guNam","mikkanaL enbar kolO? *","sillai vAyp peNDugaL * ayaR","sEri uLLArum ellE! **","selvam malgi avan kiDandha *","thirukkOLUrkkE *","mel iDai nuDangga * iLa mAn","sella mEvinaLE"],["கொல்லை என்பர் கொலோ? * குணம்","மிக்கனள் என்பர் கொலோ? *","சில்லை வாய்ப் பெண்டுகள் * அயற்","சேரி உள்ளாரும் எல்லே! **","செல்வம் மல்கி அவன் கிடந்த *","திருக்கோளூர்க்கே *","மெல் இடை நுடங்க * இள மான்","செல்ல மேவினளே"],0,"/media/recitation/TVM.6.7.4.mp3"],[3413,3413,["mEvi naindhu naindhu","viLaiyADal uRAL * en siRuth","thEvi pOy * inith than","thirumAl * thirukkOLUril **","pUviyal pozhilum * thaDamum","avan kOyilum kaNDu *","Avi uL kuLira * engnganE","ugakkungkol inRE?"],["மேவி நைந்து நைந்து","விளையாடல் உறாள் * என் சிறுத்","தேவி போய் * இனித் தன்","திருமால் * திருக்கோளூரில் **","பூவியல் பொழிலும் * தடமும்","அவன் கோயிலும் கண்டு *","ஆவி உள் குளிர * எங்ஙனே","உகக்குங்கொல் இன்றே?"],0,"/media/recitation/TVM.6.7.5.mp3"],[3414,3414,["inRu enakku udhavAdhu aganRa *","iLa mAn inip pOy *","thenthisaith thiladham anaiya *","thirukkOLUrkkE","senRu ** than thirumAl thiruk kaNNum *","sevvAyum kaNDu *","ninRu ninRu naiyum *","neDungkaNgaL pani malgavE"],["இன்று எனக்கு உதவாது அகன்ற *","இள மான் இனிப் போய் *","தென்திசைத் திலதம் அனைய *","திருக்கோளூர்க்கே","சென்று ** தன் திருமால் திருக் கண்ணும் *","செவ்வாயும் கண்டு *","நின்று நின்று நையும் *","நெடுங்கண்கள் பனி மல்கவே"],0,"/media/recitation/TVM.6.7.6.mp3"],[3415,3415,["malgu nIrk kaNNoDu *","maiyal uRRa manaththanaLAy *","allum nanpagalum *","neDumAl enRu azhaiththu inip pOy **","selvam malgi avan","kiDandha * thirukkOLUrkkE *","olgi olgi naDandhu *","engnganE pugungkol OsindhE?"],["மல்கு நீர்க் கண்ணொடு *","மையல் உற்ற மனத்தனளாய் *","அல்லும் நன்பகலும் *","நெடுமால் என்று அழைத்து இனிப் போய் **","செல்வம் மல்கி அவன்","கிடந்த * திருக்கோளூர்க்கே *","ஒல்கி ஒல்கி நடந்து *","எங்ஙனே புகுங்கொல் ஓசிந்தே?"],0,"/media/recitation/TVM.6.7.7.mp3"],[3416,3416,["osindha nuNNiDai mEl * kaiyai","vaiththu nondhu nondhu *","kasindha nenjchinaLAyk * kaNNa nIr","thuLumbach sellungkol? **","osindha oNmalarAL kozhunan *","thirukkOLUrkkE *","kasindha nenjchinaLAy * emmai","nIththa em kArigaiyE"],["ஒசிந்த நுண்ணிடை மேல் * கையை","வைத்து நொந்து நொந்து *","கசிந்த நெஞ்சினளாய்க் * கண்ண நீர்","துளும்பச் செல்லுங்கொல்? **","ஒசிந்த ஒண்மலராள் கொழுனன் *","திருக்கோளூர்க்கே *","கசிந்த நெஞ்சினளாய் * எம்மை","நீத்த எம் காரிகையே"],0,"/media/recitation/TVM.6.7.8.mp3"],[3417,3417,["kAriyam nallanagaL avai kANil * en","kaNNanukku enRu *","IriyAy iruppAL * idhellAm","kiDakka inip pOy **","sEri pal pazhi thUy iraippath *","thirukkOLUrkkE *","nEr izhai naDandhAL * emmai","onRum ninaiththilaLE"],["காரியம் நல்லனகள் அவை காணில் * என்","கண்ணனுக்கு என்று *","ஈரியாய் இருப்பாள் * இதெல்லாம்","கிடக்க இனிப் போய் **","சேரி பல் பழி தூய் இரைப்பத் *","திருக்கோளூர்க்கே *","நேர் இழை நடந்தாள் * எம்மை","ஒன்றும் நினைத்திலளே"],0,"/media/recitation/TVM.6.7.9.mp3"],[3418,3418,["ninaikkilEn dheyvanggAL! * neDungkaN","iLa mAn inip pOy *","anaiththu ulagum uDaiya *","aravindha lOchananai **","thinaith thanaiyum viDAL * avan sEr","thirukkOLUrkkE *","manaikku vAn pazhiyum ninaiyAL *","sella vaiththanaLE"],["நினைக்கிலேன் தெய்வங்காள்! * நெடுங்கண்","இள மான் இனிப் போய் *","அனைத்து உலகும் உடைய *","அரவிந்த லோசனனை **","தினைத் தனையும் விடாள் * அவன் சேர்","திருக்கோளூர்க்கே *","மனைக்கு வான் பழியும் நினையாள் *","செல்ல வைத்தனளே"],0,"/media/recitation/TVM.6.7.10.mp3"],[3419,3419,["** vaiththa mA nidhiyAm *","madhusUdhanaiyE alaRRi *","koththalar pozhil sUzh * kurugUrch","saDakOpan sonna **","paththu nURRuL ippaththu *","avan sEr thirukkOLUrkkE *","siththam vaiththu uraippAr *","thigazh ponnulagu ALvArE"],["** வைத்த மா நிதியாம் *","மதுசூதனையே அலற்றி *","கொத்தலர் பொழில் சூழ் * குருகூர்ச்","சடகோபன் சொன்ன **","பத்து நூற்றுள் இப்பத்து *","அவன் சேர் திருக்கோளூர்க்கே *","சித்தம் வைத்து உரைப்பார் *","திகழ் பொன்னுலகு ஆள்வாரே"],0,"/media/recitation/TVM.6.7.11.mp3"]],[[3420,3420,["** ponnlagu ALIrO? *","buvani muzhudhu ALIrO? *","nannalap puL inanggAL! *","vinaiyATTiyEn nAn irandhEn **","mun ulaganggaL ellAm","paDaiththa * mugil vaNNan kaNNan *","en nalam koNDa pirAn","thanakku * en nilaimai uraiththE"],["** பொன்னுலகு ஆளீரோ? *","புவனி முழுது ஆளீரோ? *","நன்னலப் புள் இனங்காள்! *","வினையாட்டியேன் நான் இரந்தேன் **","முன் உலகங்கள் எல்லாம்","படைத்த * முகில் வண்ணன் கண்ணன் *","என் நலம் கொண்ட பிரான்","தனக்கு * என் நிலைமை உரைத்தே"],0,"/media/recitation/TVM.6.8.1.mp3"],[3421,3421,["maiyamar vAL neDungkaN *","manggaimAr munbu en kai irundhu *","neyyamar innaDisil *","nichchal pAloDu mEvIrO? **","kaiyamar chakkaraththu * en","kani vAyp perumAnaik kaNDu *","meyyamar kAdhal sollik *","kiLigAL! viraindhu ODi vandhE"],["மையமர் வாள் நெடுங்கண் *","மங்கைமார் முன்பு என் கை இருந்து *","நெய்யமர் இன்னடிசில் *","நிச்சல் பாலொடு மேவீரோ? **","கையமர் சக்கரத்து * என்","கனி வாய்ப் பெருமானைக் கண்டு *","மெய்யமர் காதல் சொல்லிக் *","கிளிகாள்! விரைந்து ஓடி வந்தே"],0,"/media/recitation/TVM.6.8.2.mp3"],[3422,3422,["ODi vandhu en kuzhal mEl *","oLi mA malar UdhIrO? *","kUDiya vaNDinanggAL! *","kurunADu uDaiya aivargaTkAy **","ADiya mA neDunthErp","paDai * nIRezha seRRa pirAn *","sUDiya thaN thuLavam uNDa *","thU madhu vAygaL koNDE"],["ஓடி வந்து என் குழல் மேல் *","ஒளி மா மலர் ஊதீரோ? *","கூடிய வண்டினங்காள்! *","குருநாடு உடைய ஐவர்கட்காய் **","ஆடிய மா நெடுந்தேர்ப்","படை * நீறெழ செற்ற பிரான் *","சூடிய தண் துளவம் உண்ட *","தூ மது வாய்கள் கொண்டே"],0,"/media/recitation/TVM.6.8.3.mp3"],[3423,3423,["thU madhu vAygaL koNDu","vandhu * en mullaigaL mEl thumbigAL! *","pU madhu uNNach sellil *","vinaiyEnaip poy seydhu aganRa **","mA madhu vAr thaNthuzhAy","muDi * vAnavar kOnaik kaNDu *","yAm idhuvO thakka ARu? *","enna vENDum kaNDIr nunggaTkE"],["தூ மது வாய்கள் கொண்டு","வந்து * என் முல்லைகள் மேல் தும்பிகாள்! *","பூ மது உண்ணச் செல்லில் *","வினையேனைப் பொய் செய்து அகன்ற **","மா மது வார் தண்துழாய்","முடி * வானவர் கோனைக் கண்டு *","யாம் இதுவோ தக்க ஆறு? *","என்ன வேண்டும் கண்டீர் நுங்கட்கே"],0,"/media/recitation/TVM.6.8.4.mp3"],[3424,3424,["nunggaTku yAn uraikkEn","vammin * yAn vaLarththa kiLigAL! *","vengkaN puL Urndhu vandhu *","vinaiyEnai nenjcham kavarndha **","sengkaN karu mugilaich *","seyya vAych sezhung kaRpagaththai *","engguch senRAgilum kaNDu *","idhuvO thakka ARu? enminE"],["நுங்கட்கு யான் உரைக்கேன்","வம்மின் * யான் வளர்த்த கிளிகாள்! *","வெங்கண் புள் ஊர்ந்து வந்து *","வினையேனை நெஞ்சம் கவர்ந்த **","செங்கண் கரு முகிலைச் *","செய்ய வாய்ச் செழுங் கற்பகத்தை *","எங்குச் சென்றாகிலும் கண்டு *","இதுவோ தக்க ஆறு? என்மினே"],0,"/media/recitation/TVM.6.8.5.mp3"],[3425,3425,["en minnu nUl mArvan *","en karum perumAn en kaNNan *","than mannu nIL kazhal mEl *","thaNthuzhAy namakku anRi nalgAn **","kanmingaL enRu ummai yAn *","kaRpiyA vaiththa mARRam solli *","senmingaL thI vinaiyEn *","vaLarththa siRu pUvaigaLE!"],["என் மின்னு நூல் மார்வன் *","என் கரும் பெருமான் என் கண்ணன் *","தன் மன்னு நீள் கழல் மேல் *","தண்துழாய் நமக்கு அன்றி நல்கான் **","கன்மின்கள் என்று உம்மை யான் *","கற்பியா வைத்த மாற்றம் சொல்லி *","சென்மின்கள் தீ வினையேன் *","வளர்த்த சிறு பூவைகளே!"],0,"/media/recitation/TVM.6.8.6.mp3"],[3426,3426,["pUvaigaL pOl niRaththan *","puNDarIganggaL pOlum kaNNan *","yAvaiyum yAvarumAy *","ninRa mAyan en Azhip pirAn **","mAvai val vAy piLandha *","madhusUdhaRku en mARRam solli *","pAvaigaL! thIrkkiRRirE *","vinaiyATTiyEn pAsaRavE"],["பூவைகள் போல் நிறத்தன் *","புண்டரீகங்கள் போலும் கண்ணன் *","யாவையும் யாவருமாய் *","நின்ற மாயன் என் ஆழிப் பிரான் **","மாவை வல் வாய் பிளந்த *","மதுசூதற்கு என் மாற்றம் சொல்லி *","பாவைகள்! தீர்க்கிற்றிரே *","வினையாட்டியேன் பாசறவே"],0,"/media/recitation/TVM.6.8.7.mp3"],[3427,3427,["pAsaRavu eydhi innE *","vinaiyEn enai Uzhi naivEn? *","AsaRu thUvi veLLaik","kurugE! * aruL seydhoru nAL **","mAsaRu nIlach suDar muDi *","vAnavar kOnaik kaNDu *","EsaRum nummai allAl *","maRu nOkkilaL pErththu maRRE"],["பாசறவு எய்தி இன்னே *","வினையேன் எனை ஊழி நைவேன்? *","ஆசறு தூவி வெள்ளைக்","குருகே! * அருள் செய்தொரு நாள் **","மாசறு நீலச் சுடர் முடி *","வானவர் கோனைக் கண்டு *","ஏசறும் நும்மை அல்லால் *","மறு நோக்கிலள் பேர்த்து மற்றே"],0,"/media/recitation/TVM.6.8.8.mp3"],[3428,3428,["pErththu maRROr kaLaikaN *","vinaiyATTiyEn nAn onRilEn *","nIrth thirai mEl ulavi *","irai thErum puthA inanggAL! **","kArth thiraL mA mugil pOl *","kaNNan viNNavar kOnaik kaNDu *","vArththaigaL koNDu aruLi","uraiyIr * vaigal vandhu irundhE"],["பேர்த்து மற்றோர் களைகண் *","வினையாட்டியேன் நான் ஒன்றிலேன் *","நீர்த் திரை மேல் உலவி *","இரை தேரும் புதா இனங்காள்! **","கார்த் திரள் மா முகில் போல் *","கண்ணன் விண்ணவர் கோனைக் கண்டு *","வார்த்தைகள் கொண்டு அருளி","உரையீர் * வைகல் வந்து இருந்தே"],0,"/media/recitation/TVM.6.8.9.mp3"],[3429,3429,["vandhu irundhu ummuDaiya *","maNich chEvalum nIrum ellAm *","andharam onRum inRi *","alar mEl asaiyum annanggAL! **","en thirumArvaRku ennai *","innavARu ivaL kANmin enRu *","mandhiraththu onRu uNarththi","uraiyIr * maRu mARRanggaLE"],["வந்து இருந்து உம்முடைய *","மணிச் சேவலும் நீரும் எல்லாம் *","அந்தரம் ஒன்றும் இன்றி *","அலர் மேல் அசையும் அன்னங்காள்! **","என் திருமார்வற்கு என்னை *","இன்னவாறு இவள் காண்மின் என்று *","மந்திரத்து ஒன்று உணர்த்தி","உரையீர் * மறு மாற்றங்களே"],0,"/media/recitation/TVM.6.8.10.mp3"],[3430,3430,["** mARRanggaL Ayndhu koNDu *","madhusUdha pirAn aDi mEl *","nARRangkoL pUmpozhil sUzh *","kurugUrch saDakOpan sonna **","thORRanggaL AyiraththuL *","ivaiyum oru paththum vallAr *","URRin kaN nuN maNal pOl *","urugA niRpar nIrAyE"],["** மாற்றங்கள் ஆய்ந்து கொண்டு *","மதுசூத பிரான் அடி மேல் *","நாற்றங்கொள் பூம்பொழில் சூழ் *","குருகூர்ச் சடகோபன் சொன்ன **","தோற்றங்கள் ஆயிரத்துள் *","இவையும் ஒரு பத்தும் வல்லார் *","ஊற்றின் கண் நுண் மணல் போல் *","உருகா நிற்பர் நீராயே"],0,"/media/recitation/TVM.6.8.11.mp3"]],[[3431,3431,["** nIrAy nilanAyth * thIyAyk kAlAy neDuvAnAy *","sIrAr suDargaL iraNDAych * sivanAy ayanAnAy! **","kUrAr Azhi veNsanggu Endhik * koDiyEn pAl","vArAy * oru nAL * maNNum viNNum magizhavE"],["** நீராய் நிலனாய்த் * தீயாய்க் காலாய் நெடுவானாய் *","சீரார் சுடர்கள் இரண்டாய்ச் * சிவனாய் அயனானாய்! **","கூரார் ஆழி வெண்சங்கு ஏந்திக் * கொடியேன் பால்","வாராய் * ஒரு நாள் * மண்ணும் விண்ணும் மகிழவே"],0,"/media/recitation/TVM.6.9.1.mp3"],[3432,3432,["maNNum viNNum magizhak * kuRaLAy valangkATTi *","maNNum viNNum koNDa * mAya ammAnE! **","naNNi unai nAn * kaNDu ugandhu kUththADa *","naNNi oru nAL * njAlaththUDE naDavAyE"],["மண்ணும் விண்ணும் மகிழக் * குறளாய் வலங்காட்டி *","மண்ணும் விண்ணும் கொண்ட * மாய அம்மானே! **","நண்ணி உனை நான் * கண்டு உகந்து கூத்தாட *","நண்ணி ஒரு நாள் * ஞாலத்தூடே நடவாயே"],0,"/media/recitation/TVM.6.9.2.mp3"],[3433,3433,["njAlaththUDE naDandhum ninRum * kiDandhu irundhum *","sAlap pala nAL * ugam thORu uyirgaL kAppAnE! **","kOlath thiru mA magaLODu * unnaik kUDAdhE *","sAlap pala nAL * aDiyEn innam thaLarvEnO?"],["ஞாலத்தூடே நடந்தும் நின்றும் * கிடந்து இருந்தும் *","சாலப் பல நாள் * உகம் தோறு உயிர்கள் காப்பானே! **","கோலத் திரு மா மகளோடு * உன்னைக் கூடாதே *","சாலப் பல நாள் * அடியேன் இன்னம் தளர்வேனோ?"],0,"/media/recitation/TVM.6.9.3.mp3"],[3434,3434,["thaLarndhum muRindhum * sagaDa asurar uDal vERA *","piLandhu vIyath * thiruk kAl ANDa perumAnE! **","kiLarndhu piraman sivan * indhiran viNNavar sUzha *","viLangga oru nAL * kANa vArAy viN mIdhE"],["தளர்ந்தும் முறிந்தும் * சகட அசுரர் உடல் வேறா *","பிளந்து வீயத் * திருக் கால் ஆண்ட பெருமானே! **","கிளர்ந்து பிரமன் சிவன் * இந்திரன் விண்ணவர் சூழ *","விளங்க ஒரு நாள் * காண வாராய் விண் மீதே"],0,"/media/recitation/TVM.6.9.4.mp3"],[3435,3435,["viN mIdhu iruppAy! malai mEl niRpAy! * kaDal sErppAy! *","maN mIdhu uzhalvAy! * ivaRRuL enggum maRaindhu uRaivAy! **","eNmIdhu iyanRa puRa aNDaththAy! * enadhu Avi *","uL mIdhADi * uruk kATTAdhE oLippAyO?"],["விண் மீது இருப்பாய்! மலை மேல் நிற்பாய்! * கடல் சேர்ப்பாய்! *","மண் மீது உழல்வாய்! * இவற்றுள் எங்கும் மறைந்து உறைவாய்! **","எண்மீது இயன்ற புற அண்டத்தாய்! * எனது ஆவி *","உள் மீதாடி * உருக் காட்டாதே ஒளிப்பாயோ?"],0,"/media/recitation/TVM.6.9.5.mp3"],[3436,3436,["pAy Or aDi vaiththu adhan kIzhp * paravai nilam ellAm","thAy * Or aDiyAl * ellA ulagum thaDavandha","mAyOn! ** unnaik kANbAn * varundhi enai nALum *","thIyODu uDan sEr mezhugAy * ulagil thirivEnO?"],["பாய் ஓர் அடி வைத்து அதன் கீழ்ப் * பரவை நிலம் எல்லாம்","தாய் * ஓர் அடியால் * எல்லா உலகும் தடவந்த","மாயோன்! ** உன்னைக் காண்பான் * வருந்தி எனை நாளும் *","தீயோடு உடன் சேர் மெழுகாய் * உலகில் திரிவேனோ?"],0,"/media/recitation/TVM.6.9.6.mp3"],[3437,3437,["ulagil thiriyum karuma kadhiyAy * ulagamAy *","ulagukkE Or uyirum AnAy! * puRa aNDaththu **","alagil polindha * thisai paththAya aruvEyO! *","alagil polindha * aRivu ilEnukku aruLAyE"],["உலகில் திரியும் கரும கதியாய் * உலகமாய் *","உலகுக்கே ஓர் உயிரும் ஆனாய்! * புற அண்டத்து **","அலகில் பொலிந்த * திசை பத்தாய அருவேயோ! *","அலகில் பொலிந்த * அறிவு இலேனுக்கு அருளாயே"],0,"/media/recitation/TVM.6.9.7.mp3"],[3438,3438,["aRivu ilEnukku aruLAy * aRivAr uyir AnAy! *","veRi koL sOdhi mUrththi! * aDiyEn neDumAlE! **","kiRi seydhu ennaip puRaththiTTu * innam keDuppAyO? *","piRidhu onRu aRiyA aDiyEn * Avi thigaikkavE"],["அறிவு இலேனுக்கு அருளாய் * அறிவார் உயிர் ஆனாய்! *","வெறி கொள் சோதி மூர்த்தி! * அடியேன் நெடுமாலே! **","கிறி செய்து என்னைப் புறத்திட்டு * இன்னம் கெடுப்பாயோ? *","பிறிது ஒன்று அறியா அடியேன் * ஆவி திகைக்கவே"],0,"/media/recitation/TVM.6.9.8.mp3"],[3439,3439,["Avi thigaikka * aivar kumaikkum chiRRinbam *","pAviyEnaip * pala nI kATTip paDuppAyO? **","thAvi vaiyam koNDa * thaDanthAmaraigaTkE *","kUvik koLLum kAlam * innam kuRugAdhO?"],["ஆவி திகைக்க * ஐவர் குமைக்கும் சிற்றின்பம் *","பாவியேனைப் * பல நீ காட்டிப் படுப்பாயோ? **","தாவி வையம் கொண்ட * தடந்தாமரைகட்கே *","கூவிக் கொள்ளும் காலம் * இன்னம் குறுகாதோ?"],0,"/media/recitation/TVM.6.9.9.mp3"],[3440,3440,["kuRugA nILA * iRudhi kUDA enai Uzhi *","siRugA perugA * aLavil inbam sErndhAlum **","maRukAl inRi mAyOn * unakkE ALAgum *","siRu kAlaththai uRumO? * andhO! theriyilE"],["குறுகா நீளா * இறுதி கூடா எனை ஊழி *","சிறுகா பெருகா * அளவில் இன்பம் சேர்ந்தாலும் **","மறுகால் இன்றி மாயோன் * உனக்கே ஆளாகும் *","சிறு காலத்தை உறுமோ? * அந்தோ! தெரியிலே"],0,"/media/recitation/TVM.6.9.10.mp3"],[3441,3441,["** theridhal ninaidhal * eNNal AgAth thirumAlukku *","uriya thoNDar thoNDar * thoNDan saDakOpan **","theriyach chonna * Or AyiraththuL ippaththum *","uriya thoNDar Akkum * ulagam uNDARkE"],["** தெரிதல் நினைதல் * எண்ணல் ஆகாத் திருமாலுக்கு *","உரிய தொண்டர் தொண்டர் * தொண்டன் சடகோபன் **","தெரியச் சொன்ன * ஓர் ஆயிரத்துள் இப்பத்தும் *","உரிய தொண்டர் ஆக்கும் * உலகம் உண்டாற்கே"],0,"/media/recitation/TVM.6.9.11.mp3"]],[[3442,3442,["** ulagam uNDa peru vAyA! * ulappil kIrththi ammAnE! *","nilavum suDar sUzh oLi mUrththi! * neDiyAy! aDiyEn AruyirE! **","thiladham ulagukkAy ninRa * thiruvEngkaDaththu emperumAnE! *","kula thol aDiyEn una pAdham * kUDum ARu kURAyE"],["** உலகம் உண்ட பெரு வாயா! * உலப்பில் கீர்த்தி அம்மானே! *","நிலவும் சுடர் சூழ் ஒளி மூர்த்தி! * நெடியாய்! அடியேன் ஆருயிரே! **","திலதம் உலகுக்காய் நின்ற * திருவேங்கடத்து எம்பெருமானே! *","குல தொல் அடியேன் உன பாதம் * கூடும் ஆறு கூறாயே"],0,"/media/recitation/TVM.6.10.1.mp3"],[3443,3443,["kURAy nIRAy nilan Agik * koDu val asurar kulam ellAm *","sIRA eRiyum thiru nEmi valavA! * dheyvak kOmAnE! **","sERAr sunaith thAmarai senthI malarum * thiruvEngkaDaththAnE! *","ARA anbil aDiyEn * un aDi sEr vaNNam aruLAyE"],["கூறாய் நீறாய் நிலன் ஆகிக் * கொடு வல் அசுரர் குலம் எல்லாம் *","சீறா எறியும் திரு நேமி வலவா! * தெய்வக் கோமானே! **","சேறார் சுனைத் தாமரை செந்தீ மலரும் * திருவேங்கடத்தானே! *","ஆறா அன்பில் அடியேன் * உன் அடி சேர் வண்ணம் அருளாயே"],0,"/media/recitation/TVM.6.10.2.mp3"],[3444,3444,["vaNNam aruL koL aNi mEga vaNNA! * mAya ammAnE! *","eNNam pugundhu thiththikkum amudhE! * imaiyOr adhipadhiyE! **","theNNal aruvi maNi pon muththalaikkum * thiruvEngkaDaththAnE! *","aNNalE! un aDi sEra * aDiyERku AvA ennAyE"],["வண்ணம் அருள் கொள் அணி மேக வண்ணா! * மாய அம்மானே! *","எண்ணம் புகுந்து தித்திக்கும் அமுதே! * இமையோர் அதிபதியே! **","தெண்ணல் அருவி மணி பொன் முத்தலைக்கும் * திருவேங்கடத்தானே! *","அண்ணலே! உன் அடி சேர * அடியேற்கு ஆவா என்னாயே"],0,"/media/recitation/TVM.6.10.3.mp3"],[3445,3445,["AvA! ennAdhu ulagaththai alaikkum * asurar vANAL mEl *","thI vAy vALi mazhai pozhindha silaiyA! * thiru mA magaL kELvA!","dhEvA! ** surargaL munik kaNanggaL virumbum * thiruvEngkaDaththAnE! *","pUvAr kazhalgaL aru vinaiyEn * porundhum ARu puNarAyE"],["ஆவா! என்னாது உலகத்தை அலைக்கும் * அசுரர் வாணாள் மேல் *","தீ வாய் வாளி மழை பொழிந்த சிலையா! * திரு மா மகள் கேள்வா!","தேவா! ** சுரர்கள் முனிக் கணங்கள் விரும்பும் * திருவேங்கடத்தானே! *","பூவார் கழல்கள் அரு வினையேன் * பொருந்தும் ஆறு புணராயே"],0,"/media/recitation/TVM.6.10.4.mp3"],[3446,3446,["puNarA ninRa maram Ezh * anRu eydha oru vil valavAvO! *","puNarEy ninRa maram iraNDin * naDuvE pOna mudhalvAvO! **","thiNarAr mEgam enak kaLiRu sErum * thiruvEngkaDaththAnE! *","thiNarAr sArnggaththu una pAdham * sErvadhu aDiyEn ennALE?"],["புணரா நின்ற மரம் ஏழ் * அன்று எய்த ஒரு வில் வலவாவோ! *","புணரேய் நின்ற மரம் இரண்டின் * நடுவே போன முதல்வாவோ! **","திணரார் மேகம் எனக் களிறு சேரும் * திருவேங்கடத்தானே! *","திணரார் சார்ங்கத்து உன பாதம் * சேர்வது அடியேன் எந்நாளே?"],0,"/media/recitation/TVM.6.10.5.mp3"],[3447,3447,["ennALE? nAm maN aLandha * iNaith thAmaraigaL kANbadhaRku enRu *","ennALum ninRu imaiyOrgaL Eththi * iRainjchi inam inamAy **","mey nA manaththAl vazhipADu seyyum * thiruvEngkaDaththAnE! *","mey nAn eydhi ennAL * un aDikkaN aDiyEn mEvuvadhE?"],["எந்நாளே? நாம் மண் அளந்த * இணைத் தாமரைகள் காண்பதற்கு என்று *","எந்நாளும் நின்று இமையோர்கள் ஏத்தி * இறைஞ்சி இனம் இனமாய் **","மெய் நா மனத்தால் வழிபாடு செய்யும் * திருவேங்கடத்தானே! *","மெய் நான் எய்தி எந்நாள் * உன் அடிக்கண் அடியேன் மேவுவதே?"],0,"/media/recitation/TVM.6.10.6.mp3"],[3448,3448,["aDiyEn mEvi amarginRa amudhE! * imaiyOr adhipadhiyE! *","koDiyA aDu puL uDaiyAnE! * kOlak kani vAyp perumAnE! **","seDiyAr vinaigaL thIr marundhE! * thiruvEngkaDaththu emperumAnE! *","noDiyAr pozhudhum una pAdham * kANa nOlAdhu ARREnE"],["அடியேன் மேவி அமர்கின்ற அமுதே! * இமையோர் அதிபதியே! *","கொடியா அடு புள் உடையானே! * கோலக் கனி வாய்ப் பெருமானே! **","செடியார் வினைகள் தீர் மருந்தே! * திருவேங்கடத்து எம்பெருமானே! *","நொடியார் பொழுதும் உன பாதம் * காண நோலாது ஆற்றேனே"],0,"/media/recitation/TVM.6.10.7.mp3"],[3449,3449,["nOlAdhu ARREn una pAdham * kANa enRu nuN uNarvin *","nIlAr kaNDaththu ammAnum * niRai nAnmuganum indhiranum **","sElEy kaNNAr palar sUzha virumbum * thiruvEngkaDaththAnE! *","mAlAy mayakki aDiyEn pAl * vandhAy pOlE vArAyE"],["நோலாது ஆற்றேன் உன பாதம் * காண என்று நுண் உணர்வின் *","நீலார் கண்டத்து அம்மானும் * நிறை நான்முகனும் இந்திரனும் **","சேலேய் கண்ணார் பலர் சூழ விரும்பும் * திருவேங்கடத்தானே! *","மாலாய் மயக்கி அடியேன் பால் * வந்தாய் போலே வாராயே"],0,"/media/recitation/TVM.6.10.8.mp3"],[3450,3450,["vandhAy pOlE vArAdhAy * vArAdhAy pOl varuvAnE! *","senthAmaraik kaN sengkani vAy * nAl thOL amudhE! enadhuyirE **","sindhAmaNigaL pagar allaip pagal sey * thiruvEngkaDaththAnE! *","andhO! aDiyEn una pAdham * agala killEn iRaiyumE"],["வந்தாய் போலே வாராதாய் * வாராதாய் போல் வருவானே! *","செந்தாமரைக் கண் செங்கனி வாய் * நால் தோள் அமுதே! எனதுயிரே **","சிந்தாமணிகள் பகர் அல்லைப் பகல் செய் * திருவேங்கடத்தானே! *","அந்தோ! அடியேன் உன பாதம் * அகல கில்லேன் இறையுமே"],0,"/media/recitation/TVM.6.10.9.mp3"],[3451,3451,["** agala killEn iRaiyum enRu * alar mEl manggai uRai mArbA! *","nigaril pugazhAy! ulagam mUnRu uDaiyAy! * ennai ALvAnE! **","nigaril amarar munik kaNanggaL virumbum * thiruvEngkaDaththAnE! *","pugal onRillA aDiyEn * un aDik kIzh amarndhu pugundhEnE"],["** அகல கில்லேன் இறையும் என்று * அலர் மேல் மங்கை உறை மார்பா! *","நிகரில் புகழாய்! உலகம் மூன்று உடையாய்! என்னை ஆள்வானே! **","நிகரில் அமரர் முனிக் கணங்கள் விரும்பும் * திருவேங்கடத்தானே! *","புகல் ஒன்றில்லா அடியேன் * உன் அடிக் கீழ் அமர்ந்து புகுந்தேனே"],0,"/media/recitation/TVM.6.10.10.mp3"],[3452,3452,["** aDik kIzh amarndhu pugundhu * aDiyIr! vAzhmin enRenRu aruL koDukkum *","paDik kEzh illAp perumAnaip * pazhanak kurugUrch saDakOpan **","muDippAn sonna Ayiraththuth * thiruvEngkaDaththukku ivai paththum *","piDiththAr piDiththAr vIRRirundhu * periya vAnuL nilAvuvarE"],["** அடிக் கீழ் அமர்ந்து புகுந்து * அடியீர்! வாழ்மின் என்றென்று அருள் கொடுக்கும் *","படிக் கேழ் இல்லாப் பெருமானைப் * பழனக் குருகூர்ச் சடகோபன் **","முடிப்பான் சொன்ன ஆயிரத்துத் * திருவேங்கடத்துக்கு இவை பத்தும் *","பிடித்தார் பிடித்தார் வீற்றிருந்து * பெரிய வானுள் நிலாவுவரே"],0,"/media/recitation/TVM.6.10.11.mp3"]]]