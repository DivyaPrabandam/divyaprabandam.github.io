[[[1952,1952,["** kunRam onRu eDuththu Endhi * mAmazhai","anRu kAththa ammAn ** arakkarai","venRa villiyAr * vIramE kolO? *","thenRal vandhu * thI vIsum en seygEn?"],["** குன்றம் ஒன்று எடுத்து ஏந்தி * மாமழை","அன்று காத்த அம்மான் ** அரக்கரை","வென்ற வில்லியார் * வீரமே கொலோ? *","தென்றல் வந்து * தீ வீசும் என் செய்கேன்?"],0,"/media/recitation/PT.11.1.1.mp3"],[1953,1953,["kārum vār paṉik * kaṭalum aṉṉavaṉ *","tārum mārvamum * kaṇṭa taṇṭamo- **","corum mā mukil * tul̤iyiṉūṭu vantu *","īra vāṭai-tāṉ * īrum ĕṉṉaiye?"],["காரும் வார் பனிக் * கடலும் அன்னவன் *","தாரும் மார்வமும் * கண்ட தண்டமோ **","சோரும் மா முகில் * துளியினூடு வந்து *","ஈர வாடை தான் * ஈரும் என்னையே?"],1,"/media/recitation/PT.11.1.2.mp3"],[1954,1954,["sanggum mAmaiyum * thaLarum mEni mEl *","thinggaL vengkadhir * sIRum en seygEn? **","ponggu veNthiraip * puNari vaNNanAr *","konggalArndha thAr * kUvum ennaiyE"],["சங்கும் மாமையும் * தளரும் மேனி மேல் *","திங்கள் வெங்கதிர் * சீறும் என் செய்கேன்? **","பொங்கு வெண்திரைப் * புணரி வண்ணனார் *","கொங்கலார்ந்த தார் * கூவும் என்னையே"],0,"/media/recitation/PT.11.1.3.mp3"],[1955,1955,["anggOr AykkulaththuL * vaLarndhu senRu *","anggOr thAy uruvAgi vandhavaL **","konggai nanjchuNDa * kOyinmai kolO? *","thinggaL vengkadhir * sIRuginRadhE"],["அங்கோர் ஆய்க்குலத்துள் * வளர்ந்து சென்று *","அங்கோர் தாய் உருவாகி வந்தவள் **","கொங்கை நஞ்சு உண்ட * கோயின்மை கொலோ? *","திங்கள் வெங்கதிர் * சீறுகின்றதே"],0,"/media/recitation/PT.11.1.4.mp3"],[1956,1956,["anggu Or AL ariyAy * avuNanai *","panggamA * iru kURu seydhavan **","manggul mAmadhi * vAnggavE kolO? *","ponggu mAkaDal * pulambuginRadhE"],["அங்கோர் ஆள் அரியாய் * அவுணனை *","பங்கமா * இரு கூறு செய்தவன் **","மங்குல் மாமதி * வாங்கவே கொலோ? *","பொங்கு மாகடல் * புலம்புகின்றதே"],0,"/media/recitation/PT.11.1.5.mp3"],[1957,1957,["senRu vAr silai vaLaiththu * ilanggaiyai","venRa villiyAr * vIramE kolO? **","munRil peNNai mEl * muLarik kUTTagaththu *","anRilin kural * aDarum ennaiyE"],["சென்று வார் சிலை வளைத்து * இலங்கையை *","வென்ற வில்லியார் * வீரமே கொலோ? **","முன்றில் பெண்ணை மேல் * முளரிக் கூட்டகத்து *","அன்றிலின் குரல் * அடரும் என்னையே"],0,"/media/recitation/PT.11.1.6.mp3"],[1958,1958,["pUvai vaNNanAr * puLLin mEl vara *","mEvi ninRu nAn * kaNDa thaNDamO? **","vIvil aingkaNai * villi ambu kOththu *","AviyE * ilakkAga eyvadhE!"],["பூவை வண்ணனார் * புள்ளின் மேல் வர *","மேவி நின்று நான் * கண்ட தண்டமோ? **","வீவில் ஐங்கணை * வில்லி அம்பு கோத்து *","ஆவியே * இலக்காக எய்வதே!"],0,"/media/recitation/PT.11.1.7.mp3"],[1959,1959,["mAl inam thuzhAy * varum en nenjchagam *","mAlin anthuzhAy * vandhu ennuL puga **","kOla vADaiyum * koNDu vandhadhOr *","Ali vandhadhAl * aridhu kAvalE"],["மால் இனம் துழாய் * வரும் என் நெஞ்சகம் *","மாலின் அந்துழாய் * வந்து என்னுள் புக **","கோல வாடையும் * கொண்டு வந்ததோர் *","ஆலி வந்ததால் * அரிது காவலே"],0,"/media/recitation/PT.11.1.8.mp3"],[1960,1960,["keNDai oNkaNum thuyilum * en niRam","paNDu paNDu pOl okkum ** mikka sIrth","thoNDar iTTa * pUnthuLavin vAsamE *","vaNDu koNDu vandhu * Udhum AgilE"],["கெண்டை ஒண்கணும் துயிலும் * என் நிறம்","பண்டு பண்டு போல் ஒக்கும் ** மிக்க சீர்த்","தொண்டர் இட்ட * பூந்துளவின் வாசமே *","வண்டு கொண்டு வந்து * ஊதும் ஆகிலே"],0,"/media/recitation/PT.11.1.9.mp3"],[1961,1961,["** anRu pAradhaththu * aivar thUdhanAy *","senRa mAyanaich * sengkaN mAlinai **","manRil Ar pugazh * manggai vATkali","kanRi * sol vallArkku * allal illaiyE"],["** அன்று பாரதத்து * ஐவர் தூதனாய் *","சென்ற மாயனைச் * செங்கண் மாலினை **","மன்றில் ஆர் புகழ் * மங்கை வாட்கலி","கன்றி * சொல் வல்லார்க்கு * அல்லல் இல்லையே"],0,"/media/recitation/PT.11.1.10.mp3"]],[[1962,1962,["** kunRam eDuththu mazhai","thaDuththu * iLaiyAroDum *","manRil kuravai piNaindha","mAl * ennai mAl seydhAn **","munRil thani ninRa peNNai","mEl * kiDandhu IrginRa *","anRilin kUTTaip * pirikka","kiRpavar Ar kolO?"],["** குன்றம் எடுத்து மழை","தடுத்து * இளையாரொடும் *","மன்றில் குரவை பிணைந்த","மால் * என்னை மால் செய்தான் **","முன்றில் தனி நின்ற பெண்ணை","மேல் * கிடந்து ஈர்கின்ற *","அன்றிலின் கூட்டைப் * பிரிக்க","கிற்பவர் ஆர் கொலோ?"],0,"/media/recitation/PT.11.2.1.mp3"],[1963,1963,["pUngkurundhu osiththu Anai","kAyndhu * arimAch cheguththu *","Anggu vEzhaththin kombu","koNDu * vanpEy mulai","vAnggi uNDa ** avvAyan","niRka * ivvAyan vAy *","Enggu vEyngkuzhal * ennODu","ADum iLamaiyE"],["பூங்குருந்து ஒசித்து ஆனை","காய்ந்து * அரிமாச் செகுத்து *","ஆங்கு வேழத்தின் கொம்பு","கொண்டு * வன்பேய் முலை","வாங்கி உண்ட ** அவ்வாயன்","நிற்க * இவ்வாயன் வாய் *","ஏங்கு வேய்ங்குழல் * என்னோடு","ஆடும் இளமையே"],0,"/media/recitation/PT.11.2.2.mp3"],[1964,1964,["malloDu kanjchanum thunjcha *","venRa maNivaNNan *","allimalarth thaNthuzhAy *","ninaindhu irundhEnaiyE **","elliyin mArudham vandhaDum *","adhu anRiyum *","kollai val ERRin maNiyum *","kOyinmai seyyumE"],["மல்லொடு கஞ்சனும் துஞ்ச *","வென்ற மணிவண்ணன் *","அல்லிமலர்த் தண்துழாய் *","நினைந்து இருந்தேனையே **","எல்லியின் மாருதம் வந்தடும் *","அது அன்றியும் *","கொல்லை வல் ஏற்றின் மணியும் *","கோயின்மை செய்யுமே"],0,"/media/recitation/PT.11.2.3.mp3"],[1965,1965,["porundhu mAmaram * Ezhum","eydha punidhanAr *","thirundhu sEvaDi * en","manaththu ninai thoRum **","karunthaN mAkaDal * kanggul","Arkkum adhu anRiyum *","varundha vADai varum *","idhaRku ini en seygEn?"],["பொருந்து மாமரம் * ஏழும்","எய்த புனிதனார் *","திருந்து சேவடி * என்","மனத்து நினை தொறும் **","கருந்தண் மாகடல் * கங்குல்","ஆர்க்கும் அது அன்றியும் *","வருந்த வாடை வரும் *","இதற்கு இனி என் செய்கேன்?"],0,"/media/recitation/PT.11.2.4.mp3"],[1966,1966,["annai munivadhum * anRilin","kural Irvadhum *","mannu maRikaDal Arppadhum *","vaLai sOrvadhum **","pon angkalai algul * anna","mennaDaip pUngkuzhal *","pinnai maNALar * thiRaththam Ayina","pinnaiyE"],["அன்னை முனிவதும் * அன்றிலின்","குரல் ஈர்வதும் *","மன்னு மறிகடல் ஆர்ப்பதும் *","வளை சோர்வதும் **","பொன் அங்கலை அல்குல் * அன்ன","மென்னடைப் பூங்குழல் *","பின்னை மணாளர் * திறத்தம் ஆயின","பின்னையே"],0,"/media/recitation/PT.11.2.5.mp3"],[1967,1967,["āzhiyum caṅkum uṭaiya * naṅkal̤ aṭikal̤-tām *","pāzhimaiyāṉa kaṉavil * nammaip pakarvittār **","tozhiyum nāṉum ŏzhiya * vaiyam tuyiṉṟatu *","kozhiyum kūkiṉṟatu illaik * kūr irul̤ āyiṟṟe"],["ஆழியும் சங்கும் உடைய * நங்கள் அடிகள் தாம் *","பாழிமையான கனவில் * நம்மைப் பகர்வித்தார் **","தோழியும் நானும் ஒழிய * வையம் துயின்றது *","கோழியும் கூகின்றது இல்லைக் * கூர் இருள் ஆயிற்றே"],1,"/media/recitation/PT.11.2.6.mp3"],[1968,1968,["kAman thanakku muRai","allEn * kaDal vaNNanAr *","mAmaNavALar * enakkuth","thAnum magan sollil **","yAmanggaL thORu eri vIsum *","en iLam konggaigaL *","mAmaNi vaNNar * thiRaththavAy","vaLarginRavE"],["காமன் தனக்கு முறை","அல்லேன் * கடல் வண்ணனார் *","மாமணவாளர் * எனக்குத்","தானும் மகன் சொல்லில் **","யாமங்கள் தோறு எரி வீசும் *","என் இளம் கொங்கைகள் *","மாமணி வண்ணர் * திறத்தவாய்","வளர்கின்றவே"],0,"/media/recitation/PT.11.2.7.mp3"],[1969,1969,["manjchuRu mAlirunjchOlai *","ninRa maNALanAr *","nenjcham niRai koNDu pOyinAr *","ninaiginRilar **","venjchuDar pOy viDiyAmal *","evviDam pukkadhO! *","nanjchu uDalam thuyinRAl *","namakku ini nalladhE"],["** மஞ்சுறு மாலிருஞ்சோலை *","நின்ற மணாளனார் *","நெஞ்சம் நிறை கொண்டு போயினார் *","நினைகின்றிலர் **","வெஞ்சுடர் போய் விடியாமல் *","எவ்விடம் புக்கதோ! *","நஞ்சு உடலம் துயின்றால் *","நமக்கு இனி நல்லதே"],0,"/media/recitation/PT.11.2.8.mp3"],[1970,1970,["kAman kaNaikku Or ilakkamAy *","nalaththin migu *","pUmaru kOla * nam peNmai","sindhiththu irAdhu pOy **","thUmalar nIrkoDu * thOzhi!","nAm thozhudhu EththinAl *","kAr mugil vaNNaraik * kaNgaLAl","kANalAm kolO?"],["காமன் கணைக்கு ஓர் இலக்கமாய் *","நலத்தின் மிகு *","பூமரு கோல * நம் பெண்மை","சிந்தித்து இராது போய் **","தூமலர் நீர்கொடு * தோழி!","நாம் தொழுது ஏத்தினால் *","கார் முகில் வண்ணரைக் * கண்களால்","காணலாம் கொலோ?"],0,"/media/recitation/PT.11.2.9.mp3"],[1971,1971,["** venRi viDai uDan *","Ezh aDarththa aDigaLai *","manRil malipugazh * manggai man","kalikanRi sol **","onRu ninRa onbadhum *","uraippavar thanggaL mEl *","enRum nillA vinai * onRum","sollil ulagilE"],["** வென்றி விடை உடன் *","ஏழ் அடர்த்த அடிகளை *","மன்றில் மலிபுகழ் * மங்கை மன்","கலிகன்றி சொல் **","ஒன்று நின்ற ஒன்பதும் *","உரைப்பவர் தங்கள் மேல் *","என்றும் நி