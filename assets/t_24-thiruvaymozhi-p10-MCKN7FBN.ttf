[[[3783,3783,["** thALa thAmaraith * thaDam aNi vayal thirumOgUr *","nALu mEvi nankamarndhu ninRu * asuraraith thagarkkum **","thOLu nAnku uDaich * suri kuzhal kamalak kaN kani vAy *","kALamEgaththai anRi * maRRonRu ilam kathiyE"],["** தாள தாமரைத் * தடம் அணி வயல் திருமோகூர் *","நாளு மேவி நன்கமர்ந்து நின்று * அசுரரைத் தகர்க்கும் **","தோளு நான்கு உடைச் * சுரி குழல் கமலக் கண் கனி வாய் *","காளமேகத்தை அன்றி * மற்றொன்று இலம் கதியே"],0,"/media/recitation/TVM.10.1.1.mp3"],[3784,3784,["ilam kathi maRRonRu emmaikkum * In thaNthuzhAyin *","alanggal angkaNNi * Ayiram pEr uDai ammAn **","nalangkoL nAnmaRai vANargaL vAzh * thirumOgUr *","nalangkazhal avan aDi nizhal * thaDam anRi yAmE"],["இலம் கதி மற்றொன்று எம்மைக்கும் * ஈன் தண்துழாயின் *","அலங்கல் அங்கண்ணி * ஆயிரம் பேர் உடை அம்மான் **","நலங்கொள் நான்மறை வாணர்கள் வாழ் * திருமோகூர் *","நலங்கழல் அவன் அடி நிழல் * தடம் அன்றி யாமே"],0,"/media/recitation/TVM.10.1.2.mp3"],[3785,3785,["anRi yAm oru pugal iDam * ilam enRenRu alaRRi *","ninRu nAnmugan aranoDu * dhEvargaL nADa **","venRu immUvulagu aLiththu * uzhalvAn thirumOgUr *","nanRu nAm ini naNugudhum * namadhu iDar keDavE"],["அன்றி யாம் ஒரு புகல் இடம் * இலம் என்றென்று அலற்றி *","நின்று நான்முகன் அரனொடு * தேவர்கள் நாட **","வென்று இம்மூவுலகு அளித்து * உழல்வான் திருமோகூர் *","நன்று நாம் இனி நணுகுதும் * நமது இடர் கெடவே"],0,"/media/recitation/TVM.10.1.3.mp3"],[3786,3786,["iDar keDa emmaip pOndhu aLiyAy * enRenRu Eththi *","suDar koL sOdhiyaith * dhEvarum munivarum thoDara **","paDar koL pAmbaNaip * paLLi koLvAn thirumOgUr *","iDar keDa aDi paravudhum * thoNDIr! vamminE"],["இடர் கெட எம்மைப் போந்து அளியாய் * என்றென்று ஏத்தி *","சுடர் கொள் சோதியைத் * தேவரும் முனிவரும் தொடர **","படர் கொள் பாம்பணைப் * பள்ளி கொள்வான் திருமோகூர் *","இடர் கெட அடி பரவுதும் * தொண்டீர்! வம்மினே"],0,"/media/recitation/TVM.10.1.4.mp3"],[3787,3787,["thoNDIr! vammin * nam suDar oLi oru thani mudhalvan *","aNDa mUvulagu aLandhavan * aNi thirumOgUr **","eNDisaiyum In karumboDu * perunjchennel viLaiya *","koNDa kOyilai valam seydhu * inggu ADudhum kUththE"],["தொண்டீர்! வம்மின் * நம் சுடர் ஒளி ஒரு தனி முதல்வன் *","அண்ட மூவுலகு அளந்தவன் * அணி திருமோகூர் **","எண்டிசையும் ஈன் கரும்பொடு * பெருஞ்செந்நெல் விளைய *","கொண்ட கோயிலை வலம் செய்து * இங்கு ஆடுதும் கூத்தே"],0,"/media/recitation/TVM.10.1.5.mp3"],[3788,3788,["kUththan kOvalan * kudhaRRu val asurargaL kURRam *","Eththum nanggaTkum * amararkkum munivarkkum inban **","vAyththa thaN paNai vaLa vayal sUzh * thirumOgUr","Aththan * thAmarai aDi anRi * maRRilam araNE"],["கூத்தன் கோவலன் * குதற்று வல் அசுரர்கள் கூற்றம் *","ஏத்தும் நங்கட்கும் * அமரர்க்கும் முனிவர்க்கும் இன்பன் **","வாய்த்த தண் பணை வள வயல் சூழ் * திருமோகூர்","ஆத்தன் * தாமரை அடி அன்றி * மற்றிலம் அரணே"],0,"/media/recitation/TVM.10.1.6.mp3"],[3789,3789,["maRRilam araN vAn * perum pAzh thani mudhalA *","suRRum nIr paDaiththu * adhan vazhith thol muni mudhalA **","muRRum dhEvarODu * ulagu seyvAn thirumOgUr *","suRRi nAm valam seyya * nam thuyar keDum kaDidhE"],["மற்றிலம் அரண் வான் * பெரும் பாழ் தனி முதலா *","சுற்றும் நீர் படைத்து * அதன் வழித் தொல் முனி முதலா **","முற்றும் தேவரோடு * உலகு செய்வான் திருமோகூர் *","சுற்றி நாம் வலம் செய்ய * நம் துயர் கெடும் கடிதே"],0,"/media/recitation/TVM.10.1.7.mp3"],[3790,3790,["thuyar keDum kaDidhu aDaindhu vandhu * aDiyavar thozhumin *","uyar koL sOlai * oN thaDa maNi oLi thirumOgUr **","peyargaL Ayiram uDaiya * val arakkar pukku azhundha *","thayaradhan peRRa * maradhaga maNith thaDaththinaiyE"],["துயர் கெடும் கடிது அடைந்து வந்து * அடியவர் தொழுமின் *","உயர் கொள் சோலை * ஒண் தட மணி ஒளி திருமோகூர் **","பெயர்கள் ஆயிரம் உடைய * வல் அரக்கர் புக்கு அழுந்த *","தயரதன் பெற்ற * மரதக மணித் தடத்தினையே"],0,"/media/recitation/TVM.10.1.8.mp3"],[3791,3791,["maNith thaDaththaDi malark kaNgaL * pavaLach sevvAy *","aNik koL nAl thaDanthOL dheyvam * asurarai enRum **","thuNikkum val araTTan * uRai pozhil thirumOgUr *","naNiththu nammuDai nal araN * nAm aDaindhanamE"],["மணித் தடத்தடி மலர்க் கண்கள் * பவளச் செவ்வாய் *","அணிக் கொள் நால் தடந்தோள் தெய்வம் * அசுரரை என்றும் **","துணிக்கும் வல் அரட்டன் * உறை பொழில் திருமோகூர் *","நணித்து நம்முடை நல் அரண் * நாம் அடைந்தனமே"],0,"/media/recitation/TVM.10.1.9.mp3"],[3792,3792,["nAm aDaindha nal araN * namakku enRu nal amarar *","thImai seyyum val asurarai * anjchich senRu aDaindhAl **","kAma rUpam koNDu * ezhundhu aLippAn thirumOgUr *","nAmamE navinRu eNNumin * Eththumin namargAL!"],["நாம் அடைந்த நல் அரண் * நமக்கு என்று நல் அமரர் *","தீமை செய்யும் வல் அசுரரை * அஞ்சிச் சென்று அடைந்தால் **","காம ரூபம் கொண்டு * எழுந்து அளிப்பான் திருமோகூர் *","நாமமே நவின்று எண்ணுமின் * ஏத்துமின் நமர்காள்!"],0,"/media/recitation/TVM.10.1.10.mp3"],[3793,3793,["** Eththumin namargAL! * enRu thAn kuDam ADu","kUththanai * kurugUrch saDakOpan kuRREvalgaL **","vAyththa AyiraththuL ivai * vaN thirumOgUrkku *","Iththa paththu ivai Eththa vallArkku * iDar keDumE"],["** ஏத்துமின் நமர்காள்! * என்று தான் குடம் ஆடு","கூத்தனை * குருகூர்ச் சடகோபன் குற்றேவல்கள் **","வாய்த்த ஆயிரத்துள் இவை * வண் திருமோகூர்க்கு *","ஈத்த பத்து இவை ஏத்த வல்லார்க்கு * இடர் கெடுமே"],0,"/media/recitation/TVM.10.1.11.mp3"]],[[3794,3794,["** keDum iDar Aya ellAm * kEsavA enna * nALum","koDu vinai seyyum * kURRin thamargaLum kuRuga killAr **","viDam uDai aravil paLLi * virumbinAn surumbu alaRRum *","thaDam uDai vayal * ananthapura nagarp pugudhum inRE"],["** கெடும் இடர் ஆய எல்லாம் * கேசவா என்ன * நாளும்","கொடு வினை செய்யும் * கூற்றின் தமர்களும் குறுக கில்லார் **","விடம் உடை அரவில் பள்ளி * விரும்பினான் சுரும்பு அலற்றும் *","தடம் உடை வயல் * அனந்தபுர நகர்ப் புகுதும் இன்றே"],0,"/media/recitation/TVM.10.2.1.mp3"],[3795,3795,["inRu pOyp pugudhir Agil * ezhumaiyum Edham sAra *","kunRu nEr mADa mADE * kurundhu sEr serundhi punnai **","manRu alar pozhil * ananthapura nagar mAyan nAmam *","onRum Or AyiramAm * uLLuvArkku umbar UrE"],["இன்று போய்ப் புகுதிர் ஆகில் * எழுமையும் ஏதம் சார *","குன்று நேர் மாட மாடே * குருந்து சேர் செருந்தி புன்னை **","மன்று அலர் பொழில் * அனந்தபுர நகர் மாயன் நாமம் *","ஒன்றும் ஓர் ஆயிரமாம் * உள்ளுவார்க்கு உம்பர் ஊரே"],0,"/media/recitation/TVM.10.2.2.mp3"],[3796,3796,["Urum puTkoDiyum aqdhE * ulagellAm uNDu umizhndhAn *","sErum thaN ananthapuram * sikkenap pugudhir Agil **","thIrum nOy vinaigaL ellAm * thiNNam nAm aRiyach sonnOm *","pErum Or AyiraththuL * onRu nIr pEsuminE"],["ஊரும் புட்கொடியும் அஃதே * உலகெல்லாம் உண்டு உமிழ்ந்தான் *","சேரும் தண் அனந்தபுரம் * சிக்கெனப் புகுதிர் ஆகில் **","தீரும் நோய் வினைகள் எல்லாம் * திண்ணம் நாம் அறியச் சொன்னோம் *","பேரும் ஓர் ஆயிரத்துள் * ஒன்று நீர் பேசுமினே"],0,"/media/recitation/TVM.10.2.3.mp3"],[3797,3797,["pEsumin kUsam inRip * periya nIr vElai sUzhndhu *","vAsamE kamazhum sOlai * vayal aNi ananthapuram **","nEsam seydhu uRaiginRAnai * neRimaiyAl malargaL thUvi *","pUsanai seyginRArgaL * puNNiyam seydha ARE!"],["பேசுமின் கூசம் இன்றிப் * பெரிய நீர் வேலை சூழ்ந்து *","வாசமே கமழும் சோலை * வயல் அணி அனந்தபுரம் **","நேசம் செய்து உறைகின்றானை * நெறிமையால் மலர்கள் தூவி *","பூசனை செய்கின்றார்கள் * புண்ணியம் செய்த ஆறே!"],0,"/media/recitation/TVM.10.2.4.mp3"],[3798,3798,["puNNiyam seydhu * nalla punaloDu malargaL thUvi *","eNNumin endhai nAmam * ippiRappu aRukkum appAl **","thiNNa nAm aRiyach sonnOm * seRi pozhil ananthapuraththu *","aNNalAr kamala pAdham * aNuguvAr amarar AvAr"],["புண்ணியம் செய்து * நல்ல புனலொடு மலர்கள் தூவி *","எண்ணுமின் எந்தை நாமம் * இப்பிறப்பு அறுக்கும் அப்பால் **","திண்ண நாம் அறியச் சொன்னோம் * செறி பொழில் அனந்தபுரத்து *","அண்ணலார் கமல பாதம் * அணுகுவார் அமரர் ஆவார்"],0,"/media/recitation/TVM.10.2.5.mp3"],[3799,3799,["amararAyth thiriginRArgaTku * Adhi sEr ananthapuraththu *","amarar kOn archchikkinRu * anggu agap paNi seyvar viNNOr **","namargaLO! sollak kENmin * nAmum pOy naNuga vENDum *","kumaranAr thAdhai thunbam * thuDaiththa gOvindhanArE"],["அமரராய்த் திரிகின்றார்கட்கு * ஆதி சேர் அனந்தபுரத்து *","அமரர் கோன் அர்ச்சிக்கின்று * அங்கு அகப் பணி செய்வர் விண்ணோர் **","நமர்களோ! சொல்லக் கேண்மின் * நாமும் போய் நணுக வேண்டும் *","குமரனார் தாதை துன்பம் * துடைத்த கோவிந்தனாரே"],0,"/media/recitation/TVM.10.2.6.mp3"],[3800,3800,["thuDaiththa gOvindhanArE * ulagu uyir thEvum maRRum *","paDaiththa em parama mUrththi * pAmbaNaip paLLi koNDAn **","maDaith thalai vALai pAyum * vayal aNi ananthapuram *","kaDaiththalai sIykkap peRRAl * kaDu vinai kaLaiyalAmE"],["துடைத்த கோவிந்தனாரே * உலகு உயிர் தேவும் மற்றும் *","படைத்த எம் பரம மூர்த்தி * பாம்பணைப் பள்ளி கொண்டான் **","மடைத் தலை வாளை பாயும் * வயல் அணி அனந்தபுரம் *","கடைத்தலை சீய்க்கப் பெற்றால் * கடு வினை களையலாமே"],0,"/media/recitation/TVM.10.2.7.mp3"],[3801,3801,["kaDu vinai kaLaiyal Agum * kAmanaip payandha kALai *","iDavagai koNDadhu enbar * ezhil aNi ananthapuram **","paDam uDai aravil paLLi * payinRavan pAdham kANa *","naDaminO namargaL uLLIr! * nAm umakku aRiyach sonnOm"],["கடு வினை களையல் ஆகும் * காமனைப் பயந்த காளை *","இடவகை கொண்டது என்பர் * எழில் அணி அனந்தபுரம் **","படம் உடை அரவில் பள்ளி * பயின்றவன் பாதம் காண *","நடமினோ நமர்கள் உள்ளீர்! * நாம் உமக்கு அறியச் சொன்னோம்"],0,"/media/recitation/TVM.10.2.8.mp3"],[3802,3802,["nAm umakku aRiyach sonna * nALgaLum naNiya Ana *","sEmam nanku uDaiththuk kaNDIr * seRi pozhil ananthapuram **","thUma nal virai malargaL * thuvaL aRa Ayndhu koNDu *","vAmanan aDikku enRu Eththa * mAyndhu aRum vinaigaL thAmE"],["நாம் உமக்கு அறியச் சொன்ன * நாள்களும் நணிய ஆன *","சேமம் நன்கு உடைத்துக் கண்டீர் * செறி பொழில் அனந்தபுரம் **","தூம நல் விரை மலர்கள் * துவள் அற ஆய்ந்து கொண்டு *","வாமனன் அடிக்கு என்று ஏத்த * மாய்ந்து அறும் வினைகள் தாமே"],0,"/media/recitation/TVM.10.2.9.mp3"],[3803,3803,["mAyndhu aRum vinaigaL thAmE * mAdhavA! enna * nALum","Eyndha pon madhiL * ananthapura nagar endhaikku enRu **","sAndhoDu viLakkam dhUpam * thAmarai malargaL nalla *","Ayndhu koNDu Eththa vallAr * andhamil pugazhinArE"],["மாய்ந்து அறும் வினைகள் தாமே * மாதவா! என்ன * நாளும்","ஏய்ந்த பொன் மதிள் * அனந்தபுர நகர் எந்தைக்கு என்று **","சாந்தொடு விளக்கம் தூபம் * தாமரை மலர்கள் நல்ல *","ஆய்ந்து கொண்டு ஏத்த வல்லார் * அந்தமில் புகழினாரே"],0,"/media/recitation/TVM.10.2.10.mp3"],[3804,3804,["** andhamil pugazh * ananthapura nagar Adhi thannai *","kondhalar pozhil * kurugUr mARan sol AyiraththuL **","aindhinODu aindhum vallAr * aNaivar pOy amar ulagil *","painthoDi maDandhaiyar tham * vEy maru thOL iNaiyE"],["** அந்தமில் புகழ் * அனந்தபுர நகர் ஆதி தன்னை *","கொந்தலர் பொழில் * குருகூர் மாறன் சொல் ஆயிரத்துள் **","ஐந்தினோடு ஐந்தும் வல்லார் * அணைவர் போய் அமர் உலகில் *","பைந்தொடி மடந்தையர் தம் * வேய் மரு தோள் இணையே"],0,"/media/recitation/TVM.10.2.11.mp3"]],[[3805,3805,["** vEy maru thOL iNai meliyum AlO! *","melivum en thanimaiyum yAdhum nOkkA *","kAmaru kuyilgaLum kUvum AlO! *","kaNa mayil avai kalandhu Alum AlO! **","A maruvu ina nirai mEykka nI pOkku *","oru pagal Ayiram Uzhi AlO! *","thAmaraik kaNgaL koNDu Irdhi AlO! *","thagavilai thagavilaiyE nI kaNNA!"],["** வேய் மரு தோள் இணை மெலியும் ஆலோ! *","மெலிவும் என் தனிமையும் யாதும் நோக்கா *","காமரு குயில்களும் கூவும் ஆலோ! *","கண மயில் அவை கலந்து ஆலும் ஆலோ! **","ஆ மருவு இன நிரை மேய்க்க நீ போக்கு *","ஒரு பகல் ஆயிரம் ஊழி ஆலோ! *","தாமரைக் கண்கள் கொண்டு ஈர்தி ஆலோ! *","தகவிலை தகவிலையே நீ கண்ணா!"],0,"/media/recitation/TVM.10.3.1.mp3"],[3806,3806,["thagavilai thagavilaiyE nI kaNNA! *","thaDa mulai puNar thoRum puNarchchikku ArA *","suga veLLam visumbu iRandhu aRivai mUzhkkach","sUzhndhu * adhu kanavena nInggi AnggE **","aga uyir agam agam thORum uL pukku *","Aviyin param alla vETkai andhO! *","miga miga ini unnaip pirivai AmAl *","vIva nin pasu nirai mEykkap pOkkE"],["தகவிலை தகவிலையே நீ கண்ணா! *","தட முலை புணர் தொறும் புணர்ச்சிக்கு ஆரா *","சுக வெள்ளம் விசும்பு இறந்து அறிவை மூழ்க்கச்","சூழ்ந்து * அது கனவென நீங்கி ஆங்கே **","அக உயிர் அகம் அகம் தோறும் உள் புக்கு *","ஆவியின் பரம் அல்ல வேட்கை அந்தோ! *","மிக மிக இனி உன்னைப் பிரிவை ஆமால் *","வீவ நின் பசு நிரை மேய்க்கப் போக்கே"],0,"/media/recitation/TVM.10.3.2.mp3"],[3807,3807,["vIvan nin pasu nirai mEykkap pOkku *","vevvuyir koNDu enadhu Avi vEmAl *","yAvarum thuNai illai yAn irundhu *","un anjchana mEniyai ATTam kANEn **","pOvadhu anRu oru pagal nI aganRAl *","porukayaR kaN iNai nIrum nillA *","sAvadhu ivvAyk kulaththu AychchiyOmAyp","piRandha * iththozhuththaiyOm thanimai thAnE"],["வீவன் நின் பசு நிரை மேய்க்கப் போக்கு *","வெவ்வுயிர் கொண்டு எனது ஆவி வேமால் *","யாவரும் துணை இல்லை யான் இருந்து *","உன் அஞ்சன மேனியை ஆட்டம் காணேன் **","போவது அன்று ஒரு பகல் நீ அகன்றால் *","பொருகயற் கண் இணை நீரும் நில்லா *","சாவது இவ்வாய்க் குலத்து ஆய்ச்சியோமாய்ப்","பிறந்த * இத்தொழுத்தையோம் தனிமை தானே"],0,"/media/recitation/TVM.10.3.3.mp3"],[3808,3808,["thozhuththaiyOm thanimaiyum thuNai pirindhAr","thuyaramum * ninaigilai gOvindhA! * nin","thozhuth thanil pasukkaLaiyE virumbith *","thuRandhu emmai iTTu avai mEykkap pOdhi **","pazhuththa nal amudhin in sARRu veLLam *","pAviyEn manam agam thORum uL pukku","azhuththa * nin sengkani vAyin kaLvap","paNi mozhi * ninaithoRum Avi vEmAl"],["தொழுத்தையோம் தனிமையும் துணை பிரிந்தார்","துயரமும் * நினைகிலை கோவிந்தா! * நின்","தொழுத் தனில் பசுக்களையே விரும்பித் *","துறந்து எம்மை இட்டு அவை மேய்க்கப் போதி **","பழுத்த நல் அமுதின் இன் சாற்று வெள்ளம் *","பாவியேன் மனம் அகம் தோறும் உள் புக்கு","அழுத்த * நின் செங்கனி வாயின் கள்வப்","பணி மொழி * நினைதொறும் ஆவி வேமால்"],0,"/media/recitation/TVM.10.3.4.mp3"],[3809,3809,["paNi mozhi ninaithoRum Avi vEmAl *","pagal nirai mEykkiya pOya kaNNA! *","piNi avizh malligai vADai thUvap *","peru madha mAlaiyum vandhinRu AlO! **","maNi migu mArvinin mullaip pOdhu * en","vana mulai kamazhviththu un vAy amudham thandhu *","aNi migu thAmaraik kaiyai andhO! *","aDichchiyOm thalai misai nI aNiyAy"],["பணி மொழி நினைதொறும் ஆவி வேமால் *","பகல் நிரை மேய்க்கிய போய கண்ணா! *","பிணி அவிழ் மல்லிகை வாடை தூவப் *","பெரு மத மாலையும் வந்தின்று ஆலோ! **","மணி மிகு மார்வினின் முல்லைப் போது * என்","வன முலை கமழ்வித்து உன் வாய் அமுதம் தந்து *","அணி மிகு தாமரைக் கையை அந்தோ! *","அடிச்சியோம் தலை மிசை நீ அணியாய்"],0,"/media/recitation/TVM.10.3.5.mp3"],[3810,3810,["aDichchiyOm thalai misai nI aNiyAy *","Azhi angkaNNA! un kOlap pAdham *","piDiththadhu naDu unakku arivaiyarum","palar * adhu niRka em peNmai ARROm *","vaDith thaDangkaN iNai nIrum nillA *","manamum nillA emakku adhu thannAlE *","veDippu nin pasu nirai mEykkap pOkku *","vEm emadhu uyir azhal mezhugil ukkE"],["அடிச்சியோம் தலை மிசை நீ அணியாய் *","ஆழி அங்கண்ணா! உன் கோலப் பாதம் *","பிடித்தது நடு உனக்கு அரிவையரும்","பலர் * அது நிற்க எம் பெண்மை ஆற்றோம் *","வடித் தடங்கண் இணை நீரும் நில்லா *","மனமும் நில்லா எமக்கு அது தன்னாலே *","வெடிப்பு நின் பசு நிரை மேய்க்கப் போக்கு *","வேம் எமது உயிர் அழல் மெழுகில் உக்கே"],0,"/media/recitation/TVM.10.3.6.mp3"],[3811,3811,["vEm emadhu uyir azhal mezhugil ukku *","veL vaLai mEgalai kazhanRu vIzha *","thU malark kaN iNai muththam sOrath *","thuNai mulai payandhu ena thOLgaL vADa *","mA maNi vaNNA! un sengkamala","vaNNa * menmalar aDi nOva nI pOy *","A magizhndhu ugandhu avai mEykkinRu unnODu *","asurargaL thalaippeyyil yavan kol AnggE?"],["வேம் எமது உயிர் அழல் மெழுகில் உக்கு *","வெள் வளை மேகலை கழன்று வீழ *","தூ மலர்க் கண் இணை முத்தம் சோரத் *","துணை முலை பயந்து என தோள்கள் வாட *","மா மணி வண்ணா! உன் செங்கமல","வண்ண * மென்மலர் அடி நோவ நீ போய் *","ஆ மகிழ்ந்து உகந்து அவை மேய்க்கின்று உன்னோடு *","அசுரர்கள் தலைப்பெய்யில் யவன் கொல் ஆங்கே?"],0,"/media/recitation/TVM.10.3.7.mp3"],[3812,3812,["asurargaL thalaip peyyil yavan kol Anggu enRu *","Azhum en Ar uyir An pin pOgEl *","kasigaiyum vETkaiyum uL kalandhu *","kalaviyum naliyum en kaikazhiyEl **","vasi sey un thAmaraik kaNNum vAyum *","kaigaLum pIdhaga uDaiyum kATTi *","osi sey nuNNiDai iLa Aychchiyar *","nI ugakku nallavaroDum uzhitharAyE"],["அசுரர்கள் தலைப் பெய்யில் யவன் கொல் ஆங்கு என்று *","ஆழும் என் ஆர் உயிர் ஆன் பின் போகேல் *","கசிகையும் வேட்கையும் உள் கலந்து *","கலவியும் நலியும் என் கைகழியேல் **","வசி செய் உன் தாமரைக் கண்ணும் வாயும் *","கைகளும் பீதக உடையும் காட்டி *","ஒசி செய் நுண்ணிடை இள ஆய்ச்சியர் *","நீ உகக்கு நல்லவரொடும் உழிதராயே"],0,"/media/recitation/TVM.10.3.8.mp3"],[3813,3813,["ugakku nallavaroDum uzhithandhu *","undhan thiru uLLam iDar keDunthORum * nAnggaL","viyakka inbuRudhum em peNmai ARROm *","emperumAn! pasu mEykkap pOgEl **","migap pala asurargaL vENDu uruvam","koNDu * ninRu uzhitharuvar kanjchan Eva *","agappaDil avaroDum ninnoDu AnggE *","avaththanggaL viLaiyum en soRkoL andhO!"],["உகக்கு நல்லவரொடும் உழிதந்து *","உன்தன் திரு உள்ளம் இடர் கெடுந்தோறும் * நாங்கள்","வியக்க இன்புறுதும் எம் பெண்மை ஆற்றோம் *","எம்பெருமான்! பசு மேய்க்கப் போகேல் **","மிகப் பல அசுரர்கள் வேண்டு உருவம்","கொண்டு * நின்று உழிதருவர் கஞ்சன் ஏவ *","அகப்படில் அவரொடும் நின்னொடு ஆங்கே *","அவத்தங்கள் விளையும் என் சொற்கொள் அந்தோ!"],0,"/media/recitation/TVM.10.3.9.mp3"],[3814,3814,["avaththanggaL viLaiyum en soRkoL andhO! *","asurargaL vankaiyar kanjchan Eva *","thavaththavar maRuga ninRu uzhitharuvar *","thanimaiyum peridhu unakku irAmanaiyum","uvarththalai ** uDan thirigilaiyum enRenRu","UDuRa * ennuDai Avi vEmAl *","thivaththilum pasu nirai mEyppu uvaththi *","sengkanivAy enggaL Ayar thEvE!"],["அவத்தங்கள் விளையும் என் சொற்கொள் அந்தோ! *","அசுரர்கள் வன்கையர் கஞ்சன் ஏவ *","தவத்தவர் மறுக நின்று உழிதருவர் *","தனிமையும் பெரிது உனக்கு இராமனையும்","உவர்த்தலை ** உடன் திரிகிலையும் என்றென்று","ஊடுற * என்னுடை ஆவி வேமால் *","திவத்திலும் பசு நிரை மேய்ப்பு உவத்தி *","செங்கனிவாய் எங்கள் ஆயர் தேவே!"],0,"/media/recitation/TVM.10.3.10.mp3"],[3815,3815,["** sengkanivAy enggaL Ayar thEvu *","aththiruvaDi thiruvaDi mEl * porunal","sanggaNi thuRaivan vaN then kurugUr *","vaN saDakOpan sol AyiraththuL **","manggaiyar Aychchiyar Ayndha mAlai *","avanoDum pirivadhaRku iranggi * thaiyal","anggu avan pasu nirai mEyppu ozhippAn","uraiththana * ivaiyum paththu avaRRin sArvE"],["** செங்கனிவாய் எங்கள் ஆயர் தேவு *","அத்திருவடி திருவடி மேல் * பொருநல்","சங்கணி துறைவன் வண் தென் குருகூர் *","வண் சடகோபன் சொல் ஆயிரத்துள் **","மங்கையர் ஆய்ச்சியர் ஆய்ந்த மாலை *","அவனொடும் பிரிவதற்கு இரங்கி * தையல்","அங்கு அவன் பசு நிரை மேய்ப்பு ஒழிப்பான்","உரைத்தன * இவையும் பத்து அவற்றின் சார்வே"],0,"/media/recitation/TVM.10.3.11.mp3"]],[[3816,3816,["** sArvE thava neRikkuth * dhAmOdharan thALgaL *","kAr mEga vaNNan * kamala nayanaththan **","nIr vAnam maN eri kAlAy * ninRa nEmiyAn *","pEr vAnavargaL * pidhaRRum perumaiyanE"],["** சார்வே தவ நெறிக்குத் * தாமோதரன் தாள்கள் *","கார் மேக வண்ணன் * கமல நயனத்தன் **","நீர் வானம் மண் எரி காலாய் * நின்ற நேமியான் *","பேர் வானவர்கள் * பிதற்றும் பெருமையனே"],0,"/media/recitation/TVM.10.4.1.mp3"],[3817,3817,["perumaiyanE vAnaththu imaiyOrkkum * kANDaRku","arumaiyanE * Agaththu aNaiyAdhArkku ** enRum","thiru mey uRaiginRa * sengkaN mAl * nALum","irumai vinai kaDindhu * inggu ennai ALginRAnE"],["பெருமையனே வானத்து இமையோர்க்கும் * காண்டற்கு","அருமையனே * ஆகத்து அணையாதார்க்கு ** என்றும்","திரு மெய் உறைகின்ற * செங்கண் மால் * நாளும்","இருமை வினை கடிந்து * இங்கு என்னை ஆள்கின்றானே"],0,"/media/recitation/TVM.10.4.2.mp3"],[3818,3818,["ALginRAn AzhiyAn * ArAl kuRai uDaiyam? *","mILginRadhu illaip * piRavith thuyar kaDindhOm **","vAL keNDai oN kaN * maDap pinnai than kELvan *","thAL kaNDu koNDu * en thalai mEl punaindhEnE"],["ஆள்கின்றான் ஆழியான் * ஆரால் குறை உடையம்? *","மீள்கின்றது இல்லைப் * பிறவித் துயர் கடிந்தோம் **","வாள் கெண்டை ஒண் கண் * மடப் பின்னை தன் கேள்வன் *","தாள் கண்டு கொண்டு * என் தலை மேல் புனைந்தேனே"],0,"/media/recitation/TVM.10.4.3.mp3"],[3819,3819,["thalai mEl punaindhEn * saraNanggaL * Alin","ilai mEl thuyinRAn * imaiyOr vaNangga **","malai mEl thAn ninRu * en manaththuL irundhAnai *","nilai pErkkal AgAmai * nichchiththu irundhEnE"],["தலை மேல் புனைந்தேன் * சரணங்கள் * ஆலின்","இலை மேல் துயின்றான் * இமையோர் வணங்க **","மலை மேல் தான் நின்று * என் மனத்துள் இருந்தானை *","நிலை பேர்க்கல் ஆகாமை * நிச்சித்து இருந்தேனே"],0,"/media/recitation/TVM.10.4.4.mp3"],[3820,3820,["nichchiththu irundhEn * en nenjcham kazhiyAmai *","kaich chakkaraththu aNNal * kaLvam peridhu uDaiyan **","mechchappaDAn piRarkku * mey pOlum poy vallan *","nachchappaDum namakku * nAgaththu aNaiyAnE"],["நிச்சித்து இருந்தேன் * என் நெஞ்சம் கழியாமை *","கைச் சக்கரத்து அண்ணல் * கள்வம் பெரிது உடையன் **","மெச்சப்படான் பிறர்க்கு * மெய் போலும் பொய் வல்லன் *","நச்சப்படும் நமக்கு * நாகத்து அணையானே"],0,"/media/recitation/TVM.10.4.5.mp3"],[3821,3821,["nAgaththu aNaiyAnai * nAL thORum njAnaththAl *","Agaththu aNaippArkku * aruL seyyum ammAnai **","mAgaththu iLa madhiyam * sErum saDaiyAnai *","pAgaththu vaiththAn than * pAdham paNindhEnE"],["நாகத்து அணையானை * நாள் தோறும் ஞானத்தால் *","ஆகத்து அணைப்பார்க்கு * அருள் செய்யும் அம்மானை **","மாகத்து இள மதியம் * சேரும் சடையானை *","பாகத்து வைத்தான் தன் * பாதம் பணிந்தேனே"],0,"/media/recitation/TVM.10.4.6.mp3"],[3822,3822,["paNi nenjchE! nALum * parama param paranai *","piNi onRum sArA * piRavi keDuththu ALum **","maNi ninRa sOdhi * madhusUdhan en ammAn *","aNi ninRa sempon * aDal AzhiyAnE"],["பணி நெஞ்சே! நாளும் * பரம பரம் பரனை *","பிணி ஒன்றும் சாரா * பிறவி கெடுத்து ஆளும் **","மணி நின்ற சோதி * மதுசூதன் என் அம்மான் *","அணி நின்ற செம்பொன் * அடல் ஆழியானே"],0,"/media/recitation/TVM.10.4.7.mp3"],[3823,3823,["AzhiyAn Azhi * amararkkum appAlAn *","UzhiyAn Uzhi paDaiththAn * nirai mEyththAn **","pAzhi anthOLAl * varai eDuththAn pAdhanggaL *","vAzhi en nenjchE! * maRavAdhu vAzh kaNDAy"],["ஆழியான் ஆழி * அமரர்க்கும் அப்பாலான் *","ஊழியான் ஊழி படைத்தான் * நிரை மேய்த்தான் **","பாழி அந்தோளால் * வரை எடுத்தான் பாதங்கள் *","வாழி என் நெஞ்சே! * மறவாது வாழ் கண்டாய்"],0,"/media/recitation/TVM.10.4.8.mp3"],[3824,3824,["kaNDEn kamala malarp pAdham * kANDalumE *","viNDE ozhindha * vinai Ayina ellAm **","thoNDE seydhu enRum * thozhudhu vazhi ozhuga *","paNDE paraman * paNiththa paNi vagaiyE"],["கண்டேன் கமல மலர்ப் பாதம் * காண்டலுமே *","விண்டே ஒழிந்த * வினை ஆயின எல்லாம் **","தொண்டே செய்து என்றும் * தொழுது வழி ஒழுக *","பண்டே பரமன் * பணித்த பணி வகையே"],0,"/media/recitation/TVM.10.4.9.mp3"],[3825,3825,["vagaiyAl manam onRi * mAdhavanai * nALum","pugaiyAl viLakkAl * pudhu malarAl nIrAl **","thisai thORu amarargaL * senRu iRainjcha ninRa *","thagaiyAn saraNam * thamargaTku Or paRRE"],["வகையால் மனம் ஒன்றி * மாதவனை * நாளும்","புகையால் விளக்கால் * புது மலரால் நீரால் **","திசை தோறு அமரர்கள் * சென்று இறைஞ்ச நின்ற *","தகையான் சரணம் * தமர்கட்கு ஓர் பற்றே"],0,"/media/recitation/TVM.10.4.10.mp3"],[3826,3826,["** paRRu enRu paRRip * parama param paranai *","mal thiN thOL mAlai * vazhudhi vaLa nADan **","sol thoDai andhAdhi * Or AyiraththuL ippaththum *","kaRRArkku Or paRRAgum * kaNNan kazhal iNaiyE"],["** பற்று என்று பற்றிப் * பரம பரம் பரனை *","மல் திண் தோள் மாலை * வழுதி வள நாடன் **","சொல் தொடை அந்தாதி * ஓர் ஆயிரத்துள் இப்பத்தும் *","கற்றார்க்கு ஓர் பற்றாகும் * கண்ணன் கழல் இணையே"],0,"/media/recitation/TVM.10.4.11.mp3"]],[[3827,3827,["** kaNNan kazhal iNai *","naNNum manam uDaiyIr! **","eNNum thirunAmam *","thiNNam nAraNamE"],["** கண்ணன் கழல் இணை *","நண்ணும் மனம் உடையீர்! **","எண்ணும் திருநாமம் *","திண்ணம் நாரணமே"],0,"/media/recitation/TVM.10.5.1.mp3"],[3828,3828,["nAraNan emmAn *","pAr aNanggu ALan **","vAraNam tholaiththa *","kAraNan thAnE"],["நாரணன் எம்மான் *","பார் அணங்கு ஆளன் **","வாரணம் தொலைத்த *","காரணன் தானே"],0,"/media/recitation/TVM.10.5.2.mp3"],[3829,3829,["thAnE ulagu ellAm *","thAnE paDaiththu iDandhu **","thAnE uNDu umizhndhu *","thAnE ALvAnE"],["தானே உலகு எல்லாம் *","தானே படைத்து இடந்து **","தானே உண்டு உமிழ்ந்து *","தானே ஆள்வானே"],0,"/media/recitation/TVM.10.5.3.mp3"],[3830,3830,["ALvAn Azhi nIr *","kOL vAy aravaNaiyAn **","thAL vAy malar iTTu *","nAL vAy nADIrE"],["ஆள்வான் ஆழி நீர் *","கோள் வாய் அரவணையான் **","தாள் வாய் மலர் இட்டு *","நாள் வாய் நாடீரே"],0,"/media/recitation/TVM.10.5.4.mp3"],[3831,3831,["nADIr nAL thORum *","vADA malar koNDu **","pADIr avan nAmam *","vIDE peRalAmE"],["நாடீர் நாள் தோறும் *","வாடா மலர் கொண்டு **","பாடீர் அவன் நாமம் *","வீடே பெறலாமே"],0,"/media/recitation/TVM.10.5.5.mp3"],[3832,3832,["** mEyAn vEngkaDam *","kAyA malar vaNNan **","pEyAr mulai uNDa *","vAyAn mAdhavanE"],["** மேயான் வேங்கடம் *","காயா மலர் வண்ணன் **","பேயார் முலை உண்ட *","வாயான் மாதவனே"],0,"/media/recitation/TVM.10.5.6.mp3"],[3833,3833,["mAdhavan enRenRu *","Odha vallIrEl **","thIdhu onRum aDaiyA *","Edham sArAvE"],["மாதவன் என்றென்று *","ஓத வல்லீரேல் **","தீது ஒன்றும் அடையா *","ஏதம் சாராவே"],0,"/media/recitation/TVM.10.5.7.mp3"],[3834,3834,["sArA EdhanggaL *","nIr Ar mugil vaNNan **","pEr Ar OdhuvAr *","Ar Ar amararE"],["சாரா ஏதங்கள் *","நீர் ஆர் முகில் வண்ணன் **","பேர் ஆர் ஓதுவார் *","ஆர் ஆர் அமரரே"],0,"/media/recitation/TVM.10.5.8.mp3"],[3835,3835,["amararkku ariyAnai *","thamargaTku eLiyAnai **","amarath thozhuvArgaTku *","amarA vinaigaLE"],["அமரர்க்கு அரியானை *","தமர்கட்கு எளியானை **","அமரத் தொழுவார்கட்கு *","அமரா வினைகளே"],0,"/media/recitation/TVM.10.5.9.mp3"],[3836,3836,["vinai val iruL ennum *","munaigaL veruvip pOm **","sunai nan malar iTTu *","ninaimin neDiyAnE"],["வினை வல் இருள் என்னும் *","முனைகள் வெருவிப் போம் **","சுனை நன் மலர் இட்டு *","நினைமின் நெடியானே"],0,"/media/recitation/TVM.10.5.10.mp3"],[3837,3837,["** neDiyAn aruL sUDum *","paDiyAn saDakOpan **","noDi Ayiraththu ippaththu *","aDiyArkku aruL pERE"],["** நெடியான் அருள் சூடும் *","படியான் சடகோபன் **","நொடி ஆயிரத்து இப்பத்து *","அடியார்க்கு அருள் பேறே"],0,"/media/recitation/TVM.10.5.11.mp3"]],[[3838,3838,["** aruL peRuvAr aDiyAr * tham aDiyanERku * AzhiyAn","aruL tharuvAn amaiginRAn * adhu namadhu vidhi vagaiyE **","iruL tharumA njAlaththuL * inip piRavi yAn vENDEn *","maruLozhi nI maDa nenjchE! * vATTARRAn aDi vaNanggE"],["** அருள் பெறுவார் அடியார் * தம் அடியனேற்கு * ஆழியான்","அருள் தருவான் அமைகின்றான் * அது நமது விதி வகையே **","இருள் தருமா ஞாலத்துள் * இனிப் பிறவி யான் வேண்டேன் *","மருளொழி நீ மட நெஞ்சே! * வாட்டாற்றான் அடி வணங்கே"],0,"/media/recitation/TVM.10.6.1.mp3"],[3839,3839,["vATTARRAn aDi vaNanggi * mA njAlap piRappu aRuppAn *","kETTAyE maDa nenjchE! * kEsavan emperumAnai **","pATTAya pala pADip * pazha vinaigaL paRRu aRuththu *","nATTArODu iyalvu ozhindhu * nAraNanai naNNinamE"],["வாட்டாற்றான் அடி வணங்கி * மா ஞாலப் பிறப்பு அறுப்பான் *","கேட்டாயே மட நெஞ்சே! * கேசவன் எம்பெருமானை **","பாட்டாய பல பாடிப் * பழ வினைகள் பற்று அறுத்து *","நாட்டாரோடு இயல்வு ஒழிந்து * நாரணனை நண்ணினமே"],0,"/media/recitation/TVM.10.6.2.mp3"],[3840,3840,["naNNinam nArayaNanai * nAmanggaL pala solli *","maN ulagil vaLam mikka * vATTARRAn vandhu inRu **","viN ulagam tharuvAnAy * viraiginRAn vidhi vagaiyE *","eNNina ARu AgA * ikkarumanggaL en nenjchE!"],["நண்ணினம் நாரயணனை * நாமங்கள் பல சொல்லி *","மண் உலகில் வளம் மிக்க * வாட்டாற்றான் வந்து இன்று **","விண் உலகம் தருவானாய் * விரைகின்றான் விதி வகையே *","எண்ணின ஆறு ஆகா * இக்கருமங்கள் என் நெஞ்சே!"],0,"/media/recitation/TVM.10.6.3.mp3"],[3841,3841,["en nenjchaththuL irundhu * inggu irunthamizh nUl ivai mozhindhu *","vannenjchaththu iraNiyanai * mArvu iDandha vATTARRAn **","man anjchap bAradhaththup * pANDavarkkAyp paDai thoTTAn *","nannenjchE! namperumAn * namakku aruL thAn seyvAnE"],["என் நெஞ்சத்துள் இருந்து * இங்கு இருந்தமிழ் நூல் இவை மொழிந்து *","வன்னெஞ்சத்து இரணியனை * மார்வு இடந்த வாட்டாற்றான் **","மன் அஞ்சப் பாரதத்துப் * பாண்டவர்க்காய்ப் படை தொட்டான் *","நன்னெஞ்சே! நம்பெருமான் * நமக்கு அருள் தான் செய்வானே"],0,"/media/recitation/TVM.10.6.4.mp3"],[3842,3842,["vAn ERa vazhi thandha * vATTARRAn paNi vagaiyE *","nAn ERap peRuginREn * naragaththai nagu nenjchE! **","thEn ERu malarth thuLavam * thigazh pAdhan sezhum paRavai *","thAn ERith thirivAna * thAL iNai en thalai mElE"],["வான் ஏற வழி தந்த * வாட்டாற்றான் பணி வகையே *","நான் ஏறப் பெறுகின்றேன் * நரகத்தை நகு நெஞ்சே! **","தேன் ஏறு மலர்த் துளவம் * திகழ் பாதன் செழும் பறவை *","தான் ஏறித் திரிவான * தாள் இணை என் தலை மேலே"],0,"/media/recitation/TVM.10.6.5.mp3"],[3843,3843,["thalai mEla thAL iNaigaL * thAmaraik kaN en ammAn *","nilai pErAn en nenjchaththu * eppozhudhum emperumAn **","malai mADaththu aravaNai mEl * vATTARRAn madha mikka *","kolai yAnai maruppu osiththAn * kurai kazhalgaL kuRuginamE"],["தலை மேல தாள் இணைகள் * தாமரைக் கண் என் அம்மான் *","நிலை பேரான் என் நெஞ்சத்து * எப்பொழுதும் எம்பெருமான் **","மலை மாடத்து அரவணை மேல் * வாட்டாற்றான் மத மிக்க *","கொலை யானை மருப்பு ஒசித்தான் * குரை கழல்கள் குறுகினமே"],0,"/media/recitation/TVM.10.6.6.mp3"],[3844,3844,["kuraikazhalgaL kuRuginam * nam gOvindhan kuDi koNDAn *","thirai kuzhuvu kaDal puDai sUzh * thennATTuth thiladham anna **","varai kuzhuvu maNi mADa * vATTARRAn malar aDi mEl *","virai kuzhuvu naRunthuLavam * mey ninRu kamazhumE"],["குரைகழல்கள் குறுகினம் * நம் கோவிந்தன் குடி கொண்டான் *","திரை குழுவு கடல் புடை சூழ் * தென்னாட்டுத் திலதம் அன்ன **","வரை குழுவு மணி மாட * வாட்டாற்றான் மலர் அடி மேல் *","விரை குழுவு நறுந்துளவம் * மெய் நின்று கமழுமே"],0,"/media/recitation/TVM.10.6.7.mp3"],[3845,3845,["mey ninRu kamazh thuLava * virai ERu thiru muDiyan *","kai ninRa chakkaraththan * karudhum iDam porudhu punal **","mai ninRa varai pOlum * thiru uruva vATTARRARku *","ennanRi seydhEnA * en nenjchil thigazhvadhuvE?"],["மெய் நின்று கமழ் துளவ * விரை ஏறு திரு முடியன் *","கை நின்ற சக்கரத்தன் * கருதும் இடம் பொருது புனல் **","மை நின்ற வரை போலும் * திரு உருவ வாட்டாற்றாற்கு *","எந்நன்றி செய்தேனா * என் நெஞ்சில் திகழ்வதுவே?"],0,"/media/recitation/TVM.10.6.8.mp3"],[3846,3846,["thigazhginRa thiru mArbil * thiru manggai thannODum *","thigazhginRa thiru mAlAr * sErviDam thaN vATTARu **","pugazhginRa puL Urdhi * pOr arakkar kulam keDuththAn *","igazhvinRi en nenjchaththu * eppozhudhum piriyAnE"],["திகழ்கின்ற திரு மார்பில் * திரு மங்கை தன்னோடும் *","திகழ்கின்ற திரு மாலார் * சேர்விடம் தண் வாட்டாறு **","புகழ்கின்ற புள் ஊர்தி * போர் அரக்கர் குலம் கெடுத்தான் *","இகழ்வின்றி என் நெஞ்சத்து * எப்பொழுதும் பிரியானே"],0,"/media/recitation/TVM.10.6.9.mp3"],[3847,3847,["piriyAdhu ATsey enRu * piRappu aRuththu ALaRak koNDAn *","ari Agi iraNiyanai * Agam kINDAn anRu **","periyArkku ATpaTTakkAl * peRAdha payan peRum ARu *","vari vAL vAy aravaNai mEl * vATTARRAn kATTinanE"],["பிரியாது ஆட்செய் என்று * பிறப்பு அறுத்து ஆளறக் கொண்டான் *","அரி ஆகி இரணியனை * ஆகம் கீண்டான் அன்று **","பெரியார்க்கு ஆட்பட்டக்கால் * பெறாத பயன் பெறும் ஆறு *","வரி வாள் வாய் அரவணை மேல் * வாட்டாற்றான் காட்டினனே"],0,"/media/recitation/TVM.10.6.10.mp3"],[3848,3848,["** kATTith than kanai kazhalgaL * kaDu naragam pugal ozhiththa *","vATTARRu emperumAnai * vaLangkurugUrch saDakOpan **","pATTAya thamizh mAlai * AyiraththuL ippaththum","kETTu * ArAr vAnavargaL * sevikku iniya senjchollE"],["** காட்டித் தன் கனை கழல்கள் * கடு நரகம் புகல் ஒழித்த *","வாட்டாற்று எம்பெருமானை * வளங்குருகூர்ச் சடகோபன் **","பாட்டாய தமிழ் மாலை * ஆயிரத்துள் இப்பத்தும்","கேட்டு * ஆரார் வானவர்கள் * செவிக்கு இனிய செஞ்சொல்லே"],0,"/media/recitation/TVM.10.6.11.mp3"]],[[3849,3849,["** senjchoR kavigAL! uyir kAththu ATseymmin * thirumAlirunjchOlai *","vanjchak kaLvan mA mAyan * mAyak kaviyAy vandhu ** en","nenjchum uyirum uLkalandhu * ninRAr aRiyA vaNNam * en","nenjchum uyirum avai uNDu * thAnE Agi niRaindhAnE"],["** செஞ்சொற் கவிகாள்! உயிர் காத்து ஆட்செய்ம்மின் * திருமாலிருஞ்சோலை *","வஞ்சக் கள்வன் மா மாயன் * மாயக் கவியாய் வந்து ** என்","நெஞ்சும் உயிரும் உள்கலந்து * நின்றார் அறியா வண்ணம் * என்","நெஞ்சும் உயிரும் அவை உண்டு * தானே ஆகி நிறைந்தானே"],0,"/media/recitation/TVM.10.7.1.mp3"],[3850,3850,["thAnE Agi niRaindhu * ellA ulagum uyirum thAnEyAy *","thAnE yAn enbAn Agith * thannaith thAnE thudhiththu * enakkuth","thEnE pAlE kannalE amudhE * thirumAlirunjchOlai *","kOnE Agi ninRu ozhindhAn * ennai muRRum uyir uNDE"],["தானே ஆகி நிறைந்து * எல்லா உலகும் உயிரும் தானேயாய் *","தானே யான் என்பான் ஆகித் * தன்னைத் தானே துதித்து * எனக்குத்","தேனே பாலே கன்னலே அமுதே * திருமாலிருஞ்சோலை *","கோனே ஆகி நின்று ஒழிந்தான் * என்னை முற்றும் உயிர் உண்டே"],0,"/media/recitation/TVM.10.7.2.mp3"],[3851,3851,["ennai muRRum uyir uNDu * en mAya Akkai idhanuL pukku *","ennai muRRum thAnEyAy * ninRa mAya ammAn sEr **","thennan thirumAlirunjchOlaith * thisai kai kUppich sErndha yAn *","innum pOvEnE kolO? * en kol ammAn thiru aruLE?"],["என்னை முற்றும் உயிர் உண்டு * என் மாய ஆக்கை இதனுள் புக்கு *","என்னை முற்றும் தானேயாய் * நின்ற மாய அம்மான் சேர் **","தென்னன் திருமாலிருஞ்சோலைத் * திசை கை கூப்பிச் சேர்ந்த யான் *","இன்னும் போவேனே கொலோ? * என் கொல் அம்மான் திரு அருளே?"],0,"/media/recitation/TVM.10.7.3.mp3"],[3852,3852,["en kol ammAn thiru aruLgaL? * ulagum uyirum thAnEyAy *","nanku en uDalam kaiviDAn * njAlaththUDE naDandhu uzhakki **","then koL thisaikkuth thiladhamAy ninRa * thirumAlirunjchOlai *","nanggaL kunRam kaiviDAn * naNNA asurar naviyavE"],["என் கொல் அம்மான் திரு அருள்கள்? * உலகும் உயிரும் தானேயாய் *","நன்கு என் உடலம் கைவிடான் * ஞாலத்தூடே நடந்து உழக்கி **","தென் கொள் திசைக்குத் திலதமாய் நின்ற * திருமாலிருஞ்சோலை *","நங்கள் குன்றம் கைவிடான் * நண்ணா அசுரர் நவியவே"],0,"/media/recitation/TVM.10.7.4.mp3"],[3853,3853,["naNNA asurar navivu eydha * nalla amarar polivu eydha *","eNNAdhanagaL eNNum * nan munivar inbam thalaich siRappa **","paNNAr pADal in kavigaL * yAnAyth thannaith thAn pADi *","thennA ennum en ammAn * thirumAlirunjchOlaiyAnE"],["நண்ணா அசுரர் நவிவு எய்த * நல்ல அமரர் பொலிவு எய்த *","எண்ணாதனகள் எண்ணும் * நன் முனிவர் இன்பம் தலைச் சிறப்ப **","பண்ணார் பாடல் இன் கவிகள் * யானாய்த் தன்னைத் தான் பாடி *","தென்னா என்னும் என் அம்மான் * திருமாலிருஞ்சோலையானே"],0,"/media/recitation/TVM.10.7.5.mp3"],[3854,3854,["thirumAlirunjchOlaiyAnE Agich * sezhu mUvulagum * than","oru mA vayiRRin uLLE vaiththu * Uzhi Uzhi thalai aLikkum **","thirumAl ennai ALu mAl * sivanum piramanum kANAdhu *","aru mAl eydhi aDi parava * aruLai Indha ammAnE"],["திருமாலிருஞ்சோலையானே ஆகிச் * செழு மூவுலகும் * தன்","ஒரு மா வயிற்றின் உள்ளே வைத்து * ஊழி ஊழி தலை அளிக்கும் **","திருமால் என்னை ஆளு மால் * சிவனும் பிரமனும் காணாது *","அரு மால் எய்தி அடி பரவ * அருளை ஈந்த அம்மானே"],0,"/media/recitation/TVM.10.7.6.mp3"],[3855,3855,["aruLai I en ammAnE! ennum * mukkaN ammAnum *","theruL koL piraman ammAnum * dhEvar kOnum dhEvarum **","iruLgaL kaDiyum munivarum * Eththum ammAn thirumalai *","maruLgaL kaDiyum maNi malai * thirumAlirunjchOlai malaiyE"],["அருளை ஈ என் அம்மானே! என்னும் * முக்கண் அம்மானும் *","தெருள் கொள் பிரமன் அம்மானும் * தேவர் கோனும் தேவரும் **","இருள்கள் கடியும் முனிவரும் * ஏத்தும் அம்மான் திருமலை *","மருள்கள் கடியும் மணி மலை * திருமாலிருஞ்சோலை மலையே"],0,"/media/recitation/TVM.10.7.7.mp3"],[3856,3856,["** thirumAlirunjchOlai malaiyE * thiruppARkaDalE en thalaiyE *","thirumAl vaikundhamE * thaN thiruvEngkaDamE enadhuDalE **","aru mA mAyaththu enadhuyirE * manamE vAkkE karumamE *","oru mA noDiyum piriyAn * en Uzhi mudhalvan oruvanE"],["** திருமாலிருஞ்சோலை மலையே * திருப்பாற்கடலே என் தலையே *","திருமால் வைகுந்தமே * தண் திருவேங்கடமே எனது உடலே **","அரு மா மாயத்து எனது உயிரே * மனமே வாக்கே கருமமே *","ஒரு மா நொடியும் பிரியான் * என் ஊழி முதல்வன் ஒருவனே"],0,"/media/recitation/TVM.10.7.8.mp3"],[3857,3857,["Uzhi mudhalvan oruvanE ennum * oruvan ulagu ellAm *","Uzhi thORum than uLLE paDaiththuk * kAththuk keDuththu uzhalum **","Azhi vaNNan en ammAn * anthaN thirumAlirunjchOlai *","vAzhi manamE kaiviDEl * uDalum uyirum mangga oTTE"],["ஊழி முதல்வன் ஒருவனே என்னும் * ஒருவன் உலகு எல்லாம் *","ஊழி தோறும் தன் உள்ளே படைத்துக் * காத்துக் கெடுத்து உழலும் **","ஆழி வண்ணன் என் அம்மான் * அந்தண் திருமாலிருஞ்சோலை *","வாழி மனமே கைவிடேல் * உடலும் உயிரும் மங்க ஒட்டே"],0,"/media/recitation/TVM.10.7.9.mp3"],[3858,3858,["mangga oTTu un mA mAyai * thirumAlirunjchOlai mEya *","nanggaL kOnE! yAnE nI Agi * ennai aLiththAnE! **","ponggu aimpulanum poRi aindhum * karumEndhiriyam aimbUdham *","inggu ivvuyirEy pirakirudhi * mAn AnggAra mananggaLE"],["மங்க ஒட்டு உன் மா மாயை * திருமாலிருஞ்சோலை மேய *","நங்கள் கோனே! யானே நீ ஆகி * என்னை அளித்தானே! **","பொங்கு ஐம்புலனும் பொறி ஐந்தும் * கருமேந்திரியம் ஐம்பூதம் *","இங்கு இவ்வுயிரேய் பிரகிருதி * மான் ஆங்கார மனங்களே"],0,"/media/recitation/TVM.10.7.10.mp3"],[3859,3859,["** mAn AnggAra manam keDa * aivar vankaiyar mangga *","thAn AnggAramAyp pukkuth * thAnE thAnE AnAnai **","thEn AnggArap pozhil kurugUrch * saDakOpan sol AyiraththuL *","mAn AnggAraththu ivai paththum * thirumAlirunjchOlai malaikkE"],["** மான் ஆங்கார மனம் கெட * ஐவர் வன்கையர் மங்க *","தான் ஆங்காரமாய்ப் புக்குத் * தானே தானே ஆனானை **","தேன் ஆங்காரப் பொழில் குருகூர்ச் * சடகோபன் சொல் ஆயிரத்துள் *","மான் ஆங்காரத்து இவை பத்தும் * திருமாலிருஞ்சோலை மலைக்கே"],0,"/media/recitation/TVM.10.7.11.mp3"]],[[3860,3860,["** thirumAlirunjchOlai malai * enREn enna *","thirumAl vandhu * en nenjchu niRaiyap pugundhAn **","kuru mA maNi undhu punal * ponnith then pAl *","thirumAl senRu sErviDam * then thiruppErE"],["** திருமாலிருஞ்சோலை மலை * என்றேன் என்ன *","திருமால் வந்து * என் நெஞ்சு நிறையப் புகுந்தான் **","குரு மா மணி உந்து புனல் * பொன்னித் தென் பால் *","திருமால் சென்று சேர்விடம் * தென் திருப்பேரே"],0,"/media/recitation/TVM.10.8.1.mp3"],[3861,3861,["pErE uRaiginRa pirAn * inRu vandhu *","pErEn enRu * en nenjchu niRaiyap pugundhAn **","kAr Ezh kaDal Ezh * malai Ezh ulagu uNDum *","ArA vayiRRAnai * aDanggap piDiththEnE"],["பேரே உறைகின்ற பிரான் * இன்று வந்து *","பேரேன் என்று * என் நெஞ்சு நிறையப் புகுந்தான் **","கார் ஏழ் கடல் ஏழ் * மலை ஏழ் உலகு உண்டும் *","ஆரா வயிற்றானை * அடங்கப் பிடித்தேனே"],0,"/media/recitation/TVM.10.8.2.mp3"],[3862,3862,["piDiththEn piRavi keDuththEn * piNi sArEn *","maDiththEn manai vAzhkkaiyuL * niRpadhOr mAyaiyai **","koDik gOpura mADanggaL sUzh * thiruppErAn *","aDich sErvadhu enakku * eLidhu Ayina ARE"],["பிடித்தேன் பிறவி கெடுத்தேன் * பிணி சாரேன் *","மடித்தேன் மனை வாழ்க்கையுள் * நிற்பதோர் மாயையை **","கொடிக் கோபுர மாடங்கள் சூழ் * திருப்பேரான் *","அடிச் சேர்வது எனக்கு * எளிது ஆயின ஆறே"],0,"/media/recitation/TVM.10.8.3.mp3"],[3863,3863,["eLidhAyina ARu enRu * en kaNgaL kaLippa *","kaLidhAgiya sindhaiyanAyk * kaLikkinREn **","kiLi thAviya sOlaigaL sUzh * thiruppErAn *","theLidhAgiya * sEN visumbu tharuvAnE"],["எளிதாயின ஆறு என்று * என் கண்கள் களிப்ப *","களிதாகிய சிந்தையனாய்க் * களிக்கின்றேன் **","கிளி தாவிய சோலைகள் சூழ் * திருப்பேரான் *","தெளிதாகிய * சேண் விசும்பு தருவானே"],0,"/media/recitation/TVM.10.8.4.mp3"],[3864,3864,["vAnE tharuvAn * enakkA ennODu oTTi *","Un Ey kurambai * idhanuL pugundhu ** inRu","thAnE thaDumARRa * vinaigaL thavirththAn *","thEn Ey pozhil * then thiruppEr nagarAnE"],["வானே தருவான் * எனக்கா என்னோடு ஒட்டி *","ஊன் ஏய் குரம்பை * இதனுள் புகுந்து ** இன்று","தானே தடுமாற்ற * வினைகள் தவிர்த்தான் *","தேன் ஏய் பொழில் * தென் திருப்பேர் நகரானே"],0,"/media/recitation/TVM.10.8.5.mp3"],[3865,3865,["thiruppEr nagarAn * thirumAlirunjchOlai *","poruppE uRaiginRa pirAn * inRu vandhu **","iruppEn enRu * en nenjchu niRaiyap pugundhAn *","viruppE peRRu * amudham uNDu kaLiththEnE"],["திருப்பேர் நகரான் * திருமாலிருஞ்சோலை *","பொருப்பே உறைகின்ற பிரான் * இன்று வந்து **","இருப்பேன் என்று * என் நெஞ்சு நிறையப் புகுந்தான் *","விருப்பே பெற்று * அமுதம் உண்டு களித்தேனே"],0,"/media/recitation/TVM.10.8.6.mp3"],[3866,3866,["uNDu kaLiththERku * umbar en kuRai? * mElaith","thoNDu ugaLiththu * andhi thozhum sollup peRREn **","vaNDu kaLikkum pozhil sUzh * thiruppErAn *","kaNDu kaLippak * kaNNuL ninRu agalAnE"],["உண்டு களித்தேற்கு * உம்பர் என் குறை? * மேலைத்","தொண்டு உகளித்து * அந்தி தொழும் சொல்லுப் பெற்றேன் **","வண்டு களிக்கும் பொழில் சூழ் * திருப்பேரான் *","கண்டு களிப்பக் * கண்ணுள் நின்று அகலானே"],0,"/media/recitation/TVM.10.8.7.mp3"],[3867,3867,["kaNNuL ninRu agalAn * karuththin kaN periyan *","eNNil nuN poruL * Ezh isaiyin suvai thAnE **","vaNNa nan maNi mADanggaL sUzh * thiruppErAn *","thiNNam en manaththup * pugundhAn seRindhu inRE"],["கண்ணுள் நின்று அகலான் * கருத்தின் கண் பெரியன் *","எண்ணில் நுண் பொருள் * ஏழ் இசையின் சுவை தானே **","வண்ண நன் மணி மாடங்கள் சூழ் * திருப்பேரான் *","திண்ணம் என் மனத்துப் * புகுந்தான் செறிந்து இன்றே"],0,"/media/recitation/TVM.10.8.8.mp3"],[3868,3868,["inRu ennaip poruL Akkith * thannai ennuL vaiththAn *","anRu ennaip puRam pOgap * puNarththadhu en seyvAn? **","kunRu ennath thigazh mADanggaL sUzh * thiruppErAn *","onRu enakku aruL seyya * uNarththal uRREnE"],["இன்று என்னைப் பொருள் ஆக்கித் * தன்னை என்னுள் வைத்தான் *","அன்று என்னைப் புறம் போகப் * புணர்த்தது என் செய்வான்? **","குன்று என்னத் திகழ் மாடங்கள் சூழ் * திருப்பேரான் *","ஒன்று எனக்கு அருள் செய்ய * உணர்த்தல் உற்றேனே"],0,"/media/recitation/TVM.10.8.9.mp3"],[3869,3869,["** uRREn ugandhu paNi seydhu * una pAdham","peRREn * IdhE innam * vENDuvadhu endhAy! **","kaRRAr maRai vANargaL vAzh * thiruppErARku *","aRRAr aDiyAr thamakku * allal nillAvE"],["** உற்றேன் உகந்து பணி செய்து * உன பாதம்","பெற்றேன் * ஈதே இன்னம் * வேண்டுவது எந்தாய்! **","கற்றார் மறை வாணர்கள் வாழ் * திருப்பேராற்கு *","அற்றார் அடியார் தமக்கு * அல்லல் நில்லாவே"],0,"/media/recitation/TVM.10.8.10.mp3"],[3870,3870,["** nillA allal * nIL vayal sUzh thiruppEr mEl *","nallAr palar vAzh * kurugUrch saDakOpan **","sollAr thamizh * AyiraththuL ivai paththum","vallAr * thoNDar ALvadhu * sUzh pon visumbE"],["** நில்லா அல்லல் * நீள் வயல் சூழ் திருப்பேர் மேல் *","நல்லார் பலர் வாழ் * குருகூர்ச் சடகோபன் **","சொல்லார் தமிழ் * ஆயிரத்துள் இவை பத்தும்","வல்லார் * தொண்டர் ஆள்வது * சூழ் பொன் விசும்பே"],0,"/media/recitation/TVM.10.8.11.mp3"]],[[3871,3871,["** sUzh visumbu aNi mugil * thUriyam muzhakkina *","Azh kaDal alai thirai * kai eDuththu ADina **","Ezh pozhilum * vaLam Endhiya en appan *","vAzh pugazh nAraNan * thamaraik kaNDu ugandhE"],["** சூழ் விசும்பு அணி முகில் * தூரியம் முழக்கின *","ஆழ் கடல் அலை திரை * கை எடுத்து ஆடின **","ஏழ் பொழிலும் * வளம் ஏந்திய என் அப்பன் *","வாழ் புகழ் நாரணன் * தமரைக் கண்டு உகந்தே"],0,"/media/recitation/TVM.10.9.1.mp3"],[3872,3872,["nAraNan thamaraik kaNDu ugandhu * nannIr mugil *","pUraNa poRkuDam * pUriththadhu uyar viNNil **","nIr aNi kaDalgaL * ninRu Arththana * neDu varaith","thOraNam niraiththu * enggum thozhudhanar ulagE"],["நாரணன் தமரைக் கண்டு உகந்து * நன்னீர் முகில் *","பூரண பொற்குடம் * பூரித்தது உயர் விண்ணில் **","நீர் அணி கடல்கள் * நின்று ஆர்த்தன * நெடு வரைத்","தோரணம் நிரைத்து * எங்கும் தொழுதனர் உலகே"],0,"/media/recitation/TVM.10.9.2.mp3"],[3873,3873,["thozhudhanar ulagargaL * dhUpa nal malar mazhai","pozhivanar * bhUmi anRu aLandhavan * thamar munnE **","ezhumin enRu iru marunggu isaiththanar * munivargaL *","vazhi idhu vaikundhaRku enRu * vandhu edhirE"],["தொழுதனர் உலகர்கள் * தூப நல் மலர் மழை","பொழிவனர் * பூமி அன்று அளந்தவன் * தமர் முன்னே **","எழுமின் என்று இரு மருங்கு இசைத்தனர் * முனிவர்கள் *","வழி இது வைகுந்தற்கு என்று * வந்து எதிரே"],0,"/media/recitation/TVM.10.9.3.mp3"],[3874,3874,["edhir edhir imaiyavar * iruppiDam vaguththanar *","kadhiravar avar avar * kai nirai kATTinar **","adhir kural murasanggaL * alai kaDal muzhakkoththa *","madhu viri thuzhAy muDi * mAdhavan thamarkkE"],["எதிர் எதிர் இமையவர் * இருப்பிடம் வகுத்தனர் *","கதிரவர் அவர் அவர் * கை நிரை காட்டினர் **","அதிர் குரல் முரசங்கள் * அலை கடல் முழக்கொத்த *","மது விரி துழாய் முடி * மாதவன் தமர்க்கே"],0,"/media/recitation/TVM.10.9.4.mp3"],[3875,3875,["mAdhavan thamar enRu * vAsalil vAnavar *","pOdhumin emadhiDam * pugudhuga enRalum **","gIthanggaL pADinar * kinnarar keruDargaL *","vEdha nal vAyavar * vELvi uL maDuththE"],["மாதவன் தமர் என்று * வாசலில் வானவர் *","போதுமின் எமதிடம் * புகுதுக என்றலும் **","கீதங்கள் பாடினர் * கின்னரர் கெருடர்கள் *","வேத நல் வாயவர் * வேள்வி உள் மடுத்தே"],0,"/media/recitation/TVM.10.9.5.mp3"],[3876,3876,["vELvi uL maDuththalum * virai kamazh naRum pugai *","kALanggaL valampuri * kalandhu enggum isaiththanar **","ANmingaL vAnagam * AzhiyAn thamar enRu *","vAL oN kaN maDandhaiyar * vAzhththinar magizhndhE"],["வேள்வி உள் மடுத்தலும் * விரை கமழ் நறும் புகை *","காளங்கள் வலம்புரி * கலந்து எங்கும் இசைத்தனர் **","ஆண்மின்கள் வானகம் * ஆழியான் தமர் என்று *","வாள் ஒண் கண் மடந்தையர் * வாழ்த்தினர் மகிழ்ந்தே"],0,"/media/recitation/TVM.10.9.6.mp3"],[3877,3877,["maDandhaiyar vAzhththalum * marudharum vasukkaLum *","thoDarndhu enggum * thOththiram sollinar * thoDu kaDal","kiDandha em kEsavan * kiLar oLi maNi muDi *","kuDandhai em kOvalan * kuDi aDiyArkkE"],["மடந்தையர் வாழ்த்தலும் * மருதரும் வசுக்களும் *","தொடர்ந்து எங்கும் * தோத்திரம் சொல்லினர் * தொடு கடல்","கிடந்த எம் கேசவன் * கிளர் ஒளி மணி முடி *","குடந்தை எம் கோவலன் * குடி அடியார்க்கே"],0,"/media/recitation/TVM.10.9.7.mp3"],[3878,3878,["kuDi aDiyAr ivar * gOvindhan thanakku enRu *","muDi uDai vAnavar * muRai muRai edhir koLLa **","koDi aNi neDu madhiL * gOpuram kuRuginar *","vaDivuDai mAdhavan * vaikundham pugavE"],["குடி அடியார் இவர் * கோவிந்தன் தனக்கு என்று *","முடி உடை வானவர் * முறை முறை எதிர் கொள்ள **","கொடி அணி நெடு மதிள் * கோபுரம் குறுகினர் *","வடிவுடை மாதவன் * வைகுந்தம் புகவே"],0,"/media/recitation/TVM.10.9.8.mp3"],[3879,3879,["vaikundham puguthalum * vAsalil vAnavar *","vaikundhan thamar emar * emadhiDam pugudhu enRu **","vaikundhaththu amararum * munivarum viyandhanar *","vaikundham puguvadhu * maNNavar vidhiyE"],["வைகுந்தம் புகுதலும் * வாசலில் வானவர் *","வைகுந்தன் தமர் எமர் * எமதிடம் புகுது என்று **","வைகுந்தத்து அமரரும் * முனிவரும் வியந்தனர் *","வைகுந்தம் புகுவது * மண்ணவர் விதியே"],0,"/media/recitation/TVM.10.9.9.mp3"],[3880,3880,["vidhi vagai pugundhanar enRu * nal vEdhiyar *","padhiyinil pAngginil * pAdhanggaL kazhuvinar **","nidhiyu naRchuNNamum * niRai kuDa viLakkamum *","madhi muga maDandhaiyar * Endhinar vandhE"],["விதி வகை புகுந்தனர் என்று * நல் வேதியர் *","பதியினில் பாங்கினில் * பாதங்கள் கழுவினர் **","நிதியு நற்சுண்ணமும் * நிறை குட விளக்கமும் *","மதி முக மடந்தையர் * ஏந்தினர் வந்தே"],0,"/media/recitation/TVM.10.9.10.mp3"],[3881,3881,["** vandhavar edhir koLLa * mA maNi maNDapaththu *","andhamil pEr inbaththu * aDiyarODu irundhamai **","kondhalar pozhil * kurugUrch saDakOpan * sol","sandhanggaL Ayiraththu * ivai vallAr munivarE"],["** வந்தவர் எதிர் கொள்ள * மா மணி மண்டபத்து *","அந்தமில் பேர் இன்பத்து * அடியரோடு இருந்தமை **","கொந்தலர் பொழில் * குருகூர்ச் சடகோபன் * சொல்","சந்தங்கள் ஆயிரத்து * இவை வல்லார் முனிவரே"],0,"/media/recitation/TVM.10.9.11.mp3"]],[[3882,3882,["** muniyE! nAnmuganE! * mukkaN appA! * en pollAk","kani vAyth * thAmaraik kaN karu mANikkamE! en kaLvA! **","thaniyEn AruyirE! * en thalaimisaiyAy vandhiTTu **","ini nAn pOgal oTTEn * onRum mAyam seyyEl ennaiyE"],["** முனியே! நான்முகனே! * முக்கண் அப்பா! * என் பொல்லாக்","கனி வாய்த் * தாமரைக் கண் கரு மாணிக்கமே! என் கள்வா! **","தனியேன் ஆருயிரே! * என் தலைமிசையாய் வந்திட்டு **","இனி நான் போகல் ஒட்டேன் * ஒன்றும் மாயம் செய்யேல் என்னையே"],0,"/media/recitation/TVM.10.10.1.mp3"],[3883,3883,["mAyam seyyEl ennai * un thirumArvaththu mAlai nanggai *","vAsam sey pUngkuzhalAL * thiru ANai nin ANai kaNDAy **","nEsam seydhu unnODu ennai * uyir vERinRi onRAgavE *","kUsam seyyAdhu koNDAy * ennaik kUvik koLLAy vandhu andhO!"],["மாயம் செய்யேல் என்னை * உன் திருமார்வத்து மாலை நங்கை *","வாசம் செய் பூங்குழலாள் * திரு ஆணை நின் ஆணை கண்டாய் **","நேசம் செய்து உன்னோடு என்னை * உயிர் வேறின்றி ஒன்றாகவே *","கூசம் செய்யாது கொண்டாய் * என்னைக் கூவிக் கொள்ளாய் வந்து அந்தோ!"],0,"/media/recitation/TVM.10.10.2.mp3"],[3884,3884,["kUvik koLLAy vandhu andhO! * en pollAk karu mANikkamE! *","AvikkOr paRRuk kombu * nin alAl aRiginRilEn nAn **","mEvith thozhum piraman sivan * indhiran Adhikku ellAm *","nAvik kamala mudhaR kizhanggE! * umbar andhadhuvE"],["கூவிக் கொள்ளாய் வந்து அந்தோ! * என் பொல்லாக் கரு மாணிக்கமே! *","ஆவிக்கோர் பற்றுக் கொம்பு * நின் அலால் அறிகின்றிலேன் நான் **","மேவித் தொழும் பிரமன் சிவன் * இந்திரன் ஆதிக்கு எல்லாம் *","நாவிக் கமல முதற் கிழங்கே! * உம்பர் அந்ததுவே"],0,"/media/recitation/TVM.10.10.3.mp3"],[3885,3885,["umbar anthaN pAzhEyO! * adhanuL misai nIyEyO! *","ambara naRsOdhi! * adhanuL piraman aran nI **","umbarum yAdhavarum paDaiththa * munivan avan nI *","em param sAdhikkal uRRu * ennaip pOra viTTiTTAyE"],["உம்பர் அந்தண் பாழேயோ! * அதனுள் மிசை நீயேயோ! *","அம்பர நற்சோதி! * அதனுள் பிரமன் அரன் நீ **","உம்பரும் யாதவரும் படைத்த * முனிவன் அவன் நீ *","எம் பரம் சாதிக்கல் உற்று * என்னைப் போர விட்டிட்டாயே"],0,"/media/recitation/TVM.10.10.4.mp3"],[3886,3886,["pOra viTTiTTu ennai * nI puRam pOkkal uRRAl * pinnai yAn","Araik koNDu eththai andhO! * enadhu enbadhu en? yAn enbadhu en? **","thIra irumbu uNDa nIr adhu pOla * en Ar uyirai","Arap paruga * enakku ArA amudhAnAyE"],["போர விட்டிட்டு என்னை * நீ புறம் போக்கல் உற்றால் * பின்னை யான்","ஆரைக் கொண்டு எத்தை அந்தோ! * எனது என்பது என்? யான் என்பது என்? **","தீர இரும்பு உண்ட நீர் அது போல * என் ஆர் உயிரை","ஆரப் பருக * எனக்கு ஆரா அமுதானாயே"],0,"/media/recitation/TVM.10.10.5.mp3"],[3887,3887,["enakku ArA amudhAy * enadhu Aviyai in uyirai *","manakku ArAmai manni uNDiTTAy * ini uNDu ozhiyAy **","punak kAyA niRaththa * puNDarIgak kaN sengkani vAy *","unakku ERkum kOla malarp pAvaikku anbA! * en anbEyO!"],["எனக்கு ஆரா அமுதாய் * எனது ஆவியை இன் உயிரை *","மனக்கு ஆராமை மன்னி உண்டிட்டாய் * இனி உண்டு ஒழியாய் **","புனக் காயா நிறத்த * புண்டரீகக் கண் செங்கனி வாய் *","உனக்கு ஏற்கும் கோல மலர்ப் பாவைக்கு அன்பா! * என் அன்பேயோ!"],0,"/media/recitation/TVM.10.10.6.mp3"],[3888,3888,["** kOla malarp pAvaikku anbAgiya * en anbEyO! *","nIla varai iraNDu piRai kavvi * nimirndhadhu oppa **","kOla varAgam onRAy * nilam kOTTiDaik koNDa endhAy! *","nIlak kaDal kaDaindhAy * unnaip peRRu inip pOkkuvanO?"],["** கோல மலர்ப் பாவைக்கு அன்பாகிய * என் அன்பேயோ! *","நீல வரை இரண்டு பிறை கவ்வி * நிமிர்ந்தது ஒப்ப **","கோல வராகம் ஒன்றாய் * நிலம் கோட்டிடைக் கொண்ட எந்தாய்! *","நீலக் கடல் கடைந்தாய் * உன்னைப் பெற்று இனிப் போக்குவனோ?"],0,"/media/recitation/TVM.10.10.7.mp3"],[3889,3889,["peRRu inip pOkkuvanO? * unnai en thanip pEr uyirai *","uRRa iru vinaiyAy * uyirAyp payanAy avaiyAy **","muRRa immUvulagum * perunthURAyth thURRil pukku *","muRRak karandhu oLiththAy! * en mudhal thani viththEyO!"],["பெற்று இனிப் போக்குவனோ? * உன்னை என் தனிப் பேர் உயிரை *","உற்ற இரு வினையாய் * உயிராய்ப் பயனாய் அவையாய் **","முற்ற இம்மூவுலகும் * பெருந்தூறாய்த் தூற்றில் புக்கு *","முற்றக் கரந்து ஒளித்தாய்! * என் முதல் தனி வித்தேயோ!"],0,"/media/recitation/TVM.10.10.8.mp3"],[3890,3890,["** mudhal thani viththEyO! * muzhu mUvulagu Adhikku ellAm *","mudhal thani unnai unnai * enai nAL vandhu kUDuvan nAn? **","mudhal thani anggum inggum * muzhu muRRuRu vAzh pAzhAy *","mudhal thani sUzhndhu aganRu Azhndhu uyarndha * muDivu ilIyO!"],["முதல் தனி வித்தேயோ! * முழு மூவுலகு ஆதிக்கு எல்லாம் *","முதல் தனி உன்னை உன்னை * எனை நாள் வந்து கூடுவன் நான்? **","முதல் தனி அங்கும் இங்கும் * முழு முற்றுறு வாழ் பாழாய் *","முதல் தனி சூழ்ந்து அகன்று ஆழ்ந்து உயர்ந்த * முடிவு இலீயோ!"],0,"/media/recitation/TVM.10.10.9.mp3"],[3891,3891,["** sUzhndhaganRu Azhndhu uyarndha * muDivil perum pAzhEyO! *","sUzhndhadhanil periya * para nan malarch sOdhIyO! **","sUzhndhadhanil periya * suDar njAna inbamEyO! *","sUzhndhadhanil periya * en avA aRach sUzhndhAyE!"],["** சூழ்ந்தகன்று ஆழ்ந்து உயர்ந்த * முடிவில் பெரும் பாழேயோ! *","சூழ்ந்ததனில் பெரிய * பர நன் மலர்ச் சோதீயோ! **","சூழ்ந்ததனில் பெரிய * சுடர் ஞான இன்பமேயோ! *","சூழ்ந்ததனில் பெரிய * என் அவா அறச் சூழ்ந்தாயே!"],0,"/media/recitation/TVM.10.10.10.mp3"],[3892,3892,["** avA aRach sUzh * ariyai ayanai aranai alaRRi *","avA aRRu vIDu peRRa * kurugUrch saDakOpan sonna **","avAvil andhAdhigaLAl * ivai Ayiramum * muDindha","avAvil andhAdhi ippaththu aRindhAr * piRandhAr uyarndhE"],["** அவா அறச் சூழ் * அரியை அயனை அரனை அலற்றி *","அவா அற்று வீடு பெற்ற * குருகூர்ச் சடகோபன் சொன்ன **","அவாவில் அந்தாதிகளால் * இவை ஆயிரமும் * முடிந்த","அவாவில் அந்தாதி இப்பத்து அறிந்தார் * பிறந்தார் உயர்ந்தே"],0,"/media/recitation/TVM.10.10.11.mp3"]]]