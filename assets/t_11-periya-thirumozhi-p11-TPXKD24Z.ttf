[[[1748,1748,["** vangga mA munnIr vari niRap periya *","vAL aravin aNai mEvi *","sanggamAr angkaith thaDamalar undhich *","sAma mAmEni en thalaivan **","anggam ARu aindhu vELvi nAl vEdham *","arunggalai payinRu * eri mUnRum","sengkaiyAl vaLarkkum thuLakkamil manaththOr *","thirukkaNNangguDiyuL ninRAnE"],["** வங்க மா முந்நீர் வரி நிறப் பெரிய *","வாள் அரவின் அணை மேவி *","சங்கமார் அங்கைத் தடமலர் உந்திச் *","சாம மாமேனி என் தலைவன் **","அங்கம் ஆறு ஐந்து வேள்வி நால் வேதம் *","அருங்கலை பயின்று * எரி மூன்றும்","செங்கையால் வளர்க்கும் துளக்கமில் மனத்தோர் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.1.mp3"],[1749,1749,["kavaLa mA kadhaththa kari uyyap * poygaik","karAm koLak kalanggi * uL ninaindhu","thuvaLa mEl vandhu thOnRi * van mudhalai","thuNi paDach suDu paDai thurandhOn **","kuvaLai nIL muLari kumudham oNkazhunIr *","koymmalar neydhal oNkazhani *","thivaLum mALigai sUzh sezhumaNip purisaith *","thirukkaNNangguDiyuL ninRAnE"],["கவள மா கதத்த கரி உய்யப் * பொய்கைக்","கராம் கொளக் கலங்கி * உள் நினைந்து","துவள மேல் வந்து தோன்றி * வன் முதலை","துணி படச் சுடு படை துரந்தோன் **","குவளை நீள் முளரி குமுதம் ஒண்கழுநீர் *","கொய்ம்மலர் நெய்தல் ஒண்கழனி *","திவளும் மாளிகை சூழ் செழுமணிப் புரிசைத் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.2.mp3"],[1750,1750,["vAdhai vandhaDara vAnamum nilanum *","malaigaLum alaikaDal kuLippa *","mIdhu koNDu ugaLum mIn uruvAgi *","viripunal vari agaTToLiththOn **","pOdhalar punnai malligai mauval *","pudhu virai madhumalar aNaindhu *","sIdha oNthenRal thisai thoRum kamazhum *","thirukkaNNangguDiyuL ninRAnE"],["வாதை வந்தடர வானமும் நிலனும் *","மலைகளும் அலைகடல் குளிப்ப *","மீது கொண்டு உகளும் மீன் உருவாகி *","விரிபுனல் வரி அகட்டொளித்தோன் **","போதலர் புன்னை மல்லிகை மௌவல் *","புது விரை மதுமலர் அணைந்து *","சீத ஒண்தென்றல் திசை தொறும் கமழும் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.3.mp3"],[1751,1751,["venRi sEr thiNmai vilanggal mAmEni *","veL eyiRRu oL erith thaRu kaN *","panRiyAy anRu pArmagaL payalai","thIrththavan * panjchavar pAgan **","onRalA uruvaththu ulappil palkAlaththu *","uyar koDi oLi vaLar madhiyam *","senRu sEr sennich sigara nanmADath *","thirukkaNNangguDiyuL ninRAnE"],["வென்றி சேர் திண்மை விலங்கல் மாமேனி *","வெள் எயிற்று ஒள் எரித் தறு கண் *","பன்றியாய் அன்று பார்மகள் பயலை","தீர்த்தவன் * பஞ்சவர் பாகன் **","ஒன்றலா உருவத்து உலப்பில் பல்காலத்து *","உயர் கொடி ஒளி வளர் மதியம் *","சென்று சேர் சென்னிச் சிகர நன்மாடத் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.4.mp3"],[1752,1752,["mannavan periya vELviyil kuRaLAy *","mUvaDi nIroDum koNDu *","pinnum Ezhulagum IraDiyAgap *","perunthisai aDanggiDa nimirndhOn **","anna menkamalaththu aNi malarp pIDaththu *","alaipunal ilaik kuDai nIzhal *","sennel oNkavari asaiya vIRRirukkum *","thirukkaNNangguDiyuL ninRAnE"],["மன்னவன் பெரிய வேள்வியில் குறளாய் *","மூவடி நீரொடும் கொண்டு *","பின்னும் ஏழுலகும் ஈரடியாகப் *","பெருந்திசை அடங்கிட நிமிர்ந்தோன் **","அன்ன மென்கமலத்து அணி மலர்ப் பீடத்து *","அலைபுனல் இலைக் குடை நீழல் *","செந்நெல் ஒண்கவரி அசைய வீற்றிருக்கும் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.5.mp3"],[1753,1753,["mazhuvinAl avani arasai mUvezhukAl *","maNimuDi poDi paDuththu * udhirak","kuzhuvu vArpunaluL kuLiththu * vengkObam","thavirndhavan kulai mali kadhali **","kuzhuvum vAr kamugum kuravum naRpalavum *","kuLir tharu sUdha mAdhaviyum *","sezhumaiyAr pozhilgaL thazhuvum nanmADath *","thirukkaNNangguDiyuL ninRAnE"],["மழுவினால் அவனி அரசை மூவெழுகால் *","மணிமுடி பொடி படுத்து * உதிரக்","குழுவு வார்புனலுள் குளித்து * வெங்கோபம்","தவிர்ந்தவன் குலை மலி கதலி **","குழுவும் வார் கமுகும் குரவும் நற்பலவும் *","குளிர் தரு சூத மாதவியும் *","செழுமையார் பொழில்கள் தழுவும் நன்மாடத் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.6.mp3"],[1754,1754,["vāṉ ul̤ār-avarai valimaiyāl naliyum *","maṟi kaṭal ilaṅkaiyār-koṉai *","pāṉu ner carattāl paṉaṅkaṉipolap *","paru muṭi utira vil val̤aittoṉ- **","kāṉ ulām mayiliṉ kaṇaṅkal̤ niṉṟu āṭak *","kaṇa mukil muracam niṉṟu atira *","teṉ ulā vari vaṇṭu iṉ icai muralum *","tirukkaṇṇaṅkuṭiyul̤ niṉṟāṉe-"],["வான் உளார் அவரை வலிமையால் நலியும் *","மறி கடல் இலங்கையார் கோனை *","பானு நேர் சரத்தால் பனங்கனிபோலப் *","பரு முடி உதிர வில் வளைத்தோன் **","கான் உலாம் மயிலின் கணங்கள் நின்று ஆடக் *","கண முகில் முரசம் நின்று அதிர *","தேன் உலா வரி வண்டு இன் இசை முரலும் *","திருக்கண்ணங்குடியுள் நின்றானே"],1,"/media/recitation/PT.9.1.7.mp3"],[1755,1755,["aravu nILkoDiyOn avaiyuL Asanaththai *","anjchiDAdhE iDa * adhaRkup","periya mAmEni aNDam UDuruvap *","perunthisai aDanggiDa nimirndhOn **","varaiyin mAmaNiyum maradhagath thiraLum *","vayiramum vedhir udhir muththum *","thirai koNarndhu undhi vayal thoRum kuvikkum *","thirukkaNNangguDiyuL ninRAnE"],["அரவு நீள்கொடியோன் அவையுள் ஆசனத்தை *","அஞ்சிடாதே இட * அதற்குப்","பெரிய மாமேனி அண்டம் ஊடுருவப் *","பெருந்திசை அடங்கிட நிமிர்ந்தோன் **","வரையின் மாமணியும் மரதகத் திரளும் *","வயிரமும் வெதிர் உதிர் முத்தும் *","திரை கொணர்ந்து உந்தி வயல் தொறும் குவிக்கும் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.8.mp3"],[1756,1756,["panniya bAram pArmagaTku ozhiyap *","bAratha mAperum pOril *","mannargaL maDiya maNi neDum thiNthEr *","maiththunaRku uyththa mAmAyan **","thunnu mAdhaviyum surapunaip pozhilum *","sUzhndhezhu seNbaga malar vAy *","thennavenRu aLigaL muranRu isai pADum *","thirukkaNNangguDiyuL ninRAnE"],["பன்னிய பாரம் பார்மகட்கு ஒழியப் *","பாரத மாபெரும் போரில் *","மன்னர்கள் மடிய மணி நெடும் திண்தேர் *","மைத்துனற்கு உய்த்த மாமாயன் **","துன்னு மாதவியும் சுரபுனைப் பொழிலும் *","சூழ்ந்தெழு செண்பக மலர் வாய் *","தென்னவென்று அளிகள் முரன்று இசை பாடும் *","திருக்கண்ணங்குடியுள் நின்றானே"],0,"/media/recitation/PT.9.1.9.mp3"],[1757,1757,["** kalai ulA algul kArigai thiRaththuk *","kaDal perum paDaiyoDum senRu *","silaiyinAl ilanggai thI ezhach seRRa *","thirukkaNNangguDiyuL ninRAnai **","malai kulA mADa manggaiyar thalaivan *","mAnavEl kaliyan vAy oligaL *","ulavu sol mAlai onbadhODu onRum *","vallavarkku illai nalkuravE"],["** கலை உலா அல்குல் காரிகை திறத்துக் *","கடல் பெரும் படையொடும் சென்று *","சிலையினால் இலங்கை தீ எழச் செற்ற *","திருக்கண்ணங்குடியுள் நின்றானை **","மலை குலா மாட மங்கையர் தலைவன் *","மானவேல் கலியன் வாய் ஒலிகள் *","உலவு சொல் மாலை ஒன்பதோடு ஒன்றும் *","வல்லவர்க்கு இல்லை நல்குரவே"],0,"/media/recitation/PT.9.1.10.mp3"]],[[1758,1758,["pŏṉ ivar meṉi marakatattiṉ *","pŏṅku il̤añ coti akalattu āram","miṉ * ivar vāyil nal vetam otum *","vetiyar vāṉavar āvar tozhī **","ĕṉṉaiyum nokki ĕṉ alkulum nokki *","entu il̤aṅ kŏṅkaiyum nokkukiṉṟār *","aṉṉai ĕṉ nokkum ĕṉṟu añcukiṉṟeṉ- *","acco ŏruvar azhakiyavā-"],["பொன் இவர் மேனி மரகதத்தின் *","பொங்கு இளஞ் சோதி அகலத்து ஆரம்","மின் * இவர் வாயில் நல் வேதம் ஓதும் *","வேதியர் வானவர் ஆவர் தோழீ **","என்னையும் நோக்கி என் அல்குலும் நோக்கி *","ஏந்து இளங் கொங்கையும் நோக்குகின்றார் *","அன்னை என் நோக்கும் என்று அஞ்சுகின்றேன் *","அச்சோ ஒருவர் அழகியவா"],1,"/media/recitation/PT.9.2.1.mp3"],[1759,1759,["thODavizh nIlam maNam koDukkum *","sUzh punal sUzh kuDandhaik kiDandha *","sEDar kol enRu therikka mATTEn *","senjchuDar Azhiyum sanggum Endhi **","pADaga mellaDiyAr vaNanggap *","panmaNi muththoDu ilanggu sOdhi *","ADagam pUNDoru nAngu thOLum *","achchO oruvar azhagiyavA!"],["தோடவிழ் நீலம் மணம் கொடுக்கும் *","சூழ் புனல் சூழ் குடந்தைக் கிடந்த *","சேடர் கொல் என்று தெரிக்க மாட்டேன் *","செஞ்சுடர் ஆழியும் சங்கும் ஏந்தி **","பாடக மெல்லடியார் வணங்கப் *","பன்மணி முத்தொடு இலங்கு சோதி *","ஆடகம் பூண்டொரு நான்கு தோளும் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.2.mp3"],[1760,1760,["vEy irunjchOlai vilanggal sUzhndha *","meyya maNALar ivvaiyam ellAm *","thAyina nAyagar Avar thOzhI! *","thAmaraik kaNgaL irundhavARu **","sEy irungkunRam thigazhndhadhu oppach *","sevviyavAgi malarndha sOdhi *","Ayiram thOLoDu ilanggu pUNum *","achchO oruvar azhagiyavA!"],["வேய் இருஞ்சோலை விலங்கல் சூழ்ந்த *","மெய்ய மணாளர் இவ்வையம் எல்லாம் *","தாயின நாயகர் ஆவர் தோழீ! *","தாமரைக் கண்கள் இருந்தவாறு **","சேய் இருங்குன்றம் திகழ்ந்தது ஒப்பச் *","செவ்வியவாகி மலர்ந்த சோதி *","ஆயிரம் தோளொடு இலங்கு பூணும் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.3.mp3"],[1761,1761,["vambavizhum thuzhAy mAlai thOL mEl *","kaiyana Azhiyum sanggum Endhi *","nambar nam illam pugundhu ninRAr *","nAgarigar peridhum iLaiyar **","sempavaLam ivar vAyin vaNNam *","dhEvar ivaradhu uruvam sollil *","ampavaLath thiraLEyum oppar *","achchO oruvar azhagiyavA!"],["வம்பவிழும் துழாய் மாலை தோள் மேல் *","கையன ஆழியும் சங்கும் ஏந்தி *","நம்பர் நம் இல்லம் புகுந்து நின்றார் *","நாகரிகர் பெரிதும் இளையர் **","செம்பவளம் இவர் வாயின் வண்ணம் *","தேவர் இவரது உருவம் சொல்லில் *","அம்பவளத் திரளேயும் ஒப்பர் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.4.mp3"],[1762,1762,["kOzhiyum kUDalum kOyil koNDa *","kOvalarE oppar kunRam anna *","pAzhi anthOLum Or nAnguDaiyar *","paNDu ivar thammaiyum kaNDaRiyOm **","vAzhiyarO ivar vaNNam eNNil *","mAkaDal pOnRuLar kaiyil veyya *","Azhi onRu Endhi Or sanggu paRRi *","achchO oruvar azhagiyavA!"],["கோழியும் கூடலும் கோயில் கொண்ட *","கோவலரே ஒப்பர் குன்றம் அன்ன *","பாழி அந்தோளும் ஓர் நான்குடையர் *","பண்டு இவர் தம்மையும் கண்டறியோம் **","வாழியரோ இவர் வண்ணம் எண்ணில் *","மாகடல் போன்றுளர் கையில் வெய்ய *","ஆழி ஒன்று ஏந்தி ஓர் சங்கு பற்றி *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.5.mp3"],[1763,1763,["venjchina vEzham marupposiththa *","vEndhar kol? EndhizhaiyAr manaththai *","thanjchuDaiyALar kol? yAn aRiyEn *","thAmaraik kaNgaL irundhavARu **","kanjchanai anjcha mun kAl visaiththa *","kALaiyar Avar kaNDAr vaNanggum *","anjchana mAmalaiyEyum oppar *","achchO oruvar azhagiyavA!"],["வெஞ்சின வேழம் மருப்பொசித்த *","வேந்தர் கொல்? ஏந்திழையார் மனத்தை *","தஞ்சுடையாளர் கொல்? யான் அறியேன் *","தாமரைக் கண்கள் இருந்தவாறு **","கஞ்சனை அஞ்ச முன் கால் விசைத்த *","காளையர் ஆவர் கண்டார் வணங்கும் *","அஞ்சன மாமலையேயும் ஒப்பர் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.6.mp3"],[1764,1764,["piNi avizh thAmarai moTTalarththum *","pEraruLALar kol? yAn aRiyEn *","paNiyum en nenjcham idhen kol? thOzhI! *","paNDu ivar thammaiyum kaNDaRiyOm **","aNi kezhu thAmarai anna kaNNum *","angkaiyum panggayam mEni vAnaththu *","aNi kezhu mAmugilEyum oppar *","achchO oruvar azhagiyavA!"],["பிணி அவிழ் தாமரை மொட்டலர்த்தும் *","பேரருளாளர் கொல்? யான் அறியேன் *","பணியும் என் நெஞ்சம் இதென் கொல்? தோழீ! *","பண்டு இவர் தம்மையும் கண்டறியோம் **","அணி கெழு தாமரை அன்ன கண்ணும் *","அங்கையும் பங்கயம் மேனி வானத்து *","அணி கெழு மாமுகிலேயும் ஒப்பர் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.7.mp3"],[1765,1765,["manjchuyar mAmadhi thINDa nINDa *","mAlirunjchOlai maNALar vandhu * en","nenjchuLLum kaNNuLLum ninRu nInggAr *","nIrmalaiyAr kol? ninaikka mATTEn **","manjchuyar ponmalai mEl ezhundha *","mAmugil pOnRuLar vandhu kANIr *","anjchiRaip puLLum onRu ERi vandhAr *","achchO oruvar azhagiyavA!"],["மஞ்சுயர் மாமதி தீண்ட நீண்ட *","மாலிருஞ்சோலை மணாளர் வந்து * என்","நெஞ்சுள்ளும் கண்ணுள்ளும் நின்று நீங்கார் *","நீர்மலையார் கொல்? நினைக்க மாட்டேன் **","மஞ்சுயர் பொன்மலை மேல் எழுந்த *","மாமுகில் போன்றுளர் வந்து காணீர் *","அஞ்சிறைப் புள்ளும் ஒன்று ஏறி வந்தார் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.8.mp3"],[1766,1766,["eNthisaiyum eRi nIrk kaDalum *","Ezhulagum uDanE vizhunggi *","maNDi Or Alilaip paLLi koLLum *","mAyar kol? mAyam aRiya mATTEn **","koNDal nanmAl varaiyEyum oppar *","konggalar thAmaraik kaNNum vAyum *","aNDaththu amarar paNiya ninRAr *","achchO oruvar azhagiyavA!"],["எண்திசையும் எறி நீர்க் கடலும் *","ஏழுலகும் உடனே விழுங்கி *","மண்டி ஓர் ஆலிலைப் பள்ளி கொள்ளும் *","மாயர் கொல்? மாயம் அறிய மாட்டேன் **","கொண்டல் நன்மால் வரையேயும் ஒப்பர் *","கொங்கலர் தாமரைக் கண்ணும் வாயும் *","அண்டத்து அமரர் பணிய நின்றார் *","அச்சோ ஒருவர் அழகியவா!"],0,"/media/recitation/PT.9.2.9.mp3"],[1767,1767,["** annamum kEzhalum mInum Aya *","Adhiyai nAgai azhagiyArai *","kanni nanmAmadhiL manggai vEndhan *","kAmaru sIrk kalikanRi ** kunRA","innisaiyAl sonna senjchol mAlai *","Ezhum iraNDum oronRum vallAr *","mannavarAy ulagANDu * mINDum","vAnavarAy magizhvu eydhuvarE"],["** அன்னமும் கேழலும் மீனும் ஆய *","ஆதியை நாகை அழகியாரை *","கன்னி நன்மாமதிள் மங்கை வேந்தன் *","காமரு சீர்க் கலிகன்றி ** குன்றா","இன்னிசையால் சொன்ன செஞ்சொல் மாலை *","ஏழும் இரண்டும் ஒரொன்றும் வல்லார் *","மன்னவராய் உலகாண்டு * மீண்டும்","வானவராய் மகிழ்வு எய்துவரே"],0,"/media/recitation/PT.9.2.10.mp3"]],[[1768,1768,["taṉṉai naivikkileṉ * val viṉaiyeṉ tŏzhutum ĕzhu- *","pŏṉṉai naivikkum * ap pūñ cĕrunti maṇa nīzhalvāy **","ĕṉṉai naivittu * ĕzhil kŏṇṭu akaṉṟa pĕrumāṉ iṭam *","puṉṉai muttam pŏzhil cūzhntu * azhaku āya pullāṇiye-"],["தன்னை நைவிக்கிலேன் * வல் வினையேன் தொழுதும் எழு *","பொன்னை நைவிக்கும் * அப் பூஞ் செருந்தி மண நீழல்வாய் **","என்னை நைவித்து * எழில் கொண்டு அகன்ற பெருமான் இடம் *","புன்னை முத்தம் பொழில் சூழ்ந்து * அழகு ஆய புல்லாணியே"],1,"/media/recitation/PT.9.3.1.mp3"],[1769,1769,["urugi nenjchE! ninaindhu inggu irundhen? * thozhudhum ezhu *","murugu vaNDuN malark kaidhaiyin nIzhalil * munnoru nAL **","perugu kAdhanmai * en uLLam eydhap pirindhAn iDam *","porudhu munnIrk karaikkE * maNi undhu pullANiyE"],["உருகி நெஞ்சே! நினைந்து இங்கு இருந்தென்? * தொழுதும் எழு *","முருகு வண்டுண் மலர்க் கைதையின் நீழலில் * முன்னொரு நாள் **","பெருகு காதன்மை * என் உள்ளம் எய்தப் பிரிந்தான் இடம் *","பொருது முந்நீர்க் கரைக்கே * மணி உந்து புல்லாணியே"],0,"/media/recitation/PT.9.3.2.mp3"],[1770,1770,["Edhu seydhAl maRakkEn? * manamE! thozhudhum ezhu *","thAdhu malgu thaDam sUzh pozhil * thAzhvar thoDarndhu ** pin","pEdhai ninaip piriyEn ini * enRu aganRAn iDam *","pOdhu nALum kamazhum * pozhil sUzhndha pullANiyE"],["ஏது செய்தால் மறக்கேன்? * மனமே! தொழுதும் எழு *","தாது மல்கு தடம் சூழ் பொழில் * தாழ்வர் தொடர்ந்து ** பின்","பேதை நினைப் பிரியேன் இனி * என்று அகன்றான் இடம் *","போது நாளும் கமழும் * பொழில் சூழ்ந்த புல்லாணியே"],0,"/media/recitation/PT.9.3.3.mp3"],[1771,1771,["kongguN vaNDE kari Aga vandhAn * koDiyERku * mun","nanggaL Isan * namakkE paNiththa mozhi seydhilan **","manggai nallAy! thozhudhum ezhu * pOy avan mannum Ur *","ponggu munnIrk karaikkE * maNi undhu pullANiyE"],["கொங்குண் வண்டே கரி ஆக வந்தான் * கொடியேற்கு * முன்","நங்கள் ஈசன் * நமக்கே பணித்த மொழி செய்திலன் **","மங்கை நல்லாய்! தொழுதும் எழு * போய் அவன் மன்னும் ஊர் *","பொங்கு முந்நீர்க் கரைக்கே * மணி உந்து புல்லாணியே"],0,"/media/recitation/PT.9.3.4.mp3"],[1772,1772,["uNaril uLLam suDum Al * vinaiyEn thozhudhum ezhu *","thuNari njAzhal naRum pOdhu * nam sUzh kuzhal peydhu ** pin","thaNaril Avi thaLarum ena * anbu thandhAn iDam *","puNari Odham paNilam * maNi undhu pullANiyE"],["உணரில் உள்ளம் சுடும் ஆல் * வினையேன் தொழுதும் எழு *","துணரி ஞாழல் நறும் போது * நம் சூழ் குழல் பெய்து ** பின்","தணரில் ஆவி தளரும் என * அன்பு தந்தான் இடம் *","புணரி ஓதம் பணிலம் * மணி உந்து புல்லாணியே"],0,"/media/recitation/PT.9.3.5.mp3"],[1773,1773,["eLgi nenjchE! ninaindhu inggu irundhen? * thozhudhum ezhu *","vaLLal mAyan * maNivaNNan emmAn maruvum iDam **","kaL avizhum malark kAviyum * thUmaDal kaidhaiyum *","puLLum aLLal pazhananggaLum sUzhndha * pullANiyE"],["எள்கி நெஞ்சே! நினைந்து இங்கு இருந்தென்? * தொழுதும் எழு *","வள்ளல் மாயன் * மணிவண்ணன் எம்மான் மருவும் இடம் **","கள் அவிழும் மலர்க் காவியும் * தூமடல் கைதையும் *","புள்ளும் அள்ளல் பழனங்களும் சூழ்ந்த * புல்லாணியே"],0,"/media/recitation/PT.9.3.6.mp3"],[1774,1774,["paravi nenjchE! thozhudhum ezhu * pOy avan pAlamAy *","iravum nALum inik * kaN thuyilAdhu irundhen payan? **","viravi muththam * neDu veNmaNal mEl koNDu * veNthirai","puravi ennap pudham seydhu * vandhundhu pullANiyE"],["பரவி நெஞ்சே! தொழுதும் எழு * போய் அவன் பாலமாய் *","இரவும் நாளும் இனிக் * கண் துயிலாது இருந்தென் பயன்? **","விரவி முத்தம் * நெடு வெண்மணல் மேல் கொண்டு * வெண்திரை","புரவி என்னப் புதம் செய்து * வந்துந்து புல்லாணியே"],0,"/media/recitation/PT.9.3.7.mp3"],[1775,1775,["alamum Azhip paDaiyum uDaiyAr * namakku anbarAy *","salam adhAgith thagavonRilar * nAm thozhudhum ezhu **","ulavu kAl naRkazhi Onggu * thaNpaimpozhil UDu * isai","pulavu kAnal * kaLivaNDinam pADu pullANiyE"],["அலமும் ஆழிப் படையும் உடையார் * நமக்கு அன்பராய் *","சலம் அதாகித் தகவொன்றிலர் * நாம் தொழுதும் எழு **","உலவு கால் நற்கழி ஓங்கு * தண்பைம்பொழில் ஊடு * இசை","புலவு கானல் * களிவண்டினம் பாடு புல்லாணியே"],0,"/media/recitation/PT.9.3.8.mp3"],[1776,1776,["oti nāmam kul̤ittu ucci-taṉṉāl * ŏl̤i mā malar *","pātam nāl̤um paṇivom * namakke nalam ātaliṉ **","ātu tārāṉ ĕṉilum tarum * aṉṟiyum aṉpar āy *","potum māte tŏzhutum- * avaṉ maṉṉu pullāṇiye-"],["ஓதி நாமம் குளித்து உச்சி தன்னால் * ஒளி மா மலர் *","பாதம் நாளும் பணிவோம் * நமக்கே நலம் ஆதலின் **","ஆது தாரான் எனிலும் தரும் * அன்றியும் அன்பர் ஆய் *","போதும் மாதே தொழுதும் * அவன் மன்னு புல்லாணியே"],1,"/media/recitation/PT.9.3.9.mp3"],[1777,1777,["** ilanggu muththum pavaLak kozhundhum * ezhil thAmarai *","pulanggaL muRRum pozhil sUzhndhu * azhagAya pullANi mEl **","kalanggal illAp pugazhAn * kaliyan oli mAlai *","valangkoL thoNDarkku iDam Avadhu * pADil vaikundhamE"],["** இலங்கு முத்தும் பவளக் கொழுந்தும் * எழில் தாமரை *","புலங்கள் முற்றும் பொழில் சூழ்ந்து * அழகாய புல்லாணி மேல் **","கலங்கல் இல்லாப் புகழான் * கலியன் ஒலி மாலை *","வலங்கொள் தொண்டர்க்கு இடம் ஆவது * பாடில் வைகுந்தமே"],0,"/media/recitation/PT.9.3.10.mp3"]],[[1778,1778,["** kAvAr maDal peNNai * anRil ari kuralum *","EvAyin UDu iyanggum * eqkiR koDidhAlO! **","pUvAr maNam kamazhum * pullANi kai thozhudhEn *","pAvAy! idhu namakkOr * pAnmaiyE AgAdhE"],["** காவார் மடல் பெண்ணை * அன்றில் அரி குரலும் *","ஏவாயின் ஊடு இயங்கும் * எஃகிற் கொடிதாலோ! **","பூவார் மணம் கமழும் * புல்லாணி கை தொழுதேன் *","பாவாய்! இது நமக்கோர் * பான்மையே ஆகாதே"],0,"/media/recitation/PT.9.4.1.mp3"],[1779,1779,["munnam kuRaL uruvAy * mUvaDi maN koNDaLandha *","mannan saridhaikkE * mAl Agip pon payandhEn **","pon angkazhik kAnal * puLLinanggAL! pullANi *","annamAy nUl payandhARku * Anggu idhanaich seppuminE"],["முன்னம் குறள் உருவாய் * மூவடி மண் கொண்டளந்த *","மன்னன் சரிதைக்கே * மால் ஆகிப் பொன் பயந்தேன் **","பொன் அங்கழிக் கானல் * புள்ளினங்காள்! புல்லாணி *","அன்னமாய் நூல் பயந்தாற்கு * ஆங்கு இதனைச் செப்புமினே"],0,"/media/recitation/PT.9.4.2.mp3"],[1780,1780,["vavvith thuzhAy adhan mEl * senRa thani nenjcham *","sevvi aRiyAdhu * niRkungkol? niththilanggaL **","pavvath thirai ulavu * pullANi kai thozhudhEn *","dheyvach silaiyARku * en sindhai nOy seppuminE"],["வவ்வித் துழாய் அதன் மேல் * சென்ற தனி நெஞ்சம் *","செவ்வி அறியாது * நிற்குங்கொல்? நித்திலங்கள் **","பவ்வத் திரை உலவு * புல்லாணி கை தொழுதேன் *","தெய்வச் சிலையாற்கு * என் சிந்தை நோய் செப்புமினே"],0,"/media/recitation/PT.9.4.3.mp3"],[1781,1781,["pariya iraNiyanadhu Agam * aNi ugirAl *","ari uruvAyk kINDAn * aruL thandhavA! namakku **","poru thiraigaL pOndhulavu * pullANi kai thozhudhEn *","ari malark kaN nIr thadhumba * anthugilum nillAvE"],["பரிய இரணியனது ஆகம் * அணி உகிரால் *","அரி உருவாய்க் கீண்டான் * அருள் தந்தவா! நமக்கு **","பொரு திரைகள் போந்துலவு * புல்லாணி கை தொழுதேன் *","அரி மலர்க் கண் நீர் ததும்ப * அந்துகிலும் நில்லாவே"],0,"/media/recitation/PT.9.4.4.mp3"],[1782,1782,["** villAl ilanggai malanggach * saram thurandha *","vallALan pin pOna * nenjcham varum aLavum **","ellArum en thannai * Esilum pEsiDinum *","pullANi emperumAn * poy kETTu irundhEnE"],["** வில்லால் இலங்கை மலங்கச் * சரம் துரந்த *","வல்லாளன் பின் போன * நெஞ்சம் வரும் அளவும் **","எல்லாரும் என் தன்னை * ஏசிலும் பேசிடினும் *","புல்லாணி எம்பெருமான் * பொய் கேட்டு இருந்தேனே"],0,"/media/recitation/PT.9.4.5.mp3"],[1783,1783,["suzhanRu ilanggu vengkadhirOn * thErODum pOy maRaindhAn *","azhanRu koDidhAgi * anjchuDaril thAn aDumAl **","sezhunthaDam pUnjchOlai sUzh * pullANi kai thozhudhEn *","izhandhirundhEn en than * ezhil niRamum sanggumE"],["சுழன்று இலங்கு வெங்கதிரோன் * தேரோடும் போய் மறைந்தான் *","அழன்று கொடிதாகி * அஞ்சுடரில் தான் அடுமால் **","செழுந்தடம் பூஞ்சோலை சூழ் * புல்லாணி கை தொழுதேன் *","இழந்திருந்தேன் என் தன் * எழில் நிறமும் சங்குமே"],0,"/media/recitation/PT.9.4.6.mp3"],[1784,1784,["kanaiyAr iDikuralin * kArmaNiyin nA ADal *","thinaiyEnum nillAdhu * thIyil koDidhAlO **","punaiyAr maNimADap * pullANi kai thozhudhEn *","vinaiyEn mEl vElaiyum * venthazhalE vIsumE"],["கனையார் இடிகுரலின் * கார்மணியின் நா ஆடல் *","தினையேனும் நில்லாது * தீயில் கொடிதாலோ **","புனையார் மணிமாடப் * புல்லாணி கை தொழுதேன் *","வினையேன் மேல் வேலையும் * வெந்தழலே வீசுமே"],0,"/media/recitation/PT.9.4.7.mp3"],[1785,1785,["thUmbuDaik kai vEzham * veruva maruppu osiththa *","pAmbin aNaiyAn * aruL thandhavA! namakku **","pUnjcherundhi pon soriyum * pullANi kai thozhudhEn *","thEmbal iLampiRaiyum * en thanakkOr venthazhalE"],["தூம்புடைக் கை வேழம் * வெருவ மருப்பு ஒசித்த *","பாம்பின் அணையான் * அருள் தந்தவா! நமக்கு **","பூஞ்செருந்தி பொன் சொரியும் * புல்லாணி கை தொழுதேன் *","தேம்பல் இளம்பிறையும் * என் தனக்கோர் வெந்தழலே"],0,"/media/recitation/PT.9.4.8.mp3"],[1786,1786,["vEdhamum vELviyum * viNNum irusuDarum *","Adhiyum AnAn * aruL thandhavA! namakku **","pOdhalarum punnai sUzh * pullANi kai thozhudhEn *","Odhamum nAnum * uRanggAdhu irundhEnE"],["வேதமும் வேள்வியும் * விண்ணும் இருசுடரும் *","ஆதியும் ஆனான் * அருள் தந்தவா! நமக்கு **","போதலரும் புன்னை சூழ் * புல்லாணி கை தொழுதேன் *","ஓதமும் நானும் * உறங்காது இருந்தேனே"],0,"/media/recitation/PT.9.4.9.mp3"],[1787,1787,["** pon alarum punnai sUzh * pullANi ammAnai *","min iDaiyAr vETkai nOy kUra * irundhadhanai **","kal navilum thiNthOL * kaliyan oli vallAr *","mannavarAy maNNANDu * vAnADum unnuvarE"],["** பொன் அலரும் புன்னை சூழ் * புல்லாணி அம்மானை *","மின் இடையார் வேட்கை நோய் கூர * இருந்ததனை **","கல் நவிலும் திண்தோள் * கலியன் ஒலி வல்லார் *","மன்னவராய் மண்ணாண்டு * வானாடும் உன்னுவரே"],0,"/media/recitation/PT.9.4.10.mp3"]],[[1788,1788,["** thavaLa iLampiRai thuLLu munnIrth *","thaNmalarth thenRalODu anRil onRith","thuvaLa * en nenjchagam sOra Irum *","sUzh pani nAL thuyilAdhu iruppEn **","ivaLum Or peNkoDi enRu iranggAr *","en nalam aindhum mun koNDu pOna *","kuvaLai malar niRa vaNNar mannu *","kuRungguDikkE ennai uyththiDumin"],["** தவள இளம்பிறை துள்ளு முந்நீர்த் *","தண்மலர்த் தென்றலோடு அன்றில் ஒன்றித்","துவள * என் நெஞ்சகம் சோர ஈரும் *","சூழ் பனி நாள் துயிலாது இருப்பேன் **","இவளும் ஓர் பெண்கொடி என்று இரங்கார் *","என் நலம் ஐந்தும் முன் கொண்டு போன *","குவளை மலர் நிற வண்ணர் மன்னு *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.1.mp3"],[1789,1789,["thAdhavizh malligai pulli vandha *","thaNmadhiyin iLa vADai innE *","Udhai thiridhandhu uzhaRi uNNa *","Or iravum uRanggEn ** uRanggum","pEdhaiyar pEdhaimaiyAl irundhu *","pEsilum pEsuga pey vaLaiyAr *","kOdhai naRumalar manggai mArvan *","kuRungguDikkE ennai uyththiDumin"],["தாதவிழ் மல்லிகை புல்லி வந்த *","தண்மதியின் இள வாடை இன்னே *","ஊதை திரிதந்து உழறி உண்ண *","ஓர் இரவும் உறங்கேன் ** உறங்கும்","பேதையர் பேதைமையால் இருந்து *","பேசிலும் பேசுக பெய் வளையார் *","கோதை நறுமலர் மங்கை மார்வன் *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.2.mp3"],[1790,1790,["kālaiyum mālai ŏttuṇṭu * kaṅkul","nāzhikai ūzhiyil nīṇṭu ulāvum *","polvatu or taṉmai pukuntu niṟkum *","pŏṅku azhale ŏkkum vāṭai cŏllil **","mālavaṉ mā maṇi vaṇṇaṉ māyam *","maṟṟum ul̤a avai vantiṭāmuṉ *","kola mayil payilum puṟaviṉ *","kuṟuṅkuṭikke ĕṉṉai uyttiṭumiṉ-"],["காலையும் மாலை ஒத்துண்டு * கங்குல்","நாழிகை ஊழியில் நீண்டு உலாவும் *","போல்வது ஓர் தன்மை புகுந்து நிற்கும் *","பொங்கு அழலே ஒக்கும் வாடை சொல்லில் **","மாலவன் மா மணி வண்ணன் மாயம் *","மற்றும் உள அவை வந்திடாமுன் *","கோல மயில் பயிலும் புறவின் *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],1,"/media/recitation/PT.9.5.3.mp3"],[1791,1791,["karu maṇi pūṇṭu vĕṇ nāku aṇaintu *","kār imil eṟṟu aṇar tāzhntu ulāvum *","ŏru maṇi ocai ĕṉ ul̤l̤am tal̤l̤a *","or iravum uṟaṅkātiruppeṉ- **","pĕru maṇi vāṉavar ucci vaitta *","per arul̤āl̤aṉ pĕrumai peci *","kuru maṇi nīr kŏzhikkum puṟaviṉ *","kuṟuṅkuṭikke ĕṉṉai uyttiṭumiṉ-"],["கரு மணி பூண்டு வெண் நாகு அணைந்து *","கார் இமில் ஏற்று அணர் தாழ்ந்து உலாவும் *","ஒரு மணி ஓசை என் உள்ளம் தள்ள *","ஓர் இரவும் உறங்காதிருப்பேன் **","பெரு மணி வானவர் உச்சி வைத்த *","பேர் அருளாளன் பெருமை பேசி *","குரு மணி நீர் கொழிக்கும் புறவின் *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],1,"/media/recitation/PT.9.5.4.mp3"],[1792,1792,["thiNthimil ERRin maNiyum * Ayan","thIngkuzhal Osaiyum thenRalODu *","koNDadhOr mAlaiyum andhi InRa *","kOla iLampiRaiyODu kUDi **","paNDaiya alla ivai namakkup *","pAviyEn Aviyai vATTam seyyum *","koNDal maNi niRa vaNNar mannu *","kuRungguDikkE ennai uyththiDumin"],["திண்திமில் ஏற்றின் மணியும் * ஆயன்","தீங்குழல் ஓசையும் தென்றலோடு *","கொண்டதோர் மாலையும் அந்தி ஈன்ற *","கோல இளம்பிறையோடு கூடி **","பண்டைய அல்ல இவை நமக்குப் *","பாவியேன் ஆவியை வாட்டம் செய்யும் *","கொண்டல் மணி நிற வண்ணர் மன்னு *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.5.mp3"],[1793,1793,["elliyum nanpagalum irundhE *","Esilum Esuga EndhizhaiyAr *","nallar avar thiRam nAm aRiyOm *","nAN maDam achcham namakku inggillai **","vallana solli magizhvarElum *","mAmaNi vaNNarai nAm maRavOm *","kollai vaLar iLamullai pulgu *","kuRungguDikkE ennai uyththiDumin"],["எல்லியும் நன்பகலும் இருந்தே *","ஏசிலும் ஏசுக ஏந்திழையார் *","நல்லர் அவர் திறம் நாம் அறியோம் *","நாண் மடம் அச்சம் நமக்கு இங்கில்லை **","வல்லன சொல்லி மகிழ்வரேலும் *","மாமணி வண்ணரை நாம் மறவோம் *","கொல்லை வளர் இளமுல்லை புல்கு *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.6.mp3"],[1794,1794,["sengkaN neDiya kariya mEnith *","thEvar oruvar inggE pugundhu * en","anggam meliya vaLai kazhala *","Adhu kolO? enRu sonna pinnai **","aingkaNai villi than ANmai *","ennODu ADum adhanai aRiya mATTEn *","konggalar thaNpaNai sUzh puRavil *","kuRungguDikkE ennai uyththiDumin"],["செங்கண் நெடிய கரிய மேனித் *","தேவர் ஒருவர் இங்கே புகுந்து * என்","அங்கம் மெலிய வளை கழல *","ஆது கொலோ? என்று சொன்ன பின்னை **","ஐங்கணை வில்லி தன் ஆண்மை *","என்னோடு ஆடும் அதனை அறிய மாட்டேன் *","கொங்கலர் தண்பணை சூழ் புறவில் *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.7.mp3"],[1795,1795,["kEvalam anRu kaDalin Osai *","kENmingaL Ayan kai Ambal vandhu * en","Avi aLavum aNaindhu niRkum *","anRiyum aindhu kaNai therindhiTTu **","Evalam kATTi ivan oruvan *","ippaDiyE pugundhu eydhiDA mun *","kOvalar kUththan kuRippu aRindhu *","kuRungguDikkE ennai uyththiDumin"],["கேவலம் அன்று கடலின் ஓசை *","கேண்மின்கள் ஆயன் கை ஆம்பல் வந்து * என்","ஆவி அளவும் அணைந்து நிற்கும் *","அன்றியும் ஐந்து கணை தெரிந்திட்டு **","ஏவலம் காட்டி இவன் ஒருவன் *","இப்படியே புகுந்து எய்திடா முன் *","கோவலர் கூத்தன் குறிப்பு அறிந்து *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.8.mp3"],[1796,1796,["sOththena ninRu thozha iranggAn *","thonnalam koNDu enakku inRu thARum *","pOrppadhOr poRpaDam thandhu pOnAn *","pOyina Ur aRiyEn ** en konggai","mUththiDuginRana * maRRavan than","moy agalam aNaiyAdhu vALA *","kUththan imaiyavar kOn virumbum *","kuRungguDikkE ennai uyththiDumin"],["சோத்தென நின்று தொழ இரங்கான் *","தொன்னலம் கொண்டு எனக்கு இன்று தாறும் *","போர்ப்பதோர் பொற்படம் தந்து போனான் *","போயின ஊர் அறியேன் ** என் கொங்கை","மூத்திடுகின்றன * மற்றவன் தன்","மொய் அகலம் அணையாது வாளா *","கூத்தன் இமையவர் கோன் விரும்பும் *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],0,"/media/recitation/PT.9.5.9.mp3"],[1797,1797,["cĕṟṟavaṉ tĕṉ ilaṅkai malaṅkat *","tevar pirāṉ tiru mā makal̤aip","pĕṟṟum * ĕṉ nĕñcakam koyil kŏṇṭa *","per-arul̤āl̤aṉ pĕrumai pecak","kaṟṟavaṉ ** kāmaru cīrk kaliyaṉ *","kaṇ akattum maṉattum akalāk","kŏṟṟavaṉ * muṟṟu ulaku āl̤i niṉṟa *","kuṟuṅkuṭikke ĕṉṉai uyttiṭumiṉ-"],["செற்றவன் தென் இலங்கை மலங்கத் *","தேவர் பிரான் திரு மா மகளைப்","பெற்றும் * என் நெஞ்சகம் கோயில் கொண்ட *","பேர் அருளாளன் பெருமை பேசக்","கற்றவன் ** காமரு சீர்க் கலியன் *","கண் அகத்தும் மனத்தும் அகலாக்","கொற்றவன் * முற்று உலகு ஆளி நின்ற *","குறுங்குடிக்கே என்னை உய்த்திடுமின்"],1,"/media/recitation/PT.9.5.10.mp3"]],[[1798,1798,["** akkum puliyin * adhaLum uDaiyAr * avar oruvar","pakkam niRka ninRa * paNbar Ur pOlum **","thakka maraththin * thAzh sinai ERi * thAy vAyil","kokkin piLLai * veLLiRavuNNum kuRungguDiyE"],["** அக்கும் புலியின் * அதளும் உடையார் * அவர் ஒருவர்","பக்கம் நிற்க நின்ற * பண்பர் ஊர் போலும் **","தக்க மரத்தின் * தாழ் சினை ஏறி * தாய் வாயில்","கொக்கின் பிள்ளை * வெள்ளிறவுண்ணும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.1.mp3"],[1799,1799,["thunggAr aravath * thirai vandhulavath * thoDukaDaluL","ponggAr aravil thuyilum * punidhar Ur pOlum **","sengkAl annam * thigazh thaNpaNaiyil peDaiyODum *","konggAr kamalaththu * alaril sErum kuRungguDiyE"],["துங்கார் அரவத் * திரை வந்துலவத் * தொடுகடலுள்","பொங்கார் அரவில் துயிலும் * புனிதர் ஊர் போலும் **","செங்கால் அன்னம் * திகழ் தண்பணையில் பெடையோடும் *","கொங்கார் கமலத்து * அலரில் சேரும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.2.mp3"],[1800,1800,["vAzhak kaNDOm * vandhu kANmin thoNDIrgAL! *","kEzhal sengkaN * mAmugil vaNNar maruvum Ur **","Ezhaich sengkAl * in thuNai nAraikku irai thEDi *","kUzhaip pArvaik * kAr vayal mEyum kuRungguDiyE"],["வாழக் கண்டோம் * வந்து காண்மின் தொண்டீர்காள்! *","கேழல் செங்கண் * மாமுகில் வண்ணர் மருவும் ஊர் **","ஏழைச் செங்கால் * இன் துணை நாரைக்கு இரை தேடி *","கூழைப் பார்வைக் * கார் வயல் மேயும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.3.mp3"],[1801,1801,["ciram muṉ aintum aintum * cintac cĕṉṟu * arakkaṉ","uramum karamum tuṇitta * uravoṉ ūrpolum- **","iravum pakalum * īṉ teṉ murala * maṉṟu ĕllām","kuraviṉ pūve-tāṉ * maṇam nāṟum kuṟuṅkuṭiye"],["சிரம் முன் ஐந்தும் ஐந்தும் * சிந்தச் சென்று * அரக்கன்","உரமும் கரமும் துணித்த * உரவோன் ஊர்போலும் **","இரவும் பகலும் * ஈன் தேன் முரல * மன்று எல்லாம்","குரவின் பூவே தான் * மணம் நாறும் குறுங்குடியே"],1,"/media/recitation/PT.9.6.4.mp3"],[1802,1802,["kavvaik kaLiRRu mannar mALak * kali mAn thEr","aivarkkAy * anRu amaril uyththAn Ur pOlum **","mai vaiththu ilanggu * kaNNAr thanggaL mozhi oppAn *","kovvaik kani vAyk * kiLLai pEsum kuRungguDiyE"],["கவ்வைக் களிற்று மன்னர் மாளக் * கலி மான் தேர்","ஐவர்க்காய் * அன்று அமரில் உய்த்தான் ஊர் போலும் **","மை வைத்து இலங்கு * கண்ணார் தங்கள் மொழி ஒப்பான் *","கொவ்வைக் கனி வாய்க் * கிள்ளை பேசும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.5.mp3"],[1803,1803,["thI nIr vaNNa * mAmalar koNDu virai Endhi *","thU nIr paravith * thozhumin ezhumin thoNDIrgAL! **","mA nIr vaNNar * maruvi uRaiyum iDam * vAnil","kUn nIr madhiyai * mADam thINDum kuRungguDiyE"],["தீ நீர் வண்ண * மாமலர் கொண்டு விரை ஏந்தி *","தூ நீர் பரவித் * தொழுமின் எழுமின் தொண்டீர்காள்! **","மா நீர் வண்ணர் * மருவி உறையும் இடம் * வானில்","கூன் நீர் மதியை * மாடம் தீண்டும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.6.mp3"],[1804,1804,["vallich siRu nuN iDaiyAr iDai * nIr vaikkinRa *","allal sindhai thavira * aDaimin aDiyIrgAL! **","sollil thiruvE anaiyAr * kani vAy eyiRoppAn *","kollai mullai * mellarumbu Inum kuRungguDiyE"],["வல்லிச் சிறு நுண் இடையார் இடை * நீர் வைக்கின்ற *","அல்லல் சிந்தை தவிர * அடைமின் அடியீர்காள்! **","சொல்லில் திருவே அனையார் * கனி வாய் எயிறொப்பான் *","கொல்லை முல்லை * மெல்லரும்பு ஈனும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.7.mp3"],[1805,1805,["nArAr iNDai * nANmalar koNDu nanthamargAL! *","ArA anbODu * emperumAn Ur aDaimingaL **","thArA Arum * vAr punal mEyndhu vayal vAzhum *","kUr vAy nArai * pEDaiyoDu ADum kuRungguDiyE"],["நாரார் இண்டை * நாண்மலர் கொண்டு நந்தமர்காள்! *","ஆரா அன்போடு * எம்பெருமான் ஊர் அடைமின்கள் **","தாரா ஆரும் * வார் புனல் மேய்ந்து வயல் வாழும் *","கூர் வாய் நாரை * பேடையொடு ஆடும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.8.mp3"],[1806,1806,["ninRa vinaiyum thuyarum keDa * mAmalar Endhi *","senRu paNimin ezhumin * thozhumin thoNDIrgAL! **","enRum iravum pagalum * varivaNDu isai pADa *","kunRin mullai * manRiDai nARum kuRungguDiyE"],["நின்ற வினையும் துயரும் கெட * மாமலர் ஏந்தி *","சென்று பணிமின் எழுமின் * தொழுமின் தொண்டீர்காள்! **","என்றும் இரவும் பகலும் * வரிவண்டு இசை பாட *","குன்றின் முல்லை * மன்றிடை நாறும் குறுங்குடியே"],0,"/media/recitation/PT.9.6.9.mp3"],[1807,1807,["** silaiyAl ilanggai seRRAn * maRROr sina vEzham *","kolaiyAr kombu koNDAn * mEya kuRungguDi mEl **","kalaiyAr panuval vallAn * kaliyan oli mAlai *","nilaiyAr pADal pADap * pAvam nillAvE"],["** சிலையால் இலங்கை செற்றான் * மற்றோர் சின வேழம் *","கொலையார் கொம்பு கொண்டான் * மேய குறுங்குடி மேல் **","கலையார் பனுவல் வல்லான் * கலியன் ஒலி மாலை *","நிலையார் பாடல் பாடப் * பாவம் நில்லாவே"],0,"/media/recitation/PT.9.6.10.mp3"]],[[1808,1808,["** thandhai thAy makkaLE * suRRam enRu","uRRavar paRRi ninRa *","pandhamAr vAzhkkaiyai * nondhu nI","pazhi enak karudhinAyEl **","andhamAy AdhiyAy * Adhikkum","AdhiyAy Ayan Aya *","maindhanAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["** தந்தை தாய் மக்களே * சுற்றம் என்று","உற்றவர் பற்றி நின்ற *","பந்தமார் வாழ்க்கையை * நொந்து நீ","பழி எனக் கருதினாயேல் **","அந்தமாய் ஆதியாய் * ஆதிக்கும்","ஆதியாய் ஆயன் ஆய *","மைந்தனார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.1.mp3"],[1809,1809,["minnu mAvalliyum vanjchiyum","venRa * nuNNiDai nuDanggum *","anna men naDaiyinAr kalaviyai *","aruvaruththu anjchinAyEl **","thunnu mAmaNi muDip panjchavarkkAgi *","mun thUdhu senRa *","mannanAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["மின்னு மாவல்லியும் வஞ்சியும்","வென்ற * நுண்ணிடை நுடங்கும் *","அன்ன மென் நடையினார் கலவியை *","அருவருத்து அஞ்சினாயேல் **","துன்னு மாமணி முடிப் பஞ்சவர்க்காகி *","முன் தூது சென்ற *","மன்னனார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.2.mp3"],[1810,1810,["pUN ulA menmulaip pAvaimAr *","poyyinai mey idhenRu *","pENuvAr pEsum appEchchai * nI","pizhai enak karudhinAyEl **","nINilA veNkuDai vANanAr *","vELviyil maN irandha *","mANiyAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["பூண் உலா மென்முலைப் பாவைமார் *","பொய்யினை மெய் இதென்று *","பேணுவார் பேசும் அப்பேச்சை * நீ","பிழை எனக் கருதினாயேல் **","நீணிலா வெண்குடை வாணனார் *","வேள்வியில் மண் இரந்த *","மாணியார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.3.mp3"],[1811,1811,["paṇ ulām mĕṉ mŏzhip pāvaimār * paṇai mulai aṇaitum nām ĕṉṟu *","ĕṇṇuvār ĕṇṇam-atu ŏzhittu * nī pizhaittu uyak karutiṉāyel **","viṇ ul̤ār viṇṇiṉ mītu iyaṉṟa * veṅkaṭattu ul̤ār * val̤aṅkŏl̤ munnīr","vaṇṇaṉār vallavāzh * cŏllumā vallai āy maruvu nĕñce"],["பண் உலாம் மென் மொழிப் பாவைமார் * பணை முலை அணைதும் நாம் என்று *","எண்ணுவார் எண்ணம் அது ஒழித்து * நீ பிழைத்து உயக் கருதினாயேல் **","விண் உளார் விண்ணின் மீது இயன்ற * வேங்கடத்து உளார் * வளங்கொள் முந்நீர்","வண்ணனார் வல்லவாழ் * சொல்லுமா வல்லை ஆய் மருவு நெஞ்சே"],1,"/media/recitation/PT.9.7.4.mp3"],[1812,1812,["manjchu thOy veNkuDai mannarAy *","vAraNam sUzha vAzhndhAr *","thunjchinAr enbadhOr sollai * nI","thuyar enak karudhinAyEl **","nanjchu thOy konggai mEl angkai vAy","vaiththu * avaL nALai uNDa *","maindhanAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["மஞ்சு தோய் வெண்குடை மன்னராய் *","வாரணம் சூழ வாழ்ந்தார் *","துஞ்சினார் என்பதோர் சொல்லை * நீ","துயர் எனக் கருதினாயேல் **","நஞ்சு தோய் கொங்கை மேல் அங்கை வாய்","வைத்து * அவள் நாளை உண்ட *","மைந்தனார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.5.mp3"],[1813,1813,["uruvin Ar piRavi sEr * Un podhi","narambu thOl kurambaiyuL pukku *","aruvi nOy seydhu ninRu aivar thAm *","vAzhvadhaRku anjchinAyEl **","thiruvin Ar vEdham nAngu aindhu thI *","vELviyODu anggam ARum *","maruvinAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["உருவின் ஆர் பிறவி சேர் * ஊன் பொதி","நரம்பு தோல் குரம்பையுள் புக்கு *","அருவி நோய் செய்து நின்று ஐவர் தாம் *","வாழ்வதற்கு அஞ்சினாயேல் **","திருவின் ஆர் வேதம் நான்கு ஐந்து தீ *","வேள்வியோடு அங்கம் ஆறும் *","மருவினார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.6.mp3"],[1814,1814,["nOy elAm peydhadhOr Akkaiyai *","mey enak koNDu * vALA","pEyar thAm pEsum appEchchai * nI","pizhai enak karudhinAyEl **","thI ulA vengkadhirth thinggaLAy *","manggul vAnAgi ninRa *","mAyanAr vallavAzh * sollumA","vallaiyAy maruvu nenjchE!"],["நோய் எலாம் பெய்ததோர் ஆக்கையை *","மெய் எனக் கொண்டு * வாளா","பேயர் தாம் பேசும் அப்பேச்சை * நீ","பிழை எனக் கருதினாயேல் **","தீ உலா வெங்கதிர்த் திங்களாய் *","மங்குல் வானாகி நின்ற *","மாயனார் வல்லவாழ் * சொல்லுமா","வல்லையாய் மருவு நெஞ்சே!"],0,"/media/recitation/PT.9.7.7.mp3"],[1815,1815,["mañcu cer vāṉ ĕri * nīr nilam kāl ivai mayaṅki niṉṟa *","añcu cer ākkaiyai * araṇam aṉṟu ĕṉṟu uyak karutiṉāyel **","cantu cer mĕṉ mulaip * pŏṉ malarp pāvaiyum tāmum * nāl̤um","vantu cer vallavāzh * cŏllumā vallai āy maruvu nĕñce"],["மஞ்சு சேர் வான் எரி * நீர் நிலம் கால் இவை மயங்கி நின்ற *","அஞ்சு சேர் ஆக்கையை * அரணம் அன்று என்று உயக் கருதினாயேல் **","சந்து சேர் மென் முலைப் * பொன் மலர்ப் பாவையும் தாமும் * நாளும்","வந்து சேர் வல்லவாழ் * சொல்லுமா வல்லை ஆய் மருவு நெஞ்சே"],1,"/media/recitation/PT.9.7.8.mp3"],[1816,1816,["vĕl̤l̤iyār piṇṭiyār potiyār * ĕṉṟu ivar otukiṉṟa *","kal̤l̤anūl-taṉṉaiyum * karumam aṉṟu ĕṉṟu uyak karutiṉāyel **","tĕl̤l̤iyār kaitŏzhum tevaṉār * mā munīr amutu tanta *","val̤l̤alār vallavāzh * cŏllumā vallai āy maruvu nĕñce"],["வெள்ளியார் பிண்டியார் போதியார் * என்று இவர் ஓதுகின்ற *","கள்ளநூல் தன்னையும் * கருமம் அன்று என்று உயக் கருதினாயேல் **","தெள்ளியார் கைதொழும் தேவனார் * மா முநீர் அமுது தந்த *","வள்ளலார் வல்லவாழ் * சொல்லுமா வல்லை ஆய் மருவு நெஞ்சே"],1,"/media/recitation/PT.9.7.9.mp3"],[1817,1817,["** maRai valAr kuRaivilAr uRaiyum Ur *","vallavAzh aDigaL thammai *","siRai kulA vaNDaRai sOlai sUzh *","kOla nIL Ali nADan **","kaRai ulA vEl valla * kaliyan","vAy oli ivai kaRRu vallAr *","iRaivarAy irunilam kAval pUNDu *","inbam nangu eydhuvArE"],["** மறை வலார் குறைவிலார் உறையும் ஊர் *","வல்லவாழ் அடிகள் தம்மை *","சிறை குலா வண்டறை சோலை சூழ் *","கோல நீள் ஆலி நாடன் **","கறை உலா வேல் வல்ல * கலியன்","வாய் ஒலி இவை கற்று வல்லார் *","இறைவராய் இருநிலம் காவல் பூண்டு *","இன்பம் நன்கு எய்துவாரே"],0,"/media/recitation/PT.9.7.10.mp3"]],[[1818,1818,["** mundhuRa uraikkEn viraik kuzhal maDavAr *","kalaviyai viDu thaDumARal *","andharam Ezhum alaikaDal Ezhum","Aya * em aDigaL tham kOyil **","sandhoDu maNiyum aNi mayil thazhaiyum *","thazhuvi vandhu aruvigaL nirandhu *","vandhizhi sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["** முந்துற உரைக்கேன் விரைக் குழல் மடவார் *","கலவியை விடு தடுமாறல் *","அந்தரம் ஏழும் அலைகடல் ஏழும்","ஆய * எம் அடிகள் தம் கோயில் **","சந்தொடு மணியும் அணி மயில் தழையும் *","தழுவி வந்து அருவிகள் நிரந்து *","வந்திழி சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.1.mp3"],[1819,1819,["iNDaiyum punalum koNDu iDai inRi *","ezhuminO thozhudhum enRu * imaiyOr","aNDarum parava aravaNaith thuyinRa *","suDar muDik kaDavuL tham kOyil **","viNDalar thULi vEy vaLar puRavil *","virai malark kuRinjchiyin naRunthEn *","vaNDamar sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["இண்டையும் புனலும் கொண்டு இடை இன்றி *","எழுமினோ தொழுதும் என்று * இமையோர்","அண்டரும் பரவ அரவணைத் துயின்ற *","சுடர் முடிக் கடவுள் தம் கோயில் **","விண்டலர் தூளி வேய் வளர் புறவில் *","விரை மலர்க் குறிஞ்சியின் நறுந்தேன் *","வண்டமர் சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.2.mp3"],[1820,1820,["piNi vaLar Akkai nIngga ninREththap *","perunilam aruLil mun aruLi *","aNi vaLar kuRaLAy agal iDam muzhudhum *","aLandha em aDigaL tham kOyil **","kaNi vaLar vEnggai neDu nilam adhanil *","kuRavar tham kavaN iDaith thurandha *","maNi vaLar sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["பிணி வளர் ஆக்கை நீங்க நின்றேத்தப் *","பெருநிலம் அருளில் முன் அருளி *","அணி வளர் குறளாய் அகல் இடம் முழுதும் *","அளந்த எம் அடிகள் தம் கோயில் **","கணி வளர் வேங்கை நெடு நிலம் அதனில் *","குறவர் தம் கவண் இடைத் துரந்த *","மணி வளர் சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.3.mp3"],[1821,1821,["sUrmayil Aya pEy mulai suvaiththuch *","suDu saram aDu silaith thurandhu *","nIrmai ilAdha thADagai mALa *","ninaindhavar manam koNDa kOyil **","kAr mali vEnggai kOnggalar puRavil *","kaDimalark kuRinjchiyin naRunthEn *","vAr punal sUzh thaNmAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["சூர்மயில் ஆய பேய் முலை சுவைத்துச் *","சுடு சரம் அடு சிலைத் துரந்து *","நீர்மை இலாத தாடகை மாள *","நினைந்தவர் மனம் கொண்ட கோயில் **","கார் மலி வேங்கை கோங்கலர் புறவில் *","கடிமலர்க் குறிஞ்சியின் நறுந்தேன் *","வார் புனல் சூழ் தண்மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.4.mp3"],[1822,1822,["vaNanggalil arakkan seruk kaLaththu aviya *","maNimuDi orupadhum puraLa *","aNanggezhundhu avan than kavandham ninRADa *","amar seydha aDigaL tham kOyil **","piNanggalil neDuvEy nudhi mugam kizhippap *","pirasam vandhu izhitharap * perunthEn","maNangkamazh sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["வணங்கலில் அரக்கன் செருக் களத்து அவிய *","மணிமுடி ஒருபதும் புரள *","அணங்கெழுந்து அவன் தன் கவந்தம் நின்றாட *","அமர் செய்த அடிகள் தம் கோயில் **","பிணங்கலில் நெடுவேய் நுதி முகம் கிழிப்பப் *","பிரசம் வந்து இழிதரப் * பெருந்தேன்","மணங்கமழ் சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.5.mp3"],[1823,1823,["viDangkalandhu amarndha aravaNaith thuyinRu *","viLangkanikku iLangkanRu visiRi *","kuDangkalandhADik kuravai mun kOththa *","kUththa em aDigaL tham kOyil **","thaDangkaDal mugandhu visumbiDaip piLiRath *","thaDavaraik kaLiRenRu munindhu *","maDanggal ninRu adhirum mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["விடங்கலந்து அமர்ந்த அரவணைத் துயின்று *","விளங்கனிக்கு இளங்கன்று விசிறி *","குடங்கலந்தாடிக் குரவை முன் கோத்த *","கூத்த எம் அடிகள் தம் கோயில் **","தடங்கடல் முகந்து விசும்பிடைப் பிளிறத் *","தடவரைக் களிறென்று முனிந்து *","மடங்கல் நின்று அதிரும் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.6.mp3"],[1824,1824,["thEnugan Avi pOy uga anggOr *","sezhunthiraL panangkani udhira *","thAn ugandhu eRindha thaDangkaDal vaNNar *","eNNi mun iDangkoNDa kOyil **","vAnagach chOlai maradhagach chAyal *","mAmaNik kal adhar niRaindhu *","mAnugar sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["தேனுகன் ஆவி போய் உக அங்கோர் *","செழுந்திரள் பனங்கனி உதிர *","தான் உகந்து எறிந்த தடங்கடல் வண்ணர் *","எண்ணி முன் இடங்கொண்ட கோயில் **","வானகச் சோலை மரதகச் சாயல் *","மாமணிக் கல் அதர் நிறைந்து *","மானுகர் சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.7.mp3"],[1825,1825,["pudha migu visumbil puNari senRu aNavap *","porukaDal aravaNaith thuyinRu *","padha migu pariyin migu sinam thavirththa *","pani mugil vaNNar tham kOyil **","kadha migu sinaththa kaDa thaDak kaLiRRin *","kavuL vazhik kaLi vaNDu paruga *","madha migu sAral mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["புத மிகு விசும்பில் புணரி சென்று அணவப் *","பொருகடல் அரவணைத் துயின்று *","பத மிகு பரியின் மிகு சினம் தவிர்த்த *","பனி முகில் வண்ணர் தம் கோயில் **","கத மிகு சினத்த கட தடக் களிற்றின் *","கவுள் வழிக் களி வண்டு பருக *","மத மிகு சாரல் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.8.mp3"],[1826,1826,["pundhiyil samaNar buththar enRivargaL *","oththana pEsavum ugandhiTTu *","endhai pemmAnAr imaiyavar thalaivar *","eNNi mun iDangkoNDa kOyil **","sandhanap pozhilin thAzh sinai nIzhal *","thAzh varai magaLirgaL nALum *","mandhiraththu iRainjchum mAlirunjchOlai *","vaNanggudhum vA maDa nenjchE!"],["புந்தியில் சமணர் புத்தர் என்றிவர்கள் *","ஒத்தன பேசவும் உகந்திட்டு *","எந்தை பெம்மானார் இமையவர் தலைவர் *","எண்ணி முன் இடங்கொண்ட கோயில் **","சந்தனப் பொழிலின் தாழ் சினை நீழல் *","தாழ் வரை மகளிர்கள் நாளும் *","மந்திரத்து இறைஞ்சும் மாலிருஞ்சோலை *","வணங்குதும் வா மட நெஞ்சே!"],0,"/media/recitation/PT.9.8.9.mp3"],[1827,1827,["** vaNDamar sAral mAlirunjchOlai *","mAmaNi vaNNarai vaNanggum *","thoNDaraip paravum suDar oLi neDu vEl *","sUzh vayal Ali nannADan **","kaNDal nalvEli manggaiyar thalaivan *","kaliyan vAy oli seydha panuval *","koNDivai pADum thavam uDaiyArgaL *","ALvar ikkuraikaDal ulagE"],["** வண்டமர் சாரல் மாலிருஞ்சோலை *","மாமணி வண்ணரை வணங்கும் *","தொண்டரைப் பரவும் சுடர் ஒளி நெடு வேல் *","சூழ் வயல் ஆலி நன்னாடன் **","கண்டல் நல்வேலி மங்கையர் தலைவன் *","கலியன் வாய் ஒலி செய்த பனுவல் *","கொண்டிவை பாடும் தவம் உடையார்கள் *","ஆள்வர் இக்குரைகடல் உலகே"],0,"/media/recitation/PT.9.8.10.mp3"]],[[1828,1828,["** mUvaril mun mudhalvan * muzhanggAr kaDaluL kiDandhu *","pUvalar undhi thannuL * buvanam paDaiththu uNDumizhndha **","dhEvargaL nAyaganaith * thirumAlirunjchOlai ninRa *","kOvalar gOvindhanaik * koDi Er iDai kUDungkolO?"],["** மூவரில் முன் முதல்வன் * முழங்கார் கடலுள் கிடந்து *","பூவலர் உந்தி தன்னுள் * புவனம் படைத்து உண்டுமிழ்ந்த **","தேவர்கள் நாயகனைத் * திருமாலிருஞ்சோலை நின்ற *","கோவலர் கோவிந்தனைக் * கொடி ஏர் இடை கூடுங்கொலோ?"],0,"/media/recitation/PT.9.9.1.mp3"],[1829,1829,["** punai vaLar pUmpozhilAr * ponni sUzh arangga nagaruL","munaivanai * mUvulagum paDaiththa * mudhal mUrththi thannai **","sinai vaLar pUmpozhil sUzh * thirumAlirunjchOlai ninRAn *","kanai kazhal kANungkolO? * kayaRkaNNi em kArigaiyE"],["** புனை வளர் பூம்பொழிலார் * பொன்னி சூழ் அரங்க நகருள்","முனைவனை * மூவுலகும் படைத்த * முதல் மூர்த்தி தன்னை **","சினை வளர் பூம்பொழில் சூழ் * திருமாலிருஞ்சோலை நின்றான் *","கனை கழல் காணுங்கொலோ? * கயற்கண்ணி எம் காரிகையே"],0,"/media/recitation/PT.9.9.2.mp3"],[1830,1830,["uNDu ulagEzhinaiyum * oru pAlagan Alilai mEl *","kaN thuyil koNDu ugandha * karu mANikka mAmalaiyai **","thiNthiRal mA kari sEr * thirumAlirunjchOlai ninRa *","aNDar tham kOvinai inRu * aNugungkol? en AyizhaiyE"],["உண்டு உலகேழினையும் * ஒரு பாலகன் ஆலிலை மேல் *","கண் துயில் கொண்டு உகந்த * கரு மாணிக்க மாமலையை **","திண்திறல் மா கரி சேர் * திருமாலிருஞ்சோலை நின்ற *","அண்டர் தம் கோவினை இன்று * அணுகுங்கொல்? என் ஆயிழையே"],0,"/media/recitation/PT.9.9.3.mp3"],[1831,1831,["singgam adhAy avuNan * thiRal Agam mun kINDugandha *","panggaya mAmalark kaN * paranai em paranjchuDarai **","thinggaL nanmAmugil sEr * thirumAlirunjchOlai ninRa *","nanggaL pirAnai inRu * naNugungkol? en nannudhalE"],["சிங்கம் அதாய் அவுணன் * திறல் ஆகம் முன் கீண்டுகந்த *","பங்கய மாமலர்க் கண் * பரனை எம் பரஞ்சுடரை **","திங்கள் நன்மாமுகில் சேர் * திருமாலிருஞ்சோலை நின்ற *","நங்கள் பிரானை இன்று * நணுகுங்கொல்? என் நன்னுதலே"],0,"/media/recitation/PT.9.9.4.mp3"],[1832,1832,["dhAnavan vELvi thannil * thaniyE kuRaLAy nimirndhu *","vAnamum maNNagamum * aLandha thirivikkiraman **","thEn amar pUmpozhil sUzh * thirumAlirunjchOlai ninRa *","vAnavar kOnai inRu * vaNanggith thozha vallaL kolO?"],["தானவன் வேள்வி தன்னில் * தனியே குறளாய் நிமிர்ந்து *","வானமும் மண்ணகமும் * அளந்த திரிவிக்கிரமன் **","தேன் அமர் பூம்பொழில் சூழ் * திருமாலிருஞ்சோலை நின்ற *","வானவர் கோனை இன்று * வணங்கித் தொழ வல்லள் கொலோ?"],0,"/media/recitation/PT.9.9.5.mp3"],[1833,1833,["** nEsam ilAdhavarkkum * ninaiyAdhavarkkum ariyAn *","vAsa malarp pozhil sUzh * vaDa mAmadhuraip piRandhAn **","dhEsam ellAm vaNanggum * thirumAlirunjchOlai ninRa *","kEsava nambi thannaik * keNDai oNkaNNi kANungkolO?"],["** நேசம் இலாதவர்க்கும் * நினையாதவர்க்கும் அரியான் *","வாச மலர்ப் பொழில் சூழ் * வட மாமதுரைப் பிறந்தான் **","தேசம் எல்லாம் வணங்கும் * திருமாலிருஞ்சோலை நின்ற *","கேசவ நம்பி தன்னைக் * கெண்டை ஒண்கண்ணி காணுங்கொலோ?"],0,"/media/recitation/PT.9.9.6.mp3"],[1834,1834,["puLLinai vAy piLandhu * poru mA kari kombosiththu *","kaLLach sagaDu udhaiththa * karu mANikka mAmalaiyai **","theLLaruvi kozhikkum * thirumAlirunjchOlai ninRa *","vaLLalai vANudhalAL * vaNanggith thozha vallaL kolO?"],["புள்ளினை வாய் பிளந்து * பொரு மா கரி கொம்பொசித்து *","கள்ளச் சகடு உதைத்த * கரு மாணிக்க மாமலையை **","தெள்ளருவி கொழிக்கும் * திருமாலிருஞ்சோலை நின்ற *","வள்ளலை வாணுதலாள் * வணங்கித் தொழ வல்லள் கொலோ?"],0,"/media/recitation/PT.9.9.7.mp3"],[1835,1835,["pArththanukku anRu aruLip * bAradhaththu oru thEr mun ninRu *","kAththavan thannai * viNNOr karu mANikka mAmalaiyai **","thIrththanaip pUmpozhil sUzh * thirumAlirunjchOlai ninRa *","mUrththiyaik kai thozhavum * muDiyungkol? en moykuzhaRkE"],["பார்த்தனுக்கு அன்று அருளிப் * பாரதத்து ஒரு தேர் முன் நின்று *","காத்தவன் தன்னை * விண்ணோர் கரு மாணிக்க மாமலையை **","தீர்த்தனைப் பூம்பொழில் சூழ் * திருமாலிருஞ்சோலை நின்ற *","மூர்த்தியைக் கை தொழவும் * முடியுங்கொல்? என் மொய்குழற்கே"],0,"/media/recitation/PT.9.9.8.mp3"],[1836,1836,["** valampuri Azhiyanai * varaiyAr thiraL thOLan thannai *","pulampuri nUlavanaip * pozhil vEngkaDa vEdhiyanai **","silambiyal ARuDaiya * thirumAlirunjchOlai ninRa *","nalanthigazh nAraNanai * naNugungkol? en nannudhalE"],["** வலம்புரி ஆழியனை * வரையார் திரள் தோளன் தன்னை *","புலம்புரி நூலவனைப் * பொழில் வேங்கட வேதியனை **","சிலம்பியல் ஆறுடைய * திருமாலிருஞ்சோலை நின்ற *","நலந்திகழ் நாரணனை * நணுகுங்கொல்? என் நன்னுதலே"],0,"/media/recitation/PT.9.9.9.mp3"],[1837,1837,["** thEDaRku ariyavanaith * thirumAlirunjchOlai ninRa *","ADal paRavaiyanai * aNi Ayizhai kANum enRu **","mADak koDi madhiL sUzh * manggaiyAr kalikanRi sonna **","pADal panuval paththum * payilvArkku illai pAvanggaLE"],["** தேடற்கு அரியவனைத் * திருமாலிருஞ்சோலை நின்ற *","ஆடல் பறவையனை * அணி ஆயிழை காணும் என்று **","மாடக் கொடி மதிள் சூழ் * மங்கையார் கலிகன்றி சொன்ன **","பாடல் பனுவல் பத்தும் * பயில்வார்க்கு இல்லை பாவங்களே"],0,"/media/recitation/PT.9.9.10.mp3"]],[[1838,1838,["** enggaL em iRai em pirAn *","imaiyOrkku nAyagan * EththaDiyavar","thanggaL tham manaththup *","piriyAdhu aruL purivAn **","ponggu thaNNaruvi pudham seyyap *","pongaLE sidhaRum ilanggoLi *","senggamalam malarum *","thirukkOTTiyUrAnE"],["** எங்கள் எம் இறை எம் பிரான் *","இமையோர்க்கு நாயகன் * ஏத்தடியவர்","தங்கள் தம் மனத்துப் *","பிரியாது அருள் புரிவான் **","பொங்கு தண்ணருவி புதம் செய்யப் *","பொன்களே சிதறும் இலங்கொளி *","செங்கமலம் மலரும் *","திருக்கோட்டியூரானே"],0,"/media/recitation/PT.9.10.1.mp3"],[1839,1839,["ĕvva noy tavirppāṉ * ĕmakku iṟai iṉ nakait tuvar vāy * nila-makal̤","cĕvvi toya vallāṉ * tiru mā makaṭku iṉiyāṉ- **","mauval mālai vaṇṭu āṭum * mallikai mālaiyoṭum aṇaintu * mārutam","tĕyvam nāṟa varum- * tirukkoṭṭiyūrāṉe-"],["எவ்வ நோய் தவிர்ப்பான் * எமக்கு இறை இன் நகைத் துவர் வாய் * நில மகள்","செவ்வி தோய வல்லான் * திரு மா மகட்கு இனியான் **","மௌவல் மாலை வண்டு ஆடும் * மல்லிகை மாலையோடும் அணைந்து * மாருதம்","தெய்வம் நாற வரும் * திருக்கோட்டியூரானே"],1,"/media/recitation/PT.9.10.2.mp3"],[1840,1840,["veLLiyAn kariyAn * maNi niRa vaNNan","viNNavar thamakku iRai * emakku","oLLiyAn uyarndhAn *","ulagEzhum uNDu umizhndhAn **","thuLLu nIr moNDu koNDu sAmaraik","kaRRai * sandhanam undhi vandhasai *","theLLu nIrp puRavil *","thirukkOTTiyUrAnE"],["வெள்ளியான் கரியான் * மணி நிற வண்ணன்","விண்ணவர் தமக்கு இறை * எமக்கு","ஒள்ளியான் உயர்ந்தான் *","உலகேழும் உண்டு உமிழ்ந்தான் **","துள்ளு நீர் மொண்டு கொண்டு சாமரைக்","கற்றை * சந்தனம் உந்தி வந்தசை *","தெள்ளு நீர்ப் புறவில் *","திருக்கோட்டியூரானே"],0,"/media/recitation/PT.9.10.3.mp3"],[1841,1841,["eṟum eṟi ilaṅkum ŏṇ mazhup paṟṟum * īcaṟku icaintu * uṭampil or","kūṟu-tāṉ kŏṭuttāṉ * kula mā makaṭku iṉiyāṉ- **","nāṟu cĕṇpakam mallikai malar pulki * iṉ il̤a vaṇṭu * nal naṟum","teṟal vāymaṭukkum- * tirukkoṭṭiyūrāṉe-"],["ஏறும் ஏறி இலங்கும் ஒண் மழுப் பற்றும் * ஈசற்கு இசைந்து * உடம்பில் ஓர்","கூறு தான் கொடுத்தான் * குல மா மகட்கு இனியான் **","நாறு செண்பகம் மல்லிகை மலர் புல்கி * இன் இள வண்டு * நல் நறும்","தேறல் வாய்மடுக்கும் * திருக்கோட்டியூரானே"],1,"/media/recitation/PT.9.10.4.mp3"],[1842,1842,["vangga mAkaDal vaNNan * mAmaNi vaNNan","viNNavar kOn * madhu malarth","thonggal nILmuDiyAn * neDiyAn paDi","kaDandhAn **","manggul thOy maNi mADa veNkoDi *","mAga mIdhu uyarndhu ERi * vAn uyar","thinggaL thAn aNavum *","thirukkOTTiyUrAnE"],["வங்க மாகடல் வண்ணன் * மாமணி வண்ணன்","விண்ணவர் கோன் * மது மலர்த்","தொங்கல் நீள்முடியான் * நெடியான் படி","கடந்தான் **","மங்குல் தோய் மணி மாட வெண்கொடி *","மாக மீது உயர்ந்து ஏறி * வான் உயர்","திங்கள் தான் அணவும் *","திருக்கோட்டியூரானே"],0,"/media/recitation/PT.9.10.5.mp3"],[1843,1843,["kAvalan ilanggaikkiRai kalanggach *","saram sela uyththu * maRRu avan","Evalam thavirththAn * ennai ALuDai","empirAn **","nAvalam puvi mannar vandhu vaNangga *","mAl uRaiginRadhu inggena *","dhEvar vandhu iRainjchum *","thirukkOTTiyUrAnE"],["காவலன் இலங்கைக்கிறை கலங்கச் *","சரம் செல உய்த்து * மற்று அவன்","ஏவலம் தவிர்த்தான் * என்னை ஆளுடை","எம்பிரான் **","நாவலம் புவி மன்னர் வந்து வணங்க *","மால் உறைகின்றது இங்கென *","தேவர் வந்து இறைஞ்சும் *","திருக்கோட்டியூரானே"],0,"/media/recitation/PT.9.10.6.mp3"],[1844,1844,["kanRu koNDu viLangkani eRindhu *","Aniraikku azhivu enRu * mAmazhai","ninRu kAththugandhAn * nilamAmagaTku","iniyAn **","kunRin mullaiyin vAsamum * kuLir malligai","maNamum aLaindhu * iLan","thenRal vandhulavum *","thirukkOTTiyUrAnE"],["கன்று கொண்டு விளங்கனி எறிந்து *","ஆநிரைக்கு அழிவு என்று * மாமழை","நின்று காத்துகந்தான் * நிலமாமகட்கு","இனியான் **","குன்றின் முல்லையின் வாசமும் * குளிர் மல்லிகை","மணமும் அளைந்து * இளந்","தென்றல் வந்துலவும் *","திருக்கோட்டியூரானே"],0,"/media/recitation/PT.9.10.7.mp3"],[1845,1845,["pUngkurundhu osiththu Anai kAyndhu * arimAch","seguththu * aDiyEnai AL ugandhu","Inggu ennuL pugundhAn * imaiyOrgaL tham","perumAn **","thUnggu thaNpalavin kani * thogu vAzhaiyin","kaniyoDu mAngkani *","thEnggu thaNpunal sUzh *","thirukkOTTiyUrAnE"],["பூங்குருந்து ஒசித்து ஆனை காய்ந்து * அரிமாச்","செகுத்து * அடியேனை ஆள் உகந்து","ஈங்கு என்னுள் புகுந்தான் * இமையோர்கள் தம்","பெருமான் **","தூங்கு தண்பலவின் கனி * தொகு வாழையின்","கனியொடு மாங்கனி *","தேங்கு தண்புனல