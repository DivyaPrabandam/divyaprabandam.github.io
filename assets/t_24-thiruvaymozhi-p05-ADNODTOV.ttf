[[[3233,3233,["** kaiyAr chakkaraththu * en karu mANikkamE! enRenRu *","poyyE kaimmai sollip * puRamE puRamE ADi **","meyyE peRRu ozhindhEn * vidhi vAykkinRu kAppAr Ar? *","aiyO! kaNNa pirAn! * aRaiyO! inip pOnAlE"],["** கையார் சக்கரத்து * என் கரு மாணிக்கமே! என்றென்று *","பொய்யே கைம்மை சொல்லிப் * புறமே புறமே ஆடி **","மெய்யே பெற்று ஒழிந்தேன் * விதி வாய்க்கின்று காப்பார் ஆர்? *","ஐயோ! கண்ண பிரான்! * அறையோ! இனிப் போனாலே"],0,"/media/recitation/TVM.5.1.1.mp3"],[3234,3234,["pOnAy! mA marudhin naDuvE * en pollA maNiyE! *","thEnE! innamudhE! * enRenRE sila kUththuch solla **","thAnEl emperumAn * avan en Agi ozhindhAn *","vAnE mA nilamE * maRRu muRRum en uLLanavE"],["போனாய்! மா மருதின் நடுவே * என் பொல்லா மணியே! *","தேனே! இன்னமுதே! * என்றென்றே சில கூத்துச் சொல்ல **","தானேல் எம்பெருமான் * அவன் என் ஆகி ஒழிந்தான் *","வானே மா நிலமே * மற்று முற்றும் என் உள்ளனவே"],0,"/media/recitation/TVM.5.1.2.mp3"],[3235,3235,["uLLana maRRuLavAp * puRamE sila mAyam solli *","vaLLal! maNi vaNNanE! * enRenRE unnaiyum vanjchikkum **","kaLLa manam thavirndhE * unnaik kaNDu koNDu uyndhu ozhindhEn *","veLLaththaNaik kiDandhAy * ini unnai viTTu en koLvanE?"],["உள்ளன மற்றுளவாப் * புறமே சில மாயம் சொல்லி *","வள்ளல்! மணி வண்ணனே! * என்றென்றே உன்னையும் வஞ்சிக்கும் **","கள்ள மனம் தவிர்ந்தே * உன்னைக் கண்டு கொண்டு உய்ந்து ஒழிந்தேன் *","வெள்ளத்தணைக் கிடந்தாய் * இனி உன்னை விட்டு என் கொள்வனே?"],0,"/media/recitation/TVM.5.1.3.mp3"],[3236,3236,["en koLvan? unnai viTTu ennum * vAsaganggaL solliyum *","vankaLvanEn manaththai valiththuk * kaNNa nIr karandhu **","ninkaN nerungga vaiththE * enadhAviyai nIkka killEn *","enkaN malinam aRuththu * ennaik kUvi aruLAy kaNNanE!"],["என் கொள்வன்? உன்னை விட்டு என்னும் * வாசகங்கள் சொல்லியும் *","வன்கள்வனேன் மனத்தை வலித்துக் * கண்ண நீர் கரந்து **","நின்கண் நெருங்க வைத்தே * எனதாவியை நீக்க கில்லேன் *","என்கண் மலினம் அறுத்து * என்னைக் கூவி அருளாய் கண்ணனே!"],0,"/media/recitation/TVM.5.1.4.mp3"],[3237,3237,["kaNNa pirAnai * viNNOr karu mANikkaththai amudhai *","naNNiyum naNNa killEn * naDuvE Or uDambil iTTu **","thiNNam azhundhak kaTTip * pala sey vinai vankayiRRAl *","puNNai maRaiya varindhu * ennaip pOra vaiththAy puRamE"],["கண்ண பிரானை * விண்ணோர் கரு மாணிக்கத்தை அமுதை *","நண்ணியும் நண்ண கில்லேன் * நடுவே ஓர் உடம்பில் இட்டு **","திண்ணம் அழுந்தக் கட்டிப் * பல செய் வினை வன்கயிற்றால் *","புண்ணை மறைய வரிந்து * என்னைப் போர வைத்தாய் புறமே"],0,"/media/recitation/TVM.5.1.5.mp3"],[3238,3238,["puRam aRak kaTTik koNDu * iru valvinaiyAr kumaikkum *","muRai muRai Akkai pugal ozhiyak * kaNDu koNDu ozhindhEn **","niRam uDai nAl thaDanthOL * seyya vAy seyya thAmaraik kaN *","aRa muyal Azhi angkaik * karu mEni ammAn thannaiyE"],["புறம் அறக் கட்டிக் கொண்டு * இரு வல்வினையார் குமைக்கும் *","முறை முறை ஆக்கை புகல் ஒழியக் * கண்டு கொண்டு ஒழிந்தேன் **","நிறம் உடை நால் தடந்தோள் * செய்ய வாய் செய்ய தாமரைக் கண் *","அற முயல் ஆழி அங்கைக் * கரு மேனி அம்மான் தன்னையே"],0,"/media/recitation/TVM.5.1.6.mp3"],[3239,3239,["ammAn Azhip pirAn * avan evviDaththAn? yAn Ar? *","emmA pAviyarkkum * vidhi vAykkinRu vAykkum kaNDIr **","kaimmA thunbozhiththAy! enRu * kai thalai pUsal iTTE *","mey mAlAy ozhindhEn * empirAnum en mElAnE"],["அம்மான் ஆழிப் பிரான் * அவன் எவ்விடத்தான்? யான் ஆர்? *","எம்மா பாவியர்க்கும் * விதி வாய்க்கின்று வாய்க்கும் கண்டீர் **","கைம்மா துன்பொழித்தாய்! என்று * கை தலை பூசல் இட்டே *","மெய் மாலாய் ஒழிந்தேன் * எம்பிரானும் என் மேலானே"],0,"/media/recitation/TVM.5.1.7.mp3"],[3240,3240,["mElAth thEvargaLum * nilath thEvarum mEvith thozhum *","mAlAr vandhu ina nAL * aDiyEn manaththE manninAr **","sElEy kaNNiyarum * perunjchelvamum nanmakkaLum *","mElAth thAy thandhaiyum * avarE ini AvArE"],["மேலாத் தேவர்களும் * நிலத் தேவரும் மேவித் தொழும் *","மாலார் வந்து இன நாள் * அடியேன் மனத்தே மன்னினார் **","சேலேய் கண்ணியரும் * பெருஞ்செல்வமும் நன்மக்களும் *","மேலாத் தாய் தந்தையும் * அவரே இனி ஆவாரே"],0,"/media/recitation/TVM.5.1.8.mp3"],[3241,3241,["AvAr Ar? thuNai enRu * alai nIrk kaDaluL azhundhum","nAvAy pOl * piRavik kaDaluL * ninRu nAn thuLangga **","thEvAr kOlaththoDum * thiruchchakkaram sangginoDum *","AvA! enRu aruL seydhu * aDiyEnoDum AnAnE"],["ஆவார் ஆர்? துணை என்று * அலை நீர்க் கடலுள் அழுந்தும்","நாவாய் போல் * பிறவிக் கடலுள் * நின்று நான் துளங்க **","தேவார் கோலத்தொடும் * திருச்சக்கரம் சங்கினொடும் *","ஆவா! என்று அருள் செய்து * அடியேனொடும் ஆனானே"],0,"/media/recitation/TVM.5.1.9.mp3"],[3242,3242,["AnAn AL uDaiyAn enRu * aqdhE koNDu ugandhu vandhu *","thAnE innaruL seydhu * ennai muRRavum thAn AnAn **","mInAy AmaiyumAy * narasinggamumAyk kuRaLAy *","kAnAr EnamumAyk * kaRkiyAm innam kAr vaNNanE"],["ஆனான் ஆள் உடையான் என்று * அஃதே கொண்டு உகந்து வந்து *","தானே இன்னருள் செய்து * என்னை முற்றவும் தான் ஆனான் **","மீனாய் ஆமையுமாய் * நரசிங்கமுமாய்க் குறளாய் *","கானார் ஏனமுமாய்க் * கற்கியாம் இன்னம் கார் வண்ணனே"],0,"/media/recitation/TVM.5.1.10.mp3"],[3243,3243,["** kAr vaNNan kaNNa pirAn * kamalath thaDangkaNNan thannai *","Er vaLa oNkazhanik * kurugUrch saDakOpan sonna **","sIr vaNNa oNthamizhgaL * ivai AyiraththuL ippaththum *","Ar vaNNaththAl uraippAr * aDik kIzh puguvAr polindhE"],["** கார் வண்ணன் கண்ண பிரான் * கமலத் தடங்கண்ணன் தன்னை *","ஏர் வள ஒண்கழனிக் * குருகூர்ச் சடகோபன் சொன்ன **","சீர் வண்ண ஒண்தமிழ்கள் * இவை ஆயிரத்துள் இப்பத்தும் *","ஆர் வண்ணத்தால் உரைப்பார் * அடிக் கீழ் புகுவார் பொலிந்தே"],0,"/media/recitation/TVM.5.1.11.mp3"]],[[3244,3244,["** poliga poliga poliga *","pOyiRRu valluyirch sAbam *","naliyum naragamum naindha *","namanukku inggu yAdhonRum illai **","kaliyum keDum kaNDu koNmin *","kaDal vaNNan pUdhanggaL maN mEl *","maliyap pugundhu isai pADi *","ADi uzhi tharak kaNDOm"],["** பொலிக பொலிக பொலிக *","போயிற்று வல்லுயிர்ச் சாபம் *","நலியும் நரகமும் நைந்த *","நமனுக்கு இங்கு யாதொன்றும் இல்லை **","கலியும் கெடும் கண்டு கொண்மின் *","கடல் வண்ணன் பூதங்கள் மண் மேல் *","மலியப் புகுந்து இசை பாடி *","ஆடி உழி தரக் கண்டோம்"],0,"/media/recitation/TVM.5.2.1.mp3"],[3245,3245,["kaNDOm kaNDOm kaNDOm *","kaNNukku iniyana kaNDOm *","thoNDIr! ellIrum vArIr *","thozhudhu thozhudhu ninRArththum **","vaNDAr thaNNanthuzhAyAn *","mAdhavan pUdhanggaL maN mEl *","paN thAn pADi ninRu ADip *","parandhu thiriginRanavE"],["கண்டோம் கண்டோம் கண்டோம் *","கண்ணுக்கு இனியன கண்டோம் *","தொண்டீர்! எல்லீரும் வாரீர் *","தொழுது தொழுது நின்றார்த்தும் **","வண்டார் தண்ணந்துழாயான் *","மாதவன் பூதங்கள் மண் மேல் *","பண் தான் பாடி நின்று ஆடிப் *","பரந்து திரிகின்றனவே"],0,"/media/recitation/TVM.5.2.2.mp3"],[3246,3246,["thiriyum kali yugam nInggith *","dhEvargaL thAmum pugundhu *","periya kidha yugam paRRip *","pEr inba veLLam peruga **","kariya mugil vaNNan emmAn *","kaDal vaNNan pUdhanggaL maN mEl *","iriyap pugundhu isai pADi *","enggum iDam koNDanavE"],["திரியும் கலி யுகம் நீங்கித் *","தேவர்கள் தாமும் புகுந்து *","பெரிய கித யுகம் பற்றிப் *","பேர் இன்ப வெள்ளம் பெருக **","கரிய முகில் வண்ணன் எம்மான் *","கடல் வண்ணன் பூதங்கள் மண் மேல் *","இரியப் புகுந்து இசை பாடி *","எங்கும் இடம் கொண்டனவே"],0,"/media/recitation/TVM.5.2.3.mp3"],[3247,3247,["iDangkoL samayaththai ellAm *","eDuththuk kaLaivana pOlE *","thaDangkaDal paLLip perumAn *","thannuDaip pUdhanggaLE Ay *","kiDandhum irundhum ezhundhum *","kItham pala pala pADi *","naDandhum paRandhum kuniththum *","nADagam seyginRanavE"],["இடங்கொள் சமயத்தை எல்லாம் *","எடுத்துக் களைவன போலே *","தடங்கடல் பள்ளிப் பெருமான் *","தன்னுடைப் பூதங்களே ஆய் *","கிடந்தும் இருந்தும் எழுந்தும் *","கீதம் பல பல பாடி *","நடந்தும் பறந்தும் குனித்தும் *","நாடகம் செய்கின்றனவே"],0,"/media/recitation/TVM.5.2.4.mp3"],[3248,3248,["seyginRadhu en kaNNukku onRE *","okkinRadhu ivvulagaththu *","vaikundhan pUdhanggaLE Ay *","mAyaththinAl enggum manni **","aiyam onRillai * arakkar","asurar piRandhIr uLLIrEl *","uyyum vagai illai thoNDIr! *","Uzhi peyarththiDum konRE"],["செய்கின்றது என் கண்ணுக்கு ஒன்றே *","ஒக்கின்றது இவ்வுலகத்து *","வைகுந்தன் பூதங்களே ஆய் *","மாயத்தினால் எங்கும் மன்னி **","ஐயம் ஒன்றில்லை * அரக்கர்","அசுரர் பிறந்தீர் உள்ளீரேல் *","உய்யும் வகை இல்லை தொண்டீர்! *","ஊழி பெயர்த்திடும் கொன்றே"],0,"/media/recitation/TVM.5.2.5.mp3"],[3249,3249,["konRu uyir uNNum visAdhi *","pagai pasi thIyana ellAm *","ninRu ivvulagil kaDivAn *","nEmip pirAn thamar pOndhAr **","nanRu isai pADiyum thuLLi","ADiyum * njAlam parandhAr *","senRu thozhudhu uymmin thoNDIr! *","sindhaiyaich senniRuththiyE"],["கொன்று உயிர் உண்ணும் விசாதி *","பகை பசி தீயன எல்லாம் *","நின்று இவ்வுலகில் கடிவான் *","நேமிப் பிரான் தமர் போந்தார் **","நன்று இசை பாடியும் துள்ளி","ஆடியும் * ஞாலம் பரந்தார் *","சென்று தொழுது உய்ம்மின் தொண்டீர்! *","சிந்தையைச் செந்நிறுத்தியே"],0,"/media/recitation/TVM.5.2.6.mp3"],[3250,3250,["niRuththi num uLLaththuk koLLum *","dheyvanggaL ummai uyyak kOL *","maRuththum avanODE kaNDIr *","mArkkaNDEyanum kariyE **","kaRuththa manam onRum vENDA *","kaNNan allAl dheyvam illai *","iRuppadhu ellAm avan mUrththiyAy *","avarkkE iRuminE"],["நிறுத்தி நும் உள்ளத்துக் கொள்ளும் *","தெய்வங்கள் உம்மை உய்யக் கோள் *","மறுத்தும் அவனோடே கண்டீர் *","மார்க்கண்டேயனும் கரியே **","கறுத்த மனம் ஒன்றும் வேண்டா *","கண்ணன் அல்லால் தெய்வம் இல்லை *","இறுப்பது எல்லாம் அவன் மூர்த்தியாய் *","அவர்க்கே இறுமினே"],0,"/media/recitation/TVM.5.2.7.mp3"],[3251,3251,["iRukkum iRai iRuththu uNNa *","evvulagukkum than mUrththi *","niRuththinAn theyvanggaL Aga *","aththeyva nAyagan thAnE **","maRuth thiru mArvan avan than *","pUdhanggaL kIdhanggaL pADi *","veRuppinRi njAlaththu mikkAr *","mEvith thozhudhu uymmin nIrE"],["இறுக்கும் இறை இறுத்து உண்ண *","எவ்வுலகுக்கும் தன் மூர்த்தி *","நிறுத்தினான் தெய்வங்கள் ஆக *","அத்தெய்வ நாயகன் தானே **","மறுத் திரு மார்வன் அவன் தன் *","பூதங்கள் கீதங்கள் பாடி *","வெறுப்பின்றி ஞாலத்து மிக்கார் *","மேவித் தொழுது உய்ம்மின் நீரே"],0,"/media/recitation/TVM.5.2.8.mp3"],[3252,3252,["mEvith thozhudhu uymmin nIrgaL *","vEdhap punidha irukkai *","nAvil koNDu achchudhan thannai *","njAna vidhi pizhaiyAmE **","pUvil pugaiyum viLakkum *","sAndhamum nIrum malindhu *","mEvith thozhum aDiyArum *","pagavarum mikkadhu ulagE"],["மேவித் தொழுது உய்ம்மின் நீர்கள் *","வேதப் புனித இருக்கை *","நாவில் கொண்டு அச்சுதன் தன்னை *","ஞான விதி பிழையாமே **","பூவில் புகையும் விளக்கும் *","சாந்தமும் நீரும் மலிந்து *","மேவித் தொழும் அடியாரும் *","பகவரும் மிக்கது உலகே"],0,"/media/recitation/TVM.5.2.9.mp3"],[3253,3253,["mikka ulagugaL thORum *","mEvik kaNNan thiru mUrththi *","nakka pirAnODu * ayanum","indhiranum mudhalAga **","thokka amarar kuzhAnggaL *","enggum parandhana thoNDIr! *","okkath thozha kiRRir Agil *","kali yugam onRum illaiyE"],["மிக்க உலகுகள் தோறும் *","மேவிக் கண்ணன் திரு மூர்த்தி *","நக்க பிரானோடு * அயனும்","இந்திரனும் முதலாக **","தொக்க அமரர் குழாங்கள் *","எங்கும் பரந்தன தொண்டீர்! *","ஒக்கத் தொழ கிற்றிர் ஆகில் *","கலி யுகம் ஒன்றும் இல்லையே"],0,"/media/recitation/TVM.5.2.10.mp3"],[3254,3254,["** kali yugam onRum inRikkE *","than aDiyArkku aruL seyyum *","maliyum suDar oLi mUrththi *","mAyap pirAn kaNNan thannai **","kali vayal thennan kurugUrk *","kAri mARan saDakOpan *","oli pugazh Ayiraththu ippaththu *","uLLaththai mAsu aRukkumE"],["** கலி யுகம் ஒன்றும் இன்றிக்கே *","தன் அடியார்க்கு அருள் செய்யும் *","மலியும் சுடர் ஒளி மூர்த்தி *","மாயப் பிரான் கண்ணன் தன்னை **","கலி வயல் தென்னன் குருகூர்க் *","காரி மாறன் சடகோபன் *","ஒலி புகழ் ஆயிரத்து இப்பத்து *","உள்ளத்தை மாசு அறுக்குமே"],0,"/media/recitation/TVM.5.2.11.mp3"]],[[3255,3255,["** mAsaRu sOdhi * en seyya vAy maNik kunRaththai *","AsaRu sIlanai * Adhi mUrththiyai nADiyE **","pAsaRavu eydhi * aRivu izhandhu enai nALaiyam? *","EsaRum Uravar kavvai * thOzhI! en seyyumE?"],["** மாசறு சோதி * என் செய்ய வாய் மணிக் குன்றத்தை *","ஆசறு சீலனை * ஆதி மூர்த்தியை நாடியே **","பாசறவு எய்தி * அறிவு இழந்து எனை நாளையம்? *","ஏசறும் ஊரவர் கவ்வை * தோழீ! என் செய்யுமே?"],0,"/media/recitation/TVM.5.3.1.mp3"],[3256,3256,["en seyyum Uravar kavvai? * thOzhI! ini nammai *","en seyya thAmaraik kaNNan * ennai niRai koNDAn **","mun seyya mAmai izhandhu * mEni melivu eydhi *","en seyya vAyum karungkaNNum * payappu UrndhavE"],["என் செய்யும் ஊரவர் கவ்வை? * தோழீ! இனி நம்மை *","என் செய்ய தாமரைக் கண்ணன் * என்னை நிறை கொண்டான் **","முன் செய்ய மாமை இழந்து * மேனி மெலிவு எய்தி *","என் செய்ய வாயும் கருங்கண்ணும் * பயப்பு ஊர்ந்தவே"],0,"/media/recitation/TVM.5.3.2.mp3"],[3257,3257,["Urndha sagaDam udhaiththa pAdhaththan * pEy mulai","sArndhu * suvaiththa sevvAyan * ennai niRai koNDAn **","pErndhum peyarndhum * avanODu anRi Or sollilEn *","thIrndha en thOzhI! * en seyyum Uravar kavvaiyE?"],["ஊர்ந்த சகடம் உதைத்த பாதத்தன் * பேய் முலை","சார்ந்து * சுவைத்த செவ்வாயன் * என்னை நிறை கொண்டான் **","பேர்ந்தும் பெயர்ந்தும் * அவனோடு அன்றி ஓர் சொல்லிலேன் *","தீர்ந்த என் தோழீ! * என் செய்யும் ஊரவர் கவ்வையே?"],0,"/media/recitation/TVM.5.3.3.mp3"],[3258,3258,["Uravar kavvai eru iTTu * annai sol nIr paDuththu *","Ira nel viththi muLaiththa * nenjchap perunjcheyuL **","pEr amar kAdhal * kaDal puraiya viLaiviththa *","kAr amar mEni * nam kaNNan thOzhI! kaDiyanE?"],["ஊரவர் கவ்வை எரு இட்டு * அன்னை சொல் நீர் படுத்து *","ஈர நெல் வித்தி முளைத்த * நெஞ்சப் பெருஞ்செயுள் **","பேர் அமர் காதல் * கடல் புரைய விளைவித்த *","கார் அமர் மேனி * நம் கண்ணன் தோழீ! கடியனே?"],0,"/media/recitation/TVM.5.3.4.mp3"],[3259,3259,["kaDiyan koDiyan neDiya mAl * ulagam koNDa","aDiyan * aRivaru mEni mAyaththan ** Agilum","koDiya en nenjcham * avan enRE kiDakkum ellE! *","thuDi koL iDai maDath thOzhI! * annai en seyyumE?"],["கடியன் கொடியன் நெடிய மால் * உலகம் கொண்ட","அடியன் * அறிவரு மேனி மாயத்தன் ** ஆகிலும்","கொடிய என் நெஞ்சம் * அவன் என்றே கிடக்கும் எல்லே! *","துடி கொள் இடை மடத் தோழீ! * அன்னை என் செய்யுமே?"],0,"/media/recitation/TVM.5.3.5.mp3"],[3260,3260,["annai en seyyil en? * Ur en sollil en? thOzhimIr! *","ennai ini umakku Asai illai * agappaTTEn **","munnai amarar mudhalvan * vaNthuvarApathi","mannan * maNi vaNNan * vAsudhEvan valaiyuLE"],["அன்னை என் செய்யில் என்? * ஊர் என் சொல்லில் என்? தோழிமீர்! *","என்னை இனி உமக்கு ஆசை இல்லை * அகப்பட்டேன் **","முன்னை அமரர் முதல்வன் * வண்துவராபதி","மன்னன் * மணி வண்ணன் * வாசுதேவன் வலையுளே"],0,"/media/recitation/TVM.5.3.6.mp3"],[3261,3261,["valaiyuL agappaDuththu * ennai nal nenjcham kUvik koNDu *","alai kaDal paLLi ammAnai * Azhip pirAn thannai **","kalai koL agal algul thOzhI! * nam kaNgaLAl kaNDu *","thalaiyil vaNanggavum AngkolO? * thaiyalAr munbE"],["வலையுள் அகப்படுத்து * என்னை நல் நெஞ்சம் கூவிக் கொண்டு *","அலை கடல் பள்ளி அம்மானை * ஆழிப் பிரான் தன்னை **","கலை கொள் அகல் அல்குல் தோழீ! * நம் கண்களால் கண்டு *","தலையில் வணங்கவும் ஆங்கொலோ? * தையலார் முன்பே"],0,"/media/recitation/TVM.5.3.7.mp3"],[3262,3262,["pEy mulai uNDu sagaDam pAyndhu * marudhiDaip","pOy mudhal sAyththu * puL vAy piLandhu kaLiRaTTa **","thU muRuval thoNDai vAyp pirAnai * ennAL kolO? *","yAm uRuginRadhu thOzhI! * annaiyar nANavE"],["பேய் முலை உண்டு சகடம் பாய்ந்து * மருதிடைப்","போய் முதல் சாய்த்து * புள் வாய் பிளந்து களிறட்ட **","தூ முறுவல் தொண்டை வாய்ப் பிரானை * எந்நாள் கொலோ? *","யாம் உறுகின்றது தோழீ! * அன்னையர் நாணவே"],0,"/media/recitation/TVM.5.3.8.mp3"],[3263,3263,["nANum niRaiyum kavarndhu * ennai nal nenjcham kUvik koNDu *","sEN uyar vAnaththu irukkum * dhEva pirAn thannai **","ANai en? thOzhI! * ulagu thORu alar thURRi * Am","kONaigaL seydhu * kudhiriyAy maDal UrdhumE"],["நாணும் நிறையும் கவர்ந்து * என்னை நல் நெஞ்சம் கூவிக் கொண்டு *","சேண் உயர் வானத்து இருக்கும் * தேவ பிரான் தன்னை **","ஆணை என்? தோழீ! * உலகு தோறு அலர் தூற்றி * ஆம்","கோணைகள் செய்து * குதிரியாய் மடல் ஊர்துமே"],0,"/media/recitation/TVM.5.3.9.mp3"],[3264,3264,["yAm maDal Urndhum * em Azhi angkaip pirAnuDai *","thU maDal thaNNanthuzhAy * malar koNDu sUDuvOm **","yAm maDam inRith * theruvu thORu ayal thaiyalAr *","nA maDanggap pazhi thURRi * nADum iraikkavE"],["யாம் மடல் ஊர்ந்தும் * எம் ஆழி அங்கைப் பிரானுடை *","தூ மடல் தண்ணந்துழாய் * மலர் கொண்டு சூடுவோம் **","யாம் மடம் இன்றித் * தெருவு தோறு அயல் தையலார் *","நா மடங்கப் பழி தூற்றி * நாடும் இரைக்கவே"],0,"/media/recitation/TVM.5.3.10.mp3"],[3265,3265,["** iraikkum karungkaDal vaNNan * kaNNa pirAn thannai *","viraik koL pozhil * kurugUrch saDakOpan sonna **","niraik koL andhAdhi * Or AyiraththuL ippaththum *","uraikka vallArkku * vaikundham Agum tham Ur ellAm"],["** இரைக்கும் கருங்கடல் வண்ணன் * கண்ண பிரான் தன்னை *","விரைக் கொள் பொழில் * குருகூர்ச் சடகோபன் சொன்ன **","நிரைக் கொள் அந்தாதி * ஓர் ஆயிரத்துள் இப்பத்தும் *","உரைக்க வல்லார்க்கு * வைகுந்தம் ஆகும் தம் ஊர் எல்லாம்"],0,"/media/recitation/TVM.5.3.11.mp3"]],[[3266,3266,["** Ur ellAm thunjchi * ulagellAm naLLiruLAy *","nIr ellAm thERi * Or nIL iravAy nINDadhAl **","pAr ellAm uNDa * nam pAmbaNaiyAn vArAnAl *","Ar? ellE! valvinaiyEn * Avi kAppAr iniyE"],["** ஊர் எல்லாம் துஞ்சி * உலகெல்லாம் நள்ளிருளாய் *","நீர் எல்லாம் தேறி * ஓர் நீள் இரவாய் நீண்டதால் **","பார் எல்லாம் உண்ட * நம் பாம்பணையான் வாரானால் *","ஆர்? எல்லே! வல்வினையேன் * ஆவி காப்பார் இனியே"],0,"/media/recitation/TVM.5.4.1.mp3"],[3267,3267,["Avi kAppAr ini yAr? * Azh kaDal maN viN mUDi *","mA vikAramAy * Or valliravAy nINDadhAl **","kAvi sEr vaNNan * en kaNNanum vArAnAl *","pAviyEn nenjchamE! * nIyum pAnggu allaiyE"],["ஆவி காப்பார் இனி யார்? * ஆழ் கடல் மண் விண் மூடி *","மா விகாரமாய் * ஓர் வல்லிரவாய் நீண்டதால் **","காவி சேர் வண்ணன் * என் கண்ணனும் வாரானால் *","பாவியேன் நெஞ்சமே! * நீயும் பாங்கு அல்லையே"],0,"/media/recitation/TVM.5.4.2.mp3"],[3268,3268,["nIyum pAnggu allai kAN * nenjchamE! nIL iravum *","Oyum pozhudhu inRi * UzhiyAy nINDadhAl **","kAyum kaDunjchilai * en kAguththan vArAnAl *","mAyum vagai aRiyEn * valvinaiyEn peN piRandhE"],["நீயும் பாங்கு அல்லை காண் * நெஞ்சமே! நீள் இரவும் *","ஓயும் பொழுது இன்றி * ஊழியாய் நீண்டதால் **","காயும் கடுஞ்சிலை * என் காகுத்தன் வாரானால் *","மாயும் வகை அறியேன் * வல்வினையேன் பெண் பிறந்தே"],0,"/media/recitation/TVM.5.4.3.mp3"],[3269,3269,["peN piRandhAr eydhum * perunthuyar kANgilEn enRu *","oN suDarOn * vArAdhu oLiththAn ** immaN aLandha","kaN periya sevvAy * engkAr ERu vArAnAl *","eN periya sindhai nOy * thIrppAr Ar ennaiyE?"],["பெண் பிறந்தார் எய்தும் * பெருந்துயர் காண்கிலேன் என்று *","ஒண் சுடரோன் * வாராது ஒளித்தான் ** இம்மண் அளந்த","கண் பெரிய செவ்வாய் * எங்கார் ஏறு வாரானால் *","எண் பெரிய சிந்தை நோய் * தீர்ப்பார் ஆர் என்னையே?"],0,"/media/recitation/TVM.5.4.4.mp3"],[3270,3270,["Ar ennai ArAyvAr? * annaiyarum thOzhiyarum *","nIr ennE? ennAdhE * nIL iravum thunjchuvarAl **","kAr anna mEni * nam kaNNanum vArAnAl *","pEr ennai mAyAdhAl * valvinaiyEn pin ninRE"],["ஆர் என்னை ஆராய்வார்? * அன்னையரும் தோழியரும் *","நீர் என்னே? என்னாதே * நீள் இரவும் துஞ்சுவரால் **","கார் அன்ன மேனி * நம் கண்ணனும் வாரானால் *","பேர் என்னை மாயாதால் * வல்வினையேன் பின் நின்றே"],0,"/media/recitation/TVM.5.4.5.mp3"],[3271,3271,["pin ninRa kAdhal nOy * nenjcham peridhu aDumAl *","mun ninRu irA Uzhi * kaN pudhaiya mUDiRRAl **","man ninRa chakkaraththu * em mAyavanum vArAnAl *","inninRa nIL Avi * kAppAr Ar ivviDaththE?"],["பின் நின்ற காதல் நோய் * நெஞ்சம் பெரிது அடுமால் *","முன் நின்று இரா ஊழி * கண் புதைய மூடிற்றால் **","மன் நின்ற சக்கரத்து * எம் மாயவனும் வாரானால் *","இந்நின்ற நீள் ஆவி * காப்பார் ஆர் இவ்விடத்தே?"],0,"/media/recitation/TVM.5.4.6.mp3"],[3272,3272,["kAppAr Ar ivviDaththu? * kanggiruLin nuN thuLiyAy *","chETpAladhu UzhiyAych * selginRa kanggul vAy **","thUp pAla veNsanggu * chakkaraththan thOnRAnAl *","thIp pAla valvinaiyEn * dheyvanggAL! en seygEnO?"],["காப்பார் ஆர் இவ்விடத்து? * கங்கிருளின் நுண் துளியாய் *","சேட்பாலது ஊழியாய்ச் * செல்கின்ற கங்குல் வாய் **","தூப் பால வெண்சங்கு * சக்கரத்தன் தோன்றானால் *","தீப் பால வல்வினையேன் * தெய்வங்காள்! என் செய்கேனோ?"],0,"/media/recitation/TVM.5.4.7.mp3"],[3273,3273,["dheyvanggAL! en seygEn? * Or iravu Ezh UzhiyAy *","mey vandhu ninRu * enadhAvi melivikkum **","kai vandha chakkaraththu * en kaNNanum vArAnAl *","thaivandha thaNthenRal * venjchuDaril thAn aDumE"],["தெய்வங்காள்! என் செய்கேன்? * ஓர் இரவு ஏழ் ஊழியாய் *","மெய் வந்து நின்று * எனதாவி மெலிவிக்கும் **","கை வந்த சக்கரத்து * என் கண்ணனும் வாரானால் *","தைவந்த தண்தென்றல் * வெஞ்சுடரில் தான் அடுமே"],0,"/media/recitation/TVM.5.4.8.mp3"],[3274,3274,["venjchuDaril thAn aDumAl * vInggiruLin nuN thuLiyAy *","anjchuDara veyyOn * aNi neDunthEr thOnRAdhAl **","senjchuDarth thAmaraik kaN * selvanum vArAnAl *","nenjchiDar thIrppAr ini yAr? * ninRu uruguginREnE"],["வெஞ்சுடரில் தான் அடுமால் * வீங்கிருளின் நுண் துளியாய் *","அஞ்சுடர வெய்யோன் * அணி நெடுந்தேர் தோன்றாதால் **","செஞ்சுடர்த் தாமரைக் கண் * செல்வனும் வாரானால் *","நெஞ்சிடர் தீர்ப்பார் இனி யார்? * நின்று உருகுகின்றேனே"],0,"/media/recitation/TVM.5.4.9.mp3"],[3275,3275,["ninRu uruguginREnE pOla * neDu vAnam *","senRu urugi nuN thuLiyAych * selginRa kanggul vAy **","anRu orukAl vaiyam * aLandha pirAn vArAn enRu *","onRu orukAl sollAdhu * ulagO uRanggumE"],["நின்று உருகுகின்றேனே போல * நெடு வானம் *","சென்று உருகி நுண் துளியாய்ச் * செல்கின்ற கங்குல் வாய் **","அன்று ஒருகால் வையம் * அளந்த பிரான் வாரான் என்று *","ஒன்று ஒருகால் சொல்லாது * உலகோ உறங்குமே"],0,"/media/recitation/TVM.5.4.10.mp3"],[3276,3276,["** uRangguvAn pOl * yOgu seydha perumAnai *","siRandha pozhil sUzh * kurugUrch saDakOpan sol **","niRam kiLarndha andhAdhi * Ayiraththu ippaththAl *","iRandhu pOy vaikundham * sErA ARu engnganEyO?"],["** உறங்குவான் போல் * யோகு செய்த பெருமானை *","சிறந்த பொழில் சூழ் * குருகூர்ச் சடகோபன் சொல் **","நிறம் கிளர்ந்த அந்தாதி * ஆயிரத்து இப்பத்தால் *","இறந்து போய் வைகுந்தம் * சேரா ஆறு எங்ஙனேயோ?"],0,"/media/recitation/TVM.5.4.11.mp3"]],[[3277,3277,["** engnganEyO annaimIrgAL! * ennai munivadhu nIr? *","nanggaL kOlath thirukkuRungkuDi nambiyai * nAn kaNDa pin **","sangginODum nEmiyODum * thAmaraik kaNgaLODum *","sengkani vAy onRinODum * selginRadhu en nenjchamE"],["** எங்ஙனேயோ அன்னைமீர்காள்! * என்னை முனிவது நீர்? *","நங்கள் கோலத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","சங்கினோடும் நேமியோடும் * தாமரைக் கண்களோடும் *","செங்கனி வாய் ஒன்றினோடும் * செல்கின்றது என் நெஞ்சமே"],0,"/media/recitation/TVM.5.5.1.mp3"],[3278,3278,["en nenjchinAl nOkkik kANIr * ennai muniyAdhE *","thennan sOlaith thirukkuRungkuDi nambiyai * nAn kaNDa pin **","minnu nUlum kuNDalamum * mArvil thiru maRuvum *","mannu pUNum nAnku thOLum * vandhu enggum ninRiDumE"],["என் நெஞ்சினால் நோக்கிக் காணீர் * என்னை முனியாதே *","தென்னன் சோலைத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","மின்னு நூலும் குண்டலமும் * மார்வில் திரு மறுவும் *","மன்னு பூணும் நான்கு தோளும் * வந்து எங்கும் நின்றிடுமே"],0,"/media/recitation/TVM.5.5.2.mp3"],[3279,3279,["ninRiDum thisaikkum naiyum enRu * annaiyarum munidhir *","kunRa mADath thirukkuRungkuDi nambiyai * nAn kaNDa pin **","venRi villum thaNDum vALum * chakkaramum sanggamum *","ninRu thOnRik kaNNuL nInggA * nenjchuLLum nInggAvE"],["நின்றிடும் திசைக்கும் நையும் என்று * அன்னையரும் முனிதிர் *","குன்ற மாடத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","வென்றி வில்லும் தண்டும் வாளும் * சக்கரமும் சங்கமும் *","நின்று தோன்றிக் கண்ணுள் நீங்கா * நெஞ்சுள்ளும் நீங்காவே"],0,"/media/recitation/TVM.5.5.3.mp3"],[3280,3280,["nIngga nillA kaNNa nIrgaL enRu * annaiyarum munidhir *","thEn koL sOlaith thirukkuRungkuDi nambiyai * nAn kaNDa pin **","pUnthaN mAlaith thaNthuzhAyum * pon muDiyum vaDivum *","pAnggu thOnRum paTTum nANum * pAviyEn pakkaththavE"],["நீங்க நில்லா கண்ண நீர்கள் என்று * அன்னையரும் முனிதிர் *","தேன் கொள் சோலைத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","பூந்தண் மாலைத் தண்துழாயும் * பொன் முடியும் வடிவும் *","பாங்கு தோன்றும் பட்டும் நாணும் * பாவியேன் பக்கத்தவே"],0,"/media/recitation/TVM.5.5.4.mp3"],[3281,3281,["pakkam nOkki niRkum naiyum enRu * annaiyarum munidhir *","thakka kIrththik thirukkuRungkuDi nambiyai * nAn kaNDa pin **","thokka sOthith thoNDai vAyum * nINDa puruvanggaLum *","thakka thAmaraik kaNNum * pAviyEn Aviyin mElanavE"],["பக்கம் நோக்கி நிற்கும் நையும் என்று * அன்னையரும் முனிதிர் *","தக்க கீர்த்திக் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","தொக்க சோதித் தொண்டை வாயும் * நீண்ட புருவங்களும் *","தக்க தாமரைக் கண்ணும் * பாவியேன் ஆவியின் மேலனவே"],0,"/media/recitation/TVM.5.5.5.mp3"],[3282,3282,["mElum van pazhi nangkuDikku ivaL enRu * annai kANa koDAL *","sOlai sUzh thaN thirukkuRungkuDi nambiyai * nAn kaNDa pin **","kOla nIL koDi mUkkum * thAmaraik kaNNum kani vAyum *","nIla mEniyum nAnku thOLum * en nenjcham niRaindhanavE"],["மேலும் வன் பழி நங்குடிக்கு இவள் என்று * அன்னை காண கொடாள் *","சோலை சூழ் தண் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","கோல நீள் கொடி மூக்கும் * தாமரைக் கண்ணும் கனி வாயும் *","நீல மேனியும் நான்கு தோளும் * என் நெஞ்சம் நிறைந்தனவே"],0,"/media/recitation/TVM.5.5.6.mp3"],[3283,3283,["niRaindha van pazhi nangkuDikku ivaL enRu * annai kANa koDAL *","siRandha kIrththith thirukkuRungkuDi nambiyai * nAn kaNDa pin **","niRaindha sOthi veLLam sUzhndha * nINDa pon mEniyoDum *","niRaindhu ennuLLE ninRu ozhindhAn * nEmi angkai uLadhE"],["நிறைந்த வன் பழி நங்குடிக்கு இவள் என்று * அன்னை காண கொடாள் *","சிறந்த கீர்த்தித் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","நிறைந்த சோதி வெள்ளம் சூழ்ந்த * நீண்ட பொன் மேனியொடும் *","நிறைந்து என்னுள்ளே நின்று ஒழிந்தான் * நேமி அங்கை உளதே"],0,"/media/recitation/TVM.5.5.7.mp3"],[3284,3284,["kaiyuL nan mugam vaikkum naiyum enRu * annaiyarum munidhir *","maikoL mADath thirukkuRungkuDi nambiyai * nAn kaNDa pin **","seyya thAmaraik kaNNum algulum * siRRiDaiyum vaDivum *","moyya nIL kuzhal thAzhndha thOLgaLum * pAviyEn mun niRkumE"],["கையுள் நன் முகம் வைக்கும் நையும் என்று * அன்னையரும் முனிதிர் *","மைகொள் மாடத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","செய்ய தாமரைக் கண்ணும் அல்குலும் * சிற்றிடையும் வடிவும் *","மொய்ய நீள் குழல் தாழ்ந்த தோள்களும் * பாவியேன் முன் நிற்குமே"],0,"/media/recitation/TVM.5.5.8.mp3"],[3285,3285,["mun ninRAy enRu thOzhimArgaLum * annaiyarum munidhir *","mannu mADath thirukkuRungkuDi nambiyai * nAn kaNDa pin **","senni nIL muDi AdhiyAya * ulappil aNi kalaththan *","kannal pAl amudhAgi vandhu * en nenjcham kazhiyAnE"],["முன் நின்றாய் என்று தோழிமார்களும் * அன்னையரும் முனிதிர் *","மன்னு மாடத் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","சென்னி நீள் முடி ஆதியாய * உலப்பில் அணி கலத்தன் *","கன்னல் பால் அமுதாகி வந்து * என் நெஞ்சம் கழியானே"],0,"/media/recitation/TVM.5.5.9.mp3"],[3286,3286,["kazhiya mikkadhOr kAdhalaL ivaL enRu * annai kANa koDAL *","vazhu il kIrththith thirukkuRungkuDi nambiyai * nAn kaNDa pin **","kuzhumith dhEvar kuzhAnggaL * kai thozhach sOthi veLLaththin uLLE *","ezhuvadhOr uru en nenjchuL ezhum * Arkkum aRivaridhE"],["கழிய மிக்கதோர் காதலள் இவள் என்று * அன்னை காண கொடாள் *","வழு இல் கீர்த்தித் திருக்குறுங்குடி நம்பியை * நான் கண்ட பின் **","குழுமித் தேவர் குழாங்கள் * கை தொழச் சோதி வெள்ளத்தின் உள்ளே *","எழுவதோர் உரு என் நெஞ்சுள் எழும் * ஆர்க்கும் அறிவரிதே"],0,"/media/recitation/TVM.5.5.10.mp3"],[3287,3287,["** aRivariya pirAnai * Azhi angkaiyanaiyE alaRRi *","naRiya nalmalar nADi * nankurugUrch saDakOpan sonna **","kuRi koL AyiraththuL ivai paththum * thirukkuRungkuDi adhan mEl *","aRiyak kaRRu vallAr vaiTNavar * Azh kaDal njAlaththuLLE"],["** அறிவரிய பிரானை * ஆழி அங்கையனையே அலற்றி *","நறிய நல்மலர் நாடி * நன்குருகூர்ச் சடகோபன் சொன்ன **","குறி கொள் ஆயிரத்துள் இவை பத்தும் * திருக்குறுங்குடி அதன் மேல் *","அறியக் கற்று வல்லார் வைட்ணவர் * ஆழ் கடல் ஞாலத்துள்ளே"],0,"/media/recitation/TVM.5.5.11.mp3"]],[[3288,3288,["** kaDal njAlam seydhEnum yAnE ennum *","kaDal njAlam AvEnum yAnE ennum *","kaDal njAlam koNDEnum yAnE ennum *","kaDal njAlam kINDEnum yAnE ennum **","kaDal njAlam uNDEnum yAnE ennum *","kaDal njAlaththu Isan vandhu ERak kolO? *","kaDal njAlaththIrkku ivai en sollugEn? *","kaDal njAlaththu en magaL kaRkinRanavE"],["** கடல் ஞாலம் செய்தேனும் யானே என்னும் *","கடல் ஞாலம் ஆவேனும் யானே என்னும் *","கடல் ஞாலம் கொண்டேனும் யானே என்னும் *","கடல் ஞாலம் கீண்டேனும் யானே என்னும் **","கடல் ஞாலம் உண்டேனும் யானே என்னும் *","கடல் ஞாலத்து ஈசன் வந்து ஏறக் கொலோ? *","கடல் ஞாலத்தீர்க்கு இவை என் சொல்லுகேன்? *","கடல் ஞாலத்து என் மகள் கற்கின்றனவே"],0,"/media/recitation/TVM.5.6.1.mp3"],[3289,3289,["kaRkum kalvikku ellai ilanE ennum *","kaRkum kalvi AvEnum yAnE ennum *","kaRkum kalvi seyvEnum yAnE ennum *","kaRkum kalvi thIrppEnum yAnE ennum **","kaRkum kalvich sAramum yAnE ennum *","kaRkum kalvi nAthan vandhu ERak kolO? *","kaRkum kalviyIrkku ivai en sollugEn? *","kaRkum kalvi en magaL kANginRanavE"],["கற்கும் கல்விக்கு எல்லை இலனே என்னும் *","கற்கும் கல்வி ஆவேனும் யானே என்னும் *","கற்கும் கல்வி செய்வேனும் யானே என்னும் *","கற்கும் கல்வி தீர்ப்பேனும் யானே என்னும் **","கற்கும் கல்விச் சாரமும் யானே என்னும் *","கற்கும் கல்வி நாதன் வந்து ஏறக் கொலோ? *","கற்கும் கல்வியீர்க்கு இவை என் சொல்லுகேன்? *","கற்கும் கல்வி என் மகள் காண்கின்றனவே"],0,"/media/recitation/TVM.5.6.2.mp3"],[3290,3290,["kANginRa nilam ellAm yAnE ennum *","kANginRa visumbu ellAm yAnE ennum *","kANginRa venthI ellAm yAnE ennum *","kANginRa ikkARRu ellAm yAnE ennum **","kANginRa kaDal ellAm yAnE ennum *","kANginRa kaDal vaNNan ERak kolO? *","kANginRa ulagaththIrkku en sollugEn? *","kANginRa en kArigai seyginRanavE"],["காண்கின்ற நிலம் எல்லாம் யானே என்னும் *","காண்கின்ற விசும்பு எல்லாம் யானே என்னும் *","காண்கின்ற வெந்தீ எல்லாம் யானே என்னும் *","காண்கின்ற இக்காற்று எல்லாம் யானே என்னும் **","காண்கின்ற கடல் எல்லாம் யானே என்னும் *","காண்கின்ற கடல் வண்ணன் ஏறக் கொலோ? *","காண்கின்ற உலகத்தீர்க்கு என் சொல்லுகேன்? *","காண்கின்ற என் காரிகை செய்கின்றனவே"],0,"/media/recitation/TVM.5.6.3.mp3"],[3291,3291,["seyginRa kidhi ellAm yAnE ennum *","seyvAn ninRanagaLum yAnE ennum *","seydhu mun iRandhavum yAnE ennum *","seygaip payan uNbEnum yAnE ennum **","seyvArgaLaich seyvEnum yAnE ennum *","seyya kamalak kaNNan ERak kolO? *","seyya ulagaththIrkku ivai en sollugEn? *","seyya kani vAy iLa mAn thiRaththE"],["செய்கின்ற கிதி எல்லாம் யானே என்னும் *","செய்வான் நின்றனகளும் யானே என்னும் *","செய்து முன் இறந்தவும் யானே என்னும் *","செய்கைப் பயன் உண்பேனும் யானே என்னும் **","செய்வார்களைச் செய்வேனும் யானே என்னும் *","செய்ய கமலக் கண்ணன் ஏறக் கொலோ? *","செய்ய உலகத்தீர்க்கு இவை என் சொல்லுகேன்? *","செய்ய கனி வாய் இள மான் திறத்தே"],0,"/media/recitation/TVM.5.6.4.mp3"],[3292,3292,["thiRambAmal maN kAkkinREn yAnE ennum *","thiRambAmal malai eDuththEnE ennum *","thiRambAmal asuraraik konREnE ennum *","thiRam kATTi anRu aivaraik kAththEnE ennum **","thiRambAmal kaDal kaDaindhEnE ennum *","thiRambAdha kaDal vaNNan ERak kolO? *","thiRambAtha ulagaththIrkku en sollugEn? *","thiRambAdhu en thirumagaL eydhinavE"],["திறம்பாமல் மண் காக்கின்றேன் யானே என்னும் *","திறம்பாமல் மலை எடுத்தேனே என்னும் *","திறம்பாமல் அசுரரைக் கொன்றேனே என்னும் *","திறம் காட்டி அன்று ஐவரைக் காத்தேனே என்னும் **","திறம்பாமல் கடல் கடைந்தேனே என்னும் *","திறம்பாத கடல் வண்ணன் ஏறக் கொலோ? *","திறம்பாத உலகத்தீர்க்கு என் சொல்லுகேன்? *","திறம்பாது என் திருமகள் எய்தினவே"],0,"/media/recitation/TVM.5.6.5.mp3"],[3293,3293,["ina vEy malai EndhinEn yAnE ennum *","ina ERugaL seRREnum yAnE ennum *","ina An kanRu mEyththEnum yAnE ennum *","ina Anirai kAththEnum yAnE ennum **","ina Ayar thalaivanum yAnE ennum *","inath thEvar thalaivan vandhu ERak kolO? *","ina vERkaN nallIrkku ivai en sollugEn? *","ina vERkaNNi en magaL uRRanavE"],["இன வேய் மலை ஏந்தினேன் யானே என்னும் *","இன ஏறுகள் செற்றேனும் யானே என்னும் *","இன ஆன் கன்று மேய்த்தேனும் யானே என்னும் *","இன ஆநிரை காத்தேனும் யானே என்னும் **","இன ஆயர் தலைவனும் யானே என்னும் *","இனத் தேவர் தலைவன் வந்து ஏறக் கொலோ? *","இன வேற்கண் நல்லீர்க்கு இவை என் சொல்லுகேன்? *","இன வேற்கண்ணி என் மகள் உற்றனவே"],0,"/media/recitation/TVM.5.6.6.mp3"],[3294,3294,["uRRArgaL enakku illai yArum ennum *","uRRArgaL enakku inggu ellArum ennum *","uRRArgaLaich seyvEnum yAnE ennum *","uRRArgaLai azhippEnum yAnE ennum **","uRRArgaLukku uRREnum yAnE ennum *","uRRAr ili mAyan vandhu ERak kolO? *","uRRIrgaTku en sollich sollugEn yAn? *","uRRu ennuDaip pEdhai uraikkinRanavE"],["உற்றார்கள் எனக்கு இல்லை யாரும் என்னும் *","உற்றார்கள் எனக்கு இங்கு எல்லாரும் என்னும் *","உற்றார்களைச் செய்வேனும் யானே என்னும் *","உற்றார்களை அழிப்பேனும் யானே என்னும் **","உற்றார்களுக்கு உற்றேனும் யானே என்னும் *","உற்றார் இலி மாயன் வந்து ஏறக் கொலோ? *","உற்றீர்கட்கு என் சொல்லிச் சொல்லுகேன் யான்? *","உற்று என்னுடைப் பேதை உரைக்கின்றனவே"],0,"/media/recitation/TVM.5.6.7.mp3"],[3295,3295,["uraikkinRa mukkaN pirAn yAnE ennum *","uraikkinRa thisaimugan yAnE ennum *","uraikkinRa amararum yAnE ennum *","uraikkinRa amarar kOn yAnE ennum **","uraikkinRa munivarum yAnE ennum *","uraikkinRa mugil vaNNan ERak kolO? *","uraikkinRa ulagaththIrkku en sollugEn? *","uraikkinRa en kOmaLa oN koDikkE"],["உரைக்கின்ற முக்கண் பிரான் யானே என்னும் *","உரைக்கின்ற திசைமுகன் யானே என்னும் *","உரைக்கின்ற அமரரும் யானே என்னும் *","உரைக்கின்ற அமரர் கோன் யானே என்னும் **","உரைக்கின்ற முனிவரும் யானே என்னும் *","உரைக்கின்ற முகில் வண்ணன் ஏறக் கொலோ? *","உரைக்கின்ற உலகத்தீர்க்கு என் சொல்லுகேன்? *","உரைக்கின்ற என் கோமள ஒண் கொடிக்கே"],0,"/media/recitation/TVM.5.6.8.mp3"],[3296,3296,["koDiya vinai yAdhum ilanE ennum *","koDiya vinai AvEnum yAnE ennum *","koDiya vinai seyvEnum yAnE ennum *","koDiya vinai thIrppEnum yAnE ennum **","koDiyAn ilanggai seRREnE ennum *","koDiya puL uDaiyavan ERak kolO? *","koDiya ulagaththIrkku ivai en sollugEn? *","koDiyEn koDi en magaL kOlanggaLE"],["கொடிய வினை யாதும் இலனே என்னும் *","கொடிய வினை ஆவேனும் யானே என்னும் *","கொடிய வினை செய்வேனும் யானே என்னும் *","கொடிய வினை தீர்ப்பேனும் யானே என்னும் **","கொடியான் இலங்கை செற்றேனே என்னும் *","கொடிய புள் உடையவன் ஏறக் கொலோ? *","கொடிய உலகத்தீர்க்கு இவை என் சொல்லுகேன்? *","கொடியேன் கொடி என் மகள் கோலங்களே"],0,"/media/recitation/TVM.5.6.9.mp3"],[3297,3297,["kOlangkoL suvarkkamum yAnE ennum *","kOlamil naragamum yAnE ennum *","kOlam thigazh mOkkamum yAnE ennum *","kOlangkoL uyirgaLum yAnE ennum **","kOlangkoL thani mudhal yAnE ennum *","kOlangkoL mugil vaNNan ERak kolO? *","kOlangkoL ulagaththIrkku en sollugEn? *","kOlam thigazh kOdhai en kUndhalukkE"],["கோலங்கொள் சுவர்க்கமும் யானே என்னும் *","கோலமில் நரகமும் யானே என்னும் *","கோலம் திகழ் மோக்கமும் யானே என்னும் *","கோலங்கொள் உயிர்களும் யானே என்னும் **","கோலங்கொள் தனி முதல் யானே என்னும் *","கோலங்கொள் முகில் வண்ணன் ஏறக் கொலோ? *","கோலங்கொள் உலகத்தீர்க்கு என் சொல்லுகேன்? *","கோலம் திகழ் கோதை என் கூந்தலுக்கே"],0,"/media/recitation/TVM.5.6.10.mp3"],[3298,3298,["** kUndhal malar manggaikkum maN maDandhaikkum *","kula Ayar kozhundhukkum kELvan thannai *","vAyndha vazhudhi vaLa nADan * mannu","kurugUrch saDakOpan kuRREval seydhu **","Ayndha thamizh mAlai * AyiraththuL","ivaiyum Or paththum vallAr * ulagil","Endhu perunjchelvaththarAyth * thirumAl","aDiyArgaLaip pUsikka nORRArgaLE"],["** கூந்தல் மலர் மங்கைக்கும் மண் மடந்தைக்கும் *","குல ஆயர் கொழுந்துக்கும் கேள்வன் தன்னை *","வாய்ந்த வழுதி வள நாடன் * மன்னு","குருகூர்ச் சடகோபன் குற்றேவல் செய்து **","ஆய்ந்த தமிழ் மாலை * ஆயிரத்துள்","இவையும் ஓர் பத்தும் வல்லார் * உலகில்","ஏந்து பெருஞ்செல்வத்தராய்த் * திருமால்","அடியார்களைப் பூசிக்க நோற்றார்களே"],0,"/media/recitation/TVM.5.6.11.mp3"]],[[3299,3299,["** nORRa nOnbilEn * nuNNaRivu ilEn * Agilum ini unnai viTTu onRum","ARRa kiRkinRilEn * aravin aNai ammAnE! **","sERRuth thAmarai sennelUDu malar * sirIvara manggala nagar *","vIRRirundha endhAy! * unakku migai allEn anggE"],["** நோற்ற நோன்பிலேன் * நுண்ணறிவு இலேன் * ஆகிலும் இனி உன்னை விட்டு ஒன்றும்","ஆற்ற கிற்கின்றிலேன் * அரவின் அணை அம்மானே! **","சேற்றுத் தாமரை செந்நெலூடு மலர் * சிரீவர மங்கல நகர் *","வீற்றிருந்த எந்தாய்! * உனக்கு மிகை அல்லேன் அங்கே"],0,"/media/recitation/TVM.5.7.1.mp3"],[3300,3300,["angguRREn allEn ingguRREn allEn * unnaik kANum avAvil vIzhndhu * nAn","engguRREnum allEn * ilanggai seRRa ammAnE! **","thinggaL sEr maNi mADa nIDu * sirIvara manggala nagar uRai *","sanggu chakkaraththAy! * thamiyEnukku aruLAyE"],["அங்குற்றேன் அல்லேன் இங்குற்றேன் அல்லேன் * உன்னைக் காணும் அவாவில் வீழ்ந்து *","நான்","எங்குற்றேனும் அல்லேன் * இலங்கை செற்ற அம்மானே! **","திங்கள் சேர் மணி மாட நீடு * சிரீவர மங்கல நகர் உறை *","சங்கு சக்கரத்தாய்! * தமியேனுக்கு அருளாயே"],0,"/media/recitation/TVM.5.7.2.mp3"],[3301,3301,["karuLap puTkoDi chakkarap paDai * vAna nADa! en kAr mugil vaNNA *","poruL allAdha ennaip poruL Akki * aDimai koNDAy **","theruL koL nAnmaRai vallavar palar vAzh * sirIvara manggala nagarkku *","aruL seydhu anggu irundhAy! * aRiyEn oru kaimmARE"],["கருளப் புட்கொடி சக்கரப் படை * வான நாட! என் கார் முகில் வண்ணா *","பொருள் அல்லாத என்னைப் பொருள் ஆக்கி * அடிமை கொண்டாய் **","தெருள் கொள் நான்மறை வல்லவர் பலர் வாழ் * சிரீவர மங்கல நகர்க்கு *","அருள் செய்து அங்கு இருந்தாய்! * அறியேன் ஒரு கைம்மாறே"],0,"/media/recitation/TVM.5.7.3.mp3"],[3302,3302,["mARu sEr paDai nURRuvar mangga * Or aivarkkAy anRu mAyap pOr paNNi *","nIRu seydha endhAy! * nilam kINDa ammAnE! **","thERu njAnaththar vEdha vELvi aRAch * sirIvara manggala nagar *","ERi vIRRirundhAy! * unnai enggu eydhak kUvuvanE?"],["மாறு சேர் படை நூற்றுவர் மங்க * ஓர் ஐவர்க்காய் அன்று மாயப் போர் பண்ணி *","நீறு செய்த எந்தாய்! * நிலம் கீண்ட அம்மானே! **","தேறு ஞானத்தர் வேத வேள்வி அறாச் * சிரீவர மங்கல நகர் *","ஏறி வீற்றிருந்தாய்! * உன்னை எங்கு எய்தக் கூவுவனே?"],0,"/media/recitation/TVM.5.7.4.mp3"],[3303,3303,["eydhak kUvudhal AvadhE enakku? * evva thevvaththuLAyum Ay ninRu *","kaithavanggaL seyyum * karu mEni ammAnE! **","seydha vELviyar vaiyath dhEvar aRAch * sirIvara manggala nagar *","kai thozha irundhAy * adhu nAnum kaNDEnE"],["எய்தக் கூவுதல் ஆவதே எனக்கு? * எவ்வ தெவ்வத்துளாயும் ஆய் நின்று *","கைதவங்கள் செய்யும் * கரு மேனி அம்மானே! **","செய்த வேள்வியர் வையத் தேவர் அறாச் * சிரீவர மங்கல நகர் *","கை தொழ இருந்தாய் * அது நானும் கண்டேனே"],0,"/media/recitation/TVM.5.7.5.mp3"],[3304,3304,["** EnamAy nilam kINDa en appanE! kaNNA! * enRum ennai ALuDai *","vAna nAyaganE! * maNi mANikkach suDarE **","thEna mAm pozhil thaN sirIvara manggalaththavar * kai thozha uRai *","vAnamAmalaiyE! * aDiyEn thozha vandharuLE"],["** ஏனமாய் நிலம் கீண்ட என் அப்பனே! கண்ணா! * என்றும் என்னை ஆளுடை *","வான நாயகனே! * மணி மாணிக்கச் சுடரே **","தேன மாம் பொழில் தண் சிரீவர மங்கலத்தவர் * கை தொழ உறை *","வானமாமலையே! * அடியேன் தொழ வந்தருளே"],0,"/media/recitation/TVM.5.7.6.mp3"],[3305,3305,["vandharuLi en nenjchu iDam koNDa * vAnavar kozhundhE! * ulagukku Or","mundhaith thAy thandhaiyE! * muzhu Ezh ulagum uNDAy **","senthozhilavar vEdha vELvi aRAch * sirIvara manggala nagar *","andham il pugazhAy! * aDiyEnai agaRRElE"],["வந்தருளி என் நெஞ்சு இடம் கொண்ட * வானவர் கொழுந்தே! * உலகுக்கு ஓர்","முந்தைத் தாய் தந்தையே! * முழு ஏழ் உலகும் உண்டாய் **","செந்தொழிலவர் வேத வேள்வி அறாச் * சிரீவர மங்கல நகர் *","அந்தம் இல் புகழாய்! * அடியேனை அகற்றேலே"],0,"/media/recitation/TVM.5.7.7.mp3"],[3306,3306,["agaRRa nI vaiththa mAya val aimpulankaL Am avai * nanku aRindhanan *","agaRRi ennaiyum nI * arunjchERRil vIzhththi kaNDAy **","pagaR kadhir maNi mADa nIDu * sirIvara manggai vANanE! * enRum","pugaRku ariya endhAy! * puLLin vAy piLandhAnE!"],["அகற்ற நீ வைத்த மாய வல் ஐம்புலன்கள் ஆம் அவை * நன்கு அறிந்தனன் *","அகற்றி என்னையும் நீ * அருஞ்சேற்றில் வீழ்த்தி கண்டாய் **","பகற் கதிர் மணி மாட நீடு * சிரீவர மங்கை வாணனே! * என்றும்","புகற்கு அரிய எந்தாய்! * புள்ளின் வாய் பிளந்தானே!"],0,"/media/recitation/TVM.5.7.8.mp3"],[3307,3307,["puLLin vAy piLandhAy! marudhu iDai pOyinAy! * erudhu Ezh aDarththa * en","kaLLa mAyavanE! * karu mANikkach suDarE **","theLLiyAr thiru nAnmaRaigaL vallAr * mali thaN sirIvara manggai *","uL irundha endhAy! * aruLAy uyyum ARu enakkE"],["புள்ளின் வாய் பிளந்தாய்! மருது இடை போயினாய்! * எருது ஏழ் அடர்த்த * என்","கள்ள மாயவனே! * கரு மாணிக்கச் சுடரே **","தெள்ளியார் திரு நான்மறைகள் வல்லார் * மலி தண் சிரீவர மங்கை *","உள் இருந்த எந்தாய்! * அருளாய் உய்யும் ஆறு எனக்கே"],0,"/media/recitation/TVM.5.7.9.mp3"],[3308,3308,["ARenakku nin pAdhamE * saraNAgath thandhu ozhindhAy * unakku Or kaim","mARu nAn onRilEn * enadhu Aviyum unadhE **","sERu koL karumbum perunjchennelum * mali thaN sirIvara manggai *","nARu pUnthaN thuzhAy muDiyAy! * dheyva nAyaganE!"],["ஆறெனக்கு நின் பாதமே * சரணாகத் தந்து ஒழிந்தாய் * உனக்கு ஓர் கைம்","மாறு நான் ஒன்றிலேன் * எனது ஆவியும் உனதே **","சேறு கொள் கரும்பும் பெருஞ்செந்நெலும் * மலி தண் சிரீவர மங்கை *","நாறு பூந்தண் துழாய் முடியாய்! * தெய்வ நாயகனே!"],0,"/media/recitation/TVM.5.7.10.mp3"],[3309,3309,["** dheyva nAyagan nAraNan * thirivikkiraman aDi iNai misai *","koy koL pUmpozhil sUzh * kurugUrch saDakOpan **","seydha AyiraththuL ivai * thaN sirIvara manggai mEya paththuDan *","vaigal pADa vallAr * vAnOrkku ArA amudhE"],["** தெய்வ நாயகன் நாரணன் * திரிவிக்கிரமன் அடி இணை மிசை *","கொய் கொள் பூம்பொழில் சூழ் * குருகூர்ச் சடகோபன் **","செய்த ஆயிரத்துள் இவை * தண் சிரீவர மங்கை மேய பத்துடன் *","வைகல் பாட வல்லார் * வானோர்க்கு ஆரா அமுதே"],0,"/media/recitation/TVM.5.7.11.mp3"]],[[3310,3310,["** ArA amudhE! aDiyEn uDalam * nin pAl anbAyE *","nIrAy alaindhu karaiya * urukkuginRa neDumAlE! **","sIr Ar sennel kavari vIsum * sezhu nIrth thirukkuDandhai *","Er Ar kOlam thigazhak kiDandhAy! * kaNDEn emmAnE!"],["** ஆரா அமுதே! அடியேன் உடலம் * நின் பால் அன்பாயே *","நீராய் அலைந்து கரைய * உருக்குகின்ற நெடுமாலே! **","சீர் ஆர் செந்நெல் கவரி வீசும் * செழு நீர்த் திருக்குடந்தை *","ஏர் ஆர் கோலம் திகழக் கிடந்தாய்! * கண்டேன் எம்மானே!"],0,"/media/recitation/TVM.5.8.1.mp3"],[3311,3311,["emmAnE! en veLLai mUrththi! * ennai ALvAnE *","em mA uruvum vENDum ARRAl * AvAy! ezhil ERE! **","sem mA kamalam sezhu nIr misaik kaN malarum * thirukkuDandhai *","am mA malark kaN vaLarginRAnE! * en nAn seygEnE!"],["எம்மானே! என் வெள்ளை மூர்த்தி! * என்னை ஆள்வானே *","எம் மா உருவும் வேண்டும் ஆற்றால் * ஆவாய்! எழில் ஏறே! **","செம் மா கமலம் செழு நீர் மிசைக் கண் மலரும் * திருக்குடந்தை *","அம் மா மலர்க் கண் வளர்கின்றானே! * என் நான் செய்கேனே!"],0,"/media/recitation/TVM.5.8.2.mp3"],[3312,3312,["en nAn seygEn? yArE kaLaikaN? * ennai en seyginRAy? *","unnAl allAl yAvarAlum * onRum kuRai vENDEn **","kannAr madhiL sUzh kuDandhaik kiDandhAy! * aDiyEn aru vANAL *","sennAL ennAL? annAL * una thAL piDiththE selak kANE"],["என் நான் செய்கேன்? யாரே களைகண்? * என்னை என் செய்கின்றாய்? *","உன்னால் அல்லால் யாவராலும் * ஒன்றும் குறை வேண்டேன் **","கன்னார் மதிள் சூழ் குடந்தைக் கிடந்தாய்! * அடியேன் அரு வாணாள் *","சென்னாள் எந்நாள்? அந்நாள் * உன தாள் பிடித்தே செலக் காணே"],0,"/media/recitation/TVM.5.8.3.mp3"],[3313,3313,["selak kAN kiRpAr kANum aLavum * sellum kIrththiyAy! *","ulappu ilAnE! * ellA ulagum uDaiya oru mUrththi! **","nalaththAl mikkAr kuDandhaik kiDandhAy! * unnaik kANbAn nAn","alappAy * AgAsaththai nOkki * azhuvan thozhuvanE"],["செலக் காண் கிற்பார் காணும் அளவும் * செல்லும் கீர்த்தியாய்! *","உலப்பு இலானே! * எல்லா உலகும் உடைய ஒரு மூர்த்தி! **","நலத்தால் மிக்கார் குடந்தைக் கிடந்தாய்! * உன்னைக் காண்பான் நான்","அலப்பாய் * ஆகாசத்தை நோக்கி * அழுவன் தொழுவனே"],0,"/media/recitation/TVM.5.8.4.mp3"],[3314,3314,["azhuvan thozhuvan ADik kANban * pADi alaRRuvan *","thazhu val vinaiyAl pakkam nOkki * nANik kavizhndhu iruppan **","sezhu oN pazhanak kuDandhaik kiDandhAy! * senthAmaraik kaNNA! *","thozhuvanEnai una thAL * sErum vagaiyE sUzh kaNDAy"],["அழுவன் தொழுவன் ஆடிக் காண்பன் * பாடி அலற்றுவன் *","தழு வல் வினையால் பக்கம் நோக்கி * நாணிக் கவிழ்ந்து இருப்பன் **","செழு ஒண் பழனக் குடந்தைக் கிடந்தாய்! * செந்தாமரைக் கண்ணா! *","தொழுவனேனை உன தாள் * சேரும் வகையே சூழ் கண்டாய்"],0,"/media/recitation/TVM.5.8.5.mp3"],[3315,3315,["sUzh kaNDAy en thollai vinaiyai aRuththu * un aDi sErum","Uzh kaNDu irundhE * thUrAk kuzhi thUrththu * enai nAL aganRu iruppan? **","vAzh thol pugazhAr kuDandhaik kiDandhAy! * vAnOr kOmAnE! *","yAzhin isaiyE! amudhE! * aRivin payanE! ari ERE!"],["சூழ் கண்டாய் என் தொல்லை வினையை அறுத்து * உன் அடி சேரும்","ஊழ் கண்டு இருந்தே * தூராக் குழி தூர்த்து * எனை நாள் அகன்று இருப்பன்? **","வாழ் தொல் புகழார் குடந்தைக் கிடந்தாய்! * வானோர் கோமானே! *","யாழின் இசையே! அமுதே! * அறிவின் பயனே! அரி ஏறே!"],0,"/media/recitation/TVM.5.8.6.mp3"],[3316,3316,["ari ERE! en ampoR suDarE! * sengkaN karu mugilE! *","eriyE! pavaLak kunRE! * nAl thOL endhAy! unadharuLE **","piriyA aDimai ennaik koNDAy! * kuDandhaith thirumAlE! *","thariyEn ini un saraNam thandhu * en sanmam kaLaiyAyE"],["அரி ஏறே! என் அம்பொற் சுடரே! * செங்கண் கரு முகிலே! *","எரியே! பவளக் குன்றே! * நால் தோள் எந்தாய்! உனதருளே **","பிரியா அடிமை என்னைக் கொண்டாய்! * குடந்தைத் திருமாலே! *","தரியேன் இனி உன் சரணம் தந்து * என் சன்மம் களையாயே"],0,"/media/recitation/TVM.5.8.7.mp3"],[3317,3317,["kaLaivAy thunbam kaLaiyAdhu ozhivAy * kaLaikaN maRRilEn *","vaLai vAy nEmip paDaiyAy! * kuDandhaik kiDandha mA mAyA! **","thaLarA uDalam enadhAvi * sarindhu pOm pOdhu *","iLaiyAdhu una thAL orunggap piDiththu * pOdha isai nIyE"],["களைவாய் துன்பம் களையாது ஒழிவாய் * களைகண் மற்றிலேன் *","வளை வாய் நேமிப் படையாய்! * குடந்தைக் கிடந்த மா மாயா! **","தளரா உடலம் எனதாவி * சரிந்து போம் போது *","இளையாது உன தாள் ஒருங்கப் பிடித்து * போத இசை நீயே"],0,"/media/recitation/TVM.5.8.8.mp3"],[3318,3318,["isaiviththu ennai un thAL iNaik kIzh * iruththum ammAnE! *","asaivil amarar thalaivar thalaivA! * Adhip peru mUrththi! **","thisai vil vIsum sezhu mA maNigaL sErum * thirukkuDandhai *","asaivil ulagam paravak kiDandhAy! * kANa vArAyE"],["இசைவித்து என்னை உன் தாள் இணைக் கீழ் * இருத்தும் அம்மானே! *","அசைவில் அமரர் தலைவர் தலைவா! * ஆதிப் பெரு மூர்த்தி! **","திசை வில் வீசும் செழு மா மணிகள் சேரும் * திருக்குடந்தை *","அசைவில் உலகம் பரவக் கிடந்தாய்! * காண வாராயே"],0,"/media/recitation/TVM.5.8.9.mp3"],[3319,3319,["** vArA aruvAy varum en mAyA! * mAyA mUrththiyAy! *","ArA amudhAy aDiyEn Avi * agamE thiththippAy **","thIrA vinaigaL thIra ennai ANDAy! * thirukkuDandhai","UrA! * unakku ATpaTTum * aDiyEn innam uzhalvEnO?"],["** வாரா அருவாய் வரும் என் மாயா! * மாயா மூர்த்தியாய்! *","ஆரா அமுதாய் அடியேன் ஆவி * அகமே தித்திப்பாய் **","தீரா வினைகள் தீர என்னை ஆண்டாய்! * திருக்குடந்தை","ஊரா! * உனக்கு ஆட்பட்டும் * அடியேன் இன்னம் உழல்வேனோ?"],0,"/media/recitation/TVM.5.8.10.mp3"],[3320,3320,["** uzhalai enbin pEychchi mulai UDu * avaLai uyir uNDAn *","kazhalgaL avaiyE saraN Agak koNDa * kurugUrch saDakOpan **","kuzhalin maliyach sonna * Or AyiraththuL ippaththum *","mazhalai thIra vallAr * kAmar mAnEy nOkkiyarkkE"],["** உழலை என்பின் பேய்ச்சி முலை ஊடு * அவளை உயிர் உண்டான் *","கழல்கள் அவையே சரண் ஆகக் கொண்ட * குருகூர்ச் சடகோபன் **","குழலின் மலியச் சொன்ன * ஓர் ஆயிரத்துள் இப்பத்தும் *","மழலை தீர வல்லார் * காமர் மானேய் நோக்கியர்க்கே"],0,"/media/recitation/TVM.5.8.11.mp3"]],[[3321,3321,["** mAnEy nOkku nallIr! * vaigalum vinaiyEn meliya *","vAn Ar vaN kamugum * madhu malligai kamazhum **","thEn Ar sOlaigaL sUzh * thiruvallavAzh uRaiyum","kOnArai * aDiyEn aDi kUDuvadhu enRu kolO?"],["** மானேய் நோக்கு நல்லீர்! * வைகலும் வினையேன் மெலிய *","வான் ஆர் வண் கமுகும் * மது மல்லிகை கமழும் **","தேன் ஆர் சோலைகள் சூழ் * திருவல்லவாழ் உறையும்","கோனாரை * அடியேன் அடி கூடுவது என்று கொலோ?"],0,"/media/recitation/TVM.5.9.1.mp3"],[3322,3322,["enRu kol? thOzhimIrgAL! * emmai nIr nalindhu en seydhIrO? *","pon thigazh punnai magizh * pudhu mAdhavi mIdhu aNavi **","thenRal maNam kamazhum * thiruvallavAzh nagaruL","ninRa pirAn * aDi nIRu aDiyOm koNDu sUDuvadhE"],["என்று கொல்? தோழிமீர்காள்! * எம்மை நீர் நலிந்து என் செய்தீரோ? *","பொன் திகழ் புன்னை மகிழ் * புது மாதவி மீது அணவி **","தென்றல் மணம் கமழும் * திருவல்லவாழ் நகருள்","நின்ற பிரான் * அடி நீறு * அடியோம் கொண்டு சூடுவதே"],0,"/media/recitation/TVM.5.9.2.mp3"],[3323,3323,["sUDu malark kuzhalIr! * thuyarATTiyEnai meliya *","pADu nal vEdha oli * paravaith thirai pOl muzhangga **","mADuyarndhu Omap pugai kamazhum * thaN thiruvallavAzh *","nIDuRaiginRa pirAn * kazhal kANDungkol nichchalumE?"],["சூடு மலர்க் குழலீர்! * துயராட்டியேனை மெலிய *","பாடு நல் வேத ஒலி * பரவைத் திரை போல் முழங்க **","மாடுயர்ந்து ஓமப் புகை கமழும் * தண் திருவல்லவாழ் *","நீடுறைகின்ற பிரான் * கழல் காண்டுங்கொல் நிச்சலுமே?"],0,"/media/recitation/TVM.5.9.3.mp3"],[3324,3324,["nichchalum thOzhimIrgAL! * emmai nIr nalindhu en seydhIrO? *","pachchilai nIL kamugum * palavum thenggum vAzhaigaLum **","machchaNi mADanggaL mIdhu aNavum * thaN thiruvallavAzh *","nachcharavu in aNai mEl * nam pirAnadhu nannalamE"],["நிச்சலும் தோழிமீர்காள்! * எம்மை நீர் நலிந்து என் செய்தீரோ? *","பச்சிலை நீள் கமுகும் * பலவும் தெங்கும் வாழைகளும் **","மச்சணி மாடங்கள் மீது அணவும் * தண் திருவல்லவாழ் *","நச்சரவு இன் அணை மேல் * நம் பிரானது நன்னலமே"],0,"/media/recitation/TVM.5.9.4.mp3"],[3325,3325,["nannalath thOzhimIrgAL! * nalla andhaNar vELvip pugai *","mainnalam koNDu uyar viN maRaikkum * thaN thiruvallavAzh **","kannal angkaTTi thannaik * kaniyai innamudham thannai *","en nalangkoL suDarai * enRu kol kaNgaL kANbadhuvE?"],["நன்னலத் தோழிமீர்காள்! * நல்ல அந்தணர் வேள்விப் புகை *","மைந்நலம் கொண்டு உயர் விண் மறைக்கும் * தண் திருவல்லவாழ் **","கன்னல் அங்கட்டி தன்னைக் * கனியை இன்னமுதம் தன்னை *","என் நலங்கொள் சுடரை * என்று கொல் கண்கள் காண்பதுவே?"],0,"/media/recitation/TVM.5.9.5.mp3"],[3326,3326,["kANbadhu enjnjAnRu kolo? * vinaiyEn kani vAy maDavIr! *","pAN kural vaNDinoDu * pasunthenRalum Agi enggum **","sEN sinai Onggu * marach sezhungkAnal thiruvallavAzh *","mAN kuRaL kOlap pirAn * malarth thAmaraip pAdhanggaLE"],["காண்பது எஞ்ஞான்று கொலொ? * வினையேன் கனி வாய் மடவீர்! *","பாண் குரல் வண்டினொடு * பசுந்தென்றலும் ஆகி எங்கும் **","சேண் சினை ஓங்கு * மரச் செழுங்கானல் திருவல்லவாழ் *","மாண் குறள் கோலப் பிரான் * மலர்த் தாமரைப் பாதங்களே"],0,"/media/recitation/TVM.5.9.6.mp3"],[3327,3327,["pAdhanggaL mEl aNi * pUnthozhak kUDungkol? pAvai nallIr! *","Odha neDunthaDaththuL * uyar thAmarai sengkazhunIr **","mAdhargaL vANmugamum * kaNNum Endhum thiruvallavAzh *","nAdhan injnjAlam uNDa * nam pirAn thannai nALthORumE"],["பாதங்கள் மேல் அணி * பூந்தொழக் கூடுங்கொல்? பாவை நல்லீர்! *","ஓத நெடுந்தடத்துள் * உயர் தாமரை செங்கழுநீர் **","மாதர்கள் வாண்முகமும் * கண்ணும் ஏந்தும் திருவல்லவாழ் *","நாதன் இஞ்ஞாலம் உண்ட * நம் பிரான் தன்னை நாள்தோறுமே"],0,"/media/recitation/TVM.5.9.7.mp3"],[3328,3328,["nADoRum vIDu inRiyE * thozhak kUDungkol? nal nudhalIr! *","ADuRu thIngkarumbum * viLai sennelum Agi enggum **","mADuRu pUnthaDam sEr * vayal sUzh thaN thiruvallavAzh *","nIDuRaiginRa pirAn * nilam thAviya nIL kazhalE"],["நாடொறும் வீடு இன்றியே * தொழக் கூடுங்கொல்? நல் நுதலீர்! *","ஆடுறு தீங்கரும்பும் * விளை செந்நெலும் ஆகி எங்கும் **","மாடுறு பூந்தடம் சேர் * வயல் சூழ் தண் திருவல்லவாழ் *","நீடுறைகின்ற பிரான் * நிலம் தாவிய நீள் கழலே"],0,"/media/recitation/TVM.5.9.8.mp3"],[3329,3329,["kazhal vaLai pUrippa yAm kaNDu * kai thozhak kUDungkolO? *","kuzhal enna yAzhum ennak * kuLir sOlaiyuL thEn arundhi **","mazhalai vari vaNDugaL isai pADum * thiruvallavAzh *","suzhalin mali chakkarap perumAnadhu * thol aruLE"],["கழல் வளை பூரிப்ப யாம் கண்டு * கை தொழக் கூடுங்கொலோ? *","குழல் என்ன யாழும் என்னக் * குளிர் சோலையுள் தேன் அருந்தி **","மழலை வரி வண்டுகள் இசை பாடும் * திருவல்லவாழ் *","சுழலின் மலி சக்கரப் பெருமானது * தொல் அருளே"],0,"/media/recitation/TVM.5.9.9.mp3"],[3330,3330,["thol aruL nal vinaiyAl * solak kUDungkol? thOzhimIrgAL! *","thol aruL maNNum viNNum * thozha ninRa thiru nagaram **","nal aruL Ayiravar * nalan Endhum thiruvallavAzh *","nal aruL nam perumAn * nArAyaNan nAmanggaLE"],["தொல் அருள் நல் வினையால் * சொலக் கூடுங்கொல்? தோழிமீர்காள்! *","தொல் அருள் மண்ணும் விண்ணும் * தொழ நின்ற திரு நகரம் **","நல் அருள் ஆயிரவர் * நலன் ஏந்தும் திருவல்லவாழ் *","நல் அருள் நம் பெருமான் * நாராயணன் நாமங்களே"],0,"/media/recitation/TVM.5.9.10.mp3"],[3331,3331,["** nAmanggaL Ayiram uDaiya * nam perumAn aDi mEl *","sEmangkoL thenkurugUrch * saDakOpan therindhu uraiththa **","nAmanggaL AyiraththuL * ivai paththum thiruvallavAzh *","sEmangkoL thennagar mEl * seppuvAr siRandhAr piRandhE"],["** நாமங்கள் ஆயிரம் உடைய * நம் பெருமான் அடி மேல் *","சேமங்கொள் தென்குருகூர்ச் * சடகோபன் தெரிந்து உரைத்த **","நாமங்கள் ஆயிரத்துள் * இவை பத்தும் திருவல்லவாழ் *","சேமங்கொள் தென்னகர் மேல் * செப்புவார் சிறந்தார் பிறந்தே"],0,"/media/recitation/TVM.5.9.11.mp3"]],[[3332,3332,["** piRandhavARum vaLarndhavARum *","periya bAratham kai seydhu * aivarkkuth","thiRanggaL kATTiyiTTuch *","seydhu pOna mAyanggaLum **","niRandhan UDu pukku enadhAviyai *","ninRu ninRu urukki uNkinRa * ich","chiRandha vAn suDarE! *","unnai enRu kol sErvadhuvE?"],["** பிறந்தவாறும் வளர்ந்தவாறும் *","பெரிய பாரதம் கை செய்து * ஐவர்க்குத்","திறங்கள் காட்டியிட்டுச் *","செய்து போன மாயங்களும் **","நிறந்தன் ஊடு புக்கு எனதாவியை *","நின்று நின்று உருக்கி உண்கின்ற * இச்","சிறந்த வான் சுடரே! *","உன்னை என்று கொல் சேர்வதுவே?"],0,"/media/recitation/TVM.5.10.1.mp3"],[3333,3333,["vadhuvai vArththaiyuL ERu pAyndhadhum *","mAya mAvinai vAy piLandhadhum *","madhuvai vAr kuzhalAr *","kuravai piNaindha kuzhagum **","adhu idhu udhu ennal Avana alla *","ennai un seygai naivikkum *","mudhu vaiya mudhalvA! *","unnai enRu thalaippeyvanE?"],["வதுவை வார்த்தையுள் ஏறு பாய்ந்ததும் *","மாய மாவினை வாய் பிளந்ததும் *","மதுவை வார் குழலார் *","குரவை பிணைந்த குழகும் **","அது இது உது என்னல் ஆவன அல்ல *","என்னை உன் செய்கை நைவிக்கும் *","முது வைய முதல்வா! *","உன்னை என்று தலைப்பெய்வனே?"],0,"/media/recitation/TVM.5.10.2.mp3"],[3334,3334,["peyyum pUngkuzhal pEy mulai uNDa *","piLLaith thERRamum * pErndhu Or sADiRach","seyya pAdham onRAl *","seydha nin siRuch sEvagamum **","ney uN vArththaiyuL annai kOl koLLa *","nI un thAmaraik kaNgaL nIr malga *","paiyavE nilaiyum vandhu *","en nenjchai urukkunggaLE"],["பெய்யும் பூங்குழல் பேய் முலை உண்ட *","பிள்ளைத் தேற்றமும் * பேர்ந்து ஓர் சாடிறச்","செய்ய பாதம் ஒன்றால் *","செய்த நின் சிறுச் சேவகமும் **","நெய் உண் வார்த்தையுள் அன்னை கோல் கொள்ள *","நீ உன் தாமரைக் கண்கள் நீர் மல்க *","பையவே நிலையும் வந்து *","என் நெஞ்சை உருக்குங்களே"],0,"/media/recitation/TVM.5.10.3.mp3"],[3335,3335,["kaLLa vEDaththaik koNDu pOyp * puRam","pukkavARum * kalandhu asurarai","uLLam pEdham seydhiTTu *","uyir uNDa upAyanggaLum **","veLLa nIrch saDaiyAnum * ninniDai vERu alAmai","viLangga ninRadhum *","uLLam uL kuDaindhu * en","uyirai urukki uNNumE"],["கள்ள வேடத்தைக் கொண்டு போய்ப் * புறம்","புக்கவாறும் * கலந்து அசுரரை","உள்ளம் பேதம் செய்திட்டு *","உயிர் உண்ட உபாயங்களும் **","வெள்ள நீர்ச் சடையானும் * நின்னிடை வேறு அலாமை","விளங்க நின்றதும் *","உள்ளம் உள் குடைந்து * என்","உயிரை உருக்கி உண்ணுமே"],0,"/media/recitation/TVM.5.10.4.mp3"],[3336,3336,["uNNa vAnavar kOnukku * Ayar","oruppaDuththa aDisil uNDadhum *","vaNNa mAl varaiyai","eDuththu * mazhai kAththadhum **","maNNai mun paDaiththu uNDu umizhndhu * kaDandhu","iDandhu maNandha mAyanggaL *","eNNum thORum en nenjchu * eri vAy","mezhugu okkum ninRE"],["உண்ண வானவர் கோனுக்கு * ஆயர்","ஒருப்படுத்த அடிசில் உண்டதும் *","வண்ண மால் வரையை","எடுத்து * மழை காத்ததும் **","மண்ணை முன் படைத்து உண்டு உமிழ்ந்து * கடந்து","இடந்து மணந்த மாயங்கள் *","எண்ணும் தோறும் என் நெஞ்சு * எரி வாய்","மெழுகு ஒக்கும் நின்றே"],0,"/media/recitation/TVM.5.10.5.mp3"],[3337,3337,["ninRavARum irundhavARum *","kiDandhavARum ninaippu ariyana *","onRu alA uruvAy * aruvAya","nin mAyanggaL **","ninRu ninRu ninaiginREn * unnai","engnganam ninaikiRpan? * pAviyERku","onRu nanku uraiyAy *","ulagam uNDa oN suDarE!"],["நின்றவாறும் இருந்தவாறும் *","கிடந்தவாறும் நினைப்பு அரியன *","ஒன்று அலா உருவாய் * அருவாய","நின் மாயங்கள் **","நின்று நின்று நினைகின்றேன் * உன்னை","எங்ஙனம் நினைகிற்பன்? * பாவியேற்கு","ஒன்று நன்கு உரையாய் *","உலகம் உண்ட ஒண் சுடரே!"],0,"/media/recitation/TVM.5.10.6.mp3"],[3338,3338,["oN suDarODu iruLumAy ninRavARum *","uNmaiyODu inmaiyAy vandhu * en","kaN koLA vagai * nI karandhu","ennaich seyginRana **","eN koL sindhaiyuL naiginREn * en kariya","mANikkamE! * en kaNgaTkuth","thiN koLLa oru nAL * aruLAy","un thiru uruvE"],["ஒண் சுடரோடு இருளுமாய் நின்றவாறும் *","உண்மையோடு இன்மையாய் வந்து * என்","கண் கொளா வகை * நீ கரந்து","என்னைச் செய்கின்றன **","எண் கொள் சிந்தையுள் நைகின்றேன் * என் கரிய","மாணிக்கமே! * என் கண்கட்குத்","திண் கொள்ள ஒரு நாள் * அருளாய்","உன் திரு உருவே"],0,"/media/recitation/TVM.5.10.7.mp3"],[3339,3339,["thiru uruvu kiDandhavARum * koppUzhch","senthAmarai mEl * thisaimugan","karuvuL vIRRirundhu *","paDaiththiTTa karumanggaLum **","poruvil un thani nAyagam avai kETkum","thORum * en nenjcham ninRu nekku *","aruvi sOrum kaN nIr *","en seygEn aDiyEnE?"],["திரு உருவு கிடந்தவாறும் * கொப்பூழ்ச்","செந்தாமரை மேல் * திசைமுகன்","கருவுள் வீற்றிருந்து *","படைத்திட்ட கருமங்களும் **","பொருவில் உன் தனி நாயகம் அவை * கேட்கும்","தோறும் என் நெஞ்சம் நின்று நெக்கு *","அருவி சோரும் கண் நீர் *","என் செய்கேன் அடியேனே?"],0,"/media/recitation/TVM.5.10.8.mp3"],[3340,3340,["aDiyai mUnRai irandhavARum * anggE ninRu","Azh kaDalum maNNum viNNum","muDiya * IraDiyAl muDiththuk","koNDa * mukkiyamum **","noDiyum ARu avai kETkum thORum * en","nenjcham nin thanakkE karaindhu ugum *","koDiya val vinaiyEn *","unnai enRu kol kUDuvadhE?"],["அடியை மூன்றை இரந்தவாறும் * அங்கே நின்று","ஆழ் கடலும் மண்ணும் விண்ணும்","முடிய * ஈரடியால் முடித்துக்","கொண்ட * முக்கியமும் **","நொடியும் ஆறு அவை கேட்கும் தோறும் * என்","நெஞ்சம் நின் தனக்கே கரைந்து உகும் *","கொடிய வல் வினையேன் *","உன்னை என்று கொல் கூடுவதே?"],0,"/media/recitation/TVM.5.10.9.mp3"],[3341,3341,["kUDi nIraik kaDaindhavARum *","amudham dhEvar uNNa * asurarai","vIDum vaNNanggaLE *","seydhu pOna viththagamum **","UDu pukku enadhAviyai * urukki","uNDiDuginRa * nin thannai","nADum vaNNam sollAy *","nachchu nAgaNaiyAnE!"],["கூடி நீரைக் கடைந்தவாறும் *","அமுதம் தேவர் உண்ண * அசுரரை","வீடும் வண்ணங்களே *","செய்து போன வித்தகமும் **","ஊடு புக்கு எனதாவியை * உருக்கி","உண்டிடுகின்ற * நின் தன்னை","நாடும் வண்ணம் சொல்லாய் *","நச்சு நாகணையானே!"],0,"/media/recitation/TVM.5.10.10.mp3"],[3342,3342,["** nAgaNai misai nam pirAn * charaNE","saraN namakku enRu * nAL thoRum","Eka sindhaiyanAyk *","kurugUrch saDakOpan mARan **","Aga nURRa andhAthi * AyiraththuL","ivaiyum Or paththum vallAr *","mAga vaikundhaththu *","magizhvu eydhuvar vaigalumE"],["** நாகணை மிசை நம் பிரான் * சரணே","சரண் நமக்கு என்று * நாள் தொறும்","ஏக சிந்தையனாய்க் *","குருகூர்ச் சடகோபன் மாறன் **","ஆக நூற்ற அந்தாதி * ஆயிரத்துள்","இவையும் ஓர் பத்தும் வல்லார் *","மாக வைகுந்தத்து *","மகிழ்வு எய்துவர் வைகலுமே"],0,"/media/recitation/TVM.5.10.11.mp3"]]]