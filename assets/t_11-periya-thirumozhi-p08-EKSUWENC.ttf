[[[1448,1448,["** vaNDuNu naRumalar iNDai koNDu * paNDai nam vinai keDa enRu * aDi mEl","thoNDarum amararum paNiya ninRu * anggu aNDamoDu agal iDam aLandhavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["** வண்டுணு நறுமலர் இண்டை கொண்டு * பண்டை","நம் வினை கெட என்று * அடி மேல்","தொண்டரும் அமரரும் பணிய நின்று *","அங்கு அண்டமொடு அகல் இடம் அளந்தவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.1.mp3"],[1449,1449,["aNNal seydhu alai kaDal kaDaindhu * adhanuL kaN nudhal nanjchuNNak kaNDavanE! *","viNNavar amudhuNa amudhil varum * peNNamudhu uNDa emperumAnE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["அண்ணல் செய்து அலை கடல் கடைந்து * அதனுள்","கண் நுதல் நஞ்சுண்ணக் கண்டவனே! *","விண்ணவர் அமுதுண அமுதில் வரும் *","பெண்ணமுது உண்ட எம்பெருமானே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.2.mp3"],[1450,1450,["kuzhal niRa vaNNa! nin kURu koNDa * thazhal niRa vaNNan naNNAr nagaram","vizha * nani malai silai vaLaivu seydhu * anggu azhal niRa ambadhu AnavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["குழல் நிற வண்ண! நின் கூறு கொண்ட *","தழல் நிற வண்ணன் நண்ணார் நகரம்","விழ * நனி மலை சிலை வளைவு செய்து *","அங்கு அழல் நிற அம்பது ஆனவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.3.mp3"],[1451,1451,["nilavŏṭu vĕyil nilavu iru cuṭarum *","ulakamum uyirkal̤um uṇṭu ŏrukāl *","kalai taru kuzhaviyiṉ uruviṉai āy *","alai kaṭal āl ilai val̤arntavaṉe **","āṇṭāy uṉaik kāṇpatu or * arul̤ ĕṉakku arul̤utiyel *","veṇṭeṉ maṉaivāzhkkaiyai * -viṇṇakar meyavaṉe-"],["நிலவொடு வெயில் நிலவு இரு சுடரும் *","உலகமும் உயிர்களும் உண்டு ஒருகால் *","கலை தரு குழவியின் உருவினை ஆய் *","அலை கடல் ஆல் இலை வளர்ந்தவனே **","ஆண்டாய் உனைக் காண்பது ஓர் * அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனைவாழ்க்கையை * விண்ணகர் மேயவனே"],1,"/media/recitation/PT.6.1.4.mp3"],[1452,1452,["pAr ezhu kaDal ezhu malai ezhumAych * sIr kezhum ivvulagu Ezhum ellAm *","Ar kezhu vayiRRinil aDakki ninRu * anggOr ezhuththOr uru AnavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["பார் எழு கடல் எழு மலை எழுமாய்ச் *","சீர் கெழும் இவ்வுலகு ஏழும் எல்லாம் *","ஆர் கெழு வயிற்றினில் அடக்கி நின்று *","அங்கோர் எழுத்தோர் உரு ஆனவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.5.mp3"],[1453,1453,["kAr kezhu kaDalgaLum malaigaLumAy * Er kezhum ulagamum Agi * mudha","lArgaLum aRivaru nilaiyinai Aych * sIr kezhu nAnmaRai AnavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["கார் கெழு கடல்களும் மலைகளுமாய் *","ஏர் கெழும் உலகமும் ஆகி * முத","லார்களும் அறிவரு நிலையினை ஆய்ச் *","சீர் கெழு நான்மறை ஆனவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.6.mp3"],[1454,1454,["urukkuRu naRuney koNDAr azhalil * irukkuRum andhaNar sandhiyin vAy *","perukkamoDu amarargaL amara nalgum * irukkinil innisai AnavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["உருக்குறு நறுநெய் கொண்டார் அழலில் *","இருக்குறும் அந்தணர் சந்தியின் வாய் *","பெருக்கமொடு அமரர்கள் அமர நல்கும் *","இருக்கினில் இன்னிசை ஆனவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.7.mp3"],[1455,1455,["kAdhal seydhu iLaiyavar kalavi tharum * vEdhanai vinai adhu veruvudhalAm *","Adhalin unadhaDi aNuguvan nAn * pOdhalAr neDu muDip puNNiyanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["காதல் செய்து இளையவர் கலவி தரும் *","வேதனை வினை அது வெருவுதலாம் *","ஆதலின் உனதடி அணுகுவன் நான் *","போதலார் நெடு முடிப் புண்ணியனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.8.mp3"],[1456,1456,["sAdhalum piRaththalum enRu ivaRRaik * kAdhal seyyAdhu una kazhal aDaindhEn *","Odhal sey nAnmaRai Agi * umbar Adhal sey mUvuru AnavanE! **","ANDAy! unaik kANbadhOr * aruL enakku aruLudhiyEl *","vENDEn manai vAzhkkaiyai * viNNagar mEyavanE!"],["சாதலும் பிறத்தலும் என்று இவற்றைக் * காதல்","செய்யாது உன கழல் அடைந்தேன் *","ஓதல் செய் நான்மறை ஆகி * உம்பர்","ஆதல் செய் மூவுரு ஆனவனே! **","ஆண்டாய்! உனைக் காண்பதோர் *","அருள் எனக்கு அருளுதியேல் *","வேண்டேன் மனை வாழ்க்கையை *","விண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.1.9.mp3"],[1457,1457,["** pU maru pozhil aNi * viNNagar mEl *","kAmaru sIrk * kali kanRi sonna **","pA maru thamizh ivai * pADa vallAr *","vAmanan aDi iNai * maruvuvarE"],["** பூ மரு பொழில் அணி * விண்ணகர் மேல் *","காமரு சீர்க் * கலி கன்றி சொன்ன **","பா மரு தமிழ் இவை * பாட வல்லார் *","வாமனன் அடி இணை * மருவுவரே"],0,"/media/recitation/PT.6.1.10.mp3"]],[[1458,1458,["** poRuththEn pun sol nenjchil * poruL inbam ena iraNDum","iRuththEn * aimpulangaL kaDanAyina * vAyiloTTi","aRuththEn ** Arvach seRRam avai thannai * manaththu agaRRi","veRuththEn * nin aDaindhEn * thiruviNNagar mEyavanE!"],["** பொறுத்தேன் புன் சொல் நெஞ்சில் * பொருள் இன்பம் என இரண்டும்","இறுத்தேன் * ஐம்புலன்கள் கடனாயின * வாயிலொட்டி","அறுத்தேன் ** ஆர்வச் செற்றம் அவை தன்னை * மனத்து அகற்றி","வெறுத்தேன் * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.1.mp3"],[1459,1459,["maRandhEn unnai munnam * maRandha madhiyin manaththAl *","iRandhEn eththanaiyum * adhanAl iDumbaik kuzhiyil **","piRandhE eyththu ozhindhEn * perumAn! thirumArbA! *","siRandhEn nin aDikkE * thiruviNNagar mEyavanE!"],["மறந்தேன் உன்னை முன்னம் * மறந்த மதியின் மனத்தால் *","இறந்தேன் எத்தனையும் * அதனால் இடும்பைக் குழியில் **","பிறந்தே எய்த்து ஒழிந்தேன் * பெருமான்! திருமார்பா! *","சிறந்தேன் நின் அடிக்கே * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.2.mp3"],[1460,1460,["māṉ ey nokkiyar-tam * vayiṟṟuk kuzhiyil uzhaikkum *","ūṉ ey ākkai-taṉṉai * utavāmai uṇarntu uṇarntu ** -","vāṉe mā nilame * vantu vantu ĕṉ maṉattu irunta","teṉe! * -niṉ aṭainteṉ * -tiruviṇṇakar meyavaṉe-"],["மான் ஏய் நோக்கியர் தம் * வயிற்றுக் குழியில் உழைக்கும் *","ஊன் ஏய் ஆக்கை தன்னை * உதவாமை உணர்ந்து உணர்ந்து **","வானே மா நிலமே * வந்து வந்து என் மனத்து இருந்த","தேனே! * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே"],1,"/media/recitation/PT.6.2.3.mp3"],[1461,1461,["piRindhEn peRRa makkaL * peNDir enRivar pin udhavAdhu","aRindhEn * nI paNiththa aruL ennum * oL vAL uruvi","eRindhEn ** aimpulangaL iDar thIra * eRindhu vandhu","seRindhEn * nin aDikkE * thiruviNNagar mEyavanE!"],["பிறிந்தேன் பெற்ற மக்கள் * பெண்டிர் என்றிவர் பின் உதவாது","அறிந்தேன் * நீ பணித்த அருள் என்னும் * ஒள் வாள் உருவி","எறிந்தேன் ** ஐம்புலன்கள் இடர் தீர * எறிந்து வந்து","செறிந்தேன் * நின் அடிக்கே * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.4.mp3"],[1462,1462,["pAN thEn vaNDaRaiyum kuzhalArgaL * pallANDu isaippa *","ANDAr vaiyam ellAm * arasAgi ** mun ANDavarE","mANDAr enRu vandhAr andhO! * manai vAzhkkai thannai","vENDEn * nin aDaindhEn * thiruviNNagar mEyavanE!"],["பாண் தேன் வண்டறையும் குழலார்கள் * பல்லாண்டு இசைப்ப *","ஆண்டார் வையம் எல்லாம் * அரசாகி ** முன் ஆண்டவரே","மாண்டார் என்று வந்தார் அந்தோ! * மனை வாழ்க்கை தன்னை","வேண்டேன் * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.5.mp3"],[1463,1463,["kallA aimpulangaL avai * kaNDavARu seyya killEn *","mallA! mal amaruL mallar mALa * mal aDarththa","mallA! ** mallal amsIr * madhiL nIr ilanggai azhiththa","villA! * nin aDaindhEn * thiruviNNagar mEyavanE!"],["கல்லா ஐம்புலன்கள் அவை * கண்டவாறு செய்ய கில்லேன் *","மல்லா! மல் அமருள் மல்லர் மாள * மல் அடர்த்த","மல்லா! ** மல்லல் அம்சீர் * மதிள் நீர் இலங்கை அழித்த","வில்லா! * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.6.mp3"],[1464,1464,["vERA yAn irandhEn * veguLAdhu manakkoL endhAy! *","ARA vennaragaththu * aDiyEnai iDak karudhi **","kURA aivar vandhu kumaikkak * kuDi viTTavarai *","thERAdhu un aDaindhEn * thiruviNNagar mEyavanE!"],["வேறா யான் இரந்தேன் * வெகுளாது மனக்கொள் எந்தாய்! *","ஆறா வெந்நரகத்து * அடியேனை இடக் கருதி **","கூறா ஐவர் வந்து குமைக்கக் * குடி விட்டவரை *","தேறாது உன் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.7.mp3"],[1465,1465,["thI vAy valvinaiyAr * uDan ninRu siRandhavar pOl *","mEvA vennaragaththu * iDa uRRu viraindhu vandhAr **","mUvA vAnavar tham mudhalvA! * madhi kOL viDuththa","dhEvA! * nin aDaindhEn * thiruviNNagar mEyavanE!"],["தீ வாய் வல்வினையார் * உடன் நின்று சிறந்தவர் போல் *","மேவா வெந்நரகத்து * இட உற்று விரைந்து வந்தார் **","மூவா வானவர் தம் முதல்வா! * மதி கோள் விடுத்த","தேவா! * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.8.mp3"],[1466,1466,["pOdhAr thAmaraiyAL * pulavik kula vAnavar tham","kOdhA! * kOdhil sengkOl * kuDai mannar iDai naDandha","thUdhA! * thUmozhiyAy! suDar pOl * en manaththu irundha","vEdhA! * nin aDaindhEn * thiruviNNagar mEyavanE!"],["போதார் தாமரையாள் * புலவிக் குல வானவர் தம்","கோதா! * கோதில் செங்கோல் * குடை மன்னர் இடை நடந்த","தூதா! * தூமொழியாய்! சுடர் போல் * என் மனத்து இருந்த","வேதா! * நின் அடைந்தேன் * திருவிண்ணகர் மேயவனே!"],0,"/media/recitation/PT.6.2.9.mp3"],[1467,1467,["** thEn Ar pUm puRavil * thiruviNNagar mEyavanai *","vAn Arum madhiL sUzh * vayal manggaiyar kOn ** maruvAr","Un Ar vEl kaliyan * oli sey thamizh mAlai vallAr *","kOnAy vAnavar tham * koDi mAnagar kUDuvarE"],["** தேன் ஆர் பூம் புறவில் * திருவிண்ணகர் மேயவனை *","வான் ஆரும் மதிள் சூழ் * வயல் மங்கையர் கோன் ** மருவார்","ஊன் ஆர் வேல் கலியன் * ஒலி செய் தமிழ் மாலை வல்லார் *","கோனாய் வானவர் தம் * கொடி மாநகர் கூடுவரே"],0,"/media/recitation/PT.6.2.10.mp3"]],[[1468,1468,["** thuRappEn allEn * inbam thuRavAdhu * nin uruvam","maRappEn allEn * enRum maRavAdhu ** yAn ulagil","piRappEnAga eNNEn * piRavAmaip peRRadhu * nin","thiRaththEn AdhanmaiyAl * thiruviNNagarAnE!"],["** துறப்பேன் அல்லேன் * இன்பம் துறவாது * நின் உருவம்","மறப்பேன் அல்லேன் * என்றும் மறவாது ** யான் உலகில்","பிறப்பேனாக எண்ணேன் * பிறவாமைப் பெற்றது * நின்","திறத்தேன் ஆதன்மையால் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.1.mp3"],[1469,1469,["thuRandhEn Arvach cheRRach * chuRRam thuRandhamaiyAl *","siRandhEn nin aDikkE * aDimai thirumAlE! **","aRam thAnAyth thirivAy! * unnai en manaththagaththE *","thiRambAmal koNDEn * thiruviNNagarAnE!"],["துறந்தேன் ஆர்வச் செற்றச் * சுற்றம் துறந்தமையால் *","சிறந்தேன் நின் அடிக்கே * அடிமை திருமாலே! **","அறம் தானாய்த் திரிவாய்! * உன்னை என் மனத்தகத்தே *","திறம்பாமல் கொண்டேன் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.2.mp3"],[1470,1470,["mAnEy nOkku nallAr * madhi pOl mugaththu ulavum *","UnEy kaN vALikku * uDaindhu OTTandhu un aDaindhEn **","kOnE! kuRungkuDiyuL kuzhagA! * thirunaRaiyUrth","thEnE! * varupunal sUzh * thiruviNNagarAnE!"],["மானேய் நோக்கு நல்லார் * மதி போல் முகத்து உலவும் *","ஊனேய் கண் வாளிக்கு * உடைந்து ஓட்டந்து உன் அடைந்தேன் **","கோனே! குறுங்குடியுள் குழகா! * திருநறையூர்த்","தேனே! * வருபுனல் சூழ் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.3.mp3"],[1471,1471,["sAndhEndhu menmulaiyAr * thaDanthOL puNar inba veLLaththu","AzhndhEn * arunaragaththu azhundhum * payan paDaiththEn **","pOndhEn puNNiyanE! * unnai eydhi en thIvinaigaL","thIrndhEn * nin aDaindhEn * thiruviNNagarAnE!"],["சாந்தேந்து மென்முலையார் * தடந்தோள் புணர் இன்ப வெள்ளத்து","ஆழ்ந்தேன் * அருநரகத்து அழுந்தும் * பயன் படைத்தேன் **","போந்தேன் புண்ணியனே! * உன்னை எய்தி என் தீவினைகள்","தீர்ந்தேன் * நின் அடைந்தேன் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.4.mp3"],[1472,1472,["maRROr dheyvam eNNEn * unnai en manaththu vaiththup","peRREn * peRRadhuvum * piRavAmai emperumAn! **","vaRRA nIL kaDal sUzh * ilanggai irAvaNanaich","cheRRAy! * koRRavanE! * thiruviNNagarAnE!"],["மற்றோர் தெய்வம் எண்ணேன் * உன்னை என் மனத்து வைத்துப்","பெற்றேன் * பெற்றதுவும் * பிறவாமை எம்பெருமான்! **","வற்றா நீள் கடல் சூழ் * இலங்கை இராவணனைச்","செற்றாய்! * கொற்றவனே! * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.5.mp3"],[1473,1473,["mai oNkarungkaDalum * nilanum maNi varaiyum *","seyya suDar iraNDum * ivaiyAya ninnai ** nenjchil","uyyum vagai uNarndhEn * uNmaiyAl ini * yAdhu maRROr","dheyvam piRidhu aRiyEn * thiruviNNagarAnE!"],["மை ஒண்கருங்கடலும் * நிலனும் மணி வரையும் *","செய்ய சுடர் இரண்டும் * இவையாய நின்னை ** நெஞ்சில்","உய்யும் வகை உணர்ந்தேன் * உண்மையால் இனி * யாது மற்றோர்","தெய்வம் பிறிது அறியேன் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.6.mp3"],[1474,1474,["vERE kURuvadhu uNDu * aDiyEn viriththu uraikkum","ARE * nI paNiyAdhu aDai * nin thirumanaththu **","kUREn nenjchu thannAl * guNam koNDu * maRROr dheyvam","thEREn unnai allAl * thiruviNNagarAnE!"],["வேறே கூறுவது உண்டு * அடியேன் விரித்து உரைக்கும்","ஆறே * நீ பணியாது அடை * நின் திருமனத்து **","கூறேன் நெஞ்சு தன்னால் * குணம் கொண்டு * மற்றோர் தெய்வம்","தேறேன் உன்னை அல்லால் * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.7.mp3"],[1475,1475,["muLindhu Indha vengkaDaththu * mUrip perum kaLiRRAl *","viLindhIndha mAmaram pOl * vIzhndhArai ninaiyAdhE **","aLindhu Orndha sindhai * nin pAl aDiyERkku * vAn ulagam","theLindhE enRu eydhuvadhu? * thiruviNNagarAnE!"],["முளிந்து ஈந்த வெங்கடத்து * மூரிப் பெரும் களிற்றால் *","விளிந்தீந்த மாமரம் போல் * வீழ்ந்தாரை நினையாதே **","அளிந்து ஓர்ந்த சிந்தை * நின் பால் அடியேற்க்கு * வான் உலகம்","தெளிந்தே என்று எய்துவது? * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.8.mp3"],[1476,1476,["sollAy thirumArvA! * unakkAgith thoNDu paTTa","nallEnai * vinaigaL naliyAmai * nambu nambI **","mallA! kuDamADi! * madhusUdhanE! * ulagil","sellA nal isaiyAy! * thiruviNNagarAnE!"],["சொல்லாய் திருமார்வா! * உனக்காகித் தொண்டு பட்ட","நல்லேனை * வினைகள் நலியாமை * நம்பு நம்பீ **","மல்லா! குடமாடி! * மதுசூதனே! * உலகில்","செல்லா நல் இசையாய்! * திருவிண்ணகரானே!"],0,"/media/recitation/PT.6.3.9.mp3"],[1477,1477,["** thArAr malark kamalath * thaDam sUzhndha thaN puRavil *","sIrAr neDu maRugil * thiruviNNagarAnai **","kArAr puyal thaDakkaik * kaliyan oli mAlai *","ArAr ivai vallAr * avarkku allal nillAvE"],["** தாரார் மலர்க் கமலத் * தடம் சூழ்ந்த தண் புறவில் *","சீரார் நெடு மறுகில் * திருவிண்ணகரானை **","காரார் புயல் தடக்கைக் * கலியன் ஒலி மாலை *","ஆரார் இவை வல்லார் * அவர்க்கு அல்லல் நில்லாவே"],0,"/media/recitation/PT.6.3.10.mp3"]],[[1478,1478,["** kaNNum suzhanRu * pILaiyODu ILai vandhu EngginAl *","paN inmozhiyAr * paiya naDamin ennAdha mun **","viNNum malaiyum * vEdhamum vELviyum AyinAn *","naNNu naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["** கண்ணும் சுழன்று * பீளையோடு ஈளை வந்து ஏங்கினால் *","பண் இன்மொழியார் * பைய நடமின் என்னாத முன் **","விண்ணும் மலையும் * வேதமும் வேள்வியும் ஆயினான் *","நண்ணு நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.1.mp3"],[1479,1479,["kongguN kuzhalAr * kUDi irundhu siriththu * nIr","inggu en? irumi * empAl vandhadhu enRu igazhAdha mun **","thinggaL eri kAl * senjchuDar Ayavan thEsuDai *","nanggaL naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["கொங்குண் குழலார் * கூடி இருந்து சிரித்து * நீர்","இங்கு என்? இருமி * எம்பால் வந்தது என்று இகழாத முன் **","திங்கள் எரி கால் * செஞ்சுடர் ஆயவன் தேசுடை *","நங்கள் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.2.mp3"],[1480,1480,["konggAr kuzhalAr * kUDi irundhu siriththu * emmai","engkOlam aiyA! * en? inik kANbadhu ennAdha mun **","sengkOl valavan * thAn paNindhu Eththith thigazhum Ur *","nangkOn naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["கொங்கார் குழலார் * கூடி இருந்து சிரித்து * எம்மை","எங்கோலம் ஐயா! * என்? இனிக் காண்பது என்னாத முன் **","செங்கோல் வலவன் * தான் பணிந்து ஏத்தித் திகழும் ஊர் *","நங்கோன் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.3.mp3"],[1481,1481,["kŏmpum aravamum * valliyum vĕṉṟa nuṇ er iṭai *","vampu uṇ kuzhalār * vācal aṭaittu ikazhātamuṉ **","cĕm pŏṉ kamuku-iṉam-tāṉ * kaṉiyum cĕzhum colai cūzh *","nampaṉ naṟaiyūr * nām tŏzhutum ĕzhu nĕñcame-"],["கொம்பும் அரவமும் * வல்லியும் வென்ற நுண் ஏர் இடை *","வம்பு உண் குழலார் * வாசல் அடைத்து இகழாதமுன் **","செம் பொன் கமுகு இனம் தான் * கனியும் செழும் சோலை சூழ் *","நம்பன் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே"],1,"/media/recitation/PT.6.4.4.mp3"],[1482,1482,["vilanggum kayalum * vElum oN kAviyum venRa kaN *","salam koNDa sollAr thAnggaL * siriththu igazhAdha mun **","malanggum varAlum * vALaiyum pAy vayal sUzh tharu *","nalangkoL naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["விலங்கும் கயலும் * வேலும் ஒண் காவியும் வென்ற கண் *","சலம் கொண்ட சொல்லார் தாங்கள் * சிரித்து இகழாத முன் **","மலங்கும் வராலும் * வாளையும் பாய் வயல் சூழ் தரு *","நலங்கொள் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.5.mp3"],[1483,1483,["minnEr iDaiyAr * vETkaiyai mARRi irundhu *","en nIr irumi * empAl vandhadhu? enRu igazhAdha mun **","thonnIr ilanggai malangga * vilanggu eri UTTinAn *","nannIr naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["மின்னேர் இடையார் * வேட்கையை மாற்றி இருந்து *","என் நீர் இருமி * எம்பால் வந்தது? என்று இகழாத முன் **","தொன்னீர் இலங்கை மலங்க * விலங்கு எரி ஊட்டினான் *","நன்னீர் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.6.mp3"],[1484,1484,["vil er nutalār * veṭkaiyai māṟṟic cirittu * ivaṉ","pŏllāṉ tiraintāṉ ĕṉṉum * puṟaṉ -urai keṭpataṉmuṉ **","cŏl ār maṟai nāṉku oti * ulakil nilāyavar *","nallār naṟaiyūr * nām tŏzhutum ĕzhu nĕñcame-"],["வில் ஏர் நுதலார் * வேட்கையை மாற்றிச் சிரித்து * இவன்","பொல்லான் திரைந்தான் என்னும் * புறன் உரை கேட்பதன்முன் **","சொல் ஆர் மறை நான்கு ஓதி * உலகில் நிலாயவர் *","நல்லார் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே"],1,"/media/recitation/PT.6.4.7.mp3"],[1485,1485,["vAL oNkaN nallAr thAnggaL * madhanan enRAr thammai *","kENmingaL ILaiyODu * Enggu kizhavan ennAdha mun **","vELvum vizhavum * vIdhiyil enRum aRAdha Ur *","nALum naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["வாள் ஒண்கண் நல்லார் தாங்கள் * மதனன் என்றார் தம்மை *","கேண்மின்கள் ஈளையோடு * ஏங்கு கிழவன் என்னாத முன் **","வேள்வும் விழவும் * வீதியில் என்றும் அறாத ஊர் *","நாளும் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.8.mp3"],[1486,1486,["kani sErndhu ilanggu nal vAyavar * kAdhanmai viTTiDa *","kuni sErndhu uDalam * kOlil thaLarndhu iLaiyAdha mun **","pani sEr visumbil * pAl madhi kOL viDuththAn iDam *","nani sEr naRaiyUr * nAm thozhudhum ezhu nenjchamE!"],["கனி சேர்ந்து இலங்கு நல் வாயவர் * காதன்மை விட்டிட *","குனி சேர்ந்து உடலம் * கோலில் தளர்ந்து இளையாத முன் **","பனி சேர் விசும்பில் * பால் மதி கோள் விடுத்தான் இடம் *","நனி சேர் நறையூர் * நாம் தொழுதும் எழு நெஞ்சமே!"],0,"/media/recitation/PT.6.4.9.mp3"],[1487,1487,["** piRai sEr nudhalAr * pENudhal nammai ilAdha mun *","naRai sEr pozhil sUzh * naRaiyUr thozhu nenjchamE! enRa **","kaRaiyAr neDuvEl manggaiyar kOn * kalikanRi sol *","maRavAdhu uraippavar * vAnavarkku innarasu AvarE"],["** பிறை சேர் நுதலார் * பேணுதல் நம்மை இலாத முன் *","நறை சேர் பொழில் சூழ் * நறையூர் தொழு நெஞ்சமே! என்ற **","கறையார் நெடுவேல் மங்கையர் கோன் * கலிகன்றி சொல் *","மறவாது உரைப்பவர் * வானவர்க்கு இன்னரசு ஆவரே"],0,"/media/recitation/PT.6.4.10.mp3"]],[[1488,1488,["** kalangga munnIr kaDaindhu * amudham koNDu * imaiyOr","thuLanggal thIra * nalgu sOdhich suDar Aya **","valangkai Azhi iDangkaich sanggam * uDaiyAn Ur *","nalangkoL vAymai * andhaNar vAzhum naRaiyUrE"],["** கலங்க முந்நீர் கடைந்து * அமுதம் கொண்டு * இமையோர்","துளங்கல் தீர * நல்கு சோதிச் சுடர் ஆய **","வலங்கை ஆழி இடங்கைச் சங்கம் * உடையான் ஊர் *","நலங்கொள் வாய்மை * அந்தணர் வாழும் நறையூரே"],0,"/media/recitation/PT.6.5.1.mp3"],[1489,1489,["munai Ar sIyam Agi * avuNan muraN mArvam *","punai vAL ugirAl * pOzhpaDa Irndha punidhan Ur **","sinai Ar thE mAm * chenthaLir kOdhik kuyil kUvum *","nanai Ar sOlai sUzhndhu * azhagAya naRaiyUrE"],["முனை ஆர் சீயம் ஆகி * அவுணன் முரண் மார்வம் *","புனை வாள் உகிரால் * போழ்பட ஈர்ந்த புனிதன் ஊர் **","சினை ஆர் தே மாம் * செந்தளிர் கோதிக் குயில் கூவும் *","நனை ஆர் சோலை சூழ்ந்து * அழகாய நறையூரே"],0,"/media/recitation/PT.6.5.2.mp3"],[1490,1490,["Anaip puravith * thEroDu kAlAL aNi koNDa *","sEnaith thogaiyaich sADi * ilanggai seRRAn Ur **","mInaith thazhuvi vIzhndhu ezhum * maLLarkku alamandhu *","nAnap pudhalil * Amai oLikkum naRaiyUrE"],["ஆனைப் புரவித் * தேரொடு காலாள் அணி கொண்ட *","சேனைத் தொகையைச் சாடி * இலங்கை செற்றான் ஊர் **","மீனைத் தழுவி வீழ்ந்து எழும் * மள்ளர்க்கு அலமந்து *","நானப் புதலில் * ஆமை ஒளிக்கும் நறையூரே"],0,"/media/recitation/PT.6.5.3.mp3"],[1491,1491,["uRiyAr veNNey uNDu * uralODum kaTTuNDu *","veRiyAr kUndhal * pinnai poruTTu An venRAn Ur **","poRiyAr manjnjai * pUmpozhil thORum naDam ADa *","naRu nANmalar mEl * vaNDu isai pADum naRaiyUrE"],["உறியார் வெண்ணெய் உண்டு * உரலோடும் கட்டுண்டு *","வெறியார் கூந்தல் * பின்னை பொருட்டு ஆன் வென்றான் ஊர் **","பொறியார் மஞ்ஞை * பூம்பொழில் தோறும் நடம் ஆட *","நறு நாண்மலர் மேல் * வண்டு இசை பாடும் நறையூரே"],0,"/media/recitation/PT.6.5.4.mp3"],[1492,1492,["viDai Ezh venRu * menthOL Aychchikku anbanAy *","naDaiyAl ninRa * marudham sAyththa nAdhan Ur **","peDaiyODu annam * peyvaLaiyAr tham pin senRu *","naDaiyODu iyali * nANi oLikkum naRaiyUrE"],["விடை ஏழ் வென்று * மென்தோள் ஆய்ச்சிக்கு அன்பனாய் *","நடையால் நின்ற * மருதம் சாய்த்த நாதன் ஊர் **","பெடையோடு அன்னம் * பெய்வளையார் தம் பின் சென்று *","நடையோடு இயலி * நாணி ஒளிக்கும் நறையூரே"],0,"/media/recitation/PT.6.5.5.mp3"],[1493,1493,["pagu vAy vanpEy * konggai suvaiththu Aruyir uNDu *","pugu vAy ninRa * pOdhagam vIzhap porudhAn Ur **","negu vAy neydhal * pU madhu mAndhik kamalaththin *","nagu vAy malar mEl * annam uRanggum naRaiyUrE"],["பகு வாய் வன்பேய் * கொங்கை சுவைத்து ஆருயிர் உண்டு *","புகு வாய் நின்ற * போதகம் வீழப் பொருதான் ஊர் **","நெகு வாய் நெய்தல் * பூ மது மாந்திக் கமலத்தின் *","நகு வாய் மலர் மேல் * அன்னம் உறங்கும் நறையூரே"],0,"/media/recitation/PT.6.5.6.mp3"],[1494,1494,["mundhu nUlum muppuri nUlum * mun Indha *","andhaNALan piLLaiyai * anjnjAnRu aLiththAn Ur **","pondhil vAzhum piLLaikkAgip * puL ODi *","nandhu vArum * paimpunal vAvi naRaiyUrE"],["முந்து நூலும் முப்புரி நூலும் * முன் ஈந்த *","அந்தணாளன் பிள்ளையை * அஞ்ஞான்று அளித்தான் ஊர் **","பொந்தில் வாழும் பிள்ளைக்காகிப் * புள் ஓடி *","நந்து வாரும் * பைம்புனல் வாவி நறையூரே"],0,"/media/recitation/PT.6.5.7.mp3"],[1495,1495,["veLLaip puravith thEr * visayaRkAy viRal viyUgam","viLLa * sindhuk kOn vizha * Urndha vimalan Ur **","koLLaik kozhu mIn uN * kurugu ODip peDaiyODum *","naLLak kamalath * thERal ugukkum naRaiyUrE"],["வெள்ளைப் புரவித் தேர் * விசயற்காய் விறல் வியூகம்","விள்ள * சிந்துக் கோன் விழ* ஊர்ந்த விமலன் ஊர் **","கொள்ளைக் கொழு மீன் உண் * குருகு ஓடிப் பெடையோடும் *","நள்ளக் கமலத் * தேறல் உகுக்கும் நறையூரே"],0,"/media/recitation/PT.6.5.8.mp3"],[1496,1496,["** pArai Urum pAram thIrap * pArththan than *","thErai Urum * dhEva dhEvan sErum Ur **","thArai Urum * thaNthaLir vEli puDai sUzha *","nArai Urum * nal vayal sUzhndha naRaiyUrE"],["** பாரை ஊரும் பாரம் தீரப் * பார்த்தன் தன் *","தேரை ஊரும் * தேவ தேவன் சேரும் ஊர் **","தாரை ஊரும் * தண்தளிர் வேலி புடை சூழ *","நாரை ஊரும் * நல் வயல் சூழ்ந்த நறையூரே"],0,"/media/recitation/PT.6.5.9.mp3"],[1497,1497,["** thAmath thuLaba * nIL muDi mAyan thAn ninRa *","nAmath thiraL mAmALigai sUzhndha * naRaiyUr mEl **","kAmak kadhir vEl vallAn * kaliyan oli mAlai *","sEmath thuNaiyAm * seppum avarkkuth thirumAlE"],["** தாமத் துளப * நீள் முடி மாயன் தான் நின்ற *","நாமத் திரள் மாமாளிகை சூழ்ந்த * நறையூர் மேல் **","காமக் கதிர் வேல் வல்லான் * கலியன் ஒலி மாலை *","சேமத் துணையாம் * செப்பும் அவர்க்குத் திருமாலே"],0,"/media/recitation/PT.6.5.10.mp3"]],[[1498,1498,["** ambaramum perunilanum thisaigaL eTTum *","alaikaDalum kulavaraiyum uNDa kaNDan *","kombamarum vaTa maraththin ilai mEl * paLLi","kUDinAn thiruvaDiyE kUDa kiRpIr! **","vambavizhum seNbagaththin vAsam uNDu *","maNivaNDu vaguLaththin malar mEl vaigu *","sembiyan kOchchengkaNAn sErndha kOyil *","thirunaRaiyUr maNimADam sErminkaLE"],["** அம்பரமும் பெருநிலனும் திசைகள் எட்டும் *","அலைகடலும் குலவரையும் உண்ட கண்டன் *","கொம்பமரும் வட மரத்தின் இலை மேல் * பள்ளி","கூடினான் திருவடியே கூட கிற்பீர்! **","வம்பவிழும் செண்பகத்தின் வாசம் உண்டு *","மணிவண்டு வகுளத்தின் மலர் மேல் வைகு *","செம்பியன் கோச்செங்கணான் சேர்ந்த கோயில் *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.1.m4a"],[1499,1499,["kozhungkayalAy neDu veLLam koNDa kAlam *","kulavaraiyin mIdhODi aNDaththu appAl *","ezhundhu inidhu viLaiyADum Isan endhai *","iNaiyaDik kIzh inidhu iruppIr! inavaNDAlum **","uzhum seRuvil maNi koNarndhu karai mEl sindhi *","ulagellAm sandhanamum agilum koLLa *","sezhum ponni vaLam koDukkum sOzhan sErndha *","thirunaRaiyUr maNimADam sErmingaLE"],["கொழுங்கயலாய் நெடு வெள்ளம் கொண்ட காலம் *","குலவரையின் மீதோடி அண்டத்து அப்பால் *","எழுந்து இனிது விளையாடும் ஈசன் எந்தை *","இணையடிக் கீழ் இனிது இருப்பீர்! இனவண்டாலும் **","உழும் செறுவில் மணி கொணர்ந்து கரை மேல் சிந்தி *","உலகெல்லாம் சந்தனமும் அகிலும் கொள்ள *","செழும் பொன்னி வளம் கொடுக்கும் சோழன் சேர்ந்த *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.2.mp3"],[1500,1500,["pavva nIr uDai ADaiyAgach suRRip *","pAr agalam thiruvaDiyAp pavanam meyyA *","sevvi mAdhiram eTTum thOLA * aNDam","thirumuDiyA ninRAn pAl sella kiRpIr **","kavvai mAkaLiRu undhi veNNiyERRak *","kazhal mannar maNi muDi mEl kAgam ERa *","dheyva vAL valam koNDa sOzhan sErndha *","thirunaRaiyUr maNimADam sErmingaLE"],["பவ்வ நீர் உடை ஆடையாகச் சுற்றிப் *","பார் அகலம் திருவடியாப் பவனம் மெய்யா *","செவ்வி மாதிரம் எட்டும் தோளா * அண்டம்","திருமுடியா நின்றான் பால் செல்ல கிற்பீர் **","கவ்வை மாகளிறு உந்தி வெண்ணியேற்றக் *","கழல் மன்னர் மணி முடி மேல் காகம் ஏற *","தெய்வ வாள் வலம் கொண்ட சோழன் சேர்ந்த *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.3.mp3"],[1501,1501,["paingkaN AL ari uruvAy veruva nOkkip *","paruvaraith thOL iraNiyanaip paRRi vAnggi *","anggai vAL ugir nudhiyAl avanadhu Agam *","angkurudhi pongguviththAn aDik kIzh niRpIr! **","vengkaN mAkaLiRu undhi veNNiyERRa *","viRal mannar thiRal azhiya vemmA uyththa *","sengkaNAn kOchchOzhan sErndha kOyil *","thirunaRaiyUr maNimADam sErmingaLE"],["பைங்கண் ஆள் அரி உருவாய் வெருவ நோக்கிப் *","பருவரைத் தோள் இரணியனைப் பற்றி வாங்கி *","அங்கை வாள் உகிர் நுதியால் அவனது ஆகம் *","அங்குருதி பொங்குவித்தான் அடிக் கீழ் நிற்பீர்! **","வெங்கண் மாகளிறு உந்தி வெண்ணியேற்ற *","விறல் மன்னர் திறல் அழிய வெம்மா உய்த்த *","செங்கணான் கோச்சோழன் சேர்ந்த கோயில் *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.4.mp3"],[1502,1502,["anRu ulaga mUnRinaiyum aLandhu * vEROr","ari uruvAy iraNiyanadhu Agam kINDu *","venRu avanai viNNulagil sela uyththARku *","virundhAvIr! mEl ezhundhu vilanggal pAyndhu **","pon sidhaRi maNi koNarndhu karai mEl sindhip *","pulam parandhu nilam parakkum ponni nADan *","then thamizhan vaDa pulak kOn chOzhan sErndha *","thirunaRaiyUr maNimADam sErmingaLE"],["அன்று உலக மூன்றினையும் அளந்து * வேறோர்","அரி உருவாய் இரணியனது ஆகம் கீண்டு *","வென்று அவனை விண்ணுலகில் செல உய்த்தாற்கு *","விருந்தாவீர்! மேல் எழுந்து விலங்கல் பாய்ந்து **","பொன் சிதறி மணி கொணர்ந்து கரை மேல் சிந்திப் *","புலம் பரந்து நிலம் பரக்கும் பொன்னி நாடன் *","தென் தமிழன் வட புலக் கோன் சோழன் சேர்ந்த *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.5.mp3"],[1503,1503,["taṉṉāle taṉ uruvam payanta tāṉ āy *","tayaṅku ŏl̤i cer mūvulakum tāṉ āy vāṉ āy *","taṉṉāle taṉ uruviṉ mūrtti mūṉṟu āy *","tāṉ āyaṉ āyiṉāṉ caraṇ ĕṉṟu uyvīr **","miṉ āṭu vel entu vil̤ainta vel̤ai *","viṇ eṟat taṉi vel uyttu ulakam āṇṭa *","tĕṉ nāṭaṉ kuṭa kŏṅkaṉ cozhaṉ cernta *","tirunaṟaiyūr maṇimāṭam cermiṉkal̤e-"],["தன்னாலே தன் உருவம் பயந்த தான் ஆய் *","தயங்கு ஒளி சேர் மூவுலகும் தான் ஆய் வான் ஆய் *","தன்னாலே தன் உருவின் மூர்த்தி மூன்று ஆய் *","தான் ஆயன் ஆயினான் சரண் என்று உய்வீர் **","மின் ஆடு வேல் ஏந்து விளைந்த வேளை *","விண் ஏறத் தனி வேல் உய்த்து உலகம் ஆண்ட *","தென் நாடன் குட கொங்கன் சோழன் சேர்ந்த *","திருநறையூர் மணிமாடம் சேர்மின்களே"],1,"/media/recitation/PT.6.6.6.mp3"],[1504,1504,["mulaith thaDaththa nanjchuNDu thunjchap pEychchi *","mudhu thuvaraik kulapadhiyAk kAlip pinnE *","ilaith thaDaththa kuzhal Udhi Ayar mAdhar *","ina vaLai koNDAn aDik kIzh eydha kiRpIr! **","malaith thaDaththa maNi koNarndhu vaiyam uyya *","vaLam koDukkum varu punal amponni nADan *","silaith thaDakkaik kulach chOzhan sErndha kOyil *","thirunaRaiyUr maNimADam sErmingaLE"],["முலைத் தடத்த நஞ்சுண்டு துஞ்சப் பேய்ச்சி *","முது துவரைக் குலபதியாக் காலிப் பின்னே *","இலைத் தடத்த குழல் ஊதி ஆயர் மாதர் *","இன வளை கொண்டான் அடிக் கீழ் எய்த கிற்பீர்! **","மலைத் தடத்த மணி கொணர்ந்து வையம் உய்ய *","வளம் கொடுக்கும் வரு புனல் அம்பொன்னி நாடன் *","சிலைத் தடக்கைக் குலச் சோழன் சேர்ந்த கோயில் *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.7.m4a"],[1505,1505,["murukku ilanggu kanith thuvar vAyp pinnai kELvan *","man ellAm mun aviyach senRu * venRich","seruk kaLaththuth thiRal azhiyach seRRa vEndhan *","siram thuNiththAn thiruvaDi num senni vaippIr! **","irukkilanggu thirumozhi vAy eNthOL IsaRku *","ezhil mADam ezhupadhu seydhu ulagam ANDa *","thirukkulaththu vaLach chOzhan sErndha kOyil *","thirunaRaiyUr maNimADam sErmingaLE"],["முருக்கு இலங்கு கனித் துவர் வாய்ப் பின்னை கேள்வன் *","மன் எல்லாம் முன் அவியச் சென்று * வென்றிச்","செருக் களத்துத் திறல் அழியச் செற்ற வேந்தன் *","சிரம் துணித்தான் திருவடி நும் சென்னி வைப்பீர்! **","இருக்கிலங்கு திருமொழி வாய் எண்தோள் ஈசற்கு *","எழில் மாடம் எழுபது செய்து உலகம் ஆண்ட *","திருக்குலத்து வளச் சோழன் சேர்ந்த கோயில் *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.8.mp3"],[1506,1506,["thArALan thaNNarangga vALan * pU mEl","thani ALan muniyALar Eththa ninRa","pErALan * Ayiram pEr uDaiya ALan *","pinnaikku maNavALan perumai kETpIr! **","pArALar avar ivar enRu azhundhai ERRa *","paDai mannar uDal thuNiyap parimA uyththa *","thErALan kOchchOzhan sErndha kOyil *","thirunaRaiyUr maNimADam sErmingaLE"],["தாராளன் தண்ணரங்க வாளன் * பூ மேல்","தனி ஆளன் முனியாளர் ஏத்த நின்ற","பேராளன் * ஆயிரம் பேர் உடைய ஆளன் *","பின்னைக்கு மணவாளன் பெருமை கேட்பீர்! **","பாராளர் அவர் இவர் என்று அழுந்தை ஏற்ற *","படை மன்னர் உடல் துணியப் பரிமா உய்த்த *","தேராளன் கோச்சோழன் சேர்ந்த கோயில் *","திருநறையூர் மணிமாடம் சேர்மின்களே"],0,"/media/recitation/PT.6.6.9.mp3"],[1507,1507,["** semmozhi vAy nAl vEdha vANar vAzhum *","thirunaRaiyUr maNimADach sengkaNmAlai *","poymmozhi onRillAdha meymmai ALan *","pula manggaik kula vEndhan pulamai Arndha **","ammozhi vAyk kalikanRi inbap pADal *","pADuvAr viyan ulagil namanAr pADi *","vemmozhi kETTu anjchAdhE meymmai sollil *","viNNavarkku virundhAgum perunthakkOrE"],["** செம்மொழி வாய் நால் வேத வாணர் வாழும் *","திருநறையூர் மணிமாடச் செங்கண்மாலை *","பொய்ம்மொழி ஒன்றில்லாத மெய்ம்மை ஆளன் *","புல மங்கைக் குல வேந்தன் புலமை ஆர்ந்த **","அம்மொழி வாய்க் கலிகன்றி இன்பப் பாடல் *","பாடுவார் வியன் உலகில் நமனார் பாடி *","வெம்மொழி கேட்டு அஞ்சாதே மெய்ம்மை சொல்லில் *","விண்ணவர்க்கு விருந்தாகும் பெருந்தக்கோரே"],0,"/media/recitation/PT.6.6.10.m4a"]],[[1508,1508,["** ALum paNiyum aDiyEnaik koNDAn * viNDa nisAsararai *","thOLum thalaiyum thuNivu eydhach * suDu venjchilai vAych saram thurandhAn **","vELum sEyum anaiyArum * vERkaNArum payil vIdhi *","nALum vizhavin oli OvA * naRaiyUr ninRa nambiyE"],["** ஆளும் பணியும் அடியேனைக் கொண்டான் * விண்ட நிசாசரரை *","தோளும் தலையும் துணிவு எய்தச் * சுடு வெஞ்சிலை வாய்ச் சரம் துரந்தான் **","வேளும் சேயும் அனையாரும் * வேற்கணாரும் பயில் வீதி *","நாளும் விழவின் ஒலி ஓவா * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.1.mp3"],[1509,1509,["muniyAy vandhu mUvezhukAl * muDi sEr mannar uDal thuNiya *","thani vAy mazhuvin paDai ANDa * thArAr thOLAn vArpuRavil **","pani sEr mullai pal arumbap * pAnal orupAl kaN kATTa *","nani sEr kamalam mugam kATTum * naRaiyUr ninRa nambiyE"],["முனியாய் வந்து மூவெழுகால் * முடி சேர் மன்னர் உடல் துணிய *","தனி வாய் மழுவின் படை ஆண்ட * தாரார் தோளான் வார்புறவில் **","பனி சேர் முல்லை பல் அரும்பப் * பானல் ஒருபால் கண் காட்ட *","நனி சேர் கமலம் முகம் காட்டும் * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.2.mp3"],[1510,1510,["tĕl̤ ār kaṭalvāy viṭa vāya *","ciṉa vāl̤ aravil tuyil amarntu *","tul̤l̤ā varu māṉ vizha vāl̤i","turantāṉ * irantāṉ māvali maṇ ** -","pul̤ ār puṟavil pūṅ kāvi *","pulaṅkŏl̤ mātar kaṇ kāṭṭa *","nal̤ ār kamalam mukam kāṭṭum *","naṟaiyūr niṉṟa nampiye-"],["தெள் ஆர் கடல்வாய் விட வாய *","சின வாள் அரவில் துயில் அமர்ந்து *","துள்ளா வரு மான் விழ வாளி","துரந்தான் * இரந்தான் மாவலி மண் **","புள் ஆர் புறவில் பூங் காவி *","புலங்கொள் மாதர் கண் காட்ட *","நள் ஆர் கமலம் முகம் காட்டும் *","நறையூர் நின்ற நம்பியே"],1,"/media/recitation/PT.6.7.3.mp3"],[1511,1511,["OLiyA veNNey uNDAn enRu * uralODu Aychchi oNkayiRRAl *","viLiyA Arkka AppuNDu * vimmi azhudhAn menmalar mEl **","kaLiyA vaNDu kaL uNNak * kAmar thenRal alar thURRa *","naLir vAy mullai muRuvalikkum * naRaiyUr ninRa nambiyE"],["ஓளியா வெண்ணெய் உண்டான் என்று * உரலோடு ஆய்ச்சி ஒண்கயிற்றால் *","விளியா ஆர்க்க ஆப்புண்டு * விம்மி அழுதான் மென்மலர் மேல் **","களியா வண்டு கள் உண்ணக் * காமர் தென்றல் அலர் தூற்ற *","நளிர் வாய் முல்லை முறுவலிக்கும் * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.4.m4a"],[1512,1512,["villAr vizhavil vaDamadhurai * virumbi virumbA mal aDarththu *","kallAr thiraL thOL kanjchanaik kAyndhAn * pAyndhAn kALiyan mEl **","sollAr surudhi muRai Odhich * sOmuch cheyyum thozhilinOr *","nallAr maRaiyOr palar vAzhum * naRaiyUr ninRa nambiyE"],["வில்லார் விழவில் வடமதுரை * விரும்பி விரும்பா மல் அடர்த்து *","கல்லார் திரள் தோள் கஞ்சனைக் காய்ந்தான் * பாய்ந்தான் காளியன் மேல் **","சொல்லார் சுருதி முறை ஓதிச் * சோமுச் செய்யும் தொழிலினோர் *","நல்லார் மறையோர் பலர் வாழும் * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.5.m4a"],[1513,1513,["vaLLi kozhunan mudhalAya * makkaLODu mukkaNAn","veLgi ODa * viRal vANan * viyan thOL vanaththaith thuNiththu ugandhAn **","paLLi kamalaththiDaip paTTa * pagu vAy alavan mugam nOkki *","naLLi UDum vayal sUzhndha * naRaiyUr ninRa nambiyE"],["வள்ளி கொழுனன் முதலாய * மக்களோடு முக்கணான்","வெள்கி ஓட * விறல் வாணன் * வியன் தோள் வனத்தைத் துணித்து உகந்தான் **","பள்ளி கமலத்திடைப் பட்ட * பகு வாய் அலவன் முகம் நோக்கி *","நள்ளி ஊடும் வயல் சூழ்ந்த * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.6.m4a"],[1514,1514,["miDaiyA vandha vEl mannar vIya * visayan thEr kaDavi *","kuDaiyA varai onRu eDuththu Ayar kOvAy ninRAn * kUr Azhip","paDaiyAn ** vEdham nAnku aindhu vELvi * anggam ARu isai Ezh *","naDaiyA valla andhaNar vAzh * naRaiyUr ninRa nambiyE"],["மிடையா வந்த வேல் மன்னர் வீய * விசயன் தேர் கடவி *","குடையா வரை ஒன்று எடுத்து ஆயர் கோவாய் நின்றான் * கூர் ஆழிப்","படையான் ** வேதம் நான்கு ஐந்து வேள்வி * அங்கம் ஆறு இசை ஏழ் *","நடையா வல்ல அந்தணர் வாழ் * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.7.mp3"],[1515,1515,["pandhAr viralAL pAnjchAli * kUndhal muDikkap pAradhaththu *","kandhAr kaLiRRuk kazhal mannar kalanggach * sanggam vAy vaiththAn **","senthAmarai mEl ayanODu * sivanum anaiya perumaiyOr *","nandhA vaNkai maRaiyOr vAzh * naRaiyUr ninRa nambiyE"],["பந்தார் விரலாள் பாஞ்சாலி * கூந்தல் முடிக்கப் பாரதத்து *","கந்தார் களிற்றுக் கழல் மன்னர் கலங்கச் * சங்கம் வாய் வைத்தான் **","செந்தாமரை மேல் அயனோடு * சிவனும் அனைய பெருமையோர் *","நந்தா வண்கை மறையோர் வாழ் * நறையூர் நின்ற நம்பியே"],0,"/media/recitation/PT.6.7.8.m4a"],[1516,1516,["āṟum piṟaiyum aravamum *","aṭampum caṭaimel aṇintu * uṭalam","nīṟum pūci eṟu ūrum *","iṟaiyoṉ cĕṉṟu kuṟai irappa **","māṟu ŏṉṟu illā vāca nīr *","varai mārvu akalattu al̤ittu ukantāṉ * -","nāṟum pŏzhil cūzhntu azhaku āya *","naṟaiyūr niṉṟa nampiye-"],["ஆறும் பிறையும் அரவமும் *","அடம்பும் சடைமேல் அணிந்து * உடலம்","நீறும் பூசி ஏறு ஊரும் *","இறையோன் சென்று குறை இரப்ப **","மாறு ஒன்று இல்லா வாச நீர் *","வரை மார்வு அகலத்து அளித்து உகந்தான் *","நாறும் பொழில் சூழ்ந்து அழகு ஆய *","நறையூர் நின்ற நம்பியே"],1,"/media/recitation/PT.6.7.9.m4a"],[1517,1517,["** nanmai uDaiya maRaiyOr vAzh * naRaiyUr ninRa nambiyai *","kanni madhiL sUzh vayal manggaik * kaliyan oli sey thamizh mAlai **","panni ulagil pADuvAr * pADu sArA pazha vinaigaL *","manni ulagam ANDu pOy * vAnOr vaNangga vAzhvArE"],["** நன்மை உடைய மறையோர் வாழ் * நறையூர் நின்ற நம்பியை *","கன்னி மதிள் சூழ் வயல் மங்கைக் * கலியன் ஒலி செய் தமிழ் மாலை **","பன்னி உலகில் பாடுவார் * பாடு சாரா பழ வினைகள் *","மன்னி உலகம் ஆண்டு போய் * வானோர் வணங்க வாழ்வாரே"],0,"/media/recitation/PT.6.7.10.mp3"]],[[1518,1518,["** mAn koNDa thOl * mArvil mANiyAy * mAvali maN","thAn koNDu * thALAl aLandha perumAnai **","thEn koNDa sAral * thiruvEngkaDaththAnai *","nAn senRu nADi * naRaiyUril kaNDEnE"],["** மான் கொண்ட தோல் * மார்வில் மாணியாய் * மாவலி மண்","தான் கொண்டு * தாளால் அளந்த பெருமானை **","தேன் கொண்ட சாரல் * திருவேங்கடத்தானை *","நான் சென்று நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.1.mp3"],[1519,1519,["munnIrai munnAL * kaDaindhAnai * mUzhththa nAL","annIrai mInAy * amaiththa perumAnai **","thennAli mEya * thirumAlai emmAnai *","nannIr vayal sUzh * naRaiyUril kaNDEnE"],["முந்நீரை முன்னாள் * கடைந்தானை * மூழ்த்த நாள்","அந்நீரை மீனாய் * அமைத்த பெருமானை **","தென்னாலி மேய * திருமாலை எம்மானை *","நன்னீர் வயல் சூழ் * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.2.m4a"],[1520,1520,["thU vAya puL Urndhu * vandhu thuRai vEzham *","mUvAmai nalgi * mudhalai thuNiththAnai **","dhEvAdhi dhEvanaich * sengkamalak kaNNAnai *","nAvAy uLAnai * naRaiyUril kaNDEnE"],["தூ வாய புள் ஊர்ந்து * வந்து துறை வேழம் *","மூவாமை நல்கி * முதலை துணித்தானை **","தேவாதி தேவனைச் * செங்கமலக் கண்ணானை *","நாவாய் உளானை * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.3.mp3"],[1521,1521,["ODA ariyAy * iraNiyanai Un iDandha *","sEDAr pozhil sUzh * thirunIrmalaiyAnai **","vADA malarth thuzhAy * mAlai muDiyAnai *","nALthORum nADi * naRaiyUril kaNDEnE"],["ஓடா அரியாய் * இரணியனை ஊன் இடந்த *","சேடார் பொழில் சூழ் * திருநீர்மலையானை **","வாடா மலர்த் துழாய் * மாலை முடியானை *","நாள்தோறும் நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.4.mp3"],[1522,1522,["kallAr madhiL sUzh * kaDi ilanggaik kAr arakkan *","vallAgam kILa * vari venjcharam thurandha","villAnai ** selva vibIDaNaRku * vERAga *","nallAnai nADi * naRaiyUril kaNDEnE"],["கல்லார் மதிள் சூழ் * கடி இலங்கைக் கார் அரக்கன் *","வல்லாகம் கீள * வரி வெஞ்சரம் துரந்த","வில்லானை ** செல்வ விபீடணற்கு * வேறாக *","நல்லானை நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.5.mp3"],[1523,1523,["umbar ulagODu * uyir ellAm undhiyil *","vambu malar mEl * paDaiththAnai mAyOnai **","ambu anna kaNNAL * asOdhai than singgaththai *","nambanai nADi * naRaiyUril kaNDEnE"],["உம்பர் உலகோடு * உயிர் எல்லாம் உந்தியில் *","வம்பு மலர் மேல் * படைத்தானை மாயோனை **","அம்பு அன்ன கண்ணாள் * அசோதை தன் சிங்கத்தை *","நம்பனை நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.6.mp3"],[1524,1524,["kaTTERu nIL sOlaik * kANDavaththaith thI mUTTi","viTTAnai * meyyam amarndha perumAnai **","maTTERu kaRpagaththai * mAdharkkAy * vaN thuvarai","naTTAnai nADi * naRaiyUril kaNDEnE"],["கட்டேறு நீள் சோலைக் * காண்டவத்தைத் தீ மூட்டி","விட்டானை * மெய்யம் அமர்ந்த பெருமானை **","மட்டேறு கற்பகத்தை * மாதர்க்காய் * வண் துவரை","நட்டானை நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.7.mp3"],[1525,1525,["maNNin mI pAram keDuppAn * maRa mannar *","paNNin mEl vandha * paDai ellAm pAradhaththu **","viNNin mIdhu ERa * visayan thEr UrndhAnai *","naNNi nAn nADi * naRaiyUril kaNDEnE"],["மண்ணின் மீ பாரம் கெடுப்பான் * மற மன்னர் *","பண்ணின் மேல் வந்த * படை எல்லாம் பாரதத்து **","விண்ணின் மீது ஏற * விசயன் தேர் ஊர்ந்தானை *","நண்ணி நான் நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.8.mp3"],[1526,1526,["** ponggERu nIL sOdhip * pon Azhi thannODum *","sanggERu kOlath * thaDakkaip perumAnai **","konggERu sOlaik * kuDandhaik kiDandhAnai *","nangkOnai nADi * naRaiyUril kaNDEnE"],["** பொங்கேறு நீள் சோதிப் * பொன் ஆழி தன்னோடும் *","சங்கேறு கோலத் * தடக்கைப் பெருமானை **","கொங்கேறு சோலைக் * குடந்தைக் கிடந்தானை *","நங்கோனை நாடி * நறையூரில் கண்டேனே"],0,"/media/recitation/PT.6.8.9.mp3"],[1527,1527,["** mannu madhurai * vasudhEvar vAzh mudhalai *","nannaRaiyUr ninRa nambiyai ** vambavizh thAr","kannavilum thOLAn * kaliyan oli vallAr *","pon ulagil vAnavarkkup * puththELir AguvarE"],["** மன்னு மதுரை * வசுதேவர் வாழ் முதலை *","நன்னறையூர் நின்ற நம்பியை ** வம்பவிழ் தார்","கன்னவிலும் தோளான் * கலியன் ஒலி வல்லார் *","பொன் உலகில் வானவர்க்குப் * புத்தேளிர் ஆகுவரே"],0,"/media/recitation/PT.6.8.10.mp3"]],[[1528,1528,["** peDai aDarththa maDavannam * piriyAdhu * malark kamalam","maDal eDuththu madhu nugarum * vayal uDuththa thirunaRaiyUr **","muDai aDarththa siram Endhi * mUvulagum bali thirivOn *","iDar keDuththa thiruvALan * iNai aDiyE aDai nenjchE!"],["** பெடை அடர்த்த மடவன்னம் * பிரியாது * மலர்க் கமலம்","மடல் எடுத்து மது நுகரும் * வயல் உடுத்த திருநறையூர் **","முடை அடர்த்த சிரம் ஏந்தி * மூவுலகும் பலி திரிவோன் *","இடர் கெடுத்த திருவாளன் * இணை அடியே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.1.mp3"],[1529,1529,["kazhi Arum kana sanggam * kalandhu enggum niRaindhERi *","vazhi Ara muththu InRu * vaLangkoDukkum thirunaRaiyUr **","pazhi Arum viRal arakkan * parumuDigaL avai sidhaRa *","azhal ARum saram thurandhAn * aDi iNaiyE aDai nenjchE!"],["கழி ஆரும் கன சங்கம் * கலந்து எங்கும் நிறைந்தேறி *","வழி ஆர முத்து ஈன்று * வளங்கொடுக்கும் திருநறையூர் **","பழி ஆரும் விறல் அரக்கன் * பருமுடிகள் அவை சிதற *","அழல் ஆறும் சரம் துரந்தான் * அடி இணையே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.2.mp3"],[1530,1530,["suLai koNDa palangkanigaL * thEn pAya kadhaligaLin *","thiLai koNDa pazham kezhumu * thigazh sOlaith thirunaRaiyUr **","vaLai koNDa vaNNaththan * pin thOnRal * mUvulagODu","aLai veNNey uNDAn than * aDi iNaiyE aDai nenjchE!"],["சுளை கொண்ட பலங்கனிகள் * தேன் பாய கதலிகளின் *","திளை கொண்ட பழம் கெழுமு * திகழ் சோலைத் திருநறையூர் **","வளை கொண்ட வண்ணத்தன் * பின் தோன்றல் * மூவுலகோடு","அளை வெண்ணெய் உண்டான் தன் * அடி இணையே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.3.mp3"],[1531,1531,["thunROLith thukiRpaDalam * thunni enggum mALigai mEl *","ninRAra vAn mUDum * nIL selvath thirunaRaiyUr **","manRArak kuDam ADi * varai eDuththu mazhai thaDuththa *","kunRArum thiraL thOLan * kuraikazhalE aDai nenjchE!"],["துன்றோளித் துகிற்படலம் * துன்னி எங்கும் மாளிகை மேல் *","நின்றார வான் மூடும் * நீள் செல்வத் திருநறையூர் **","மன்றாரக் குடம் ஆடி * வரை எடுத்து மழை தடுத்த *","குன்றாரும் திரள் தோளன் * குரைகழலே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.4.mp3"],[1532,1532,["akil kuṟaṭum cantaṉamum * am pŏṉṉum aṇi muttum *","mikak kŏṇarntu tirai untum * viyaṉ pŏṉṉit tirunaṟaiyūr **","pakal karanta cuṭar āzhip * paṭaiyāṉ iv ulaku ezhum *","pukak karanta tiru vayiṟṟaṉ * pŏṉ-aṭiye aṭai nĕñce-"],["அகில் குறடும் சந்தனமும் * அம் பொன்னும் அணி முத்தும் *","மிகக் கொணர்ந்து திரை உந்தும் * வியன் பொன்னித் திருநறையூர் **","பகல் கரந்த சுடர் ஆழிப் * படையான் இவ் உலகு ஏழும் *","புகக் கரந்த திரு வயிற்றன் * பொன் அடியே அடை நெஞ்சே"],1,"/media/recitation/PT.6.9.5.mp3"],[1533,1533,["pon muththum ari ugirum * puzhaik kaimmA karikkODum *","minnath thaNthirai undhum * viyan ponnith thirunaRaiyUr **","min oththa nuNmarunggul * melliyalai * thirumArbil","mannath thAn vaiththu ugandhAn * malar aDiyE aDai nenjchE!"],["பொன் முத்தும் அரி உகிரும் * புழைக் கைம்மா கரிக்கோடும் *","மின்னத் தண்திரை உந்தும் * வியன் பொன்னித் திருநறையூர் **","மின் ஒத்த நுண்மருங்குல் * மெல்லியலை * திருமார்பில்","மன்னத் தான் வைத்து உகந்தான் * மலர் அடியே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.6.mp3"],[1534,1534,["sIr thazhaiththa kadhirch chennel * sengkamalaththu iDai iDaiyin *","pAr thazhaiththuk karumbu Onggip * payan viLaikkum thirunaRaiyUr **","kAr thazhaiththa thiru uruvan * kaNNa pirAn viNNavar kOn *","thAr thazhaiththa thuzhAy muDiyan * thaLir aDiyE aDai nenjchE!"],["சீர் தழைத்த கதிர்ச் செந்நெல் * செங்கமலத்து இடை இடையின் *","பார் தழைத்துக் கரும்பு ஓங்கிப் * பயன் விளைக்கும் திருநறையூர் **","கார் தழைத்த திரு உருவன் * கண்ண பிரான் விண்ணவர் கோன் *","தார் தழைத்த துழாய் முடியன் * தளிர் அடியே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.7.mp3"],[1535,1535,["** kulai Arndha pazhukkAyum * pasungkAyum pALai muththum *","thalai Arndha iLangkamugin * thaDanjchOlaith thirunaRaiyUr **","malai Arndha kOlam sEr * maNimADam miga manni *","nilai Ara ninRAn than * nIL kazhalE aDai nenjchE!"],["** குலை ஆர்ந்த பழுக்காயும் * பசுங்காயும் பாளை முத்தும் *","தலை ஆர்ந்த இளங்கமுகின் * தடஞ்சோலைத் திருநறையூர் **","மலை ஆர்ந்த கோலம் சேர் * மணிமாடம் மிக மன்னி *","நிலை ஆர நின்றான் தன் * நீள் கழலே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.8.mp3"],[1536,1536,["maRai Arum peruvELvik * kozhum pugai pOy vaLarndhu enggum *","niRai Ara vAn mUDum * nIL selvath thirunaRaiyUr **","piRai Arum saDaiyAnum * piramanum mun thozhudhu Eththa *","iRai Agi ninRAn than * iNai aDiyE aDai nenjchE!"],["மறை ஆரும் பெருவேள்விக் * கொழும் புகை போய் வளர்ந்து எங்கும் *","நிறை ஆர வான் மூடும் * நீள் செல்வத் திருநறையூர் **","பிறை ஆரும் சடையானும் * பிரமனும் முன் தொழுது ஏத்த *","இறை ஆகி நின்றான் தன் * இணை அடியே அடை நெஞ்சே!"],0,"/media/recitation/PT.6.9.9.mp3"],[1537,1537,["** thiNkaLaga madhiL puDai sUzh * thirunaRaiyUr ninRAnai *","vaNkaLaga nilavu eRikkum * vayal manggai nagarALan **","paNgaL agam payinRa sIrp * pADal ivai paththum vallAr *","viNgaL agaththu imaiyavarAy * vIRRirundhu vAzhvArE"],["** திண்களக மதிள் புடை சூழ் * திருநறையூர் நின்றானை *","வண்களக நிலவு எறிக்கும் * வயல் மங்கை நகராளன் **","பண்கள் அகம் பயின்ற சீர்ப் * பாடல் இவை பத்தும் வல்லார் *","விண்கள் அகத்து இமையவராய் * வீற்றிருந்து வாழ்வாரே"],0,"/media/recitation/PT.6.9.10.mp3"]],[[1538,1538,["** kiDandha nambi kuDandhai mEvik * kEzhalAy ulagai","iDandha nambi * enggaL nambi * eRinjar araN azhiya **","kaDandha nambi kaDiyAr ilanggai * ulagai IraDiyAl *","naDandha nambi nAmam sollil * namO nArAyaNamE"],["** கிடந்த நம்பி குடந்தை மேவிக் * கேழலாய் உலகை","இடந்த நம்பி * எங்கள் நம்பி * எறிஞர் அரண் அழிய **","கடந்த நம்பி கடியார் இலங்கை * உலகை ஈரடியால் *","நடந்த நம்பி நாமம் சொல்லில் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.1.mp3"],[1539,1539,["viDam thAn uDaiya aravam veruvach * seruvil muna nAL * mun","thaDanthAmarai nIrp poygai pukku * mikka thADALan **","iDandhAn vaiyam kEzhal Agi * ulagai IraDiyAl *","naDandhAnuDaiya nAmam sollil * namO nArAyaNamE"],["விடம் தான் உடைய அரவம் வெருவச் * செருவில் முன நாள் * முன்","தடந்தாமரை நீர்ப் பொய்கை புக்கு * மிக்க தாடாளன் **","இடந்தான் வையம் கேழல் ஆகி * உலகை ஈரடியால் *","நடந்தானுடைய நாமம் சொல்லில் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.2.mp3"],[1540,1540,["pUNAdhu analum * thaRu kaN vEzham maRuga * vaLai maruppaip","pENAn vAnggi * amudham koNDa perumAn thirumArvan **","pANA vaNDu muralum kUndhal * Aychchi thayir veNNey *","nANAdhu uNDAn nAmam sollil * namO nArAyaNamE"],["பூணாது அனலும் * தறு கண் வேழம் மறுக * வளை மருப்பைப்","பேணான் வாங்கி * அமுதம் கொண்ட பெருமான் திருமார்வன் **","பாணா வண்டு முரலும் கூந்தல் * ஆய்ச்சி தயிர் வெண்ணெய் *","நாணாது உண்டான் நாமம் சொல்லில் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.3.mp3"],[1541,1541,["kallAr madhiL sUzh * kachchi nagaruL nachchi * pADagaththuL","ellA ulagum vaNangga * irundha ammAn ** ilanggaik kOn","vallAL Agam * villAl munindha endhai * vibIDaNaRku","nallAnuDaiya nAmam sollil * namO nArAyaNamE"],["கல்லார் மதிள் சூழ் * கச்சி நகருள் நச்சி * பாடகத்துள்","எல்லா உலகும் வணங்க * இருந்த அம்மான் ** இலங்கைக் கோன்","வல்லாள் ஆகம் * வில்லால் முனிந்த எந்தை * விபீடணற்கு","நல்லானுடைய நாமம் சொல்லில் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.4.mp3"],[1542,1542,["kuDaiyA varaiyAl * nirai mun kAththa perumAn * maruvAdha","viDai thAn Ezhum venRAn * kOval ninRAn ** thennilanggai","aDaiyA arakkar vIyap * porudhu mEvi vengkURRam *","naDaiyA uNNak kaNDAn nAmam * namO nArAyaNamE"],["குடையா வரையால் * நிரை முன் காத்த பெருமான் * மருவாத","விடை தான் ஏழும் வென்றான் * கோவல் நின்றான் ** தென்னிலங்கை","அடையா அரக்கர் வீயப் * பொருது மேவி வெங்கூற்றம் *","நடையா உண்ணக் கண்டான் நாமம் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.5.mp3"],[1543,1543,["kAna eNgum kuranggum * musuvum paDaiyA * aDal arakkar","mAnam azhiththu ninRa * venRi ammAn ** enakku enRum","thEnum pAlum amudhumAya * thirumAl thirunAmam *","nAnum sonnEn namarum uraimin * namO nArAyaNamE"],["கான எண்கும் குரங்கும் * முசுவும் படையா * அடல் அரக்கர்","மானம் அழித்து நின்ற * வென்றி அம்மான் ** எனக்கு என்றும்","தேனும் பாலும் அமுதுமாய * திருமால் திருநாமம் *","நானும் சொன்னேன் நமரும் உரைமின் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.6.mp3"],[1544,1544,["ninRa varaiyum kiDandha kaDalum * thisaiyum irunilanum *","onRum ozhiyA vaNNam * eNNi ninRa ammAnAr **","kunRu kuDaiyA eDuththa * aDigaLuDaiya thirunAmam *","nanRu kANmin thoNDIr! sonnEn * namO nArAyaNamE"],["நின்ற வரையும் கிடந்த கடலும் * திசையும் இருநிலனும் *","ஒன்றும் ஒழியா வண்ணம் * எண்ணி நின்ற அம்மானார் **","குன்று குடையா எடுத்த * அடிகளுடைய திருநாமம் *","நன்று காண்மின் தொண்டீர்! சொன்னேன் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.7.mp3"],[1545,1545,["kaDungkAl mAri kallE pozhiya * allE emakku enRu","paDungkAl * nIyE saraN enRu * Ayar anjcha anjchA mun **","neDungkAl kunRam kuDai onRu Endhi * niraiyaich siramaththAl *","naDunggA vaNNam kAththAn nAmam * namO nArAyaNamE"],["கடுங்கால் மாரி கல்லே பொழிய * அல்லே எமக்கு என்று","படுங்கால் * நீயே சரண் என்று * ஆயர் அஞ்ச அஞ்சா முன் **","நெடுங்கால் குன்றம் குடை ஒன்று ஏந்தி * நிரையைச் சிரமத்தால் *","நடுங்கா வண்ணம் காத்தான் நாமம் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.8.mp3"],[1546,1546,["ponggu puNarik kaDal sUzh ADai * nila mAmagaL malar mA","manggai * piraman sivan indhiran * vAnavar nAyagarAya **","enggaL aDigaL imaiyOr * thalaivaruDaiya thirunAmam *","nanggaL vinaigaL thavira uraimin * namO nArAyaNamE"],["பொங்கு புணரிக் கடல் சூழ் ஆடை * நில மாமகள் மலர் மா","மங்கை * பிரமன் சிவன் இந்திரன் * வானவர் நாயகராய **","எங்கள் அடிகள் இமையோர் * தலைவருடைய திருநாமம் *","நங்கள் வினைகள் தவிர உரைமின் * நமோ நாராயணமே"],0,"/media/recitation/PT.6.10.9.mp3"],[1547,1547,["** vAvith thaDam sUzh maNi muththARRu * naRaiyUr neDumAlai *","nAvil paravi nenjchil koNDu * nambi nAmaththai **","kAvith thaDangkaN maDavAr kELvan * kaliyan oli mAlai *","mEvich solla vallAr pAvam * nillA vIyumE"],["** வாவித் தடம் சூழ் மணி முத்தாற்று * நறையூர் நெடுமாலை *","நாவில் பரவி நெஞ்சில் கொண்டு * நம்பி நாமத்தை **","காவித் தடங்கண் மடவார் கேள்வன் * கலியன் ஒலி மாலை *","மேவிச் சொல்ல வல்லார் பாவம் * நில்லா வீயுமே"],0,"/media/recitation/PT.6.10.10.mp3"]]]