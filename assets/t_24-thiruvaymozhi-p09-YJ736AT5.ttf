[[[3673,3673,["** koNDa peNDir makkaL uRRAr * suRRaththavar piRarum *","kaNDadhODu paTTadhu allAl * kAdhal maRRu yAdhum illai **","eNthisaiyum kIzhum mElum * muRRavum uNDa pirAn *","thoNDarOmAy uyyal allAl * illai kaNDIr thuNaiyE"],["** கொண்ட பெண்டிர் மக்கள் உற்றார் * சுற்றத்தவர் பிறரும் *","கண்டதோடு பட்டது அல்லால் * காதல் மற்று யாதும் இல்லை **","எண்திசையும் கீழும் மேலும் * முற்றவும் உண்ட பிரான் *","தொண்டரோமாய் உய்யல் அல்லால் * இல்லை கண்டீர் துணையே"],0,"/media/recitation/TVM.9.1.1.mp3"],[3674,3674,["thuNaiyum sArvum AguvAr pOl * suRRaththavar piRarum *","aNaiya vandha Akkam uNDEl * aTTaigaL pOl suvaippar **","kaNai onRAlE Ezh maramum eydha * em kAr mugilai *","puNai enRu uyyap pOgil allAl * illai kaNDIr poruLE"],["துணையும் சார்வும் ஆகுவார் போல் * சுற்றத்தவர் பிறரும் *","அணைய வந்த ஆக்கம் உண்டேல் * அட்டைகள் போல் சுவைப்பர் **","கணை ஒன்றாலே ஏழ் மரமும் எய்த * எம் கார் முகிலை *","புணை என்று உய்யப் போகில் அல்லால் * இல்லை கண்டீர் பொருளே"],0,"/media/recitation/TVM.9.1.2.mp3"],[3675,3675,["poruL kai uNDAych sellak kANil * pORRi enRu ERRu ezhuvar *","iruL koL thunbaththu inmai kANil * ennE! enbArum illai **","maruL koL seygai asurar mangga * vaDamadhuraip piRandhARku *","aruL koL ALAy uyyal allAl * illai kaNDIr araNE"],["பொருள் கை உண்டாய்ச் செல்லக் காணில் * போற்றி என்று ஏற்று எழுவர் *","இருள் கொள் துன்பத்து இன்மை காணில் * என்னே! என்பாரும் இல்லை **","மருள் கொள் செய்கை அசுரர் மங்க * வடமதுரைப் பிறந்தாற்கு *","அருள் கொள் ஆளாய் உய்யல் அல்லால் * இல்லை கண்டீர் அரணே"],0,"/media/recitation/TVM.9.1.3.mp3"],[3676,3676,["araNam Avar aRRa kAlaikku * enRenRu amaikkappaTTAr *","iraNam koNDa theppar Avar * inRi iTTAlum aqdhE **","varuNiththu ennE? * vaDamadhuraip piRandhavan vaNpugazhE *","saraN enRu uyyap pOgal allAl * illai kaNDIr sadhirE"],["அரணம் ஆவர் அற்ற காலைக்கு * என்றென்று அமைக்கப்பட்டார் *","இரணம் கொண்ட தெப்பர் ஆவர் * இன்றி இட்டாலும் அஃதே **","வருணித்து என்னே? * வடமதுரைப் பிறந்தவன் வண்புகழே *","சரண் என்று உய்யப் போகல் அல்லால் * இல்லை கண்டீர் சதிரே"],0,"/media/recitation/TVM.9.1.4.mp3"],[3677,3677,["sadhiram enRu thammaith thAmE * sammadhiththu inmozhiyAr *","madhura bOgam thuRRavarE * vaigi maRRonRu uRuvar **","adhir koL seygai asurar mangga * vaDamadhuraip piRandhARku *","edhir koL ALAy uyyal allAl * illai kaNDIr inbamE"],["சதிரம் என்று தம்மைத் தாமே * சம்மதித்து இன்மொழியார் *","மதுர போகம் துற்றவரே * வைகி மற்றொன்று உறுவர் **","அதிர் கொள் செய்கை அசுரர் மங்க * வடமதுரைப் பிறந்தாற்கு *","எதிர் கொள் ஆளாய் உய்யல் அல்லால் * இல்லை கண்டீர் இன்பமே"],0,"/media/recitation/TVM.9.1.5.mp3"],[3678,3678,["illai kaNDIr inbam andhO! * uLLadhu ninaiyAdhE *","thollaiyArgaL eththanaivar * thOnRik kazhindhu ozhindhAr? **","mallai mUdhUr * vaDamadhuraip piRandhavan vaNpugazhE *","solli uyyap pOgal allAl * maRRonRu illai surukkE"],["இல்லை கண்டீர் இன்பம் அந்தோ! * உள்ளது நினையாதே *","தொல்லையார்கள் எத்தனைவர் * தோன்றிக் கழிந்து ஒழிந்தார்? **","மல்லை மூதூர் * வடமதுரைப் பிறந்தவன் வண்புகழே *","சொல்லி உய்யப் போகல் அல்லால் * மற்றொன்று இல்லை சுருக்கே"],0,"/media/recitation/TVM.9.1.6.mp3"],[3679,3679,["maRRonRu illai surunggach sonnOm * mA nilaththu evvuyirkkum *","chiRRa vENDA sindhippE amaiyum * kaNDIrgaL andhO! **","kuRRam anRu enggaL peRRath thAyan * vaDamadhuraip piRandhAn *","kuRRamil sIr kaRRu vaigal * vAzhdhal kaNDIr guNamE"],["மற்றொன்று இல்லை சுருங்கச் சொன்னோம் * மா நிலத்து எவ்வுயிர்க்கும் *","சிற்ற வேண்டா சிந்திப்பே அமையும் * கண்டீர்கள் அந்தோ! **","குற்றம் அன்று எங்கள் பெற்றத் தாயன் * வடமதுரைப் பிறந்தான் *","குற்றமில் சீர் கற்று வைகல் * வாழ்தல் கண்டீர் குணமே"],0,"/media/recitation/TVM.9.1.7.mp3"],[3680,3680,["vAzhdhal kaNDIr guNam idhandhO? * mAyavan aDi paravi *","pOzhdhu pOga uLLakiRkum * punmai ilAdhavarkku **","vAzh thuNaiyA * vaDamadhuraip piRandhavan vaNpugazhE *","vIzh thuNaiyAp pOm idhanil * yAdhum illai mikkadhE"],["வாழ்தல் கண்டீர் குணம் இதந்தோ? * மாயவன் அடி பரவி *","போழ்து போக உள்ளகிற்கும் * புன்மை இலாதவர்க்கு **","வாழ் துணையா * வடமதுரைப் பிறந்தவன் வண்புகழே *","வீழ் துணையாப் போம் இதனில் * யாதும் இல்லை மிக்கதே"],0,"/media/recitation/TVM.9.1.8.mp3"],[3681,3681,["yAdhum illai mikku adhanil * enRenRu adhu karudhi *","kAdhu seyvAn kUdhai seydhu * kaDaimuRai vAzhkkaiyum pOm **","mA thugilin koDik koL mADa * vaDamadhuraip piRandha *","thAdhu sEr thOL kaNNan allAl * illai kaNDIr saraNE"],["யாதும் இல்லை மிக்கு அதனில் * என்றென்று அது கருதி *","காது செய்வான் கூதை செய்து * கடைமுறை வாழ்க்கையும் போம் **","மா துகிலின் கொடிக் கொள் மாட * வடமதுரைப் பிறந்த *","தாது சேர் தோள் கண்ணன் அல்லால் * இல்லை கண்டீர் சரணே"],0,"/media/recitation/TVM.9.1.9.mp3"],[3682,3682,["kaNNan allAl illai kaNDIr saraN * adhu niRka vandhu *","maNNin bAram nIkkudhaRkE * vaDamadhuraip piRandhAn **","thiNNamA num uDaimai uNDEl * avan aDi sErndhu uymminO *","eNNa vENDA nummadhu Adhum * avan anRi maRRu illaiyE"],["கண்ணன் அல்லால் இல்லை கண்டீர் சரண் * அது நிற்க வந்து *","மண்ணின் பாரம் நீக்குதற்கே * வடமதுரைப் பிறந்தான் **","திண்ணமா நும் உடைமை உண்டேல் * அவன் அடி சேர்ந்து உய்ம்மினோ *","எண்ண வேண்டா நும்மது ஆதும் * அவன் அன்றி மற்று இல்லையே"],0,"/media/recitation/TVM.9.1.10.mp3"],[3683,3683,["** Adhum illai maRRu avanil * enRadhuvE thuNindhu *","thAdhu sEr thOL kaNNanaik * kurugUrch saDakOpan sonna **","thIdhu ilAdha oNthamizhgaL * ivai AyiraththuL ippaththum *","Odha valla pirAkkaL * nammai ALuDaiyArgaL paNDE"],["** ஆதும் இல்லை மற்று அவனில் * என்றதுவே துணிந்து *","தாது சேர் தோள் கண்ணனைக் * குருகூர்ச் சடகோபன் சொன்ன **","தீது இலாத ஒண்தமிழ்கள் * இவை ஆயிரத்துள் இப்பத்தும் *","ஓத வல்ல பிராக்கள் * நம்மை ஆளுடையார்கள் பண்டே"],0,"/media/recitation/TVM.9.1.11.mp3"]],[[3684,3684,["** paNDai nALAlE nin thiruvaruLum *","panggayaththAL thiruvaruLum","koNDu * nin kOyil sIyththup palpaDikAl *","kuDi kuDi vazhi vandhu ATcheyyum **","thoNDarOrkku aruLich sOdhi vAy thiRandhu * un","thAmaraik kaNgaLAl nOkkAy *","theNthiraip porunal thaN paNai sUzhndha *","thiruppuLingkuDik kiDandhAnE!"],["** பண்டை நாளாலே நின் திருவருளும் *","பங்கயத்தாள் திருவருளும்","கொண்டு * நின் கோயில் சீய்த்துப் பல்படிகால் *","குடி குடி வழி வந்து ஆட்செய்யும் **","தொண்டரோர்க்கு அருளிச் சோதி வாய் திறந்து * உன்","தாமரைக் கண்களால் நோக்காய் *","தெண்திரைப் பொருநல் தண் பணை சூழ்ந்த *","திருப்புளிங்குடிக் கிடந்தானே!"],0,"/media/recitation/TVM.9.2.1.mp3"],[3685,3685,["kuDi kiDandhu Akkam seydhu * nin thIrththa","aDimaik kuRREval seydhu * un pon","aDik kaDavAdhE vazhi varuginRa *","aDiyarOrkku aruLi ** nI oru nAL","paDikku aLavAga nimirththa * nin pAdha","panggayamE thalaikku aNiyAy *","koDik koL pon madhiL sUzh kuLir vayal sOlaith *","thiruppuLingkuDik kiDandhAnE!"],["குடி கிடந்து ஆக்கம் செய்து * நின் தீர்த்த","அடிமைக் குற்றேவல் செய்து * உன் பொன்","அடிக் கடவாதே வழி வருகின்ற *","அடியரோர்க்கு அருளி ** நீ ஒரு நாள்","படிக்கு அளவாக நிமிர்த்த * நின் பாத","பங்கயமே தலைக்கு அணியாய் *","கொடிக் கொள் பொன் மதிள் சூழ் குளிர் வயல் சோலைத் *","திருப்புளிங்குடிக் கிடந்தானே!"],0,"/media/recitation/TVM.9.2.2.mp3"],[3686,3686,["kiDandha nAL kiDandhAy eththanai kAlam","kiDaththi? * un thiru uDambu asaiya *","thoDarndhu kuRREval seydhu * thol aDimai","vazhi varum thoNDarOrkku aruLi **","thaDangkoL thAmaraik kaN vizhiththu * nI ezhundhu","un thAmarai manggaiyum nIyum *","iDangkoL mUvulagum thozha irundharuLAy *","thiruppuLingkuDik kiDandhAnE!"],["கிடந்த நாள் கிடந்தாய் எத்தனை காலம்","கிடத்தி? * உன் திரு உடம்பு அசைய *","தொடர்ந்து குற்றேவல் செய்து * தொல் அடிமை","வழி வரும் தொண்டரோர்க்கு அருளி **","தடங்கொள் தாமரைக் கண் விழித்து * நீ எழுந்து","உன் தாமரை மங்கையும் நீயும் *","இடங்கொள் மூவுலகும் தொழ இருந்தருளாய் *","திருப்புளிங்குடிக் கிடந்தானே!"],0,"/media/recitation/TVM.9.2.3.mp3"],[3687,3687,["puLingkuDik kiDandhu varaguNamanggai","irundhu * vaikundhaththuL ninRu *","theLindha en sindhai agam kazhiyAdhE *","ennai ALvAy! enakku aruLi **","naLirndha sIr ulagam mUnRuDan viyappa *","nAnggaL kUththADi ninRu Arppa *","paLinggu nIr mugilin pavaLam pOl * kani vAy","sivappa nI kANa vArAyE"],["புளிங்குடிக் கிடந்து வரகுணமங்கை","இருந்து * வைகுந்தத்துள் நின்று *","தெளிந்த என் சிந்தை அகம் கழியாதே *","என்னை ஆள்வாய்! எனக்கு அருளி **","நளிர்ந்த சீர் உலகம் மூன்றுடன் வியப்ப *","நாங்கள் கூத்தாடி நின்று ஆர்ப்ப *","பளிங்கு நீர் முகிலின் பவளம் போல் * கனி வாய்","சிவப்ப நீ காண வாராயே"],0,"/media/recitation/TVM.9.2.4.mp3"],[3688,3688,["pavaLam pOl kani vAy sivappa nI kANa","vandhu * nin pal nilA muththam *","thavazh kadhir muRuval seydhu * nin thiruk kaN","thAmarai thayangga ninRaruLAy **","pavaLa nanpaDark kIzhch sangguRai porunal *","thaN thiruppuLingkuDik kiDandhAy! *","kavaLa mA kaLiRRin iDar keDath thaDaththuk *","kAy sinap paRavai UrndhAnE!"],["பவளம் போல் கனி வாய் சிவப்ப நீ காண","வந்து * நின் பல் நிலா முத்தம் *","தவழ் கதிர் முறுவல் செய்து * நின் திருக் கண்","தாமரை தயங்க நின்றருளாய் **","பவள நன்படர்க் கீழ்ச் சங்குறை பொருநல் *","தண் திருப்புளிங்குடிக் கிடந்தாய்! *","கவள மா களிற்றின் இடர் கெடத் தடத்துக் *","காய் சினப் பறவை ஊர்ந்தானே!"],0,"/media/recitation/TVM.9.2.5.mp3"],[3689,3689,["kAy sinap paRavai Urndhu * pon malaiyin","mImisaik kAr mugil pOl *","mA sina mAli mAli mAn enRu * anggu","avar paDak kananRu mun ninRa **","kAysina vEndhE! kadhir muDiyAnE! *","kali vayal thiruppuLingkuDiyAy! *","kAy sina Azhi sanggu vAL vil thaNDu","Endhi * em iDar kaDivAnE!"],["காய் சினப் பறவை ஊர்ந்து * பொன் மலையின்","மீமிசைக் கார் முகில் போல் *","மா சின மாலி மாலி மான் என்று * அங்கு","அவர் படக் கனன்று முன் நின்ற **","காய்சின வேந்தே! கதிர் முடியானே! *","கலி வயல் திருப்புளிங்குடியாய்! *","காய் சின ஆழி சங்கு வாள் வில் தண்டு","ஏந்தி * எம் இடர் கடிவானே!"],0,"/media/recitation/TVM.9.2.6.mp3"],[3690,3690,["em iDar kaDindhu inggu ennai ALvAnE! *","imaiyavar thamakkum Anggu anaiyAy! *","semmaDal malarum thAmaraip pazhanath *","thaN thiruppuLingkuDik kiDandhAy! **","nammuDai aDiyar kavvai kaNDu ugandhu *","nAm kaLiththu uLa nalam kUra *","immaDa ulagar kANa nI oru nAL *","irundhiDAy enggaL kaN mugappE"],["எம் இடர் கடிந்து இங்கு என்னை ஆள்வானே! *","இமையவர் தமக்கும் ஆங்கு அனையாய்! *","செம்மடல் மலரும் தாமரைப் பழனத் *","தண் திருப்புளிங்குடிக் கிடந்தாய்! **","நம்முடை அடியர் கவ்வை கண்டு உகந்து *","நாம் களித்து உள நலம் கூர *","இம்மட உலகர் காண நீ ஒரு நாள் *","இருந்திடாய் எங்கள் கண் முகப்பே"],0,"/media/recitation/TVM.9.2.7.mp3"],[3691,3691,["enggaL kaN mugappE ulagargaL ellAm *","iNai aDi thozhudhu ezhudhu iRainjchi *","thanggaL anbu Arath thamadhu sol valaththAl *","thalaith thalaich siRandhu pUsippa **","thinggaL sEr mADath thiruppuLingkuDiyAy! *","thiruvaikundhaththuLLAy! dhEvA! *","inggaN mA njAlaththu idhanuLum oru nAL *","irundhiDAy vIRRiDang koNDE"],["எங்கள் கண் முகப்பே உலகர்கள் எல்லாம் *","இணை அடி தொழுது எழுது இறைஞ்சி *","தங்கள் அன்பு ஆரத் தமது சொல் வலத்தால் *","தலைத் தலைச் சிறந்து பூசிப்ப **","திங்கள் சேர் மாடத் திருப்புளிங்குடியாய்! *","திருவைகுந்தத்துள்ளாய்! தேவா! *","இங்கண் மா ஞாலத்து இதனுளும் ஒரு நாள் *","இருந்திடாய் வீற்றிடங் கொண்டே"],0,"/media/recitation/TVM.9.2.8.mp3"],[3692,3692,["vIRRiDang koNDu viyan koL mA njAlaththu *","idhanuLum irundhiDAy * aDiyOm","pORRi OvAdhE kaN inai kuLirap *","pudhu malar Agaththaip paruga **","sERRiLa vALai sennelUDu ugaLum *","sezhum paNaith thiruppuLingkuDiyAy! *","kURRamAy asurar kula mudhal arindha *","koDu vinaip paDaigaL vallAnE!"],["வீற்றிடங் கொண்டு வியன் கொள் மா ஞாலத்து *","இதனுளும் இருந்திடாய் * அடியோம்","போற்றி ஓவாதே கண் இனை குளிரப் *","புது மலர் ஆகத்தைப் பருக **","சேற்றிள வாளை செந்நெலூடு உகளும் *","செழும் பணைத் திருப்புளிங்குடியாய்! *","கூற்றமாய் அசுரர் குல முதல் அரிந்த *","கொடு வினைப் படைகள் வல்லானே!"],0,"/media/recitation/TVM.9.2.9.mp3"],[3693,3693,["koDu vinaip paDaigaL vallaiyAy * amararkku","iDar keDa asurargaTku iDar sey *","kaDu vinai nanjchE! ennuDai amudhE! *","kali vayal thiruppuLingkuDiyAy! **","vaDivu iNai illA malar magaL * maRRai","nila magaL piDikkum mel aDiyai *","koDu vinaiyEnum piDikka nI oru nAL *","kUvudhal varudhal seyyAyE"],["கொடு வினைப் படைகள் வல்லையாய் * அமரர்க்கு","இடர் கெட அசுரர்கட்கு இடர் செய் *","கடு வினை நஞ்சே! என்னுடை அமுதே! *","கலி வயல் திருப்புளிங்குடியாய்! **","வடிவு இணை இல்லா மலர் மகள் * மற்றை","நில மகள் பிடிக்கும் மெல் அடியை *","கொடு வினையேனும் பிடிக்க நீ ஒரு நாள் *","கூவுதல் வருதல் செய்யாயே"],0,"/media/recitation/TVM.9.2.10.mp3"],[3694,3694,["** kUvudhal varudhal seydhiDAy enRu *","kurai kaDal kaDaindhavan thannai *","mEvi nanku amarndha viyan punal porunal *","vazhudhi nADan saDakOpan **","nA iyal pADal AyiraththuLLum *","ivaiyum Or paththum vallArgaL *","Ovudhal inRi ulagam mUnRu aLandhAn *","aDi iNai uLLaththu OrvArE"],["** கூவுதல் வருதல் செய்திடாய் என்று *","குரை கடல் கடைந்தவன் தன்னை *","மேவி நன்கு அமர்ந்த வியன் புனல் பொருநல் *","வழுதி நாடன் சடகோபன் **","நா இயல் பாடல் ஆயிரத்துள்ளும் *","இவையும் ஓர் பத்தும் வல்லார்கள் *","ஓவுதல் இன்றி உலகம் மூன்று அளந்தான் *","அடி இணை உள்ளத்து ஓர்வாரே"],0,"/media/recitation/TVM.9.2.11.mp3"]],[[3695,3695,["** Or AyiramAy * ulagEzh aLikkum *","pEr Ayiram koNDadhOr * pIDu uDaiyan **","kAr Ayina * kALa nan mEniyinan *","nArAyaNan * nanggaL pirAn avanE"],["** ஓர் ஆயிரமாய் * உலகேழ் அளிக்கும் *","பேர் ஆயிரம் கொண்டதோர் * பீடு உடையன் **","கார் ஆயின * காள நன் மேனியினன் *","நாராயணன் * நங்கள் பிரான் அவனே"],0,"/media/recitation/TVM.9.3.1.mp3"],[3696,3696,["avanE agal njAlam * paDaiththu iDandhAn *","avanE aqdhu uNDu umizhndhAn * aLandhAn **","avanE avanum * avanum avanum *","avanE maRRu ellAmum * aRindhanamE"],["அவனே அகல் ஞாலம் * படைத்து இடந்தான் *","அவனே அஃது உண்டு உமிழ்ந்தான் * அளந்தான் **","அவனே அவனும் * அவனும் அவனும் *","அவனே மற்று எல்லாமும் * அறிந்தனமே"],0,"/media/recitation/TVM.9.3.2.mp3"],[3697,3697,["aRindhana vEdha * arum poruL nUlgaL *","aRindhana koLga * arum poruL Adhal **","aRindhanar ellAm * ariyai vaNanggi *","aRindhanar * nOygaL aRukkum marundhE"],["அறிந்தன வேத * அரும் பொருள் நூல்கள் *","அறிந்தன கொள்க * அரும் பொருள் ஆதல் **","அறிந்தனர் எல்லாம் * அரியை வணங்கி *","அறிந்தனர் * நோய்கள் அறுக்கும் மருந்தே"],0,"/media/recitation/TVM.9.3.3.mp3"],[3698,3698,["marundhE nanggaL * bOga magizhchchikku enRu *","perundhEvar kuzhAnggaL * pidhaRRum pirAn **","karundhEvan emmAn * kaNNan viNNulagam *","tharum dhEvanaich * sOrEl kaNDAy manamE!"],["மருந்தே நங்கள் * போக மகிழ்ச்சிக்கு என்று *","பெருந்தேவர் குழாங்கள் * பிதற்றும் பிரான் **","கருந்தேவன் எம்மான் * கண்ணன் விண்ணுலகம் *","தரும் தேவனைச் * சோரேல் கண்டாய் மனமே!"],0,"/media/recitation/TVM.9.3.4.mp3"],[3699,3699,["manamE! unnai * val vinaiyEn irandhu *","kanamE sollinEn * idhu sOrEl kaNDAy **","puna mEviya * pUnthaN thuzhAy alanggal *","inam Edhum ilAnai * aDaivadhumE"],["மனமே! உன்னை * வல் வினையேன் இரந்து *","கனமே சொல்லினேன் * இது சோரேல் கண்டாய் **","புன மேவிய * பூந்தண் துழாய் அலங்கல் *","இனம் ஏதும் இலானை * அடைவதுமே"],0,"/media/recitation/TVM.9.3.5.mp3"],[3700,3700,["aDaivadhum aNi Ar * malar manggai thOL *","miDaivadhum * asurarkku vempOrgaLE **","kaDaivadhum * kaDaluL amudham * en manam","uDaivadhum * avaRkE orunggAgavE"],["அடைவதும் அணி ஆர் * மலர் மங்கை தோள் *","மிடைவதும் * அசுரர்க்கு வெம்போர்களே **","கடைவதும் * கடலுள் அமுதம் * என் மனம்","உடைவதும் * அவற்கே ஒருங்காகவே"],0,"/media/recitation/TVM.9.3.6.mp3"],[3701,3701,["Agam sEr * narasinggam adhAgi * Or","Agam vaLLugirAl * piLandhAn uRai **","mAga vaikundham * kANbadhaRku * en manam","Egam eNNum * irAp pagal inRiyE"],["ஆகம் சேர் * நரசிங்கம் அதாகி * ஓர்","ஆகம் வள்ளுகிரால் * பிளந்தான் உறை **","மாக வைகுந்தம் * காண்பதற்கு * என் மனம்","ஏகம் எண்ணும் * இராப் பகல் இன்றியே"],0,"/media/recitation/TVM.9.3.7.mp3"],[3702,3702,["inRip pOga * iru vinaiyum keDuththu *","onRi Akkai pugAmai * uyyak koLvAn **","ninRa vEngkaDam * nIL nilaththu uLLadhu *","senRu dhEvargaL * kai thozhuvArgaLE"],["இன்றிப் போக * இரு வினையும் கெடுத்து *","ஒன்றி ஆக்கை புகாமை * உய்யக் கொள்வான் **","நின்ற வேங்கடம் * நீள் நிலத்து உள்ளது *","சென்று தேவர்கள் * கை தொழுவார்களே"],0,"/media/recitation/TVM.9.3.8.mp3"],[3703,3703,["thozhudhu mA malar * nIr suDar dhUpam koNDu *","ezhudhum ennum idhu * migai Adhalil **","pazhudhil thol pugazhp * pAmbaNaip paLLiyAy! *","thazhuvum ARu aRiyEn * una thALgaLE"],["தொழுது மா மலர் * நீர் சுடர் தூபம் கொண்டு *","எழுதும் என்னும் இது * மிகை ஆதலில் **","பழுதில் தொல் புகழ்ப் * பாம்பணைப் பள்ளியாய்! *","தழுவும் ஆறு அறியேன் * உன தாள்களே"],0,"/media/recitation/TVM.9.3.9.mp3"],[3704,3704,["thALa thAmaraiyAn * unadhu undhiyAn *","vAL koL nIL mazhu ALi * un AgaththAn **","ALar Ayth thozhuvArum * amarargaL *","nALum en pugazhgO * una sIlamE?"],["தாள தாமரையான் * உனது உந்தியான் *","வாள் கொள் நீள் மழு ஆளி * உன் ஆகத்தான் **","ஆளர் ஆய்த் தொழுவாரும் * அமரர்கள் *","நாளும் என் புகழ்கோ * உன சீலமே?"],0,"/media/recitation/TVM.9.3.10.mp3"],[3705,3705,["** sIlam ellai ilAn * aDi mEl * aNi","kOla nIL * kurugUrch saDakOpan ** sol","mAlai AyiraththuL * ivai paththin in","pAlar * vaikuntham ERudhal pAnmaiyE"],["** சீலம் எல்லை இலான் * அடி மேல் * அணி","கோல நீள் * குருகூர்ச் சடகோபன் ** சொல்","மாலை ஆயிரத்துள் * இவை பத்தின் இன்","பாலர் * வைகுந்தம் ஏறுதல் பான்மையே"],0,"/media/recitation/TVM.9.3.11.mp3"]],[[3706,3706,["** maiyAr karung kaNNi * kamala malar mEl","seyyAL * thiru mArvinil sEr * thirumAlE! **","veyyAr suDar Azhi * suri sanggam Endhum","kaiyA! * unnaik kANak * karudhum en kaNNE"],["** மையார் கருங் கண்ணி * கமல மலர் மேல்","செய்யாள் * திரு மார்வினில் சேர் * திருமாலே! **","வெய்யார் சுடர் ஆழி * சுரி சங்கம் ஏந்தும்","கையா! * உன்னைக் காணக் * கருதும் என் கண்ணே"],0,"/media/recitation/TVM.9.4.1.mp3"],[3707,3707,["kaNNE! unnaik * kANak karudhi * en nenjcham","eNNE koNDa * sindhaiyadhAy ninRu iyambum **","viNNOr munivarkku * enRum kANbu ariyAyai *","naNNAdhu ozhiyEn enRu * nAn azhaippanE"],["கண்ணே! உன்னைக் * காணக் கருதி * என் நெஞ்சம்","எண்ணே கொண்ட * சிந்தையதாய் நின்று இயம்பும் **","விண்ணோர் முனிவர்க்கு * என்றும் காண்பு அரியாயை *","நண்ணாது ஒழியேன் என்று * நான் அழைப்பனே"],0,"/media/recitation/TVM.9.4.2.mp3"],[3708,3708,["azhaikkinRa aDi nAyEn * nAy kUzhai vAlAl *","kuzhaikkinRadhu pOla * en uLLam kuzhaiyum **","mazhaikku anRu kunRam eDuththu * Anirai kAththAy! *","pizhaikkinRadhu aruL enRu * pEdhu uRuvanE"],["அழைக்கின்ற அடி நாயேன் * நாய் கூழை வாலால் *","குழைக்கின்றது போல * என் உள்ளம் குழையும் **","மழைக்கு அன்று குன்றம் எடுத்து * ஆநிரை காத்தாய்! *","பிழைக்கின்றது அருள் என்று * பேது உறுவனே"],0,"/media/recitation/TVM.9.4.3.mp3"],[3709,3709,["uRuvadhu idhu enRu * unakku ATpaTTu * nin kaN","peRuvadhu edhu kol enRu * pEdhaiyEn nenjcham **","maRugal seyyum * vAnavar dhAnavarkku enRum *","aRivadhu ariya * ari Aya ammAnE!"],["உறுவது இது என்று * உனக்கு ஆட்பட்டு * நின் கண்","பெறுவது எது கொல் என்று * பேதையேன் நெஞ்சம் **","மறுகல் செய்யும் * வானவர் தானவர்க்கு என்றும் *","அறிவது அரிய * அரி ஆய அம்மானே!"],0,"/media/recitation/TVM.9.4.4.mp3"],[3710,3710,["ari Aya ammAnai * amarar pirAnai *","periyAnaip * piramanai mun paDaiththAnai **","vari vAL aravin aNaip * paLLi koLginRa *","kariyAn kazhal kANak * karudhum karuththE"],["அரி ஆய அம்மானை * அமரர் பிரானை *","பெரியானைப் * பிரமனை முன் படைத்தானை **","வரி வாள் அரவின் அணைப் * பள்ளி கொள்கின்ற *","கரியான் கழல் காணக் * கருதும் கருத்தே"],0,"/media/recitation/TVM.9.4.5.mp3"],[3711,3711,["karuththE! unnaik * kANak karudhi * en nenjchaththu","iruththAga iruththinEn * dhEvargaTku ellAm","viruththA! ** viLanggum suDarch sOdhi * uyarath","thoruththA! * unnai uLLum * en uLLam ugandhE"],["கருத்தே! உன்னைக் * காணக் கருதி * என் நெஞ்சத்து","இருத்தாக இருத்தினேன் * தேவர்கட்கு எல்லாம்","விருத்தா! ** விளங்கும் சுடர்ச் சோதி * உயரத்","தொருத்தா! * உன்னை உள்ளும் * என் உள்ளம் உகந்தே"],0,"/media/recitation/TVM.9.4.6.mp3"],[3712,3712,["ugandhE unnai * uLLum en uLLaththu * agam pAl","agandhAn amarndhE * iDam koNDa amalA! **","migum dhAnavan mArvu agalam * iru kURA","nagandhAy * narasinggam adhAya uruvE!"],["உகந்தே உன்னை * உள்ளும் என் உள்ளத்து * அகம் பால்","அகந்தான் அமர்ந்தே * இடம் கொண்ட அமலா! **","மிகும் தானவன் மார்வு அகலம் * இரு கூறா","நகந்தாய் * நரசிங்கம் அதாய உருவே!"],0,"/media/recitation/TVM.9.4.7.mp3"],[3713,3713,["uru Agiya * ARu samayanggaTku ellAm *","poru Agi ninRAn * avan ellAp poruTkum **","aru Agiya Adhiyaith * dhEvargaTku ellAm *","karu Agiya kaNNanaik * kaNDu koNDEnE"],["உரு ஆகிய * ஆறு சமயங்கட்கு எல்லாம் *","பொரு ஆகி நின்றான் * அவன் எல்லாப் பொருட்கும் **","அரு ஆகிய ஆதியைத் * தேவர்கட்கு எல்லாம் *","கரு ஆகிய கண்ணனைக் * கண்டு கொண்டேனே"],0,"/media/recitation/TVM.9.4.8.mp3"],[3714,3714,["kaNDu koNDu * en kaN iNai Arak kaLiththu *","paNDai vinai Ayina * paRRODu aRuththu **","thoNDarkku amudhu uNNach * sol mAlaigaL sonnEn *","aNDaththu amarar perumAn * aDiyEnE"],["கண்டு கொண்டு * என் கண் இணை ஆரக் களித்து *","பண்டை வினை ஆயின * பற்றோடு அறுத்து **","தொண்டர்க்கு அமுது உண்ணச் * சொல் மாலைகள் சொன்னேன் *","அண்டத்து அமரர் பெருமான் * அடியேனே"],0,"/media/recitation/TVM.9.4.9.mp3"],[3715,3715,["aDiyAn ivan enRu * enakku AraruL seyyum","neDiyAnai * niRai pugazh anjchiRaip * puLLin","koDiyAnai ** kunRAmal * ulagam aLandha","aDiyAnai * aDaindhu aDiyEn uyndha ARE"],["அடியான் இவன் என்று * எனக்கு ஆரருள் செய்யும்","நெடியானை * நிறை புகழ் அஞ்சிறைப் * புள்ளின்","கொடியானை ** குன்றாமல் * உலகம் அளந்த","அடியானை * அடைந்து அடியேன் உய்ந்த ஆறே"],0,"/media/recitation/TVM.9.4.10.mp3"],[3716,3716,["** ARA madha yAnai * aDarththavan thannai *","sERAr vayal * thenkurugUrch saDakOpan **","nURE sonna * Or AyiraththuL ippaththum *","ERE tharum * vAnavar tham innuyirkkE"],["** ஆறா மத யானை * அடர்த்தவன் தன்னை *","சேறார் வயல் * தென்குருகூர்ச் சடகோபன் **","நூறே சொன்ன * ஓர் ஆயிரத்துள் இப்பத்தும் *","ஏறே தரும் * வானவர் தம் இன்னுயிர்க்கே"],0,"/media/recitation/TVM.9.4.11.mp3"]],[[3717,3717,["** in uyirch sEvalum nIrum kUvik koNDu * inggu eththanai *","en uyir nOva mizhaRRElmin * kuyil pEDaigAL! **","en uyirk kaNNa pirAnai * nIr varak kUvugilIr *","en uyir kUvik koDuppArkkum * iththanai vENDumO?"],["** இன் உயிர்ச் சேவலும் நீரும் கூவிக் கொண்டு * இங்கு எத்தனை *","என் உயிர் நோவ மிழற்றேல்மின் * குயில் பேடைகாள்! **","என் உயிர்க் கண்ண பிரானை * நீர் வரக் கூவுகிலீர் *","என் உயிர் கூவிக் கொடுப்பார்க்கும் * இத்தனை வேண்டுமோ?"],0,"/media/recitation/TVM.9.5.1.mp3"],[3718,3718,["iththanai vENDuvadhu anRu andhO! * anRil pEDaigAL! *","eththanai nIrum num sEvalum * karaindhu Enggudhir **","viththagan gOvindhan * meyyan allan oruvarkkum *","aththanaiyAm ini * en uyir avan kaiyadhE"],["இத்தனை வேண்டுவது அன்று அந்தோ! * அன்றில் பேடைகாள்! *","எத்தனை நீரும் நும் சேவலும் * கரைந்து ஏங்குதிர் **","வித்தகன் கோவிந்தன் * மெய்யன் அல்லன் ஒருவர்க்கும் *","அத்தனையாம் இனி * என் உயிர் அவன் கையதே"],0,"/media/recitation/TVM.9.5.2.mp3"],[3719,3719,["avan kaiyadhE enadhu Aruyir * anRil pEDaigAL! *","evam solli nIr kuDaindhu ADudhir * puDai sUzhavE **","thavam seydhillA * vinaiyATTiyEn uyir inggu uNDO? *","evam solli niRRum? * num Enggu kUkkural kETTumE"],["அவன் கையதே எனது ஆருயிர் * அன்றில் பேடைகாள்! *","எவம் சொல்லி நீர் குடைந்து ஆடுதிர் * புடை சூழவே **","தவம் செய்தில்லா * வினையாட்டியேன் உயிர் இங்கு உண்டோ? *","எவம் சொல்லி நிற்றும்? * நும் ஏங்கு கூக்குரல் கேட்டுமே"],0,"/media/recitation/TVM.9.5.3.mp3"],[3720,3720,["kUkkural kETTum * nam kaNNan mAyan veLippaDAn *","mER kiLai koLLEnmin * nIrum sEvalum kOzhigAL! **","vAkkum manamum * karumamum namakku AnggadhE *","Akkaiyum Aviyum * andharam ninRu uzhalumE"],["கூக்குரல் கேட்டும் * நம் கண்ணன் மாயன் வெளிப்படான் *","மேற் கிளை கொள்ளேன்மின் * நீரும் சேவலும் கோழிகாள்! **","வாக்கும் மனமும் * கருமமும் நமக்கு ஆங்கதே *","ஆக்கையும் ஆவியும் * அந்தரம் நின்று உழலுமே"],0,"/media/recitation/TVM.9.5.4.mp3"],[3721,3721,["andharam ninRu uzhalginRa * yAnuDaip pUvaigAL! *","num thiRaththu Edhum iDai illai * kuzhaREnminO **","indhira njAlanggaL kATTi * ivvEzhulagum koNDa *","nam thirumArban * nam Avi uNNa nanku eNNinAn"],["அந்தரம் நின்று உழல்கின்ற * யானுடைப் பூவைகாள்! *","நும் திறத்து ஏதும் இடை இல்லை * குழறேன்மினோ **","இந்திர ஞாலங்கள் காட்டி * இவ்வேழுலகும் கொண்ட *","நம் திருமார்பன் * நம் ஆவி உண்ண நன்கு எண்ணினான்"],0,"/media/recitation/TVM.9.5.5.mp3"],[3722,3722,["nanku eNNi nAn vaLarththa * siRu kiLip paidhalE! *","in kural nI mizhaRREl * en Aruyirk kAguththan **","nin seyya vAy okkum vAyan * kaNNan kai kAlinan *","nin pasunjchAma niRaththan * kUTTuNDu nIngginAn"],["நன்கு எண்ணி நான் வளர்த்த * சிறு கிளிப் பைதலே! *","இன் குரல் நீ மிழற்றேல் * என் ஆருயிர்க் காகுத்தன் **","நின் செய்ய வாய் ஒக்கும் வாயன் * கண்ணன் கை காலினன் *","நின் பசுஞ்சாம நிறத்தன் * கூட்டுண்டு நீங்கினான்"],0,"/media/recitation/TVM.9.5.6.mp3"],[3723,3723,["kUTTuNDu nInggiya * kOlath thAmaraik kaN sevvAy *","vATTamil en karu mANikkam * kaNNan mAyan pOl **","kOTTiya villoDu * minnu mEgak kuzhAnggaLgAL! *","kATTEnmin num uru * en uyirkku adhu kAlanE"],["கூட்டுண்டு நீங்கிய * கோலத் தாமரைக் கண் செவ்வாய் *","வாட்டமில் என் கரு மாணிக்கம் * கண்ணன் மாயன் போல் **","கோட்டிய வில்லொடு * மின்னு மேகக் குழாங்கள்காள்! *","காட்டேன்மின் நும் உரு * என் உயிர்க்கு அது காலனே"],0,"/media/recitation/TVM.9.5.7.mp3"],[3724,3724,["uyirkku adhu kAlan enRu * ummai yAn irandhERku * nIr","kuyiR paidhalgAL! * kaNNan nAmamE kuzhaRik konRIr **","thayirp pazhanjchORRoDu * pAl aDisilum thandhu * sol","payiRRiya nal vaLam UTTinIr * paNbu uDaiyIrE!"],["உயிர்க்கு அது காலன் என்று * உம்மை யான் இரந்தேற்கு * நீர்","குயிற் பைதல்காள்! * கண்ணன் நாமமே குழறிக் கொன்றீர் **","தயிர்ப் பழஞ்சோற்றொடு * பால் அடிசிலும் தந்து * சொல்","பயிற்றிய நல் வளம் ஊட்டினீர் * பண்பு உடையீரே!"],0,"/media/recitation/TVM.9.5.8.mp3"],[3725,3725,["paNbuDai vaNDoDu thumbigAL! * paN mizhaRRElmin *","puN purai vEl koDu * kuththAl okkum num in kural **","thaN peru nIrth thaDanthAmarai * malarndhAl okkum","kaN perung kaNNan * nam Avi uNDu ezha naNNinAn"],["பண்புடை வண்டொடு தும்பிகாள்! * பண் மிழற்றேல்மின் *","புண் புரை வேல் கொடு * குத்தால் ஒக்கும் நும் இன் குரல் **","தண் பெரு நீர்த் தடந்தாமரை * மலர்ந்தால் ஒக்கும்","கண் பெருங் கண்ணன் * நம் ஆவி உண்டு எழ நண்ணினான்"],0,"/media/recitation/TVM.9.5.9.mp3"],[3726,3726,["ezha naNNi nAmum * nam vAna nADanODu onRinOm *","pazhana nannAraik kuzhAnggaLgAL! * payinRu en ini? **","izhai nalla Akkaiyum * paiyavE puyakkaRRadhu *","thazhai nalla inbam thalaippeydhu * enggum thazhaikkavE"],["எழ நண்ணி நாமும் * நம் வான நாடனோடு ஒன்றினோம் *","பழன நன்னாரைக் குழாங்கள்காள்! * பயின்று என் இனி? **","இழை நல்ல ஆக்கையும் * பையவே புயக்கற்றது *","தழை நல்ல இன்பம் தலைப்பெய்து * எங்கும் தழைக்கவே"],0,"/media/recitation/TVM.9.5.10.mp3"],[3727,3727,["** inbam thalaippeydhu enggum thazhaiththa * pal Uzhikku *","than pugazh Eththath * thanakku aruL seydha mAyanai **","then kurugUrch saDakOpan * sol AyiraththuL ivai *","onbadhODu onRukkum * mUvulagum urugumE"],["** இன்பம் தலைப்பெய்து எங்கும் தழைத்த * பல் ஊழிக்கு *","தன் புகழ் ஏத்தத் * தனக்கு அருள் செய்த மாயனை **","தென் குருகூர்ச் சடகோபன் * சொல் ஆயிரத்துள் இவை *","ஒன்பதோடு ஒன்றுக்கும் * மூவுலகும் உருகுமே"],0,"/media/recitation/TVM.9.5.11.mp3"]],[[3728,3728,["** urugumAl nenjcham * uyirin param anRi *","perugumAl vETkaiyum * en seygEn thoNDanEn? **","theru ellAm kAvi kamazh * thirukkATkarai *","maruviya mAyan than * mAyam ninaithoRE"],["** உருகுமால் நெஞ்சம் * உயிரின் பரம் அன்றி *","பெருகுமால் வேட்கையும் * என் செய்கேன் தொண்டனேன்? **","தெரு எல்லாம் காவி கமழ் * திருக்காட்கரை *","மருவிய மாயன் தன் * மாயம் நினைதொறே"],0,"/media/recitation/TVM.9.6.1.mp3"],[3729,3729,["ninaithoRum sollunthoRum * nenjchu iDindhu ugum *","vinai koL sIr pADilum * vEm enadhu Aruyir **","sunai koL pUnjchOlaith * then kATkarai en appA! *","ninaigilEn nAn * unakku ATcheyyum nIrmaiyE"],["நினைதொறும் சொல்லுந்தொறும் * நெஞ்சு இடிந்து உகும் *","வினை கொள் சீர் பாடிலும் * வேம் எனது ஆருயிர் **","சுனை கொள் பூஞ்சோலைத் * தென் காட்கரை என் அப்பா! *","நினைகிலேன் நான் * உனக்கு ஆட்செய்யும் நீர்மையே"],0,"/media/recitation/TVM.9.6.2.mp3"],[3730,3730,["nIrmaiyAl nenjcham * vanjchiththup pugundhu * ennai","Irmai seydhu * en uyirAy en uyir uNDAn **","sIr malgu sOlaith * then kATkarai en appan *","kAr mugil vaNNaN than * kaLvam aRigilEn"],["நீர்மையால் நெஞ்சம் * வஞ்சித்துப் புகுந்து * என்னை","ஈர்மை செய்து * என் உயிராய் என் உயிர் உண்டான் **","சீர் மல்கு சோலைத் * தென் காட்கரை என் அப்பன் *","கார் முகில் வண்ணண் தன் * கள்வம் அறிகிலேன்"],0,"/media/recitation/TVM.9.6.3.mp3"],[3731,3731,["aRigilEn thannuL * anaiththu ulagum niRka *","neRimaiyAl thAnum * avaRRuL niRkum pirAn **","veRi kamazh sOlaith * then kATkarai en appan *","siRiya en Aruyir uNDa * thiruvaruLE"],["அறிகிலேன் தன்னுள் * அனைத்து உலகும் நிற்க *","நெறிமையால் தானும் * அவற்றுள் நிற்கும் பிரான் **","வெறி கமழ் சோலைத் * தென் காட்கரை என் அப்பன் *","சிறிய என் ஆருயிர் உண்ட * திருவருளே"],0,"/media/recitation/TVM.9.6.4.mp3"],[3732,3732,["thiru aruL seybavan pOla * ennuL pugundhu *","uruvamum Aruyirum * uDanE uNDAn **","thiru vaLar sOlaith * then kATkarai en appan *","karu vaLar mEni * en kaNNan kaLvanggaLE"],["திரு அருள் செய்பவன் போல * என்னுள் புகுந்து *","உருவமும் ஆருயிரும் * உடனே உண்டான் **","திரு வளர் சோலைத் * தென் காட்கரை என் அப்பன் *","கரு வளர் மேனி * என் கண்ணன் கள்வங்களே"],0,"/media/recitation/TVM.9.6.5.mp3"],[3733,3733,["en kaNNan kaLvam * enakkuch semmAy niRkum *","angkaNNan uNDa * en Aruyirk kOdhu idhu **","punkaNmai eydhip * pulambi irAp pagal *","en kaNNan enRu * avan kATkarai EththumE"],["என் கண்ணன் கள்வம் * எனக்குச் செம்மாய் நிற்கும் *","அங்கண்ணன் உண்ட * என் ஆருயிர்க் கோது இது **","புன்கண்மை எய்திப் * புலம்பி இராப் பகல் *","என் கண்ணன் என்று * அவன் காட்கரை ஏத்துமே"],0,"/media/recitation/TVM.9.6.6.mp3"],[3734,3734,["kATkarai Eththum * adhanuL kaNNA! ennum *","vETkai nOy kUra * ninaindhu karaindhu ugum **","ATkoLvAn oththu * en uyir uNDa mAyanAl *","kOTkuRai paTTadhu * en Aruyir kOL uNDE"],["காட்கரை ஏத்தும் * அதனுள் கண்ணா! என்னும் *","வேட்கை நோய் கூர * நினைந்து கரைந்து உகும் **","ஆட்கொள்வான் ஒத்து * என் உயிர் உண்ட மாயனால் *","கோட்குறை பட்டது * என் ஆருயிர் கோள் உண்டே"],0,"/media/recitation/TVM.9.6.7.mp3"],[3735,3735,["kOL uNDAn anRi vandhu * en uyir thAn uNDAn *","nALu nAL vandhu * ennai muRRavum thAn uNDAn **","kALa nIr mEgath * then kATkarai en appaRku *","ALanRE paTTadhu * en Aruyir paTTadhE"],["கோள் உண்டான் அன்றி வந்து * என் உயிர் தான் உண்டான் *","நாளு நாள் வந்து * என்னை முற்றவும் தான் உண்டான் **","காள நீர் மேகத் * தென் காட்கரை என் அப்பற்கு *","ஆளன்றே பட்டது * என் ஆருயிர் பட்டதே"],0,"/media/recitation/TVM.9.6.8.mp3"],[3736,3736,["Aruyir paTTadhu * enadhu uyir paTTadhu? *","pEr idhazhth thAmaraik kaN * kani vAy adhOr **","kAr ezhil mEgath * then kATkarai kOyil koL *","sIr ezhil nAl thaDanthOL * dheyva vArikkE"],["ஆருயிர் பட்டது * எனது உயிர் பட்டது? *","பேர் இதழ்த் தாமரைக் கண் * கனி வாய் அதோர் **","கார் எழில் மேகத் * தென் காட்கரை கோயில் கொள் *","சீர் எழில் நால் தடந்தோள் * தெய்வ வாரிக்கே"],0,"/media/recitation/TVM.9.6.9.mp3"],[3737,3737,["vArik koNDu * unnai vizhungguvan kANil enRu *","ArvuRRa ennai ozhiya * ennil munnam","pAriththu ** thAn ennai * muRRap paruginAn *","kAr okkum * kATkarai appan kaDiyanE"],["வாரிக் கொண்டு * உன்னை விழுங்குவன் காணில் என்று *","ஆர்வுற்ற என்னை ஒழிய * என்னில் முன்னம்","பாரித்து ** தான் என்னை * முற்றப் பருகினான் *","கார் ஒக்கும் * காட்கரை அப்பன் கடியனே"],0,"/media/recitation/TVM.9.6.10.mp3"],[3738,3738,["** kaDiyanAyk * kanjchanaik konRa pirAn thannai *","koDi madhiL then kurugUrch * saDakOpan ** sol","vaDivamai Ayiraththu * ippaththinAl sanmam","muDivu eydhi * nAsam kaNDIrgaL engkAnalE"],["** கடியனாய்க் * கஞ்சனைக் கொன்ற பிரான் தன்னை *","கொடி மதிள் தென் குருகூர்ச் * சடகோபன் ** சொல்","வடிவமை ஆயிரத்து * இப்பத்தினால் சன்மம்","முடிவு எய்தி * நாசம் கண்டீர்கள் எங்கானலே"],0,"/media/recitation/TVM.9.6.11.mp3"]],[[3739,3739,["** engkAnal agam kazhivAy * iraith thErndhu inggu inidhu amarum *","sengkAla maDa nArAy! * thirumUzhikkaLaththu uRaiyum **","konggAr pUnthuzhAy muDi * em kuDak kUththarkku en thUdhAy *","nungkAlgaL en thalai mEl * kezhumIrO numarODE"],["** எங்கானல் அகம் கழிவாய் * இரைத் தேர்ந்து இங்கு இனிது அமரும் *","செங்கால மட நாராய்! * திருமூழிக்களத்து உறையும் **","கொங்கார் பூந்துழாய் முடி * எம் குடக் கூத்தர்க்கு என் தூதாய் *","நுங்கால்கள் என் தலை மேல் * கெழுமீரோ நுமரோடே"],0,"/media/recitation/TVM.9.7.1.mp3"],[3740,3740,["numarODum piriyAdhE * nIrum num sEvalumAy *","amar kAdhal kurugu inanggAL! * aNi mUzhikkaLaththu uRaiyum **","emarAlum pazhippuNDu * inggu en? thammAl izhippuNDu *","thamarODu anggu uRaivArkkuth * thakkilamE? kELIrE"],["நுமரோடும் பிரியாதே * நீரும் நும் சேவலுமாய் *","அமர் காதல் குருகு இனங்காள்! * அணி மூழிக்களத்து உறையும் **","எமராலும் பழிப்புண்டு * இங்கு என்? தம்மால் இழிப்புண்டு *","தமரோடு அங்கு உறைவார்க்குத் * தக்கிலமே? கேளீரே"],0,"/media/recitation/TVM.9.7.2.mp3"],[3741,3741,["thakkilamE? kELIrgaL * thaDam punal vAy irai thErum *","kokku inanggAL! kurugu inanggAL! * kuLir mUzhikkaLaththu uRaiyum **","sekkamalaththu alar pOlum * kaN kai kAl sengkani vAy *","akkamalaththu ilai pOlum * thirumEni aDigaLukkE"],["தக்கிலமே? கேளீர்கள் * தடம் புனல் வாய் இரை தேரும் *","கொக்கு இனங்காள்! குருகு இனங்காள்! * குளிர் மூழிக்களத்து உறையும் **","செக்கமலத்து அலர் போலும் * கண் கை கால் செங்கனி வாய் *","அக்கமலத்து இலை போலும் * திருமேனி அடிகளுக்கே"],0,"/media/recitation/TVM.9.7.3.mp3"],[3742,3742,["thirumEni aDigaLukkuth * thI vinaiyEn viDu thUdhAy *","thirumUzhikkaLam ennum * sezhu nagar vAy aNi mugilgAL! **","thirumEni avaTku aruLIr * enRakkAl ummaith than *","thirumEni oLi agaRRith * theLi visumbu kaDiyumE?"],["திருமேனி அடிகளுக்குத் * தீ வினையேன் விடு தூதாய் *","திருமூழிக்களம் என்னும் * செழு நகர் வாய் அணி முகில்காள்! **","திருமேனி அவட்கு அருளீர் * என்றக்கால் உம்மைத் தன் *","திருமேனி ஒளி அகற்றித் * தெளி விசும்பு கடியுமே?"],0,"/media/recitation/TVM.9.7.4.mp3"],[3743,3743,["theLi visumbu kaDidhu ODith * thI vaLaiththu min ilagum *","oLi mugilgAL! * thirumUzhikkaLaththu uRaiyum oNsuDarkku **","theLi visumbu thiru nADAth * thI vinaiyEn manaththu uRaiyum *","thuLi vAr kaTkuzhalArkku * en thUdhu uraiththal seppuminE"],["தெளி விசும்பு கடிது ஓடித் * தீ வளைத்து மின் இலகும் *","ஒளி முகில்காள்! * திருமூழிக்களத்து உறையும் ஒண்சுடர்க்கு **","தெளி விசும்பு திரு நாடாத் * தீ வினையேன் மனத்து உறையும் *","துளி வார் கட்குழலார்க்கு * என் தூது உரைத்தல் செப்புமினே"],0,"/media/recitation/TVM.9.7.5.mp3"],[3744,3744,["thUdhu uraiththal seppumingaL * thU mozhi vAy vaNDu inanggAL! *","pOdhu iraiththu madhu nugarum * pozhil mUzhikkaLaththu uRaiyum **","mAdharaith tham mArvagaththE * vaiththArkku en vAy mARRam *","thUdhu uraiththal seppudhirEl * suDar vaLaiyum kalaiyumE"],["தூது உரைத்தல் செப்புமின்கள் * தூ மொழி வாய் வண்டு இனங்காள்! *","போது இரைத்து மது நுகரும் * பொழில் மூழிக்களத்து உறையும் **","மாதரைத் தம் மார்வகத்தே * வைத்தார்க்கு என் வாய் மாற்றம் *","தூது உரைத்தல் செப்புதிரேல் * சுடர் வளையும் கலையுமே"],0,"/media/recitation/TVM.9.7.6.mp3"],[3745,3745,["suDar vaLaiyum kalaiyum koNDu * aruvinaiyEn thOL thuRandha *","paDar pugazhAn * thirumUzhikkaLaththu uRaiyum panggayak kaN **","suDar pavaLa vAyanaik kaNDu * oru nAL Or thUy mARRam *","paDar pozhil vAyk kurugu inanggAL! * enakku onRu paNiyIrE"],["சுடர் வளையும் கலையும் கொண்டு * அருவினையேன் தோள் துறந்த *","படர் புகழான் * திருமூழிக்களத்து உறையும் பங்கயக் கண் **","சுடர் பவள வாயனைக் கண்டு * ஒரு நாள் ஓர் தூய் மாற்றம் *","படர் பொழில் வாய்க் குருகு இனங்காள்! * எனக்கு ஒன்று பணியீரே"],0,"/media/recitation/TVM.9.7.7.mp3"],[3746,3746,["enakku onRu paNiyIrgaL * irum pozhil vAy irai thErndhu *","manakku inbam paDa mEvum * vaNDu inanggAL! thumbigAL! **","kanak koL thiN madhiL puDai sUzh * thirumUzhikkaLaththu uRaiyum *","punak koL kAyA mEnip * pUnthuzhAy muDiyArkkE"],["எனக்கு ஒன்று பணியீர்கள் * இரும் பொழில் வாய் இரை தேர்ந்து *","மனக்கு இன்பம் பட மேவும் * வண்டு இனங்காள்! தும்பிகாள்! **","கனக் கொள் திண் மதிள் புடை சூழ் * திருமூழிக்களத்து உறையும் *","புனக் கொள் காயா மேனிப் * பூந்துழாய் முடியார்க்கே"],0,"/media/recitation/TVM.9.7.8.mp3"],[3747,3747,["pUnthuzhAy muDiyArkkup * pon Azhik kaiyArukku *","Endhu nIr iLangkurugE! * thirumUzhikkaLaththArukku **","Endhu pUN mulai payandhu * en iNai malark kaN nIr thadhumba *","thAm thammaik koNDu agaldhal * thagavanRu enRu uraiyIrE"],["பூந்துழாய் முடியார்க்குப் * பொன் ஆழிக் கையாருக்கு *","ஏந்து நீர் இளங்குருகே! * திருமூழிக்களத்தாருக்கு **","ஏந்து பூண் முலை பயந்து * என் இணை மலர்க் கண் நீர் ததும்ப *","தாம் தம்மைக் கொண்டு அகல்தல் * தகவன்று என்று உரையீரே"],0,"/media/recitation/TVM.9.7.9.mp3"],[3748,3748,["thagavanRu enRu uraiyIrgaL * thaDam punal vAy irai thErndhu *","miga inbam paDa mEvum * men naDaiya annanggAL! **","miga mEni melivu eydhi * mEgalaiyum IDu azhindhu * en","agamEni ozhiyAmE * thirumUzhikkaLaththArkkE"],["தகவன்று என்று உரையீர்கள் * தடம் புனல் வாய் இரை தேர்ந்து *","மிக இன்பம் பட மேவும் * மென் நடைய அன்னங்காள்! **","மிக மேனி மெலிவு எய்தி * மேகலையும் ஈடு அழிந்து * என்","அகமேனி ஒழியாமே * திருமூழிக்களத்தார்க்கே"],0,"/media/recitation/TVM.9.7.10.mp3"],[3749,3749,["** ozhivu inRith thirumUzhikkaLaththu uRaiyum * oNsuDarai *","ozhivillA aNi mazhalaik * kiLi mozhiyAL alaRRiya sol **","vazhu illA vaN kurugUrch * saDakOpan vAyndhu uraiththa *","azhivillA Ayiraththu ippaththum * nOy aRukkumE"],["** ஒழிவு இன்றித் திருமூழிக்களத்து உறையும் * ஒண்சுடரை *","ஒழிவில்லா அணி மழலைக் * கிளி மொழியாள் அலற்றிய சொல் **","வழு இல்லா வண் குருகூர்ச் * சடகோபன் வாய்ந்து உரைத்த *","அழிவில்லா ஆயிரத்து இப்பத்தும் * நோய் அறுக்குமே"],0,"/media/recitation/TVM.9.7.11.mp3"]],[[3750,3750,["** aRukkum vinai Ayina * Agaththu avanai *","niRuththum manaththu onRiya * sindhaiyinArkku **","veRith thaN malarch sOlaigaL sUzh * thirunAvAy *","kuRukkum vagai uNDu kolO? * koDiyERkE"],["** அறுக்கும் வினை ஆயின * ஆகத்து அவனை *","நிறுத்தும் மனத்து ஒன்றிய * சிந்தையினார்க்கு **","வெறித் தண் மலர்ச் சோலைகள் சூழ் * திருநாவாய் *","குறுக்கும் வகை உண்டு கொலோ? * கொடியேற்கே"],0,"/media/recitation/TVM.9.8.1.mp3"],[3751,3751,["koDi Er iDaik * kOkanagaththavaL kELvan *","vaDi vEl thaDangkaN * maDap pinnai maNALan **","neDiyAn uRai sOlaigaL sUzh * thirunAvAy *","aDiyEn aNugap peRu nAL * evai kolo?"],["கொடி ஏர் இடைக் * கோகனகத்தவள் கேள்வன் *","வடி வேல் தடங்கண் * மடப் பின்னை மணாளன் **","நெடியான் உறை சோலைகள் சூழ் * திருநாவாய் *","அடியேன் அணுகப் பெறு நாள் * எவை கொலொ?"],0,"/media/recitation/TVM.9.8.2.mp3"],[3752,3752,["evai kol aNugap peRu nAL? * enRu eppOdhum *","kavaiyil manam inRik * kaNNIrgaL kaluzhvan **","navaiyil thirunAraNan sEr * thirunAvAy *","avaiyuL pugal Avadhu * Or nAL aRiyEnE"],["எவை கொல் அணுகப் பெறு நாள்? * என்று எப்போதும் *","கவையில் மனம் இன்றிக் * கண்ணீர்கள் கலுழ்வன் **","நவையில் திருநாரணன் சேர் * திருநாவாய் *","அவையுள் புகல் ஆவது * ஓர் நாள் அறியேனே"],0,"/media/recitation/TVM.9.8.3.mp3"],[3753,3753,["nALEl aRiyEn * enakku uLLana * nAnum","mILA aDimaip * paNi seyyap pugundhEn **","nILAr malarch sOlaigaL sUzh * thirunAvAy *","vALEy thaDangkaN * maDap pinnai maNALA!"],["நாளேல் அறியேன் * எனக்கு உள்ளன * நானும்","மீளா அடிமைப் * பணி செய்யப் புகுந்தேன் **","நீளார் மலர்ச் சோலைகள் சூழ் * திருநாவாய் *","வாளேய் தடங்கண் * மடப் பின்னை மணாளா!"],0,"/media/recitation/TVM.9.8.4.mp3"],[3754,3754,["maNALan malar manggaikkum * maN maDandhaikkum *","kaNNALan * ulagaththu uyir dhEvargaTku ellAm **","viNNALan virumbi uRaiyum * thirunAvAy *","kaN Arak kaLikkinRadhu * inggu enRu kol kaNDE?"],["மணாளன் மலர் மங்கைக்கும் * மண் மடந்தைக்கும் *","கண்ணாளன் * உலகத்து உயிர் தேவர்கட்கு எல்லாம் **","விண்ணாளன் விரும்பி உறையும் * திருநாவாய் *","கண் ஆரக் களிக்கின்றது * இங்கு என்று கொல் கண்டே?"],0,"/media/recitation/TVM.9.8.5.mp3"],[3755,3755,["kaNDE kaLikkinRadhu * inggu enRu kol? kaNgaL *","thoNDE unakkAy ozhindhEn * thurisu inRi **","vaNDAr malarch sOlaigaL sUzh * thirunAvAy *","koNDE uRaiginRa * em kOvalar kOvE!"],["கண்டே களிக்கின்றது * இங்கு என்று கொல்? கண்கள் *","தொண்டே உனக்காய் ஒழிந்தேன் * துரிசு இன்றி **","வண்டார் மலர்ச் சோலைகள் சூழ் * திருநாவாய் *","கொண்டே உறைகின்ற * எம் கோவலர் கோவே!"],0,"/media/recitation/TVM.9.8.6.mp3"],[3756,3756,["kO Agiya mAvaliyai * nilam koNDAy! *","dhEvAsuram seRRavanE! * thirumAlE! **","nAvAy uRaiginRa * en nAraNa nambI! *","AvA! aDiyAn * ivan enRu aruLAyE"],["கோ ஆகிய மாவலியை * நிலம் கொண்டாய்! *","தேவாசுரம் செற்றவனே! * திருமாலே! **","நாவாய் உறைகின்ற * என் நாரண நம்பீ! *","ஆவா! அடியான் * இவன் என்று அருளாயே"],0,"/media/recitation/TVM.9.8.7.mp3"],[3757,3757,["aruLAdhu ozhivAy * aruL seydhu * aDiyEnaip","poruL Akki * un pon aDik kIzhp puga vaippAy **","maruLE inRi * unnai en nenjchaththu iruththum *","theruLE tharu * then thirunAvAy en dhEvE!"],["அருளாது ஒழிவாய் * அருள் செய்து * அடியேனைப்","பொருள் ஆக்கி * உன் பொன் அடிக் கீழ்ப் புக வைப்பாய் **","மருளே இன்றி * உன்னை என் நெஞ்சத்து இருத்தும் *","தெருளே தரு * தென் திருநாவாய் என் தேவே!"],0,"/media/recitation/TVM.9.8.8.mp3"],[3758,3758,["dhEvar munivarkku enRum * kANDaRku ariyan *","mUvar mudhalvan * oru mUvulagu ALi **","dhEvan virumbi uRaiyum * thirunAvAy *","yAvar aNugap peRuvAr * ini andhO!"],["தேவர் முனிவர்க்கு என்றும் * காண்டற்கு அரியன் *","மூவர் முதல்வன் * ஒரு மூவுலகு ஆளி **","தேவன் விரும்பி உறையும் * திருநாவாய் *","யாவர் அணுகப் பெறுவார் * இனி அந்தோ!"],0,"/media/recitation/TVM.9.8.9.mp3"],[3759,3759,["andhO! aNugap peRu nAL * enRu eppOdhum *","sindhai kalanggith * thirumAl! enRu azhaippan **","kondhAr malarch sOlaigaL sUzh * thirunAvAy *","vandhE uRaiginRa * em mA maNi vaNNA!"],["அந்தோ! அணுகப் பெறு நாள் * என்று எப்போதும் *","சிந்தை கலங்கித் * திருமால்! என்று அழைப்பன் **","கொந்தார் மலர்ச் சோலைகள் சூழ் * திருநாவாய் *","வந்தே உறைகின்ற * எம் மா மணி வண்ணா!"],0,"/media/recitation/TVM.9.8.10.mp3"],[3760,3760,["** vaNNam maNi mADa * nal nAvAy uLLAnai *","thiN ammadhiL * then kurugUrch saDakOpan **","paNNAr thamizh * Ayiraththu ippaththum vallAr *","maNNANDu * maNam kamazhvar malligaiyE"],["** வண்ணம் மணி மாட * நல் நாவாய் உள்ளானை *","திண் அம்மதிள் * தென் குருகூர்ச் சடகோபன் **","பண்ணார் தமிழ் * ஆயிரத்து இப்பத்தும் வல்லார் *","மண்ணாண்டு * மணம் கமழ்வர் மல்லிகையே"],0,"/media/recitation/TVM.9.8.11.mp3"]],[[3761,3761,["** malligai kamazh thenRal Irum AlO! *","vaN kuRinjchi isai thavazhum AlO! *","sel kadhir mAlaiyum mayakkum AlO! *","sekkar nal mEganggaL sidhaikkum AlO! **","alli anthAmaraik kaNNan emmAn *","AyargaL ERu ari ERu em mAyOn *","pulliya mulaigaLum thOLum koNDu *","pugal iDam aRigilam thamiyam AlO!"],["** மல்லிகை கமழ் தென்றல் ஈரும் ஆலோ! *","வண் குறிஞ்சி இசை தவழும் ஆலோ! *","செல் கதிர் மாலையும் மயக்கும் ஆலோ! *","செக்கர் நல் மேகங்கள் சிதைக்கும் ஆலோ! **","அல்லி அந்தாமரைக் கண்ணன் எம்மான் *","ஆயர்கள் ஏறு அரி ஏறு எம் மாயோன் *","புல்லிய முலைகளும் தோளும் கொண்டு *","புகல் இடம் அறிகிலம் தமியம் ஆலோ!"],0,"/media/recitation/TVM.9.9.1.mp3"],[3762,3762,["pugal iDam aRigilam thamiyam AlO! *","pulambuRu maNi thenRal Ambal AlO! *","pagal aDu mAlai vaN sAndham AlO! *","panjchamam mullai thaN vADai AlO! **","agal iDam paDaiththu iDandhu uNDu umizhndhu","aLandhu * enggum aLikkinRa Ayan mAyOn *","igal iDaththu asurargaL kURRam vArAn *","ini irundhu en uyir kAkkum ARu en?"],["புகல் இடம் அறிகிலம் தமியம் ஆலோ! *","புலம்புறு மணி தென்றல் ஆம்பல் ஆலோ! *","பகல் அடு மாலை வண் சாந்தம் ஆலோ! *","பஞ்சமம் முல்லை தண் வாடை ஆலோ! **","அகல் இடம் படைத்து இடந்து உண்டு உமிழ்ந்து","அளந்து * எங்கும் அளிக்கின்ற ஆயன் மாயோன் *","இகல் இடத்து அசுரர்கள் கூற்றம் வாரான் *","இனி இருந்து என் உயிர் காக்கும் ஆறு என்?"],0,"/media/recitation/TVM.9.9.2.mp3"],[3763,3763,["ini irundhu en uyir kAkkum ARu en? *","iNai mulai namuga nuN iDai nuDangga *","thuni irungkalavi seydhu Agam thOyndhu *","thuRandhu emmai iTTu agal kaNNan kaLvan **","thani iLam singgam em mAyan vArAn *","thAmaraik kaNNum sevvAyum * nIlap","pani irungkuzhalgaLum nAnku thOLum *","pAviyEn manaththE ninRu Irum AlO!"],["இனி இருந்து என் உயிர் காக்கும் ஆறு என்? *","இணை முலை நமுக நுண் இடை நுடங்க *","துனி இருங்கலவி செய்து ஆகம் தோய்ந்து *","துறந்து எம்மை இட்டு அகல் கண்ணன் கள்வன் **","தனி இளம் சிங்கம் எம் மாயன் வாரான் *","தாமரைக் கண்ணும் செவ்வாயும் * நீலப்","பனி இருங்குழல்களும் நான்கு தோளும் *","பாவியேன் மனத்தே நின்று ஈரும் ஆலோ!"],0,"/media/recitation/TVM.9.9.3.mp3"],[3764,3764,["pAviyEn manaththE ninRu Irum AlO! *","vADai thaN vADai vevvADai AlO! *","mEvu thaN madhiyam vemmadhiyam AlO! *","menmalarp paLLi vempaLLi AlO! **","thUvi ampuL uDaith dheyva vaNDu","thudhaindha * em peNmai ampU idhAlO! *","Aviyin param alla vagaigaL AlO! *","yAm uDai nenjchamum thuNai anRu AlO!"],["பாவியேன் மனத்தே நின்று ஈரும் ஆலோ! *","வாடை தண் வாடை வெவ்வாடை ஆலோ! *","மேவு தண் மதியம் வெம்மதியம் ஆலோ! *","மென்மலர்ப் பள்ளி வெம்பள்ளி ஆலோ! **","தூவி அம்புள் உடைத் தெய்வ வண்டு","துதைந்த * எம் பெண்மை அம்பூ இதாலோ! *","ஆவியின் பரம் அல்ல வகைகள் ஆலோ! *","யாம் உடை நெஞ்சமும் துணை அன்று ஆலோ!"],0,"/media/recitation/TVM.9.9.4.mp3"],[3765,3765,["yAm uDai nenjchamum thuNai anRAlO! *","A pugum mAlaiyum AginRAlO! *","yAm uDai Ayan than manam kal AlO! *","avanuDaith thIngkuzhal Irum AlO! **","yAm uDaith thuNai ennum thOzhimArum *","emmin mun avanukkum Ayvar AlO! *","yAm uDai Ar uyir kAkkum ARu en? *","avan uDai aruL peRum pOdhu aridhE"],["யாம் உடை நெஞ்சமும் துணை அன்றாலோ! *","ஆ புகும் மாலையும் ஆகின்றாலோ! *","யாம் உடை ஆயன் தன் மனம் கல் ஆலோ! *","அவனுடைத் தீங்குழல் ஈரும் ஆலோ! **","யாம் உடைத் துணை என்னும் தோழிமாரும் *","எம்மின் முன் அவனுக்கும் ஆய்வர் ஆலோ! *","யாம் உடை ஆர் உயிர் காக்கும் ஆறு என்? *","அவன் உடை அருள் பெறும் போது அரிதே"],0,"/media/recitation/TVM.9.9.5.mp3"],[3766,3766,["avan uDai aruL peRum pOdhu aridhAl *","avvaruL allana aruLum alla *","avan aruL peRum aLavu Avi nillAdhu *","aDu pagal mAlaiyum nenjchum kANEn **","sivanoDu piraman vaN thirumaDandhai *","sEr thiru Agam em Avi Irum *","evam inip pugum iDam? evan seygEnO? *","Arukku en sollugEn? annaimIrgAL!"],["அவன் உடை அருள் பெறும் போது அரிதால் *","அவ்வருள் அல்லன அருளும் அல்ல *","அவன் அருள் பெறும் அளவு ஆவி நில்லாது *","அடு பகல் மாலையும் நெஞ்சும் காணேன் **","சிவனொடு பிரமன் வண் திருமடந்தை *","சேர் திரு ஆகம் எம் ஆவி ஈரும் *","எவம் இனிப் புகும் இடம்? எவன் செய்கேனோ? *","ஆருக்கு என் சொல்லுகேன்? அன்னைமீர்காள்!"],0,"/media/recitation/TVM.9.9.6.mp3"],[3767,3767,["Arukku en sollugEn? annaimIrgAL! *","Ar uyir aLavu anRu ikkUr thaN vADai *","kAr okkum mEni nam kaNNan kaLvam *","kavarndha aththani nenjcham avan kaNaqdhE **","sIr uRRa agiRpugai yAzh narambu *","panjchamam thaN pasunjchAndhu aNaindhu *","pOr uRRa vADai thaN malligaip pUp *","pudhu maNam mugandhu koNDu eRiyum AlO!"],["ஆருக்கு என் சொல்லுகேன்? அன்னைமீர்காள்! *","ஆர் உயிர் அளவு அன்று இக்கூர் தண் வாடை *","கார் ஒக்கும் மேனி நம் கண்ணன் கள்வம் *","கவர்ந்த அத்தனி நெஞ்சம் அவன் கணஃதே **","சீர் உற்ற அகிற்புகை யாழ் நரம்பு *","பஞ்சமம் தண் பசுஞ்சாந்து அணைந்து *","போர் உற்ற வாடை தண் மல்லிகைப் பூப் *","புது மணம் முகந்து கொண்டு எறியும் ஆலோ!"],0,"/media/recitation/TVM.9.9.7.mp3"],[3768,3768,["pudhu maNam mugandhu koNDu eRiyum AlO! *","ponggu iLa vADai pun sekkar AlO! *","adhu maNandhu aganRa nam kaNNan kaLvam *","kaNNaniR koDidhu ini adhanil umbar **","madhu maNa malligai mandhak kOvai *","vaN pasunjchAndhinil panjchamam vaiththu *","adhu maNandhu in aruL AychchiyarkkE *","Udhum aththIngkuzhaRkE uyyEn nAn"],["புது மணம் முகந்து கொண்டு எறியும் ஆலோ! *","பொங்கு இள வாடை புன் செக்கர் ஆலோ! *","அது மணந்து அகன்ற நம் கண்ணன் கள்வம் *","கண்ணனிற் கொடிது இனி அதனில் உம்பர் **","மது மண மல்லிகை மந்தக் கோவை *","வண் பசுஞ்சாந்தினில் பஞ்சமம் வைத்து *","அது மணந்து இன் அருள் ஆய்ச்சியர்க்கே *","ஊதும் அத்தீங்குழற்கே உய்யேன் நான்"],0,"/media/recitation/TVM.9.9.8.mp3"],[3769,3769,["Udhum aththIngkuzhaRkE uyyEn nAn *","adhu mozhindhu iDai iDaith than sey kOlath *","thUdhu sey kaNgaL koNDu onRu pEsith *","thU mozhi isaigaL koNDu onRu nOkki **","pEdhuRu mugam seydhu nondhu nondhu *","pEdhai nenjchu aRavaRap pADum pATTai *","yAdhum onRu aRigilam amma! amma! *","mAlaiyum vandhadhu mAyan vArAn"],["ஊதும் அத்தீங்குழற்கே உய்யேன் நான் *","அது மொழிந்து இடை இடைத் தன் செய் கோலத் *","தூது செய் கண்கள் கொண்டு ஒன்று பேசித் *","தூ மொழி இசைகள் கொண்டு ஒன்று நோக்கி **","பேதுறு முகம் செய்து நொந்து நொந்து *","பேதை நெஞ்சு அறவறப் பாடும் பாட்டை *","யாதும் ஒன்று அறிகிலம் அம்ம! அம்ம! *","மாலையும் வந்தது மாயன் வாரான்"],0,"/media/recitation/TVM.9.9.9.mp3"],[3770,3770,["mAlaiyum vandhadhu mAyan vArAn *","mA maNi pulamba vallERu aNaindha *","kOla nannAgugaL ugaLum AlO! *","koDiyana kuzhalgaLum kuzhaRum AlO! **","vAloLi vaLar mullai karumugaigaL *","malligai alambi vaNDu Alum AlO! *","vElaiyum visumbil viNDu alaRum AlO! *","en solli uyvan inggu avanai viTTE?"],["மாலையும் வந்தது மாயன் வாரான் *","மா மணி புலம்ப வல்லேறு அணைந்த *","கோல நன்னாகுகள் உகளும் ஆலோ! *","கொடியன குழல்களும் குழறும் ஆலோ! **","வாலொளி வளர் முல்லை கருமுகைகள் *","மல்லிகை அலம்பி வண்டு ஆலும் ஆலோ! *","வேலையும் விசும்பில் விண்டு அலறும் ஆலோ! *","என் சொல்லி உய்வன் இங்கு அவனை விட்டே?"],0,"/media/recitation/TVM.9.9.10.mp3"],[3771,3771,["** avanai viTTu aganRu uyir ARRa killA *","aNi izhai Aychchiyar mAlaip pUsal *","avanai viTTu agalvadhaRkE iranggi *","aNi kurugUrch saDakOpan mARan **","avani uNDu umizhndhavan mEl uraiththa *","AyiraththuL ivai paththum koNDu *","avaniyuL alaRRi ninRu uymmin thoNDIr! *","achchonna mAlai naNNith thozhudhE"],["** அவனை விட்டு அகன்று உயிர் ஆற்ற கில்லா *","அணி இழை ஆய்ச்சியர் மாலைப் பூசல் *","அவனை விட்டு அகல்வதற்கே இரங்கி *","அணி குருகூர்ச் சடகோபன் மாறன் **","அவனி உண்டு உமிழ்ந்தவன் மேல் உரைத்த *","ஆயிரத்துள் இவை பத்தும் கொண்டு *","அவனியுள் அலற்றி நின்று உய்ம்மின் தொண்டீர்! *","அச்சொன்ன மாலை நண்ணித் தொழுதே"],0,"/media/recitation/TVM.9.9.11.mp3"]],[[3772,3772,["** mAlai naNNith * thozhudhu ezhuminO vinai keDa *","kAlai mAlai * kamala malar iTTu nIr **","vElai mOdhum madhiL sUzh * thirukkaNNapuraththu *","Alin mEl Al amarndhAn * aDi iNaigaLE"],["** மாலை நண்ணித் * தொழுது எழுமினோ வினை கெட *","காலை மாலை * கமல மலர் இட்டு நீர் **","வேலை மோதும் மதிள் சூழ் * திருக்கண்ணபுரத்து *","ஆலின் மேல் ஆல் அமர்ந்தான் * அடி இணைகளே"],0,"/media/recitation/TVM.9.10.1.mp3"],[3773,3773,["kaL avizhum malar iTTu * nIr iRainjchumin *","naLLi sErum vayal sUzh * kiDanggin puDai **","veLLi Eyndha madhiL sUzh * thirukkaNNapuram","uLLi * nALum thozhudhu ezhuminO thoNDarE!"],["கள் அவிழும் மலர் இட்டு * நீர் இறைஞ்சுமின் *","நள்ளி சேரும் வயல் சூழ் * கிடங்கின் புடை **","வெள்ளி ஏய்ந்த மதிள் சூழ் * திருக்கண்ணபுரம்","உள்ளி * நாளும் தொழுது எழுமினோ தொண்டரே!"],0,"/media/recitation/TVM.9.10.2.mp3"],[3774,3774,["thoNDar! nuntham * thuyar pOga nIr EkamAy *","viNDu vADA malar iTTu * nIr iRainjchumin **","vaNDu pADum pozhil sUzh * thirukkaNNapuraththu","aNDa vANan * amarar perumAnaiyE"],["தொண்டர்! நுந்தம் * துயர் போக நீர் ஏகமாய் *","விண்டு வாடா மலர் இட்டு * நீர் இறைஞ்சுமின் **","வண்டு பாடும் பொழில் சூழ் * திருக்கண்ணபுரத்து","அண்ட வாணன் * அமரர் பெருமானையே"],0,"/media/recitation/TVM.9.10.3.mp3"],[3775,3775,["mAnai nOkki * maDap pinnai than kELvanai *","thEnai vADA malar iTTu * nIr iRainjchumin **","vAnai undhu madhiL sUzh * thirukkaNNapuram *","thAn nayandha perumAn * saraN AgumE"],["மானை நோக்கி * மடப் பின்னை தன் கேள்வனை *","தேனை வாடா மலர் இட்டு * நீர் இறைஞ்சுமின் **","வானை உந்து மதிள் சூழ் * திருக்கண்ணபுரம் *","தான் நயந்த பெருமான் * சரண் ஆகுமே"],0,"/media/recitation/TVM.9.10.4.mp3"],[3776,3776,["saraNam Agum * thana thAL aDaindhArkku ellAm *","maraNam AnAl * vaikuntham koDukkum pirAn **","araN amaindha madhiL sUzh * thirukkaNNapurath","tharaNi ALan * thanadhu anbarkku anbAgumE"],["சரணம் ஆகும் * தன தாள் அடைந்தார்க்கு எல்லாம் *","மரணம் ஆனால் * வைகுந்தம் கொடுக்கும் பிரான் **","அரண் அமைந்த மதிள் சூழ் * திருக்கண்ணபுரத்","தரணி ஆளன் * தனது அன்பர்க்கு அன்பாகுமே"],0,"/media/recitation/TVM.9.10.5.mp3"],[3777,3777,["anban Agum * thana thAL aDainthArkku ellAm *","sempon Agaththu * avuNan uDal kINDavan **","nanpon Eyndha madhiL sUzh * thirukkaNNapuraththu","anban * nALum thana meyyarkku meyyanE"],["அன்பன் ஆகும் * தன தாள் அடைந்தார்க்கு எல்லாம் *","செம்பொன் ஆகத்து * அவுணன் உடல் கீண்டவன் **","நன்பொன் ஏய்ந்த மதிள் சூழ் * திருக்கண்ணபுரத்து","அன்பன் * நாளும் தன மெய்யர்க்கு மெய்யனே"],0,"/media/recitation/TVM.9.10.6.mp3"],[3778,3778,["meyyan Agum * virumbith thozhuvArkku ellAm *","poyyan Agum * puRamE thozhuvArkku ellAm **","seyyil vALai ugaLum * thirukkaNNapuraththu","aiyan * Agaththu aNaippArgaTku aNiyanE"],["மெய்யன் ஆகும் * விரும்பித் தொழுவார்க்கு எல்லாம் *","பொய்யன் ஆகும் * புறமே தொழுவார்க்கு எல்லாம் **","செய்யில் வாளை உகளும் * திருக்கண்ணபுரத்து","ஐயன் * ஆகத்து அணைப்பார்கட்கு அணியனே"],0,"/media/recitation/TVM.9.10.7.mp3"],[3779,3779,["aNiyan Agum * thana thAL aDainthArkku ellAm *","piNiyum sArA * piRavi keDuththu ALum **","maNi pon Eyndha madhiL sUzh * thirukkaNNapuram","paNimin * nALum paramETTi than pAdhamE"],["அணியன் ஆகும் * தன தாள் அடைந்தார்க்கு எல்லாம் *","பிணியும் சாரா * பிறவி கெடுத்து ஆளும் **","மணி பொன் ஏய்ந்த மதிள் சூழ் * திருக்கண்ணபுரம்","பணிமின் * நாளும் பரமேட்டி தன் பாதமே"],0,"/media/recitation/TVM.9.10.8.mp3"],[3780,3780,["pAdha nALum * paNiyath thaNiyum piNi *","Edham sArA * enakkEl ini en kuRai? **","vEdha nAvar virumbum * thirukkaNNapuraththu","AdhiyAnai * aDaindhArkku allal illaiyE"],["பாத நாளும் * பணியத் தணியும் பிணி *","ஏதம் சாரா * எனக்கேல் இனி என் குறை? **","வேத நாவர் விரும்பும் * திருக்கண்ணபுரத்து","ஆதியானை * அடைந்தார்க்கு அல்லல் இல்லையே"],0,"/media/recitation/TVM.9.10.9.mp3"],[3781,3781,["illai allal * enakkEl ini en kuRai? *","alli mAdhar amarum * thiru mArbinan **","kallil Eyndha madhiL sUzh * thirukkaNNapuram","solla * nALum thuyar pADu sArAvE"],["இல்லை அல்லல் * எனக்கேல் இனி என் குறை? *","அல்லி மாதர் அமரும் * திரு மார்பினன் **","கல்லில் ஏய்ந்த மதிள் சூழ் * திருக்கண்ணபுரம்","சொல்ல * நாளும் துயர் பாடு சாராவே"],0,"/media/recitation/TVM.9.10.10.mp3"],[3782,3782,["** pADu sArA * vinai paRRaRa vENDuvIr *","mADa nIDu * kurugUrch saDakOpan ** sol","pADal Ana thamizh * AyiraththuL ippaththum *","pADi ADip * paNimin avan thALgaLE"],["** பாடு சாரா * வினை பற்றற வேண்டுவீர் *","மாட நீடு * குருகூர்ச் சடகோபன் ** சொல்","பாடல் ஆன தமிழ் * ஆயிரத்துள் இப்பத்தும் *","பாடி ஆடிப் * பணிமின் அவன் தாள்களே"],0,"/media/recitation/TVM.9.10.11.mp3"]]]