[[[1248,1248,["** pOdhalarndha pozhiR sOlaip * puRam enggum poru thiraigaL *","thAdhudhira vandhalaikkum * thaDamaNNith thenkarai mEl *","mAdhavan thAn uRaiyum iDam * vayal nAnggai * vari vaNDu","thEdhena enRu isai pADum * thiruththEvanAr thogaiyE"],["** போதலர்ந்த பொழிற் சோலைப் * புறம் எங்கும் பொரு திரைகள் *","தாதுதிர வந்தலைக்கும் * தடமண்ணித் தென்கரை மேல் *","மாதவன் தான் உறையும் இடம் * வயல் நாங்கை * வரி வண்டு","தேதென என்று இசை பாடும் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.1.mp3"],[1249,1249,["yAvarumAy yAvaiyumAy * ezhil vEdhap poruLgaLumAy *","mUvarumAy mudhalAya * mUrththi amarndhu uRaiyum iDam **","mA varum thiNpaDai mannai * venRi koLvAr mannu nAnggai *","dhEvarum senRu iRainjchu pozhil * thiruththEvanAr thogaiyE"],["யாவருமாய் யாவையுமாய் * எழில் வேதப் பொருள்களுமாய் *","மூவருமாய் முதலாய * மூர்த்தி அமர்ந்து உறையும் இடம் **","மா வரும் திண்படை மன்னை * வென்றி கொள்வார் மன்னு நாங்கை *","தேவரும் சென்று இறைஞ்சு பொழில் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.2.mp3"],[1250,1250,["vAnADum maNNADum * maRRuLLa palluyirum *","thAnAya emperumAn * thalaivan amarndhu uRaiyum iDam **","AnAdha perunjchelvaththu * arumaRaiyOr nAnggai thannuL *","thEnArum malarp pozhil sUzh * thiruththEvanAr thogaiyE"],["வானாடும் மண்ணாடும் * மற்றுள்ள பல்லுயிரும் *","தானாய எம்பெருமான் * தலைவன் அமர்ந்து உறையும் இடம் **","ஆனாத பெருஞ்செல்வத்து * அருமறையோர் நாங்கை தன்னுள் *","தேனாரும் மலர்ப் பொழில் சூழ் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.3.mp3"],[1251,1251,["indhiranum imaiyavarum * munivargaLum ezhil amaindha *","sandha malarch chadhumuganum * kadhiravanum chandhiranum **","endhai emakku aruL ena ninRu * aruLum iDam ezhil nAnggai *","sundhara naRpozhil puDai sUzh * thiruththEvanAr thogaiyE"],["இந்திரனும் இமையவரும் * முனிவர்களும் எழில் அமைந்த *","சந்த மலர்ச் சதுமுகனும் * கதிரவனும் சந்திரனும் **","எந்தை எமக்கு அருள் என நின்று * அருளும் இடம் எழில் நாங்கை *","சுந்தர நற்பொழில் புடை சூழ் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.4.mp3"],[1252,1252,["aṇṭamum iv alai kaṭalum * avaṉikal̤um kula varaiyum *","uṇṭa pirāṉ uṟaiyum iṭam * ŏl̤i maṇi cantu akil kaṉakam **","tĕṇ tiraikal̤ varat tiraṭṭum * tikazh maṇṇit tĕṉ karaimel *","tiṇ tiṟalār payil-nāṅkait * tiruttevaṉārtŏkaiye-"],["அண்டமும் இவ் அலை கடலும் * அவனிகளும் குல வரையும் *","உண்ட பிரான் உறையும் இடம் * ஒளி மணி சந்து அகில் கனகம் **","தெண் திரைகள் வரத் திரட்டும் * திகழ் மண்ணித் தென் கரைமேல் *","திண் திறலார் பயில் நாங்கைத் * திருத்தேவனார்தொகையே"],1,"/media/recitation/PT.4.1.5.mp3"],[1253,1253,["njAlam ellAm amudhu seydhu * nAnmaRaiyum thoDarAdha *","pAlaganAy Alilaiyil * paLLi koLLum paraman iDam **","sAli vaLam perugi varum * thaDamaNNith thenkarai mEl *","sEl ugaLum vayal nAnggaith * thiruththEvanAr thogaiyE"],["ஞாலம் எல்லாம் அமுது செய்து * நான்மறையும் தொடராத *","பாலகனாய் ஆலிலையில் * பள்ளி கொள்ளும் பரமன் இடம் **","சாலி வளம் பெருகி வரும் * தடமண்ணித் தென்கரை மேல் *","சேல் உகளும் வயல் நாங்கைத் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.6.mp3"],[1254,1254,["ODAdha ALariyin * uruvAgi iraNiyanai *","vADAdha vaLLugirAl * piLandhu aLaindha mAladhiDam **","EDERu perunjchelvaththu * ezhil maRaiyOr nAnggai thannuL *","sEDERu pozhil thazhuvu * thiruththEvanAr thogaiyE"],["ஓடாத ஆளரியின் * உருவாகி இரணியனை *","வாடாத வள்ளுகிரால் * பிளந்து அளைந்த மாலதிடம் **","ஏடேறு பெருஞ்செல்வத்து * எழில் மறையோர் நாங்கை தன்னுள் *","சேடேறு பொழில் தழுவு * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.7.mp3"],[1255,1255,["vArArum iLangkonggai * maithiliyai maNam puNarvAn *","kArAr thiNsilai iRuththa * thanik kALai karudhum iDam **","ErArum perunjchelvaththu * ezhil maRaiyOr nAnggai thannuL *","sIrArum malarp pozhil sUzh * thiruththEvanAr thogaiyE"],["வாராரும் இளங்கொங்கை * மைதிலியை மணம் புணர்வான் *","காரார் திண்சிலை இறுத்த * தனிக் காளை கருதும் இடம் **","ஏராரும் பெருஞ்செல்வத்து * எழில் மறையோர் நாங்கை தன்னுள் *","சீராரும் மலர்ப் பொழில் சூழ் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.8.mp3"],[1256,1256,["kumba migu madha yAnai * pAganoDum kulaindhu vIzha *","kombadhanaip paRiththu eRindha * kUththan amarndhu uRaiyum iDam **","vambavizhum seNbagaththin * maNam kamazhum nAnggai thannuL *","sempon madhiL pozhil puDai sUzh * thiruththEvanAr thogaiyE"],["கும்ப மிகு மத யானை * பாகனொடும் குலைந்து வீழ *","கொம்பதனைப் பறித்து எறிந்த * கூத்தன் அமர்ந்து உறையும் இடம் **","வம்பவிழும் செண்பகத்தின் * மணம் கமழும் நாங்கை தன்னுள் *","செம்பொன் மதிள் பொழில் புடை சூழ் * திருத்தேவனார் தொகையே"],0,"/media/recitation/PT.4.1.9.mp3"],[1257,1257,["** kArArndha thirumEnik * kaNNan amarndhu uRaiyum iDam *","sIrArndha pozhil nAnggaith * thiruththEvanAr thogai mEl **","kUrArndha vERkaliyan * kURu thamizh paththum vallAr *","ErArndha vaikundhaththu * imaiyavarODu iruppArE"],["** காரார்ந்த திருமேனிக் * கண்ணன் அமர்ந்து உறையும் இடம் *","சீரார்ந்த பொழில் நாங்கைத் * திருத்தேவனார் தொகை மேல் **","கூரார்ந்த வேற்கலியன் * கூறு தமிழ் பத்தும் வல்லார் *","ஏரார்ந்த வைகுந்தத்து * இமையவரோடு இருப்பாரே"],0,"/media/recitation/PT.4.1.10.mp3"]],[[1258,1258,["** kamba mAkaDal aDaiththu ilanggaikku man * kathir muDi avai paththum","ambinAl aRuththu * arasu avan thambikku * aLiththavan uRai kOyil **","sempalA nirai seNbagam mAdhavi * sUthagam vAzhaigaL sUzh *","vambulAm kamugu Onggiya nAnggUr * vaNpuruDOththamamE"],["** கம்ப மாகடல் அடைத்து இலங்கைக்கு மன் * கதிர் முடி அவை பத்தும்","அம்பினால் அறுத்து * அரசு அவன் தம்பிக்கு * அளித்தவன் உறை கோயில் **","செம்பலா நிரை செண்பகம் மாதவி * சூதகம் வாழைகள் சூழ் *","வம்புலாம் கமுகு ஓங்கிய நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.1.mp3"],[1259,1259,["pallavam thigazh pUngkaDambu ERi * akkALiyan paNavaranggil *","ollai vandhuRap pAyndhu arunaDam seydha * umbar kOn uRai kOyil **","nalla venthazhal mUnRu nAlvEdham * aivELviyODu ARanggam *","valla andhaNar malgiya nAnggUr * vaNpuruDOththamamE"],["பல்லவம் திகழ் பூங்கடம்பு ஏறி * அக்காளியன் பணவரங்கில் *","ஒல்லை வந்துறப் பாய்ந்து அருநடம் செய்த * உம்பர் கோன் உறை கோயில் **","நல்ல வெந்தழல் மூன்று நால்வேதம் * ஐவேள்வியோடு ஆறங்கம் *","வல்ல அந்தணர் மல்கிய நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.2.mp3"],[1260,1260,["aNDar Anavar vAnavar kOnukku enRu * amaiththa sORadhu ellAm","uNDu * kOnirai mEyththu avai kAththavan * ugandhu inidhuRai kOyil **","koNDalAr muzhavil kuLir vAr pozhil * kula mayil naDam ADa *","vaNDu thAn isai pADiDu nAnggUr * vaNpuruDOththamamE"],["அண்டர் ஆனவர் வானவர் கோனுக்கு என்று * அமைத்த சோறது எல்லாம்","உண்டு * கோநிரை மேய்த்து அவை காத்தவன் * உகந்து இனிதுறை கோயில் **","கொண்டலார் முழவில் குளிர் வார் பொழில் * குல மயில் நடம் ஆட *","வண்டு தான் இசை பாடிடு நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.3.mp3"],[1261,1261,["paruṅkai yāṉaiyiṉ kŏmpiṉaip paṟittu * ataṉ pākaṉaic cāṭip pukku *","ŏruṅka mallaraik kŏṉṟu * piṉ kañcaṉai utaittavaṉ uṟai koyil **","karumpiṉūṭu uyar cālikal̤ vil̤aitaru * kazhaṉiyil mali vāvi *","maruṅku ĕlām pŏzhil oṅkiya nāṅkūr * vaṇpuruṭottamame-"],["பருங்கை யானையின் கொம்பினைப் பறித்து * அதன் பாகனைச் சாடிப் புக்கு *","ஒருங்க மல்லரைக் கொன்று * பின் கஞ்சனை உதைத்தவன் உறை கோயில் **","கரும்பினூடு உயர் சாலிகள் விளைதரு * கழனியில் மலி வாவி *","மருங்கு எலாம் பொழில் ஓங்கிய நாங்கூர் * வண்புருடோத்தமமே"],1,"/media/recitation/PT.4.2.4.mp3"],[1262,1262,["sADu pOy vizhath thAL nimirththu * Isan than paDaiyoDum kiLaiyODum","ODa * vANanai Ayiram thOLgaLum * thuNiththavan uRai kOyil **","ADu vAn koDi agal visumbu aNavip pOyp * pagalavan oLi maRaikkum *","mADa mALigai sUzh tharu nAnggUr * vaNpuruDOththamamE"],["சாடு போய் விழத் தாள் நிமிர்த்து * ஈசன் தன் படையொடும் கிளையோடும்","ஓட * வாணனை ஆயிரம் தோள்களும் * துணித்தவன் உறை கோயில் **","ஆடு வான் கொடி அகல் விசும்பு அணவிப் போய்ப் * பகலவன் ஒளி மறைக்கும் *","மாட மாளிகை சூழ் தரு நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.5.mp3"],[1263,1263,["angkaiyAl aDi mUnRu nIr ERRu * ayan alar koDu thozhudhu Eththa *","ganggai pOdharak kAl nimirththu aruLiya * kaNNan vandhuRai kOyil **","konggai kOnggu avai kATTa vAy kumudhanggaL kATTa * mA padhumanggaL *","manggaimAr mugam kATTiDu nAnggUr * vaNpuruDOththamamE"],["அங்கையால் அடி மூன்று நீர் ஏற்று * அயன் அலர் கொடு தொழுது ஏத்த *","கங்கை போதரக் கால் நிமிர்த்து அருளிய * கண்ணன் வந்துறை கோயில் **","கொங்கை கோங்கு அவை காட்ட வாய் குமுதங்கள் காட்ட * மா பதுமங்கள் *","மங்கைமார் முகம் காட்டிடு நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.6.mp3"],[1264,1264,["uLaiya oNthiRal ponpeyarOn thanadhu * uram piLandhu udhiraththai","aLaiyum * venjchinaththu ari pari kIRiya * appan vandhuRai kOyil **","iLaiya manggaiyar iNaiyaDich silambinODu * ezhil koL pandhu aDippOr * kai","vaLaiyil ninRu oli malgiya nAnggUr * vaNpuruDOththamamE"],["உளைய ஒண்திறல் பொன்பெயரோன் தனது * உரம் பிளந்து உதிரத்தை","அளையும் * வெஞ்சினத்து அரி பரி கீறிய * அப்பன் வந்துறை கோயில் **","இளைய மங்கையர் இணையடிச் சிலம்பினோடு * எழில் கொள் பந்து அடிப்போர் * கை","வளையில் நின்று ஒலி மல்கிய நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.7.mp3"],[1265,1265,["vALaiyAr thaDangkaN umai panggan * van sAbam maRRadhu nIngga *","mULaiyAr siraththu aiyam munnaLiththa * em mugil vaNNan uRai kOyil **","pALai vAnkamugUDu uyar thenggin * vanpazham vizha veruvip pOy *","vALai pAy thaDam sUzh tharu nAnggUr * vaNpuruDOththamamE"],["வாளையார் தடங்கண் உமை பங்கன் * வன் சாபம் மற்றது நீங்க *","மூளையார் சிரத்து ஐயம் முன்னளித்த * எம் முகில் வண்ணன் உறை கோயில் **","பாளை வான்கமுகூடு உயர் தெங்கின் * வன்பழம் விழ வெருவிப் போய் *","வாளை பாய் தடம் சூழ் தரு நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.8.mp3"],[1266,1266,["indhu vAr saDai Isanaip payandha * nAnmuganai than ezhilArum *","undhi mAmalar mImisaip paDaiththavan * ugandhu inidhuRai kOyil **","kundhi vAzhaiyin kozhungkani nugarndhu * than kuruLaiyaith thazhuvip pOy *","mandhi mAmpaNai mEl vaigu nAnggUr * vaNpuruDOththamamE"],["இந்து வார் சடை ஈசனைப் பயந்த * நான்முகனை தன் எழிலாரும் *","உந்தி மாமலர் மீமிசைப் படைத்தவன் * உகந்து இனிதுறை கோயில் **","குந்தி வாழையின் கொழுங்கனி நுகர்ந்து * தன் குருளையைத் தழுவிப் போய் *","மந்தி மாம்பணை மேல் வைகு நாங்கூர் * வண்புருடோத்தமமே"],0,"/media/recitation/PT.4.2.9.mp3"],[1267,1267,["** maNNuL Ar pugazh vEdhiyar nAnggUr * vaNpuruDOththamaththuL *","aNNal sEvaDik kIzh aDaindhu uyndhavan * Aliman aruLmAri **","paNNuL Ar tharap pADiya pADal * ippaththum vallAr * ulagil","eNNilAdha pErinbam uRRu * imaiyavarODum kUDuvarE"],["** மண்ணுள் ஆர் புகழ் வேதியர் நாங்கூர் * வண்புருடோத்தமத்துள் *","அண்ணல் சேவடிக் கீழ் அடைந்து உய்ந்தவன் * ஆலிமன் அருள்மாரி **","பண்ணுள் ஆர் தரப் பாடிய பாடல் * இப்பத்தும் வல்லார் * உலகில்","எண்ணிலாத பேரின்பம் உற்று * இமையவரோடும் கூடுவரே"],0,"/media/recitation/PT.4.2.10.mp3"]],[[1268,1268,["** pEr aNindhu ulagaththavar thozhudhu Eththum * pEraruLALan empirAnai *","vAraNi mulaiyAL malarmagaLODu * maNmagaLum uDan niRpa **","sIraNi mADa nAnggai nannaDuvuL * semponsey kOyilin uLLE *","kAraNi mEgam ninRadhu oppAnaik * kaNDu koNDu uyndhu ozhindhEnE"],["** பேர் அணிந்து உலகத்தவர் தொழுது ஏத்தும் *","பேரருளாளன் எம்பிரானை *","வாரணி முலையாள் மலர்மகளோடு *","மண்மகளும் உடன் நிற்ப **","சீரணி மாட நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","காரணி மேகம் நின்றது ஒப்பானைக் *","கண்டு கொண்டு உய்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.1.mp3"],[1269,1269,["piRappoDu mUppu onRu illavan thannaip * pEdhiyA inba veLLaththai *","iRappu edhirkAlak kazhivum AnAnai * Ezh isaiyin suvai thannai **","siRappuDai maRaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","maRaip perum poruLai vAnavar kOnaik * kaNDu nAn vAzhndhu ozhindhEnE"],["பிறப்பொடு மூப்பு ஒன்று இல்லவன் தன்னைப் *","பேதியா இன்ப வெள்ளத்தை *","இறப்பு எதிர்காலக் கழிவும் ஆனானை *","ஏழ் இசையின் சுவை தன்னை **","சிறப்புடை மறையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","மறைப் பெரும் பொருளை வானவர் கோனைக் *","கண்டு நான் வாழ்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.2.mp3"],[1270,1270,["thiDavisumbu eri nIr thinggaLum suDarum * sezhunilaththu uyirgaLum maRRum *","paDarporuLgaLumAy ninRavan thannai * panggayaththu ayanavan anaiya **","thiDamozhi maRaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","kaDal niRa vaNNan thannai nAn aDiyEn * kaNDu koNDu uyndhu ozhindhEnE"],["திடவிசும்பு எரி நீர் திங்களும் சுடரும் *","செழுநிலத்து உயிர்களும் மற்றும் *","படர்பொருள்களுமாய் நின்றவன் தன்னை *","பங்கயத்து அயனவன் அனைய **","திடமொழி மறையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","கடல் நிற வண்ணன் தன்னை நான் அடியேன் *","கண்டு கொண்டு உய்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.3.mp3"],[1271,1271,["vasai aRu kuRaLAy mAvali vELvi * maN aLaviTTavan thannai *","asaivaRum amarar aDiyiNai vaNangga * alaikaDal thuyinRa ammAnai **","thisaimugan anaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","uyarmaNi maguDam sUDi ninRAnaik * kaNDu koNDu uyndhu ozhindhEnE"],["வசை அறு குறளாய் மாவலி வேள்வி *","மண் அளவிட்டவன் தன்னை *","அசைவறும் அமரர் அடியிணை வணங்க *","அலைகடல் துயின்ற அம்மானை **","திசைமுகன் அனையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","உயர்மணி மகுடம் சூடி நின்றானைக் *","கண்டு கொண்டு உய்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.4.mp3"],[1272,1272,["thI manaththu arakkar thiRal azhiththavanE! enRu * senRu aDaindhavar thamakku *","thAy manaththu iranggi aruLinaik koDukkum * thayaradhan madhalaiyaich sayamE **","thEmalarp pozhil sUzh nAnggai nannaDuvuL * semponsey kOyilin uLLE *","kAmanaip payandhAn thannai nAn aDiyEn * kaNDu koNDu uyndhu ozhindhEnE"],["தீ மனத்து அரக்கர் திறல் அழித்தவனே! என்று *","சென்று அடைந்தவர் தமக்கு *","தாய் மனத்து இரங்கி அருளினைக் கொடுக்கும் *","தயரதன் மதலையைச் சயமே **","தேமலர்ப் பொழில் சூழ் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","காமனைப் பயந்தான் தன்னை நான் அடியேன் *","கண்டு கொண்டு உய்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.5.mp3"],[1273,1273,["mallai mA munnIr adharpaDa * malaiyAl aNai seydhu magizhndhavan thannai *","kallin mIdhu iyanRa kaDimadhiL ilanggai kalangga * Or vALi thoTTAnai **","selva nAnmaRaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","alli mAmalarAL thannoDum aDiyEn * kaNDu koNDu allal thIrndhEnE"],["மல்லை மா முந்நீர் அதர்பட * மலையால்","அணை செய்து மகிழ்ந்தவன் தன்னை *","கல்லின் மீது இயன்ற கடிமதிள் இலங்கை","கலங்க * ஓர் வாளி தொட்டானை **","செல்வ நான்மறையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","அல்லி மாமலராள் தன்னொடும் அடியேன் *","கண்டு கொண்டு அல்லல் தீர்ந்தேனே"],0,"/media/recitation/PT.4.3.6.mp3"],[1274,1274,["venjchinak kaLiRum villoDu mallum * veguNDu iRuththu aDarththavan thannai *","kanjchanaik kAyndha kALai ammAnaik * karumugil thiruniRaththavanai **","senjchol nAnmaRaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","anjchanak kunRam ninRadhu oppAnaik * kaNDu koNDu allal thIrndhEnE"],["வெஞ்சினக் களிறும் வில்லொடு மல்லும் *","வெகுண்டு இறுத்து அடர்த்தவன் தன்னை *","கஞ்சனைக் காய்ந்த காளை அம்மானைக் *","கருமுகில் திருநிறத்தவனை **","செஞ்சொல் நான்மறையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","அஞ்சனக் குன்றம் நின்றது ஒப்பானைக் *","கண்டு கொண்டு அல்லல் தீர்ந்தேனே"],0,"/media/recitation/PT.4.3.7.mp3"],[1275,1275,["** anRiya vANan Ayiram thOLum thuNiya * anRu Azhi thoTTAnai *","min thigazh kuDumi vEngkaDa malai mEl * mEviya vEdha nalviLakkai **","thenthisaith thiladham anaiyavar nAnggaich * semponsey kOyilin uLLE *","manRadhu poliya magizhndhu ninRAnai * vaNanggi nAn vAzhndhu ozhindhEnE"],["** அன்றிய வாணன் ஆயிரம் தோளும் துணிய *","அன்று ஆழி தொட்டானை *","மின் திகழ் குடுமி வேங்கட மலை மேல் *","மேவிய வேத நல்விளக்கை **","தென்திசைத் திலதம் அனையவர் நாங்கைச் *","செம்பொன்செய் கோயிலின் உள்ளே *","மன்றது பொலிய மகிழ்ந்து நின்றானை *","வணங்கி நான் வாழ்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.8.mp3"],[1276,1276,["kaLangkani vaNNA! kaNNaNE! * endhan kArmugilE! ena ninaindhiTTu *","uLam kanindhirukkum aDiyavar thanggaL * uLLaththuL URiya thEnai **","theLindha nAnmaRaiyOr nAnggai nannaDuvuL * semponsey kOyilin uLLE *","vaLangkoL pErinbam manni ninRAnai * vaNanggi nAn vAzhndhu ozhindhEnE"],["களங்கனி வண்ணா! கண்ணணே! *","என்தன் கார்முகிலே! என நினைந்திட்டு *","உளம் கனிந்திருக்கும் அடியவர் தங்கள் *","உள்ளத்துள் ஊறிய தேனை **","தெளிந்த நான்மறையோர் நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","வளங்கொள் பேரின்பம் மன்னி நின்றானை *","வணங்கி நான் வாழ்ந்து ஒழிந்தேனே"],0,"/media/recitation/PT.4.3.9.mp3"],[1277,1277,["** thEn amar sOlai nAnggai nannaDuvuL * semponsey kOyilin uLLE *","vAnavar kOnaik kaNDamai sollum * manggaiyAr vATkalikanRi **","Unamil pADal onbadhODu onRum * ozhivinRik kaRRu vallArgaL *","mAna veNkuDaik kIzh vaiyagam ANDu * vAnavar Aguvar magizhndhE"],["** தேன் அமர் சோலை நாங்கை நன்னடுவுள் *","செம்பொன்செய் கோயிலின் உள்ளே *","வானவர் கோனைக் கண்டமை சொல்லும் *","மங்கையார் வாட்கலிகன்றி **","ஊனமில் பாடல் ஒன்பதோடு ஒன்றும் *","ஒழிவின்றிக் கற்று வல்லார்கள் *","மான வெண்குடைக் கீழ் வையகம் ஆண்டு *","வானவர் ஆகுவர் மகிழ்ந்தே"],0,"/media/recitation/PT.4.3.10.mp3"]],[[1278,1278,["** mARRarasar maNimuDiyum thiRalum thEsum *","maRRavar tham kAdhalimAr kuzhaiyum * thandhai","kAl thaLaiyum uDan kazhala vandhu thOnRik *","kathanAgam kAththaLiththa kaNNar kaNDIr **","nURRidhazh koL aravindham nuzhaindha paLLaththu *","iLangkamugin mudhupALai paguvAy naNDin *","sERRaLaiyil veNmuththam sindhum nAnggUrth *","thiruththeRRiyambalaththu en sengkaNmAlE"],["** மாற்றரசர் மணிமுடியும் திறலும் தேசும் *","மற்றவர் தம் காதலிமார் குழையும் * தந்தை","கால் தளையும் உடன் கழல வந்து தோன்றிக் *","கதநாகம் காத்தளித்த கண்ணர் கண்டீர் **","நூற்றிதழ் கொள் அரவிந்தம் நுழைந்த பள்ளத்து *","இளங்கமுகின் முதுபாளை பகுவாய் நண்டின் *","சேற்றளையில் வெண்முத்தம் சிந்தும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங்கண்மாலே"],0,"/media/recitation/PT.4.4.1.mp3"],[1279,1279,["poRRoDith thOL maDamagaL than vaDivu koNDa *","pollAdha vanpEychchi konggai vAnggi *","peRReDuththa thAy pOla maDuppa * Arum","pENA nanjchuNDu ugandha piLLai kaNDIr **","nel thoDuththa malar nIlam niRaindha sUzhal *","irunjchiRaiya vaNDoliyum neDungkaNAr tham *","siRRaDi mEl silamboliyum mizhaRRum nAnggUrth *","thiruththeRRiyambalaththu en sengkaNmAlE"],["பொற்றொடித் தோள் மடமகள் தன் வடிவு கொண்ட *","பொல்லாத வன்பேய்ச்சி கொங்கை வாங்கி *","பெற்றெடுத்த தாய் போல மடுப்ப * ஆரும்","பேணா நஞ்சுண்டு உகந்த பிள்ளை கண்டீர் **","நெல் தொடுத்த மலர் நீலம் நிறைந்த சூழல் *","இருஞ்சிறைய வண்டொலியும் நெடுங்கணார் தம் *","சிற்றடி மேல் சிலம்பொலியும் மிழற்றும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங்கண்மாலே"],0,"/media/recitation/PT.4.4.2.mp3"],[1280,1280,["paṭal aṭaitta ciṟu kurampai nuzhaintu pukkup *","pacu vĕṇṇĕy patam ārap paṇṇai muṟṟum *","aṭal aṭartta vel kaṇār tokkai paṟṟi *","alantalaimai cĕytu uzhalum aiyaṉ kaṇṭīr **","maṭal ĕṭutta nĕṭun tĕṅkiṉ pazhaṅkal̤ vīzha *","māṅkaṉikal̤ tiraṭṭu uruṭṭā varu nīrp pŏṉṉi *","tiṭal ĕṭuttu malar cumantu aṅku izhiyum nāṅkūrt *","tiruttĕṟṟiyampalattu ĕṉ cĕṅ kaṇ māle-"],["படல் அடைத்த சிறு குரம்பை நுழைந்து புக்குப் *","பசு வெண்ணெய் பதம் ஆரப் பண்ணை முற்றும் *","அடல் அடர்த்த வேல் கணார் தோக்கை பற்றி *","அலந்தலைமை செய்து உழலும் ஐயன் கண்டீர் **","மடல் எடுத்த நெடுந் தெங்கின் பழங்கள் வீழ *","மாங்கனிகள் திரட்டு உருட்டா வரு நீர்ப் பொன்னி *","திடல் எடுத்து மலர் சுமந்து அங்கு இழியும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங் கண் மாலே"],1,"/media/recitation/PT.4.4.3.mp3"],[1281,1281,["vār ārum mulai maṭavāl̤ piṉṉaikku āki *","val̤ai maruppiṉ kaṭuñ ciṉattu vaṉ tāl̤ ārnta *","kār ār tiṇ viṭai aṭarttu vatuvai āṇṭa *","karu mukilpol tiru niṟattu ĕṉ kaṇṇar kaṇṭīr **","er ārum malarp pŏzhilkal̤ tazhuvi ĕṅkum *","ĕzhil matiyaik kāl tŏṭara vil̤aṅku coti *","cīr ārum maṇi māṭam tikazhum nāṅkūrt *","tiruttĕṟṟiyampalattu ĕṉ cĕṅ kaṇ māle-"],["வார் ஆரும் முலை மடவாள் பின்னைக்கு ஆகி *","வளை மருப்பின் கடுஞ் சினத்து வன் தாள் ஆர்ந்த *","கார் ஆர் திண் விடை அடர்த்து வதுவை ஆண்ட *","கரு முகில்போல் திரு நிறத்து என் கண்ணர் கண்டீர் **","ஏர் ஆரும் மலர்ப் பொழில்கள் தழுவி எங்கும் *","எழில் மதியைக் கால் தொடர விளங்கு சோதி *","சீர் ஆரும் மணி மாடம் திகழும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங் கண் மாலே"],1,"/media/recitation/PT.4.4.4.mp3"],[1282,1282,["kalai ilanggum agal algul kamalap pAvai *","kadhir muththa veNNagaiyAL karungkaN Aychchi *","mulai ilanggum oLi maNippUN vaDamum thEyppa *","mUvAdha varai neDunthOL mUrththi kaNDIr **","malai ilanggu niraich sandhi mADa vIdhi *","ADavarai maDamozhiyAr mugaththu * iraNDu","silai vilanggi manam siRai koNDirukkum nAnggUrth *","thiruththeRRiyambalaththu en sengkaNmAlE"],["கலை இலங்கும் அகல் அல்குல் கமலப் பாவை *","கதிர் முத்த வெண்ணகையாள் கருங்கண் ஆய்ச்சி *","முலை இலங்கும் ஒளி மணிப்பூண் வடமும் தேய்ப்ப *","மூவாத வரை நெடுந்தோள் மூர்த்தி கண்டீர் **","மலை இலங்கு நிரைச் சந்தி மாட வீதி *","ஆடவரை மடமொழியார் முகத்து * இரண்டு","சிலை விலங்கி மனம் சிறை கொண்டிருக்கும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங்கண்மாலே"],0,"/media/recitation/PT.4.4.5.mp3"],[1283,1283,["tāṉpolum eṉṟu ĕzhuntāṉ taraṇiyāl̤aṉ *","atu kaṇṭu tarittiruppāṉ arakkar-taṅkal̤ *","koṉpolum eṉṟu ĕzhuntāṉ kuṉṟam aṉṉa *","irupatu tol̤ uṭaṉ tuṇitta ŏruvaṉ kaṇṭīr **","māṉpolum mĕṉ nokkiṉ cĕyya vāyār *","marakatampol maṭak kil̤iyaik kaimel kŏṇṭu *","teṉpolum mĕṉ mazhalai payiṟṟum nāṅkūrt *","tiruttĕṟṟiyampalattu ĕṉ cĕṅ kaṇ māle-"],["தான்போலும் ஏன்று எழுந்தான் தரணியாளன் *","அது கண்டு தரித்திருப்பான் அரக்கர் தங்கள் *","கோன்போலும் ஏன்று எழுந்தான் குன்றம் அன்ன *","இருபது தோள் உடன் துணித்த ஒருவன் கண்டீர் **","மான்போலும் மென் நோக்கின் செய்ய வாயார் *","மரகதம்போல் மடக் கிளியைக் கைமேல் கொண்டு *","தேன்போலும் மென் மழலை பயிற்றும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங் கண் மாலே"],1,"/media/recitation/PT.4.4.6.mp3"],[1284,1284,["pŏṅku ilaṅku puri nūlum tolum tāzhap *","pŏllāta kuṟal̤ uru āyp pŏruntā vāṇaṉ *","maṅkalam cer maṟai vel̤vi-ataṉul̤ pukku *","maṇ akalam kuṟai iranta maintaṉ kaṇṭīr **","kŏṅku alarnta malark kuzhalār kŏṅkai toynta *","kuṅkumattiṉ kuzhampu al̤ainta kolam-taṉṉāl *","cĕṅ kalaṅkal vĕṇ maṇalmel tavazhum nāṅkūrt *","tiruttĕṟṟiyampalattu ĕṉ cĕṅ kaṇ māle-"],["பொங்கு இலங்கு புரி நூலும் தோலும் தாழப் *","பொல்லாத குறள் உரு ஆய்ப் பொருந்தா வாணன் *","மங்கலம் சேர் மறை வேள்வி அதனுள் புக்கு *","மண் அகலம் குறை இரந்த மைந்தன் கண்டீர் **","கொங்கு அலர்ந்த மலர்க் குழலார் கொங்கை தோய்ந்த *","குங்குமத்தின் குழம்பு அளைந்த கோலம் தன்னால் *","செங் கலங்கல் வெண் மணல்மேல் தவழும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங் கண் மாலே"],1,"/media/recitation/PT.4.4.7.mp3"],[1285,1285,["silambin iDai siRu paral pOl periya mEru *","thirukkuLambil kaNakaNappath thiruvAkAram","kulungga * nila maDandhai thanai iDandhu pulgik *","kOTTiDai vaiththu aruLiya engkOmAn kaNDIr **","ilanggiya nAnmaRai anaiththum anggam ARum *","Ezhisaiyum kELvigaLum eNthikku enggum *","silambiya naRperum selvam thigazhum nAnggUrth *","thiruththeRRiyambalaththu en sengkaNmAlE"],["சிலம்பின் இடை சிறு பரல் போல் பெரிய மேரு *","திருக்குளம்பில் கணகணப்பத் திருவாகாரம்","குலுங்க * நில மடந்தை தனை இடந்து புல்கிக் *","கோட்டிடை வைத்து அருளிய எங்கோமான் கண்டீர் **","இலங்கிய நான்மறை அனைத்தும் அங்கம் ஆறும் *","ஏழிசையும் கேள்விகளும் எண்திக்கு எங்கும் *","சிலம்பிய நற்பெரும் செல்வம் திகழும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங்கண்மாலே"],0,"/media/recitation/PT.4.4.8.mp3"],[1286,1286,["Ezhulagum thAzh varaiyum enggum mUDi *","eNthisaiyum maNDalamum maNDi * aNDam","mOzhai ezhundhu Azhi migum Uzhi veLLam *","mun agaTTil oDukkiya em mUrththi kaNDIr **","Uzhi thoRum Uzhi thoRum uyarndha selvaththu *","Onggiya nAnmaRai anaiththum thAnggu nAvar *","sEzh uyarndha maNimADam thigazhum nAnggUrth *","thiruththeRRiyambalaththu en sengkaNmAlE"],["ஏழுலகும் தாழ் வரையும் எங்கும் மூடி *","எண்திசையும் மண்டலமும் மண்டி * அண்டம்","மோழை எழுந்து ஆழி மிகும் ஊழி வெள்ளம் *","முன் அகட்டில் ஒடுக்கிய எம் மூர்த்தி கண்டீர் **","ஊழி தொறும் ஊழி தொறும் உயர்ந்த செல்வத்து *","ஓங்கிய நான்மறை அனைத்தும் தாங்கு நாவர் *","சேழுயர்ந்த மணிமாடம் திகழும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங்கண்மாலே"],0,"/media/recitation/PT.4.4.9.mp3"],[1287,1287,["cīr aṇinta maṇi māṭam tikazhum nāṅkūrt *","tiruttĕṟṟiyampalattu ĕṉ cĕṅ kaṇ mālai *","kūr aṇinta vel valavaṉ āli nāṭaṉ *","kŏṭi māṭa maṅkaiyar-koṉ kuṟaiyal āl̤i **","pār aṇinta tŏl pukazhāṉ kaliyaṉ cŏṉṉa *","pāmālai ivai aintum aintum vallār *","cīr aṇinta ulakattu maṉṉar āki *","ceṇ vicumpil vāṉavar āyt tikazhvar-tāme-"],["சீர் அணிந்த மணி மாடம் திகழும் நாங்கூர்த் *","திருத்தெற்றியம்பலத்து என் செங் கண் மாலை *","கூர் அணிந்த வேல் வலவன் ஆலி நாடன் *","கொடி மாட மங்கையர் கோன் குறையல் ஆளி **","பார் அணிந்த தொல் புகழான் கலியன் சொன்ன *","பாமாலை இவை ஐந்தும் ஐந்தும் வல்லார் *","சீர் அணிந்த உலகத்து மன்னர் ஆகி *","சேண் விசும்பில் வானவர் ஆய்த் திகழ்வர் தாமே"],1,"/media/recitation/PT.4.4.10.mp3"]],[[1288,1288,["** thUmbuDaip panaik kai vEzham * thuyar keDuththu aruLi * mannu","kAmbuDaik kunRam Endhik * kaDumazhai kAththa endhai **","pUmpunal ponni muRRum * pugundhu pon varaNDa * enggum","thEmpozhil kamazhum nAnggUrth * thirumaNikkUDaththAnE"],["** தூம்புடைப் பனைக் கை வேழம் * துயர் கெடுத்து அருளி * மன்னு","காம்புடைக் குன்றம் ஏந்திக் * கடுமழை காத்த எந்தை **","பூம்புனல் பொன்னி முற்றும் * புகுந்து பொன் வரண்ட * எங்கும்","தேம்பொழில் கமழும் நாங்கூர்த் * திருமணிக்கூடத்தானே"],0,"/media/recitation/PT.4.5.1.mp3"],[1289,1289,["kavvai vAL eyiRRu vanpEy * kadhir mulai suvaiththu * ilanggai","vavviya iDumbai kUrak * kaDungkaNai thurandha endhai **","kovvai vAy magaLir konggaik * kunggumam kazhuvip pOndha *","dheyva nIr kamazhum nAnggUrth * thirumaNikkUDaththAnE"],["கவ்வை வாள் எயிற்று வன்பேய் * கதிர் முலை சுவைத்து * இலங்கை","வவ்விய இடும்பை கூரக் * கடுங்கணை துரந்த எந்தை **","கொவ்வை வாய் மகளிர் கொங்கைக் * குங்குமம் கழுவிப் போந்த *","தெய்வ நீர் கமழும் நாங்கூர்த் * திருமணிக்கூடத்தானே"],0,"/media/recitation/PT.4.5.2.mp3"],[1290,1290,["māt tŏzhil maṭaṅkac cĕṟṟu *","marutu iṟa naṭantu * vaṉ tāl̤","cet tŏzhil citaittup * piṉṉai","cĕvvit tol̤ puṇarnta ĕntai ** -","nāt tŏzhil maṟai vallārkal̤ *","nayantu aṟam payanta vaṇ kait *","tīt tŏzhil payilum nāṅkūrt *","tirumaṇikkūṭattāṉe-"],["மாத் தொழில் மடங்கச் செற்று *","மருது இற நடந்து * வன் தாள்","சேத் தொழில் சிதைத்துப் * பின்னை","செவ்வித் தோள் புணர்ந்த எந்தை **","நாத் தொழில் மறை வல்லார்கள் *","நயந்து அறம் பயந்த வண் கைத் *","தீத் தொழில் பயிலும் நாங்கூர்த் *","திருமணிக்கூடத்தானே"],1,"/media/recitation/PT.4.5.3.mp3"],[1291,1291,["tāṅku-arum ciṉattu vaṉ tāl̤ *","taṭak kai mā maruppu vāṅki *","pūṅ kuruntu ŏcittu pul̤ vāy","pil̤antu * ĕrutu aṭartta ĕntai ** -","māṅkaṉi nukarnta manti *","vantu vaṇṭu iriya * vāzhait","tīṅ kaṉi nukarum nāṅkūrt *","tirumaṇikkūṭattāṉe-"],["தாங்கு அரும் சினத்து வன் தாள் *","தடக் கை மா மருப்பு வாங்கி *","பூங் குருந்து ஒசித்து புள் வாய்","பிளந்து * எருது அடர்த்த எந்தை **","மாங்கனி நுகர்ந்த மந்தி *","வந்து வண்டு இரிய * வாழைத்","தீங் கனி நுகரும் நாங்கூர்த் *","திருமணிக்கூடத்தானே"],1,"/media/recitation/PT.4.5.4.mp3"],[1292,1292,["karu makal̤ ilaṅkaiyāṭṭi *","pilaṅ kŏl̤ vāy tiṟantu * taṉmel","varum-aval̤ cĕviyum mūkkum","vāl̤iṉāl taṭinta ĕntai ** -","pĕru makal̤ petai maṅkai *","taṉṉŏṭum pirivu ilāta *","tirumakal̤ maruvum nāṅkūrt *","tirumaṇikkūṭattāṉe-"],["கரு மகள் இலங்கையாட்டி *","பிலங் கொள் வாய் திறந்து * தன்மேல்","வரும் அவள் செவியும் மூக்கும்","வாளினால் தடிந்த எந்தை **","பெரு மகள் பேதை மங்கை *","தன்னொடும் பிரிவு இலாத *","திருமகள் மருவும் நாங்கூர்த் *","திருமணிக்கூடத்தானே"],1,"/media/recitation/PT.4.5.5.mp3"],[1293,1293,["keNDaiyum kuRaLum puLLum * kEzhalum ariyum mAvum *","aNDamum suDarum * allA ARRalum Aya endhai **","oNthiRal thennan ODa * vaDavarasu OTTam kaNDa *","thiNthiRalALar nAnggUrth * thirumaNikkUDaththAnE"],["கெண்டையும் குறளும் புள்ளும் * கேழலும் அரியும் மாவும் *","அண்டமும் சுடரும் * அல்லா ஆற்றலும் ஆய எந்தை **","ஒண்திறல் தென்னன் ஓட * வடவரசு ஓட்டம் கண்ட *","திண்திறலாளர் நாங்கூர்த் * திருமணிக்கூடத்தானே"],0,"/media/recitation/PT.4.5.6.mp3"],[1294,1294,["kuṉṟamum vāṉum maṇṇum *","kul̤ir puṉal tiṅkal̤oṭu *","niṉṟa vĕm cuṭarum allā *","nilaikal̤um āya ĕntai ** -","maṉṟamum vayalum kāvum *","māṭamum maṇaṅ kŏṇṭu * ĕṅkum","tĕṉṟal vantu ulavum nāṅkūrt *","tirumaṇikkūṭattāṉe-"],["குன்றமும் வானும் மண்ணும் *","குளிர் புனல் திங்களோடு *","நின்ற வெம் சுடரும் அல்லா *","நிலைகளும் ஆய எந்தை **","மன்றமும் வயலும் காவும் *","மாடமும் மணங் கொண்டு * எங்கும்","தென்றல் வந்து உலவும் நாங்கூர்த் *","திருமணிக்கூடத்தானே"],1,"/media/recitation/PT.4.5.7.mp3"],[1295,1295,["sanggaiyum thuNivum poyyum * meyyum iththaraNi Ombum *","ponggiya mugilum * allAp poruLgaLum Aya endhai **","panggayam uguththa thERal * parugiya vALai pAya *","sengkayal ugaLum nAnggUrth * thirumaNikkUDaththAnE"],["சங்கையும் துணிவும் பொய்யும் * மெய்யும் இத்தரணி ஓம்பும் *","பொங்கிய முகிலும் * அல்லாப் பொருள்களும் ஆய எந்தை **","பங்கயம் உகுத்த தேறல் * பருகிய வாளை பாய *","செங்கயல் உகளும் நாங்கூர்த் * திருமணிக்கூடத்தானே"],0,"/media/recitation/PT.4.5.8.mp3"],[1296,1296,["pAvamum aRamum vIDum * inbamum thunbam thAnum *","kOvamum aruLum * allAk guNanggaLum Aya endhai **","mUvaril enggaL mUrththi * ivan ena munivarODu *","dhEvar vandhu iRainjchum nAnggUrth * thirumaNikkUDaththAnE"],["பாவமும் அறமும் வீடும் * இன்பமும் துன்பம் தானும் *","கோவமும் அருளும் * அல்லாக் குணங்களும் ஆய எந்தை **","மூவரில் எங்கள் மூர்த்தி * இவன் என முனிவரோடு *","தேவர் வந்து இறைஞ்சும் நாங்கூர்த் * திருமணிக்கூடத்தானே"],0,"/media/recitation/PT.4.5.9.mp3"],[1297,1297,["** thinggaL thOy mADa nAnggUrth * thirumaNikkUDaththAnai *","manggaiyar thalaivan vaNthArk * kaliyan vAyoligaL vallAr **","ponggu nIr ulagam ANDu * ponnulagANDu * pinnum","vengkadhirp paridhi vaTTaththu * UDu pOy viLangguvArE"],["** திங்கள் தோய் மாட நாங்கூர்த் * திருமணிக்கூடத்தானை *","மங்கையர் தலைவன் வண்தார்க் * கலியன் வாயொலிகள் வல்லார் **","பொங்கு நீர் உலகம் ஆண்டு * பொன்னுலகாண்டு * பின்னும்","வெங்கதிர்ப் பரிதி வட்டத்து * ஊடு போய் விளங்குவாரே"],0,"/media/recitation/PT.4.5.10.mp3"]],[[1298,1298,["tā al̤antu ulakam muṟṟum *","taṭa malarp pŏykai pukku *","nā val̤am naviṉṟu aṅku etta *","nākattiṉ naṭukkam tīrttāy **","mā val̤am pĕruki maṉṉum *","maṟaiyavar vāzhum nāṅkai *","kāval̤ampāṭi meya *","kaṇṇaṉe kal̤aikaṇ nīye-"],["தா அளந்து உலகம் முற்றும் *","தட மலர்ப் பொய்கை புக்கு *","நா வளம் நவின்று அங்கு ஏத்த *","நாகத்தின் நடுக்கம் தீர்த்தாய் **","மா வளம் பெருகி மன்னும் *","மறையவர் வாழும் நாங்கை *","காவளம்பாடி மேய *","கண்ணனே களைகண் நீயே"],1,"/media/recitation/PT.4.6.1.mp3"],[1299,1299,["maNNiDandhu Enam Agi * mAvali vali tholaippAn *","viNNavar vENDach senRu * vELviyil kuRai irandhAy **","thuNNena mARRAr thammaith * tholaiththavar nAnggai mEya *","kaNNanE! kAvaLanthaNpADiyAy! * kaLaikaN nIyE"],["மண்ணிடந்து ஏனம் ஆகி * மாவலி வலி தொலைப்பான் *","விண்ணவர் வேண்டச் சென்று * வேள்வியில் குறை இரந்தாய் **","துண்ணென மாற்றார் தம்மைத் * தொலைத்தவர் நாங்கை மேய *","கண்ணனே! காவளந்தண்பாடியாய்! * களைகண் நீயே"],0,"/media/recitation/PT.4.6.2.mp3"],[1300,1300,["uruththezhu vAli mArbil * Oru kaNai uruva OTTi *","karuththuDaith thambikku * inbak kadhir muDi arasu aLiththAy **","paruththezhu palavum mAvum * pazham vizhundhu ozhugum nAnggai *","karuththanE! kAvaLanthaNpADiyAy! * kaLaikaN nIyE"],["உருத்தெழு வாலி மார்பில் * ஓரு கணை உருவ ஓட்டி *","கருத்துடைத் தம்பிக்கு * இன்பக் கதிர் முடி அரசு அளித்தாய் **","பருத்தெழு பலவும் மாவும் * பழம் விழுந்து ஒழுகும் நாங்கை *","கருத்தனே! காவளந்தண்பாடியாய்! * களைகண் நீயே"],0,"/media/recitation/PT.4.6.3.mp3"],[1301,1301,["munai mugaththu arakkan mALa * muDigaL paththu aRuththu vIzhththu * Anggu","anaiyavaRku iLaiyavaRkE * arasu aLiththu aruLinAnE! **","sunaigaLil kayalgaL pAyach * surumbu thEn nugarum nAnggai *","kanai kazhal kAvaLanthaNpADiyAy! * kaLaikaN nIyE"],["முனை முகத்து அரக்கன் மாள * முடிகள் பத்து அறுத்து வீழ்த்து * ஆங்கு","அனையவற்கு இளையவற்கே * அரசு அளித்து அருளினானே! **","சுனைகளில் கயல்கள் பாயச் * சுரும்பு தேன் நுகரும் நாங்கை *","கனை கழல் காவளந்தண்பாடியாய்! * களைகண் நீயே"],0,"/media/recitation/PT.4.6.4.mp3"],[1302,1302,["paDa aravu uchchi than mEl * pAyndhu pal naDanggaL seydhu *","maDavaral manggai thannai * mArvagaththu iruththinAnE! **","thaDavarai thanggu mADath * thagu pugazh nAnggai mEya *","kaDavuLE! kAvaLanthaNpADiyAy! * kaLaikaN nIyE"],["பட அரவு உச்சி தன் மேல் * பாய்ந்து பல் நடங்கள் செய்து *","மடவரல் மங்கை தன்னை * மார்வகத்து இருத்தினானே! **","தடவரை தங்கு மாடத் * தகு புகழ் நாங்கை மேய *","கடவுளே! காவளந்தண்பாடியாய்! * களைகண் நீயே"],0,"/media/recitation/PT.4.6.5.mp3"],[1303,1303,["mallarai aTTu mALak * kanjchanai malaindhu konRu *","pallarasu avindhu vIzhap * pAradhap pOr muDiththAy! **","nallaraN kAvin nIzhal * naRai kamazh nAnggai mEya *","kallaraN kAvaLanthaNpADiyAy! * kaLaikaN nIyE"],["மல்லரை அட்டு மாளக் * கஞ்சனை மலைந்து கொன்று *","பல்லரசு அவிந்து வீழப் * பாரதப் போர் முடித்தாய்! **","நல்லரண் காவின் நீழல் * நறை கமழ் நாங்கை மேய *","கல்லரண் காவளந்தண்பாடியாய்! * களைகண் நீயே"],0,"/media/recitation/PT.4.6.6.mp3"],[1304,1304,["mūttavaṟku aracu veṇṭi *","muṉpu tūtu ĕzhuntarul̤i *","māttu amar pākaṉ vīzha *","mata kari maruppu ŏcittāy **","pūttu amar colai oṅkip *","puṉal parantu ŏzhukum nāṅkai *","kāttaṉe kāval̤am taṇ","pāṭiyāy * kal̤aikaṇ nīye-"],["மூத்தவற்கு அரசு வேண்டி *","முன்பு தூது எழுந்தருளி *","மாத்து அமர் பாகன் வீழ *","மத கரி மருப்பு ஒசித்தாய் **","பூத்து அமர் சோலை ஓங்கிப் *","புனல் பரந்து ஒழுகும் நாங்கை *","காத்தனே காவளம் தண்","பாடியாய் * களைகண் நீயே"],1,"/media/recitation/PT.4.6.7.mp3"],[1305,1305,["EviLam kannikkAgi * imaiyavar kOnaich seRRu *","kAvaLam kaDidhiRuththuk * kaRpagam koNDu pOndhAy! **","pUvaLam pozhilgaL sUzhndha * purandharan seydha nAnggai *","kAvaLampADi mEya * kaNNanE! kaLaikaN nIyE"],["ஏவிளம் கன்னிக்காகி * இமையவர் கோனைச் செற்று *","காவளம் கடிதிறுத்துக் * கற்பகம் கொண்டு போந்தாய்! **","பூவளம் பொழில்கள் சூழ்ந்த * புரந்தரன் செய்த நாங்கை *","காவளம்பாடி மேய * கண்ணனே! களைகண் நீயே"],0,"/media/recitation/PT.4.6.8.mp3"],[1306,1306,["cantam āyc camayam ākic *","camaya aim pūtam āki *","antam āy āti āki *","aru maṟai-avaiyum āṉāy **","mantam ār pŏzhilkal̤toṟum *","maṭa mayil ālum nāṅkai *","kantam ār kāval̤am taṇ","pāṭiyāy * kal̤aikaṇ nīye-"],["சந்தம் ஆய்ச் சமயம் ஆகிச் *","சமய ஐம் பூதம் ஆகி *","அந்தம் ஆய் ஆதி ஆகி *","அரு மறை அவையும் ஆனாய் **","மந்தம் ஆர் பொழில்கள்தோறும் *","மட மயில் ஆலும் நாங்கை *","கந்தம் ஆர் காவளம் தண்","பாடியாய் * களைகண் நீயே"],1,"/media/recitation/PT.4.6.9.mp3"],[1307,1307,["mā val̤am pĕruki maṉṉum *","maṟaiyavar vāzhum * nāṅkaik","kāval̤ampāṭi meya *","kaṇṇaṉaik kaliyaṉ cŏṉṉa **","pā val̤am pattum vallār *","pārmicai aracar ākik *","ko il̤a maṉṉar tāzhak *","kuṭai nizhal pŏlivar-tāme-"],["மா வளம் பெருகி மன்னும் *","மறையவர் வாழும் * நாங்கைக்","காவளம்பாடி மேய *","கண்ணனைக் கலியன் சொன்ன **","பா வளம் பத்தும் வல்லார் *","பார்மிசை அரசர் ஆகிக் *","கோ இள மன்னர் தாழக் *","குடை நிழல் பொலிவர் தாமே"],1,"/media/recitation/PT.4.6.10.mp3"]],[[1308,1308,["** kaNNAr kaDal pOl * thirumEni kariyAy! *","naNNAr munai * venRi koLvAr mannu nAnggUr **","thiNNAr madhiL sUzh * thiruveLLakkuLaththuL","aNNA! * aDiyEn iDaraik kaLaiyAyE"],["** கண்ணார் கடல் போல் * திருமேனி கரியாய்! *","நண்ணார் முனை * வென்றி கொள்வார் மன்னு நாங்கூர் **","திண்ணார் மதிள் சூழ் * திருவெள்ளக்குளத்துள்","அண்ணா! * அடியேன் இடரைக் களையாயே"],0,"/media/recitation/PT.4.7.1.mp3"],[1309,1309,["kondhAr thuLava * malar koNDu aNivAnE! *","nandhAdha perum pugazh * vEdhiyar nAnggUr **","senthAmarai nIrth * thiruveLLakkuLaththuL","endhAy! * aDiyEn iDaraik kaLaiyAyE"],["கொந்தார் துளவ * மலர் கொண்டு அணிவானே! *","நந்தாத பெரும் புகழ் * வேதியர் நாங்கூர் **","செந்தாமரை நீர்த் * திருவெள்ளக்குளத்துள்","எந்தாய்! * அடியேன் இடரைக் களையாயே"],0,"/media/recitation/PT.4.7.2.mp3"],[1310,1310,["kunRAl kuLir mAri * thaDuththu ugandhAnE! *","nanRAya perum pugazh * vEdhiyar nAnggUr **","senRAr vaNanggum * thiruveLLakkuLaththuL","ninRAy! * neDiyAy! aDiyEn iDar nIkkE"],["குன்றால் குளிர் மாரி * தடுத்து உகந்தானே! *","நன்றாய பெரும் புகழ் * வேதியர் நாங்கூர் **","சென்றார் வணங்கும் * திருவெள்ளக்குளத்துள்","நின்றாய்! * நெடியாய்! அடியேன் இடர் நீக்கே"],0,"/media/recitation/PT.4.7.3.mp3"],[1311,1311,["kAnAr kari kombadhu * osiththa kaLiRE! *","nAnA vagai * nallavar manniya nAnggUr **","thEnAr pozhil sUzh * thiruveLLakkuLaththuL","AnAy! * aDiyEnukku aruL puriyAyE"],["கானார் கரி கொம்பது * ஒசித்த களிறே! *","நானா வகை * நல்லவர் மன்னிய நாங்கூர் **","தேனார் பொழில் சூழ் * திருவெள்ளக்குளத்துள்","ஆனாய்! * அடியேனுக்கு அருள் புரியாயே"],0,"/media/recitation/PT.4.7.4.mp3"],[1312,1312,["** vEDAr thiruvEngkaDam * mEya viLakkE! *","nADAr pugazh * vEdhiyar manniya nAnggUr **","sEDAr pozhil sUzh * thiruveLLakkuLaththAy! *","pADA varuvEn * vinai Ayina pARRE"],["** வேடார் திருவேங்கடம் * மேய விளக்கே! *","நாடார் புகழ் * வேதியர் மன்னிய நாங்கூர் **","சேடார் பொழில் சூழ் * திருவெள்ளக்குளத்தாய்! *","பாடா வருவேன் * வினை ஆயின பாற்றே"],0,"/media/recitation/PT.4.7.5.mp3"],[1313,1313,["kallAl kaDalai * aNai kaTTi ugandhAy! *","nallAr palar * vEdhiyar manniya nAnggUr **","selvA! * thiruveLLakkuLaththu uRaivAnE! *","ellA iDarum * keDumARu aruLAyE"],["கல்லால் கடலை * அணை கட்டி உகந்தாய்! *","நல்லார் பலர் * வேதியர் மன்னிய நாங்கூர் **","செல்வா! * திருவெள்ளக்குளத்து உறைவானே! *","எல்லா இடரும் * கெடுமாறு அருளாயே"],0,"/media/recitation/PT.4.7.6.mp3"],[1314,1314,["kOlAl nirai mEyththa * engkOvalar kOvE! *","nAlAgiya * vEdhiyar manniya nAnggUr **","sElAr vayal sUzh * thiruveLLakkuLaththuL","mAlE! * ena valvinai thIrththu aruLAyE"],["கோலால் நிரை மேய்த்த * எங்கோவலர் கோவே! *","நாலாகிய * வேதியர் மன்னிய நாங்கூர் **","சேலார் வயல் சூழ் * திருவெள்ளக்குளத்துள்","மாலே! * என வல்வினை தீர்த்து அருளாயே"],0,"/media/recitation/PT.4.7.7.mp3"],[1315,1315,["vārākam-atu āki * im maṇṇai iṭantāy *","nārāyaṇaṉe! * nalla vetiyar nāṅkūr *","cīr ār pŏzhil cūzh * tiruvĕl̤l̤akkul̤attul̤ *","ārāamute * aṭiyeṟku arul̤āye-"],["வாராகம் அது ஆகி * இம் மண்ணை இடந்தாய் *","நாராயணனே! * நல்ல வேதியர் நாங்கூர் **","சீர் ஆர் பொழில் சூழ் * திருவெள்ளக்குளத்துள்","ஆராஅமுதே * அடியேற்கு அருளாயே"],1,"/media/recitation/PT.4.7.8.mp3"],[1316,1316,["pUvAr thirumAmagaL * pulgiya mArbA! *","nAvAr pugazh * vEdhiyar manniya nAnggUrth **","dhEvA! * thiruveLLakkuLaththu uRaivAnE! *","AvA! aDiyAn * ivan enRu aruLAyE"],["பூவார் திருமாமகள் * புல்கிய மார்பா! *","நாவார் புகழ் * வேதியர் மன்னிய நாங்கூர்த் **","தேவா! * திருவெள்ளக்குளத்து உறைவானே! *","ஆவா! அடியான் * இவன் என்று அருளாயே"],0,"/media/recitation/PT.4.7.9.mp3"],[1317,1317,["** nal anbuDai * vEdhiyar manniya nAnggUr *","selvan * thiruveLLakkuLaththu uRaivAnai **","kallin mali thOL * kaliyan sonna mAlai *","vallar ena vallavar * vAnavar thAmE"],["** நல் அன்புடை * வேதியர் மன்னிய நாங்கூர் *","செல்வன் * திருவெள்ளக்குளத்து உறைவானை **","கல்லின் மலி தோள் * கலியன் சொன்ன மாலை *","வல்லர் என வல்லவர் * வானவர் தாமே"],0,"/media/recitation/PT.4.7.10.mp3"]],[[1318,1318,["** kavaLa yAnaik kombu osiththa * kaNNan enRum kAmaru sIr *","kuvaLai mEgam anna mEni * koNDa kOn en Anai enRum **","thavaLa mADa nIDu nAnggaith * thAmaraiyAL kELvan enRum *","pavaLa vAyAL en maDandhai * pArththanpaLLi pADuvALE"],["** கவள யானைக் கொம்பு ஒசித்த * கண்ணன் என்றும் காமரு சீர் *","குவளை மேகம் அன்ன மேனி * கொண்ட கோன் என் ஆனை என்றும் **","தவள மாட நீடு நாங்கைத் * தாமரையாள் கேள்வன் என்றும் *","பவள வாயாள் என் மடந்தை * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.1.mp3"],[1319,1319,["kanjchan viTTa venjchinaththa * kaLiRu aDarththa kALai enRum *","vanjchamEvi vandha pEyin * uyirai uNDa mAyan enRum **","senjcholALar nIDu nAnggaith * dhEva dhEvan enRenRu Odhi *","panjchi anna mellaDiyAL * pArththanpaLLi pADuvALE"],["கஞ்சன் விட்ட வெஞ்சினத்த * களிறு அடர்த்த காளை என்றும் *","வஞ்சமேவி வந்த பேயின் * உயிரை உண்ட மாயன் என்றும் **","செஞ்சொலாளர் நீடு நாங்கைத் * தேவ தேவன் என்றென்று ஓதி *","பஞ்சி அன்ன மெல்லடியாள் * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.2.mp3"],[1320,1320,["aṇṭar-koṉ ĕṉ āṉai ĕṉṟum *","āyar mātar kŏṅkai pulku","cĕṇṭaṉ ĕṉṟum * nāṉmaṟaikal̤","teṭi oṭum * cĕlvaṉ ĕṉṟum **","vaṇṭu ulāvu pŏzhil kŏl̤ nāṅkai *","maṉṉum māyaṉ ĕṉṟu ĕṉṟu oti * -","paṇṭupol aṉṟu-ĕṉ maṭantai *","pārttaṉpal̤l̤i pāṭuvāl̤e-"],["அண்டர் கோன் என் ஆனை என்றும் *","ஆயர் மாதர் கொங்கை புல்கு","செண்டன் என்றும் * நான்மறைகள்","தேடி ஓடும் * செல்வன் என்றும் **","வண்டு உலாவு பொழில் கொள் நாங்கை *","மன்னும் மாயன் என்று என்று ஓதி *","பண்டுபோல் அன்று என் மடந்தை *","பார்த்தன்பள்ளி பாடுவாளே"],1,"/media/recitation/PT.4.8.3.mp3"],[1321,1321,["kollai AnAL parisazhindhAL * kOl vaLaiyAr tham mugappE *","mallai munnIr thaTTilanggai * kaTTazhiththa mAyan enRum **","selvam malgu maRaiyOr nAnggai * dhEva dhEvan enRenRu Odhi *","palvaLaiyAL en maDandhai * pArththanpaLLi pADuvALE"],["கொல்லை ஆனாள் பரிசழிந்தாள் * கோல் வளையார் தம் முகப்பே *","மல்லை முந்நீர் தட்டிலங்கை * கட்டழித்த மாயன் என்றும் **","செல்வம் மல்கு மறையோர் நாங்கை * தேவ தேவன் என்றென்று ஓதி *","பல்வளையாள் என் மடந்தை * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.4.mp3"],[1322,1322,["arakkar āvi māl̤a aṉṟu *","āzh kaṭal cūzh ilaṅkai cĕṟṟa *","kurakkaracaṉ ĕṉṟum * kola","villi ĕṉṟum ** mā matiyai","nĕrukkum māṭam nīṭu nāṅkai *","niṉmalaṉ-tāṉ ĕṉṟu ĕṉṟu oti *","parakkazhintāl̤ ĕṉ maṭantai *","pārttaṉpal̤l̤i pāṭuvāl̤e-"],["அரக்கர் ஆவி மாள அன்று *","ஆழ் கடல் சூழ் இலங்கை செற்ற *","குரக்கரசன் என்றும் * கோல","வில்லி என்றும் ** மா மதியை","நெருக்கும் மாடம் நீடு நாங்கை *","நின்மலன் தான் என்று என்று ஓதி *","பரக்கழிந்தாள் என் மடந்தை *","பார்த்தன்பள்ளி பாடுவாளே"],1,"/media/recitation/PT.4.8.5.mp3"],[1323,1323,["ñālam muṟṟum uṇṭu umizhnta *","nātaṉ ĕṉṟum nāṉilam cūzh *","velai aṉṉa kola meṉi *","vaṇṇaṉ ĕṉṟum ** mel ĕzhuntu","cel ukal̤um vayal kŏl̤ nāṅkait *","teva-tevaṉ ĕṉṟu ĕṉṟu oti *","pāliṉ nalla mĕṉ-mŏzhiyāl̤ *","pārttaṉpal̤l̤i pāṭuvāl̤e-"],["ஞாலம் முற்றும் உண்டு உமிழ்ந்த *","நாதன் என்றும் நானிலம் சூழ் *","வேலை அன்ன கோல மேனி *","வண்ணன் என்றும் ** மேல் எழுந்து","சேல் உகளும் வயல் கொள் நாங்கைத் *","தேவ தேவன் என்று என்று ஓதி *","பாலின் நல்ல மென் மொழியாள் *","பார்த்தன்பள்ளி பாடுவாளே"],1,"/media/recitation/PT.4.8.6.mp3"],[1324,1324,["nADi endhan uLLam koNDa * nAdhan enRum * nAnmaRaigaL","thEDi enRum kANa mATTAch * selvan enRum ** siRai koL vaNDu","sEDulavu pozhil koL nAnggaith * dhEva dhEvan enRenRu Odhi *","pADagam sEr mellaDiyAL * pArththanpaLLi pADuvALE"],["நாடி என்தன் உள்ளம் கொண்ட * நாதன் என்றும் * நான்மறைகள்","தேடி என்றும் காண மாட்டாச் * செல்வன் என்றும் ** சிறை கொள் வண்டு","சேடுலவு பொழில் கொள் நாங்கைத் * தேவ தேவன் என்றென்று ஓதி *","பாடகம் சேர் மெல்லடியாள் * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.7.mp3"],[1325,1325,["ulagam Eththum oruvan enRum * oNsuDarODu umbar eydhA *","nilavum Azhip paDaiyan enRum * nEsan enRum ** thenthisaikkuth","thiladham anna maRaiyOr nAnggaith * dhEva dhEvan enRenRu Odhi *","palarum Esa en maDandhai * pArththanpaLLi pADuvALE"],["உலகம் ஏத்தும் ஒருவன் என்றும் * ஒண்சுடரோடு உம்பர் எய்தா *","நிலவும் ஆழிப் படையன் என்றும் * நேசன் என்றும் ** தென்திசைக்குத்","திலதம் அன்ன மறையோர் நாங்கைத் * தேவ தேவன் என்றென்று ஓதி *","பலரும் ஏச என் மடந்தை * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.8.mp3"],[1326,1326,["kaNNan enRum vAnavargaL * kAdhaliththu malargaL thUvum *","eNNan enRum inban enRum * Ezhulagukku Adhi enRum **","thiNNa mADa nIDu nAnggaith * dhEva dhEvan enRenRu Odhi *","paNNin anna menmozhiyAL * pArththanpaLLi pADuvALE"],["கண்ணன் என்றும் வானவர்கள் * காதலித்து மலர்கள் தூவும் *","எண்ணன் என்றும் இன்பன் என்றும் * ஏழுலகுக்கு ஆதி என்றும் **","திண்ண மாட நீடு நாங்கைத் * தேவ தேவன் என்றென்று ஓதி *","பண்ணின் அன்ன மென்மொழியாள் * பார்த்தன்பள்ளி பாடுவாளே"],0,"/media/recitation/PT.4.8.9.mp3"],[1327,1327,["** pAruL nalla maRaiyOr nAnggaip * pArththanpaLLich sengkaN mAlai *","vArkoL nalla mulai maDavAL pADalaith * thAy mozhindha mARRam **","kUrkoL nalla vEl kaliyan * kURu thamizh paththum vallAr *","ErkoL nalla vaikunthaththuL * inbam nALum eydhuvArE"],["** பாருள் நல்ல மறையோர் நாங்கைப் * பார்த்தன்பள்ளிச் செங்கண் மாலை *","வார்கொள் நல்ல முலை மடவாள் பாடலைத் * தாய் மொழிந்த மாற்றம் **","கூர்கொள் நல்ல வேல் கலியன் * கூறு தமிழ் பத்தும் வல்லார் *","ஏர்கொள் நல்ல வைகுந்தத்துள் * இன்பம் நாளும் எய்துவாரே"],0,"/media/recitation/PT.4.8.10.mp3"]],[[1328,1328,["** nummaith thozhudhOm * nundham paNi seydhirukkum num aDiyOm *","immaikku inbam peRROm * endhAy! indhaLUrIrE! **","emmaik kaDidhAk karumam aruLi * AvA! enRu iranggi *","nammai orukAl kATTi naDandhAl * nAnggaL uyyOmE?"],["** நும்மைத் தொழுதோம் * நுந்தம் பணி செய்திருக்கும் நும் அடியோம் *","இம்மைக்கு இன்பம் பெற்றோம் * எந்தாய்! இந்தளூரீரே! **","எம்மைக் கடிதாக் கருமம் அருளி * ஆவா! என்று இரங்கி *","நம்மை ஒருகால் காட்டி நடந்தால் * நாங்கள் உய்யோமே?"],0,"/media/recitation/PT.4.9.1.mp3"],[1329,1329,["** sindhai thannuL nInggAdhu irundha thiruvE! * maruviniya","maindhA! * andhaN Ali mAlE! * sOlai mazhakaLiRE! **","nandhA viLakkin suDarE! * naRaiyUr ninRa nambI! * en","endhAy! indhaLUrAy! * aDiyERku iRaiyum iranggAyE!"],["** சிந்தை தன்னுள் நீங்காது இருந்த திருவே! * மருவினிய","மைந்தா! * அந்தண் ஆலி மாலே! * சோலை மழகளிறே! **","நந்தா விளக்கின் சுடரே! * நறையூர் நின்ற நம்பீ! * என்","எந்தாய்! இந்தளூராய்! * அடியேற்கு இறையும் இரங்காயே!"],0,"/media/recitation/PT.4.9.2.mp3"],[1330,1330,["pEsuginRadhu idhuvE * vaiyam IraDiyAl aLandha *","mUsi vaNDu muralum * kaNNi muDiyIr! ** ummaik kANum","Asai ennum * kaDalil vIzhndhu inggu ayarththOm * ayalArum","EsuginRadhu idhuvE kANum * indhaLUrIrE!"],["பேசுகின்றது இதுவே * வையம் ஈரடியால் அளந்த *","மூசி வண்டு முரலும் * கண்ணி முடியீர்! ** உம்மைக் காணும்","ஆசை என்னும் * கடலில் வீழ்ந்து இங்கு அயர்த்தோம் * அயலாரும்","ஏசுகின்றது இதுவே காணும் * இந்தளூரீரே!"],0,"/media/recitation/PT.4.9.3.mp3"],[1331,1331,["ācai vazhuvātu ettum * ĕmakku iṅku izhukkāyttu * aṭiyorkku","tecam aṟiya * umakke āl̤āyt tirikiṉṟomukku **","kāciṉ ŏl̤iyil tikazhum vaṇṇam * kāṭṭīr ĕm pĕrumāṉ *","vāci vallīr intal̤ūrīr! * -vāzhnte pom nīre-"],["ஆசை வழுவாது ஏத்தும் * எமக்கு இங்கு இழுக்காய்த்து * அடியோர்க்கு","தேசம் அறிய * உமக்கே ஆளாய்த் திரிகின்றோமுக்கு **","காசின் ஒளியில் திகழும் வண்ணம் * காட்டீர் எம் பெருமான் *","வாசி வல்லீர் இந்தளூரீர்! * வாழ்ந்தே போம் நீரே"],1,"/media/recitation/PT.4.9.4.mp3"],[1332,1332,["thI emperumAn nIr emperumAn * thisaiyum iru nilanu","mAy * emperumAn Agi ninRAl * aDiyOm kANOmAl **","thAy emperumAn * thandhai thandhai AvIr * aDiyOmuk","kE emperumAn allIrO? nIr * indhaLUrIrE!"],["தீ எம்பெருமான் நீர் எம்பெருமான் * திசையும் இரு நிலனு","மாய் * எம்பெருமான் ஆகி நின்றால் * அடியோம் காணோமால் **","தாய் எம்பெருமான் * தந்தை தந்தை ஆவீர் * அடியோமுக்","கே எம்பெருமான் அல்லீரோ? நீர் * இந்தளூரீரே!"],0,"/media/recitation/PT.4.9.5.mp3"],[1333,1333,["cŏllātu ŏzhiyakilleṉ * aṟinta cŏllil * num aṭiyār","ĕllāroṭum ŏkka * ĕṇṇiyiruntīr aṭiyeṉai **","nallār aṟivīr tīyār aṟivīr * namakku-iv ulakattil *","ĕllām aṟivīr-īte aṟiyīr * intal̤ūrīre-"],["சொல்லாது ஒழியகில்லேன் * அறிந்த சொல்லில் * நும் அடியார்","எல்லாரோடும் ஒக்க * எண்ணியிருந்தீர் அடியேனை **","நல்லார் அறிவீர் தீயார் அறிவீர் * நமக்கு இவ் உலகத்தில் *","எல்லாம் அறிவீர் ஈதே அறியீர் * இந்தளூரீரே"],1,"/media/recitation/PT.4.9.6.mp3"],[1334,1334,["mATTIr AnIr paNi nIr koLLa * emmaip paNi aRiyA","vITTIr * idhanai vERE sonnOm * indhaLUrIrE! **","kATTIr AnIr * nuntham aDikkaL kATTil * umakku indha","nATTE vandhu thoNDar Ana * nAnggaL uyyOmE?"],["மாட்டீர் ஆனீர் பணி நீர் கொள்ள * எம்மைப் பணி அறியா","வீட்டீர் * இதனை வேறே சொன்னோம் * இந்தளூரீரே! **","காட்டீர் ஆனீர் * நுந்தம் அடிக்கள் காட்டில் * உமக்கு இந்த","நாட்டே வந்து தொண்டர் ஆன * நாங்கள் உய்யோமே?"],0,"/media/recitation/PT.4.9.7.mp3"],[1335,1335,["munnai vaNNam pAlin vaNNam * muzhudhum nilai ninRa *","pinnai vaNNam konDal vaNNam * vaNNam eNNungkAl **","ponnin vaNNam maNiyin vaNNam * puraiyum thirumEni *","inna vaNNam enRu kATTIr * indhaLUrIrE!"],["முன்னை வண்ணம் பாலின் வண்ணம் * முழுதும் நிலை நின்ற *","பின்னை வண்ணம் கொன்டல் வண்ணம் * வண்ணம் எண்ணுங்கால் **","பொன்னின் வண்ணம் மணியின் வண்ணம் * புரையும் திருமேனி *","இன்ன வண்ணம் என்று காட்டீர் * இந்தளூரீரே!"],0,"/media/recitation/PT.4.9.8.mp3"],[1336,1336,["endhai thandhai thammAn enRenRu * emar Ezh aLavum *","vandhu ninRa thoNDarOrkkE * vAsi vallIrAl **","sindhai thannuL mundhi niRRir * siRidhum thirumEni *","indha vaNNam enRu kATTIr * indhaLUrIrE"],["எந்தை தந்தை தம்மான் என்றென்று * எமர் ஏழ் அளவும் *","வந்து நின்ற தொண்டரோர்க்கே * வாசி வல்லீரால் **","சிந்தை தன்னுள் முந்தி நிற்றிர் * சிறிதும் திருமேனி *","இந்த வண்ணம் என்று காட்டீர் * இந்தளூரீரே"],0,"/media/recitation/PT.4.9.9.mp3"],[1337,1337,["** ErAr pozhil sUzh * indhaLUril endhai perumAnai *","kArAr puRavin manggai vEndhan * kaliyan oli seydha **","sIrAr insol mAlai * kaRRuth thirivAr ulagaththil *","ArAr avarE * amararkku enRum amarar AvArE"],["** ஏரார் பொழில் சூழ் * இந்தளூரில் எந்தை பெருமானை *","காரார் புறவின் மங்கை வேந்தன் * கலியன் ஒலி செய்த **","சீரார் இன்சொல் மாலை * கற்றுத் திரிவார் உலகத்தில் *","ஆரார் அவரே * அமரர்க்கு என்றும் அமரர் ஆவாரே"],0,"/media/recitation/PT.4.9.10.mp3"]],[[1338,1338,["āycciyar azhaippa vĕṇṇĕy uṇṭu ŏrukāl *","āl ilai val̤arnta ĕm pĕrumāṉ *","peycciyai mulai uṇṭu iṇai marutu iṟuttup *","pĕru nilam al̤antavaṉ koyil ** -","kāytta nīl̤ kamukum kataliyum tĕṅkum *","ĕṅkum ām pŏzhilkal̤iṉ naṭuve *","vāytta nīr pāyum maṇṇiyiṉ tĕṉpāl * -","tiruvĕl̤l̤iyaṅkuṭi-atuve-"],["ஆய்ச்சியர் அழைப்ப வெண்ணெய் உண்டு ஒருகால் *","ஆல் இலை வளர்ந்த எம் பெருமான் *","பேய்ச்சியை முலை உண்டு இணை மருது இறுத்துப் *","பெரு நிலம் அளந்தவன் கோயில் **","காய்த்த நீள் கமுகும் கதலியும் தெங்கும் *","எங்கும் ஆம் பொழில்களின் நடுவே *","வாய்த்த நீர் பாயும் மண்ணியின் தென்பால் *","திருவெள்ளியங்குடி அதுவே"],1,"/media/recitation/PT.4.10.1.mp3"],[1339,1339,["Anirai mEyththu anRu alaikaDal aDaiththiTTu *","arakkar tham siranggaLai uruTTi *","kAr niRai mEgam kalandhadhOr uruvak *","kaNNanAr karudhiya kOyil **","pU niraich serundhi punnai muththarumbip *","podhumbiDai varivaNDu miNDi *","thEn iraiththu uNDu anggu innisai muralum *","thiruveLLiyangkuDi adhuvE"],["ஆநிரை மேய்த்து அன்று அலைகடல் அடைத்திட்டு *","அரக்கர் தம் சிரங்களை உருட்டி *","கார் நிறை மேகம் கலந்ததோர் உருவக் *","கண்ணனார் கருதிய கோயில் **","பூ நிரைச் செருந்தி புன்னை முத்தரும்பிப் *","பொதும்பிடை வரிவண்டு மிண்டி *","தேன் இரைத்து உண்டு அங்கு இன்னிசை முரலும் *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.2.mp3"],[1340,1340,["kaDu viDam uDaiya kALiyan thaDaththaik *","kalakki mun alakkazhiththu * avan than","paDam iRap pAyndhu pal maNi sindhap *","pal naDam payinRavan kOyil **","paDavaravu algul pAvai nallArgaL *","payiRRiya nADagaththu oli pOy *","aDai puDai thazhuvi aNDam ninRu adhirum *","thiruveLLiyangkuDi adhuvE"],["கடு விடம் உடைய காளியன் தடத்தைக் *","கலக்கி முன் அலக்கழித்து * அவன் தன்","படம் இறப் பாய்ந்து பல் மணி சிந்தப் *","பல் நடம் பயின்றவன் கோயில் **","படவரவு அல்குல் பாவை நல்லார்கள் *","பயிற்றிய நாடகத்து ஒலி போய் *","அடை புடை தழுவி அண்டம் நின்று அதிரும் *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.3.mp3"],[1341,1341,["kaRavai mun kAththuk kanjchanaik kAyndha *","kALamEgath thiru uruvan *","paRavai mun uyarththup pARkaDal thuyinRa *","paramanAr paLLi koL kOyil **","thuRai thuRai thORum ponmaNi sidhaRum *","thoguthirai maNNiyin thenpAl *","seRimaNi mADak koDi kadhir aNavum *","thiruveLLiyangkuDi adhuvE"],["கறவை முன் காத்துக் கஞ்சனைக் காய்ந்த *","காளமேகத் திரு உருவன் *","பறவை முன் உயர்த்துப் பாற்கடல் துயின்ற *","பரமனார் பள்ளி கொள் கோயில் **","துறை துறை தோறும் பொன்மணி சிதறும் *","தொகுதிரை மண்ணியின் தென்பால் *","செறிமணி மாடக் கொடி கதிர் அணவும் *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.4.mp3"],[1342,1342,["pArinai uNDu pArinai umizhndhu *","pAradham kai eRindhu * orukAl","thErinai Urndhu thErinaith thurandha *","sengkaNmAl senRu uRai kOyil **","Er nirai vayaluL vALaigaL maRugi *","emakkiDam anRu idhu enRu eNNi *","sIr mali poygai senRu aNaiginRa *","thiruveLLiyangkuDi adhuvE"],["பாரினை உண்டு பாரினை உமிழ்ந்து *","பாரதம் கை எறிந்து * ஒருகால்","தேரினை ஊர்ந்து தேரினைத் துரந்த *","செங்கண்மால் சென்று உறை கோயில் **","ஏர் நிரை வயலுள் வாளைகள் மறுகி *","எமக்கிடம் அன்று இது என்று எண்ணி *","சீர் மலி பொய்கை சென்று அணைகின்ற *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.5.mp3"],[1343,1343,["kARRiDaip pULai karandhana arandhai","uRak * kaDal arakkar tham sEnai *","kURRiDaich sellak koDungkaNai thurandha *","kOlavilli irAman than kOyil **","URRiDai ninRa vAzhaiyin kanigaL *","Uzhththu vIzhndhana uNDu maNDi *","sERRiDaik kayalgaL ugaL thigazh vayal sUzh *","thiruveLLiyangkuDi adhuvE"],["காற்றிடைப் பூளை கரந்தன அரந்தை","உறக் * கடல் அரக்கர் தம் சேனை *","கூற்றிடைச் செல்லக் கொடுங்கணை துரந்த *","கோலவில்லி இராமன் தன் கோயில் **","ஊற்றிடை நின்ற வாழையின் கனிகள் *","ஊழ்த்து வீழ்ந்தன உண்டு மண்டி *","சேற்றிடைக் கயல்கள் உகள் திகழ் வயல் சூழ் *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.6.mp3"],[1344,1344,["OLLiya karumam seyvan enRu uNarndha *","mAvali vELviyil pukku *","theLLiya kuRaLAy mUvaDi koNDu *","thikkuRa vaLarndhavan kOyil **","aLLi ampozhilvAy irundhu vAzh kuyilgaL *","ari ari enRavai azhaippa *","veLLiyAr vaNangga viraindhu aruL seyvAn *","thiruveLLiyangkuDi adhuvE"],["ஓள்ளிய கருமம் செய்வன் என்று உணர்ந்த *","மாவலி வேள்வியில் புக்கு *","தெள்ளிய குறளாய் மூவடி கொண்டு *","திக்குற வளர்ந்தவன் கோயில் **","அள்ளி அம்பொழில்வாய் இருந்து வாழ் குயில்கள் *","அரி அரி என்றவை அழைப்ப *","வெள்ளியார் வணங்க விரைந்து அருள் செய்வான் *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.7.mp3"],[1345,1345,["muDi uDai amararkku iDar seyyum *","asurar tham perumAnai * anRu ariyAy","maDi iDai vaiththu mArvai mun kINDa *","mAyanAr manniya kOyil **","paDi iDai mADaththu aDiyiDaith thUNil *","padhiththa panmaNigaLin oLiyAl *","viDi pagal iravenRu aRivaridhAya *","thiruveLLiyangkuDi adhuvE"],["முடி உடை அமரர்க்கு இடர் செய்யும் *","அசுரர் தம் பெருமானை * அன்று அரியாய்","மடி இடை வைத்து மார்வை முன் கீண்ட *","மாயனார் மன்னிய கோயில் **","படி இடை மாடத்து அடியிடைத் தூணில் *","பதித்த பன்மணிகளின் ஒளியால் *","விடி பகல் இரவென்று அறிவரிதாய *","திருவெள்ளியங்குடி அதுவே"],0,"/media/recitation/PT.4.10.8.mp3"],[1346,1346,["kuṭi kuṭi ākak kūṭi niṉṟu amarar *","kuṇaṅkal̤e pitaṟṟi niṉṟu etta *","aṭiyavarkku arul̤i aravu-aṇait tuyiṉṟa *","āzhiyāṉ amarntu uṟai koyil ** -","kaṭi uṭaik kamalam aṭiyiṭai malarak *","karumpŏṭu pĕruñ cĕnnĕl acaiya *","vaṭivu uṭai aṉṉam pĕṭaiyŏṭum cerum *","vayal-vĕl̤l̤iyaṅkuṭi-atuve-"],["குடி குடி ஆகக் கூடி நின்று அமரர் *","குணங்களே பிதற்றி நின்று ஏத்த *","அடியவர்க்கு அருளி அரவு அணைத் துயின்ற *","ஆழியான் அமர்ந்து உறை கோயில் **","கடி உடைக் கமலம் அடியிடை மலரக் *","கரும்பொடு பெருஞ் செந்நெல் அசைய *","வடிவு உடை அன்னம் பெடையொடும் சேரும் *","வயல் வெள்ளியங்குடி அதுவே"],1,"/media/recitation/PT.4.10.9.mp3"],[1347,1347,["** paNDu mun EnamAgi anRu orukAl *","pAr iDandhu eyiRRinil koNDu *","theNthirai varuDap pARkaDal thuyinRa *","thiruveLLiyangkuDiyAnai **","vaNDaRai sOlai manggaiyar thalaivan *","mAnavEl kaliyan vAy oligaL *","koNDivai pADum thavam uDaiyArgaL *","ALvar ikkurai kaDal ulagE"],["** பண்டு முன் ஏனமாகி அன்று ஒருகால் *","பார் இடந்து எயிற்றினில் கொண்டு *","தெண்திரை வருடப் பாற்கடல் துயின்ற *","திருவெள்ளியங்குடியானை **","வண்டறை சோலை மங்கையர் தலைவன் *","மானவேல் கலியன் வாய் ஒலிகள் *","கொண்டிவை பாடும் தவம் உடையார்கள் *","ஆள்வர் இக்குரை கடல் உலகே"],0,"/media/recitation/PT.4.10.10.mp3"]]]