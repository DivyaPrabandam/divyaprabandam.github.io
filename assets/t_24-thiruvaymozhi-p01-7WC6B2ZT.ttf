[[[2791,2791,["** uyarvaRa uyar nalam * uDaiyavan yavan avan *","mayarvaRa madhi nalam * aruLinan yavan avan **","ayarvaRum amarargaL * adhipadhi yavan avan *","thuyaraRu suDar aDi * thozhudhu ezhu en mananE!"],["** உயர்வற உயர் நலம் * உடையவன் யவன் அவன் *","மயர்வு அற மதி நலம் * அருளினன் யவன் அவன் **","அயர்வு அறும் அமரர்கள் * அதிபதி யவன் அவன் *","துயரறு சுடர் அடி * தொழுது எழு என் மனனே!"],0,"/media/recitation/TVM.1.1.1.mp3"],[2792,2792,["manan agam malam aRa * malar misai ezhu tharum *","manan uNarvu aLavilan * poRi uNarvu avai ilan **","inan uNar muzhu nalam * edhir nigazh kazhivinum *","inan ilan enan uyir * migunarai ilanE"],["மனன் அகம் மலம் அற * மலர் மிசை எழு தரும் *","மனன் உணர்வு அளவிலன் * பொறி உணர்வு அவை இலன் **","இனன் உணர் முழு நலம் * எதிர் நிகழ் கழிவினும் *","இனன் இலன் எனன் உயிர் * மிகுநரை இலனே"],0,"/media/recitation/TVM.1.1.2.mp3"],[2793,2793,["ilan adhu uDaiyan idhu * ena ninaivu ariyavan *","nilaniDai visumbiDai * uruvinan aruvinan **","pulanoDu pulan alan * ozhivilan parandha * an","nalan uDai oruvanai * naNuginam nAmE"],["இலன் அது உடையன் இது * என நினைவு அரியவன் *","நிலனிடை விசும்பிடை * உருவினன் அருவினன் **","புலனொடு புலன் அலன் * ஒழிவிலன் பரந்த * அந்","நலன் உடை ஒருவனை * நணுகினம் நாமே"],0,"/media/recitation/TVM.1.1.3.mp3"],[2794,2794,["nAm avan ivan uvan * avaL ivaL uvaL evaL *","thAm avar ivar uvar * adhu idhu udhu edhu **","vIm avai ivai uvai * avai nalam thInggavai *","Am avai Ay avai * Ay ninRa avarE"],["நாம் அவன் இவன் உவன் * அவள் இவள் உவள் எவள் *","தாம் அவர் இவர் உவர் * அது இது உது எது **","வீம் அவை இவை உவை * அவை நலம் தீங்கவை *","ஆம் அவை ஆய் அவை * ஆய் நின்ற அவரே"],0,"/media/recitation/TVM.1.1.4.mp3"],[2795,2795,["avaravar thamathamadhu * aRivaRi vagai vagai *","avaravar iRaiyavar * ena aDi aDaivargaL **","avaravar iRaiyavar * kuRaivilar iRaiyavar *","avaravar vidhi vazhi * aDaiya ninRanarE"],["அவரவர் தமதமது * அறிவறி வகை வகை *","அவரவர் இறையவர் * என அடி அடைவர்கள் **","அவரவர் இறையவர் * குறைவிலர் இறையவர் *","அவரவர் விதி வழி * அடைய நின்றனரே"],0,"/media/recitation/TVM.1.1.5.mp3"],[2796,2796,["ninRanar irundhanar * kiDandhanar thirindhanar *","ninRilar irundhilar * kiDandhilar thirindhilar **","enRumor iyalvinar * ena ninaivu ariyavar *","enRumor iyalvoDu * ninRa em thiDarE"],["நின்றனர் இருந்தனர் * கிடந்தனர் திரிந்தனர் *","நின்றிலர் இருந்திலர் * கிடந்திலர் திரிந்திலர் **","என்றுமொர் இயல்வினர் * என நினைவு அரியவர் *","என்றுமொர் இயல்வொடு * நின்ற எம் திடரே"],0,"/media/recitation/TVM.1.1.6.mp3"],[2797,2797,["thiDa visumbu eri vaLi * nIr nilam ivai misai *","paDar poruL muzhuvadhumAy * avai avai thoRum **","uDal misai uyir enak * karandhu enggum parandhuLan *","suDar migu surudhiyuL * ivai uNDa suranE"],["திட விசும்பு எரி வளி * நீர் நிலம் இவை மிசை *","படர் பொருள் முழுவதுமாய் * அவை அவை தொறும் **","உடல் மிசை உயிர் எனக் * கரந்து எங்கும் பரந்துளன் *","சுடர் மிகு சுருதியுள் * இவை உண்ட சுரனே"],0,"/media/recitation/TVM.1.1.7.mp3"],[2798,2798,["surar aRivu aru nilai * viN mudhal muzhuvadhum *","varan mudhalAy avai * muzhudhu uNDa paraparan **","puram oru mUnRu eriththu * amararkkum aRivu iyandhu *","aran ayan ena * ulagu azhiththu amaiththu uLanE"],["சுரர் அறிவு அரு நிலை * விண் முதல் முழுவதும் *","வரன் முதலாய் அவை * முழுது உண்ட பரபரன் **","புரம் ஒரு மூன்று எரித்து * அமரர்க்கும் அறிவு இயந்து *","அரன் அயன் என * உலகு அழித்து அமைத்து உளனே"],0,"/media/recitation/TVM.1.1.8.mp3"],[2799,2799,["uLan enil uLan * avan uruvam ivvuruvugaL *","uLan alan enil * avan aruvam ivvaruvugaL **","uLan ena ilan ena * ivai guNam uDaimaiyil *","uLan iru thagaimaiyoDu * ozhivu ilan parandhE"],["உளன் எனில் உளன் * அவன் உருவம் இவ்வுருவுகள் *","உளன் அலன் எனில் * அவன் அருவம் இவ்வருவுகள் **","உளன் என இலன் என * இவை குணம் உடைமையில் *","உளன் இரு தகைமையொடு * ஒழிவு இலன் பரந்தே"],0,"/media/recitation/TVM.1.1.9.mp3"],[2800,2800,["parandha thaN paravaiyuL * nIr thoRum parandhuLan *","parandha aNDam idhena * nila visumbu ozhivaRa **","karandha sil iDam thoRum * iDam thigazh poruL thoRum *","karandhu enggum parandhuLan * ivai uNDa karanE"],["பரந்த தண் பரவையுள் * நீர் தொறும் பரந்துளன் *","பரந்த அண்டம் இதென * நில விசும்பு ஒழிவற **","கரந்த சில் இடம் தொறும் * இடம் திகழ் பொருள் தொறும் *","கரந்து எங்கும் பரந்துளன் * இவை உண்ட கரனே"],0,"/media/recitation/TVM.1.1.10.mp3"],[2801,2801,["** kara visumbu eri vaLi * nIr nilam ivai misai *","varanavil thiRal vali * aLi poRaiyAy ninRa **","paran aDi mEl * kurugUrch saDakOpan sol *","niraniRai Ayiraththu * ivai paththum vIDE"],["** கர விசும்பு எரி வளி * நீர் நிலம் இவை மிசை *","வரனவில் திறல் வலி * அளி பொறையாய் நின்ற **","பரன் அடி மேல் * குருகூர்ச் சடகோபன் சொல் *","நிரனிறை ஆயிரத்து * இவை பத்தும் வீடே"],0,"/media/recitation/TVM.1.1.11.mp3"]],[[2802,2802,["** vIDumin muRRavum *","vIDu seydhu ** um uyir","vIDu uDaiyAn iDai *","vIDu seymminE"],["** வீடுமின் முற்றவும் *","வீடு செய்து ** உம் உயிர்","வீடு உடையான் இடை *","வீடு செய்ம்மினே"],0,"/media/recitation/TVM.1.2.1.mp3"],[2803,2803,["minnin nilaiyila *","mannuyir AkkaigaL **","ennum iDaththu * iRai","unnumin nIrE"],["மின்னின் நிலையில *","மன்னுயிர் ஆக்கைகள் **","என்னும் இடத்து * இறை","உன்னுமின் நீரே"],0,"/media/recitation/TVM.1.2.2.mp3"],[2804,2804,["nIr numadhu enRivai *","vEr mudhal mAyththu ** iRai","sErmin uyirkku * adhan","nEr niRai illE"],["நீர் நுமது என்றிவை *","வேர் முதல் மாய்த்து ** இறை","சேர்மின் உயிர்க்கு * அதன்","நேர் நிறை இல்லே"],0,"/media/recitation/TVM.1.2.3.mp3"],[2805,2805,["illadhum uLLadhum *","alladhu avan uru **","ellaiyil annalam *","pulgu paRRu aRRE"],["இல்லதும் உள்ளதும் *","அல்லது அவன் உரு **","எல்லையில் அந்நலம் *","புல்கு பற்று அற்றே"],0,"/media/recitation/TVM.1.2.4.mp3"],[2806,2806,["aRRadhu paRRu enil *","uRRadhu vIDuyir **","seRRadhu mannuRil *","aRRiRai paRRE"],["அற்றது பற்று எனில் *","உற்றது வீடுயிர் **","செற்றது மன்னுறில் *","அற்றிறை பற்றே"],0,"/media/recitation/TVM.1.2.5.mp3"],[2807,2807,["paRRilan Isanum *","muRRavum ninRanan **","paRRilaiyAy * avan","muRRil aDanggE"],["பற்றிலன் ஈசனும் *","முற்றவும் நின்றனன் **","பற்றிலையாய் * அவன்","முற்றில் அடங்கே"],0,"/media/recitation/TVM.1.2.6.mp3"],[2808,2808,["aDanggezhil sampaththu *","aDanggak kaNDu ** Isan","aDanggezhil aqdhu enRu *","aDangguga uLLE"],["அடங்கெழில் சம்பத்து *","அடங்கக் கண்டு ** ஈசன்","அடங்கெழில் அஃது என்று *","அடங்குக உள்ளே"],0,"/media/recitation/TVM.1.2.7.mp3"],[2809,2809,["uLLam urai seyal *","uLLa immUnRaiyum **","uLLik keDuththu * iRai","uLLil oDunggE"],["உள்ளம் உரை செயல் *","உள்ள இம்மூன்றையும் **","உள்ளிக் கெடுத்து * இறை","உள்ளில் ஒடுங்கே"],0,"/media/recitation/TVM.1.2.8.mp3"],[2810,2810,["oDungga avaN kaN *","oDunggalum ellAm **","viDum pinnum Akkai *","viDum pozhudhu eNNE"],["ஒடுங்க அவண் கண் *","ஒடுங்கலும் எல்லாம் **","விடும் பின்னும் ஆக்கை *","விடும் பொழுது எண்ணே"],0,"/media/recitation/TVM.1.2.9.mp3"],[2811,2811,["** eN perukku annalaththu *","oN poruL IRila **","vaN pugazh nAraNan *","thiN kazhal sErE"],["** எண் பெருக்கு அந்நலத்து *","ஒண் பொருள் ஈறில **","வண் புகழ் நாரணன் *","திண் கழல் சேரே"],0,"/media/recitation/TVM.1.2.10.mp3"],[2812,2812,["** sErth thaDath * then kuru","gUrch saDakOpan sol **","sIrth thoDai Ayiraththu *","Orththa ippaththE"],["** சேர்த் தடத் * தென் குரு","கூர்ச் சடகோபன் சொல் **","சீர்த் தொடை ஆயிரத்து *","ஓர்த்த இப்பத்தே"],0,"/media/recitation/TVM.1.2.11.mp3"]],[[2813,2813,["** paththuDai aDiyavarkku eLiyavan * piRargaLukku ariya","viththagan * malarmagaL virumbum * nam arum peRal aDigaL **","maththuRu kaDai veNNey kaLavinil * uraviDai AppuNDu *","eththiRam! uralinODu * iNaindhu irundhu Enggiya eLivE"],["** பத்துடை அடியவர்க்கு எளியவன் * பிறர்களுக்கு அரிய","வித்தகன் * மலர்மகள் விரும்பும் * நம் அரும் பெறல் அடிகள் **","மத்துறு கடை வெண்ணெய் களவினில் * உரவிடை ஆப்புண்டு *","எத்திறம்! உரலினோடு * இணைந்து இருந்து ஏங்கிய எளிவே"],0,"/media/recitation/TVM.1.3.1.mp3"],[2814,2814,["eLivarum iyalvinan * nilai varambila pala piRappAy *","oLi varu muzhu nalam * mudhalila kEDila vIDAm **","theLi tharum nilaimai adhu * ozhivilan muzhuvadhum iRaiyOn *","aLi varum aruLinODu * agaththanan puRaththanan amaindhE"],["எளிவரும் இயல்வினன் * நிலை வரம்பில பல பிறப்பாய் *","ஒளி வரு முழு நலம் * முதலில கேடில வீடாம் **","தெளி தரும் நிலைமை அது * ஒழிவிலன் முழுவதும் இறையோன் *","அளி வரும் அருளினோடு * அகத்தனன் புறத்தனன் அமைந்தே"],0,"/media/recitation/TVM.1.3.2.mp3"],[2815,2815,["amaivuDai aRa neRi * muzhuvadhum uyarvaRa uyarndhu *","amaivuDai mudhal keDal * oDiviDai aRa nilam adhuvAm **","amaivuDai amararum * yAvaiyum yAvarum thAnAm *","amaivuDai nAraNan mAyaiyai * aRibavar yArE?"],["அமைவுடை அற நெறி * முழுவதும் உயர்வற உயர்ந்து *","அமைவுடை முதல் கெடல் * ஒடிவிடை அற நிலம் அதுவாம் **","அமைவுடை அமரரும் * யாவையும் யாவரும் தானாம் *","அமைவுடை நாரணன் மாயையை * அறிபவர் யாரே?"],0,"/media/recitation/TVM.1.3.3.mp3"],[2816,2816,["yArum Or nilaimaiyan ena * aRivariya emperumAn *","yArum Or nilaimaiyan ena * aRiveLiya emperumAn **","pErum Or Ayiram * piRa pala uDaiya emperumAn *","pErum Or uruvamum * uLadhillai iladhillai piNakkE"],["யாரும் ஓர் நிலைமையன் என * அறிவரிய எம்பெருமான் *","யாரும் ஓர் நிலைமையன் என * அறிவெளிய எம்பெருமான் **","பேரும் ஓர் ஆயிரம் * பிற பல உடைய எம்பெருமான் *","பேரும் ஓர் உருவமும் * உளதில்லை இலதில்லை பிணக்கே"],0,"/media/recitation/TVM.1.3.4.mp3"],[2817,2817,["piNakkaRa aRu vagaich samayamum * neRi uLLi uraiththa *","kaNakkaRu nalaththanan * andhamil Adhi ambagavan **","vaNakkuDaith thava neRi * vazhi ninRu puRa neRi kaLai kaTTu *","uNakkumin pasai aRa * avanuDai uNarvu koNDu uNarndhE"],["பிணக்கற அறு வகைச் சமயமும் * நெறி உள்ளி உரைத்த *","கணக்கறு நலத்தனன் * அந்தமில் ஆதி அம்பகவன் **","வணக்குடைத் தவ நெறி * வழி நின்று புற நெறி களை கட்டு *","உணக்குமின் பசை அற * அவனுடை உணர்வு கொண்டு உணர்ந்தே"],0,"/media/recitation/TVM.1.3.5.mp3"],[2818,2818,["uNarndhu uNarndhu izhindhu aganRu * uyarndhuru viyandha innilaimai *","uNarndhu uNarndhu uNarilum * iRai nilai uNarvu aridhu uyirgAL! **","uNarndhu uNarndhu uraiththu uraiththu * ari ayan aran ennum ivarai *","uNarndhu uNarndhu uraiththu uraiththu * iRainjchumin manappaTTadhonRE"],["உணர்ந்து உணர்ந்து இழிந்து அகன்று * உயர்ந்துரு வியந்த இந்நிலைமை *","உணர்ந்து உணர்ந்து உணரிலும் * இறை நிலை உணர்வு அரிது உயிர்காள்! **","உணர்ந்து உணர்ந்து உரைத்து உரைத்து * அரி அயன் அரன் என்னும் இவரை *","உணர்ந்து உணர்ந்து உரைத்து உரைத்து * இறைஞ்சுமின் மனப்பட்டதொன்றே"],0,"/media/recitation/TVM.1.3.6.mp3"],[2819,2819,["onRenap pala ena * aRivarum vaDivinuL ninRa *","nanRezhil nAraNan * nAnmugan aran ennum ivarai **","onRa num manaththu vaiththu * uLLi num iru pasai aRuththu *","nanRena nalam seyvadhu * avaniDai nammuDai nALE"],["ஒன்றெனப் பல என * அறிவரும் வடிவினுள் நின்ற *","நன்றெழில் நாரணன் * நான்முகன் அரன் என்னும் இவரை **","ஒன்ற நும் மனத்து வைத்து * உள்ளி நும் இரு பசை அறுத்து *","நன்றென நலம் செய்வது * அவனிடை நம்முடை நாளே"],0,"/media/recitation/TVM.1.3.7.mp3"],[2820,2820,["nALum ninRaDu nama pazhamai * anggoDu vinai uDanE","mALum * Or kuRaivu illai * manan aga malam aRak kazhuvi **","nALu nam thiruvuDai aDigaL tham * nalangkazhal vaNanggi *","mALum Or iDaththilum * vaNakkoDu mALvadhu valamE"],["நாளும் நின்றடு நம பழமை * அங்கொடு வினை உடனே","மாளும் * ஓர் குறைவு இல்லை * மனன் அக மலம் அறக் கழுவி **","நாளு நம் திருவுடை அடிகள் தம் * நலங்கழல் வணங்கி *","மாளும் ஓர் இடத்திலும் * வணக்கொடு மாள்வது வலமே"],0,"/media/recitation/TVM.1.3.8.mp3"],[2821,2821,["valaththanan thiripuram eriththavan * iDam peRaththundhith","thalaththu * ezhu thisai mugan paDaiththa * nal ulagamum thAnum","pulappaDa ** pinnum than ulagaththil * agaththanan thAnE","solap pugil * ivai pinnum vayiRRuLa * ivai avan thuyakkE"],["வலத்தனன் திரிபுரம் எரித்தவன் * இடம் பெறத்துந்தித்","தலத்து * எழு திசை முகன் படைத்த * நல் உலகமும் தானும்","புலப்பட ** பின்னும் தன் உலகத்தில் * அகத்தனன் தானே","சொலப் புகில் * இவை பின்னும் வயிற்றுள * இவை அவன் துயக்கே"],0,"/media/recitation/TVM.1.3.9.mp3"],[2822,2822,["thuyakkaRu madhiyil nal njAnaththuL * amararaith thuyakkum *","mayakkuDai mAyaigaL * vAnilum periyana vallan **","puyaRkaru niRaththanan * peru nilam kaDandha nal aDip pOdhu *","ayarppilan alaRRuvan * thazhuvuvan vaNangguvan amarndhE"],["துயக்கறு மதியில் நல் ஞானத்துள் * அமரரைத் துயக்கும் *","மயக்குடை மாயைகள் * வானிலும் பெரியன வல்லன் **","புயற்கரு நிறத்தனன் * பெரு நிலம் கடந்த நல் அடிப் போது *","அயர்ப்பிலன் அலற்றுவன் * தழுவுவன் வணங்குவன் அமர்ந்தே"],0,"/media/recitation/TVM.1.3.10.mp3"],[2823,2823,["** amarargaL thozhudhu ezha * alaikaDal kaDaindhavan thannai *","amar pozhil vaLangkurugUrch * saDakOpan kuRREvalgaL **","amar suvai Ayiraththu * avaRRinuL ivai paththum vallAr *","amararODu uyarvil senRu * aRuvar tham piRavi anjchiRaiyE"],["** அமரர்கள் தொழுது எழ * அலைகடல் கடைந்தவன் தன்னை *","அமர் பொழில் வளங்குருகூர்ச் * சடகோபன் குற்றேவல்கள் **","அமர் சுவை ஆயிரத்து * அவற்றினுள் இவை பத்தும் வல்லார் *","அமரரோடு உயர்வில் சென்று * அறுவர் தம் பிறவி அஞ்சிறையே"],0,"/media/recitation/TVM.1.3.11.mp3"]],[[2824,2824,["** anjchiRaiya maDa nArAy! * aLiyaththAy! * nIyum nin","anjchiRaiya sEvalumAy * AvA! enRu enakku aruLi **","venjchiRaip puL uyarththArkku * en viDu thUdhAych senRakkAl *","van chiRaiyil avan vaikkil * vaippuNDAl en seyyumO?"],["** அஞ்சிறைய மட நாராய்! * அளியத்தாய்! * நீயும் நின்","அஞ்சிறைய சேவலுமாய் * ஆவா! என்று எனக்கு அருளி **","வெஞ்சிறைப் புள் உயர்த்தார்க்கு * என் விடு தூதாய்ச் சென்றக்கால் *","வன் சிறையில் அவன் வைக்கில் * வைப்புண்டால் என் செய்யுமோ?"],0,"/media/recitation/TVM.1.4.1.mp3"],[2825,2825,["en seyya thAmaraik kaN * perumAnArkku en thUdhAy *","en seyyum uraiththakkAl? * inak kuyilgAL! nIr alirE? **","mun seydha muzhu vinaiyAl * thiruvaDik kIzhk kuRREval *","mun seyya muyalAdhEn * agalvadhuvO? vidhi inamE"],["என் செய்ய தாமரைக் கண் * பெருமானார்க்கு என் தூதாய் *","என் செய்யும் உரைத்தக்கால்? * இனக் குயில்காள்! நீர் அலிரே? **","முன் செய்த முழு வினையால் * திருவடிக் கீழ்க் குற்றேவல் *","முன் செய்ய முயலாதேன் * அகல்வதுவோ? விதி இனமே"],0,"/media/recitation/TVM.1.4.2.mp3"],[2826,2826,["vidhiyinAl peDai maNakkum * mennaDaiya annanggAL! *","madhiyinAl kuRaL mANAy * ulagu irandha kaLvarkku **","madhiyilEn valvinaiyE * mALAdhO? enRu * oruththi","madhi ellAm uL kalanggi * mayanggum Al ennIrE"],["விதியினால் பெடை மணக்கும் * மென்னடைய அன்னங்காள்! *","மதியினால் குறள் மாணாய் * உலகு இரந்த கள்வர்க்கு **","மதியிலேன் வல்வினையே * மாளாதோ? என்று * ஒருத்தி","மதி எல்லாம் உள் கலங்கி * மயங்கும் ஆல் என்னீரே"],0,"/media/recitation/TVM.1.4.3.mp3"],[2827,2827,["en nIrmai kaNDu iranggi * idhu thagAdhu ennAdha *","en nIla mugil vaNNaRku * en solli yAn sollugEnO? **","nannIrmai ini avarkaN * thanggAdhu enRoru vAychchol *","nannIla maganRilgAL! * nalgudhirO? nalgIrO?"],["என் நீர்மை கண்டு இரங்கி * இது தகாது என்னாத *","என் நீல முகில் வண்ணற்கு * என் சொல்லி யான் சொல்லுகேனோ? **","நன்னீர்மை இனி அவர்கண் * தங்காது என்றொரு வாய்ச்சொல் *","நன்னீல மகன்றில்காள்! * நல்குதிரோ? நல்கீரோ?"],0,"/media/recitation/TVM.1.4.4.mp3"],[2828,2828,["nalgith thAn kAththu aLikkum * pozhil Ezhum vinaiyERkE *","nalgath thAn AgAdhO? * nAraNanaik kaNDakkAl **","malgu nIrp punaRpaDappai * irai thEr vaN siRu kurugE!*","malgu nIr kaNNERku * Or vAsagam koNDu aruLAyE"],["நல்கித் தான் காத்து அளிக்கும் * பொழில் ஏழும் வினையேற்கே *","நல்கத் தான் ஆகாதோ? * நாரணனைக் கண்டக்கால் **","மல்கு நீர்ப் புனற்படப்பை * இரை தேர் வண் சிறு குருகே!*","மல்கு நீர் கண்ணேற்கு * ஓர் வாசகம் கொண்டு அருளாயே"],0,"/media/recitation/TVM.1.4.5.mp3"],[2829,2829,["aruLAdha nIr aruLi * avar Avi thuvarA mun *","aruL Azhip puL kaDavIr * avar vIdhi oru nAL enRu **","aruL Azhi ammAnaik * kaNDakkAl idhu solli *","aruL Azhi varivaNDE! * yAmum en pizhaiththOmE?"],["அருளாத நீர் அருளி * அவர் ஆவி துவரா முன் *","அருள் ஆழிப் புள் கடவீர் * அவர் வீதி ஒரு நாள் என்று **","அருள் ஆழி அம்மானைக் * கண்டக்கால் இது சொல்லி *","அருள் ஆழி வரிவண்டே! * யாமும் என் பிழைத்தோமே?"],0,"/media/recitation/TVM.1.4.6.mp3"],[2830,2830,["enbu izhai kOppadhu pOlap * pani vADai IrginRa *","en pizhaiyE ninaindhu aruLi * aruLAdha thirumAlArkku **","en pizhaiththAL thiruvaDiyin * thagavinukku enRoru vAychchol *","enbu izhaikkum iLangkiLiyE! * yAn vaLarththa nI alaiyE?"],["என்பு இழை கோப்பது போலப் * பனி வாடை ஈர்கின்ற *","என் பிழையே நினைந்து அருளி * அருளாத திருமாலார்க்கு **","என் பிழைத்தாள் திருவடியின் * தகவினுக்கு என்றொரு வாய்ச்சொல் *","என்பு இழைக்கும் இளங்கிளியே! * யான் வளர்த்த நீ அலையே?"],0,"/media/recitation/TVM.1.4.7.mp3"],[2831,2831,["nI alaiyE? siRu pUvAy! * neDumAlArkku en thUdhAy *","nOy enadhu nuval enna * nuvalAdhE irundhu ozhindhAy **","sAyaloDu maNi mAmai * thaLarndhEn nAn * ini unadhu","vAy alagil innaDisil * vaippArai nADAyE"],["நீ அலையே? சிறு பூவாய்! * நெடுமாலார்க்கு என் தூதாய் *","நோய் எனது நுவல் என்ன * நுவலாதே இருந்து ஒழிந்தாய் **","சாயலொடு மணி மாமை * தளர்ந்தேன் நான் * இனி உனது","வாய் அலகில் இன்னடிசில் * வைப்பாரை நாடாயே"],0,"/media/recitation/TVM.1.4.8.mp3"],[2832,2832,["nADAdha malar nADi * nAL thORum nAraNan than *","vADAdha malar aDik kIzh * vaikkavE vagukkinRu **","vIDADi vIRRiruththal * vinai aRRadhu en seyvadhO? *","UDADu pani vADAy! * uraiththu IrAy enadhuDalE"],["நாடாத மலர் நாடி * நாள் தோறும் நாரணன் தன் *","வாடாத மலர் அடிக் கீழ் * வைக்கவே வகுக்கின்று **","வீடாடி வீற்றிருத்தல் * வினை அற்றது என் செய்வதோ? *","ஊடாடு பனி வாடாய்! * உரைத்து ஈராய் எனதுடலே"],0,"/media/recitation/TVM.1.4.9.mp3"],[2833,2833,["uDal Azhip piRappu vIDu * uyir mudhalA muRRumAy *","kaDal Azhi nIr thORRi * adhan uLLE kaN vaLarum **","aDal Azhi ammAnaik * kaNDakkAl idhu solli *","viDal Azhi maDa nenjchE! * vinaiyOm onRAm aLavE"],["உடல் ஆழிப் பிறப்பு வீடு * உயிர் முதலா முற்றுமாய் *","கடல் ஆழி நீர் தோற்றி * அதன் உள்ளே கண் வளரும் **","அடல் ஆழி அம்மானைக் * கண்டக்கால் இது சொல்லி *","விடல் ஆழி மட நெஞ்சே! * வினையோம் ஒன்றாம் அளவே"],0,"/media/recitation/TVM.1.4.10.mp3"],[2834,2834,["** aLaviyanRa Ezh ulagaththavar * perumAn kaNNanai *","vaLa vayal sUzh vaNkurugUrch * saDakOpan vAyndhu uraiththa **","aLaviyanRa andhAdhi * AyiraththuL ippaththin *","vaLa uraiyAl peRal Agum * vAnOnggu peru vaLamE"],["** அளவியன்ற ஏழ் உலகத்தவர் * பெருமான் கண்ணனை *","வள வயல் சூழ் வண்குருகூர்ச் * சடகோபன் வாய்ந்து உரைத்த **","அளவியன்ற அந்தாதி * ஆயிரத்துள் இப்பத்தின் *","வள உரையால் பெறல் ஆகும் * வானோங்கு பெரு வளமே"],0,"/media/recitation/TVM.1.4.11.mp3"]],[[2835,2835,["** vaLavEzh ulagin mudhalAya * vAnOr iRaiyai * aruvinaiyEn","kaLavEzh veNNey thoDuvuNDa * kaLvA! enban pinnaiyum **","thaLavEzh muRuval pinnaikkAy * val AnAyar thalaivanAy *","iLavEREzhum thazhuviya * endhAy! enban ninaindhu naindhE"],["** வளவேழ் உலகின் முதலாய * வானோர் இறையை * அருவினையேன்","களவேழ் வெண்ணெய் தொடுவுண்ட * கள்வா! என்பன் பின்னையும் **","தளவேழ் முறுவல் பின்னைக்காய் * வல் ஆனாயர் தலைவனாய் *","இளவேறேழும் தழுவிய எந்தாய்! * என்பன் நினைந்து நைந்தே"],0,"/media/recitation/TVM.1.5.1.mp3"],[2836,2836,["ninaindhu naindhu uL karaindhu urugi * imaiyOr palarum munivarum *","punaindha kaNNi nIr sAndham * pugaiyODu Endhi vaNangginAl **","ninaindha ellAp poruLgaTkum * viththAy mudhalil sidhaiyAmE *","mananjchey njAnaththu un perumai * mAsUNAdhO? mAyOnE!"],["நினைந்து நைந்து உள் கரைந்து உருகி * இமையோர் பலரும் முனிவரும் *","புனைந்த கண்ணி நீர் சாந்தம் * புகையோடு ஏந்தி வணங்கினால் **","நினைந்த எல்லாப் பொருள்கட்கும் * வித்தாய் முதலில் சிதையாமே *","மனஞ்செய் ஞானத்து உன் பெருமை * மாசூணாதோ? மாயோனே!"],0,"/media/recitation/TVM.1.5.2.mp3"],[2837,2837,["mA yOnigaLAy naDai kaRRa * vAnOr palarum munivarum *","nI yOnigaLaip paDai enRu * niRai nAnmuganaip paDaiththavan **","sEyOn ellA aRivukkum * thisaigaL ellAm thiruvaDiyAl","thAyOn * ellA evvuyirkkum thAyOn * thAn Or uruvanE"],["மா யோனிகளாய் நடை கற்ற * வானோர் பலரும் முனிவரும் *","நீ யோனிகளைப் படை என்று * நிறை நான்முகனைப் படைத்தவன் **","சேயோன் எல்லா அறிவுக்கும் * திசைகள் எல்லாம் திருவடியால்","தாயோன் * எல்லா எவ்வுயிர்க்கும் தாயோன் * தான் ஓர் உருவனே"],0,"/media/recitation/TVM.1.5.3.mp3"],[2838,2838,["thAn Or uruvE thani viththAyth * thannil mUvar mudhalAya *","vAnOr palarum munivarum * maRRum maRRum muRRumAy **","thAn Or peru nIr thannuLLE thORRi * adhanuL kaN vaLarum *","vAnOr perumAn mAmAyan * vaikunthan emperumAnE"],["தான் ஓர் உருவே தனி வித்தாய்த் * தன்னில் மூவர் முதலாய *","வானோர் பலரும் முனிவரும் * மற்றும் மற்றும் முற்றுமாய் **","தான் ஓர் பெரு நீர் தன்னுள்ளே தோற்றி * அதனுள் கண் வளரும் *","வானோர் பெருமான் மாமாயன் * வைகுந்தன் எம்பெருமானே"],0,"/media/recitation/TVM.1.5.4.mp3"],[2839,2839,["mAn Ey nOkki maDavALai * mArvil koNDAy! mAdhavA! *","kUnE sidhaiya uNDai vil * niRaththil theRiththAy! gOvindhA! **","vAn Ar sOdhi maNivaNNA! * madhusUdhA! nI aruLAy * un","thEnE malarum thiruppAdham * sErum ARu vinaiyEnE"],["மான் ஏய் நோக்கி மடவாளை * மார்வில் கொண்டாய்! மாதவா! *","கூனே சிதைய உண்டை வில் * நிறத்தில் தெறித்தாய்! கோவிந்தா! **","வான் ஆர் சோதி மணிவண்ணா! * மதுசூதா! நீ அருளாய் * உன்","தேனே மலரும் திருப்பாதம் * சேரும் ஆறு வினையேனே"],0,"/media/recitation/TVM.1.5.5.mp3"],[2840,2840,["vinaiyEn vinai thIr marundhAnAy! * viNNOr thalaivA! kEsavA! *","manai sEr Ayar kula mudhalE! * mAmAyanE! mAdhavA! **","sinai Ey thazhaiya marAmaranggaL * Ezhum eydhAy! sirIdharA! *","inaiyAy! inaiya peyarinAy! * enRu naivan aDiyEnE"],["வினையேன் வினை தீர் மருந்தானாய்! * விண்ணோர் தலைவா! கேசவா! *","மனை சேர் ஆயர் குல முதலே! * மாமாயனே! மாதவா! **","சினை ஏய் தழைய மராமரங்கள் * ஏழும் எய்தாய்! சிரீதரா! *","இனையாய்! இனைய பெயரினாய்! * என்று நைவன் அடியேனே"],0,"/media/recitation/TVM.1.5.6.mp3"],[2841,2841,["aDiyEn siRiya njAnaththan * aRidhal Arkkum ariyAnai *","kaDi sEr thaNNanthuzhAyk * kaNNi punaindhAn thannaik kaNNanai **","seDiyAr Akkai aDiyAraich * sErdhal thIrkkum thirumAlai *","aDiyEn kANbAn alaRRuvan * idhanil mikkOr ayarvuNDE?"],["அடியேன் சிறிய ஞானத்தன் * அறிதல் ஆர்க்கும் அரியானை *","கடி சேர் தண்ணந்துழாய்க் * கண்ணி புனைந்தான் தன்னைக் கண்ணனை **","செடியார் ஆக்கை அடியாரைச் * சேர்தல் தீர்க்கும் திருமாலை *","அடியேன் காண்பான் அலற்றுவன் * இதனில் மிக்கோர் அயர்வுண்டே?"],0,"/media/recitation/TVM.1.5.7.mp3"],[2842,2842,["uNDAy ulagEzh munnamE * umizhndhu mAyaiyAl pukku *","uNDAy veNNey siRu manisar * uvalai yAkkai nilai eydhi **","maN thAn sOrndhadhu uNDElum * manisarkkAgum pIr * siRidhum","aNDA vaNNam maN karaiya * ney UN marundhO? mAyOnE!"],["உண்டாய் உலகேழ் முன்னமே * உமிழ்ந்து மாயையால் புக்கு *","உண்டாய் வெண்ணெய் சிறு மனிசர் * உவலை யாக்கை நிலை எய்தி **","மண் தான் சோர்ந்தது உண்டேலும் * மனிசர்க்காகும் பீர் * சிறிதும்","அண்டா வண்ணம் மண் கரைய * நெய் ஊண் மருந்தோ? மாயோனே!"],0,"/media/recitation/TVM.1.5.8.mp3"],[2843,2843,["mAyOm thIya alavalaip * peru mA vanjchap pEy vIya *","thUya kuzhaviyAy viDap pAl amudhA * amudhu seydhiTTa","mAyan ** vAnOr thanith thalaivan malarAL maindhan * evvuyirkkum","thAyOn * thammAn en ammAn * am mA mUrththiyaich sArndhE"],["மாயோம் தீய அலவலைப் * பெரு மா வஞ்சப் பேய் வீய *","தூய குழவியாய் விடப் பால் அமுதா * அமுது செய்திட்ட","மாயன் ** வானோர் தனித் தலைவன் மலராள் மைந்தன் * எவ்வுயிர்க்கும்","தாயோன் * தம்மான் என் அம்மான் * அம் மா மூர்த்தியைச் சார்ந்தே"],0,"/media/recitation/TVM.1.5.9.mp3"],[2844,2844,["sArndha iru val vinaigaLum sariththu * mAyap paRRu aRuththu *","thIrndhu than pAl manam vaikkath thiruththi * vIDu thiruththuvAn **","Arndha njAnach suDar Agi * agalam kIzh mEl aLavu iRandhu *","nErndha uruvAy aruvAgum * ivaRRin uyirAm neDumAlE!"],["சார்ந்த இரு வல் வினைகளும் சரித்து * மாயப் பற்று அறுத்து *","தீர்ந்து தன் பால் மனம் வைக்கத் திருத்தி * வீடு திருத்துவான் **","ஆர்ந்த ஞானச் சுடர் ஆகி * அகலம் கீழ் மேல் அளவு இறந்து *","நேர்ந்த உருவாய் அருவாகும் * இவற்றின் உயிராம் நெடுமாலே!"],0,"/media/recitation/TVM.1.5.10.mp3"],[2845,2845,["** mAlE! mAyap perumAnE! * mAmAyanE! enRenRu *","mAlE ERi mAl aruLAl * mannu kurugUrch saDakOpan **","pAlEy thamizhar isaikArar * paththar paravum Ayiraththin *","pAlE paTTa ivai paththum * vallArkku illai parivadhE"],["** மாலே! மாயப் பெருமானே! * மாமாயனே! என்றென்று *","மாலே ஏறி மால் அருளால் * மன்னு குருகூர்ச் சடகோபன் **","பாலேய் தமிழர் இசைகாரர் * பத்தர் பரவும் ஆயிரத்தின் *","பாலே பட்ட இவை பத்தும் * வல்லார்க்கு இல்லை பரிவதே"],0,"/media/recitation/TVM.1.5.11.mp3"]],[[2846,2846,["** parivadhil Isanaip pADi *","virivadhu mEval uRuvIr! **","piri vagai inRi nannIr thUy *","purivadhuvum pugai pUvE"],["** பரிவதில் ஈசனைப் பாடி *","விரிவது மேவல் உறுவீர்! **","பிரி வகை இன்றி நன்னீர் தூய் *","புரிவதுவும் புகை பூவே"],0,"/media/recitation/TVM.1.6.1.mp3"],[2847,2847,["madhu vAr thaNNanthuzhAyAn *","mudhu vEdha mudhalvanukku **","edhu Edhu? en paNi? ennAdhu *","adhuvE ATseyyum IDE"],["மது வார் தண்ணந்துழாயான் *","முது வேத முதல்வனுக்கு **","எது ஏது? என் பணி? என்னாது *","அதுவே ஆட்செய்யும் ஈடே"],0,"/media/recitation/TVM.1.6.2.mp3"],[2848,2848,["IDum eDuppum il Isan *","mADu viDAdhu en mananE **","pADum en nA avan pADal *","ADum en anggam aNanggE"],["ஈடும் எடுப்பும் இல் ஈசன் *","மாடு விடாது என் மனனே **","பாடும் என் நா அவன் பாடல் *","ஆடும் என் அங்கம் அணங்கே"],0,"/media/recitation/TVM.1.6.3.mp3"],[2849,2849,["aNanggu ena ADum en anggam *","vaNanggi vazhipaDum Isan **","piNanggi amarar pidhaRRum *","guNangkezhu koLgaiyinAnE"],["அணங்கு என ஆடும் என் அங்கம் *","வணங்கி வழிபடும் ஈசன் **","பிணங்கி அமரர் பிதற்றும் *","குணங்கெழு கொள்கையினானே"],0,"/media/recitation/TVM.1.6.4.mp3"],[2850,2850,["koLgai koLAmai ilAdhAn *","eLgal irAgam ilAdhAn **","viLgai viLLAmai virumbi *","uL kalandhArkku Or amudhE"],["கொள்கை கொளாமை இலாதான் *","எள்கல் இராகம் இலாதான் **","விள்கை விள்ளாமை விரும்பி *","உள் கலந்தார்க்கு ஓர் அமுதே"],0,"/media/recitation/TVM.1.6.5.mp3"],[2851,2851,["amudham amarargaTku Indha *","nimir suDar Azhi neDumAl **","amudhilum ARRa iniyan *","nimir thirai nIL kaDalAnE"],["அமுதம் அமரர்கட்கு ஈந்த *","நிமிர் சுடர் ஆழி நெடுமால் **","அமுதிலும் ஆற்ற இனியன் *","நிமிர் திரை நீள் கடலானே"],0,"/media/recitation/TVM.1.6.6.mp3"],[2852,2852,["nIL kaDal sUzh ilanggaik kOn *","thOLgaL thalai thuNi seydhAn **","thALgaL thalaiyil vaNanggi *","nAL kaDalaik kazhiminE"],["நீள் கடல் சூழ் இலங்கைக் கோன் *","தோள்கள் தலை துணி செய்தான் **","தாள்கள் தலையில் வணங்கி *","நாள் கடலைக் கழிமினே"],0,"/media/recitation/TVM.1.6.7.mp3"],[2853,2853,["kazhimin thoNDIrgaL! kazhiththu *","thozhumin avanaith thozhudhAl **","vazhi ninRa valvinai mALviththu *","azhivinRi Akkam tharumE"],["கழிமின் தொண்டீர்கள்! கழித்து *","தொழுமின் அவனைத் தொழுதால் **","வழி நின்ற வல்வினை மாள்வித்து *","அழிவின்றி ஆக்கம் தருமே"],0,"/media/recitation/TVM.1.6.8.mp3"],[2854,2854,["tharuma arum payanAya *","thirumagaLAr thanik kELvan **","perumai uDaiya pirAnAr *","irumai vinai kaDivArE"],["தரும அரும் பயனாய *","திருமகளார் தனிக் கேள்வன் **","பெருமை உடைய பிரானார் *","இருமை வினை கடிவாரே"],0,"/media/recitation/TVM.1.6.9.mp3"],[2855,2855,["kaDivAr thIya vinaigaL *","noDi Arum aLavaik kaN **","koDiyA aDu puL uyarththa *","vaDivAr mAdhavanArE"],["கடிவார் தீய வினைகள் *","நொடி ஆரும் அளவைக் கண் **","கொடியா அடு புள் உயர்த்த *","வடிவார் மாதவனாரே"],0,"/media/recitation/TVM.1.6.10.mp3"],[2856,2856,["** mAdhavan pAl saDakOpan *","thIdhu avam inRi uraiththa **","Edham il Ayiraththu ippaththu *","Odha vallAr piRavArE"],["** மாதவன் பால் சடகோபன் *","தீது அவம் இன்றி உரைத்த **","ஏதம் இல் ஆயிரத்து இப்பத்து *","ஓத வல்லார் பிறவாரே"],0,"/media/recitation/TVM.1.6.11.mp3"]],[[2857,2857,["** piRavith thuyar aRa * njAnaththuL ninRu *","thuRavich suDar viLakkam * thalaippeyvAr **","aRavanai * Azhip paDai andhaNanai *","maRaviyai inRi * manaththu vaippArE"],["** பிறவித் துயர் அற * ஞானத்துள் நின்று *","துறவிச் சுடர் விளக்கம் * தலைப்பெய்வார் **","அறவனை * ஆழிப் படை அந்தணனை *","மறவியை இன்றி * மனத்து வைப்பாரே"],0,"/media/recitation/TVM.1.7.1.mp3"],[2858,2858,["vaippAm marundhAm * aDiyarai * valvinaith","thuppAm pulan aindhum * thunjchak koDAn avan **","eppAl yavarkkum * nalaththAl uyarndhu uyarndhu *","appAlavan * enggaL Ayar kozhundhE"],["வைப்பாம் மருந்தாம் * அடியரை * வல்வினைத்","துப்பாம் புலன் ஐந்தும் * துஞ்சக் கொடான் அவன் **","எப்பால் யவர்க்கும் * நலத்தால் உயர்ந்து உயர்ந்து *","அப்பாலவன் * எங்கள் ஆயர் கொழுந்தே"],0,"/media/recitation/TVM.1.7.2.mp3"],[2859,2859,["Ayar kozhundhAy * avarAl puDai uNNum *","mAyap pirAnai * en mANikkach sOdhiyai **","thUya amudhaip * parugip parugi * en","mAyap piRavi * mayarvu aRuththEnE"],["ஆயர் கொழுந்தாய் * அவரால் புடை உண்ணும் *","மாயப் பிரானை * என் மாணிக்கச் சோதியை **","தூய அமுதைப் * பருகிப் பருகி * என்","மாயப் பிறவி * மயர்வு அறுத்தேனே"],0,"/media/recitation/TVM.1.7.3.mp3"],[2860,2860,["mayarvu aRa en manaththE * manninAn thannai *","uyar vinaiyE tharum * oNsuDark kaRRaiyai **","ayarvil amarargaL * Adhik kozhundhai * en","isaivinai * en solli yAn viDuvEnO?"],["மயர்வு அற என் மனத்தே * மன்னினான் தன்னை *","உயர் வினையே தரும் * ஒண்சுடர்க் கற்றையை **","அயர்வில் அமரர்கள் * ஆதிக் கொழுந்தை * என்","இசைவினை * என் சொல்லி யான் விடுவேனோ?"],0,"/media/recitation/TVM.1.7.4.mp3"],[2861,2861,["viDuvEnO? en viLakkai * en Aviyai *","naDuvE vandhu * uyyak koLginRa nAdhanai **","thoDuvE seydhu * iLavAychchiyar kaNNinuL *","viDavE seydhu * vizhikkum pirAnaiyE"],["விடுவேனோ? என் விளக்கை * என் ஆவியை *","நடுவே வந்து * உய்யக் கொள்கின்ற நாதனை **","தொடுவே செய்து * இளவாய்ச்சியர் கண்ணினுள் *","விடவே செய்து * விழிக்கும் பிரானையே"],0,"/media/recitation/TVM.1.7.5.mp3"],[2862,2862,["pirAn * peru nilam kINDavan * pinnum","virAy malarth thuzhAy * vEyndha muDiyan **","marAmaram * eydha mAyavan * ennuL","irAn enil * pinnai yAn oTTuvEnO?"],["பிரான் * பெரு நிலம் கீண்டவன் * பின்னும்","விராய் மலர்த் துழாய் * வேய்ந்த முடியன் **","மராமரம் * எய்த மாயவன் * என்னுள்","இரான் எனில் * பின்னை யான் ஒட்டுவேனோ?"],0,"/media/recitation/TVM.1.7.6.mp3"],[2863,2863,["yAn oTTi ennuL * iruththuvam enRilan *","thAn oTTi vandhu * en thani nenjchai vanjchiththu **","Un oTTi ninRu * en uyiril kalandhu * iyal","vAn oTTumO? * ini ennai negizhkkavE"],["யான் ஒட்டி என்னுள் * இருத்துவம் என்றிலன் *","தான் ஒட்டி வந்து * என் தனி நெஞ்சை வஞ்சித்து **","ஊன் ஒட்டி நின்று * என் உயிரில் கலந்து * இயல்","வான் ஒட்டுமோ? * இனி என்னை நெகிழ்க்கவே"],0,"/media/recitation/TVM.1.7.7.mp3"],[2864,2864,["ennai negizhkkilum * ennuDai nal nenjcham","thannai * agalvikkath * thAnum killAn ini **","pinnai neDum paNaith thOL * magizh pIDuDai *","munnai amarar * muzhumudhalAnE"],["என்னை நெகிழ்க்கிலும் * என்னுடை நல் நெஞ்சம்","தன்னை * அகல்விக்கத் * தானும் கில்லான் இனி **","பின்னை நெடும் பணைத் தோள் * மகிழ் பீடுடை *","முன்னை அமரர் * முழுமுதலானே"],0,"/media/recitation/TVM.1.7.8.mp3"],[2865,2865,["amarar muzhu mudhal * Agiya Adhiyai *","amararkku amudhu Indha * Ayar kozhundhai **","amara azhumbath * thuzhAvi en Avi *","amarath thazhuviRRu * ini agalumO?"],["அமரர் முழு முதல் * ஆகிய ஆதியை *","அமரர்க்கு அமுது ஈந்த * ஆயர் கொழுந்தை **","அமர அழும்பத் * துழாவி என் ஆவி *","அமரத் தழுவிற்று * இனி அகலுமோ?"],0,"/media/recitation/TVM.1.7.9.mp3"],[2866,2866,["agalil agalum * aNugil aNugum *","pugalum ariyan * poruvallan emmAn **","nigarilavan pugazh * pADi iLaippilam *","pagalum iravum * paDindhu kuDaindhE"],["அகலில் அகலும் * அணுகில் அணுகும் *","புகலும் அரியன் * பொருவல்லன் எம்மான் **","நிகரிலவன் புகழ் * பாடி இளைப்பிலம் *","பகலும் இரவும் * படிந்து குடைந்தே"],0,"/media/recitation/TVM.1.7.10.mp3"],[2867,2867,["** kuDaindhu vaNDuNNum * thuzhAy muDiyAnai *","aDaindha thenkurugUrch * saDakOpan **","miDaindha sol thoDai * Ayiraththu ippaththu *","uDaindhu nOygaLai * ODuvikkumE"],["** குடைந்து வண்டுண்ணும் * துழாய் முடியானை *","அடைந்த தென்குருகூர்ச் * சடகோபன் **","மிடைந்த சொல் தொடை * ஆயிரத்து இப்பத்து *","உடைந்து நோய்களை * ஓடுவிக்குமே"],0,"/media/recitation/TVM.1.7.11.mp3"]],[[2868,2868,["** ODum puL ERi *","sUDum thaNthuzhAy **","nIDu ninRu avai *","ADum ammAnE"],["** ஓடும் புள் ஏறி *","சூடும் தண்துழாய் **","நீடு நின்று அவை *","ஆடும் அம்மானே"],0,"/media/recitation/TVM.1.8.1.mp3"],[2869,2869,["ammAnAyp pinnum *","emmANbum AnAn **","vem mA vAy kINDa *","sem mA kaNNanE"],["அம்மானாய்ப் பின்னும் *","எம்மாண்பும் ஆனான் **","வெம் மா வாய் கீண்ட *","செம் மா கண்ணனே"],0,"/media/recitation/TVM.1.8.2.mp3"],[2870,2870,["kaN AvAn enRum *","maNNOr viNNOrkku **","thaNNAr vEngkaDa *","viNNOr veRpanE"],["கண் ஆவான் என்றும் *","மண்ணோர் விண்ணோர்க்கு **","தண்ணார் வேங்கட *","விண்ணோர் வெற்பனே"],0,"/media/recitation/TVM.1.8.3.mp3"],[2871,2871,["veRpai onRu eDuththu *","oRkam inRiyE **","niRkum ammAn sIr *","kaRpan vaigalE"],["வெற்பை ஒன்று எடுத்து *","ஒற்கம் இன்றியே **","நிற்கும் அம்மான் சீர் *","கற்பன் வைகலே"],0,"/media/recitation/TVM.1.8.4.mp3"],[2872,2872,["vaigalum veNNey *","kai kalandhu uNDAn **","poy kalavAdhu * en","mey kalandhAnE"],["வைகலும் வெண்ணெய் *","கை கலந்து உண்டான் **","பொய் கலவாது * என்","மெய் கலந்தானே"],0,"/media/recitation/TVM.1.8.5.mp3"],[2873,2873,["kalandhu en Avi *","nalangkoL nAdhan **","pulan koL mANAy *","nilam koNDAnE"],["கலந்து என் ஆவி *","நலங்கொள் நாதன் **","புலன் கொள் மாணாய் *","நிலம் கொண்டானே"],0,"/media/recitation/TVM.1.8.6.mp3"],[2874,2874,["koNDAn Ezh viDai *","uNDAn Ezh vaiyam **","thaN thAmam seydhu * en","eN thAn AnAnE"],["கொண்டான் ஏழ் விடை *","உண்டான் ஏழ் வையம் **","தண் தாமம் செய்து * என்","எண் தான் ஆனானே"],0,"/media/recitation/TVM.1.8.7.mp3"],[2875,2875,["AnAn An Ayan *","mInODu Enamum **","thAn AnAn ennil *","thAn Aya sanggE"],["ஆனான் ஆன் ஆயன் *","மீனோடு ஏனமும் **","தான் ஆனான் என்னில் *","தான் ஆய சங்கே"],0,"/media/recitation/TVM.1.8.8.mp3"],[2876,2876,["sanggu chakkaram *","angkaiyil koNDAn **","enggum thAnAya *","nanggaL nAdhanE"],["சங்கு சக்கரம் *","அங்கையில் கொண்டான் **","எங்கும் தானாய *","நங்கள் நாதனே"],0,"/media/recitation/TVM.1.8.9.mp3"],[2877,2877,["nAdhan njAlam koL *","pAdhan en ammAn *","Odham pOl kiLar *","vEdha nIranE"],["நாதன் ஞாலம் கொள் *","பாதன் என் அம்மான் *","ஓதம் போல் கிளர் *","வேத நீரனே"],0,"/media/recitation/TVM.1.8.10.mp3"],[2878,2878,["** nIr purai vaNNan *","sIr saDakOpan **","nErdhal Ayiraththu *","Ordhal ivaiyE"],["** நீர் புரை வண்ணன் *","சீர் சடகோபன் **","நேர்தல் ஆயிரத்து *","ஓர்தல் இவையே"],0,"/media/recitation/TVM.1.8.11.mp3"]],[[2879,2879,["** ivaiyum avaiyum uvaiyum * ivarum avarum uvarum *","evaiyum yavarum thannuLLE * Agiyum Akkiyum kAkkum **","avaiyuL thani mudhal emmAn * kaNNapirAn en amudham *","suvaiyan thiruvin maNALan * ennuDaich sUzhal uLAnE"],["** இவையும் அவையும் உவையும் * இவரும் அவரும் உவரும் *","எவையும் யவரும் தன்னுள்ளே * ஆகியும் ஆக்கியும் காக்கும் **","அவையுள் தனி முதல் எம்மான் * கண்ணபிரான் என் அமுதம் *","சுவையன் திருவின் மணாளன் * என்னுடைச் சூழல் உளானே"],0,"/media/recitation/TVM.1.9.1.mp3"],[2880,2880,["sUzhal pala pala vallAn * thollaiyam kAlaththu ulagai *","kEzhal onRAgi iDandha * kEsavan ennuDai ammAn **","vEzha maruppai osiththAn * viNNavarkku eNNal ariyAn *","Azha neDungkaDal sErndhAn * avan en arugalilAnE"],["சூழல் பல பல வல்லான் * தொல்லையம் காலத்து உலகை *","கேழல் ஒன்றாகி இடந்த * கேசவன் என்னுடை அம்மான் **","வேழ மருப்பை ஒசித்தான் * விண்ணவர்க்கு எண்ணல் அரியான் *","ஆழ நெடுங்கடல் சேர்ந்தான் * அவன் என் அருகலிலானே"],0,"/media/recitation/TVM.1.9.2.mp3"],[2881,2881,["arugal ilAya perunjchIr * amarargaL Adhi mudhalvan *","karugiya nIla nanmEni vaNNan * senthAmaraik kaNNan **","poru siRaip puL uvandhu ERum * pUmagaLAr thanik kELvan *","oru kadhiyin suvai thandhiTTu * ozhivilan ennODu uDanE"],["அருகல் இலாய பெருஞ்சீர் * அமரர்கள் ஆதி முதல்வன் *","கருகிய நீல நன்மேனி வண்ணன் * செந்தாமரைக் கண்ணன் **","பொரு சிறைப் புள் உவந்து ஏறும் * பூமகளார் தனிக் கேள்வன் *","ஒரு கதியின் சுவை தந்திட்டு * ஒழிவிலன் என்னோடு உடனே"],0,"/media/recitation/TVM.1.9.3.mp3"],[2882,2882,["uDan amar kAdhal magaLir * thirumagaL maNmagaL Ayar","maDamagaL * enRivar mUvar ALum * ulagamum mUnRE **","uDan avai okka vizhunggi * Alilaich sErndhavan emmAn *","kaDal mali mAyap perumAn * kaNNan en okkalaiyAnE"],["உடன் அமர் காதல் மகளிர் * திருமகள் மண்மகள் ஆயர்","மடமகள் * என்றிவர் மூவர் ஆளும் * உலகமும் மூன்றே **","உடன் அவை ஒக்க விழுங்கி * ஆலிலைச் சேர்ந்தவன் எம்மான் *","கடல் மலி மாயப் பெருமான் * கண்ணன் என் ஒக்கலையானே"],0,"/media/recitation/TVM.1.9.4.mp3"],[2883,2883,["okkalai vaiththu mulaip pAl uNNenRu * thandhiDa vAnggi *","sekkam sega anRu avaL pAl * uyir sega uNDa perumAn **","nakka pirAnODu * ayanum indhiranum mudhalAga *","okkavum thORRiya Isan * mAyan en nenjchin uLAnE"],["ஒக்கலை வைத்து முலைப் பால் உண்ணென்று * தந்திட வாங்கி *","செக்கம் செக அன்று அவள் பால் * உயிர் செக உண்ட பெருமான் **","நக்க பிரானோடு * அயனும் இந்திரனும் முதலாக *","ஒக்கவும் தோற்றிய ஈசன் * மாயன் என் நெஞ்சின் உளானே"],0,"/media/recitation/TVM.1.9.5.mp3"],[2884,2884,["mAyan en nenjchin uLLan * maRRum yavarkkum aqdhE *","kAyamum sIvanum thAnE * kAlum eriyum avanE **","sEyan aNiyan yavarkkum * sindhaikkum gOcharam allan *","thUyan thuyakkan mayakkan * ennuDaith thOLiNaiyAnE"],["மாயன் என் நெஞ்சின் உள்ளன் * மற்றும் யவர்க்கும் அஃதே *","காயமும் சீவனும் தானே * காலும் எரியும் அவனே **","சேயன் அணியன் யவர்க்கும் * சிந்தைக்கும் கோசரம் அல்லன் *","தூயன் துயக்கன் மயக்கன் * என்னுடைத் தோளிணையானே"],0,"/media/recitation/TVM.1.9.6.mp3"],[2885,2885,["thOLiNai mElum nanmArbin mElum * suDar muDi mElum *","thALiNai mElum punaindha * thaNNanthuzhAy uDai ammAn **","kEL iNai onRum ilAdhAn * kiLarum suDar oLi mUrththi *","nAL aNaindhu onRum agalAn * ennuDai nAvin uLAnE"],["தோளிணை மேலும் நன்மார்பின் மேலும் * சுடர் முடி மேலும் *","தாளிணை மேலும் புனைந்த * தண்ணந்துழாய் உடை அம்மான் **","கேள் இணை ஒன்றும் இலாதான் * கிளரும் சுடர் ஒளி மூர்த்தி *","நாள் அணைந்து ஒன்றும் அகலான் * என்னுடை நாவின் உளானே"],0,"/media/recitation/TVM.1.9.7.mp3"],[2886,2886,["nAvinuL ninRu malarum * njAnak kalaigaLukku ellAm *","Aviyum Akkaiyum thAnE * azhippODu aLippavan thAnE **","pUviyal nAl thaDanthOLan * poru paDai Azhi sanggu Endhum *","kAvi nanmEni kamalak kaNNan * en kaNNin uLAnE"],["நாவினுள் நின்று மலரும் * ஞானக் கலைகளுக்கு எல்லாம் *","ஆவியும் ஆக்கையும் தானே * அழிப்போடு அளிப்பவன் தானே **","பூவியல் நால் தடந்தோளன் * பொரு படை ஆழி சங்கு ஏந்தும் *","காவி நன்மேனி கமலக் கண்ணன் * என் கண்ணின் உளானே"],0,"/media/recitation/TVM.1.9.8.mp3"],[2887,2887,["kamalak kaNNan en kaNNin uLLAn * kANban avan kaNgaLAlE *","amalanggaL Aga vizhikkum * aimpulanum avan mUrththi **","kamalaththu ayan nambi thannaik * kaN nudhalAnoDum thORRi *","amalath dheyvaththODu ulagam Akki * en neRRi uLAnE"],["கமலக் கண்ணன் என் கண்ணின் உள்ளான் * காண்பன் அவன் கண்களாலே *","அமலங்கள் ஆக விழிக்கும் * ஐம்புலனும் அவன் மூர்த்தி **","கமலத்து அயன் நம்பி தன்னைக் * கண் நுதலானொடும் தோற்றி *","அமலத் தெய்வத்தோடு உலகம் ஆக்கி * என் நெற்றி உளானே"],0,"/media/recitation/TVM.1.9.9.mp3"],[2888,2888,["neRRiyuL ninRu ennai ALum * nirai malarp pAdhanggaL sUDi *","kaRRaith thuzhAy muDik kOlak * kaNNapirAnaith thozhuvAr **","oRRaip piRai aNindhAnum * nAnmuganum indhiranum *","maRRai amararum ellAm vandhu * enadhu uchchi uLAnE"],["நெற்றியுள் நின்று என்னை ஆளும் * நிரை மலர்ப் பாதங்கள் சூடி *","கற்றைத் துழாய் முடிக் கோலக் * கண்ணபிரானைத் தொழுவார் **","ஒற்றைப் பிறை அணிந்தானும் * நான்முகனும் இந்திரனும் *","மற்றை அமரரும் எல்லாம் வந்து * எனது உச்சி உளானே"],0,"/media/recitation/TVM.1.9.10.mp3"],[2889,2889,["** uchchi uLLE niRkum dhEva dhEvaRkuk * kaNNapirARku *","ichchai uL sella uNarththi * vaNkurugUrch saDakOpan **","ichchonna AyiraththuL * ivaiyum Or paththu empirARku *","nichchalum viNNappam seyya * nIL kazhal senni porumE"],["** உச்சி உள்ளே நிற்கும் தேவ தேவற்குக் * கண்ணபிராற்கு *","இச்சை உள் செல்ல உணர்த்தி * வண்குருகூர்ச் சடகோபன் **","இச்சொன்ன ஆயிரத்துள் * இவையும் ஓர் பத்து எம்பிராற்கு *","நிச்சலும் விண்ணப்பம் செய்ய * நீள் கழல் சென்னி பொருமே"],0,"/media/recitation/TVM.1.9.11.mp3"]],[[2890,2890,["** poru mA nIL paDai * Azhi sanggaththoDu *","thiru mA nIL kazhal * Ezh ulagum thozha **","oru mANik kuRaL Agi nimirndha * ak","karu mANikkam * en kaN uLadhAgumE"],["** பொரு மா நீள் படை * ஆழி சங்கத்தொடு *","திரு மா நீள் கழல் * ஏழ் உலகும் தொழ **","ஒரு மாணிக் குறள் ஆகி நிமிர்ந்த * அக்","கரு மாணிக்கம் * என் கண் உளதாகுமே"],0,"/media/recitation/TVM.1.10.1.mp3"],[2891,2891,["kaNNuLLE niRkum * kAdhanmaiyAl thozhil *","eNNilum varum * en ini vENDuvam? **","maNNum nIrum * eriyum nal vAyuvum *","viNNumAy viriyum * empirAnaiyE"],["கண்ணுள்ளே நிற்கும் * காதன்மையால் தொழில் *","எண்ணிலும் வரும் * என் இனி வேண்டுவம்? **","மண்ணும் நீரும் * எரியும் நல் வாயுவும் *","விண்ணுமாய் விரியும் * எம்பிரானையே"],0,"/media/recitation/TVM.1.10.2.mp3"],[2892,2892,["empirAnai * endhai thandhai thandhaikkum","tham pirAnai * thaNthAmaraik kaNNanai **","kombarAvu * nuNNEr iDai mArvanai *","empirAnaith thozhAy * maDa nenjchamE!"],["எம்பிரானை * எந்தை தந்தை தந்தைக்கும்","தம் பிரானை * தண்தாமரைக் கண்ணனை **","கொம்பராவு * நுண்ணேர் இடை மார்வனை *","எம்பிரானைத் தொழாய் * மட நெஞ்சமே!"],0,"/media/recitation/TVM.1.10.3.mp3"],[2893,2893,["nenjchamE nallai nallai * unnaip peRRAl","en seyyOm? * ini enna kuRaivinam? **","maindhanai * malarAL maNavALanai *","thunjchum pOdhum * viDAdhu thoDar kaNDAy"],["நெஞ்சமே நல்லை நல்லை * உன்னைப் பெற்றால்","என் செய்யோம்? * இனி என்ன குறைவினம்? **","மைந்தனை * மலராள் மணவாளனை *","துஞ்சும் போதும் * விடாது தொடர் கண்டாய்"],0,"/media/recitation/TVM.1.10.4.mp3"],[2894,2894,["kaNDAyE nenjchE! * karumanggaL vAykkinRu * Or","eN thAnum inRiyE * vandhu iyalum ARu **","uNDAnai * ulagEzhum Or mUvaDi","koNDAnai * kaNDu koNDanai nIyumE"],["கண்டாயே நெஞ்சே! * கருமங்கள் வாய்க்கின்று * ஓர்","எண் தானும் இன்றியே * வந்து இயலும் ஆறு **","உண்டானை * உலகேழும் ஓர் மூவடி","கொண்டானை * கண்டு கொண்டனை நீயுமே"],0,"/media/recitation/TVM.1.10.5.mp3"],[2895,2895,["nIyum nAnum * innEr niRkil * mEl maRROr","nOyum sAr koDAn * nenjchamE! sonnEn **","thAyum thandhaiyumAy * ivvulaginil *","vAyum Isan * maNivaNNan endhaiyE"],["நீயும் நானும் * இந்நேர் நிற்கில் * மேல் மற்றோர்","நோயும் சார் கொடான் * நெஞ்சமே! சொன்னேன் **","தாயும் தந்தையுமாய் * இவ்வுலகினில் *","வாயும் ஈசன் * மணிவண்ணன் எந்தையே"],0,"/media/recitation/TVM.1.10.6.mp3"],[2896,2896,["endhaiyE enRum * emperumAn enRum *","sindhaiyuL vaippan * solluvan pAviyEn **","endhai! emperumAn! enRu * vAnavar","sindhaiyuL vaiththuch * sollum selvanaiyE"],["எந்தையே என்றும் * எம்பெருமான் என்றும் *","சிந்தையுள் வைப்பன் * சொல்லுவன் பாவியேன் **","எந்தை! எம்பெருமான்! என்று * வானவர்","சிந்தையுள் வைத்துச் * சொல்லும் செல்வனையே"],0,"/media/recitation/TVM.1.10.7.mp3"],[2897,2897,["selva nAraNan * enRa sol kETTalum *","malgum kaN pani * nADuvan mAyamE **","allum nanpagalum * iDaivIDu inRi *","nalgi ennai viDAn * nambi nambiyE"],["செல்வ நாரணன் * என்ற சொல் கேட்டலும் *","மல்கும் கண் பனி * நாடுவன் மாயமே **","அல்லும் நன்பகலும் * இடைவீடு இன்றி *","நல்கி என்னை விடான் * நம்பி நம்பியே"],0,"/media/recitation/TVM.1.10.8.mp3"],[2898,2898,["** nambiyaith thenkuRungkuDi ninRa * ach","chemponE thigazhum * thirumUrththiyai **","umbar vAnavar * Adhi anjchOdhiyai *","empirAnai * en solli maRappanO?"],["** நம்பியைத் தென்குறுங்குடி நின்ற * அச்","செம்பொனே திகழும் * திருமூர்த்தியை **","உம்பர் வானவர் * ஆதி அஞ்சோதியை *","எம்பிரானை * என் சொல்லி மறப்பனோ?"],0,"/media/recitation/TVM.1.10.9.mp3"],[2899,2899,["maRappum njAnamum * nAn onRu uNarndhilan *","maRakkum enRu * senthAmaraik kaNNoDu **","maRappaRa en uLLE * manninAn thannai *","maRappanO? ini * yAn en maNiyaiyE"],["மறப்பும் ஞானமும் * நான் ஒன்று உணர்ந்திலன் *","மறக்கும் என்று * செந்தாமரைக் கண்ணொடு **","மறப்பற என் உள்ளே * மன்னினான் தன்னை *","மறப்பனோ? இனி * யான் என் மணியையே"],0,"/media/recitation/TVM.1.10.10.mp3"],[2900,2900,["** maNiyai vAnavar kaNNanaith * thannadhOr","aNiyai * thenkurugUrch saDakOpan ** sol","paNi sey AyiraththuL * ivai paththuDan *","thaNivilar kaRparEl * kalvi vAyumE"],["** மணியை வானவர் கண்ணனைத் * தன்னதோர்","அணியை * தென்குருகூர்ச் சடகோபன் ** சொல்","பணி செய் ஆயிரத்துள் * இவை பத்துடன் *","தணிவிலர் கற்பரேல் * கல்வி வாயுமே"],0,"/media/recitation/TVM.1.10.11.mp3"]]]