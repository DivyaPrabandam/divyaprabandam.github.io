[[[3013,3013,["** muDich chOdhiyAy * unadhu mugach chOdhi malarndhadhuvO? *","aDich chOdhi nI ninRa * thAmaraiyAy alarndhadhuvO? **","paDich chOdhi ADaiyoDum * pal kalanAy * nin paimpon","kaDich chOdhi kalandhadhuvO? * thirumAlE! kaTTuraiyE"],["** முடிச் சோதியாய் * உனது முகச் சோதி மலர்ந்ததுவோ? *","அடிச் சோதி நீ நின்ற * தாமரையாய் அலர்ந்ததுவோ? **","படிச் சோதி ஆடையொடும் * பல் கலனாய் * நின் பைம்பொன்","கடிச் சோதி கலந்ததுவோ? * திருமாலே! கட்டுரையே"],0,"/media/recitation/TVM.3.1.1.mp3"],[3014,3014,["kaTTuraikkil thAmarai * nin kaN pAdham kai ovvA *","suTTuraiththa nanpon * un thirumEni oLi ovvAdhu **","oTTuraiththu ivvulagu unnaip * pugazhvellAm perumpAlum *","paTTuraiyAyp puRkenRE * kATTumAl paranjchOdhI!"],["கட்டுரைக்கில் தாமரை * நின் கண் பாதம் கை ஒவ்வா *","சுட்டுரைத்த நன்பொன் * உன் திருமேனி ஒளி ஒவ்வாது **","ஒட்டுரைத்து இவ்வுலகு உன்னைப் * புகழ்வெல்லாம் பெரும்பாலும் *","பட்டுரையாய்ப் புற்கென்றே * காட்டுமால் பரஞ்சோதீ!"],0,"/media/recitation/TVM.3.1.2.mp3"],[3015,3015,["paranjchOdhi! nI paramAy * nin igazhndhu pin maRROr *","paranjchOdhi inmaiyin * paDi Ovi nigazhginRa **","paranjchOdhi ninnuLLE * paDar ulagam paDaiththa * em","paranjchOdhi! gOvindhA! * paNburaikka mATTEnE"],["பரஞ்சோதி! நீ பரமாய் * நின் இகழ்ந்து பின் மற்றோர் *","பரஞ்சோதி இன்மையின் * படி ஓவி நிகழ்கின்ற **","பரஞ்சோதி நின்னுள்ளே * படர் உலகம் படைத்த * எம்","பரஞ்சோதி! கோவிந்தா! * பண்புரைக்க மாட்டேனே"],0,"/media/recitation/TVM.3.1.3.mp3"],[3016,3016,["mATTAdhE Agilum * immalar thalai mA njAlam * nin","mATTAya malar puraiyum * thiru uruvam manam vaikka **","mATTAdha pala samaya * madhi koDuththAy malarth thuzhAy *","mATTE nI manam vaiththAy * mA njAlam varundhAdhE?"],["மாட்டாதே ஆகிலும் * இம்மலர் தலை மா ஞாலம் * நின்","மாட்டாய மலர் புரையும் * திரு உருவம் மனம் வைக்க **","மாட்டாத பல சமய * மதி கொடுத்தாய் மலர்த் துழாய் *","மாட்டே நீ மனம் வைத்தாய் * மா ஞாலம் வருந்தாதே?"],0,"/media/recitation/TVM.3.1.4.mp3"],[3017,3017,["varundhAdha arunthavaththa * malar kadhirin suDar uDambAy *","varundhAdha njAnamAy * varambinRi muzhudhu iyanRAy! **","varungkAlam nigazh kAlam * kazhi kAlamAy ulagai *","orunggAga aLippAy! sIr * enggu ulakka OdhuvanE?"],["வருந்தாத அருந்தவத்த * மலர் கதிரின் சுடர் உடம்பாய் *","வருந்தாத ஞானமாய் * வரம்பின்றி முழுது இயன்றாய்! **","வருங்காலம் நிகழ் காலம் * கழி காலமாய் உலகை *","ஒருங்காக அளிப்பாய்! சீர் * எங்கு உலக்க ஓதுவனே?"],0,"/media/recitation/TVM.3.1.5.mp3"],[3018,3018,["OdhuvAr OththellAm * evvulagaththu evvevaiyum *","sAdhuvAy nin pugazhin * thagai allAl piRidhu illai **","pOdhu vAzh punanthuzhAy * muDiyinAy! pUvin mEl *","mAdhu vAzh mArbinAy! * en solli yAn vAzhththuvanE?"],["ஓதுவார் ஓத்தெல்லாம் * எவ்வுலகத்து எவ்வெவையும் *","சாதுவாய் நின் புகழின் * தகை அல்லால் பிறிது இல்லை **","போது வாழ் புனந்துழாய் * முடியினாய்! பூவின் மேல் *","மாது வாழ் மார்பினாய்! * என் சொல்லி யான் வாழ்த்துவனே?"],0,"/media/recitation/TVM.3.1.6.mp3"],[3019,3019,["vAzhththuvAr palar Aga * ninnuLLE nAnmuganai *","mUzhththa nIr ulagellAm * paDai enRu mudhal paDaiththAy! **","kEzhththa sIr aran mudhalAk * kiLar dheyvamAyk kiLarndhu *","sUzhththu amarar thudhiththAl * un thol pugazh mAsUNAdhE?"],["வாழ்த்துவார் பலர் ஆக * நின்னுள்ளே நான்முகனை *","மூழ்த்த நீர் உலகெல்லாம் * படை என்று முதல் படைத்தாய்! **","கேழ்த்த சீர் அரன் முதலாக் * கிளர் தெய்வமாய்க் கிளர்ந்து *","சூழ்த்து அமரர் துதித்தால் * உன் தொல் புகழ் மாசூணாதே?"],0,"/media/recitation/TVM.3.1.7.mp3"],[3020,3020,["mAsUNAch suDar uDambAy * malarAdhu kuviyAdhu *","mAsUNA njAnamAy * muzhudhumAy muzhudhu iyanRAy! **","mAsUNA vAn kOlaththu * amarar kOn vazhippaTTAl *","mAsUNA una pAdha * malarch chOdhi mazhunggAdhE?"],["மாசூணாச் சுடர் உடம்பாய் * மலராது குவியாது *","மாசூணா ஞானமாய் * முழுதுமாய் முழுது இயன்றாய்! **","மாசூணா வான் கோலத்து * அமரர் கோன் வழிப்பட்டால் *","மாசூணா உன பாத * மலர்ச் சோதி மழுங்காதே?"],0,"/media/recitation/TVM.3.1.8.mp3"],[3021,3021,["mazhunggAdha vainnudhiya * chakkara nal valaththaiyAy *","thozhungkAdhal kaLiRu aLippAn * puL Urndhu thOnRinaiyE **","mazhunggAdha njAnamE * paDaiyAga malar ulagil *","thozhumbu AyArkku aLiththAl * un suDarch chOdhi maRaiyAdhE?"],["மழுங்காத வைந்நுதிய * சக்கர நல் வலத்தையாய் *","தொழுங்காதல் களிறு அளிப்பான் * புள் ஊர்ந்து தோன்றினையே **","மழுங்காத ஞானமே * படையாக மலர் உலகில் *","தொழும்பு ஆயார்க்கு அளித்தால் * உன் சுடர்ச் சோதி மறையாதே?"],0,"/media/recitation/TVM.3.1.9.mp3"],[3022,3022,["maRai Aya nAl vEdhaththuL ninRa * malarch chuDarE! *","muRaiyAl ivvulagellAm * paDaiththu iDandhu uNDu umizhndhu aLandhAy! **","piRai ERu saDaiyAnum * nAnmuganum indhiranum *","iRai Adhal aRindhu Eththa * vIRRiruththal idhu viyappE?"],["மறை ஆய நால் வேதத்துள் நின்ற * மலர்ச் சுடரே! *","முறையால் இவ்வுலகெல்லாம் * படைத்து இடந்து உண்டு உமிழ்ந்து அளந்தாய்! **","பிறை ஏறு சடையானும் * நான்முகனும் இந்திரனும் *","இறை ஆதல் அறிந்து ஏத்த * வீற்றிருத்தல் இது வியப்பே?"],0,"/media/recitation/TVM.3.1.10.mp3"],[3023,3023,["** viyappAya viyappu illA * meynjnjAna vEdhiyanai *","sayap pugazhAr palar vAzhum * thaDangkurugUr saDakOpan **","thuyakku inRith thozhudhu uraiththa * AyiraththuL ippaththum *","uyak koNDu piRappu aRukkum * oli munnIr njAlaththE"],["** வியப்பாய வியப்பில்லா * மெய்ஞ்ஞான வேதியனை *","சயப் புகழார் பலர் வாழும் * தடங்குருகூர் சடகோபன் **","துயக்கு இன்றித் தொழுது உரைத்த * ஆயிரத்துள் இப்பத்தும் *","உயக் கொண்டு பிறப்பு அறுக்கும் * ஒலி முந்நீர் ஞாலத்தே"],0,"/media/recitation/TVM.3.1.11.mp3"]],[[3024,3024,["** munnIr njAlam paDaiththa * em mugil vaNNanE! *","annAL nI thandha * Akkaiyin vazhi uzhalvEn **","vennAL nOy vIya * vinaigaLai vEr aRap pAyndhu *","ennAL yAn unnai * ini vandhu kUDuvanE?"],["** முந்நீர் ஞாலம் படைத்த * எம் முகில் வண்ணனே! *","அந்நாள் நீ தந்த * ஆக்கையின் வழி உழல்வேன் **","வெந்நாள் நோய் வீய * வினைகளை வேர் அறப் பாய்ந்து *","எந்நாள் யான் உன்னை * இனி வந்து கூடுவனே?"],0,"/media/recitation/TVM.3.2.1.mp3"],[3025,3025,["van mA vaiyam aLandha * em vAmanA! * nin","panmA mAyap * pal piRaviyil paDiginRa yAn **","thonmA valvinaith * thoDargaLai mudhal arindhu *","nin mA thAL sErndhu * niRpadhu enjnjAnRu kolO?"],["வன் மா வையம் அளந்த * எம் வாமனா! * நின்","பன்மா மாயப் * பல் பிறவியில் படிகின்ற யான் **","தொன்மா வல்வினைத் * தொடர்களை முதல் அரிந்து *","நின் மா தாள் சேர்ந்து * நிற்பது எஞ்ஞான்று கொலோ?"],0,"/media/recitation/TVM.3.2.2.mp3"],[3026,3026,["kollA mAk kOl * kolai seydhu bArathap pOr *","ellAch sEnaiyum * iru nilaththu aviththa endhAy! **","pollA Akkaiyin * puNarvinai aRukkal aRA *","sollAy yAn unnaich * sArvadhOr sUzhchchiyE"],["கொல்லா மாக் கோல் * கொலை செய்து பாரதப் போர் *","எல்லாச் சேனையும் * இரு நிலத்து அவித்த எந்தாய்! **","பொல்லா ஆக்கையின் * புணர்வினை அறுக்கல் அறா *","சொல்லாய் யான் உன்னைச் * சார்வதோர் சூழ்ச்சியே"],0,"/media/recitation/TVM.3.2.3.mp3"],[3027,3027,["sUzhchchi njAnach * suDar oLi Agi * enRum","Ezhchchik kEDu inRi * engngaNum niRaindha endhAy! **","thAzhchchi maRRu enggum thavirndhu * nin thALiNak kIzh","vAzhchchi * yAn sErum vagai * aruLAy vandhE"],["சூழ்ச்சி ஞானச் * சுடர் ஒளி ஆகி * என்றும்","ஏழ்ச்சிக் கேடு இன்றி * என்ங்ஙணும் நிறைந்த எந்தாய்! **","தாழ்ச்சி மற்று எங்கும் தவிர்ந்து * நின் தாளிணக் கீழ்","வாழ்ச்சி * யான் சேரும் வகை * அருளாய் வந்தே"],0,"/media/recitation/TVM.3.2.4.mp3"],[3028,3028,["vandhAy pOlE * vandhum en manaththinai nI *","sindhAmal seyyAy * idhuvE idhu Agil **","kondhAr kAyAvin * kozhu malarth thiru niRaththa","endhAy! * yAn unnai * enggu vandhu aNukiRpanE?"],["வந்தாய் போலே * வந்தும் என் மனத்தினை நீ *","சிந்தாமல் செய்யாய் * இதுவே இது ஆகில் **","கொந்தார் காயாவின் * கொழு மலர்த் திரு நிறத்த","எந்தாய்! * யான் உன்னை * எங்கு வந்து அணுகிற்பனே?"],0,"/media/recitation/TVM.3.2.5.mp3"],[3029,3029,["kiRpan killEn * enRilan muna nALAl *","aRpa sAranggaL * avai suvaiththu aganRu ozhindhEn **","paRpallAyiram * uyir seydha paramA! * nin","naRpon sOdhith thAL * naNuguvadhu enjnjAnRE?"],["கிற்பன் கில்லேன் * என்றிலன் முன நாளால் *","அற்ப சாரங்கள் * அவை சுவைத்து அகன்று ஒழிந்தேன் **","பற்பல்லாயிரம் * உயிர் செய்த பரமா! * நின்","நற்பொன் சோதித் தாள் * நணுகுவது எஞ்ஞான்றே?"],0,"/media/recitation/TVM.3.2.6.mp3"],[3030,3030,["enjnjAnRu nAm irundhu irundhu * iranggi nenjchE! *","mey njAnam inRi * vinai iyal piRappu azhundhi **","enjnjAnRum enggum * ozhivaRa niRaindhu ninRa *","mey njAnach sOdhik * kaNNanai mEvudhumE"],["எஞ்ஞான்று நாம் இருந்து இருந்து * இரங்கி நெஞ்சே! *","மெய் ஞானம் இன்றி * வினை இயல் பிறப்பு அழுந்தி **","எஞ்ஞான்றும் எங்கும் * ஒழிவற நிறைந்து நின்ற *","மெய் ஞானச் சோதிக் * கண்ணனை மேவுதுமே"],0,"/media/recitation/TVM.3.2.7.mp3"],[3031,3031,["mEvu thunba vinaigaLai * viDuththum ilEn *","Ovudhal inRi * un kazhal vaNanggiRRilEn **","pAvu thol sIrk kaNNA! * en paranjchuDarE! *","kUvuginREn kANbAn * enggu eydhak kUvuvanE?"],["மேவு துன்ப வினைகளை * விடுத்தும் இலேன் *","ஓவுதல் இன்றி * உன் கழல் வணங்கிற்றிலேன் **","பாவு தொல் சீர்க் கண்ணா! * என் பரஞ்சுடரே! *","கூவுகின்றேன் காண்பான் * எங்கு எய்தக் கூவுவனே?"],0,"/media/recitation/TVM.3.2.8.mp3"],[3032,3032,["kUvik kUvik * koDu vinaith thURRuL ninRu *","pAviyEn pala kAlam * vazhi thigaiththu alamaruginREn **","mEvi anRu Anirai kAththavan * ulagam ellAm *","thAviya ammAnai * enggu inith thalaippeyvanE?"],["கூவிக் கூவிக் * கொடு வினைத் தூற்றுள் நின்று *","பாவியேன் பல காலம் * வழி திகைத்து அலமருகின்றேன் **","மேவி அன்று ஆநிரை காத்தவன் * உலகம் எல்லாம் *","தாவிய அம்மானை * எங்கு இனித் தலைப்பெய்வனே?"],0,"/media/recitation/TVM.3.2.9.mp3"],[3033,3033,["thalaippey kAlam * naman thamar pAsam viTTAl *","alaippUN uNNum * avvallal ellAm agala **","kalaip pal njAnaththu * en kaNNanaik kaNDu koNDu *","nilaip peRRu en nenjcham peRRadhu * nIDuyirE"],["தலைப்பெய் காலம் * நமன் தமர் பாசம் விட்டால் *","அலைப்பூண் உண்ணும் * அவ்வல்லல் எல்லாம் அகல **","கலைப் பல் ஞானத்து * என் கண்ணனைக் கண்டு கொண்டு *","நிலைப் பெற்று என் நெஞ்சம் பெற்றது * நீடுயிரே"],0,"/media/recitation/TVM.3.2.10.mp3"],[3034,3034,["** uyirgaL ellA * ulagamum uDaiyavanai *","kuyil koL sOlaith * thenkurugUrch saDakOpan **","seyiril sol isai mAlai * AyiraththuL ippaththum *","uyirin mEl Akkai * UniDai ozhivikkumE"],["** உயிர்கள் எல்லா * உலகமும் உடையவனை *","குயில் கொள் சோலைத் * தென்குருகூர்ச் சடகோபன் **","செயிரில் சொல் இசை மாலை * ஆயிரத்துள் இப்பத்தும் *","உயிரின் மேல் ஆக்கை * ஊனிடை ஒழிவிக்குமே"],0,"/media/recitation/TVM.3.2.11.mp3"]],[[3035,3035,["** ozhivil kAlam ellAm * uDanAy manni *","vazhu ilA * aDimai seyya vENDum nAm **","thezhi kural aruvith * thiruvEngkaDaththu *","ezhil koL sOthi * endhai thandhai thandhaikkE"],["** ஒழிவில் காலம் எல்லாம் * உடனாய் மன்னி *","வழு இலா * அடிமை செய்ய வேண்டும் நாம் **","தெழி குரல் அருவித் * திருவேங்கடத்து *","எழில் கொள் சோதி * எந்தை தந்தை தந்தைக்கே"],0,"/media/recitation/TVM.3.3.1.mp3"],[3036,3036,["endhai thandhai thandhai * thandhai thandhaikkum","mundhai * vAnavar * vAnavar kOnoDum **","sindhu pU magizhum * thiruvEngkaDaththu *","andham il pugazhk * kAr ezhil aNNalE"],["எந்தை தந்தை தந்தை * தந்தை தந்தைக்கும்","முந்தை * வானவர் * வானவர் கோனொடும் **","சிந்து பூ மகிழும் * திருவேங்கடத்து *","அந்தம் இல் புகழ்க் * கார் எழில் அண்ணலே"],0,"/media/recitation/TVM.3.3.2.mp3"],[3037,3037,["aNNal mAyan * aNi koL senthAmaraik","kaNNan * sengkani vAyk * karu mANikkam **","theNNiRaich sunai nIrth * thiruvEngkaDaththu *","eN il thol pugazh * vAnavar IsanE"],["அண்ணல் மாயன் * அணி கொள் செந்தாமரைக்","கண்ணன் * செங்கனி வாய்க் * கரு மாணிக்கம் **","தெண்ணிறைச் சுனை நீர்த் * திருவேங்கடத்து *","எண் இல் தொல் புகழ் * வானவர் ஈசனே"],0,"/media/recitation/TVM.3.3.3.mp3"],[3038,3038,["Isan vAnavarkku enban * enRAl * adhu","thEsamO * thiruvEngkaDaththAnukku **","nIsanEn * niRai onRum ilEn * en kaN","pAsam vaiththa * paranjchuDarch sOdhikkE"],["ஈசன் வானவர்க்கு என்பன் * என்றால் * அது","தேசமோ * திருவேங்கடத்தானுக்கு **","நீசனேன் * நிறை ஒன்றும் இலேன் * என் கண்","பாசம் வைத்த * பரஞ்சுடர்ச் சோதிக்கே"],0,"/media/recitation/TVM.3.3.4.mp3"],[3039,3039,["sOdhi Agi * ellA ulagum thozhum *","Adhi mUrththi enRAl * aLavAgumO? **","vEdhiyar * muzhu vEdhaththu amudhaththai *","thIdhil sIrth * thiruvEngkaDaththAnaiyE"],["சோதி ஆகி * எல்லா உலகும் தொழும் *","ஆதி மூர்த்தி என்றால் * அளவாகுமோ? **","வேதியர் * முழு வேதத்து அமுதத்தை *","தீதில் சீர்த் * திருவேங்கடத்தானையே"],0,"/media/recitation/TVM.3.3.5.mp3"],[3040,3040,["vEm kaDanggaL * mey mEl vinai muRRavum *","thAnggaL thanggaTku * nallanavE seyvAr **","vEngkaDaththu uRaivArkku * nama ennal","Am kaDamai * adhu sumandhArgaTkE"],["வேம் கடங்கள் * மெய் மேல் வினை முற்றவும் *","தாங்கள் தங்கட்கு * நல்லனவே செய்வார் **","வேங்கடத்து உறைவார்க்கு * நம என்னல்","ஆம் கடமை * அது சுமந்தார்கட்கே"],0,"/media/recitation/TVM.3.3.6.mp3"],[3041,3041,["sumandhu mA malar * nIr suDar dhUpam koNDu *","amarndhu vAnavar * vAnavar kOnoDum **","namanRu ezhum * thiruvEngkaDam nanggaTku *","saman koL vIDu tharum * thaDam kunRamE"],["சுமந்து மா மலர் * நீர் சுடர் தூபம் கொண்டு *","அமர்ந்து வானவர் * வானவர் கோனொடும் **","நமன்று எழும் * திருவேங்கடம் நங்கட்கு *","சமன் கொள் வீடு தரும் * தடம் குன்றமே"],0,"/media/recitation/TVM.3.3.7.mp3"],[3042,3042,["** kunRam Endhik * kuLir mazhai kAththavan *","anRu njAlam * aLandha pirAn ** paran","senRu sEr * thiruvEngkaDa mA malai *","onRumE thozha * nam vinai OyumE"],["** குன்றம் ஏந்திக் * குளிர் மழை காத்தவன் *","அன்று ஞாலம் * அளந்த பிரான் ** பரன்","சென்று சேர் * திருவேங்கட மா மலை *","ஒன்றுமே தொழ * நம் வினை ஓயுமே"],0,"/media/recitation/TVM.3.3.8.mp3"],[3043,3043,["Oyu mUppup * piRappu iRappup piNi *","vIyumARu seyvAn * thiruvEngkaDaththu","Ayan ** nAL malarAm * aDith thAmarai *","vAy uLLum manaththu uLLum * vaippArgaTkE"],["ஓயு மூப்புப் * பிறப்பு இறப்புப் பிணி *","வீயுமாறு செய்வான் * திருவேங்கடத்து","ஆயன் ** நாள் மலராம் * அடித் தாமரை *","வாய் உள்ளும் மனத்து உள்ளும் * வைப்பார்கட்கே"],0,"/media/recitation/TVM.3.3.9.mp3"],[3044,3044,["vaiththa nAL varai * ellai kuRugich senRu *","eyththu iLaippadhan * munnam aDaiminO **","paiththa pAmbaNaiyAn * thiruvEngkaDam *","moyththa sOlai * moy pUnthaDam thAzhvarE"],["வைத்த நாள் வரை * எல்லை குறுகிச் சென்று *","எய்த்து இளைப்பதன் * முன்னம் அடைமினோ **","பைத்த பாம்பணையான் * திருவேங்கடம் *","மொய்த்த சோலை * மொய் பூந்தடம் தாழ்வரே"],0,"/media/recitation/TVM.3.3.10.mp3"],[3045,3045,["** thAL parappi * maN thAviya Isanai *","nIL pozhil * kurugUrch saDakOpan sol **","kEzh il Ayiraththu * ippaththum vallavar *","vAzhvar vAzhvu eydhi * njAlam pugazhavE"],["** தாள் பரப்பி * மண் தாவிய ஈசனை *","நீள் பொழில் * குருகூர்ச் சடகோபன் சொல் **","கேழ் இல் ஆயிரத்து * இப்பத்தும் வல்லவர் *","வாழ்வர் வாழ்வு எய்தி * ஞாலம் புகழவே"],0,"/media/recitation/TVM.3.3.11.mp3"]],[[3046,3046,["** pugazhu nal oruvan engO? * poruvil sIrp bUmi engO? *","thigazhum thaNparavai engO? * thI engO? vAyu engO? **","nigazhum AkAsam engO? * nIL suDar iraNDum engO? *","igazhvil ivvanaiththum engO? * kaNNanaik kUvum ARE"],["** புகழு நல் ஒருவன் என்கோ? * பொருவில் சீர்ப் பூமி என்கோ? *","திகழும் தண்பரவை என்கோ? * தீ என்கோ? வாயு என்கோ? **","நிகழும் ஆகாசம் என்கோ? * நீள் சுடர் இரண்டும் என்கோ? *","இகழ்வில் இவ்வனைத்தும் என்கோ? * கண்ணனைக் கூவும் ஆறே"],0,"/media/recitation/TVM.3.4.1.mp3"],[3047,3047,["kUvum ARu aRiya mATTEn * kunRanggaL anaiththum engO? *","mEvu sIr mAri engO? * viLanggu thAragaigaL engO? **","nA iyal kalaigaL engO? * njAna nal Avi engO? *","pAvu sIrk kaNNan emmAn * panggayak kaNNanaiyE"],["கூவும் ஆறு அறிய மாட்டேன் * குன்றங்கள் அனைத்தும் என்கோ? *","மேவு சீர் மாரி என்கோ? * விளங்கு தாரகைகள் என்கோ? **","நா இயல் கலைகள் என்கோ? * ஞான நல் ஆவி என்கோ? *","பாவு சீர்க் கண்ணன் எம்மான் * பங்கயக் கண்ணனையே"],0,"/media/recitation/TVM.3.4.2.mp3"],[3048,3048,["panggayak kaNNan engO? * pavaLach sevvAyan engO? *","angkadhir aDiyan engO? * anjchana vaNNan engO? **","sengkadhir muDiyan engO? * thiru maRu mArvan engO? *","sanggu chakkaraththan engO? * sAdhi mANikkaththaiyE"],["பங்கயக் கண்ணன் என்கோ? * பவளச் செவ்வாயன் என்கோ? *","அங்கதிர் அடியன் என்கோ? * அஞ்சன வண்ணன் என்கோ? **","செங்கதிர் முடியன் என்கோ? * திரு மறு மார்வன் என்கோ? *","சங்கு சக்கரத்தன் என்கோ? * சாதி மாணிக்கத்தையே"],0,"/media/recitation/TVM.3.4.3.mp3"],[3049,3049,["sAdhi mANikkam engO? * savi koL pon muththam engO? *","sAdhi nal vayiram engO? * thavivil sIr viLakkam engO? **","Adhi anjchOdhi engO? * Adhi ampuruDan engO? *","Adhum il kAlaththu endhai * achchudhan amalanaiyE"],["சாதி மாணிக்கம் என்கோ? * சவி கொள் பொன் முத்தம் என்கோ? *","சாதி நல் வயிரம் என்கோ? * தவிவில் சீர் விளக்கம் என்கோ? **","ஆதி அஞ்சோதி என்கோ? * ஆதி அம்புருடன் என்கோ? *","ஆதும் இல் காலத்து எந்தை * அச்சுதன் அமலனையே"],0,"/media/recitation/TVM.3.4.4.mp3"],[3050,3050,["achchudhan amalan engO? * aDiyavar vinai keDukkum *","nachchu mA marundham engO? * nalangkaDal amudham engO? **","achchuvaik kaTTi engO? * aRu suvai aDisil engO? *","neych chuvaith thERal engO? * kani engO? pAl engEnO?"],["அச்சுதன் அமலன் என்கோ? * அடியவர் வினை கெடுக்கும் *","நச்சு மா மருந்தம் என்கோ? * நலங்கடல் அமுதம் என்கோ? **","அச்சுவைக் கட்டி என்கோ? * அறு சுவை அடிசில் என்கோ? *","நெய்ச் சுவைத் தேறல் என்கோ? * கனி என்கோ? பால் என்கேனோ?"],0,"/media/recitation/TVM.3.4.5.mp3"],[3051,3051,["pAl engO? * nAnku vEdhap payan engO? * samaya nIdhi","nUl engO? * nuDanggu kELvi isai engO? ** ivaRRuL nalla","mEl engO? * vinaiyin mikka payan engO? * kaNNan engO?","mAl engO? mAyan engO? * vAnavar AdhiyaiyE"],["பால் என்கோ? * நான்கு வேதப் பயன் என்கோ? * சமய நீதி","நூல் என்கோ? * நுடங்கு கேள்வி இசை என்கோ? ** இவற்றுள் நல்ல","மேல் என்கோ? * வினையின் மிக்க பயன் என்கோ? * கண்ணன் என்கோ?","மால் என்கோ? மாயன் என்கோ? * வானவர் ஆதியையே"],0,"/media/recitation/TVM.3.4.6.mp3"],[3052,3052,["vAnavar Adhi engO? * vAnavar dheyvam engO? *","vAnavar bOgam engO? * vAnavar muRRum engO? **","Unam il selvam engO? * Unam il suvarkkam engO? *","Unam il mOkkam engO? * oLi maNi vaNNanaiyE"],["வானவர் ஆதி என்கோ? * வானவர் தெய்வம் என்கோ? *","வானவர் போகம் என்கோ? * வானவர் முற்றும் என்கோ? **","ஊனம் இல் செல்வம் என்கோ? * ஊனம் இல் சுவர்க்கம் என்கோ? *","ஊனம் இல் மோக்கம் என்கோ? * ஒளி மணி வண்ணனையே"],0,"/media/recitation/TVM.3.4.7.mp3"],[3053,3053,["oLi maNi vaNNan engO? * oruvan enRu Eththa ninRa *","naLir madhich saDaiyan engO? * nAnmugak kaDavuL engO? **","aLi magizhndhu ulagam ellAm * paDaiththu avai Eththa ninRa *","kaLi malarth thuLavan emmAn * kaNNanai mAyanaiyE"],["ஒளி மணி வண்ணன் என்கோ? * ஒருவன் என்று ஏத்த நின்ற *","நளிர் மதிச் சடையன் என்கோ? * நான்முகக் கடவுள் என்கோ? **","அளி மகிழ்ந்து உலகம் எல்லாம் * படைத்து அவை ஏத்த நின்ற *","களி மலர்த் துளவன் எம்மான் * கண்ணனை மாயனையே"],0,"/media/recitation/TVM.3.4.8.mp3"],[3054,3054,["kaNNanai mAyan thannaik * kaDal kaDaindhu amudham koNDa *","aNNalai achchudhanai * ananthanai ananthan than mEl **","naNNi nanku uRaiginRAnai * njAlam uNDu umizhndha mAlai *","eNNum ARu aRiya mATTEn * yAvaiyum yavarum thAnE"],["கண்ணனை மாயன் தன்னைக் * கடல் கடைந்து அமுதம் கொண்ட *","அண்ணலை அச்சுதனை * அனந்தனை அனந்தன் தன் மேல் **","நண்ணி நன்கு உறைகின்றானை * ஞாலம் உண்டு உமிழ்ந்த மாலை *","எண்ணும் ஆறு அறிய மாட்டேன் * யாவையும் யவரும் தானே"],0,"/media/recitation/TVM.3.4.9.mp3"],[3055,3055,["yAvaiyum yavarum thAn Ay * avar avar samayam thORum *","thOyvilan pulan aindhukkum * solappaDAn uNarvin mUrththi **","Avi sEr uyirin uLLAl * Adhum Or paRRilAdha *","pAvanai adhanaik kUDil * avanaiyum kUDalAmE"],["யாவையும் யவரும் தான் ஆய் * அவர் அவர் சமயம் தோறும் *","தோய்விலன் புலன் ஐந்துக்கும் * சொலப்படான் உணர்வின் மூர்த்தி **","ஆவி சேர் உயிரின் உள்ளால் * ஆதும் ஓர் பற்றிலாத *","பாவனை அதனைக் கூடில் * அவனையும் கூடலாமே"],0,"/media/recitation/TVM.3.4.10.mp3"],[3056,3056,["** kUDi vaNDaRaiyum thaNthArk * koNDal pOl vaNNan thannai *","mADalar pozhil kurugUr * vaN saDakOpan sonna **","pADal Or AyiraththuL * ivaiyum oru paththum vallAr *","vIDila bOgam eydhi * virumbuvar amarar moyththE"],["** கூடி வண்டறையும் தண்தார்க் * கொண்டல் போல் வண்ணன் தன்னை *","மாடலர் பொழில் குருகூர் * வண் சடகோபன் சொன்ன **","பாடல் ஓர் ஆயிரத்துள் * இவையும் ஒரு பத்தும் வல்லார் *","வீடில போகம் எய்தி * விரும்புவர் அமரர் மொய்த்தே"],0,"/media/recitation/TVM.3.4.11.mp3"]],[[3057,3057,["** moy mAm pUmpozhil poygai * mudhalaich siRaippaTTu ninRa *","kaimmAvukku aruL seydha * kAr mugil pOl vaNNan kaNNan **","emmAnaich sollip pADi * ezhundhum paRandhum thuLLAdhAr *","thammAl karumam en? sollIr * thaNkaDal vaTTaththu uLLIrE!"],["** மொய் மாம் பூம்பொழில் பொய்கை * முதலைச் சிறைப்பட்டு நின்ற *","கைம்மாவுக்கு அருள் செய்த * கார் முகில் போல் வண்ணன் கண்ணன் **","எம்மானைச் சொல்லிப் பாடி * எழுந்தும் பறந்தும் துள்ளாதார் *","தம்மால் கருமம் என்? சொல்லீர் * தண்கடல் வட்டத்து உள்ளீரே!"],0,"/media/recitation/TVM.3.5.1.mp3"],[3058,3058,["thaNkaDal vaTTaththu uLLAraith * thamakku iraiyAth thaDindhuNNum *","thiN kazhaRkAl asurarkkuth * thInggu izhaikkum thirumAlai **","paNgaL thalaik koLLap pADip * paRandhum kuniththu uzhalAdhAr *","maN koL ulagil piRappAr * valvinai mOdha malaindhE"],["தண்கடல் வட்டத்து உள்ளாரைத் * தமக்கு இரையாத் தடிந்துண்ணும் *","திண் கழற்கால் அசுரர்க்குத் * தீங்கு இழைக்கும் திருமாலை **","பண்கள் தலைக் கொள்ளப் பாடிப் * பறந்தும் குனித்து உழலாதார் *","மண் கொள் உலகில் பிறப்பார் * வல்வினை மோத மலைந்தே"],0,"/media/recitation/TVM.3.5.2.mp3"],[3059,3059,["malaiyai eDuththuk kal mAri kAththup * pasu nirai thannai *","tholaivu thavirththa pirAnaich * sollich solli ninRu eppOdhum **","thalaiyinODu Adhanam thaTTath * thaDukuTTamAyp paRavAdhAr *","alai koL naragaththu azhundhik * kiDandhu uzhaikkinRa vambarE"],["மலையை எடுத்துக் கல் மாரி காத்துப் * பசு நிரை தன்னை *","தொலைவு தவிர்த்த பிரானைச் * சொல்லிச் சொல்லி நின்று எப்போதும் **","தலையினோடு ஆதனம் தட்டத் * தடுகுட்டமாய்ப் பறவாதார் *","அலை கொள் நரகத்து அழுந்திக் * கிடந்து உழைக்கின்ற வம்பரே"],0,"/media/recitation/TVM.3.5.3.mp3"],[3060,3060,["vambavizh kOdhai poruTTA * mAl viDai Ezhum aDarththa *","sempavaLath thiraL vAyan * sirIdharan thol pugazh pADi **","kumbiDu naTTam iTTADik * kOgu kaTTuNDu uzhalAdhAr *","tham piRappAl payan ennE? * sAdhu sananggaL iDaiyE"],["வம்பவிழ் கோதை பொருட்டா * மால் விடை ஏழும் அடர்த்த *","செம்பவளத் திரள் வாயன் * சிரீதரன் தொல் புகழ் பாடி **","கும்பிடு நட்டம் இட்டாடிக் * கோகு கட்டுண்டு உழலாதார் *","தம் பிறப்பால் பயன் என்னே? * சாது சனங்கள் இடையே"],0,"/media/recitation/TVM.3.5.4.mp3"],[3061,3061,["sAdhu sanaththai naliyum * kanjchanaich sAdhippadhaRku *","Adhi anjchOdhi uruvai * anggu vaiththu inggup piRandha **","vEdha mudhalvanaip pADi * vIdhigaL thORum thuLLAdhAr *","Odhi uNarndhavar munnA * en savippAr manisarE?"],["சாது சனத்தை நலியும் * கஞ்சனைச் சாதிப்பதற்கு *","ஆதி அஞ்சோதி உருவை * அங்கு வைத்து இங்குப் பிறந்த **","வேத முதல்வனைப் பாடி * வீதிகள் தோறும் துள்ளாதார் *","ஓதி உணர்ந்தவர் முன்னா * என் சவிப்பார் மனிசரே?"],0,"/media/recitation/TVM.3.5.5.mp3"],[3062,3062,["manisarum maRRum muRRumAy * mAyap piRavi piRandha *","thaniyan piRappili thannaith * thaDangkaDal sErndha pirAnai **","kaniyaik karumbin insARRaik * kaTTiyaith thEnai amudhai *","munivinRi Eththik kunippAr * muzhudhuNar nIrmaiyinArE"],["மனிசரும் மற்றும் முற்றுமாய் * மாயப் பிறவி பிறந்த *","தனியன் பிறப்பிலி தன்னைத் * தடங்கடல் சேர்ந்த பிரானை **","கனியைக் கரும்பின் இன்சாற்றைக் * கட்டியைத் தேனை அமுதை *","முனிவின்றி ஏத்திக் குனிப்பார் * முழுதுணர் நீர்மையினாரே"],0,"/media/recitation/TVM.3.5.6.mp3"],[3063,3063,["nIrmai il nURRuvar vIya * aivarkku aruL seydhu ninRu *","pAr malgu sEnai aviththa * paranjchuDarai ninaindhu ADi **","nIr malgu kaNNinar Agi * nenjcham kuzhaindhu naiyAdhE *","Un malgi mODu paruppAr * uththamargaTku en seyvArE?"],["நீர்மை இல் நூற்றுவர் வீய * ஐவர்க்கு அருள் செய்து நின்று *","பார் மல்கு சேனை அவித்த * பரஞ்சுடரை நினைந்து ஆடி **","நீர் மல்கு கண்ணினர் ஆகி * நெஞ்சம் குழைந்து நையாதே *","ஊன் மல்கி மோடு பருப்பார் * உத்தமர்கட்கு என் செய்வாரே?"],0,"/media/recitation/TVM.3.5.7.mp3"],[3064,3064,["vAr punal anthaN aruvi * vaDa thiruvEngkaDaththu endhai *","pEr pala sollip pidhaRRip * piththar enRE piRar kURa **","Ur pala pukkum pugAdhum * ulOgar sirikka ninRu ADi *","Arvam perugik kunippAr * amarar thozhappaDuvArE"],["வார் புனல் அந்தண் அருவி * வட திருவேங்கடத்து எந்தை *","பேர் பல சொல்லிப் பிதற்றிப் * பித்தர் என்றே பிறர் கூற **","ஊர் பல புக்கும் புகாதும் * உலோகர் சிரிக்க நின்று ஆடி *","ஆர்வம் பெருகிக் குனிப்பார் * அமரர் தொழப்படுவாரே"],0,"/media/recitation/TVM.3.5.8.mp3"],[3065,3065,["amarar thozhappaDuvAnai * anaiththulagukkum pirAnai *","amarar manaththinuL yOgu puNarndhu * avan thannODu onRAga **","amarath thuNiya vallArgaL ozhiya * allAdhavar ellAm *","amara ninaindhu ezhundhu ADi * alaRRuvadhE karumamE"],["அமரர் தொழப்படுவானை * அனைத்துலகுக்கும் பிரானை *","அமரர் மனத்தினுள் யோகு புணர்ந்து * அவன் தன்னோடு ஒன்றாக **","அமரத் துணிய வல்லார்கள் ஒழிய * அல்லாதவர் எல்லாம் *","அமர நினைந்து எழுந்து ஆடி * அலற்றுவதே கருமமே"],0,"/media/recitation/TVM.3.5.9.mp3"],[3066,3066,["karumamum karuma palanum Agiya * kAraNan thannai *","thiru maNi vaNNanaich sengkaN mAlinaith * dhEva pirAnai **","orumai manaththinuL vaiththu * uLLam kuzhaindhu ezhundhu ADi *","perumaiyum nANum thavirndhu * pidhaRRumin pEdhaimai thIrndhE"],["கருமமும் கரும பலனும் ஆகிய * காரணன் தன்னை *","திரு மணி வண்ணனைச் செங்கண் மாலினைத் * தேவ பிரானை **","ஒருமை மனத்தினுள் வைத்து * உள்ளம் குழைந்து எழுந்து ஆடி *","பெருமையும் நாணும் தவிர்ந்து * பிதற்றுமின் பேதைமை தீர்ந்தே"],0,"/media/recitation/TVM.3.5.10.mp3"],[3067,3067,["** thIrndha aDiyavar thammaith * thiruththip paNi koLLa valla *","Arndha pugazh achchudhanai * amarar pirAnai emmAnai **","vAyndha vaLa vayal sUzh * thaN vaLangkurugUrch saDakOpan *","nErndha Or Ayiraththu ippaththu * aruvinai nIRu seyyumE"],["** தீர்ந்த அடியவர் தம்மைத் * திருத்திப் பணி கொள்ள வல்ல *","ஆர்ந்த புகழ் அச்சுதனை * அமரர் பிரானை எம்மானை **","வாய்ந்த வள வயல் சூழ் * தண் வளங்குருகூர்ச் சடகோபன் *","நேர்ந்த ஓர் ஆயிரத்து இப்பத்து * அருவினை நீறு செய்யுமே"],0,"/media/recitation/TVM.3.5.11.mp3"]],[[3068,3068,["** seyya thAmaraik kaNNanAy *","ulagEzhum uNDa avan kaNDIr *","vaiyam vAnam manisar dheyvam *","maRRum maRRum maRRum muRRumAy **","seyya sUzh suDar njAnamAy *","veLippaTTu ivai paDaiththAn * pinnum","moy koL sOdhiyODu AyinAn * oru","mUvar Agiya mUrththiyE"],["** செய்ய தாமரைக் கண்ணனாய் *","உலகேழும் உண்ட அவன் கண்டீர் *","வையம் வானம் மனிசர் தெய்வம் *","மற்றும் மற்றும் மற்றும் முற்றுமாய் **","செய்ய சூழ் சுடர் ஞானமாய் *","வெளிப்பட்டு இவை படைத்தான் * பின்னும்","மொய் கொள் சோதியோடு ஆயினான் * ஒரு","மூவர் ஆகிய மூர்த்தியே"],0,"/media/recitation/TVM.3.6.1.mp3"],[3069,3069,["mUvar Agiya mUrththiyai * mudhal","mUvarkku mudhalvan thannai *","sAvam uLLana nIkkuvAnaith *","thaDangkaDal kiDandhAn thannai **","dhEva dhEvanaith thennilanggai *","eri ezhach seRRa villiyai *","pAva nAsanaip panggayath thaDang","kaNNanaip * paravuminO"],["மூவர் ஆகிய மூர்த்தியை * முதல்","மூவர்க்கு முதல்வன் தன்னை *","சாவம் உள்ளன நீக்குவானைத் *","தடங்கடல் கிடந்தான் தன்னை **","தேவ தேவனைத் தென்னிலங்கை *","எரி எழச் செற்ற வில்லியை *","பாவ நாசனைப் பங்கயத் தடங்","கண்ணனைப் * பரவுமினோ"],0,"/media/recitation/TVM.3.6.2.mp3"],[3070,3070,["paravi vAnavar Eththa ninRa *","paramanaip paranjchOdhiyai *","kuravai kOththa kuzhaganai *","maNi vaNNanaik kuDak kUththanai **","aravam ERi alai kaDal amarum *","thuyil koNDa aNNalai *","iravu nanpagalum viDAdhu * enRum","Eththudhal manam vaimminO"],["பரவி வானவர் ஏத்த நின்ற *","பரமனைப் பரஞ்சோதியை *","குரவை கோத்த குழகனை *","மணி வண்ணனைக் குடக் கூத்தனை **","அரவம் ஏறி அலை கடல் அமரும் *","துயில் கொண்ட அண்ணலை *","இரவு நன்பகலும் விடாது * என்றும்","ஏத்துதல் மனம் வைம்மினோ"],0,"/media/recitation/TVM.3.6.3.mp3"],[3071,3071,["vaimmin num manaththenRu * yAn","uraikkinRa mAyavan sIrmaiyai *","emmanOrgaL uraippadhu en? * adhu","niRka nALthoRum ** vAnavar","thammai ALum avanum * nAnmuganum","saDaimuDi aNNalum *","semmaiyAl avan pAdha panggayam *","sindhiththu Eththith thirivarE"],["வைம்மின் நும் மனத்தென்று * யான்","உரைக்கின்ற மாயவன் சீர்மையை *","எம்மனோர்கள் உரைப்பது என்? * அது","நிற்க நாள்தொறும் ** வானவர்","தம்மை ஆளும் அவனும் * நான்முகனும்","சடைமுடி அண்ணலும் *","செம்மையால் அவன் பாத பங்கயம் *","சிந்தித்து ஏத்தித் திரிவரே"],0,"/media/recitation/TVM.3.6.4.mp3"],[3072,3072,["thiriyum kARRODu agal visumbu *","thiNindha maN kiDandha kaDal *","eriyum thIyODu iru suDar dheyvam *","maRRum maRRum muRRumAy **","kariya mEniyan seyya thAmaraik","kaNNan * kaNNan viNNOr iRai *","suriyum pal karungkunjchi * enggaL","suDar muDi aNNal thORRamE"],["திரியும் காற்றோடு அகல் விசும்பு *","திணிந்த மண் கிடந்த கடல் *","எரியும் தீயோடு இரு சுடர் தெய்வம் *","மற்றும் மற்றும் முற்றுமாய் **","கரிய மேனியன் செய்ய தாமரைக்","கண்ணன் * கண்ணன் விண்ணோர் இறை *","சுரியும் பல் கருங்குஞ்சி * எங்கள்","சுடர் முடி அண்ணல் தோற்றமே"],0,"/media/recitation/TVM.3.6.5.mp3"],[3073,3073,["thORRak kEDavai illavan uDaiyAn *","avan oru mUrththiyAy *","sIRRaththODu aruL peRRavan * aDik","kIzhp puga ninRa sengkaNmAl **","nARRath thORRach suvai oli *","uRal Agi ninRa * em vAnavar","ERRaiyE anRi * maRRoruvarai","yAn ilEn ezhumaikkumE"],["தோற்றக் கேடவை இல்லவன் உடையான் *","அவன் ஒரு மூர்த்தியாய் *","சீற்றத்தோடு அருள் பெற்றவன் * அடிக்","கீழ்ப் புக நின்ற செங்கண்மால் **","நாற்றத் தோற்றச் சுவை ஒலி *","உறல் ஆகி நின்ற * எம் வானவர்","ஏற்றையே அன்றி * மற்றொருவரை","யான் இலேன் எழுமைக்குமே"],0,"/media/recitation/TVM.3.6.6.mp3"],[3074,3074,["ezhumaikkum enadhu Avikku *","innamudhaththinai enadhu Aruyir *","kezhumiya kadhirch chOdhiyai * maNi","vaNNanaik kuDak kUththanai **","vizhumiya amarar munivar","vizhunggum * kannal kaniyinai *","thozhumin thUya manaththarAy *","iRaiyum nillA thuyaranggaLE"],["எழுமைக்கும் எனது ஆவிக்கு *","இன்னமுதத்தினை எனது ஆருயிர் *","கெழுமிய கதிர்ச் சோதியை * மணி","வண்ணனைக் குடக் கூத்தனை **","விழுமிய அமரர் முனிவர்","விழுங்கும் * கன்னல் கனியினை *","தொழுமின் தூய மனத்தராய் *","இறையும் நில்லா துயரங்களே"],0,"/media/recitation/TVM.3.6.7.mp3"],[3075,3075,["thuyaramE tharu thunba inba","vinaigaLAy * avai allanAy *","uyara ninRadhOr sOdhiyAy *","ulagEzhum uNDu umizhndhAn thannai **","ayara vAnggu naman thamarkku *","aru nanjchinai achchudhan thannai *","thayaradhaRku magan thannai anRi *","maRRilEn thanjcham AgavE"],["துயரமே தரு துன்ப இன்ப","வினைகளாய் * அவை அல்லனாய் *","உயர நின்றதோர் சோதியாய் *","உலகேழும் உண்டு உமிழ்ந்தான் தன்னை **","அயர வாங்கு நமன் தமர்க்கு *","அரு நஞ்சினை அச்சுதன் தன்னை *","தயரதற்கு மகன் தன்னை அன்றி *","மற்றிலேன் தஞ்சம் ஆகவே"],0,"/media/recitation/TVM.3.6.8.mp3"],[3076,3076,["thanjcham Agiya thandhai thAyoDu *","thAnumAy avai allanAy *","enjchalil amarar kula mudhal *","mUvar tham uLLum Adhiyai **","anjchi nIr ulagaththu uLLIrgaL! *","avan ivan enRu kUzhEnmin *","nenjchinAl ninaippAn yavan *","avan Agum nIL kaDal vaNNanE"],["தஞ்சம் ஆகிய தந்தை தாயொடு *","தானுமாய் அவை அல்லனாய் *","எஞ்சலில் அமரர் குல முதல் *","மூவர் தம் உள்ளும் ஆதியை **","அஞ்சி நீர் உலகத்து உள்ளீர்கள்! *","அவன் இவன் என்று கூழேன்மின் *","நெஞ்சினால் நினைப்பான் யவன் *","அவன் ஆகும் நீள் கடல் வண்ணனே"],0,"/media/recitation/TVM.3.6.9.mp3"],[3077,3077,["kaDal vaNNan kaNNan * viNNavar","karu mANikkam enadhu Aruyir *","paDa aravin aNaik kiDandha *","paranjchuDar paNDu nURRuvar **","aDa varum paDai mangga * aivargaTkAgi","venjchamaththu * anRu thEr","kaDaviya perumAn * kanai kazhal","kANbadhu enRu kol kaNgaLE?"],["கடல் வண்ணன் கண்ணன் * விண்ணவர்","கரு மாணிக்கம் எனது ஆருயிர் *","பட அரவின் அணைக் கிடந்த *","பரஞ்சுடர் பண்டு நூற்றுவர் **","அட வரும் படை மங்க * ஐவர்கட்காகி","வெஞ்சமத்து * அன்று தேர்","கடவிய பெருமான் * கனை கழல்","காண்பது என்று கொல் கண்களே?"],0,"/media/recitation/TVM.3.6.10.mp3"],[3078,3078,["** kaNgaL kANDaRku ariyanAyk *","karuththukku nanRum eLiyanAy *","maN koL njAlaththu uyirkkellAm * aruL","seyyum vAnavar Isanai **","paN koL sOlai vazhudhi nADan *","kurugaik kOn saDakOpan sol *","paN koL Ayiraththu ippaththAl *","paththar Agak kUDum payiluminE"],["** கண்கள் காண்டற்கு அரியனாய்க் *","கருத்துக்கு நன்றும் எளியனாய் *","மண் கொள் ஞாலத்து உயிர்க்கெல்லாம் * அருள்","செய்யும் வானவர் ஈசனை **","பண் கொள் சோலை வழுதி நாடன் *","குருகைக் கோன் சடகோபன் சொல் *","பண் கொள் ஆயிரத்து இப்பத்தால் *","பத்தர் ஆகக் கூடும் பயிலுமினே"],0,"/media/recitation/TVM.3.6.11.mp3"]],[[3079,3079,["** payilum suDar oLi mUrththiyaip * panggayak kaNNanai *","payila iniya * nam pARkaDal sErndha paramanai **","payilum thiru uDaiyAr * yavarElum avar kaNDIr *","payilum piRappiDai thORu * emmai ALum paramarE"],["** பயிலும் சுடர் ஒளி மூர்த்தியைப் * பங்கயக் கண்ணனை *","பயில இனிய * நம் பாற்கடல் சேர்ந்த பரமனை **","பயிலும் திரு உடையார் * யவரேலும் அவர் கண்டீர் *","பயிலும் பிறப்பிடை தோறு * எம்மை ஆளும் பரமரே"],0,"/media/recitation/TVM.3.7.1.mp3"],[3080,3080,["ALum paramanaik kaNNanai * Azhip pirAn thannai *","thOLum Or nAnkuDaith * thU maNi vaNNan emmAn thannai **","thALum thaDak kaiyum kUppip * paNiyum avar kaNDIr *","nALum piRappiDai thORu * emmai ALuDai nAdharE"],["ஆளும் பரமனைக் கண்ணனை * ஆழிப் பிரான் தன்னை *","தோளும் ஓர் நான்குடைத் * தூ மணி வண்ணன் எம்மான் தன்னை **","தாளும் தடக் கையும் கூப்பிப் * பணியும் அவர் கண்டீர் *","நாளும் பிறப்பிடை தோறு * எம்மை ஆளுடை நாதரே"],0,"/media/recitation/TVM.3.7.2.mp3"],[3081,3081,["nAdhanai njAlamum vAnamum Eththum * naRunthuzhAyp","pOdhanai * pon neDunjchakkaraththu * endhai pirAn thannai **","pAdham paNiya vallAraip * paNiyum avar kaNDIr *","Odhum piRappiDai thORu * emmai ALuDaiyArgaLE"],["நாதனை ஞாலமும் வானமும் ஏத்தும் * நறுந்துழாய்ப்","போதனை * பொன் நெடுஞ்சக்கரத்து * எந்தை பிரான் தன்னை **","பாதம் பணிய வல்லாரைப் * பணியும் அவர் கண்டீர் *","ஓதும் பிறப்பிடை தோறு * எம்மை ஆளுடையார்களே"],0,"/media/recitation/TVM.3.7.3.mp3"],[3082,3082,["uDai Arndha ADaiyan * kaNDikaiyan uDai nANinan *","puDai Ar pon nUlinan * pon muDiyan maRRum pal kalan **","naDaiyA uDaith thiru nAraNan * thoNDar thoNDar kaNDIr *","iDai Ar piRappiDai thORu * emakku em perumakkaLE"],["உடை ஆர்ந்த ஆடையன் * கண்டிகையன் உடை நாணினன் *","புடை ஆர் பொன் நூலினன் * பொன் முடியன் மற்றும் பல் கலன் **","நடையா உடைத் திரு நாரணன் * தொண்டர் தொண்டர் கண்டீர் *","இடை ஆர் பிறப்பிடை தோறு * எமக்கு எம் பெருமக்களே"],0,"/media/recitation/TVM.3.7.4.mp3"],[3083,3083,["perumakkaL uLLavar tham perumAnai * amarargaTku","arumai ozhiya * anRu Aramudhu UTTiya appanai **","perumai pidhaRRa vallAraip * pidhaRRumavar kaNDIr *","varumaiyum immaiyum * nammai aLikkum pirAkkaLE"],["பெருமக்கள் உள்ளவர் தம் பெருமானை * அமரர்கட்கு","அருமை ஒழிய * அன்று ஆரமுது ஊட்டிய அப்பனை **","பெருமை பிதற்ற வல்லாரைப் * பிதற்றுமவர் கண்டீர் *","வருமையும் இம்மையும் * நம்மை அளிக்கும் பிராக்களே"],0,"/media/recitation/TVM.3.7.5.mp3"],[3084,3084,["aLikkum paramanaik kaNNanai * Azhip pirAn thannai *","thuLikkum naRungkaNNith * thU maNi vaNNan emmAn thannai **","oLik koNDa sOdhiyai * uLLaththuk koLLumavar kaNDIr *","salippinRi ANDu emmaich * sanma sanmAntharam kApparE"],["அளிக்கும் பரமனைக் கண்ணனை * ஆழிப் பிரான் தன்னை *","துளிக்கும் நறுங்கண்ணித் * தூ மணி வண்ணன் எம்மான் தன்னை **","ஒளிக் கொண்ட சோதியை * உள்ளத்துக் கொள்ளுமவர் கண்டீர் *","சலிப்பின்றி ஆண்டு எம்மைச் * சன்ம சன்மாந்தரம் காப்பரே"],0,"/media/recitation/TVM.3.7.6.mp3"],[3085,3085,["sanma sanmAntharam kAththu * aDiyArgaLaik koNDu pOy *","thanmai peRuththith * than thAL iNaik kIzhk koLLum appanai **","thonmai pidhaRRa vallAraip * pidhaRRumavar kaNDIr *","nammai peRuththu emmai * nAL uyyak koLginRa nambarE"],["சன்ம சன்மாந்தரம் காத்து * அடியார்களைக் கொண்டு போய் *","தன்மை பெறுத்தித் * தன் தாள் இணைக் கீழ்க் கொள்ளும் அப்பனை **","தொன்மை பிதற்ற வல்லாரைப் * பிதற்றுமவர் கண்டீர் *","நம்மை பெறுத்து எம்மை * நாள் உய்யக் கொள்கின்ற நம்பரே"],0,"/media/recitation/TVM.3.7.7.mp3"],[3086,3086,["nambanai njAlam paDaiththavanaith * thiru mArbanai *","umbar ulaginil yArkkum * uNarvariyAn thannaik **","kumbi naragargaL Eththuvar Elum * avar kaNDIr *","em pal piRappiDai thORu * em thozhu kulam thAnggaLE"],["நம்பனை ஞாலம் படைத்தவனைத் * திரு மார்பனை *","உம்பர் உலகினில் யார்க்கும் * உணர்வரியான் தன்னைக் **","கும்பி நரகர்கள் ஏத்துவர் ஏலும் * அவர் கண்டீர் *","எம் பல் பிறப்பிடை தோறு * எம் தொழு குலம் தாங்களே"],0,"/media/recitation/TVM.3.7.8.mp3"],[3087,3087,["kulam thAnggu sAdhigaL * nAlilum kIzh izhindhu * eththanai","nalam thAn ilAdha * chaNDALa chaNDALargaL Agilum **","valanthAnggu chakkaraththu aNNal * maNi vaNNaRku AL enRu uL","kalandhAr * aDiyAr tham aDiyAr * em aDigaLE"],["குலம் தாங்கு சாதிகள் * நாலிலும் கீழ் இழிந்து * எத்தனை","நலம் தான் இலாத * சண்டாள சண்டாளர்கள் ஆகிலும் **","வலந்தாங்கு சக்கரத்து அண்ணல் * மணி வண்ணற்கு ஆள் என்று உள்","கலந்தார் * அடியார் தம் அடியார் * எம் அடிகளே"],0,"/media/recitation/TVM.3.7.9.mp3"],[3088,3088,["aDi Arndha vaiyam uNDu * Alilai anna vasanjcheyyum *","paDi Adhumil kuzhavip paDi * endhai pirAn thanakku **","aDiyAr aDiyAr tham aDiyAr aDiyAr thamakku *","aDiyAr aDiyAr tham * aDiyAr aDiyOnggaLE"],["அடி ஆர்ந்த வையம் உண்டு * ஆலிலை அன்ன வசஞ்செய்யும் *","படி ஆதுமில் குழவிப் படி * எந்தை பிரான் தனக்கு **","அடியார் அடியார் தம் அடியார் அடியார் தமக்கு *","அடியார் அடியார் தம் * அடியார் அடியோங்களே"],0,"/media/recitation/TVM.3.7.10.mp3"],[3089,3089,["** aDi Onggu nURRuvar vIya * anRu aivarukku aruL seydha","neDiyOnai * thenkurugUrch saDakOpan kuRREvalgaL **","aDi Arndha AyiraththuL * ivai paththu avan thoNDar mEl","muDivu * Arak kaRkiRkil * sanmam seyyAmai muDiyumE"],["** அடி ஓங்கு நூற்றுவர் வீய * அன்று ஐவருக்கு அருள் செய்த","நெடியோனை * தென்குருகூர்ச் சடகோபன் குற்றேவல்கள் **","அடி ஆர்ந்த ஆயிரத்துள் * இவை பத்து அவன் தொண்டர் மேல்","முடிவு * ஆரக் கற்கிற்கில் * சன்மம் செய்யாமை முடியுமே"],0,"/media/recitation/TVM.3.7.11.mp3"]],[[3090,3090,["** muDiyAnE! * mUvulagum thozhudhu Eththum sIr","aDiyAnE! * Azh kaDalaik kaDaindhAy! * puL Ur","koDiyAnE! ** koNDal vaNNA! * aNDaththu umbaril","neDiyAnE! * enRu kiDakkum en nenjchamE"],["** முடியானே! * மூவுலகும் தொழுது ஏத்தும் சீர்","அடியானே! * ஆழ் கடலைக் கடைந்தாய்! * புள் ஊர்","கொடியானே! ** கொண்டல் வண்ணா! * அண்டத்து உம்பரில்","நெடியானே! * என்று கிடக்கும் என் நெஞ்சமே"],0,"/media/recitation/TVM.3.8.1.mp3"],[3091,3091,["nenjchamE! nIL nagarAga * irundha en","thanjchanE! * thaNNilanggaikku iRaiyaich seRRa","nanjchanE! ** njAlam koLvAn * kuRaL Agiya","vanjchanE! * ennum eppOdhum en vAsagamE"],["நெஞ்சமே! நீள் நகராக * இருந்த என்","தஞ்சனே! * தண்ணிலங்கைக்கு இறையைச் செற்ற","நஞ்சனே! ** ஞாலம் கொள்வான் * குறள் ஆகிய","வஞ்சனே! * என்னும் எப்போதும் என் வாசகமே"],0,"/media/recitation/TVM.3.8.2.mp3"],[3092,3092,["vAsagamE Eththa aruL seyyum * vAnavar tham","nAyaganE! * nAL iLam thinggaLaik * kOL viDuththu **","vEy agam pAl veNNey thoDu uNDa * An Ayar","thAyavanE! * enRu thaDavum en kaigaLE"],["வாசகமே ஏத்த அருள் செய்யும் * வானவர் தம்","நாயகனே! * நாள் இளம் திங்களைக் * கோள் விடுத்து **","வேய் அகம் பால் வெண்ணெய் தொடு உண்ட * ஆன் ஆயர்","தாயவனே! * என்று தடவும் என் கைகளே"],0,"/media/recitation/TVM.3.8.3.mp3"],[3093,3093,["kaigaLAl Arath * thozhudhu thozhudhu unnai *","vaigalum mAththiraip pOdhum * Or vIDinRi **","pai koL pAmbERi * uRai paranE! * unnai","mey koLLak kANa * virumbum en kaNgaLE"],["கைகளால் ஆரத் * தொழுது தொழுது உன்னை *","வைகலும் மாத்திரைப் போதும் * ஓர் வீடின்றி **","பை கொள் பாம்பேறி * உறை பரனே! * உன்னை","மெய் கொள்ளக் காண * விரும்பும் என் கண்களே"],0,"/media/recitation/TVM.3.8.4.mp3"],[3094,3094,["kaNgaLAl kANa * varungkol? enRu AsaiyAl *","maN koNDa vAmanan * ERa magizhndhu sel **","paN koNDa puLLin * siRagoli pAviththu *","thiN koLLa Orkkum * kiDandhu en sevigaLE"],["கண்களால் காண * வருங்கொல்? என்று ஆசையால் *","மண் கொண்ட வாமனன் * ஏற மகிழ்ந்து செல் **","பண் கொண்ட புள்ளின் * சிறகொலி பாவித்து *","திண் கொள்ள ஓர்க்கும் * கிடந்து என் செவிகளே"],0,"/media/recitation/TVM.3.8.5.mp3"],[3095,3095,["sevigaLAl Ara * nin kIrththik kani ennum","kavigaLE * kAlap paN thEn * uRaippath thuRRu **","puviyin mEl * pon neDum chakkaraththu unnaiyE *","avivinRi Adharikkum * enadhu AviyE"],["செவிகளால் ஆர * நின் கீர்த்திக் கனி என்னும்","கவிகளே * காலப் பண் தேன் * உறைப்பத் துற்று **","புவியின் மேல் * பொன் நெடும் சக்கரத்து உன்னையே *","அவிவின்றி ஆதரிக்கும் * எனது ஆவியே"],0,"/media/recitation/TVM.3.8.6.mp3"],[3096,3096,["AviyE! AramudhE! * ennai AL uDai *","thUvi ampuL uDaiyAy! * suDar nEmiyAy! **","pAviyEn nenjcham * pulambap pala kAlum *","kUviyum kANap peREn * una kOlamE"],["ஆவியே! ஆரமுதே! * என்னை ஆள் உடை *","தூவி அம்புள் உடையாய்! * சுடர் நேமியாய்! **","பாவியேன் நெஞ்சம் * புலம்பப் பல காலும் *","கூவியும் காணப் பெறேன் * உன கோலமே"],0,"/media/recitation/TVM.3.8.7.mp3"],[3097,3097,["kOlamE! thAmaraik kaNNadhOr * anjchana","nIlamE! * ninRu enadhu Aviyai * IrginRa","sIlamE! ** senRu sellAdhana * mun nilAm","kAlamE! * unnai ennAL * kaNDu koLvanE?"],["கோலமே! தாமரைக் கண்ணதோர் * அஞ்சன","நீலமே! * நின்று எனது ஆவியை * ஈர்கின்ற","சீலமே! ** சென்று செல்லாதன * முன் நிலாம்","காலமே! * உன்னை எந்நாள் * கண்டு கொள்வனே?"],0,"/media/recitation/TVM.3.8.8.mp3"],[3098,3098,["koLvan nAn mAvali! * mUvaDi thA enRa","kaLvanE! * kanjchanai vanjchiththu * vANanai","uL vanmai thIra ** Or Ayiram thOL thuNiththa *","puL vallAy! * unnai enjnjAnRu porundhuvanE?"],["கொள்வன் நான் மாவலி! * மூவடி தா என்ற","கள்வனே! * கஞ்சனை வஞ்சித்து * வாணனை","உள் வன்மை தீர ** ஓர் ஆயிரம் தோள் துணித்த *","புள் வல்லாய்! * உன்னை எஞ்ஞான்று பொருந்துவனே?"],0,"/media/recitation/TVM.3.8.9.mp3"],[3099,3099,["porundhiya mA marudhin iDai pOya * em","perunthagAy! * un kazhal kANiya pEdhuRRu **","varundhi nAn * vAsaga mAlai koNDu * unnaiyE","irundhu irundhu * eththanai kAlam pulambuvanE?"],["பொருந்திய மா மருதின் இடை போய * எம்","பெருந்தகாய்! * உன் கழல் காணிய பேதுற்று **","வருந்தி நான் * வாசக மாலை கொண்டு * உன்னையே","இருந்து இருந்து * எத்தனை காலம் புலம்புவனே?"],0,"/media/recitation/TVM.3.8.10.mp3"],[3100,3100,["** pulambu sIrp * bUmi aLandha perumAnai *","nalangkoL sIr * nankurugUrch saDakOpan ** sol","valam koNDa AyiraththuL * ivaiyum Or paththu *","ilanggu vAn * yAvarum ERuvar sonnAlE"],["** புலம்பு சீர்ப் * பூமி அளந்த பெருமானை *","நலங்கொள் சீர் * நன்குருகூர்ச் சடகோபன் ** சொல்","வலம் கொண்ட ஆயிரத்துள் * இவையும் ஓர் பத்து *","இலங்கு வான் * யாவரும் ஏறுவர் சொன்னாலே"],0,"/media/recitation/TVM.3.8.11.mp3"]],[[3101,3101,["** sonnAl virOdham idhu * Agilum solluvan kENminO *","en nAvil inkavi * yAn oruvarkkum koDukkilEn **","thennA thenA enRu * vaNDu mural thiruvEngkaDaththu *","en Anai en appan * emperumAn uLan AgavE"],["** சொன்னால் விரோதம் இது * ஆகிலும் சொல்லுவன் கேண்மினோ *","என் நாவில் இன்கவி * யான் ஒருவர்க்கும் கொடுக்கிலேன் **","தென்னா தெனா என்று * வண்டு முரல் திருவேங்கடத்து *","என் ஆனை என் அப்பன் * எம்பெருமான் உளன் ஆகவே"],0,"/media/recitation/TVM.3.9.1.mp3"],[3102,3102,["uLan AgavE eNNith * thannai onRAgath than selvaththai *","vaLanA madhikkum * immAniDaththaik kavi pADi en? **","kuLan Ar kazhani sUzh * kaN nan kuRungkuDi meymmaiyE *","uLan Aya endhaiyai * endhai pemmAnai ozhiyavE"],["உளன் ஆகவே எண்ணித் * தன்னை ஒன்றாகத் தன் செல்வத்தை *","வளனா மதிக்கும் * இம்மானிடத்தைக் கவி பாடி என்? **","குளன் ஆர் கழனி சூழ் * கண் நன் குறுங்குடி மெய்ம்மையே *","உளன் ஆய எந்தையை * எந்தை பெம்மானை ஒழியவே"],0,"/media/recitation/TVM.3.9.2.mp3"],[3103,3103,["ozhivu onRu illAdha * pal Uzhi thORUzhi nilAva * pOm","vazhiyaith tharum * nanggaL vAnavar Isanai niRkap pOy **","kazhiya miga nalla * vAn kavi koNDu pulavIrgAL! *","izhiyak karudhi * Or mAniDam pADal en AvadhE?"],["ஒழிவு ஒன்று இல்லாத * பல் ஊழி தோறூழி நிலாவ * போம்","வழியைத் தரும் * நங்கள் வானவர் ஈசனை நிற்கப் போய் **","கழிய மிக நல்ல * வான் கவி கொண்டு புலவீர்காள்! *","இழியக் கருதி * ஓர் மானிடம் பாடல் என் ஆவதே?"],0,"/media/recitation/TVM.3.9.3.mp3"],[3104,3104,["en Avadhu? eththenai nALaikkup pOdhum? * pulavIrgAL! *","mannA manisaraip * pADip paDaikkum perum poruL **","min Ar maNi muDi * viNNavar thAdhaiyaip pADinAl *","than AgavE koNDu * sanmam seyyAmaiyum koLLumE"],["என் ஆவது? எத்தெனை நாளைக்குப் போதும்? * புலவீர்காள்! *","மன்னா மனிசரைப் * பாடிப் படைக்கும் பெரும் பொருள் **","மின் ஆர் மணி முடி * விண்ணவர் தாதையைப் பாடினால் *","தன் ஆகவே கொண்டு * சன்மம் செய்யாமையும் கொள்ளுமே"],0,"/media/recitation/TVM.3.9.4.mp3"],[3105,3105,["koLLum payan illai * kuppai kiLarththanna selvaththai *","vaLLal pugazhndhu * num vAymai izhakkum pulavIrgAL! **","koLLak kuRaivilan * vENDiRRu ellAm tharum kOdhil * en","vaLLal maNi vaNNan thannaik * kavi solla vamminO"],["கொள்ளும் பயன் இல்லை * குப்பை கிளர்த்தன்ன செல்வத்தை *","வள்ளல் புகழ்ந்து * நும் வாய்மை இழக்கும் புலவீர்காள்! **","கொள்ளக் குறைவிலன் * வேண்டிற்று எல்லாம் தரும் கோதில் * என்","வள்ளல் மணி வண்ணன் தன்னைக் * கவி சொல்ல வம்மினோ"],0,"/media/recitation/TVM.3.9.5.mp3"],[3106,3106,["vammin pulavIr! * num mey varuththik kai seydhu uymminO *","immannulaginil * selvar ippOdhu illai nOkkinOm **","num inkavi koNDu * num num iTTA dheyvam EththinAl *","sem min suDar muDi * en thirumAlukkuch sErumE"],["வம்மின் புலவீர்! * நும் மெய் வருத்திக் கை செய்து உய்ம்மினோ *","இம்மன்னுலகினில் * செல்வர் இப்போது இல்லை நோக்கினோம் **","நும் இன்கவி கொண்டு * நும் நும் இட்டா தெய்வம் ஏத்தினால் *","செம் மின் சுடர் முடி * என் திருமாலுக்குச் சேருமே"],0,"/media/recitation/TVM.3.9.6.mp3"],[3107,3107,["sErum koDai pugazh * ellai ilAnai * Or Ayiram","pErum uDaiya pirAnai allAl * maRRu yAn kilEn **","mAri anaiya kai * mAl varai okkum thiN thOL enRu *","pAril Or paRRaiyaip * pachchaip pasum poygaL pEsavE"],["சேரும் கொடை புகழ் * எல்லை இலானை * ஓர் ஆயிரம்","பேரும் உடைய பிரானை அல்லால் * மற்று யான் கிலேன் **","மாரி அனைய கை * மால் வரை ஒக்கும் திண் தோள் என்று *","பாரில் ஓர் பற்றையைப் * பச்சைப் பசும் பொய்கள் பேசவே"],0,"/media/recitation/TVM.3.9.7.mp3"],[3108,3108,["vEyin mali purai thOLi * pinnaikku maNALanai *","Aya perum pugazh * ellai ilAdhana pADip pOy **","kAyam kazhiththu * avan thAL iNaik kIzhp pugum kAdhalan *","mAya manisarai * en solla vallEn en vAy koNDE?"],["வேயின் மலி புரை தோளி * பின்னைக்கு மணாளனை *","ஆய பெரும் புகழ் * எல்லை இலாதன பாடிப் போய் **","காயம் கழித்து * அவன் தாள் இணைக் கீழ்ப் புகும் காதலன் *","மாய மனிசரை * என் சொல்ல வல்லேன் என் வாய் கொண்டே?"],0,"/media/recitation/TVM.3.9.8.mp3"],[3109,3109,["vAy koNDu mAniDam pADa vandha * kaviyEn allEn *","Ay koNDa sIr vaLLal * Azhip pirAn enakkE uLan **","sAy koNDa immaiyum sAdhiththu * vAnavar nATTaiyum *","nI kaNDu koL enRu * vIDum tharum ninRu ninRE"],["வாய் கொண்டு மானிடம் பாட வந்த * கவியேன் அல்லேன் *","ஆய் கொண்ட சீர் வள்ளல் * ஆழிப் பிரான் எனக்கே உளன் **","சாய் கொண்ட இம்மையும் சாதித்து * வானவர் நாட்டையும் *","நீ கண்டு கொள் என்று * வீடும் தரும் நின்று நின்றே"],0,"/media/recitation/TVM.3.9.9.mp3"],[3110,3110,["ninRu ninRu pala nAL uykkum * ivvuDal nInggip pOy *","senRu senRu Agilum kaNDu * sanmam kazhippAn eNNi **","onRi onRi ulagam paDaiththAn * kavi AyinERku *","enRum enRum ini * maRRoruvar kavi ERkumE?"],["நின்று நின்று பல நாள் உய்க்கும் * இவ்வுடல் நீங்கிப் போய் *","சென்று சென்று ஆகிலும் கண்டு * சன்மம் கழிப்பான் எண்ணி **","ஒன்றி ஒன்றி உலகம் படைத்தான் * கவி ஆயினேற்கு *","என்றும் என்றும் இனி * மற்றொருவர் கவி ஏற்குமே?"],0,"/media/recitation/TVM.3.9.10.mp3"],[3111,3111,["** ERkum perum pugazh * vAnavar Isan kaNNan thanakku *","ERkum perum pugazh * vaNkurugUrch saDakOpan sol **","ERkum perum pugazh * AyiraththuL ivaiyum Or paththu *","ERkum perum pugazh * solla vallArkku illai sanmamE"],["** ஏற்கும் பெரும் புகழ் * வானவர் ஈசன் கண்ணன் தனக்கு *","ஏற்கும் பெரும் புகழ் * வண்குருகூர்ச் சடகோபன் சொல் **","ஏற்கும் பெரும் புகழ் * ஆயிரத்துள் இவையும் ஓர் பத்து *","ஏற்கும் பெரும் புகழ் * சொல்ல வல்லார்க்கு இல்லை சன்மமே"],0,"/media/recitation/TVM.3.9.11.mp3"]],[[3112,3112,["** sanmam pala pala seydhu veLippaTTuch *","sanggoDu chakkaram vil *","oNmai uDaiya ulakkai oLvAL * thaNDu","koNDu puL Urndhu ** ulagil","vanmai uDaiya arakkar * asurarai","mALap paDai porudha *","nanmai uDaiyavan sIr paravap peRRa *","nAn Or kuRaivu ilanE"],["** சன்மம் பல பல செய்து வெளிப்பட்டுச் *","சங்கொடு சக்கரம் வில் *","ஒண்மை உடைய உலக்கை ஒள்வாள் * தண்டு","கொண்டு புள் ஊர்ந்து ** உலகில்","வன்மை உடைய அரக்கர் * அசுரரை","மாளப் படை பொருத *","நன்மை உடையவன் சீர் பரவப் பெற்ற *","நான் ஓர் குறைவு இலனே"],0,"/media/recitation/TVM.3.10.1.mp3"],[3113,3113,["kuRaivil thaDangkaDal kOL aravERith * than","kOlach senthAmaraik kaN *","uRaibavan pOla Or yOgu puNarndha *","oLi maNi vaNNan kaNNan **","kaRai aNi mUkkuDaip puLLaik kaDAvi *","asuraraik kAyndha ammAn *","niRai pugazh Eththiyum pADiyum ADiyum *","yAn oru muTTilanE"],["குறைவில் தடங்கடல் கோள் அரவேறித் * தன்","கோலச் செந்தாமரைக் கண் *","உறைபவன் போல ஓர் யோகு புணர்ந்த *","ஒளி மணி வண்ணன் கண்ணன் **","கறை அணி மூக்குடைப் புள்ளைக் கடாவி *","அசுரரைக் காய்ந்த அம்மான் *","நிறை புகழ் ஏத்தியும் பாடியும் ஆடியும் *","யான் ஒரு முட்டிலனே"],0,"/media/recitation/TVM.3.10.2.mp3"],[3114,3114,["muTTil pal bOgaththu oru thani nAyagan *","mUvulagukku uriya *","kaTTiyaith thEnai amudhai * nanpAlaik","kaniyaik karumbu thannai **","maTTavizh thaNNanthuzhAy muDiyAnai","vaNanggi * avan thiRaththup","paTTa pinnai * iRai Agilum * yAn en","manaththup parivilanE"],["முட்டில் பல் போகத்து ஒரு தனி நாயகன் *","மூவுலகுக்கு உரிய *","கட்டியைத் தேனை அமுதை * நன்பாலைக்","கனியைக் கரும்பு தன்னை **","மட்டவிழ் தண்ணந்துழாய் முடியானை","வணங்கி * அவன் திறத்துப்","பட்ட பின்னை * இறை ஆகிலும் * யான் என்","மனத்துப் பரிவிலனே"],0,"/media/recitation/TVM.3.10.3.mp3"],[3115,3115,["parivinRi vANanaik kAththum enRu * anRu","paDaiyoDum vandhu ethirndha *","thiripuram seRRavanum maganum * pinnum","anggiyum pOr tholaiya **","poru siRaip puLLaik kaDAviya * mAyanai","Ayanaip poRchakkaraththu","ariyinai * achchudhanaip paRRi * yAn","iRaiyEnum iDar ilanE"],["பரிவின்றி வாணனைக் காத்தும் என்று * அன்று","படையொடும் வந்து எதிர்ந்த *","திரிபுரம் செற்றவனும் மகனும் * பின்னும்","அங்கியும் போர் தொலைய **","பொரு சிறைப் புள்ளைக் கடாவிய * மாயனை","ஆயனைப் பொற்சக்கரத்து","அரியினை * அச்சுதனைப் பற்றி * யான்","இறையேனும் இடர் இலனே"],0,"/media/recitation/TVM.3.10.4.mp3"],[3116,3116,["iDar inRiyE oru nAL oru pOzhdhil *","ellA ulagum kazhiya *","paDar pugazhp pArththanum vaidhikanum *","uDan ERath thiN thEr kaDavi **","suDar oLiyAy ninRa thannuDaich sOdhiyil *","vaidhikan piLLaigaLai **","uDaloDum koNDu koDuththavanaip paRRi *","onRum thuyar ilanE"],["இடர் இன்றியே ஒரு நாள் ஒரு போழ்தில் *","எல்லா உலகும் கழிய *","படர் புகழ்ப் பார்த்தனும் வைதிகனும் *","உடன் ஏறத் திண் தேர் கடவி **","சுடர் ஒளியாய் நின்ற தன்னுடைச் சோதியில் *","வைதிகன் பிள்ளைகளை **","உடலொடும் கொண்டு கொடுத்தவனைப் பற்றி *","ஒன்றும் துயர் இலனே"],0,"/media/recitation/TVM.3.10.5.mp3"],[3117,3117,["thuyaril suDar oLi thannuDaich sOdhi *","ninRa vaNNam niRkavE *","thuyaril maliyum manisar piRaviyil *","thOnRik kaN kANa vandhu **","thuyaranggaL seydhu than dheyva nilai ulagil *","puga uykkum ammAn *","thuyaramil sIrk kaNNan mAyan pugazh thuRRa *","yAn Or thunbam ilanE"],["துயரில் சுடர் ஒளி தன்னுடைச் சோதி *","நின்ற வண்ணம் நிற்கவே *","துயரில் மலியும் மனிசர் பிறவியில் *","தோன்றிக் கண் காண வந்து **","துயரங்கள் செய்து தன் தெய்வ நிலை உலகில் *","புக உய்க்கும் அம்மான் *","துயரமில் சீர்க் கண்ணன் மாயன் புகழ் துற்ற *","யான் ஓர் துன்பம் இலனே"],0,"/media/recitation/TVM.3.10.6.mp3"],[3118,3118,["thunbamum inbamumAgiya * sey vinaiyAy","ulaganggaLumAy *","inbam il vennaragAgi * iniya","nal vAn suvarkkanggaLumAy **","man pal uyirgaLum Agip * pala pala","mAya mayakkugaLAl *","inbuRum ivviLaiyATTu uDaiyAnaip peRRu *","Edhum allal ilanE"],["துன்பமும் இன்பமுமாகிய * செய் வினையாய்","உலகங்களுமாய் *","இன்பம் இல் வெந்நரகாகி * இனிய","நல் வான் சுவர்க்கங்களுமாய் **","மன் பல் உயிர்களும் ஆகிப் * பல பல","மாய மயக்குகளால் *","இன்புறும் இவ்விளையாட்டு உடையானைப் பெற்று *","ஏதும் அல்லல் இலனே"],0,"/media/recitation/TVM.3.10.7.mp3"],[3119,3119,["allalil inbam aLavu iRandhu enggum *","azhagamar sUzh oLiyan *","alli malar magaL bOga mayakkukkaL *","Agiyum niRkum ammAn **","ellaiyil njAnaththan njAnam aqdhE koNDu *","ellAk karumanggaLum sey *","ellaiyil mAyanaik kaNNanaith thAL paRRi *","yAn Or dhukkam ilanE"],["அல்லலில் இன்பம் அளவு இறந்து எங்கும் *","அழகமர் சூழ் ஒளியன் *","அல்லி மலர் மகள் போக மயக்குக்கள் *","ஆகியும் நிற்கும் அம்மான் **","எல்லையில் ஞானத்தன் ஞானம் அஃதே கொண்டு *","எல்லாக் கருமங்களும் செய் *","எல்லையில் மாயனைக் கண்ணனைத் தாள் பற்றி *","யான் ஓர் துக்கம் இலனே"],0,"/media/recitation/TVM.3.10.8.mp3"],[3120,3120,["dhukkamil njAnach suDar oLi mUrththi *","thuzhAy alanggal perumAn *","mikka pal mAyanggaLAl vikirdham seydhu *","vENDum uruvu koNDu **","nakka pirAnODu ayan mudhal Aga *","ellArum evaiyum * thannuL","okka oDungga vizhungga vallAnaip peRRu *","onRum thaLarvilanE"],["துக்கம் இல் ஞானச் சுடர் ஒளி மூர்த்தி *","துழாய் அலங்கல் பெருமான் *","மிக்க பல் மாயங்களால் விகிர்தம் செய்து *","வேண்டும் உருவு கொண்டு **","நக்க பிரானோடு அயன் முதல் ஆக *","எல்லாரும் எவையும் * தன்னுள்","ஒக்க ஒடுங்க விழுங்க வல்லானைப் பெற்று *","ஒன்றும் தளர்விலனே"],0,"/media/recitation/TVM.3.10.9.mp3"],[3121,3121,["thaLarvu inRiyE enRum enggum parandha *","thani mudhal njAnam onRAy *","aLavuDai aimpulankaL aRiyA vagaiyAl *","aruvAgi niRkum **","vaLar oLi Isanai mUrththiyaip * pUthanggaL","aindhai iru suDarai *","kiLar oLi mAyanaik kaNNanaith thAL paRRi *","yAn enRum kEDilanE"],["தளர்வு இன்றியே என்றும் எங்கும் பரந்த *","தனி முதல் ஞானம் ஒன்றாய் *","அளவுடை ஐம்புலன்கள் அறியா வகையால் *","அருவாகி நிற்கும் **","வளர் ஒளி ஈசனை மூர்த்தியைப் * பூதங்கள்","ஐந்தை இரு சுடரை *","கிளர் ஒளி மாயனைக் கண்ணனைத் தாள் பற்றி *","யான் என்றும் கேடிலனே"],0,"/media/recitation/TVM.3.10.10.mp3"],[3122,3122,["** kEDil vizhup pugazhk kEsavanaik *","kurugUrch saDakOpan sonna *","pADal Or AyiraththuL * ivaiyum oru paththum","payiRRa vallArgaTku ** avan","nADu nagaramum nankuDan kANa *","nalan iDai Urdhi paNNi *","vIDum peRuththith than mUvulagukkum","tharum * oru nAyagamE"],["** கேடில் விழுப் புகழ்க் கேசவனைக் *","குருகூர்ச் சடகோபன் சொன்ன *","பாடல் ஓர் ஆயிரத்துள் * இவையும் ஒரு பத்தும்","பயிற்ற வல்லார்கட்கு ** அவன்","நாடு நகரமும் நன்குடன் காண *","நலன் இடை ஊர்தி பண்ணி *","வீடும் பெறுத்தித் தன் மூவுலகுக்கும்","தரும் * ஒரு நாயகமே"],0,"/media/recitation/TVM.3.10.11.mp3"]]]